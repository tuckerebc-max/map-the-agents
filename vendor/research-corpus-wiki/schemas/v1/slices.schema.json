{
  "$defs": {
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "lines",
            "html_block"
          ],
          "title": "Kind",
          "type": "string"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "heading": {
          "default": "",
          "title": "Heading",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "line_start",
        "line_end",
        "ordinal"
      ],
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z]+_[0-9a-f]{32,64}$",
      "title": "Id",
      "type": "string"
    },
    "access": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Access",
      "type": "string"
    },
    "review_state": {
      "enum": [
        "extracted",
        "mechanically_checked",
        "human_reviewed",
        "approved",
        "disputed",
        "superseded",
        "unverified"
      ],
      "title": "Review State",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "created_by_operation": {
      "title": "Created By Operation",
      "type": "string"
    },
    "updated_by_operation": {
      "title": "Updated By Operation",
      "type": "string"
    },
    "record_type": {
      "const": "slice",
      "default": "slice",
      "title": "Record Type",
      "type": "string"
    },
    "source_version_id": {
      "title": "Source Version Id",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/Locator"
    },
    "text_digest": {
      "title": "Text Digest",
      "type": "string"
    },
    "excerpt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt"
    },
    "quotation_allowed": {
      "title": "Quotation Allowed",
      "type": "boolean"
    },
    "publication_allowed": {
      "title": "Publication Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "access",
    "review_state",
    "created_at",
    "updated_at",
    "created_by_operation",
    "updated_by_operation",
    "source_version_id",
    "source_id",
    "locator",
    "text_digest",
    "quotation_allowed",
    "publication_allowed"
  ],
  "title": "Slice",
  "type": "object"
}
