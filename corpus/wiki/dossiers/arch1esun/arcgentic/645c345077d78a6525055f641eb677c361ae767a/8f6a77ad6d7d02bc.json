      ],
      "text": "Arcgentic is described as a harness engineering layer for AI coding agents, turning ad-hoc prompting into a gated engineering workflow for Codex and Claude Code."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6e3691dc845547df4ee44d44d8c693cfe19c971fba524d5ccfb51c0dcff9dd02",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
