          "git_sha": "8f5be1f2c06f6d3eb026d77b5e07550767101866",
          "line_end": 266,
          "line_start": 256,
          "path": "README.md",
          "repository": "arch1esun/arcgentic",
          "url": "https://github.com/Arch1eSUN/Arcgentic/blob/645c345077d78a6525055f641eb677c361ae767a/README.md#L256-L266"
