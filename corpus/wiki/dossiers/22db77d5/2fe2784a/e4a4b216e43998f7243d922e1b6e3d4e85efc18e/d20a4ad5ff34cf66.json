        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_dbdcd328e39dedfb7005dbb0dd6acba12f81f326d43aa21d9a3938a121907da1"
      ],
      "text": "The app is single-user: the owner is resolved via the app's service principal and Apps API, and authorization checks X-Forwarded-Email against app.creator."
    },
