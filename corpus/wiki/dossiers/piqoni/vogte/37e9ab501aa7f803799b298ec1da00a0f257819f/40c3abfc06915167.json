      ],
      "text": "Vogte is described as an agentic terminal tool aimed at existing Go codebases, helping developers build and maintain Go projects with LLMs."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ab954c665c09aeacbdda48e27808afc9fdaa6d9a022fbc1237eb1c0ce56af530",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "37e9ab501aa7f803799b298ec1da00a0f257819f",
          "git_sha": "65f5517f94834e250b3b1910b324212bdd58cf3f",
          "line_end": 19,
          "line_start": 15,
          "path": "README.md",
          "repository": "piqoni/vogte",
          "url": "https://github.com/piqoni/vogte/blob/37e9ab501aa7f803799b298ec1da00a0f257819f/README.md#L15-L19"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_cd8c9cbd884d767239beba20ea16b552888b89b088ef8baf7ecdcf7c370e56a7"
      ],
      "text": "Because the language is assumed to be Go, the tool parses repositories with Abstract Syntax Trees to extract compressed, relevant context for LLM prompts, aiming for near-zero configuration."
    },
