          "git_sha": "65f5517f94834e250b3b1910b324212bdd58cf3f",
          "line_end": 71,
          "line_start": 71,
          "path": "README.md",
          "repository": "piqoni/vogte",
          "url": "https://github.com/piqoni/vogte/blob/37e9ab501aa7f803799b298ec1da00a0f257819f/README.md#L71-L71"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e4ed103fed3dd585d7381c5656fa547e1d22c328f107a6920e499344ead4fbb1"
      ],
      "text": "In agent mode (via -agent or the AGENT toggle) the tool edits files without user approval, and users are advised to rely on version control to avoid losing work."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b92079fc233fee9e64deafadc83644f693358bd05878d83d92bda697ca0c43ee",
      "evidence_type": "organizational_statement",
      "facet": "evaluation",
      "kind": "observation",
