      "locators": [
        {
          "commit": "37e9ab501aa7f803799b298ec1da00a0f257819f",
          "git_sha": "65f5517f94834e250b3b1910b324212bdd58cf3f",
          "line_end": 38,
          "line_start": 38,
          "path": "README.md",
          "repository": "piqoni/vogte",
          "url": "https://github.com/piqoni/vogte/blob/37e9ab501aa7f803799b298ec1da00a0f257819f/README.md#L38-L38"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_cd6b15587329d62e736811776e6eb7864953064b834a35873362d81dee924dd7"
      ],
      "text": "It uses a two-step flow: first it extracts structs/interfaces/methods signatures and asks the LLM which files are needed, then supplies those files in full so the LLM can produce a solution."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b15b3a0acc12cfb42cd406210c022500552442ab28ae63bb377666e6e94740a1",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
