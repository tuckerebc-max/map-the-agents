          "line_end": 38,
          "line_start": 38,
          "path": "README.md",
          "repository": "abcwyc/pi-agent-desktop",
          "url": "https://github.com/abcwyc/pi-agent-desktop/blob/378db4dc27e4d345c12a74c78f4340bbbc47ce24/README.md#L38-L38"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a92bea6c4b5fb7ad536fa89d3526bc3e001c9094394bb8e2e308a80531e6f866"
      ],
      "text": "The desktop package bundles a Next.js standalone server, a Node.js runtime, and the current Pi SDK, so the local server starts with the app without separate installation."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4981a9df3749bb06b507b8ab92f8f808bc0f91766a7c91d9536c88cc49f6d1b8",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
