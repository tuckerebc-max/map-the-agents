          "line_end": 11,
          "line_start": 7,
          "path": "docs/ownership-boundaries.md",
          "repository": "abcwyc/pi-agent-desktop",
          "url": "https://github.com/abcwyc/pi-agent-desktop/blob/378db4dc27e4d345c12a74c78f4340bbbc47ce24/docs/ownership-boundaries.md#L7-L11"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_3a56449678312941421e41887374252b319519181f3318985c2e151b2beb7c80"
      ],
      "text": "The app bundles three components: the desktop shell authored in this fork, the pi agent runtime as an npm dependency, and the pi-web UI merged from an upstream release tag."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a1328d147906cc2b906f3313db67094ac302951fd34ce395cb553b00fe5420c1",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
