          "git_sha": "ff880e488a555ecd77616a718bb77e8b1e946340",
          "line_end": 17,
          "line_start": 9,
          "path": "README.md",
          "repository": "abcwyc/pi-agent-desktop",
          "url": "https://github.com/abcwyc/pi-agent-desktop/blob/378db4dc27e4d345c12a74c78f4340bbbc47ce24/README.md#L9-L17"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6f4c4da84285072c2ca2aff68db368619a6f93908e8ce69eee7af4930527d34e"
      ],
      "text": "Features include browsing and resuming past Pi sessions, real-time chat with visible thinking/tool calls/cost, branching or forking conversations, and Git worktree switching from the sidebar."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c4f3efd765e2dba08679f7f328c477c4cac16ea1a64d93770ea3c80d9c1545d3",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "378db4dc27e4d345c12a74c78f4340bbbc47ce24",
          "git_sha": "ff880e488a555ecd77616a718bb77e8b1e946340",
          "line_end": 17,
          "line_start": 9,
          "path": "README.md",
          "repository": "abcwyc/pi-agent-desktop",
          "url": "https://github.com/abcwyc/pi-agent-desktop/blob/378db4dc27e4d345c12a74c78f4340bbbc47ce24/README.md#L9-L17"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6f4c4da84285072c2ca2aff68db368619a6f93908e8ce69eee7af4930527d34e"
      ],
      "text": "The app can preview source code, diffs, Markdown, images, audio, PDF, and DOCX files, and offers dark mode, automatic session naming, and a completion sound."
    },
