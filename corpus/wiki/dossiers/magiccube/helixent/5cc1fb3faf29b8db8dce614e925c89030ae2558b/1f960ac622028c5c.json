        {
          "commit": "5cc1fb3faf29b8db8dce614e925c89030ae2558b",
          "git_sha": "e55a7b733f3985f21af07371c85bd206a1bd76ec",
          "line_end": 7,
          "line_start": 4,
          "path": "docs/code-convention.md",
          "repository": "magiccube/helixent",
          "url": "https://github.com/MagicCube/helixent/blob/5cc1fb3faf29b8db8dce614e925c89030ae2558b/docs/code-convention.md#L4-L7"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_51fa410846477090081e686207f67a3f63ac8ac08dcbcd57ac07913fcaec42c2"
      ],
      "text": "The stack uses TypeScript strict/ESM on the Bun runtime, Zod for schemas, the OpenAI SDK, Ink with React 19 for the TUI, Commander for the CLI, and gray-matter plus yaml for skills parsing."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8ff95731cd2059ea196c4abc2d871fc18e689466ed028ccdcc17c988340a6f19",
