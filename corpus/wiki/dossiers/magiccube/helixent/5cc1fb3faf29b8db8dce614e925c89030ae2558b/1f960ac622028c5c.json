        "slc_4f7467256e8c1a2c9bf601e879470144d5524605ba1312b4ec0e87be6a4eaa59",
        "slc_5d22afb35d58402c70df007d222dbecf4bce363850fc74a2eec8ddada4bd7534"
      ],
      "text": "The coding agent ships practical developer tools such as bash, read_file, write_file, str_replace, list_files, glob_search, grep_search, apply_patch, file_info, mkdir, and move_path, plus a todo-list-based plan mode."
    },
    {
      "basis": "documented",
      "claim_id": "clm_934e9e18c7bd22d1559d3aefd58ec9588af109b3e7c571cc3989b1aaf2913b59",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
