        "slc_32986783c5251d8589ba6b888ee1241dd65aaa20a4193be4e43c2e89ba322fc8",
        "slc_41ba54b4f840c2a7f3e0d45780ef210a07a9de104ae1ef93b7a315ebe18623e6"
      ],
      "text": "An Autopilot control agent watches a pod, sends the next instruction when it goes idle, enforces iteration caps, keeps decision history, and supports human takeover and handback."
    },
