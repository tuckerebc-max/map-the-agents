      "slice_ids": [
        "slc_f88ed077632bda278c065b63794dda573ccb1a53d8ad278a7edb549b89d158a6"
      ],
      "text": "Server side comprises a Go backend (Gin+GORM) handling auth, pod lifecycle, tickets, billing and runner-cert PKI; a WebSocket Relay for terminal data; and a self-hosted Go runner daemon that spawns PTY pods."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2bc41b0538b7a6939c35d3dbd5362414a141ee6c9e27f65af498680de8231727",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "1f90b14194d03c353df4f281a05442afe93cae34",
          "git_sha": "ffb1eb121c3438b6ec954b7f8f0ac74b35a2d9df",
          "line_end": 98,
          "line_start": 92,
          "path": "README.md",
          "repository": "agentsmesh/agentsmesh",
          "url": "https://github.com/AgentsMesh/AgentsMesh/blob/1f90b14194d03c353df4f281a05442afe93cae34/README.md#L92-L98"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_b6ca2ecfd1d13e1f3225ac591fa15f0b4e966e14671300e6147df11ab9087e06"
      ],
      "text": "Client side includes a Rust core of 10 crates compiled to WASM for web/desktop and exposed to iOS via UniFFI, plus Next.js web, Electron desktop, SwiftUI/TCA iOS, and a web-admin console."
    },
    {
      "basis": "documented",
      "claim_id": "clm_998a48c72462952db8470c2aa4302aa850458369df5533595b1fcb1adacd86af",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
