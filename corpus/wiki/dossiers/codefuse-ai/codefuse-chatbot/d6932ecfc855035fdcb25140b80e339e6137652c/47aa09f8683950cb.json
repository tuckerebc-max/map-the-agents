          "url": "https://github.com/codefuse-ai/codefuse-chatbot/blob/d6932ecfc855035fdcb25140b80e339e6137652c/README.md#L154-L154"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_17ca4e00b2fc5350478edd78f28307bb4a3f60de0a3810ddf99b9285429ef84b"
      ],
      "text": "The project acknowledges being built on the open-source projects langchain-chatchat and codebox-api."
    },
    {
      "basis": "documented",
      "claim_id": "clm_101f7e00ff34f7ccea06b203ff83aa3ab87ff1a413b252b32e6a4cc7926f5211",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
