      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9aa9d3b27dcee4a23e0c0f8a5d3a90fccfef8482bd9da45ded2b58b68fb95748"
      ],
      "text": "The workflow targets tools that read repository-level AGENTS.md instructions, with Cursor, Codex CLI, and Gemini CLI cited as common examples, and exact discovery behavior depends on tool version."
    },
