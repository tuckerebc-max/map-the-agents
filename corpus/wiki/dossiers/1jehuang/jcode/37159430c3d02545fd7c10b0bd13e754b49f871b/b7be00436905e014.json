      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_80d5817d59778f5a55aba7deeb018b8cecb21cd8f51fd55c5aa35d9f28190e5b"
      ],
      "text": "jcode offers built-in login flows via `jcode login --provider <id>` for providers including claude, openai, gemini, copilot, azure, fireworks, novita, minimax, lmstudio, ollama, and custom OpenAI-compatible endpoints."
    },
