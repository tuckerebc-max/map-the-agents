          "line_start": 352,
          "path": "README.md",
          "repository": "1jehuang/jcode",
          "url": "https://github.com/1jehuang/jcode/blob/37159430c3d02545fd7c10b0bd13e754b49f871b/README.md#L352-L364"
        }
