          "git_sha": "94aa4a39a2fc26b96c32b87380ccd00bf492914e",
          "line_end": 290,
          "line_start": 283,
          "path": "README.md",
          "repository": "qwen-code-dev-bot/oh-my-cli",
          "url": "https://github.com/qwen-code-dev-bot/oh-my-cli/blob/8dce0123dabfdae34093088281aaeb890e62d4fd/README.md#L283-L290"
