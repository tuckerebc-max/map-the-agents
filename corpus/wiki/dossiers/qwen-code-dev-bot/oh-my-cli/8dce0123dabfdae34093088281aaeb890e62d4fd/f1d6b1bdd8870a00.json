      "slice_ids": [
        "slc_a1800aaf31a53dd7f98c09b531e7224d59836390902d137a85103deadfb04306"
      ],
      "text": "Sessions persist as JSONL under ~/.oh-my-cli/sessions/ with atomic checkpointing; on resume, complete checkpoints are promoted, partial ones discarded, and corrupt ones quarantined rather than deleted."
    },
