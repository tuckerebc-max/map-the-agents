        "slc_ee045ca81706d5ae295b6af4701d56770c33b1d7e8a1b157b46267034f714bdb"
      ],
      "text": "The architecture doc describes this project as a Rust implementation of the 2389 Agent Protocol, with agents interoperating over MQTT and an emphasis on reliability and strict protocol compliance."
    },
    {
      "basis": "documented",
      "claim_id": "clm_40000d59be14b8c76d56b55f1beca7e77d0b0dfa088e8096c42f202ddd1cf026",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
