        "slc_cd436bd610354a3b7823d2b0752f76c80d4e2abe98130d0e5be812c8fd50fdab"
      ],
      "text": "The product exposes five MCP tools: start_work, inspect_work, update_work, transfer_work, and finish_work, covering presence/claims, state reads, prompts, ownership changes, and completion evidence."
    },
    {
      "basis": "documented",
      "claim_id": "clm_730768a1bf06d275b6d25698b32d44a78ca7e25a39de167902d3e44676d794cf",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "d2408b0cbce5c24f9fd85ead5ec23522fbeea0e3",
          "git_sha": "c5398fee141ee4bb0cf360d89981b4302a093030",
          "line_end": 189,
          "line_start": 187,
          "path": "README.md",
          "repository": "get-concord-ai/concord-mcp",
          "url": "https://github.com/Get-Concord-AI/concord-mcp/blob/d2408b0cbce5c24f9fd85ead5ec23522fbeea0e3/README.md#L187-L189"
