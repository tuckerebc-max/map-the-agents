        "slc_7f06aa71d082e13b2e3e177cb7f6d7aa394813d6be797ac6f7611ff308292b79"
      ],
      "text": "Environments are built by starting from a Base environment and adding environment modules (e.g. Boxes, Ramps, RandomWalls) plus wrappers on top."
    },
    {
      "basis": "documented",
      "claim_id": "clm_bfd55558b2797e345d4754e919f217eae47040b6d3a52a358dfc8681f15957a8",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "bafaf1e11e6398624116761f91ae7c93b136f395",
          "git_sha": "ef8ad41f8bad62d0ac99c3f0f922279521fa43ba",
          "line_end": 20,
          "line_start": 20,
          "path": "README.md",
          "repository": "openai/multi-agent-emergence-environments",
          "url": "https://github.com/openai/multi-agent-emergence-environments/blob/bafaf1e11e6398624116761f91ae7c93b136f395/README.md#L20-L20"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_80f16257ae02dd33508847cdcc583580e252bbd5ab6149614365ca6775df1b20"
      ],
      "text": "New objects or dynamics should be added via EnvModule classes (objects/sites, simulator changes) or gym.Wrapper classes (rewards, observations, game mechanics like Lock and Grab) rather than subclassing Base."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ac82ca8224b13346cfc243ee11ed2dc892d8069ce030a23f59cdb54ae230a169",
      "evidence_type": "organizational_statement",
