      "slice_ids": [
        "slc_25127b1aa72e727e1d681d4274e184e56cb143a7a6e74afff9eff1441e2275de"
      ],
      "text": "Defined environments include Hide and Seek (random rooms, quadrant, food variants), Box locking (Lock and Return, Sequential Lock), Blueprint Construction, and Shelter Construction."
    },
