          "git_sha": "65c7ff4a12473a6ee43633a9db33d64ceea3a6d1",
          "line_end": 155,
          "line_start": 137,
          "path": "README.md",
          "repository": "renaissance-innovation-labs/jacob-ai",
          "url": "https://github.com/Renaissance-Innovation-Labs/jacob-ai/blob/bd0e26461466991aee873f74896f4902387b9f47/README.md#L137-L155"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4032cc00c792d7b17db76bd24fde51109f81c43e034821dad2c64244a2d78a05"
      ],
      "text": "The GitHub app is configured with read/write permissions for issues, pull requests, and contents, and subscribes to issue, comment, and pull-request webhook events."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2c27258808a9bf7e8a25448ed04c259033351a8e07f1d5c350ca42ae17e05d91",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
      "locators": [
        {
          "commit": "bd0e26461466991aee873f74896f4902387b9f47",
          "git_sha": "65c7ff4a12473a6ee43633a9db33d64ceea3a6d1",
          "line_end": 111,
          "line_start": 111,
          "path": "README.md",
          "repository": "renaissance-innovation-labs/jacob-ai",
          "url": "https://github.com/Renaissance-Innovation-Labs/jacob-ai/blob/bd0e26461466991aee873f74896f4902387b9f47/README.md#L111-L111"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_478948417ee5b7ae2535d04f2c8b0e3a1b62e7182156a75972e278649be09d7f"
      ],
      "text": "The local version does not store the codebase; hosted logs with code snippets are retained 14 days, GitHub app tokens expire after 8 hours and are not saved in the database."
    }
