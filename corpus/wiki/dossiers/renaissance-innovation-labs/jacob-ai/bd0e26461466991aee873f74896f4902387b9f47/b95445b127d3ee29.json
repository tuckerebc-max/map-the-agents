        "slc_33fa7570333f4c0c7200aa69e14fbac7bf709f0b784b41f5008d798d5747dd0c"
      ],
      "text": "JACoB (Just Another Coding Bot) is an open-source AI tool that automates coding tasks, converts Figma designs into deployable code, and integrates into existing developer workflows."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2538c1f14f81963df1c6c74aff14b0b6a90b2f10dc8d72062f97a4d27f77b3c1",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "bd0e26461466991aee873f74896f4902387b9f47",
          "git_sha": "65c7ff4a12473a6ee43633a9db33d64ceea3a6d1",
          "line_end": 115,
          "line_start": 115,
          "path": "README.md",
          "repository": "renaissance-innovation-labs/jacob-ai",
          "url": "https://github.com/Renaissance-Innovation-Labs/jacob-ai/blob/bd0e26461466991aee873f74896f4902387b9f47/README.md#L115-L115"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2ad1998925b14541f7441c2046e8e9f989964a726871e5348a5072ed9ca56239"
      ],
      "text": "The product is delivered as a custom GitHub app, a Figma plugin, and a command-line tool for setting configuration options."
    },
    {
      "basis": "documented",
      "claim_id": "clm_599bedf9da939d82beae33cb7158bdb8e6372a56abf5a30df5bda5f52a81afbb",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "bd0e26461466991aee873f74896f4902387b9f47",
          "git_sha": "65c7ff4a12473a6ee43633a9db33d64ceea3a6d1",
          "line_end": 165,
          "line_start": 163,
          "path": "README.md",
          "repository": "renaissance-innovation-labs/jacob-ai",
          "url": "https://github.com/Renaissance-Innovation-Labs/jacob-ai/blob/bd0e26461466991aee873f74896f4902387b9f47/README.md#L163-L165"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_26132aa2054a408d20a922bf524fdd8cd527f6047c812fac6514f024d5b7efd6"
      ],
      "text": "Per-project behavior is configured via a jacob.config file generated with 'npx jacob-setup create', specifying project details and build environment variables."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2bc710bfd8367bb2936d2771ddc6cdce02d4d7a3cefbb4a8b731d51b42aaec53",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "bd0e26461466991aee873f74896f4902387b9f47",
          "git_sha": "65c7ff4a12473a6ee43633a9db33d64ceea3a6d1",
          "line_end": 123,
          "line_start": 119,
          "path": "README.md",
          "repository": "renaissance-innovation-labs/jacob-ai",
          "url": "https://github.com/Renaissance-Innovation-Labs/jacob-ai/blob/bd0e26461466991aee873f74896f4902387b9f47/README.md#L119-L123"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e64fab8479355d9cdf990d61ddecb4f0caf5d1f1ceda897470376cd13a3f7042"
      ],
      "text": "The codebase is built with Next.js, NextAuth.js, Tailwind CSS, tRPC, and Orchid ORM."
    },
    {
      "basis": "documented",
      "claim_id": "clm_903824559fd500c4aed7b7b4502c7ffbaf489ba004242c7225686ef040c5d4dd",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
