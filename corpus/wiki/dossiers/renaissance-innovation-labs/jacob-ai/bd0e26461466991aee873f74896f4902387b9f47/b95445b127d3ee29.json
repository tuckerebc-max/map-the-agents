      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_37ffe96c0a1e2ee5cf828f4262c74fca6da1b864cd62312ebe43f5c03bf70ec2"
      ],
      "text": "Due to context window and model constraints, JACoB targets smaller tasks and currently works best with TypeScript/JavaScript, Next.js, Tailwind, and Figma designs."
    },
    {
      "basis": "documented",
      "claim_id": "clm_75b2cac5faae10fe7601fc8c391ac8ea9a2934aee8b4693462ca61ae78e18e7a",
      "evidence_type": "organizational_statement",
      "facet": "evaluation",
      "kind": "observation",
      "locators": [
        {
          "commit": "bd0e26461466991aee873f74896f4902387b9f47",
          "git_sha": "65c7ff4a12473a6ee43633a9db33d64ceea3a6d1",
          "line_end": 72,
          "line_start": 72,
          "path": "README.md",
          "repository": "renaissance-innovation-labs/jacob-ai",
          "url": "https://github.com/Renaissance-Innovation-Labs/jacob-ai/blob/bd0e26461466991aee873f74896f4902387b9f47/README.md#L72-L72"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_f0928c8ddafcfdbdefbc66733480fd4d0e35f3ae959ca3f75b8c161b8bb98bb0"
      ],
      "text": "The team evaluated JACoB via the JACoB Arena, where developers compared it against top design-to-code tools and human benchmarks, reportedly outperforming seven such tools."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d2e035e901de65d314f66e3326889be2e9d24599a5816b1d786de0ade2291daf",
