          "repository": "renaissance-innovation-labs/jacob-ai",
          "url": "https://github.com/Renaissance-Innovation-Labs/jacob-ai/blob/bd0e26461466991aee873f74896f4902387b9f47/README.md#L127-L131"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_50a99b26496d3056c306050dd76a1a6bd734cc0cc5215733884562df3fc27c7a"
      ],
      "text": "Self-hosting requires GitHub and Figma accounts, Node.js, Docker and Docker Compose, an OpenAI account, and a PortKey account."
    },
    {
      "basis": "documented",
      "claim_id": "clm_612d0227e64f675cf51e48639a2ea475fada7ea45e3571d15ed8ab995fac05bb",
