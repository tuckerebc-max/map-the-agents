      "slice_ids": [
        "slc_a0fbf30fe8d83edea319ae09d3df7fbca884781a328bd978bf6377af7310a71e"
      ],
      "text": "Previews are produced by bundling each committed deployment with @cloudflare/worker-bundler and loading it through the Worker Loader binding; SpaceDO serves static assets while backend requests and WebSockets are forwarded to the generated App Facet."
    },
