      "slice_ids": [
        "slc_2182ff141de60d8cc3761e839c49aa076020c6669b3aab7825b6bf5a68db40a2"
      ],
      "text": "The persistence snapshot contains conversation_history, AgentExecutionContext, and optional AgentConfig; on restore the saved config is applied, unpaired tool results are handled automatically, and system prompts are re-injected by the agent as needed."
    },
