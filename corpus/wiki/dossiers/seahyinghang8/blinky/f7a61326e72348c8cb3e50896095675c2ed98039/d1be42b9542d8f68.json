        "slc_68afdf6fe4194c8f74fefb27bd937579631407bfea40cd27dd22afad52ae3e4f"
      ],
      "text": "Blinky is an open-source AI debugging agent for VSCode that uses LLMs to identify and fix backend code errors, inspired by SWE-agent."
    },
    {
      "basis": "documented",
      "claim_id": "clm_fdd4c468589c0f5e9eff42ce185abf525ac5033509b7bb3525336959c77e5bee",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "f7a61326e72348c8cb3e50896095675c2ed98039",
          "git_sha": "ce07e951230f7c14a4c30003523f8c0452493594",
          "line_end": 16,
          "line_start": 16,
          "path": "README.md",
          "repository": "seahyinghang8/blinky",
          "url": "https://github.com/seahyinghang8/blinky/blob/f7a61326e72348c8cb3e50896095675c2ed98039/README.md#L16-L16"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_8689fc647b00e73cee0e29a797a1d065b0a790d7efc22bd30b0a0fe3c15f543a"
      ],
      "text": "The agent leverages the VSCode API, the Language Server Protocol, and print statement debugging to triangulate bugs in real-world backend systems."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5a7c12c7943199fb22a78cbdc84a60c4be2c6f1e93433af0b6795ea3c7c1bdb8",
      "evidence_type": "organizational_statement",
