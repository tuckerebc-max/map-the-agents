      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c836d25fbaeb10859b1f219641ece108f889be6beda252f87e5abe47102ffb28"
      ],
      "text": "On first run the user is prompted for an OpenAI API key, which is stored locally in VSCode config for subsequent calls to OpenAI's server."
    },
