          "line_end": 49,
          "line_start": 49,
          "path": "README.md",
          "repository": "traycerai/traycer",
          "url": "https://github.com/traycerai/traycer/blob/b12949767727955f2b68546b772000c98d73e2b9/README.md#L49-L49"
