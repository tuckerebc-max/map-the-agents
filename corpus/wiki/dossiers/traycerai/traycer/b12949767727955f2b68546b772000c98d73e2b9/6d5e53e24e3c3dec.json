      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_07f3d0d55151574d6f850a8aa144e03aa2877c12ac3f6a43368fdde2e0b4c462"
      ],
      "text": "An agent is a durable session inside a Task that the user interacts with through a Chat or Terminal interface, powered by an underlying coding-agent provider."
    },
