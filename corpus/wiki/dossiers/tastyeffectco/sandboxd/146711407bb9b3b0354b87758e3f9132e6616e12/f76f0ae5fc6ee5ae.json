      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2ddf3a6f61bcdfadb59489d7420b114a474ca3aeed49557f3b9223bbe8f91d93",
        "slc_8dfda5094e337126cd5a1c8d77011849f3c9f6beee0ad48a98f316eaeb8f9490",
        "slc_e6400749a91ba1a968ffda78da997bd8a74df96cc78e905d1401cbb6b9d5fa63"
      ],
      "text": "Workspaces live under SANDBOXD_DATA_DIR/workspaces/<id> as bind mounts and survive stop and reboot; control-plane state is a SQLite file; the container writable layer is none (read-only rootfs) and /tmp is tmpfs, so only /home/sandbox is writable in-sandbox."
    },
    {
      "basis": "documented",
      "claim_id": "clm_468c5c1ae1ae6b478fc7ff3d1c29c1f008e0c5d7059cd5c600a6781644b11068",
