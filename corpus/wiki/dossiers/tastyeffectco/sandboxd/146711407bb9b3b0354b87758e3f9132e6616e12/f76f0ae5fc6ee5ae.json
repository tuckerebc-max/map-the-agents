        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_308153086e5efa7eb323d68d09951b80c176dc81640c6b6c96b73de8afa39cce",
        "slc_9440681256107780a727c90ccbdb3e64ce49fa81f2a4368c1aa4e0d01beaf62f"
      ],
      "text": "Running sandboxd requires Docker plus the Compose plugin and git on Linux (macOS via Docker Desktop is best-effort), runs natively on amd64 and arm64, and installs via a one-line curl script."
    },
    {
      "basis": "documented",
      "claim_id": "clm_75b5815b0090f20052326fae8ec7601288a8ef2a5e94d455fa4506bd6e8514b8",
