        "slc_b5d2750d1162877aa8328b0c27c47c17981fb6d68120929c268294a783537b21",
        "slc_e6a689bbbb66531d277cf3e321b4e813a888b4d0a7f00151268fadd7912ad363"
      ],
      "text": "sandboxd is an open-source, self-hosted AI app builder: a prompt causes a coding agent to build a real app in an isolated sandbox on the user's server, each app live at a preview URL."
    },
    {
      "basis": "documented",
      "claim_id": "clm_25c10b740f7138f0607433ae782c7879e69fb45e395fa2cecc99a2d2eec56cd4",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "146711407bb9b3b0354b87758e3f9132e6616e12",
          "git_sha": "3fa8a1a6e25c8e1b6e2c92cc2a731e0ad5abf11b",
          "line_end": 65,
          "line_start": 48,
          "path": "ARCHITECTURE.md",
          "repository": "tastyeffectco/sandboxd",
          "url": "https://github.com/tastyeffectco/sandboxd/blob/146711407bb9b3b0354b87758e3f9132e6616e12/ARCHITECTURE.md#L48-L65"
        },
        {
