          "git_sha": "2c1622da884a6b15b108f2f47eaa99b1da8ff58d",
          "line_end": 282,
          "line_start": 279,
          "path": "README.md",
          "repository": "tastyeffectco/sandboxd",
          "url": "https://github.com/tastyeffectco/sandboxd/blob/146711407bb9b3b0354b87758e3f9132e6616e12/README.md#L279-L282"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_455565c864a7b48753ee5d65de5e5a28ec3232d45aa4018751a106fb2f3e2ac4"
      ],
      "text": "The project is beta 0.x: isolation is containers rather than VMs, it is single-server, API auth is off by default, and breaking changes are expected before 1.0."
    },
    {
      "basis": "documented",
      "claim_id": "clm_27c2cdae83c088c029611f5af0bc7b75dd52ee21d0bfd1d820ef60ac1e2159b7",
