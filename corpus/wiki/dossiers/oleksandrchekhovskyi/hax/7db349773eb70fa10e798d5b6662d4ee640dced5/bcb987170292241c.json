          "line_end": 107,
          "line_start": 100,
          "path": "README.md",
          "repository": "oleksandrchekhovskyi/hax",
          "url": "https://github.com/OleksandrChekhovskyi/hax/blob/7db349773eb70fa10e798d5b6662d4ee640dced5/README.md#L100-L107"
