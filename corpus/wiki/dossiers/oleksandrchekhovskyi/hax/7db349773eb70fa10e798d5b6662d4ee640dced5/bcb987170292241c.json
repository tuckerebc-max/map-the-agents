      "slice_ids": [
        "slc_b4811475a2d14e1b7571aa74c4276b5a7b04d84bd4b739c2b47e6466c2a8acf5"
      ],
      "text": "The CLI supports an interactive REPL, one-shot `-p` prompts (including stdin input), `-c` to continue the latest session, and `--resume`/`--resume=ID` session selection."
    },
