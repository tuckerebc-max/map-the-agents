        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4191a5db5503dc2b9c3909eada515feb40347d380d37b330f549839a82173825"
      ],
      "text": "Security model: read-only tools are hard-enforced by the CLI permission layer by default; access is Discord channel membership plus optional user/role allowlists, and the persona's discouragement of leaking secrets is described as a soft layer only."
    },
