      ],
      "text": "README badges link the package to PyPI as claude-code-tools and to a Rust crate named aichat-search on crates.io."
    },
    {
      "basis": "documented",
      "claim_id": "clm_27202477a165f912b1e66bb9379a7f51e62d22ab118c365c9e88e760be7c5f7a",
