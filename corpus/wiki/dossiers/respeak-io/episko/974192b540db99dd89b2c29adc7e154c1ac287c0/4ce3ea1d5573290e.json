          "git_sha": "0e7e40f0dfa7cbc62342c3ae4839fd7adba54685",
          "line_end": 105,
          "line_start": 103,
          "path": "README.md",
          "repository": "respeak-io/episko",
          "url": "https://github.com/respeak-io/episko/blob/974192b540db99dd89b2c29adc7e154c1ac287c0/README.md#L103-L105"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a042382aed963ef1aeffdc986f1f730501e68543f3aac88fbef0d4ba1f306bed"
      ],
      "text": "Building from source requires Node.js 18+, pnpm, stable Rust with Tauri system dependencies, and at least one supported coding-agent CLI on PATH."
    },
    {
