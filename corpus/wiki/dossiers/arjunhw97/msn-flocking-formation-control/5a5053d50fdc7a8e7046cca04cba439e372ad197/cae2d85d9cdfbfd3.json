        "slc_0436171a4c0f2567975645afdbdbc9e07af31da39d4f7bcd3c134e22b7090b0d"
      ],
      "text": "The repository provides five MATLAB scripts, MSN1.m through MSN5.m, corresponding to five simulation cases described in the README."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c0abbf135c83887dc31ab5f8503f72ace13f868bf3da795b348c01970dd41108",
      "evidence_type": "organizational_statement",
