          "git_sha": "ffc987e1fa0093040c572dd9850f2de4ee98dbcb",
          "line_end": 14,
          "line_start": 10,
          "path": "README.md",
          "repository": "arjunhw97/msn-flocking-formation-control",
          "url": "https://github.com/arjunhw97/MSN-Flocking-Formation-Control/blob/5a5053d50fdc7a8e7046cca04cba439e372ad197/README.md#L10-L14"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5497480c2d08cda3b50da9230d320dd4034df25a3fa79be0af25ab55b521fd42"
      ],
      "text": "Simulations use 100 sensor nodes in 2 dimensions with a desired inter-node distance of 15 and interaction range r = k*d where k = 1.2."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7e29e9a69ee470133f85bdeb9ad0a0b1807d34ec2269fbf58dc650f932bf52b1",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
      "locators": [
        {
          "commit": "5a5053d50fdc7a8e7046cca04cba439e372ad197",
          "git_sha": "ffc987e1fa0093040c572dd9850f2de4ee98dbcb",
          "line_end": 14,
          "line_start": 10,
          "path": "README.md",
          "repository": "arjunhw97/msn-flocking-formation-control",
          "url": "https://github.com/arjunhw97/MSN-Flocking-Formation-Control/blob/5a5053d50fdc7a8e7046cca04cba439e372ad197/README.md#L10-L14"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5497480c2d08cda3b50da9230d320dd4034df25a3fa79be0af25ab55b521fd42"
      ],
      "text": "Epsilon is set to 0.1 and Delta_t to 0.009; the README notes these two parameters are optional and can be changed by the user."
    },
    {
      "basis": "documented",
      "claim_id": "clm_9523ab7623bc22587094a9061d33898d4d48dca72cf06ed0e642edf3e6f64389",
      "evidence_type": "organizational_statement",
