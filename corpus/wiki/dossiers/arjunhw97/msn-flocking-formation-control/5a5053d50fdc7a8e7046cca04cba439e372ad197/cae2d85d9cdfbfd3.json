      ],
      "text": "Case 1 (MSN1.m) simulates MSN fragmentation: it generates a connected 100-node network in a 50x50 area, plots the initial deployment, and links neighboring nodes with lines."
    },
    {
      "basis": "documented",
      "claim_id": "clm_096ac87fd6ba05a5437b26d04b4be8b3084590d2de1643424f6a772183c4173e",
      "evidence_type": "organizational_statement",
