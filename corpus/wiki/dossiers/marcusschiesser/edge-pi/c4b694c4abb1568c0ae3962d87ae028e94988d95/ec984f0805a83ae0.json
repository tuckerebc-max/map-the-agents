          "line_end": 5,
          "line_start": 5,
          "path": "README.md",
          "repository": "marcusschiesser/edge-pi",
          "url": "https://github.com/marcusschiesser/edge-pi/blob/c4b694c4abb1568c0ae3962d87ae028e94988d95/README.md#L5-L5"
        }
