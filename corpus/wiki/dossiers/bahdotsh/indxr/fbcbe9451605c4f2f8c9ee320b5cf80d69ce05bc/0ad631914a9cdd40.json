      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_897ed27ea9e4134d898e8f2c425e32a1fe79301a8ca39891ce244049e7018b9e"
      ],
      "text": "Cache validation is two-tier: a quick mtime+size check, with an xxh3 content-hash fallback for cases like touch where metadata changed but content did not."
    },
