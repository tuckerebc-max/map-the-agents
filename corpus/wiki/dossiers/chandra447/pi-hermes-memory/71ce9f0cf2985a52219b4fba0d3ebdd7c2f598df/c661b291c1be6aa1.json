      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_62932d9019e1d2fe93cb42ede3171c0246fdd477821ff23dda90a569662bc4c8"
      ],
      "text": "Memory blocks are wrapped in <memory-context> XML tags with a guard note stating they are not new user input, to prevent the model from treating stored facts as instructions."
    },
