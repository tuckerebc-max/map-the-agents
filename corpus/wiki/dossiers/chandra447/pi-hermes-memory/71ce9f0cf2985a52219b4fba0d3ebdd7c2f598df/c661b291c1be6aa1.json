      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_fe632a7a9ef6267fe044e717dfb36d049137471993fdab101be43f3b79e984c0"
      ],
      "text": "By default full Markdown memories are not injected into the system prompt; instead a <memory-policy> block tells the agent when to call memory_search, keeping first-turn token usage low."
    },
