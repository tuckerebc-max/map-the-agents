          "git_sha": "68bef0a01b340d92974632ff76ff3e8dabeff517",
          "line_end": 49,
          "line_start": 49,
          "path": "README.md",
          "repository": "trypromptly/llmstack",
          "url": "https://github.com/trypromptly/LLMStack/blob/701348426fadd0536de8b72536216a9c0365f25b/README.md#L49-L49"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_04da9bceecaa7add63a3b3a7ca7d1a9244cc74b84124c4b7e07a0a68a421396e"
      ],
      "text": "Users can add provider API keys (e.g., OpenAI, Cohere, Stability) from the Settings page, and instance-wide default keys can be placed in ~/.llmstack/config."
    },
