          "git_sha": "68bef0a01b340d92974632ff76ff3e8dabeff517",
          "line_end": 47,
          "line_start": 47,
          "path": "README.md",
          "repository": "trypromptly/llmstack",
          "url": "https://github.com/trypromptly/LLMStack/blob/701348426fadd0536de8b72536216a9c0365f25b/README.md#L47-L47"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e862bd0f1acf870220c3c3deb2c6d38ca694aa8d99a9c510f7cedfdf0fc23975"
      ],
      "text": "On first run, LLMStack creates a .llmstack directory in the user's home containing the database and config files, and opens a browser to localhost:3000."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0a07b35a56a0f57322a1746e31a04a4f7e830143b96e43f6fd478f995cae9dc2",
