        "slc_f364e135c5535d65e58b0eba8944dfc72419e93fee943ad01cc44a8549acae4f"
      ],
      "text": "LLMStack is installed with 'pip install llmstack' and started with the 'llmstack' command; Windows users are directed to use WSL2."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2dbc34207ae0368104e2bfaa4082f44e4af937ff016853c7d24822901db97bb7",
      "evidence_type": "organizational_statement",
