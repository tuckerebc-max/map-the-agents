      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_f34d335dca4d42c29d9ac67a675871956f8bc6287ac9cc0acedecbd7debcf22f",
        "slc_fddcd6c7f8885ad95db08ce3581ff3f2402b3638a192f5a77f52ac48af77b66f"
      ],
      "text": "Apps and chatbots built with LLMStack are accessible via an HTTP API, and AI chains can be triggered from Slack or Discord."
    },
    {
      "basis": "documented",
      "claim_id": "clm_529ae893abf637d42048e603b9c207f5a9539308ae2a8d90d45978902fa8b581",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
