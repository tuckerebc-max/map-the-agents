      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_cd4393dfc2b51c7a3462cef6b5f2899a443b28023d1430ba7a88f6865b59c9b7"
      ],
      "text": "The Rust core includes tree-sitter parsing for ~30 languages, symbol/call-graph computation, diff/format/backup, an LSP client, trigram index, and semantic index."
    },
