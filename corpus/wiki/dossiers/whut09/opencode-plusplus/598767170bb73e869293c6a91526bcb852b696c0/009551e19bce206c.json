      "slice_ids": [
        "slc_cab66952cf84209e62067fde3ba259384c2b97b9fe3f36fc67d086380f24f009"
      ],
      "text": "Documented MCP tools include opencode_plusplus_build, plan, pack, retrieve, tests, impact, verify, and explain, plus experimental runtime loop tools for start/evaluate/repair/finalize flows."
    },
