      "slice_ids": [
        "slc_eab3877c8f24635267950a8d3891f4219c6efe51405bf359b2300287991c9933"
      ],
      "text": "The default encryptor cannot handle numbers greater than 400, so calculation results must stay within 0 to 400 inclusive; the limit is configurable in HE_data/HE_data.py."
    },
