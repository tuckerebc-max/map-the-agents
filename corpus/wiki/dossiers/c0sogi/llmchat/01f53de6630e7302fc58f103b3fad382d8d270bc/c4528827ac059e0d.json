        "slc_b419cbce21c93601a3ad62a7f48f236af61297ae74e8b33a0bd148e3e7dfec39",
        "slc_d5a5b40baf084a3040f49029d876969006fe71464b9be0cd5d62573e3baaf1e4",
        "slc_ef4330726a25e74dc2656cd6f6144c0b824626a546f3bcde6fbb2a6ea8673dfb"
      ],
      "text": "Three LLM model types are supported: OpenAIModel (async chat completions via the OpenAI API), LlamaCppModel (local GGML .bin files), and ExllamaModel (local GPTQ model folders), all defined as LLMModel subclasses in app/models/llms.py."
    },
