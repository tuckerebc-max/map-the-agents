      ],
      "text": "VT Code is described as a secure, open-source terminal coding agent written in Rust, shipped as a single static binary for interactive and long-running autonomous work."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6e5dbab108180acb00e3375600d1ea7b54fd606a3842be6720d12cccf0297428",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
