      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_0202ada36b181f903584c9ff9b42599993f13e72897e3cfaffede729488b3af4",
        "slc_55b2879ff7548d230fb7e73f42f23bfaac75e967eaa4fd0ba8bd85daa688c99f"
      ],
      "text": "All application state lives in a single `App` struct with methods split across `app/*.rs` impl blocks; UI rendering functions take `&App` and never mutate state, which happens only in `app/` methods."
    },
    {
      "basis": "documented",
      "claim_id": "clm_05fb9e66743f1c5906fefab6582e25832e4ffdffc4ce4e6aaf9ef9ab2b5a2091",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
