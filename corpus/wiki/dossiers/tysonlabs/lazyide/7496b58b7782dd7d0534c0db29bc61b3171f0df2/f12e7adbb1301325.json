      "slice_ids": [
        "slc_7864c5c664dc4267f156ce3b2fa3947c25633490518264ca70a7ad3c873aeff6"
      ],
      "text": "Syntax highlighting is line-at-a-time keyword/string/comment matching with bracket depth tracking, not AST-based, covering 11 language families detected by file extension."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d7ef6ef6e84a4172b22e75b24420486d37da5349677f73d5f43fb7dc89796ef8",
