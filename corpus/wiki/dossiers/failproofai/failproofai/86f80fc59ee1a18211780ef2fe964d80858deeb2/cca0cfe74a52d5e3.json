        "slc_722ce834e26f2b89e6f25040d4e70e1371d70b5a3ac68bf9b39b0fe6cd39cd36",
        "slc_f01b6c01851df78b308680ea61f5b4a2878520757c57fc49f7a089c6f4f7ef96"
      ],
      "text": "Custom policies are registered via a customPolicies.add() API from the failproofai package, matching events such as PreToolUse and receiving a context with tool input."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a9cf62070de819442d116355e30a898ccbb653a3c9347fc4334913a7de2f37b0",
      "evidence_type": "organizational_statement",
