          "line_end": 158,
          "line_start": 149,
          "path": "README.md",
          "repository": "failproofai/failproofai",
          "url": "https://github.com/FailproofAI/failproofai/blob/86f80fc59ee1a18211780ef2fe964d80858deeb2/README.md#L149-L158"
        },
        {
          "commit": "86f80fc59ee1a18211780ef2fe964d80858deeb2",
          "git_sha": "636d2666bd3f24622e247b3b741143aed0c0ac72",
          "line_end": 143,
          "line_start": 143,
          "path": "README.md",
          "repository": "failproofai/failproofai",
          "url": "https://github.com/FailproofAI/failproofai/blob/86f80fc59ee1a18211780ef2fe964d80858deeb2/README.md#L143-L143"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4969eba81462601b04009136272519555fedf345e61bc86ff6ce8b040a7a40d8",
        "slc_5e3aaf6ad6cad2855f727027b436b7c2cc8c6572bdfc0392c7e4ea2de35ae080"
      ],
      "text": "39 built-in policies ship with the tool and activate immediately on install; examples include blocking .env reads, sudo, rm -rf, force pushes, destructive SQL, and unreviewed terraform/kubectl changes."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1c0982328557c797273d1738618266d07074dd42a3e37ed058b3b50e31e6d8fd",
      "evidence_type": "organizational_statement",
