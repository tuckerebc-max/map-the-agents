      "slice_ids": [
        "slc_42c35fe291c4b978c03655a9aee73f3fee65be6391848be6ca4949cbd1f27e17"
      ],
      "text": "Custom policies are JS files dropped into .failproofai/policies/ that load automatically without flags, and can be committed so the whole team receives them on pull."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f9e3d7d8905aedd84a24c98a4568e3545b84f73a5ec20252c1965974e3aeb891",
