      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
          "commit": "23a69227e3380e6b44a7ebd93c52e023c59f17c3",
          "git_sha": "23bce6e2a2e83612581f9eb7f838f78121e5d17f",
          "line_end": 111,
          "line_start": 109,
          "path": "README.md",
          "repository": "vercel-labs/deepsec",
          "url": "https://github.com/vercel-labs/deepsec/blob/23a69227e3380e6b44a7ebd93c52e023c59f17c3/README.md#L109-L111"
        },
        {
