        "slc_1429a8d614a2782db7cc60095d0448ed8ebe3e353a06c6ebd387eeb41e0d0ea2"
      ],
      "text": "The project is described as backend-as-a-service infrastructure for the AI era, versioned 1.0.0 and licensed under Apache 2.0."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0464457376fa17c1689b1f07a13a52ae25ede9fc3af2ee218ef9bb304c27e33b",
      "evidence_type": "organizational_statement",
