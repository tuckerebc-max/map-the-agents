      "slice_ids": [
        "slc_2093e3099d195a2b7582e1a1aea6cd41c450b9b2d14e1349d18afe1c37da3710"
      ],
      "text": "Postgres stores catalog, tool cache, findings, and the durable job queue; Redis holds cross-process query locks and the pool ledger, and the server refuses to boot if either is unreachable."
    },
