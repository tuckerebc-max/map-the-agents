        {
          "commit": "63db0e2736d235032dd82207b84c00cf5f296ffc",
          "git_sha": "5c0558d632e90f365ba3904b1713389b1c007d36",
          "line_end": 862,
          "line_start": 855,
          "path": "README.md",
          "repository": "aozyildirim/agena",
          "url": "https://github.com/aozyildirim/Agena/blob/63db0e2736d235032dd82207b84c00cf5f296ffc/README.md#L855-L862"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e5226d1d01982b19a0996340cc1d155572e453bbde678ed42e65a1b1c39b2828"
      ],
      "text": "Agent roles are mapped to model tiers: Context Analyst and Finalizer use a small fast model, while PM, Planner, Reviewer use large reasoning models and the Developer uses a large model with 128K output."
    },
