      "slice_ids": [
        "slc_2151cc20cbcd29d3d268a11b18780bb958537d475b557b597232603c0a84f4e5"
      ],
      "text": "The build script targets macOS by default because it uses the system-installed Noto Sans Myanmar font; on other OSes the regular and bold TTF files must be placed manually in build/."
    },
