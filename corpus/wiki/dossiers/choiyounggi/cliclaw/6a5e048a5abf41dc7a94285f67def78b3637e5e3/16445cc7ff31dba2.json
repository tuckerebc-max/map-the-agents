        "slc_1d4a925e4f79a5a5d5808617498342d39a98b0ad8f23ff98d6b914abc6429b58"
      ],
      "text": "In Telegram, slash commands switch the active agent, show status/health, stop jobs, reset sessions, toggle safety, set model overrides, and toggle Claude plan mode; other text or photos are sent as prompts."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f773ff00213ac273eabbc940dd3f09365ffb3721635ff6402d05c11660b67429",
      "evidence_type": "organizational_statement",
