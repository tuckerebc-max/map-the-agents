          "line_end": 140,
          "line_start": 127,
          "path": "README.md",
          "repository": "choiyounggi/cliclaw",
          "url": "https://github.com/choiyounggi/cliclaw/blob/6a5e048a5abf41dc7a94285f67def78b3637e5e3/README.md#L127-L140"
