          "git_sha": "136e92d12e7a759bd9beb6c5365ad6e358473704",
          "line_end": 211,
          "line_start": 208,
          "path": "README.md",
          "repository": "choiyounggi/cliclaw",
          "url": "https://github.com/choiyounggi/cliclaw/blob/6a5e048a5abf41dc7a94285f67def78b3637e5e3/README.md#L208-L211"
