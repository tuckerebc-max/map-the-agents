        "slc_52a5525f88e9bf9c63b3fed279316eddb29ebeb7bea37a88329237a9ee78eff6"
      ],
      "text": "The CLI supports options including `--acp`, `--stdin`, `--json`, `-p/--prompt`, `--sandbox-mode`, `--session`, `--profile`, `--thinking`, and `--doctor`."
    },
