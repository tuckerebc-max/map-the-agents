      ],
      "text": "StemCode ships as a desktop app, a `stemcode` terminal command, VS Code and Visual Studio extensions, and an ACP-compatible editor server."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d975a0b6cdce10dfefc6859497e00509664da66c578689ee0e97c5b38c0e4316",
