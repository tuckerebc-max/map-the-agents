      "slice_ids": [
        "slc_733cf886263e0a7eef45a5f720e0de75e39bc84fdb7fa4bb4ca8d2bd5da2b7a2"
      ],
      "text": "The Discord bot configuration guide is described as basic, and running the Discord bots in production is stated to be at the user's own risk with permissions to be optimized as needed."
