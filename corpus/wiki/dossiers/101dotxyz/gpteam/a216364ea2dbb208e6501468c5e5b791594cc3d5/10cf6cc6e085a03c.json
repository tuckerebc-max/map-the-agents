          "git_sha": "ee58abba8d45052ad5db412bca6c2148d10c9e1b",
          "line_end": 22,
          "line_start": 11,
          "path": "DISCORD.md",
          "repository": "101dotxyz/gpteam",
          "url": "https://github.com/101dotxyz/GPTeam/blob/a216364ea2dbb208e6501468c5e5b791594cc3d5/DISCORD.md#L11-L22"
        },
        {
          "commit": "a216364ea2dbb208e6501468c5e5b791594cc3d5",
          "git_sha": "ee58abba8d45052ad5db412bca6c2148d10c9e1b",
          "line_end": 49,
          "line_start": 33,
          "path": "DISCORD.md",
          "repository": "101dotxyz/gpteam",
          "url": "https://github.com/101dotxyz/GPTeam/blob/a216364ea2dbb208e6501468c5e5b791594cc3d5/DISCORD.md#L33-L49"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_0a73545aefb1354d7f38c9b74f744335f5ee29e240ebf43e6697d386f0701ca6",
        "slc_562c03330c4a84fde2741d5661db41494c9f46f1334e580a6ff58d326fa1ed6e"
      ],
      "text": "Discord setup requires channel IDs per location in .env as <LOCATION_NAME>_CHANNEL_ID and bot tokens as <BOT_FIRST_NAME>_DISCORD_TOKEN, with the announcer bot needing Message Content Intent enabled."
    },
