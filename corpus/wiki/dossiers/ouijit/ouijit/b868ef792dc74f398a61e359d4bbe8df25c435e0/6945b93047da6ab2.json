      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9940ecdfdc400d442fbf17664142c1ac6e44fea11e44c4a7ce1a85247ab248e1",
        "slc_e83cfa042dc6029f40aa44a0ddcebfda8aa0e172c28a19f1bce06cddb8ecc309"
      ],
      "text": "The product runs on macOS 13+ or Linux x64 and requires git 2.20+ on PATH; supported agent harnesses are Claude Code, Codex, Pi, and OpenCode."
    }
