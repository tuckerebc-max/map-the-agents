        "slc_bbb9953cbb01c6e3f32f3f093ee068dfc40d4a26f193ba655cf1a96a9e6af215"
      ],
      "text": "Ouijit is a task and terminal manager for running coding agents in parallel, where each task gets its own git worktree and terminal, with lifecycle hooks launching the agent CLI."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8a85cf2bcf2aadd90fbe7a07e04d205da3e44c728452a2d3cdba0e5086a94932",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
      "locators": [
        {
