      "slice_ids": [
        "slc_25807d0122c7d564dc4925f3db1e9ffa3766de6d112ffa6d6ae6137c9164ba88",
        "slc_68731cd7717d8c231946eff51d0ea012c06ffa2907578e0afb1b353e3def3b31",
        "slc_6d5464705351e2343ae6545377242d9f1f1a1c74eb11beb1a9ae131aabd4df05",
        "slc_9d124614eb96df768dd5f7a66f6a7070572c9dcca8cfa81d0233cc5668d73005",
        "slc_a068611223328909f08392c96715c3f4a2957f13040d733c64096dea3cbc471c",
        "slc_d646a862a40fe786e304d408356802804da8510108b64977ac63cc68617256dd"
      ],
      "text": "Looper is distributed as a GitHub Release Go binary and supports multiple agent vendor CLIs identified in config, including grok-build (invoked as grok), pi, and omp (Oh My Pi), alongside codex and claude-code shown in examples."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2b03def758431262b11849f0b9fd44e81d202d45fd90289d0a7f511fdeac6c2a",
      "evidence_type": "organizational_statement",
