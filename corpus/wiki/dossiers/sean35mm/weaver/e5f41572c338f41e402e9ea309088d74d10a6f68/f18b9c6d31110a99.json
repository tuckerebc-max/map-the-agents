        {
          "commit": "e5f41572c338f41e402e9ea309088d74d10a6f68",
          "git_sha": "6765c3a259cc8846310367a64cca740478159266",
          "line_end": 176,
          "line_start": 172,
          "path": "README.md",
          "repository": "sean35mm/weaver",
          "url": "https://github.com/sean35mm/weaver/blob/e5f41572c338f41e402e9ea309088d74d10a6f68/README.md#L172-L176"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6ef740920d386cbed8a0719238af6e858ab01886cd7fa956a0cef9e4ceb1335f"
      ],
      "text": "Claims are advisory and TTL-bound; a claim exit code 1 means the claim was recorded with an overlap found, and different-worktree overlaps are informational because files are isolated."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b86c7a3a42e7f0968cb408ad731d76a3734209fec33e6c1431013648f560a94a",
