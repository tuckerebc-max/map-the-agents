      "kind": "observation",
      "locators": [
        {
          "commit": "e5f41572c338f41e402e9ea309088d74d10a6f68",
          "git_sha": "6765c3a259cc8846310367a64cca740478159266",
          "line_end": 94,
          "line_start": 92,
          "path": "README.md",
          "repository": "sean35mm/weaver",
          "url": "https://github.com/sean35mm/weaver/blob/e5f41572c338f41e402e9ea309088d74d10a6f68/README.md#L92-L94"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_02bf4000ab7c378e86506bb8be5445a4295f70c11fec03469a5d42fba3403803"
      ],
      "text": "Every scratchpad mutation creates a revision, and passing --revision prevents a stale writer from replacing a newer edit."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8f8801ef03dd66024c5b3eec22051d56413b3aa7dba68620ae27c6b291cc81b5",
