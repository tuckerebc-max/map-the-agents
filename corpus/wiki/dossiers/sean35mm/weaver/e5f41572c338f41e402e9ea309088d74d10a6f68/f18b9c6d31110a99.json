      "slice_ids": [
        "slc_91aa735d8d1b4c33eaa6dd2014e1881c716d2a6c7c623e157aa492f228dee959"
      ],
      "text": "The self-contained binary supports macOS and Linux on arm64/x64 (WSL2 on Windows), installs to ~/.local/bin/weaver, and requires no Node, npm, server, or account."
    },
