        "slc_390c59e04da5f5fce453bb5f4a5322b032cb5defd87fbc0ae08ff78120349e5d"
      ],
      "text": "Weaver is a CLI over a local SQLite store with no cloud account, remote sync, coordination daemon, or MCP server; Git stays authoritative for code and the CLI for coordination."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8418c0ab7953e285b5cc16510a2b493aa0a851a23d27afc7374613c42d5d3595",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "e5f41572c338f41e402e9ea309088d74d10a6f68",
          "git_sha": "6765c3a259cc8846310367a64cca740478159266",
          "line_end": 16,
          "line_start": 13,
          "path": "README.md",
          "repository": "sean35mm/weaver",
          "url": "https://github.com/sean35mm/weaver/blob/e5f41572c338f41e402e9ea309088d74d10a6f68/README.md#L13-L16"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_81602d9851e162962adbda914ec9b2e21850d28fd2ffce9c5ef1a38d436fcded"
      ],
      "text": "The product provides a status→task→claim→done coordination loop, live sessions, advisory file claims, recent activity, optional Markdown scratchpads, and durable Repository Facts."
    },
    {
      "basis": "documented",
      "claim_id": "clm_73e7cdb88e75296202af70f403b799f451e874f4c5f6ac3e799a0f00491e6068",
