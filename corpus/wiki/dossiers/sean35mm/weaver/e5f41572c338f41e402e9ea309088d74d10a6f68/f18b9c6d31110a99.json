          "git_sha": "6765c3a259cc8846310367a64cca740478159266",
          "line_end": 222,
          "line_start": 210,
          "path": "README.md",
          "repository": "sean35mm/weaver",
          "url": "https://github.com/sean35mm/weaver/blob/e5f41572c338f41e402e9ea309088d74d10a6f68/README.md#L210-L222"
