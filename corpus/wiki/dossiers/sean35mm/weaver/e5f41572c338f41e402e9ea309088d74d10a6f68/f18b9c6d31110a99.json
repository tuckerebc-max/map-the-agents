      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_697fd324dacd1c4c11caa50a79867ffec57f0d641f4ae1d38713a494a6fc50d0"
      ],
      "text": "Stores live under ~/.weaver/ with one SQLite database per repository identity; scratchpads, facts, intents, and reasons are plaintext local data, and there is no telemetry."
    },
    {
      "basis": "documented",
      "claim_id": "clm_df5f37479e54adc8e9ff5573202bad5481d3630b5b002defafb70c7ce6628c6b",
