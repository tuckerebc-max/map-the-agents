      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e260d7d34e2fb2860f46cd6883e717c715cee5ec766b6ddcbd8cacc0be1c7500"
      ],
      "text": "With GITHUB_TOKEN set, a background PR watcher polls every 30 seconds; CI failures and changes-requested reviews automatically become follow-up tickets via the scheduler's dynamic enqueue."
    },
