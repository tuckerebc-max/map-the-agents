          "git_sha": "8c40b294cad8457fc7d2a3bdfbfe57cc1e8cc6be",
          "line_end": 412,
          "line_start": 412,
          "path": "README.md",
          "repository": "jcast90/relay",
          "url": "https://github.com/jcast90/relay/blob/7bd5a2f6a13ce62db53ca3c55f2a7ef89e36e710/README.md#L412-L412"
