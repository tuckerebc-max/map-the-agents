      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5f0d8ebe2592a69379e2d9c0f413583a6f10870c1077b9eb3069c8d7c28d58c1"
      ],
      "text": "The project is explicitly beta, pre-v1: APIs, CLI flags, ~/.relay file layouts, and GUI surfaces may change between releases, and users are asked to file issues with reproductions."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8d50777bac5605ed996fa4541a6b0736ec19d107bbfb7bef67216446e9acbed2",
