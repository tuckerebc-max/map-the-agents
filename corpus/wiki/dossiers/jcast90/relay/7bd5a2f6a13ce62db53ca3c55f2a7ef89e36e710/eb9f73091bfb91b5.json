          "commit": "7bd5a2f6a13ce62db53ca3c55f2a7ef89e36e710",
          "git_sha": "8c40b294cad8457fc7d2a3bdfbfe57cc1e8cc6be",
          "line_end": 228,
          "line_start": 221,
          "path": "README.md",
          "repository": "jcast90/relay",
          "url": "https://github.com/jcast90/relay/blob/7bd5a2f6a13ce62db53ca3c55f2a7ef89e36e710/README.md#L221-L228"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d628a0a99e5c8a027d908590b94fd1e244e330a3589ae73625635d5d03bf7647"
      ],
      "text": "Requests are classified into complexity tiers (trivial, bugfix, feature_small, feature_large, architectural, multi_repo); feature_large and above require user approval via MCP, while trivial/bugfix use heuristic matching."
    },
    {
      "basis": "documented",
      "claim_id": "clm_267e21a505cb5abef02ee8f841ccdfb8a8740d84c77d14dce9e13e08312c6011",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
