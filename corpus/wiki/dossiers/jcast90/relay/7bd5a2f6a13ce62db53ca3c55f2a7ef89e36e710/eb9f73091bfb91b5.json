        "slc_7e57ce6acf4a4f10e307c5ad3d0ce5dc932f27bbe4637ae9a97ad69716fb2088"
      ],
      "text": "Relay converts a sentence, GitHub issue URL, or Linear ticket into a running plan: classify, plan, decompose into a ticket DAG, dispatch to Claude or Codex agents, verify, open a PR, and track until merged."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4aefb87951f21dc0d7829388b0bacb848c124ea3a88729e01b3c94d880463286",
