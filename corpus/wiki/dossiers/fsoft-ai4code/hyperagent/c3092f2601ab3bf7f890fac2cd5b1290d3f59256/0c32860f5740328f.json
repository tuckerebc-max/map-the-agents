          "line_end": 30,
          "line_start": 28,
          "path": "README.md",
          "repository": "fsoft-ai4code/hyperagent",
          "url": "https://github.com/FSoft-AI4Code/HyperAgent/blob/c3092f2601ab3bf7f890fac2cd5b1290d3f59256/README.md#L28-L30"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6436e99ecd50f5c882151cb2ebee0470d1daf7d6d488148fb4b4466cb2b1d148"
      ],
      "text": "Reported results include 31.4% resolved rate on SWE-Bench Verified and 25% on SWE-Bench Lite, with verification noted as in progress via a swe-bench experiments PR."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e3bf6bdbc6792c3b5d15c8bfd7195699ce4086a4aab582a99d3f60053134bf29",
      "evidence_type": "organizational_statement",
      "facet": "evaluation",
