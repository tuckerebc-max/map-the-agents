        "slc_e647615b51da790d9894d0048161adf1e915e2c799c4e919055c3af51c619174"
      ],
      "text": "HyperAgent is described as a generalist multi-agent system for a wide range of software engineering tasks across programming languages, mimicking human developer workflows."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0d4acf8c87ce6457c0b4373cb82e21077c86bb58297f90ec4fc45e2218f7497f",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
