        {
          "commit": "c3092f2601ab3bf7f890fac2cd5b1290d3f59256",
          "git_sha": "13899106f41ad21dd3623c742519c10804cf8ce3",
          "line_end": 24,
          "line_start": 24,
          "path": "README.md",
          "repository": "fsoft-ai4code/hyperagent",
          "url": "https://github.com/FSoft-AI4Code/HyperAgent/blob/c3092f2601ab3bf7f890fac2cd5b1290d3f59256/README.md#L24-L24"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e647615b51da790d9894d0048161adf1e915e2c799c4e919055c3af51c619174"
      ],
      "text": "The system comprises four specialized agents: Planner, Navigator, Code Editor, and Executor, covering the SE task lifecycle from conception to verification."
    },
    {
      "basis": "documented",
      "claim_id": "clm_fb55657a2a5b8644cfd58327bb594ea822280b175d65f8f262ddb208b409164c",
      "evidence_type": "organizational_statement",
      "facet": "evaluation",
      "kind": "observation",
      "locators": [
        {
          "commit": "c3092f2601ab3bf7f890fac2cd5b1290d3f59256",
