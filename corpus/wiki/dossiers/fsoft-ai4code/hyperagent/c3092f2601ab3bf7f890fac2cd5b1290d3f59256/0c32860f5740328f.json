      "locators": [
        {
          "commit": "c3092f2601ab3bf7f890fac2cd5b1290d3f59256",
          "git_sha": "13899106f41ad21dd3623c742519c10804cf8ce3",
          "line_end": 115,
          "line_start": 80,
          "path": "README.md",
          "repository": "fsoft-ai4code/hyperagent",
          "url": "https://github.com/FSoft-AI4Code/HyperAgent/blob/c3092f2601ab3bf7f890fac2cd5b1290d3f59256/README.md#L80-L115"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_86e389cd06f65b90a69afebe0292bca4217b9dfd23e1949048e51d3d3b4b0e15"
      ],
      "text": "Agent configuration is per-role: the config dict keys nav, edit, exec, and plan each take model settings (e.g., Claude models with API keys, stop sequences, base URLs), plus a 'type' field such as 'patch'."
    },
    {
