        "slc_5cb9a6c04b4c1cd5ec357d5aba6165f3339c7df20886c324e9430407db0e9746"
      ],
      "text": "dux is a terminal UI that runs multiple AI coding agents side by side, each in its own git worktree, with companion terminals, macros, commit generation, and a command palette."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f90c6ce639f60c5dd3541de2e4ee89d90a6a0a0ee12c1c17ab004db824b8c024",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "14e044d616d205a5ef1d030978c55337a812fa04",
          "git_sha": "d21669be4f3cb7c4fea1ecc2c1a1fdb6a72db29c",
          "line_end": 19,
          "line_start": 19,
          "path": "README.md",
          "repository": "patrickdappollonio/dux",
          "url": "https://github.com/patrickdappollonio/dux/blob/14e044d616d205a5ef1d030978c55337a812fa04/README.md#L19-L19"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_de71c88a76fa000d5c5cc9a4904bae28fb88e01709185affa7fd56bf4207d176"
      ],
      "text": "Agents run through a PTY like a normal shell, so CLIs such as Claude, Codex, or OpenCode behave as they would in a regular terminal, including MCP servers, hooks, and permission dialogs."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ff104f5610089b2d526b76c26b365dd298cdceffa6c8e9027d34ce441cfb190d",
      "evidence_type": "organizational_statement",
      "facet": "components",
