          "line_end": 83,
          "line_start": 81,
          "path": "README.md",
          "repository": "patrickdappollonio/dux",
          "url": "https://github.com/patrickdappollonio/dux/blob/14e044d616d205a5ef1d030978c55337a812fa04/README.md#L81-L83"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_b590638af391e0fccd136235e2e6af6926679d423dcb536cfb68584af9448a8d"
      ],
      "text": "The interface has three panes: projects and agent sessions on the left, the agent's live terminal output or diff in the center, and changed files, staging, and diffs on the right."
    },
