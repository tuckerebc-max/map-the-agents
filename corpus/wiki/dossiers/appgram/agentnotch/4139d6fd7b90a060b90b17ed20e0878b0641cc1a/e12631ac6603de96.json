      ],
      "text": "AgentNotch is a macOS menu bar app that lives in the Mac's notch and shows real-time telemetry from Claude Code and OpenAI Codex sessions."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a513571ac9ce6d547062ef3a2b07ce169155c377278a04ae9f70bc1c4480a311",
      "evidence_type": "organizational_statement",
      "facet": "components",
