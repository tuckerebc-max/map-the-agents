          "line_end": 28,
          "line_start": 28,
          "path": "README.md",
          "repository": "appgram/agentnotch",
          "url": "https://github.com/AppGram/agentnotch/blob/4139d6fd7b90a060b90b17ed20e0878b0641cc1a/README.md#L28-L28"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_cf950dfecabd5e30d808792a7645385f98ff1ff036aff5ac81862351df374cf5"
      ],
      "text": "The app displays each tool call as it happens, including file reads, code edits, and shell commands."
    },
