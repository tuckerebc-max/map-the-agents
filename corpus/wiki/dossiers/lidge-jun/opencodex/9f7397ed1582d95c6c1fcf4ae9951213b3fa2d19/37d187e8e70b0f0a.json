      "slice_ids": [
        "slc_f256017381fb013544f02e633d86db4b9204bbd7c68e02c928e8eea4ae5e9c1c"
      ],
      "text": "By default the proxy binds to 127.0.0.1 without authentication; binding beyond loopback requires OPENCODEX_API_AUTH_TOKEN, which every client request must carry as the `x-opencodex-api-key` header."
    },
