          "git_sha": "f7ea0552ae6104bdc33d0608bf0a05243afe01ae",
          "line_end": 89,
          "line_start": 89,
          "path": "readme.md",
          "repository": "exafunction/codeium-react-code-editor",
          "url": "https://github.com/Exafunction/codeium-react-code-editor/blob/768e1b231c00e078c86bc19c8ede697a1e37ec75/readme.md#L89-L89"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_7bc8739e0e5c3872ec8540cbb1edcef5129df7d0198ca69b9705af3755111453"
      ],
      "text": "The otherDocuments prop accepts at most 10 documents, and a reranker runs behind the scenes to optimize what fits within the token limit."
    },
    {
      "basis": "documented",
      "claim_id": "clm_cd8c74774b504c476931c54742491eb4892ec8a6567132dead80ca772bbda81b",
