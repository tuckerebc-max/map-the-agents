          "line_end": 87,
          "line_start": 68,
          "path": "readme.md",
          "repository": "exafunction/codeium-react-code-editor",
          "url": "https://github.com/Exafunction/codeium-react-code-editor/blob/768e1b231c00e078c86bc19c8ede697a1e37ec75/readme.md#L68-L87"
        },
        {
          "commit": "768e1b231c00e078c86bc19c8ede697a1e37ec75",
          "git_sha": "f7ea0552ae6104bdc33d0608bf0a05243afe01ae",
          "line_end": 48,
          "line_start": 40,
          "path": "readme.md",
          "repository": "exafunction/codeium-react-code-editor",
          "url": "https://github.com/Exafunction/codeium-react-code-editor/blob/768e1b231c00e078c86bc19c8ede697a1e37ec75/readme.md#L40-L48"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4d25a700dcd7da7a19bef1298feee080f91d1c1d12d81896cc8603d28ed5a225",
        "slc_6222782e9696e45de01e436de21c10ce608cc6bcd5a4c662967aa01c2162ff59"
      ],
      "text": "CodeiumEditor accepts props including language, theme, and otherDocuments; the advanced example passes Document objects with absolutePath, relativePath, text, editorLanguage, and language fields."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3d68b89eeb7ca0ace8dfef8cda1d47cf28e26b400c0d0e66d3185f15cb4791a8",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
