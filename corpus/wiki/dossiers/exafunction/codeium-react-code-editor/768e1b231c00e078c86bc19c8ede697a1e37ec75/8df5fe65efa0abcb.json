          "url": "https://github.com/Exafunction/codeium-react-code-editor/blob/768e1b231c00e078c86bc19c8ede697a1e37ec75/readme.md#L109-L109"
        },
        {
          "commit": "768e1b231c00e078c86bc19c8ede697a1e37ec75",
          "git_sha": "f7ea0552ae6104bdc33d0608bf0a05243afe01ae",
          "line_end": 38,
          "line_start": 37,
          "path": "readme.md",
          "repository": "exafunction/codeium-react-code-editor",
          "url": "https://github.com/Exafunction/codeium-react-code-editor/blob/768e1b231c00e078c86bc19c8ede697a1e37ec75/readme.md#L37-L38"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5fb839d775a1d1d85a82a32cd90b30ac6c53bd17242a38cdddb8d5968df0db0d",
        "slc_e68056d5e8a35bf32049251489f697d59a4d1156d744d0f68d2530d1311c5d0b"
      ],
      "text": "The core editor API matches that of the wrapped Monaco React project, and the component is imported as CodeiumEditor from @codeium/react-code-editor."
    },
    {
      "basis": "documented",
      "claim_id": "clm_79cf43d90310a80bec6fe2b810d5b19168ea07c5bb26992abb41b85ff37c55fd",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
