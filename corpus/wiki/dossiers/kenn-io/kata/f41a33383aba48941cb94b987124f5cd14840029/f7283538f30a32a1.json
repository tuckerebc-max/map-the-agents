      "slice_ids": [
        "slc_442c955dd7cbf0796049350f64daf5441373a59278ceb7c017fe06f6efa9f137",
        "slc_b3a20587b1e0538665557753cc6e4a85418afbb80a869a78d37713ec57ecf6ff"
      ],
      "text": "Every state change appends to an immutable event log with the actor recorded; actors are free-form snapshots on events, not foreign keys, and there is no global user registry."
    },
    {
      "basis": "documented",
      "claim_id": "clm_970a78ae79337d59265c6517bb5db2f6b618efc17772bf26735c3df95c7e145b",
