          "line_end": 125,
          "line_start": 120,
          "path": "docs/design/architecture.md",
          "repository": "kenn-io/kata",
          "url": "https://github.com/kenn-io/kata/blob/f41a33383aba48941cb94b987124f5cd14840029/docs/design/architecture.md#L120-L125"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
