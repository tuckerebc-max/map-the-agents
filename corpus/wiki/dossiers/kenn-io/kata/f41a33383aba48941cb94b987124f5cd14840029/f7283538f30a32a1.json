        "slc_f19a9ac8fb70f91cf96b9da955461b9aef2dfbe1d2cd9933f5f07a8baa47f288"
      ],
      "text": "Hooks run local commands after database commit on a bounded worker pool, invoked without a shell via exec.Command with event data as JSON on stdin; hooks are not a sandbox and run with the daemon's OS user."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8c52c55eccbd5b2c6970defb70c71ad8b502d7ea2e24c19825928526eb60a8e3",
