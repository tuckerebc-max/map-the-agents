      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4a34adc00dbe00effe11599c1adb71f0026577ed15c70f31c2972567167d753a",
        "slc_cd6f8efbee49d81c80f30155e654411a7617333b8fcbe0f5ddb587dbef0d1b01",
        "slc_f7f3d2310290422b96354177e0c770493e560dec805157decacdaa644f073158"
      ],
      "text": "Closing an issue is an explicit API mutation carrying a reason, message, typed evidence, and actor attribution; kata never infers closure from git history."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3e3425fb2166eb68f9fdb901185b35e92b3106eab6b25f1057027a73901f37c1",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "f41a33383aba48941cb94b987124f5cd14840029",
          "git_sha": "be64daf8afb2185f68de75218f60338efabf7ab1",
          "line_end": 32,
          "line_start": 25,
          "path": "docs/design/architecture.md",
          "repository": "kenn-io/kata",
          "url": "https://github.com/kenn-io/kata/blob/f41a33383aba48941cb94b987124f5cd14840029/docs/design/architecture.md#L25-L32"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_853b9e49b5be2a024291eabd41c360c06691672e5675ba62fdf702e0b55a58bc"
      ],
      "text": "The surface is deliberately small: three relationship types, labels, owners, comments, and a constrained integer priority 0-4; there is no in_progress status, severity field, threaded replies, reactions, attachments, or markdown rendering."
    },
