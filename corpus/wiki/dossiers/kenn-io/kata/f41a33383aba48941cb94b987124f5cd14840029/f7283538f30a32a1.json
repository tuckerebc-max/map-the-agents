          "line_start": 109,
          "path": "README.md",
          "repository": "kenn-io/kata",
          "url": "https://github.com/kenn-io/kata/blob/f41a33383aba48941cb94b987124f5cd14840029/README.md#L109-L120"
        }
      ],
      "review_state": "mechanically_checked",
