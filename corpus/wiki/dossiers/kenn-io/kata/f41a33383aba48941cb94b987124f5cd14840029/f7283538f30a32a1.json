        "slc_bbf05df1606171a8bd499efd03af2522400b0d72c8f26074975afa99697a2bef"
      ],
      "text": "Local mode trusts the OS user with no authentication on a Unix socket or loopback listener; shared/remote modes require a bearer token and explicit trust opt-in before credentials cross a plaintext non-loopback connection."
    },
    {
      "basis": "documented",
      "claim_id": "clm_89e6452e8b4e8fd72736a2a91c39c87bf02b8a3ac5d94656580e0409a83deccc",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
          "commit": "f41a33383aba48941cb94b987124f5cd14840029",
          "git_sha": "be64daf8afb2185f68de75218f60338efabf7ab1",
          "line_end": 125,
          "line_start": 120,
          "path": "docs/design/architecture.md",
          "repository": "kenn-io/kata",
          "url": "https://github.com/kenn-io/kata/blob/f41a33383aba48941cb94b987124f5cd14840029/docs/design/architecture.md#L120-L125"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_bbf05df1606171a8bd499efd03af2522400b0d72c8f26074975afa99697a2bef"
      ],
      "text": "The loopback HTTP server rejects non-empty Origin headers, requires application/json Content-Type on mutations, and emits no CORS headers to resist drive-by browser requests."
    },
