          "git_sha": "d19d8c9a8dac5617d9c75598647276a439602c08",
          "line_end": 33,
          "line_start": 31,
          "path": "website/docs/code_execution.md",
          "repository": "microsoft/taskweaver",
          "url": "https://github.com/microsoft/TaskWeaver/blob/d44ddef23f90059fb17999d3095db4240e98f955/website/docs/code_execution.md#L31-L33"
