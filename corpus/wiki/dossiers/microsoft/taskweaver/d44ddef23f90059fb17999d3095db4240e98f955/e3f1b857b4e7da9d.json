      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9defb9061f44f514d78e2b714f71dd2e4767f2622336754a7e9ee5a0a6f4deda"
      ],
      "text": "The execution mode is configured via the execution_service.kernel_mode parameter in taskweaver_config.json, with 'container' as the default value."
    },
