        "slc_f1937ef781e14604fc43516e0833c3aeee9ea8571c1ffc2184aa82dd3e45b3b3",
        "slc_fb7aa483b2ff549600e9ac906d375715199dab5bdc76b90b3cb427642ef71538"
      ],
      "text": "LLM configuration is provided in a taskweaver_config.json file, e.g. llm.api_key and llm.model for OpenAI, with other LLMs and advanced configurations supported per the docs."
    },
    {
      "basis": "documented",
