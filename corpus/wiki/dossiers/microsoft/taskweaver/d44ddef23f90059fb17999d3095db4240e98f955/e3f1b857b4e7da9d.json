      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d78c6ade3874a0e5b90502894843493cc5171725b88698b58f9094a2ce4dcb26"
      ],
      "text": "The default executor Docker image contains only dependencies from requirements.txt; users needing extra packages must modify the Dockerfile at TaskWeaver/docker/ces_container/Dockerfile and rebuild."
    },
    {
      "basis": "documented",
      "claim_id": "clm_40d8986fa5da28efbff70827ee87237f9817d18e424d619b5df06072ce1f0d6f",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "d44ddef23f90059fb17999d3095db4240e98f955",
          "git_sha": "e46dc54ad0162374620c58a0a943a5c0e99eaa49",
          "line_end": 102,
          "line_start": 99,
          "path": "website/docs/memory.md",
          "repository": "microsoft/taskweaver",
          "url": "https://github.com/microsoft/TaskWeaver/blob/d44ddef23f90059fb17999d3095db4240e98f955/website/docs/memory.md#L99-L102"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_85bd59c095192aca14987ae58e79d75ef4b3da7e62b398b0cc2a104822d57869"
      ],
      "text": "Shared information is stored as attachments inside posts rather than a separate structure so that, if a round fails, its shared entries can be filtered out by round status, analogous to transaction logging."
    },
