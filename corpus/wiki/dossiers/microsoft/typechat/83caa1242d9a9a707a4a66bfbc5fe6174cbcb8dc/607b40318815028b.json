        "slc_aacbd2fa520a88bc22500ec299d3742dbcf5f2c8e6c8915e940f2d49784b7db6"
      ],
      "text": "TypeChat is a library for building natural language interfaces using types, replacing prompt engineering with schema engineering."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3f97560752a84efde2f19f2f57b465a5a28565a0cd5af09a7c7fbc3754326c52",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "83caa1242d9a9a707a4a66bfbc5fe6174cbcb8dc",
          "git_sha": "4513aa5965101ad22aff9b7c40c10ffee264403b",
          "line_end": 9,
          "line_start": 9,
          "path": "README.md",
          "repository": "microsoft/typechat",
          "url": "https://github.com/microsoft/TypeChat/blob/83caa1242d9a9a707a4a66bfbc5fe6174cbcb8dc/README.md#L9-L9"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_348779bcd092b4d017be84621a04e58550bcf0253dacec1d9d65f52eb99e4529"
      ],
      "text": "Developers define types representing supported intents, from simple sentiment classification to complex schemas like shopping carts or music apps."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e110ca5bc9af171f6664a5f13c876e8ff70e185056b53c30c00ec9d6f873b2bb",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "83caa1242d9a9a707a4a66bfbc5fe6174cbcb8dc",
          "git_sha": "4513aa5965101ad22aff9b7c40c10ffee264403b",
          "line_end": 9,
          "line_start": 9,
          "path": "README.md",
          "repository": "microsoft/typechat",
          "url": "https://github.com/microsoft/TypeChat/blob/83caa1242d9a9a707a4a66bfbc5fe6174cbcb8dc/README.md#L9-L9"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_348779bcd092b4d017be84621a04e58550bcf0253dacec1d9d65f52eb99e4529"
      ],
      "text": "Schemas can be extended by adding types to a discriminated union, and made hierarchical via a meta-schema that selects sub-schemas from user input."
    },
    {
      "basis": "documented",
      "claim_id": "clm_833b73fc6fcb8c19819e08dd75a0cea1cff58094a461d768b704cb27450210ba",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "83caa1242d9a9a707a4a66bfbc5fe6174cbcb8dc",
          "git_sha": "4513aa5965101ad22aff9b7c40c10ffee264403b",
          "line_end": 15,
          "line_start": 13,
          "path": "README.md",
          "repository": "microsoft/typechat",
          "url": "https://github.com/microsoft/TypeChat/blob/83caa1242d9a9a707a4a66bfbc5fe6174cbcb8dc/README.md#L13-L15"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_525e99ce2b02b9bada680ee4c7354089fb228860fdff31c4e648400880d6e094"
      ],
      "text": "TypeChat's pipeline: builds an LLM prompt from the types, validates the response against the schema, and repairs invalid output through further model interaction."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3b39565381a90c73d1973b5d86ba82d4504246e11cbc9f91e7da9121b5824cdc",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "83caa1242d9a9a707a4a66bfbc5fe6174cbcb8dc",
          "git_sha": "4513aa5965101ad22aff9b7c40c10ffee264403b",
          "line_end": 15,
          "line_start": 13,
          "path": "README.md",
          "repository": "microsoft/typechat",
          "url": "https://github.com/microsoft/TypeChat/blob/83caa1242d9a9a707a4a66bfbc5fe6174cbcb8dc/README.md#L13-L15"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_525e99ce2b02b9bada680ee4c7354089fb228860fdff31c4e648400880d6e094"
      ],
      "text": "After validation, TypeChat summarizes the resulting instance succinctly without using an LLM to confirm alignment with user intent."
    },
