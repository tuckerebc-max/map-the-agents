        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_f40069edd28d8d5aefeafee49c500c1e552af9049abb537bb19c6913a79a8236"
      ],
      "text": "Version 2.0 changes distribution from source linked into the project to a pre-compiled library; consumers can opt back into source via the CodeGenHelpersMode property set to 'source'."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3f8ce228d0217475a58d193906a50bd40f3877d08e30819f8be6552781a483eb",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
