        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_02459597345775d45863e7255bf43661c79f1bec8a410646af05a7ddcc2037e0"
      ],
      "text": "The library is distributed as the AvantiPoint.CodeGenHelpers NuGet package."
    },
    {
      "basis": "documented",
      "claim_id": "clm_05f88e9695ea1104cc6cf184caa8d42596279a7312a0f6c9c2c9fee414c853a8",
