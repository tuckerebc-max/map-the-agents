        "slc_56329c8b66f19b8d8e63c3d740b904e708d2e8068896928277b675d22fae0824",
        "slc_d16a67eff2a4a971cc973546ec876306d36c314e2666271d65d493ee7d8767f5"
      ],
      "text": "A GeneratorExecutionContext AddSource extension adds generated code to the compilation and formats output based on ParseOptions; Build can also be passed ParseOptions to replicate that formatting."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0a406d425e7a6fe62da442f9f073f5da1b237f44303bc3356ec23c0724ba0bfc",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "69671cd8bfe82c3bdb2952d0c08f969c33a0b400",
          "git_sha": "f81ee5e45f86f88cd0461f6d64fc2bc658f694ac",
          "line_end": 146,
          "line_start": 146,
          "path": "ReadMe.md",
          "repository": "dansiegel/codegenhelpers",
          "url": "https://github.com/dansiegel/CodeGenHelpers/blob/69671cd8bfe82c3bdb2952d0c08f969c33a0b400/ReadMe.md#L146-L146"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d28060ba49e7ccd913c95f915729027bd53b022183bd4d21f3afd5a5ff1f678a"
      ],
      "text": "The AddSource extension names each generated file with the fully qualified type name plus .g.cs (e.g. AwesomeApp.SomeClass.g.cs), and iterating a CodeBuilder yields one source text per included Class, Enum, or Record."
    },
