          "git_sha": "f81ee5e45f86f88cd0461f6d64fc2bc658f694ac",
          "line_end": 132,
          "line_start": 132,
          "path": "ReadMe.md",
          "repository": "dansiegel/codegenhelpers",
          "url": "https://github.com/dansiegel/CodeGenHelpers/blob/69671cd8bfe82c3bdb2952d0c08f969c33a0b400/ReadMe.md#L132-L132"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ced6ca1f7fa1d1278472aa161150dea42a1281d949c04acf46c16ade92ead282"
      ],
      "text": "Builders include overloads for Roslyn types like ITypeSymbol and INamespaceSymbol; adding an ITypeSymbol parameter automatically imports its namespace even when it appears higher in the syntax tree."
    },
