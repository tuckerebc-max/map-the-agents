      "slice_ids": [
        "slc_03001ccf3ad31c1e752d03e0a2b72cfdae8393d86d0c4d12cbbbfc824f2496cb"
      ],
      "text": "The library provides a fluent builder framework for generating code, working with native Roslyn types such as ITypeSymbol to manage namespace imports."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6127af11ec116475f80159a1ecea5d2cc61433ca662340948090e4f33b40fc72",
      "evidence_type": "organizational_statement",
