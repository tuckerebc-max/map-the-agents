        {
          "commit": "ef01b6411acc870ee455270b2c27baf7fe562561",
          "git_sha": "6447216eefaeff347b39ef746dd8e5caa1b15436",
          "line_end": 355,
          "line_start": 355,
          "path": "README.md",
          "repository": "dicklesworthstone/coding_agent_account_manager",
          "url": "https://github.com/Dicklesworthstone/coding_agent_account_manager/blob/ef01b6411acc870ee455270b2c27baf7fe562561/README.md#L355-L355"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_731f414b87ce2582d05cf151ddcdc27077fc6a41dedd547568f7ea6057aeadd1"
      ],
      "text": "After switching codex auth, caam detects a running codex app-server daemon and warns; --reload-daemon SIGTERMs it so it respawns with the new auth."
    },
    {
      "basis": "documented",
      "claim_id": "clm_76e8d1d77ee2480b6ea8e62bc21fd29625cef0fbd18e8a7b9417b4aeaf9d3ee2",
