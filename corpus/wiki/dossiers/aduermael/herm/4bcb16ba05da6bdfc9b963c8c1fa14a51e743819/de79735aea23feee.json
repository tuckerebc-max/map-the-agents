        {
          "commit": "4bcb16ba05da6bdfc9b963c8c1fa14a51e743819",
          "git_sha": "b47664528c65909747fb171c4814c620308e69bf",
          "line_end": 19,
          "line_start": 19,
          "path": "README.md",
          "repository": "aduermael/herm",
          "url": "https://github.com/aduermael/herm/blob/4bcb16ba05da6bdfc9b963c8c1fa14a51e743819/README.md#L19-L19"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_75fee0cd1bd5046dc511aec136d326c2b9ee244c4be0735dd0a73ab1df6ec69f"
      ],
      "text": "The CLI supports multiple providers (Anthropic, OpenAI, Gemini, Grok, OpenRouter, Ollama, Azure OpenAI, Vertex AI, Bedrock) and models can be mixed, e.g. a different model for the main agent, exploration, or vision."
    },
