        "slc_43275e86646ff4625a7799098841f5575442ea4066df6d16bfa0e4876caa7c3d"
      ],
      "text": "The plugin wraps the external pi CLI binary (default \"pi\", configurable to a custom path or wrapper command array) rather than implementing the agent itself."
    },
    {
      "basis": "documented",
      "claim_id": "clm_28a390ed4616a085c05558bea2c20495b5f70a3aa95d208eb196e26f2b162aa0",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
