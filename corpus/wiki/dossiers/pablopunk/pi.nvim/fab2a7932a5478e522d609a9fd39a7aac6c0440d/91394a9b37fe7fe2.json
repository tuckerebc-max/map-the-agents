        "slc_13b51a0df80a6b64af9db1d4880b9d5a5e2510b2001a52236aa9f9ae92a85bba",
        "slc_2cb68cfa93c0c9c0eb4c2b36d07f9b676976e34ae13729ef49e3a5a04728d2ec"
      ],
      "text": "Context sent to pi includes the current buffer, cwd, selection, and optionally LSP/linter diagnostics via vim.diagnostic, with unsaved buffer content treated as the source of truth over disk."
    },
