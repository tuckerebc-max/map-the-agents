      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2cb68cfa93c0c9c0eb4c2b36d07f9b676976e34ae13729ef49e3a5a04728d2ec"
      ],
      "text": "Requests run asynchronously so editing stays nonblocking, and changed loaded buffers are reloaded after successful pi edits."
    },
