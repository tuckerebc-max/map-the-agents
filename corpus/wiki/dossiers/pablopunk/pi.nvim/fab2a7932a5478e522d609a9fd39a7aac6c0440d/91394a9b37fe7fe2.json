      "slice_ids": [
        "slc_43275e86646ff4625a7799098841f5575442ea4066df6d16bfa0e4876caa7c3d"
      ],
      "text": "The tools option lets users restrict pi's tools; read, edit, and write are always enabled, and an empty list disables bash."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6618eb0df2f2fd1ff23c07c8c861a578638e68cc71e2fc064fed57c622218136",
