      ],
      "text": "Configuration options include binary path, provider, model, thinking level (off through xhigh), tools list, system prompts, and context sizing knobs like max_bytes and surrounding_lines."
    },
    {
      "basis": "documented",
      "claim_id": "clm_62ad7e0089384df6254c03da4eb470dacf1fc945e1bed692886c4dcb1aed1a3f",
      "evidence_type": "organizational_statement",
