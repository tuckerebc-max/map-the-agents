        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_43275e86646ff4625a7799098841f5575442ea4066df6d16bfa0e4876caa7c3d"
      ],
      "text": "Setting a custom system_prompt overrides pi's generated baseline instructions, which the README flags as something to use with care."
    }
