          "git_sha": "79dac4b99cb5cb21224da913a8699be8ec36f4df",
          "line_end": 24,
          "line_start": 22,
          "path": "README.md",
          "repository": "pablopunk/pi.nvim",
          "url": "https://github.com/pablopunk/pi.nvim/blob/fab2a7932a5478e522d609a9fd39a7aac6c0440d/README.md#L22-L24"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_87eb90a2e6f85b11250009a93a77f38f4e29841272819fd1510f82f47e2dd991"
      ],
      "text": "Requires Neovim 0.10+ and a globally installed pi binary, installed via a curl script; models must be available in pi."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5b36b0ea4a337697cb3b8da3f5f2956ba55038e9f6355dc951a6aabf620967bd",
