        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9ff518fbe047a4d10b06d5bb50a08fde3287e3505aa346adada0be7592fe1888"
      ],
      "text": "Fusil is a revival of Victor Stinner's fuzzing framework; only the Python fuzzing path is actively developed and tested, targeting crashes in CPython, C extensions, the Tier-2 JIT, and OOM error paths."
    },
    {
      "basis": "documented",
      "claim_id": "clm_aa563e86ab6aca14362c8cb5e3bc1076e43a953299049eae66c3154e5d4ac9b1",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
          "commit": "a7aa4e94bd8468f074d96fc6da6a76426b15b341",
          "git_sha": "b9d19d586db1ac45d40125d415164425896cbd7a",
          "line_end": 14,
          "line_start": 10,
          "path": "README.rst",
          "repository": "devdanzin/fusil",
          "url": "https://github.com/devdanzin/fusil/blob/a7aa4e94bd8468f074d96fc6da6a76426b15b341/README.rst#L10-L14"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e74bac349ce21eebd278d69647d37ebcb295bc2ed978fa6ddb6cb0c1be36e532"
      ],
      "text": "Historical non-Python fuzzers (firefox, php, mplayer) and subsystems like network, file/process mangling, and X11 are legacy and out of scope, kept under notworking/ directories and may not work as-is."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ded7ff974ce58369fa7759387d6c9730b6e88ff6e8e32a8cce2f061af2e66e66",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "a7aa4e94bd8468f074d96fc6da6a76426b15b341",
          "git_sha": "b9d19d586db1ac45d40125d415164425896cbd7a",
          "line_end": 21,
          "line_start": 16,
          "path": "README.rst",
          "repository": "devdanzin/fusil",
          "url": "https://github.com/devdanzin/fusil/blob/a7aa4e94bd8468f074d96fc6da6a76426b15b341/README.rst#L16-L21"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_05e4cedacb743b9077eaa1ba616b051b617e5952056fb65bb07410b342bf83a1"
      ],
      "text": "Fusil is built as a small multi-agent system where agents communicate via asynchronous messages, and a per-session score drives the fuzzer's adaptive aggressivity."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7889ad8225b9dc8a01328b15aa024f432e59bf3feb0a542921defac6ac53f608",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "a7aa4e94bd8468f074d96fc6da6a76426b15b341",
          "git_sha": "b9d19d586db1ac45d40125d415164425896cbd7a",
          "line_end": 21,
          "line_start": 16,
          "path": "README.rst",
          "repository": "devdanzin/fusil",
          "url": "https://github.com/devdanzin/fusil/blob/a7aa4e94bd8468f074d96fc6da6a76426b15b341/README.rst#L16-L21"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_05e4cedacb743b9077eaa1ba616b051b617e5952056fb65bb07410b342bf83a1"
      ],
      "text": "Each session generates a standalone test script, runs it as a sandboxed child process with memory/cpu/process limits, dropped privileges, and redirected output, watching for crash signals and patterns like 'Fatal Python error' or AddressSanitizer output."
    },
    {
      "basis": "documented",
      "claim_id": "clm_36885c75776835396edd255e54c040c5cbc5b884977ec8d14c17afb9f3ac853f",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
          "commit": "a7aa4e94bd8468f074d96fc6da6a76426b15b341",
          "git_sha": "b9d19d586db1ac45d40125d415164425896cbd7a",
          "line_end": 38,
          "line_start": 36,
          "path": "README.rst",
          "repository": "devdanzin/fusil",
          "url": "https://github.com/devdanzin/fusil/blob/a7aa4e94bd8468f074d96fc6da6a76426b15b341/README.rst#L36-L38"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5b81c827c5a55fe695592acef8c11930de638ab1f1882e7c0a9ce3d0b411dbb0"
      ],
      "text": "By default the fuzzer expects a dedicated unprivileged fusil user/group to drop privileges to; the --unsafe flag instead runs fuzzed children as the current user."
    },
