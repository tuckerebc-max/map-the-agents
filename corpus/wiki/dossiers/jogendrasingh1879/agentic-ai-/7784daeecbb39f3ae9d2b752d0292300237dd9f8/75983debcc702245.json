        "slc_73c75347c3916db4900508144c773f0fffb59d576de173c81779dfef862d3ae4"
      ],
      "text": "The system is exposed as a REST API built with FastAPI, with the Order Agent and Inventory Agent as separate endpoints."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1189cd1007dcacfe44f0d8c50adda666214a8b4164830ac0159340984e029a12",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "7784daeecbb39f3ae9d2b752d0292300237dd9f8",
          "git_sha": "5a0a3e6a795e490ab479dfea3af1dbe1c107bb1a",
          "line_end": 41,
          "line_start": 38,
          "path": "README.md",
          "repository": "jogendrasingh1879/agentic-ai-",
          "url": "https://github.com/JogendraSingh1879/Agentic-AI-/blob/7784daeecbb39f3ae9d2b752d0292300237dd9f8/README.md#L38-L41"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_28c33f6bcae62d8282493d3368b7a8c2e6a3e1bbd3736c12a767d6729d5829ca"
      ],
      "text": "The Order Agent communicates with the Inventory Agent via API calls, which may be synchronous or asynchronous, to check ingredient availability before confirming orders."
    },
    {
      "basis": "documented",
      "claim_id": "clm_044dbb67ebe1fc3f807f439c4ade2350b2031f114db7f08df66e4f5f24e16eee",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "7784daeecbb39f3ae9d2b752d0292300237dd9f8",
          "git_sha": "5a0a3e6a795e490ab479dfea3af1dbe1c107bb1a",
          "line_end": 28,
          "line_start": 25,
          "path": "README.md",
          "repository": "jogendrasingh1879/agentic-ai-",
          "url": "https://github.com/JogendraSingh1879/Agentic-AI-/blob/7784daeecbb39f3ae9d2b752d0292300237dd9f8/README.md#L25-L28"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_da703cb2f7bb5230d92c7f25809d20d292624e8e52f3c88b5b6f1bbb7e2765a1"
      ],
      "text": "The Order Agent receives order details (size, type, quantity), validates availability, requests inventory checks, and handles payment processing."
    },
    {
      "basis": "documented",
      "claim_id": "clm_543877fb5fafa70c2676ea33ca38049716d88697921cbfe8da2142b842e4f3c1",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "7784daeecbb39f3ae9d2b752d0292300237dd9f8",
          "git_sha": "5a0a3e6a795e490ab479dfea3af1dbe1c107bb1a",
          "line_end": 34,
          "line_start": 32,
          "path": "README.md",
          "repository": "jogendrasingh1879/agentic-ai-",
          "url": "https://github.com/JogendraSingh1879/Agentic-AI-/blob/7784daeecbb39f3ae9d2b752d0292300237dd9f8/README.md#L32-L34"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c7ee25ae61b5d39ea35389e2ee57c7731e2e3f84b001edac0e7e5dce8bac4b12"
      ],
      "text": "The Inventory Agent manages pizza ingredients such as cheese, dough, and toppings, checks sufficiency for orders, and updates stock after each order."
    },
    {
      "basis": "documented",
      "claim_id": "clm_9756c8d5953c65d597777e1ba7f82e9464d7184188d049d93c7366f91afa7ba0",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
