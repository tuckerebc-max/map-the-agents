        "slc_2ef2f532252fb4a2cacbf62ad1e83d7d6b2070a1990a4fe0be4e162c05348b15"
      ],
      "text": "A viewer subcommand offers `paperbanana viewer evolution` for pipeline evolution and `paperbanana viewer eval` for evaluation-with-reference review."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a466f19b3198a1faef61d08b80bd5b16594978d7455e4387f93f708b6d2af9dc",
