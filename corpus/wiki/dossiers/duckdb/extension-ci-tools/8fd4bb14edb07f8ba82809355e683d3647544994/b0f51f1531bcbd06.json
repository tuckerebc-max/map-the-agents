      ],
      "text": "The repository provides reusable components for building, testing and deploying DuckDB extensions, used by the extension template and other extensions to deduplicate build/CI configuration."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4d4b4671a5e4e639625ad1a8f20b4ee32dbde9c72d130035ae8b4febd5f58ed4",
      "evidence_type": "organizational_statement",
      "facet": "components",
