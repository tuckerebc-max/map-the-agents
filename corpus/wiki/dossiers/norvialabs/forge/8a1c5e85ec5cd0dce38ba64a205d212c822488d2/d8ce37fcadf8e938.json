        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e1a196263c5b3de892ccb59e5c8674a8b0c0b037225b762ca94a638db877ee96"
      ],
      "text": "Core UX invariants include exactly one effective keyboard owner at a time, colour never being the sole state indicator, approvals and failures outranking routine activity, and refusing to render below an enforced minimum of 80x18."
    },
