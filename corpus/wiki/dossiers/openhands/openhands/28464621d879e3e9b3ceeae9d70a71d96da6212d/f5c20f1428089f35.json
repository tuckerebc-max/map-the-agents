      ],
      "text": "Agent Canvas is described as a self-hosted developer control center for coding agents and automations, currently in beta status."
    },
    {
      "basis": "documented",
      "claim_id": "clm_fc6129a93846711e98cfe1c967e72301cac361acb4a3e2253bf8319653df7d71",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "28464621d879e3e9b3ceeae9d70a71d96da6212d",
          "git_sha": "65f48c09a39f7e40e3a55760c4f4654af5a97bdd",
          "line_end": 31,
          "line_start": 3,
          "path": "README.md",
          "repository": "openhands/openhands",
          "url": "https://github.com/OpenHands/OpenHands/blob/28464621d879e3e9b3ceeae9d70a71d96da6212d/README.md#L3-L31"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_567f412d816008629a55204889545561fc32594b4c126693761bbe873d74d8bd"
      ],
      "text": "It can run OpenHands, Claude Code, Codex, Gemini, or any ACP-compatible agent across local, remote, and cloud backends."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b5778ec096c8aedf70bda1d8e9768c89805135737f4f2341627da89487741738",
      "evidence_type": "organizational_statement",
