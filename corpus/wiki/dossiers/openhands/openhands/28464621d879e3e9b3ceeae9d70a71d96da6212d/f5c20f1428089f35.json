          "line_end": 75,
          "line_start": 75,
          "path": "README.md",
          "repository": "openhands/openhands",
          "url": "https://github.com/OpenHands/OpenHands/blob/28464621d879e3e9b3ceeae9d70a71d96da6212d/README.md#L75-L75"
        },
        {
          "commit": "28464621d879e3e9b3ceeae9d70a71d96da6212d",
          "git_sha": "65f48c09a39f7e40e3a55760c4f4654af5a97bdd",
          "line_end": 80,
          "line_start": 77,
          "path": "README.md",
          "repository": "openhands/openhands",
          "url": "https://github.com/OpenHands/OpenHands/blob/28464621d879e3e9b3ceeae9d70a71d96da6212d/README.md#L77-L80"
        }
      ],
      "review_state": "mechanically_checked",
