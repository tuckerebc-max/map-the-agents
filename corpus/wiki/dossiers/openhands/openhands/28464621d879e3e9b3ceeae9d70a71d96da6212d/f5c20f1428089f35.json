          "git_sha": "65f48c09a39f7e40e3a55760c4f4654af5a97bdd",
          "line_end": 122,
          "line_start": 122,
          "path": "README.md",
          "repository": "openhands/openhands",
          "url": "https://github.com/OpenHands/OpenHands/blob/28464621d879e3e9b3ceeae9d70a71d96da6212d/README.md#L122-L122"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5f5c0a6bca2483f2d47bc6072d2efac2fe0b8bd0bba79b34c9b91a7aaaaac57d"
      ],
      "text": "The UI is served at localhost:8000 for npm/source launches and at /canvas for the Docker image, with backends addable from the UI."
    },
