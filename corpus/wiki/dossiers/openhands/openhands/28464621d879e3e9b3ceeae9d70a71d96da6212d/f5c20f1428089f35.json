        "slc_6392abb3d5a479a541d77796dc29f3a890600a74024af9e3383a4cc487351ee7"
      ],
      "text": "The agent-canvas CLI starts the full local stack by default and supports --frontend-only and --backend-only flags to run pieces separately."
    },
    {
      "basis": "documented",
      "claim_id": "clm_49c25e9e4c714aa8c5ff0386c2b77d3f42de2833fc38028ce18331f7420d7917",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
