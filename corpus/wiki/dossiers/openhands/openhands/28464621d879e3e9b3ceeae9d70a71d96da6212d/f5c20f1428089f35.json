      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_78ba414ed92694713d9e209cd6bdd879b75d7724a837ede13e4f46f8b538ae2c"
      ],
      "text": "Agent Canvas is powered by the OpenHands Agent Server, a REST API for running multiple agents on one machine; the frontend can connect to and switch between multiple Agent Servers."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f1c91aec83a0e9718c944ae4ea5faa2012761c4654b0ee3e5d2bc82d01b4a720",
      "evidence_type": "organizational_statement",
