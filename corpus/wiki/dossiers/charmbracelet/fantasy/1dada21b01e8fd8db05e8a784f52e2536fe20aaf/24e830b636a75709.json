        {
          "commit": "1dada21b01e8fd8db05e8a784f52e2536fe20aaf",
          "git_sha": "b4af728c15a485b23849f40f775e1ab203c605af",
          "line_end": 26,
          "line_start": 21,
          "path": "README.md",
          "repository": "charmbracelet/fantasy",
          "url": "https://github.com/charmbracelet/fantasy/blob/1dada21b01e8fd8db05e8a784f52e2536fe20aaf/README.md#L21-L26"
        },
        {
          "commit": "1dada21b01e8fd8db05e8a784f52e2536fe20aaf",
          "git_sha": "b4af728c15a485b23849f40f775e1ab203c605af",
          "line_end": 35,
          "line_start": 30,
          "path": "README.md",
          "repository": "charmbracelet/fantasy",
          "url": "https://github.com/charmbracelet/fantasy/blob/1dada21b01e8fd8db05e8a784f52e2536fe20aaf/README.md#L30-L35"
        }
      ],
      "review_state": "mechanically_checked",
