      ],
      "text": "Fantasy is a Go library for building AI agents, offering multi-provider and multi-model support behind a single API."
    },
    {
      "basis": "documented",
      "claim_id": "clm_faefd5fdf77346e204c2b2d6ae2944222a61de8860daf1eed8b67f20029a7618",
