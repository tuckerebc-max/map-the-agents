        "slc_155f53537f7df57c874d4458b1375e301f326c33a53ba80aece40dccce99ebf8",
        "slc_23280c3495202b5f4e7f137d1a50afeaac499e3f5460032457876ea3d7551b50"
      ],
      "text": "Providers are instantiated via constructors like openrouter.New with an API-key option, and language models are obtained by calling provider.LanguageModel with a context and model name."
    },
    {
      "basis": "documented",
      "claim_id": "clm_264f186b7d3181da23bee4b706e4acaf3ce0087d544c74a78089e42b21d13f0d",
      "evidence_type": "organizational_statement",
