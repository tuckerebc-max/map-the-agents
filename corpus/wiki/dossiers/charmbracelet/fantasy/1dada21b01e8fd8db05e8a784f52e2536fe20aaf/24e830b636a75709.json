          "line_end": 59,
          "line_start": 51,
          "path": "README.md",
          "repository": "charmbracelet/fantasy",
          "url": "https://github.com/charmbracelet/fantasy/blob/1dada21b01e8fd8db05e8a784f52e2536fe20aaf/README.md#L51-L59"
        },
        {
          "commit": "1dada21b01e8fd8db05e8a784f52e2536fe20aaf",
          "git_sha": "b4af728c15a485b23849f40f775e1ab203c605af",
          "line_end": 49,
          "line_start": 44,
          "path": "README.md",
          "repository": "charmbracelet/fantasy",
          "url": "https://github.com/charmbracelet/fantasy/blob/1dada21b01e8fd8db05e8a784f52e2536fe20aaf/README.md#L44-L49"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9d66ccc13d77eb7d6c5ccb2016db3115a7c43775405f87f833454f27da7eb117",
        "slc_d383f0ffdb4fbcd87c78420a5928d451834b475082c09044f947fac52b02b7db"
      ],
      "text": "Agents are created with fantasy.NewAgent, accepting a model plus options such as WithSystemPrompt and WithTools, and run via agent.Generate with an AgentCall containing a prompt."
    },
    {
      "basis": "documented",
      "claim_id": "clm_508610f86caa71d8a60c0007f703645378f9a5f78c5389e42bc0fc152b606f99",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
