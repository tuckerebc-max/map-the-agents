      "slice_ids": [
        "slc_50ee9fd00a099f8e8ea56fbbcada64cd4913d4b39327bf63dde4939d365fd38c"
      ],
      "text": "Fantasy supports many providers via dedicated packages (e.g. Azure, Bedrock, OpenRouter) and a generic openaicompat layer for OpenAI-compatible providers."
    },
    {
      "basis": "documented",
      "claim_id": "clm_29831ec274fcf5937cae4b3b81c1c5fcdab06c0e5dd9191045fdfcb3dc124e2f",
