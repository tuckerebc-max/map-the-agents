        {
          "commit": "9a1709fa3b7f92343574d8008ce949263da9c82f",
          "git_sha": "01813a189e653ebe4f2989903c1c5d9986de21b3",
          "line_end": 12,
          "line_start": 9,
          "path": "README.md",
          "repository": "bmdavis419/.better-coding-agents",
          "url": "https://github.com/bmdavis419/.better-coding-agents/blob/9a1709fa3b7f92343574d8008ce949263da9c82f/README.md#L9-L12"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2f4043826333a27c25374587f4b277f775f9579bae53cd5afbc84ae60f4198ca"
      ],
      "text": "The repository ships preconfigured setups for svelte & sveltekit, effect.ts, neverthrow, and opencode."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6dbf7ae307f51ff96a04a4ab15fc23716bd76498e7f2b4d86cb0529bcf9a5c2c",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
