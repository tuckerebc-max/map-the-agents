        "slc_785342a6482c2d0f7537bb584a2f63f6f79c45881824d1e8ecf191e0a9e0358b"
      ],
      "text": "The approach is to clone a library's entire source repo as a git subtree so an agent can search the codebase to answer questions about that library."
    },
    {
      "basis": "documented",
      "claim_id": "clm_152c56215d1894fa60d554233b33b3f5605e1b245e39c626728bc9b33efef897",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
