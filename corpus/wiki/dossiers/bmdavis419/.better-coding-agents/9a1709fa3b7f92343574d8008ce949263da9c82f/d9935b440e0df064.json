          "git_sha": "01813a189e653ebe4f2989903c1c5d9986de21b3",
          "line_end": 19,
          "line_start": 19,
          "path": "README.md",
          "repository": "bmdavis419/.better-coding-agents",
          "url": "https://github.com/bmdavis419/.better-coding-agents/blob/9a1709fa3b7f92343574d8008ce949263da9c82f/README.md#L19-L19"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c1570060a1dd3f9f8747a7897d6e6c551fafc43798406b600cb974fbd8454797"
      ],
      "text": "After setup, users get slash commands for the covered libraries in OpenCode and Cursor, plus a special OpenCode agent that searches the codebase for answers."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c4a9a2c784200ab4ec69aa53ef9a45268b40f1068d2654879cabf7217cc30d22",
      "evidence_type": "organizational_statement",
      "facet": "components",
