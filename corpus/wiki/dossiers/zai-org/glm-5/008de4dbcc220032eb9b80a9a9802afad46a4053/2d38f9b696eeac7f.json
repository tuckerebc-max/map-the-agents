{
  "applied_operation_id": "op_345b3e2327f34a5db0591e4818fc1087",
  "claims": [
    {
      "basis": "documented",
      "claim_id": "clm_68e9c18d840cbe2ae2ec4bdd665510bf5e9c75ba93dd4c8547dee11988d2f1c1",
      "evidence_type": "organizational_statement",
