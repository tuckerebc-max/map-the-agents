        {
          "commit": "008de4dbcc220032eb9b80a9a9802afad46a4053",
          "git_sha": "b50da8f1ed05d96f27184200496acd59f3b345fb",
          "line_end": 59,
          "line_start": 59,
          "path": "README.md",
          "repository": "zai-org/glm-5",
          "url": "https://github.com/zai-org/GLM-5/blob/008de4dbcc220032eb9b80a9a9802afad46a4053/README.md#L59-L59"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_27e444aafc0392fb82a8edf4ce5ec7322b51a7a48ca0c45afc4010369e9e1545"
      ],
      "text": "GLM-5 scales from GLM-4.5's 355B parameters (32B active) to 744B parameters (40B active), with pre-training data increased from 23T to 28.5T tokens."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6a17be0bab0b2728b34e79532ea3aa27ece77e1500cb1b4cd5d6dcf7305239ac",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
      "locators": [
        {
          "commit": "008de4dbcc220032eb9b80a9a9802afad46a4053",
          "git_sha": "b50da8f1ed05d96f27184200496acd59f3b345fb",
          "line_end": 86,
          "line_start": 75,
          "path": "README.md",
          "repository": "zai-org/glm-5",
          "url": "https://github.com/zai-org/GLM-5/blob/008de4dbcc220032eb9b80a9a9802afad46a4053/README.md#L75-L86"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4b4c497f7522a83757473665dee7f6558e3a9a96398dea422e1beb47ecb420db"
      ],
      "text": "Downloadable checkpoints include GLM-5.3 and GLM-5.3-BF16 at 744B-A40B, and GLM-5.3-Flash and its BF16 variant at 320B-A18B, hosted on Hugging Face and ModelScope."
    },
    {
      "basis": "documented",
      "claim_id": "clm_19182cd407bcef9682c95b578e5e73ebbaecf6ea5fce6ed5d43ec4ba19d9682b",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "008de4dbcc220032eb9b80a9a9802afad46a4053",
          "git_sha": "b50da8f1ed05d96f27184200496acd59f3b345fb",
          "line_end": 28,
          "line_start": 28,
          "path": "README.md",
          "repository": "zai-org/glm-5",
          "url": "https://github.com/zai-org/GLM-5/blob/008de4dbcc220032eb9b80a9a9802afad46a4053/README.md#L28-L28"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_7fe7e6da8a3a7b7e9a32493549b0a33e358c9a0ca625a512ed121c24e83fb5c5"
      ],
      "text": "GLM-5.3-Flash uses a newly trained base model with a hybrid sparse-plus-linear attention architecture and Manifold-Constrained Hyper-Connections (mHC), trained on a 30T-token multimodal corpus."
    },
    {
      "basis": "documented",
      "claim_id": "clm_96f0de77cb416c42b2ebbd18d671be1973e10b6cedc0b326584c0b41c84be424",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "008de4dbcc220032eb9b80a9a9802afad46a4053",
          "git_sha": "b50da8f1ed05d96f27184200496acd59f3b345fb",
          "line_end": 39,
          "line_start": 36,
          "path": "README.md",
          "repository": "zai-org/glm-5",
          "url": "https://github.com/zai-org/GLM-5/blob/008de4dbcc220032eb9b80a9a9802afad46a4053/README.md#L36-L39"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d566eea14a51a1257357909d31bae0e7ea8ea736bb911a051fc85eb3b551024a"
      ],
      "text": "GLM-5.2 introduces IndexShare, reusing one indexer across every four sparse attention layers to cut per-token FLOPs 2.9x at 1M context, plus an improved MTP layer for speculative decoding."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c5ad130415e8988127d72e927164221a73a5d5f0e6c34c74c062f1b562c4202f",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "008de4dbcc220032eb9b80a9a9802afad46a4053",
          "git_sha": "b50da8f1ed05d96f27184200496acd59f3b345fb",
          "line_end": 59,
          "line_start": 59,
          "path": "README.md",
          "repository": "zai-org/glm-5",
          "url": "https://github.com/zai-org/GLM-5/blob/008de4dbcc220032eb9b80a9a9802afad46a4053/README.md#L59-L59"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_27e444aafc0392fb82a8edf4ce5ec7322b51a7a48ca0c45afc4010369e9e1545"
      ],
      "text": "GLM-5 integrates DeepSeek Sparse Attention (DSA) to reduce deployment cost while preserving long-context capacity."
    },
    {
      "basis": "documented",
      "claim_id": "clm_05dbf8b39d3e5d05976d17a83f1c330f7efe34e6b3bf64a06198fcf0d82e6253",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "008de4dbcc220032eb9b80a9a9802afad46a4053",
          "git_sha": "b50da8f1ed05d96f27184200496acd59f3b345fb",
          "line_end": 113,
          "line_start": 111,
          "path": "README.md",
          "repository": "zai-org/glm-5",
          "url": "https://github.com/zai-org/GLM-5/blob/008de4dbcc220032eb9b80a9a9802afad46a4053/README.md#L111-L113"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_17e5319662e43172a4e43a61b6ea79004fc5f35306db45be530f0d15d874692c"
      ],
      "text": "GLM-5.3 and GLM-5.3-Flash accept a reasoning_effort parameter with low, high, and max levels, defaulting to max when unset or invalid; GLM-5.2 accepts only high and max."
    },
    {
      "basis": "documented",
      "claim_id": "clm_84f7f367239052e1a5a0c827caddd4b5c2c28daf2e6a0881e5f089aaee0c5518",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "008de4dbcc220032eb9b80a9a9802afad46a4053",
          "git_sha": "b50da8f1ed05d96f27184200496acd59f3b345fb",
          "line_end": 113,
          "line_start": 111,
          "path": "README.md",
          "repository": "zai-org/glm-5",
          "url": "https://github.com/zai-org/GLM-5/blob/008de4dbcc220032eb9b80a9a9802afad46a4053/README.md#L111-L113"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_17e5319662e43172a4e43a61b6ea79004fc5f35306db45be530f0d15d874692c"
      ],
      "text": "In the GLM-5.3 and GLM-5.3-Flash chat template, clear_thinking defaults to false when not passed, and users are told to pass true explicitly for chat scenarios."
    },
    {
      "basis": "documented",
      "claim_id": "clm_18f6d5da58dff9d07dd1e6ebddc7e5e5a09cf36e5353e346548d860f91357a4d",
