        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c5abc9a952fb7b8e0210f522ce27b2a26aa1ba08f64f37776eb01fb75ed445d9"
      ],
      "text": "The tool is described as a self-contained bash script with no server, proxy, or resident process, shelling out to existing CLIs such as claude, codex, devin, and agy."
    },
    {
      "basis": "documented",
      "claim_id": "clm_bdbc751880a4565e4848c7705f9621ad5297786aa9b74c162f3ea62391dc3eca",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "0ad71828e1188dc5c90e1bbde57d28a748d76d0b",
          "git_sha": "c3b4dbdec07c22f27ffcc9f185d8996405548535",
          "line_end": 312,
          "line_start": 302,
          "path": "README.md",
          "repository": "alexgreensh/outsourcerer",
          "url": "https://github.com/alexgreensh/outsourcerer/blob/0ad71828e1188dc5c90e1bbde57d28a748d76d0b/README.md#L302-L312"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9444485a87dec0abc194ceb4df9c8d75974fcb6eb4c6ff20a1cffaa3c0abd64f"
      ],
      "text": "The CLI exposes verbs including run/research/edit/yolo, bg/status/watch/result/logs/cancel, second-opinion, image, tab/estimate, suggest/deals, doctor/models, and parity variants."
    },
    {
      "basis": "documented",
      "claim_id": "clm_06f879da88d06b60c7d388e387046f56fe6af506ee18a4faed579a5a6074eb2f",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "0ad71828e1188dc5c90e1bbde57d28a748d76d0b",
          "git_sha": "c3b4dbdec07c22f27ffcc9f185d8996405548535",
          "line_end": 316,
          "line_start": 314,
          "path": "README.md",
          "repository": "alexgreensh/outsourcerer",
          "url": "https://github.com/alexgreensh/outsourcerer/blob/0ad71828e1188dc5c90e1bbde57d28a748d76d0b/README.md#L314-L316"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_884b74eb73fb52642ffc111c5ee164b45cdcf473140bbfdcb9a5fcb3c097de45"
      ],
      "text": "Named lanes map to providers: OpenRouter lanes (hy3, glm-5.2, deepseek-*), Codex native (sol/terra/luna), Claude native (fable/opus/sonnet/haiku), keyless Gemini via Antigravity, Hermes, and local ollama:<model>/local lanes."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c093bbdd09ceed9813b5537e4a98a5d10d9dc9deb7b938e8501327f0070ae494",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "0ad71828e1188dc5c90e1bbde57d28a748d76d0b",
          "git_sha": "c3b4dbdec07c22f27ffcc9f185d8996405548535",
          "line_end": 230,
          "line_start": 226,
          "path": "README.md",
          "repository": "alexgreensh/outsourcerer",
          "url": "https://github.com/alexgreensh/outsourcerer/blob/0ad71828e1188dc5c90e1bbde57d28a748d76d0b/README.md#L226-L230"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e4f4b84f592787e48d5e9776e772b2b4fdf8fe13d65bd1b5995668dead2ca888"
      ],
      "text": "A fanout command runs multi-agent squads across backends, with fanout status <id> --json returning a stable JSON envelope and fanout collect gathering results into one place."
    },
    {
      "basis": "documented",
      "claim_id": "clm_887d5c322105074da3db71751862963606db9f40fae237959bceb4761a383ebf",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "0ad71828e1188dc5c90e1bbde57d28a748d76d0b",
          "git_sha": "c3b4dbdec07c22f27ffcc9f185d8996405548535",
          "line_end": 224,
          "line_start": 224,
          "path": "README.md",
          "repository": "alexgreensh/outsourcerer",
          "url": "https://github.com/alexgreensh/outsourcerer/blob/0ad71828e1188dc5c90e1bbde57d28a748d76d0b/README.md#L224-L224"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_31c50f022ea2c9784f496047040c4aa3e92ba50dae552aefe283746eea1f5b85"
      ],
      "text": "Routing precedence is explicitly ordered: global -m wins, then --route name mapping, then per-agent frontmatter, then the default lane."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d7658fc4ac558cdedcb010254b54914e39b1c8b7ece2d637cbfd72c09bed5c87",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
