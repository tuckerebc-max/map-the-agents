        "slc_16901e04a593c4b674326e6af74b9c57a9d2c65a6c871df8dfcb0f61bc6e02cb",
        "slc_f1eec2e46a7dba1b5546570b240ccb37a6f62ee738757bca39371c2d981f118a"
      ],
      "text": "The Tab ledger separates real cash cost (read back exactly from OpenRouter per generation) from subscription plan-limit usage, never labeling subscription spend as free."
    },
    {
      "basis": "documented",
      "claim_id": "clm_deba28b2125e020653931f5c1282c19369f51a307a81664818dd2f3cc5f06a47",
      "evidence_type": "organizational_statement",
