          "url": "https://github.com/alexgreensh/outsourcerer/blob/0ad71828e1188dc5c90e1bbde57d28a748d76d0b/README.md#L183-L183"
        },
        {
          "commit": "0ad71828e1188dc5c90e1bbde57d28a748d76d0b",
          "git_sha": "c3b4dbdec07c22f27ffcc9f185d8996405548535",
          "line_end": 169,
          "line_start": 169,
          "path": "README.md",
          "repository": "alexgreensh/outsourcerer",
          "url": "https://github.com/alexgreensh/outsourcerer/blob/0ad71828e1188dc5c90e1bbde57d28a748d76d0b/README.md#L169-L169"
