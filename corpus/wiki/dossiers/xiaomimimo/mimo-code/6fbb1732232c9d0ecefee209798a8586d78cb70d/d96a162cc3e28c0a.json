      "slice_ids": [
        "slc_95aacfde970cf69b017b466d92b1ea4026712085a6184cceaa488035f8662fcb"
      ],
      "text": "The README states MiMoCode does not support the built-in macOS Terminal.app, recommending iTerm2 or the VS Code integrated terminal for rendering issues."
    },
