          "line_end": 545,
          "line_start": 545,
          "path": "README.md",
          "repository": "xiaomimimo/mimo-code",
          "url": "https://github.com/XiaomiMiMo/MiMo-Code/blob/6fbb1732232c9d0ecefee209798a8586d78cb70d/README.md#L545-L545"
