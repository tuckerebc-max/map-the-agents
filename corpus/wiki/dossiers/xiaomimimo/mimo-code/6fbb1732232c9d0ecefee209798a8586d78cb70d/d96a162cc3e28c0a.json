      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_432fa95a545e819dddaf47b1350b26f2ee29780bacbfb64d959f4fdfdc3021f8"
      ],
      "text": "MiMoCode is built as a fork of OpenCode, retaining core capabilities (multiple providers, TUI, LSP, MCP, plugins) and adding memory, context management, subagents, goal loops, and dream/distill self-improvement."
    },
    {
      "basis": "documented",
      "claim_id": "clm_15240c53919e0e0e430d8728137c74f3bb4b04d4d00c7b9e6367afeb3b26045a",
