          "line_end": 206,
          "line_start": 201,
          "path": "docs/architecture.md",
          "repository": "nanocoai/nanoclaw",
          "url": "https://github.com/nanocoai/nanoclaw/blob/3f9ed607b7e7a4872747295f75286f1c377d7c33/docs/architecture.md#L201-L206"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_faefb2614496446e0474b3eacc4d8ca1282e86e85d9085919cd2c20cd9219fde"
      ],
      "text": "Message sequence numbers use disjoint parity — even seqs written by the host in messages_in, odd by the container in messages_out — forming a single monotonic id across both tables."
    },
