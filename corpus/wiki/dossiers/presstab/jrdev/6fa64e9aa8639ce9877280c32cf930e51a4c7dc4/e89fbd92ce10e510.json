      ],
      "text": "JrDev runs in the user's current working directory, started by entering 'jrdev' in a project directory, with commands like /init and /code typed into a Command Input field."
    },
    {
      "basis": "documented",
      "claim_id": "clm_426a84bdac74b688192cf0b1631beb17609fb60c06034f6f1b59cb1480019ab5",
