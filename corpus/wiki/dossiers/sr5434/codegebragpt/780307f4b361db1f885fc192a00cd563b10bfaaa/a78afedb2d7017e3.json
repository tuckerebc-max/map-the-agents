      ],
      "text": "The project's stated purpose is finetuning multimodal LLMs on STEM datasets."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7d041da455c6625a54a9ea334e3efacb60bd02adc17b636db50ca02c51c24eb2",
