      "slice_ids": [
        "slc_1671a057417b6a5a9c3aad3d232499010267afe2a6803af965a748e1b2c776eb"
      ],
      "text": "Training data is drawn from public Hugging Face datasets including MetaMathQA, Camel AI math/chemistry/physics/biology, GSM8K, MMLU, Evol Instruct Code, Glaive code assistant, arXiv-derived instruct sets, and ScienceQA."
    },
    {
      "basis": "documented",
