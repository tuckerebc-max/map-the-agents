          "git_sha": "9efcecb409feea00076cce8d6ce1587b446c4d56",
          "line_end": 80,
          "line_start": 75,
          "path": "README.md",
          "repository": "hofstadter-io/hof",
          "url": "https://github.com/hofstadter-io/hof/blob/52feda8ce076ec6a3501811c72dde0ca599b798d/README.md#L75-L80"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_dce76d11e8e971740d9a4bfc421534c3c09c0e6d442221a3b7ea4ab289eddaf6"
      ],
      "text": "The repository is organized around a Go CLI entrypoint (cmd/hof), core logic in lib/, a CUE-based task engine in flow/, docs site source, and CI scripts."
    },
    {
      "basis": "documented",
      "claim_id": "clm_39f29d021fe53d75d1fbf63f98aefd0da98544a82f616f291dd9b957ea17659a",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
