          "git_sha": "9efcecb409feea00076cce8d6ce1587b446c4d56",
          "line_end": 29,
          "line_start": 26,
          "path": "README.md",
          "repository": "hofstadter-io/hof",
          "url": "https://github.com/hofstadter-io/hof/blob/52feda8ce076ec6a3501811c72dde0ca599b798d/README.md#L26-L29"
