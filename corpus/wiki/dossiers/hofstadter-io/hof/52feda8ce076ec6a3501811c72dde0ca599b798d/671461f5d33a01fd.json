        "slc_430316fc1470c845f29baf48834134c915323e3338eee564426047c33ea4b275",
        "slc_97adeb374d8fb1bcd973f2c26d24c4ebdc122f443bbcce37c01b8479d8d08cfd"
      ],
      "text": "The CLI offers main commands including chat, create, datamodel, def, eval, export, flow, fmt, gen, mod, tui, and vet, plus additional commands like update, version, completion, and feedback."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b3675f3d00a4347391610dd9563ff390ec30845ff2261464da3dc18a400df504",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
