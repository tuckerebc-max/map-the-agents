      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6e21f920eeb8f0aec48b2069072da1e1b7e927960b590ec16491c639ae72f0fc"
      ],
      "text": "hof is built on CUE, which the project treats as the language for schemas, configuration, and declarative sources of truth, powering both developer experience and implementation."
    },
