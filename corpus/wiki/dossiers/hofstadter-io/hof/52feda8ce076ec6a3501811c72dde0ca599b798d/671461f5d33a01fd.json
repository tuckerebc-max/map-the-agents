          "line_end": 147,
          "line_start": 135,
          "path": "README.md",
          "repository": "hofstadter-io/hof",
          "url": "https://github.com/hofstadter-io/hof/blob/52feda8ce076ec6a3501811c72dde0ca599b798d/README.md#L135-L147"
