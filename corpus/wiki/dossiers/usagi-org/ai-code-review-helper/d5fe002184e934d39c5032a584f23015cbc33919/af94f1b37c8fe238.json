      ],
      "text": "General review mode uses /github_webhook_general and /gitlab_webhook_general endpoints, producing one Markdown summary comment per changed file."
    },
    {
      "basis": "documented",
      "claim_id": "clm_68018abaa9014456143de0f2fff6cad64915eb4d9f678bd3697f56be506d768d",
