      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_85682b0db91bd419abe6e3a6fc5e634c0ec95acd2331a6f611830a929aa105ae"
      ],
      "text": "Global configuration is loaded from environment variables; runtime changes made via the admin panel take effect immediately but are reloaded from environment variables on restart, so env vars are recommended for persistent global config."
    },
