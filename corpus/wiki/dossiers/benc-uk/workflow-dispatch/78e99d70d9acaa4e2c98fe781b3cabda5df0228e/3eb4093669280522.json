{
  "applied_operation_id": "op_7fb31a86cee641918da5bd81b3ed30b4",
  "claims": [
    {
      "basis": "documented",
      "claim_id": "clm_77f1a4d8c9666b80d9e4d84fb2a3baf5204b83111a73acbd9289fd8974ad67ca",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 4,
          "line_start": 3,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L3-L4"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_13734364f8f3226882b7769236e18ff3de573ebc3198206b1f3ab406eb1ab090"
      ],
      "text": "The action triggers another GitHub Actions workflow using the workflow_dispatch event, and the target workflow must be configured for that event type."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5bbd03c504971e64a0da710c8c58a9c6d8e8320a7659ad3a7d5b73d32a855510",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 6,
          "line_start": 6,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L6-L6"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_8c96728cf221af1f4948c12a62c62cd5ba6c27b5b413c4da13ab479870036f8f"
      ],
      "text": "The intended use case is chaining workflows, e.g. a CI build workflow triggering a CD deploy workflow, allowing separate CI/CD workflows that pass data between them."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ab9bbaa57f9fdc21277935e768b48616af8930bf3bad777aedb0f5f6ebaf8775",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 24,
          "line_start": 24,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L24-L24"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_12d6c4e3f469d511953a0b1c01127f1dc0c62dbfa3073169ca0f9f5cca066edb"
      ],
      "text": "The required `workflow` input accepts the target workflow's name, filename, or ID, and all three forms are used when looking up the workflow."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b55009ba4a706844940229229c032d80b0989f470803fd1c81cefd419a991c84",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 38,
          "line_start": 38,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L38-L38"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_774307709a3c2279421b14f98c141e12f49843f71f3709afe3e06ca1857b67fa"
      ],
      "text": "An optional `inputs` parameter passes inputs to the target workflow as a JSON-encoded string, for workflows that have inputs configured."
    },
    {
      "basis": "documented",
      "claim_id": "clm_62efcea2197d2796fcf407626b6f50ab4c95abb4309c2db4d9e01d809d639b27",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 42,
          "line_start": 42,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L42-L42"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c888c2d27ffbc5678d082ec9103653c5c158e1444355222aa4e918936f391acf"
      ],
      "text": "An optional `ref` input sets the Git reference (branch, tag, or commit SHA) for the triggered run; if omitted, the triggering workflow's context ref is used."
    },
    {
      "basis": "documented",
      "claim_id": "clm_48fc76b459966a6b51a16048da35f820d62c5fa90a0a2b2b580f9bc45fa3f609",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 46,
          "line_start": 46,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L46-L46"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_fbd8b8f19271cedc9247c835a8b3b54dceb8d7f491e0b7e2a5007f87eb3c8fee"
      ],
      "text": "By default workflows are triggered in the same repo; an optional `repo` input (owner/name) enables triggering in another repository."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e82c34f2e54f92acd6b43e9d545f4a28b3a67c9fd93d8a2f2a18b0d8d5b3a505",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 55,
          "line_start": 55,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L55-L55"
        },
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 53,
          "line_start": 53,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L53-L53"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_80f35d14ffa000a54ea785697624b5108e3ea7f6be76eed28c2a07a7b438ba74",
        "slc_e5fcdd4075a8f963e8aaf00d9b445d5d778b96d56ce444cc89fc5809da0b5828"
      ],
      "text": "By default the standard GITHUB_TOKEN is used, so users no longer need to supply their own token; cross-repo dispatch requires a PAT with repo rights passed via a secret."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b58084cd291ef269914f25524263ce4321732e65c35c792fa5f8c82c090e3d85",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 61,
          "line_start": 61,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L61-L61"
        },
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 69,
          "line_start": 69,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L69-L69"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_372d91b5466484f04314edbd3139ffcd3513b463c3ec71bae96b416fe9ab54d7",
        "slc_e1fe903a7ac8719b3b437901d0a61ccd49b8da27479849314374c297691f5e0a"
      ],
      "text": "Setting `wait-for-completion` to true makes the action poll the triggered run's status every 5 seconds until it finishes, with the interval configurable via `wait-interval-seconds`."
    },
    {
      "basis": "documented",
      "claim_id": "clm_773d0a99079f5de9e41aed1cc476e26f8554f2e13e70175d6d2a040195f6cb78",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 65,
          "line_start": 65,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L65-L65"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_24ac131ef9ca8149bbab02b7134dd9659bd8ea60d7c5e31ba319435aae2f4916"
      ],
      "text": "The `wait-timeout-seconds` input caps waiting at a default of 900 seconds (15 minutes), applying only when wait-for-completion is enabled."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ea7812eac26aae256d286a7384eef75f0576b16ea50b6b05f4d3a5bc15dab073",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 73,
          "line_start": 73,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L73-L73"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_25152e8755e88041d3efbf5362ed6182b60215f7f8abb426653e0acb0e9d19b5"
      ],
      "text": "With `sync-status` set to true, the action fails if the triggered workflow run fails or is cancelled; this requires wait-for-completion to be enabled."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0a7d63090279ac57cd4493643c215917db4a2cc29d1232db5557ffbfab7960b5",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 82,
          "line_start": 77,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L77-L82"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9dc8216295fef7e7109a967b9263be4fcc960c2c97f385bc6ca1e053e7ab17cd"
      ],
      "text": "The action exposes outputs runId, runUrl, runUrlHtml, and workflowId describing the triggered workflow run."
    },
    {
      "basis": "documented",
      "claim_id": "clm_55e60e31c082f76692d9e1716ad43c506b219855fc5f1cc1cf1f5a48c655fdb5",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
          "commit": "78e99d70d9acaa4e2c98fe781b3cabda5df0228e",
          "git_sha": "51bf96e420cf094b0189d396351ab6da757795cf",
          "line_end": 14,
          "line_start": 14,
          "path": "README.md",
          "repository": "benc-uk/workflow-dispatch",
          "url": "https://github.com/benc-uk/workflow-dispatch/blob/78e99d70d9acaa4e2c98fe781b3cabda5df0228e/README.md#L14-L14"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6a6ce9ae3849f711be9009ffa501d7beebb3bf034696cad50e3a4b8410d15295"
      ],
      "text": "Workflows triggered by this action appear in the GitHub UI as \"manually triggered\", since the action simulates the manual workflow_dispatch trigger."
    }
