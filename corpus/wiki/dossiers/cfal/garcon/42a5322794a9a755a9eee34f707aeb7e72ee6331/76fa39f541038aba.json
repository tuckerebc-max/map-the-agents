      "slice_ids": [
        "slc_8e45c3ff4fb8fbdde2b59c188985429810c35bcee07aa11690a4274be08c557a"
      ],
      "text": "The web UI is served at http://127.0.0.1:8080 by default; first launch requires creating an account at /setup, and authentication is enabled by default."
    },
