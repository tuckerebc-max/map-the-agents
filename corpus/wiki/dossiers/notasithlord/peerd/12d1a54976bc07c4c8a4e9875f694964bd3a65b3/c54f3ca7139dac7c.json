        "slc_f5cbff8369f35e17a42aa7163c39f0404090956ba3e66675be7cee2f8048516f"
      ],
      "text": "peerd is described as a general-purpose agent runtime built on browser primitives (Workers, origins, sandboxing, OPFS, WASM/WASI, WebRTC, WebAuthn, WebExtensions) that runs inside Chrome and Firefox."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7ffb39d9dd53d3709f9ddb054d15da4cc24521bcb49841076596aff7ecbb9ea6",
      "evidence_type": "organizational_statement",
