          "git_sha": "11191d87cd7af63bc0d5c75eeeb4999cfec532e1",
          "line_end": 417,
          "line_start": 417,
          "path": "README.md",
          "repository": "taewooopark/agent-blackbox",
          "url": "https://github.com/TaewoooPark/Agent-Blackbox/blob/bc0d72aeb7bd207b48099ba07f813be37c0e449c/README.md#L417-L417"
