      "slice_ids": [
        "slc_32bc508dd7676e75619c93c7c3817ae2542ba4070a5f7f82cc7c88f314832156"
      ],
      "text": "The open-source version includes only the editor, works with a single project, and requires the project path to be declared in a .env file."
