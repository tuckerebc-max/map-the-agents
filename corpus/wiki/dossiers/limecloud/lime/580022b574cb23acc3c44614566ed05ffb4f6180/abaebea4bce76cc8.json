      "slice_ids": [
        "slc_759b252a07d49e255c58f69218565f1f73c4ebca15ca6a70103b141f09aa8160"
      ],
      "text": "Desktop GUI business capabilities enter the Rust runtime only through App Server JSON-RPC; Electron IPC is limited to windows, file selection, system permissions, notifications, updates, native views, and sidecar lifecycle."
    },
