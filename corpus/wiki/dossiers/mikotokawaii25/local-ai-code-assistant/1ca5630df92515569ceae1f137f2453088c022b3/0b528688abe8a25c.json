      "slice_ids": [
        "slc_1602127c9e406af781742649f22140f6212f9c0aa90631e74728aec207943eab",
        "slc_bb12d15417cb50538ab37eed6cf8238c3e7fae27b5f5b256f238c2ac845291f7"
      ],
      "text": "Configuration is exposed through a loom_config.yaml file covering per-task model assignments, token budgets, sampling parameters, context-sharing rules, theme, and LAN-only remote access."
    },
    {
      "basis": "documented",
      "claim_id": "clm_35c508f0a0ac363d91d79f270924eb2de42200a2c0f73dc8c1cd12c9d81d5a9a",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "1ca5630df92515569ceae1f137f2453088c022b3",
          "git_sha": "3f10350e01859ab32a086839ed2c2f778972b46c",
          "line_end": 108,
          "line_start": 108,
          "path": "README.md",
          "repository": "mikotokawaii25/local-ai-code-assistant",
          "url": "https://github.com/MIKOTOKAWAII25/local-ai-code-assistant/blob/1ca5630df92515569ceae1f137f2453088c022b3/README.md#L108-L108"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_7583e31cf9a1bc28dc402cc43f56b5e4ccbd1fdef3d9c1e49f9fa4573d451f8a"
      ],
      "text": "Advanced users can write custom 'loom scripts' in Lua that define model interactions, thread switching, and output merging."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5c841f4ee2958fee2f9985721b5678c5ba1ab77cfcd5b8451699182023252f48",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "1ca5630df92515569ceae1f137f2453088c022b3",
          "git_sha": "3f10350e01859ab32a086839ed2c2f778972b46c",
          "line_end": 41,
          "line_start": 41,
          "path": "README.md",
          "repository": "mikotokawaii25/local-ai-code-assistant",
          "url": "https://github.com/MIKOTOKAWAII25/local-ai-code-assistant/blob/1ca5630df92515569ceae1f137f2453088c022b3/README.md#L41-L41"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4e3db7b3426d4ed5a6fe5d95cf29bd16499f3d147660a64dc0f86b25a1d4ab73"
      ],
      "text": "The app indexes a codebase as context up to 100k tokens and splits it across model threads so each model sees a relevant slice."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0c40d1f24190c39551ddf0eb50288376fb4e688991a5948ac280ddf563a1f0c2",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
