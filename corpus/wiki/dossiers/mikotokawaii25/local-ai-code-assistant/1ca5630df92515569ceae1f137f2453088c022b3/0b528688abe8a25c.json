        "slc_dc57561aef2503991d08934b237efe5fa7fd21c3995c6e49e0007f2645285e58",
        "slc_e10bc026d6a1b26b2f7e6726fea43c00af9d725fe3fb3b95e43d645817209b5c"
      ],
      "text": "CodeLoom is designed as an offline-only desktop tool that runs multiple open-source models locally with no cloud dependencies or data leaving the machine."
    },
    {
      "basis": "documented",
      "claim_id": "clm_dc3d49f4d72e0242de79b014c31f7bc95b2f7ad73c8a491f7b2241555105694e",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "1ca5630df92515569ceae1f137f2453088c022b3",
          "git_sha": "3f10350e01859ab32a086839ed2c2f778972b46c",
          "line_end": 26,
          "line_start": 26,
          "path": "README.md",
          "repository": "mikotokawaii25/local-ai-code-assistant",
          "url": "https://github.com/MIKOTOKAWAII25/local-ai-code-assistant/blob/1ca5630df92515569ceae1f137f2453088c022b3/README.md#L26-L26"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_92410b69a3b7aaf5c50221e4d42258e7fdc1d6e9557ff656f8a48d1748439cb0"
      ],
      "text": "The product supports up to five concurrent model sessions, each with its own context window, history, and parameters, and lets the user pick which thread's answer wins."
    },
    {
      "basis": "documented",
      "claim_id": "clm_eede548c2c423cda8a9059c4286058050856f6a2402abcb014b28953613f2659",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "1ca5630df92515569ceae1f137f2453088c022b3",
          "git_sha": "3f10350e01859ab32a086839ed2c2f778972b46c",
          "line_end": 29,
          "line_start": 29,
          "path": "README.md",
          "repository": "mikotokawaii25/local-ai-code-assistant",
          "url": "https://github.com/MIKOTOKAWAII25/local-ai-code-assistant/blob/1ca5630df92515569ceae1f137f2453088c022b3/README.md#L29-L29"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_714def682d03d4abf01056d09b33f9f7096ccf49a18117edc74fe81bdcc79e43"
      ],
      "text": "Context can be merged between model threads manually or automatically, e.g. passing a small model's draft to a larger model without copy/paste."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1f71f80423c143f50d67feb1216a3efc34453e6cfbfe1b8add349f0fc79d3414",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "1ca5630df92515569ceae1f137f2453088c022b3",
          "git_sha": "3f10350e01859ab32a086839ed2c2f778972b46c",
          "line_end": 57,
          "line_start": 57,
          "path": "README.md",
          "repository": "mikotokawaii25/local-ai-code-assistant",
          "url": "https://github.com/MIKOTOKAWAII25/local-ai-code-assistant/blob/1ca5630df92515569ceae1f137f2453088c022b3/README.md#L57-L57"
        },
        {
          "commit": "1ca5630df92515569ceae1f137f2453088c022b3",
          "git_sha": "3f10350e01859ab32a086839ed2c2f778972b46c",
          "line_end": 61,
          "line_start": 59,
          "path": "README.md",
          "repository": "mikotokawaii25/local-ai-code-assistant",
          "url": "https://github.com/MIKOTOKAWAII25/local-ai-code-assistant/blob/1ca5630df92515569ceae1f137f2453088c022b3/README.md#L59-L61"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_3ae7209cf3981876d533f2c799c84e1c20d43407c7b6f0c01b555792937b55c1",
        "slc_b86d4a62460c880bd0bc96e22b97a116ce3fafb17fc8575314710ed6c09ebc6f"
      ],
      "text": "A 'loom' concept assigns a main 'warp' model for heavy tasks and auxiliary 'weft' models for fast tasks, with a cross-thread shuttle passing tokens between threads."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1aff519aae4c3939f1ef7a30b22f53aab0adc822cbaa6d4f0c5d110f2533646f",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "1ca5630df92515569ceae1f137f2453088c022b3",
          "git_sha": "3f10350e01859ab32a086839ed2c2f778972b46c",
          "line_end": 19,
          "line_start": 17,
          "path": "README.md",
          "repository": "mikotokawaii25/local-ai-code-assistant",
          "url": "https://github.com/MIKOTOKAWAII25/local-ai-code-assistant/blob/1ca5630df92515569ceae1f137f2453088c022b3/README.md#L17-L19"
        },
        {
          "commit": "1ca5630df92515569ceae1f137f2453088c022b3",
          "git_sha": "3f10350e01859ab32a086839ed2c2f778972b46c",
          "line_end": 35,
          "line_start": 35,
          "path": "README.md",
          "repository": "mikotokawaii25/local-ai-code-assistant",
          "url": "https://github.com/MIKOTOKAWAII25/local-ai-code-assistant/blob/1ca5630df92515569ceae1f137f2453088c022b3/README.md#L35-L35"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_64acab42e088cef2d40acc15d4a46f86576a87b0c58f85ee9487ba18002c03b1",
        "slc_d4527a7dd3b328ea985629a0031f49c058f9ea5b35d4147d0ca0e3ab681dec8d"
      ],
      "text": "Inference runs via local backends including llama.cpp, ExLlama, and MLX, and models can be imported from Hugging Face, Ollama, or local GGUF/GPTQ files."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e23daa62e7c7ef158479c5e0c7640cd2454827c82c0006d018a3125029978433",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
