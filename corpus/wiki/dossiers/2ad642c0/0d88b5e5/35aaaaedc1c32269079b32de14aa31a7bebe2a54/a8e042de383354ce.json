          "line_end": 338,
          "line_start": 333,
          "path": "README.md",
          "repository": "dimitrigeelen/agentic-engineering-framework",
          "url": "https://github.com/DimitriGeelen/agentic-engineering-framework/blob/35aaaaedc1c32269079b32de14aa31a7bebe2a54/README.md#L333-L338"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_acbe64eaafabf063efc8d1428e57821b0f2f25afae6221ee7e7ae71a3e0c6024"
      ],
      "text": "A tiered authority model: Tier 0 destructive commands need human approval via `fw tier0 approve`, Tier 1 edits need an active task, Tier 2 exceptions are single-use and logged, Tier 3 read-only is pre-approved."
    },
    {
      "basis": "documented",
      "claim_id": "clm_250b88293dd96367dea437f48198c698874a270823a7a6962d13fd8789b0a5ff",
      "evidence_type": "organizational_statement",
