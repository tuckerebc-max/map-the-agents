        "slc_2001379ba05d5a44ce4b38de7ebdd6202cebb232289b5529c77443b17fd29fe0"
      ],
      "text": "The framework's core principle is traceability: nothing gets done without a task, with conversations, decisions, and artefacts captured in a record called the Context Fabric."
    },
    {
      "basis": "documented",
      "claim_id": "clm_de5e41cb55dc06640216ad9b756eed5fce68c429f99802f8d765a5da1578f526",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
