          "git_sha": "976559d20704ff9c7a6615a44a9482bebfd6d63f",
          "line_end": 43,
          "line_start": 39,
          "path": "README.md",
          "repository": "dimitrigeelen/agentic-engineering-framework",
          "url": "https://github.com/DimitriGeelen/agentic-engineering-framework/blob/35aaaaedc1c32269079b32de14aa31a7bebe2a54/README.md#L39-L43"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_33e4b8c9689de56930c90c33a6233c7cf89380a6efeda5f3296ebb33b10bc1d6"
      ],
      "text": "A Component Fabric maps how code pieces relate, making a change's blast radius visible before the change rather than after."
    },
    {
