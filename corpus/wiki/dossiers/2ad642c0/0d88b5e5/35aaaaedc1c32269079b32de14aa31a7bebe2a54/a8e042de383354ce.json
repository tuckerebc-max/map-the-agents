        "slc_662eb0a24fbdb82efc645bcf6617fc586e52d30774947036c5e520fc60ff3062"
      ],
      "text": "A PreToolUse hook intercepts file modifications and refuses edits when no active task is set; build tasks with placeholder acceptance criteria are blocked (policy G-020)."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e83bc772c0ce2638c050d92f148cd129ffa3c080779829852e69977d23911b75",
      "evidence_type": "organizational_statement",
