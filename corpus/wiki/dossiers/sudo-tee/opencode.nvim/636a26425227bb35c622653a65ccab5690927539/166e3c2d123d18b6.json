          "line_end": 27,
          "line_start": 27,
          "path": "README.md",
          "repository": "sudo-tee/opencode.nvim",
          "url": "https://github.com/sudo-tee/opencode.nvim/blob/636a26425227bb35c622653a65ccab5690927539/README.md#L27-L27"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4300aee06e89ff7c49826953b83fce178c5d7b730f078118f341c64a61d3c26f"
      ],
      "text": "A dedicated chat panel window inside Neovim shows previous messages and responses and uses workspace/editor state as context for iterating on code."
    },
