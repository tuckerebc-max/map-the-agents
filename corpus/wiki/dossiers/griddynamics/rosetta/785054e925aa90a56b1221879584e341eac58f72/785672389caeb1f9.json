        "slc_2f3c8496dd9e91320286bffb52471b9acb09bf604126103cba49ada20336bc76",
        "slc_36c0f35f97c7f61163b4939f8beef33c807742e34b85a5be151d26ad4eddbb93"
      ],
      "text": "Rosetta layers instructions at runtime — core, then organization, then project — with higher layers propagating to every project automatically, all authored in markdown and versioned in Git."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f7623ff1a657804b23de4140cfd0613403ef9063d2b6551373647c6fbb6130a1",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "785054e925aa90a56b1221879584e341eac58f72",
          "git_sha": "ff28e8e2d0460cb70e6e5c2af4e14abc32d9e5c0",
          "line_end": 72,
          "line_start": 72,
          "path": "docs/ARCHITECTURE.md",
          "repository": "griddynamics/rosetta",
          "url": "https://github.com/griddynamics/rosetta/blob/785054e925aa90a56b1221879584e341eac58f72/docs/ARCHITECTURE.md#L72-L72"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d67955ebc568825154f6025880fb70bc56c39d95611d23fc50a7fdc3fea5fa8a"
      ],
      "text": "The architecture follows inversion of control: Rosetta does not see or process source code; it exposes guardrails and a menu of instructions, and the coding agent selects only what it needs."
    },
