      "slice_ids": [
        "slc_041a106fae0b9a68746cd8fe0cfe5a31eb89cd8ecd4c134fd630c9ebbf452c35"
      ],
      "text": "test_flex.py exposes CLI flags including --task_type (math/retro), --actor, --memory_path, --split, --samples, --batch_size, --no-retrieve for ablation, --pass_at_n, and --no-telemetry."
    },
