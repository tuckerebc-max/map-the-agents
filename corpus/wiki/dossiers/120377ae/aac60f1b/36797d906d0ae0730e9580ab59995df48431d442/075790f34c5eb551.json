      "locators": [
        {
          "commit": "36797d906d0ae0730e9580ab59995df48431d442",
          "git_sha": "120f7bd99f79c234eb3691073a1d25896420fa99",
          "line_end": 93,
          "line_start": 93,
          "path": "README.md",
          "repository": "honeydew-ai/honeydew-ai-coding-agents-plugins",
          "url": "https://github.com/honeydew-ai/honeydew-ai-coding-agents-plugins/blob/36797d906d0ae0730e9580ab59995df48431d442/README.md#L93-L93"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_3ff5d2502b91a55034b2278b50bd7ae6f6e25aaf1a28d666ee74385603ecf22a"
      ],
      "text": "Skills are written as agent-agnostic markdown documentation that any MCP-capable coding agent can consume as prompts or instructions, rather than being tied to one agent's plugin format."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1bc47c994d43ff224e4c0e0b2db88fb2be7b3bc98418608bb6920fe662d92a4b",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
