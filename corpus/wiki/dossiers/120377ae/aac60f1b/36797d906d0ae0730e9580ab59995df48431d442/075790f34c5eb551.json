        "slc_4544795aa68a2cb20b527016ceb7f764531c3cc48d50bf09d5a4812a21a40bb2",
        "slc_6e4bae0d41d7a8c61f7b24647161f9e3c12175a43643f57876960f37643d5272",
        "slc_7b191651f0c776828641efa84437ea7e1616e272ec09e75834ff9604e946bbc4",
        "slc_814c445d49f3f6b3e73e532491e2203c7eb3c6926b3b5d3dd512df2536a56fa7",
        "slc_de7516d28a9b510eda5e1dc151d4590307e73f4974aa041cca28e4c1dc657c22"
      ],
      "text": "The plugin is distributed through agent-specific marketplaces: Claude Code and Copilot CLI use /plugin marketplace add, Codex uses codex plugin marketplace add, Cursor uses a Team Marketplace dashboard, and Gemini CLI uses gemini extensions install."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1998c197a235053dba156a5b5715d51791b7297d28707cff0744e86639051dd1",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "36797d906d0ae0730e9580ab59995df48431d442",
          "git_sha": "120f7bd99f79c234eb3691073a1d25896420fa99",
          "line_end": 191,
          "line_start": 191,
          "path": "README.md",
          "repository": "honeydew-ai/honeydew-ai-coding-agents-plugins",
          "url": "https://github.com/honeydew-ai/honeydew-ai-coding-agents-plugins/blob/36797d906d0ae0730e9580ab59995df48431d442/README.md#L191-L191"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9b98d14a662573e853d449b778d1db00e21f42f0b6dbeaeae4c36f757b561636"
      ],
      "text": "A Claude-specific release zip packages the plugin in claude.ai's expected layout, with .claude-plugin/plugin.json at the zip root alongside .mcp.json, hooks/, assets/, and skill markdown files."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8d0ac02a03ee4384318e38132f61956406d7eb4e58ea9b3bd515e889ce5483b2",
      "evidence_type": "organizational_statement",
