      "kind": "observation",
      "locators": [
        {
          "commit": "36797d906d0ae0730e9580ab59995df48431d442",
          "git_sha": "120f7bd99f79c234eb3691073a1d25896420fa99",
          "line_end": 16,
          "line_start": 15,
          "path": "README.md",
          "repository": "honeydew-ai/honeydew-ai-coding-agents-plugins",
          "url": "https://github.com/honeydew-ai/honeydew-ai-coding-agents-plugins/blob/36797d906d0ae0730e9580ab59995df48431d442/README.md#L15-L16"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_92d2d1d9cfcca126340340fcac84bd6eabbb68f0049e4a3ae36f81158ad761ea"
      ],
      "text": "Prerequisites are a coding agent with plugin/skill or MCP support (e.g., Claude Code, Codex, Cursor, Copilot CLI, Gemini CLI) and a Honeydew AI workspace with the Honeydew MCP server configured."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0e62889ea81350963a827d5b27535a93ddd0c3a318d54a58b1241741cc2aca2c",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "36797d906d0ae0730e9580ab59995df48431d442",
          "git_sha": "120f7bd99f79c234eb3691073a1d25896420fa99",
          "line_end": 185,
          "line_start": 183,
          "path": "README.md",
          "repository": "honeydew-ai/honeydew-ai-coding-agents-plugins",
          "url": "https://github.com/honeydew-ai/honeydew-ai-coding-agents-plugins/blob/36797d906d0ae0730e9580ab59995df48431d442/README.md#L183-L185"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ca864170eb5a4bf150d7540055a0f7fdf961dd1e5e3aa6dbbec11e8576e9bccb"
      ],
      "text": "Supported data warehouses are Snowflake, Databricks, and BigQuery."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e7f90bae5ffc00a9572e7dab1ba4435578342d45b9999b123ace762c72a09bb6",
      "evidence_type": "organizational_statement",
