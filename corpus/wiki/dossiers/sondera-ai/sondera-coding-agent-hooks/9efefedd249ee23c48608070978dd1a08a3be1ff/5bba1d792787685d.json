        "slc_7abe19841616eefc11fce37991a2a560ee3b0e5db2170b503898bbb33a460fdf"
      ],
      "text": "The harness coordinates three guardrail subsystems: a YARA-X signature engine (always on and the only deterministic one), an optional LLM secure-code policy classifier, and optional LLM information-flow sensitivity labeling."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8767f500c0ffa2ddd79be00717321c6c9125448995e9b94ae40097ee222889ef",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
