        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5019dc8519656fe93bd8aac6f4a642b2d54df36013a634e5c652b75d06c8c54f"
      ],
      "text": "Lineage lets sessions branch like ideas: a session can be forked for a parallel attempt, including cross-harness forks, and results merged back."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4d9c60a321fbb971b5ef835cfab111699ffb331093beebdc2ad24b6dccb01067",
