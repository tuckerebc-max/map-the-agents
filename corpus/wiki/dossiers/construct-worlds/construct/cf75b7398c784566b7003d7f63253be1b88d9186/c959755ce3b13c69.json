      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "cf75b7398c784566b7003d7f63253be1b88d9186",
          "git_sha": "9da83576bb5981cee20d999f39273413304372e2",
          "line_end": 32,
          "line_start": 25,
          "path": "README.md",
          "repository": "construct-worlds/construct",
          "url": "https://github.com/construct-worlds/construct/blob/cf75b7398c784566b7003d7f63253be1b88d9186/README.md#L25-L32"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5019dc8519656fe93bd8aac6f4a642b2d54df36013a634e5c652b75d06c8c54f"
      ],
      "text": "Sessions live in the daemon rather than the terminal, so SSH drops or laptop sleep do not stop agents, and users can reattach with scrollback intact."
    },
    {
      "basis": "documented",
      "claim_id": "clm_127af993f42400a88dd4141a77e2e2c5e02f31dad4eed105f7fe14e6e3dcd847",
