      "slice_ids": [
        "slc_5bc19712a8faf6d0f1690fe06eae112c7131d63bb3f3082ee4adf142c70c94a5",
        "slc_c67af16dc8d90e25340257a84c479f253b5ca5bd2aaaea6a486c82f08e185e3f"
      ],
      "text": "Each pane is a full working copy in its own worktree so agents do not conflict; merging auto-commits, merges, and cleans up in one step."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ad52f889b36563b378c4d8e21d39598c8fbd65f030586f6ad710404c5dedba7f",
