        "slc_c67af16dc8d90e25340257a84c479f253b5ca5bd2aaaea6a486c82f08e185e3f"
      ],
      "text": "dmux manages multiple AI coding agents in parallel, giving each task a tmux pane backed by its own isolated git worktree and branch, with merge or GitHub PR actions to bring work back."
    },
    {
      "basis": "documented",
      "claim_id": "clm_31fa6019a9afaeb2a140f3728cfda459cc486dbe77acef77d1f279fe087c33fe",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "8cb3d926631a9349ab67f7ece41d218427ac7e24",
          "git_sha": "f16e4eca1ea359ddad0044884480215f6c766e38",
          "line_end": 86,
          "line_start": 73,
          "path": "README.md",
          "repository": "standardagents/dmux",
          "url": "https://github.com/standardagents/dmux/blob/8cb3d926631a9349ab67f7ece41d218427ac7e24/README.md#L73-L86"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ee1421e4db545f7aa8f67db1561070caa785fe313c6cce2276d3f8f98eddf05f"
      ],
      "text": "The TUI exposes single-key shortcuts: n for a new worktree pane, t for a terminal pane, m for the pane menu, f for file browsing, s for settings, and q to quit, among others."
    },
    {
      "basis": "documented",
      "claim_id": "clm_25f1318024e3c5f39e490b50c2837f71d733d0fc13fae68b439dfd79956b8413",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "8cb3d926631a9349ab67f7ece41d218427ac7e24",
          "git_sha": "f16e4eca1ea359ddad0044884480215f6c766e38",
          "line_end": 60,
          "line_start": 49,
          "path": "README.md",
          "repository": "standardagents/dmux",
          "url": "https://github.com/standardagents/dmux/blob/8cb3d926631a9349ab67f7ece41d218427ac7e24/README.md#L49-L60"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5bc19712a8faf6d0f1690fe06eae112c7131d63bb3f3082ee4adf142c70c94a5"
      ],
      "text": "dmux supports launching many agent CLIs, including Claude Code, Codex, OpenCode, Cline, Gemini, Qwen, Amp, pi, Cursor, Copilot, and Crush, with multi-select of several agents per prompt."
    },
    {
      "basis": "documented",
      "claim_id": "clm_30ebe052a252f4f3d418e66abc46856e4df763a60814ec8cd706a230d16b190c",
