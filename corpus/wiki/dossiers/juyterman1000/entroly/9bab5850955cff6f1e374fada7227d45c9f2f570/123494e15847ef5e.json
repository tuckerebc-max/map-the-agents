      "slice_ids": [
        "slc_fa71be0f4906684b45fb31e9739ab2ba799df3deba0ae606525a3fd745ad959e"
      ],
      "text": "Architecture invariants specify fail-closed behavior only for the security/compliance gate and provider gateway; all other stages fail open by passing the exact original context through unchanged with a receipt warning."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3fe9aa7c7a429b28933df118f007705dfb45c4fb3fe4fdcdc24ebb10fbdcd8ee",
