          "line_end": 212,
          "line_start": 208,
          "path": "docs/nehemiah/architecture.md",
          "repository": "boringcomputers/nehemiah",
          "url": "https://github.com/boringcomputers/nehemiah/blob/fea6f0a5299154cb40da9f302a51547e61d40076/docs/nehemiah/architecture.md#L208-L212"
