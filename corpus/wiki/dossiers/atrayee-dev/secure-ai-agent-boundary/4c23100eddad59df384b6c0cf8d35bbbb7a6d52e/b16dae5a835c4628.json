        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_1548fc53308c4d2b196263e75930d779dbad1c69f8a2c371277ec632d8d90331",
        "slc_c5dfce6177ebaf3c36a76bbfe457ee94330fd6ef7f3c13922ad1b7dcf69256d1"
      ],
      "text": "The primary entry point is a .codeboundary.yml file at the repository root, defining a default contract, an allowed-models list with names and fingerprints, and an audit log destination such as a local .cb-audit/ directory."
    },
    {
      "basis": "documented",
      "claim_id": "clm_064297d1f673aee996b989a02163d9e296554c50057dc4d65890217de91c79d3",
