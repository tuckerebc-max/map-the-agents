          "git_sha": "4a93cf7993237c445fd9ce88f79705250c72b42b",
          "line_end": 102,
          "line_start": 102,
          "path": "README.md",
          "repository": "atrayee-dev/secure-ai-agent-boundary",
          "url": "https://github.com/Atrayee-dev/secure-ai-agent-boundary/blob/4c23100eddad59df384b6c0cf8d35bbbb7a6d52e/README.md#L102-L102"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d7972712b5b6b7a7452a954ebce6a120f356355fa4f08eda05fa52a6f70334e6"
      ],
      "text": "The tool is described as editor-agnostic, integrating with any tool that can run a CLI command before and after an edit or any IDE extension supporting LSP-like hook callbacks."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ac1b5cda3007c5e6fee52cd8c10e1b8db36c243f8bbdd1acc3a774b012105c76",
