      "slice_ids": [
        "slc_4d7eeaca6f49b8a50d55e6aff0f0e45aa4288c1c966e672eea3150a967762c2c",
        "slc_94a731e051c87c65e4e3bd5d1166b33f89b40accbf7055a1465cb957a6328698",
        "slc_cc4850278d079414138f6dfeb7c99d57c062f78d4439642a1a7fbe695eb6d1cb"
      ],
      "text": "The architecture uses a 'diplomat's pouch' metaphor: the engineer declares contract contents, the model receives only declared data, and output stays sealed until the engineer unseals it; extra context requests are logged as boundary violation attempts."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7ddbe2efa17f631cbc88fe30dcda9258170a684ac38587de544c4886cef2840d",
