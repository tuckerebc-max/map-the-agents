        "slc_f58c7bcc91d9640363489c1611928f8dc2231f2fe7b2d312724e4b2c99fce29a"
      ],
      "text": "Hybrid sessions route low-sensitivity tasks to a fast local model and high-complexity tasks to a frontier API under one contract, with context stripped and rehydrated between models."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d41f32b73134ab69bde4227b6b64838d1a633ac7b5b7be78c9ced7693ae07189",
