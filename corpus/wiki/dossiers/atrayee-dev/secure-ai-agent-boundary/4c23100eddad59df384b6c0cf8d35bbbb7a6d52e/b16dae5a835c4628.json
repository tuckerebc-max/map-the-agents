        "slc_61ae2014a1ab37140e9a0eea789ca8d76ec6a5feca3c95ba44463c72e0282fbc"
      ],
      "text": "CodeBoundary is described as a zero-trust compartment model in which each third-party model runs in an ephemeral container with strictly bounded data exposure, rather than sharing context across a common environment."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3d7a05b84c717a4173ee472f4097b1d885163265179f1c4dad51c5e080c4342b",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
