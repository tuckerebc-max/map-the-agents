      "slice_ids": [
        "slc_07f6e1f232e5d1af298d2af8016e0782e4f248e9ed637a2ef6a9bc6c8418abbf"
      ],
      "text": "A manager terminal serves as a central hub for cross-project commands, and multiple Claude Code sessions can run side-by-side with auto-dispatch by repo name, task ID, or context."
    },
    {
      "basis": "documented",
      "claim_id": "clm_dfb840c9d874c7017eb239e4a942abd2737c5b7cab30de6635043f15370b6394",
