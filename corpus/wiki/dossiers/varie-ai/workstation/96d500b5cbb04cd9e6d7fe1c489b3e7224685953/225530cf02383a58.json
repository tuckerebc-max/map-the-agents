      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_1cee34e520c4f03a5b093687e492c5a83a6836c1bb9ecae5b2709cbe3352e8fe"
      ],
      "text": "Voice audio is processed on-device via Apple Speech or WhisperKit, while LLM-based voice routing and OpenClaw agent integration are opt-in features that are off by default."
    },
