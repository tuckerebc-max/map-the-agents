        "slc_93dd2d6718c096c2b0666fea107da130da0547a2a7d52f38b630154c4ee62099"
      ],
      "text": "Screenshot capture supports three modes: session (Electron built-in, no permission), session plus multi-page scrollback via --pages N (max 10), and full-screen capture requiring macOS Screen Recording."
    },
    {
      "basis": "documented",
      "claim_id": "clm_68b14ea6f3db612a08093ac44838119765a610bed18d46589bfc0d11dbb439ca",
