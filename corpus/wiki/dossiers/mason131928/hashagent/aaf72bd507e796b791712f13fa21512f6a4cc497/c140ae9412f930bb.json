      "slice_ids": [
        "slc_860e433bee5dff00152ec23eb25d7715e0098245c98df24a6f4ce0ff4183eabb"
      ],
      "text": "Optional stateless Cloudflare Pages Functions provide /api/search and /api/read because search providers and arbitrary pages do not reliably allow browser CORS; they can be disabled in Agent settings."
    },
