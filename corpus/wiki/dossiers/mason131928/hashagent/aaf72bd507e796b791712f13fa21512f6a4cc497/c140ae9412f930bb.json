        "slc_c74f2e427528c634ddccd635cd96afa17cd586be74ca70435b7458ccc1cca2b1"
      ],
      "text": "Architecture routes agent decoding and inference through a model registry into a WebLLM Worker or a Transformers.js Worker, both targeting WebGPU on the user's device."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6a09bed3a98aac8a304fd8f79d3f0f5969aef0a287b0d73f262e0519d54f1365",
