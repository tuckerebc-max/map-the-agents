      "slice_ids": [
        "slc_1d81d5bd074685550ec801b58323febf6bdf02325e9ea761f5e4dc4321c1cd3d"
      ],
      "text": "The workflow has three phases: plan (crawl up to 3 pages, capture accessibility snapshots, generate specs), execute (specs run in parallel in isolated browser contexts), and report."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a827647b82b191892e38dd675073fcdd5721979b6b77db0f7bbb6fdd1f3e3634",
      "evidence_type": "organizational_statement",
      "facet": "components",
