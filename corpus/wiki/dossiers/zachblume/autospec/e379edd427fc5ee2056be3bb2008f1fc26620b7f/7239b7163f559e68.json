      "slice_ids": [
        "slc_1d81d5bd074685550ec801b58323febf6bdf02325e9ea761f5e4dc4321c1cd3d"
      ],
      "text": "The executor uses semantic actions like click by role, fill by label, press keys, scroll, and navigate, re-reading the accessibility snapshot after each step."
    },
