        "slc_593f3fbb9c4f3f947684e88920ceca7e19e8f31e9039b880e07f9cc93ea13630"
      ],
      "text": "Autospec is described as an AI agent that autonomously explores a web app, generates commonsense test specs, and executes them, producing reusable Playwright test files."
    },
    {
      "basis": "documented",
      "claim_id": "clm_423afbe7c3e8e5e16b5c63dfd6ae774cbc021b5bd6c4a0ed80035309168e2a1d",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "e379edd427fc5ee2056be3bb2008f1fc26620b7f",
          "git_sha": "ff2790cf6d5148827e24043a0d762452c1014346",
          "line_end": 10,
          "line_start": 5,
          "path": "README.md",
          "repository": "zachblume/autospec",
          "url": "https://github.com/zachblume/autospec/blob/e379edd427fc5ee2056be3bb2008f1fc26620b7f/README.md#L5-L10"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_593f3fbb9c4f3f947684e88920ceca7e19e8f31e9039b880e07f9cc93ea13630"
      ],
      "text": "It uses vision and language models to judge the whole UI after each interaction, deciding correctness rather than checking regressions against rigid prior behavior."
    },
    {
