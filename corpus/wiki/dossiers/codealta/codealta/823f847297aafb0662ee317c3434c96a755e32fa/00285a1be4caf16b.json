      "slice_ids": [
        "slc_a393fe8650fe231a8b89d002e59c43d1c26c2bfcc1aa51ae7c18d0cd48073161"
      ],
      "text": "Agent sessions are durable and project-scoped, stored in CodeAlta-owned journals, and can be reopened independently of provider startup; prompts can be queued on busy sessions."
    },
