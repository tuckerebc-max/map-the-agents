      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2fffa2e9757df06917dec4b288aa03c49ef30640791bc005ea8653a958b04647"
      ],
      "text": "Long-running tasks can pause and ask the user a question back through the Cowork session via request_cowork.sh, moving through awaiting_reply, reply_to_machine(), and resume_remote(), with timeouts distinguishable from approvals and parallel tasks getting separate replies."
    },
