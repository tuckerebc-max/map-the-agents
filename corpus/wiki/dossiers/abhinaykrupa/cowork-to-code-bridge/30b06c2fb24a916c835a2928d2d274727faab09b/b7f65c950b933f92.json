        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_76e9d89b535ef2edbd2f62a4850d2a33e324bc1590a099229582dc038327d381",
        "slc_bcfa11f149ac144ecf6b12f3b4a0363f20bd570883216861fe000d605852801e"
      ],
      "text": "Tasks are JSON files written to a queue/ folder and results are JSON files in results/, with the daemon polling roughly every second; no network connection exists between the Cowork sandbox and the machine."
    },
    {
