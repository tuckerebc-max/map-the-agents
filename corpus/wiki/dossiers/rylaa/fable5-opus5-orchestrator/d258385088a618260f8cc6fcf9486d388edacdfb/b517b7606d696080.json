        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c883385d815c85ecb7ea986bc9af3984d50460dddf2ec242e2956752a4bd8f6b"
      ],
      "text": "The product is a Claude Code plugin installed via the marketplace commands `/plugin marketplace add Rylaa/fable5-opus5-orchestrator` and `/plugin install orchestrator@fable-orchestrator`."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d0fcf10d2c3aa7937cd2ba83e241e5bd856c9eff75beeb3ff3d8f2b47d066e9b",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "d258385088a618260f8cc6fcf9486d388edacdfb",
          "git_sha": "b652138c2c297d9ac3899b000aee062018fc76a2",
          "line_end": 14,
          "line_start": 14,
          "path": "README.md",
          "repository": "rylaa/fable5-opus5-orchestrator",
          "url": "https://github.com/Rylaa/fable5-opus5-orchestrator/blob/d258385088a618260f8cc6fcf9486d388edacdfb/README.md#L14-L14"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_263f83e83386f6b107189526ec403dff34445eba161a2ab2d751e65e9bb28c73"
      ],
      "text": "The plugin needs `python3` on PATH, supports macOS and Linux only, and Claude Code must be restarted after installation."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d4f95ba1c01c5d2cb4e33f8f385b8bd985dd6104b5bf3714e3deb18be4929184",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "d258385088a618260f8cc6fcf9486d388edacdfb",
          "git_sha": "b652138c2c297d9ac3899b000aee062018fc76a2",
          "line_end": 22,
          "line_start": 18,
          "path": "README.md",
          "repository": "rylaa/fable5-opus5-orchestrator",
          "url": "https://github.com/Rylaa/fable5-opus5-orchestrator/blob/d258385088a618260f8cc6fcf9486d388edacdfb/README.md#L18-L22"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d501911551fed5e031a47e22018380d66f80577ecbefebac45533155cd08457b"
      ],
      "text": "Sessions run as: chair reads the repo, asks all questions in rounds before planning, writes a ledger, then works directly or through workers; workers cannot ask the user anything."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a5212a76b171883a4c28297660c2ab2ea8a5fae446d25a14c654af0cf19a3621",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "d258385088a618260f8cc6fcf9486d388edacdfb",
          "git_sha": "b652138c2c297d9ac3899b000aee062018fc76a2",
          "line_end": 33,
          "line_start": 28,
          "path": "README.md",
          "repository": "rylaa/fable5-opus5-orchestrator",
          "url": "https://github.com/Rylaa/fable5-opus5-orchestrator/blob/d258385088a618260f8cc6fcf9486d388edacdfb/README.md#L28-L33"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ea797db768170c3ce54a197cea347745202b0eff3971d68856e5f377dce4fd2a"
      ],
      "text": "Four hooks enforce the workflow: a PreToolUse clarify gate, a PreToolUse spawn gate, a task-list gate on the third ledgerless tracker task, and a Stop gate when a turn ends with open ledger items."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f58a7e45025e484b597c5e8d42d7b40d7ada39be61c782d88064b2acbdc2af13",
      "evidence_type": "organizational_statement",
