      "kind": "observation",
      "locators": [
        {
          "commit": "ba53ebed3643920bb9ef9d08ee33e59bd708c930",
          "git_sha": "a8e7646842e3881c2b7b48d18f1a833ccc8159f1",
          "line_end": 412,
          "line_start": 381,
          "path": "README.md",
          "repository": "video-db/call.md",
