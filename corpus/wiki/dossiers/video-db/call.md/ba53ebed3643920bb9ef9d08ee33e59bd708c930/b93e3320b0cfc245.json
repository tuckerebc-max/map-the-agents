      "slice_ids": [
        "slc_1d3d9267efae6d05beea91f74582cc11f94ff45c4bfcbc1bcec04eb848ed5573"
      ],
      "text": "The local tRPC server binds to 127.0.0.1 only, accepts CORS from loopback origins, and every procedure except registration requires a valid access token; renderer windows run with contextIsolation and no Node integration."
    },
