      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4808bf29ff6e0767f6ce76aa05cde28461eb4443c212b0857ca69f679a42957c"
      ],
      "text": "Zellij is a workspace aimed at developers, ops-oriented people, and terminal enthusiasts; similar programs are known as terminal multiplexers."
    },
    {
      "basis": "documented",
      "claim_id": "clm_27c93638f02426190d0ea7446a3a2a91b5f46deffb771b27e3cb567da6ad602f",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "a162323384dff3fbd9c68a4c0971f4f6efca424a",
          "git_sha": "1685a1d7c3e748fbe57b4dd1c49f51fd8d696b8f",
          "line_end": 46,
          "line_start": 46,
          "path": "README.md",
          "repository": "zellij-org/zellij",
          "url": "https://github.com/zellij-org/zellij/blob/a162323384dff3fbd9c68a4c0971f4f6efca424a/README.md#L46-L46"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_23a80d90bdac0074884bdae46728e5edf0dd14f63338396514e162df2443fd8a"
      ],
      "text": "The project states a philosophy of not sacrificing simplicity for power, aiming for a strong out-of-the-box experience plus advanced features."
    },
    {
      "basis": "documented",
      "claim_id": "clm_31b40d585f1939d05d6d9c5ce73b4edffca7dca3fac3d25344a93ea3d2c6d800",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "a162323384dff3fbd9c68a4c0971f4f6efca424a",
          "git_sha": "1685a1d7c3e748fbe57b4dd1c49f51fd8d696b8f",
          "line_end": 48,
          "line_start": 48,
          "path": "README.md",
          "repository": "zellij-org/zellij",
          "url": "https://github.com/zellij-org/zellij/blob/a162323384dff3fbd9c68a4c0971f4f6efca424a/README.md#L48-L48"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_de186cdd4668e8fe6eea2af99fcad3e3aab9b9185118fc64d4e49d94ffecdc33"
      ],
      "text": "Zellij advertises deep customizability, layout-based personal automation, multiplayer collaboration, floating and stacked panes, and a plugin system for any language compiling to WebAssembly."
    },
    {
      "basis": "documented",
      "claim_id": "clm_47fd3457a1cf007496c591329b579ec1618d2cb5318b62399d1869b33cecd1ba",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "a162323384dff3fbd9c68a4c0971f4f6efca424a",
          "git_sha": "1685a1d7c3e748fbe57b4dd1c49f51fd8d696b8f",
          "line_end": 50,
          "line_start": 50,
          "path": "README.md",
          "repository": "zellij-org/zellij",
          "url": "https://github.com/zellij-org/zellij/blob/a162323384dff3fbd9c68a4c0971f4f6efca424a/README.md#L50-L50"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_78db6ef2f57fcdfb22bec1c00aeb4079f44ee3337954eada4d925e91d1c1d71a"
      ],
      "text": "Zellij includes a built-in web client, making a terminal optional for using it."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3d957ab74046ff817da29fd77c0116847b59b4c1ad392572c54919bb9498fcd8",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "a162323384dff3fbd9c68a4c0971f4f6efca424a",
          "git_sha": "0f0aaaa94ef74d1e54586c7ec7c6f5fc29524899",
          "line_end": 8,
          "line_start": 4,
          "path": "docs/ARCHITECTURE.md",
          "repository": "zellij-org/zellij",
          "url": "https://github.com/zellij-org/zellij/blob/a162323384dff3fbd9c68a4c0971f4f6efca424a/docs/ARCHITECTURE.md#L4-L8"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_370cbad8e8090762b8c7fcb18d0824d858957a7c068a1b41b5a91e76310f556c"
      ],
      "text": "The Screen component manages on-screen panes: coordinating pane resizing, creating new panes, and closing panes while filling their space with others."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ffdf28cf6513737c54693ff22f21b3569d47ca54f886b0c61a79e00a7778740f",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "a162323384dff3fbd9c68a4c0971f4f6efca424a",
          "git_sha": "0f0aaaa94ef74d1e54586c7ec7c6f5fc29524899",
          "line_end": 14,
          "line_start": 11,
          "path": "docs/ARCHITECTURE.md",
          "repository": "zellij-org/zellij",
          "url": "https://github.com/zellij-org/zellij/blob/a162323384dff3fbd9c68a4c0971f4f6efca424a/docs/ARCHITECTURE.md#L11-L14"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d81439325a08dc3fd15b3e0c4d69405cc0bf42eb2725933274da4cab7303093a"
      ],
      "text": "TerminalPane connects a pane to a single pty (typically running a shell or program), tracks the Scroll line buffer, and interprets ANSI/VT instructions for styling and cursor positioning."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6cf0d0bb45a5cb5e3150f51a8fbeae0a6953a8d49bd105b0f87e7b10f77ee8fb",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "a162323384dff3fbd9c68a4c0971f4f6efca424a",
          "git_sha": "0f0aaaa94ef74d1e54586c7ec7c6f5fc29524899",
          "line_end": 41,
          "line_start": 41,
          "path": "docs/ARCHITECTURE.md",
          "repository": "zellij-org/zellij",
          "url": "https://github.com/zellij-org/zellij/blob/a162323384dff3fbd9c68a4c0971f4f6efca424a/docs/ARCHITECTURE.md#L41-L41"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_b9a62bb8e2b628bf96ad616d614608df9750f322b7f7ae1d8446f86c41e3de56"
      ],
      "text": "The PtyBus tracks asynchronous streams reading from pty sockets, parses bytes into ANSI/VT events, and sends them to the Screen for delivery to the relevant TerminalPane."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c30fdd179c9eb3b6e3c1257e8627f61bc88df0fe751e13b8b0329a8a0bcc53a2",
