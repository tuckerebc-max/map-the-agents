      "slice_ids": [
        "slc_2e98e1527c8fa0070c709b0e038b69ae6fff1b1c648c3a74a4197c676915edf3",
        "slc_421129862e16638fdd7a4757af6bb6271e51f349a164e745a31127b2d34af165",
        "slc_496a04a174a7e79951dd0aff63fbae60f0d5b5f059a71960848dfe995e9cf570"
      ],
      "text": "Sinew connects to five providers — Anthropic, OpenAI, Google, Kimi (subscription/OAuth) and OpenRouter (API key) — usable in parallel so models can be mixed per mode, sub-agent, or teammate."
    },
    {
      "basis": "documented",
      "claim_id": "clm_19f6a1fe50e910915126c6e3e24154204181ea2e9ef6145d0c9aad92c6d21145",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
