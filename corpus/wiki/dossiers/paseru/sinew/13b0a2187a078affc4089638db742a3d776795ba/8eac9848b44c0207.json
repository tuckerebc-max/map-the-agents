        {
          "commit": "13b0a2187a078affc4089638db742a3d776795ba",
          "git_sha": "4c26caa7948603c78f14e88dd41a187d886386e1",
          "line_end": 35,
          "line_start": 25,
          "path": "README.md",
          "repository": "paseru/sinew",
          "url": "https://github.com/Paseru/sinew/blob/13b0a2187a078affc4089638db742a3d776795ba/README.md#L25-L35"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c227f6b584380d7999b0611e2ff0c02453f87f692b51685c26ef9fe6ad6e5c7b"
      ],
      "text": "The README warns that Claude Code and Antigravity OAuth flows are technically reserved for first-party clients, so third-party use could theoretically flag accounts, though no bans have been reported; API-key or OpenRouter paths are fully sanctioned."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b37c78a8766b5138350bc0aa7b06ac4b2019ec7e15aab7846933f215a8fba879",
      "evidence_type": "organizational_statement",
