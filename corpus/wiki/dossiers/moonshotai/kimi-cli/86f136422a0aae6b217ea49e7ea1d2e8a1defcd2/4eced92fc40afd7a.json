      "slice_ids": [
        "slc_213d6bf3470661ab87bb9c462817a1ba29ad544f77459341e9c1fc02bb043262"
      ],
      "text": "A prominent README notice states Kimi CLI is evolving into Kimi Code CLI from the same team, that installing Kimi Code CLI automatically migrates existing configuration and sessions, and that this project will be gradually wound down while its docs and existing installs remain available."
    },
