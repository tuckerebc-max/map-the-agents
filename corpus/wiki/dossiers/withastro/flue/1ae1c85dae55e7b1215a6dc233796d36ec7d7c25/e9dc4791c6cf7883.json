        "slc_f5d2d5ca33bb1dc7d72f862e51b9ebfe52bcb8e327cda403e7f448d57102e4b5"
      ],
      "text": "Agents are exported TypeScript functions marked with a 'use agent' directive; hooks like useModel, useSandbox, useSkill, and useTool compose capabilities, and the function's returned string is its instruction."
    },
    {
      "basis": "documented",
      "claim_id": "clm_14f1267daeb9aba6d0d8d7c3057ab2b2c5453a70b8fa71beb8df5e33dbbfe526",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
