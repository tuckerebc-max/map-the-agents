          "line_end": 54,
          "line_start": 46,
          "path": "README.md",
          "repository": "withastro/flue",
          "url": "https://github.com/withastro/flue/blob/1ae1c85dae55e7b1215a6dc233796d36ec7d7c25/README.md#L46-L54"
