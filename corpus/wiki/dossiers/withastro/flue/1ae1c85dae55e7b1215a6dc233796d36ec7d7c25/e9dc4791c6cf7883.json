      "slice_ids": [
        "slc_fd401e4b77a22267fa6e87f029243943eac62b98a0d716364a4bf4349f7472ab"
      ],
      "text": "The framework supports subagents: specialized roles can be defined for different tasks, and the agent can delegate work to the appropriate expert."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4d8456a7bdea1e471b1eca58cea45863d16ee1800d51f7ab710dad780818adba",
