      "slice_ids": [
        "slc_56ea8550b1611de1ae04372941cff187b741626c1cdafa83007f18c8e87aba93"
      ],
      "text": "Slash commands map to agents: /plan (Sokka), /build (Aang), /search (Toph), /fix (Katara), /tasks (Appa), /scout (Momo), /doc (Iroh), /image (Zuko), and /cactus-juice (swarm)."
    },
