          "git_sha": "498b1716a890d213c75259ee4da65af8968a1d09",
          "line_end": 76,
          "line_start": 76,
          "path": "README.md",
          "repository": "tmcfarlane/oh-my-cursor",
          "url": "https://github.com/tmcfarlane/oh-my-cursor/blob/5bad458bff4c18c470a9907c1a02ba8bf87ace90/README.md#L76-L76"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_13c2e9a355d2a86f3a64767a0c70e16a2884e6cf953476bef7cf23beefef8a82"
      ],
      "text": "The orchestrator rule makes the root thread a pure dispatcher whose only permitted tools are Task, TodoWrite, AskQuestion, and SwitchMode, delegating all work to specialist agents."
    },
    {
      "basis": "documented",
      "claim_id": "clm_57651503d8478abd2c8bef4b5f0f2dc31262c0eeb8dbc9da2b1fd86d722e3671",
