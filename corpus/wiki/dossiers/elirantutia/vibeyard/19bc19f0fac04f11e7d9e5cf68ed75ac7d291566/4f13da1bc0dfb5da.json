          "line_end": 54,
          "line_start": 41,
          "path": "README.md",
          "repository": "elirantutia/vibeyard",
          "url": "https://github.com/elirantutia/vibeyard/blob/19bc19f0fac04f11e7d9e5cf68ed75ac7d291566/README.md#L41-L54"
