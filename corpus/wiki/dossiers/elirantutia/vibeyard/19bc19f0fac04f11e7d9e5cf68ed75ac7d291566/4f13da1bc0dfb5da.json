      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5eddedcdab0cdacaff906b102714e25c8105364c7b23ae36b6ffc1db7c3bd5b2"
      ],
      "text": "Each agent session runs in its own PTY, and multiple Claude profiles are supported with each session backed by an isolated config directory so credentials and history do not mix."
    },
