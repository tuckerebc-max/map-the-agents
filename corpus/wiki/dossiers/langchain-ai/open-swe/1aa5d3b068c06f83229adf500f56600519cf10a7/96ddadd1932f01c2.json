      "slice_ids": [
        "slc_c1765cfa73e1c7244b247ddf3442944fde3fbdb1f8c2505a21679ada5d98f80b"
      ],
      "text": "Safety controls include per-thread sandbox isolation, GitHub App installation boundaries with optional per-user OAuth, org/repo allowlists with actor authorization checks, human approval before pushing workflow-file changes, and read-only reviewer/chat agents."
    },
