        {
          "commit": "1aa5d3b068c06f83229adf500f56600519cf10a7",
          "git_sha": "15884fd2a2234587477ec53a629d14f83c7723b8",
          "line_end": 87,
          "line_start": 87,
          "path": "README.md",
          "repository": "langchain-ai/open-swe",
          "url": "https://github.com/langchain-ai/open-swe/blob/1aa5d3b068c06f83229adf500f56600519cf10a7/README.md#L87-L87"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_0ac545d0e97e1127a5303933fd553131ada8b9018dcb9d2164c9f99a807c1cb0"
      ],
      "text": "Deep Agents supplies planning, file operations, shell access, skills, state, and subagent primitives; Open SWE adds software-engineering tools, prompts, middleware, integrations, authorization, and product surfaces on top."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1da20a10437cc0a60885a64ee2488c4af45a021c523de6751280360a6d540ca0",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "1aa5d3b068c06f83229adf500f56600519cf10a7",
          "git_sha": "15884fd2a2234587477ec53a629d14f83c7723b8",
          "line_end": 45,
          "line_start": 45,
          "path": "README.md",
          "repository": "langchain-ai/open-swe",
          "url": "https://github.com/langchain-ai/open-swe/blob/1aa5d3b068c06f83229adf500f56600519cf10a7/README.md#L45-L45"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ec83dd0a54eece1081ead2972169d1fbc533de6779e8c47647228bd35390ac91"
      ],
      "text": "Each coding thread is bound to its own persistent sandbox; a thread is a durable conversation containing multiple invocations, independent threads run in parallel, and read-only PR chat needs no sandbox."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e4a9dc1309f1e3977c989582be20d3107b77829e8af3f0b121ae62b1d9790866",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "1aa5d3b068c06f83229adf500f56600519cf10a7",
          "git_sha": "15884fd2a2234587477ec53a629d14f83c7723b8",
          "line_end": 93,
          "line_start": 93,
          "path": "README.md",
          "repository": "langchain-ai/open-swe",
          "url": "https://github.com/langchain-ai/open-swe/blob/1aa5d3b068c06f83229adf500f56600519cf10a7/README.md#L93-L93"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_768562dcf14abc6228993f0e650f055774cef93103a84e8b8996add3229d61b7"
      ],
      "text": "LangGraph provides durable execution and thread state, with each Open SWE invocation executing as a LangGraph run within a thread."
    },
    {
      "basis": "documented",
      "claim_id": "clm_dc22235b02dde51c1de34e7f47ce0c208d31078f8388be408f38db87866d5823",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
      "locators": [
        {
          "commit": "1aa5d3b068c06f83229adf500f56600519cf10a7",
          "git_sha": "15884fd2a2234587477ec53a629d14f83c7723b8",
          "line_end": 105,
          "line_start": 105,
          "path": "README.md",
          "repository": "langchain-ai/open-swe",
          "url": "https://github.com/langchain-ai/open-swe/blob/1aa5d3b068c06f83229adf500f56600519cf10a7/README.md#L105-L105"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_04290ed2013e17d500db282938dec7d91f819420a63efcd1db3cd0cced7f07b1"
      ],
      "text": "Cloud work runs in isolated Linux sandboxes that persist with their thread; an unreachable coding sandbox is not silently replaced—the system fails safely rather than risk discarding uncommitted work."
    },
