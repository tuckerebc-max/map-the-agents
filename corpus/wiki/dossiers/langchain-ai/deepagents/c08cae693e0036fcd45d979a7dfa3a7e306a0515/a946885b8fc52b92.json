          "line_end": 42,
          "line_start": 35,
          "path": "README.md",
          "repository": "langchain-ai/deepagents",
          "url": "https://github.com/langchain-ai/deepagents/blob/c08cae693e0036fcd45d979a7dfa3a7e306a0515/README.md#L35-L42"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_56ba845a9c266a57d373e431bd7ce08f9d9979a4dbcb491ae94a12654d4fbff6"
      ],
      "text": "Documented features include sub-agents with isolated context windows, pluggable filesystem backends, context summarization with tool-output offloading, shell access, persistent memory, human-in-the-loop tool approval, skills, and custom or MCP tools."
    },
    {
