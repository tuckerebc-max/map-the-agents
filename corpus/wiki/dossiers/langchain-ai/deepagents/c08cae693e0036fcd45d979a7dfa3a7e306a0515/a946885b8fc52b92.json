        "slc_787ff0ce84ca630a74cf991791b76beab432b5aadf36f39962ccdabcf7f8c953"
      ],
      "text": "The harness is model-agnostic: it works with any tool-calling LLM, including frontier APIs, open-weight hosted models, and self-hosted models via Ollama, vLLM, or llama.cpp."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2946bb3316cf14a7c5ad4825ddc58e21899f97318d28b25ad20b811e9e826d55",
      "evidence_type": "organizational_statement",
      "facet": "components",
