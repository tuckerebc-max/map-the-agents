        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_19d41c4b1dea5ecc0edf68b17f995c25e2fcc7829e568cbce806f18e1c4f96af"
      ],
      "text": "The container uses two volumes: /config for Cursor configuration files and /cursor for Cursor data files."
    },
    {
      "basis": "documented",
      "claim_id": "clm_94f6824941f7f6f5ce7807da29954b9f1b384f1dd71fc4ad29309881fee16933",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "a86ef5f7c0f4e0304e7488a91914694d63460537",
