        "slc_f1606ca6f6cf2bb68c81e94f95e49c1382532a76a7abbee8b793a39cfab4ad8c"
      ],
      "text": "Access is configured through CUSTOM_USER and PASSWORD environment variables passed at container start."
    },
    {
      "basis": "documented",
      "claim_id": "clm_17d422b228a73f179d320671f97c534d01ef5c3e7a891b020b1cf265f1259100",
