{
  "applied_operation_id": "op_3fd4492ae6e6436ea7834c872c47bd7d",
  "claims": [
    {
      "basis": "documented",
      "claim_id": "clm_6514d5b0d6701d5dd13283e71cfc97e125a884d14b6dc4257923ca12403de3fd",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 23,
          "line_start": 21,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L21-L23"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_aa481a4cfdff4c38e5237d1a5aabbdd676db3cf88ec70dddd4f1bb79b42147a6"
      ],
      "text": "Emdash is a desktop app for running AI coding agents in parallel, with each task isolated in its own Git worktree so multiple fixes or features can be explored, reviewed, and merged."
    },
    {
      "basis": "documented",
      "claim_id": "clm_03adde549d86554f5a38331d79b1938234767068a65129b1b15e86f9b070e937",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 26,
          "line_start": 25,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L25-L26"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_b8c6e5100981c02b9ff08603ac35edffab12d4566ef374a3f4b49d234974ee72"
      ],
      "text": "The product works with local projects and remote machines over SSH, and drives CLI agents the user already has, such as Claude Code, Codex, OpenCode, and Amp."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7d08750c5326d617b80795b420eb2361d0355f7a86b6c6d3a94b02ad00f3fa23",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 37,
          "line_start": 32,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L32-L37"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a8926eb39e481364c0b19031c772c5eb2f3f430ea8fd45dda1e02f1c857f7ec7"
      ],
      "text": "Features include running multiple agents without juggling terminals, per-agent worktree/branch isolation, sending issues from trackers like Linear, GitHub, Jira, and GitLab into agents, and reviewing diffs, creating PRs, inspecting CI checks, and merging from one place."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0da47d90d37e39b1b0862666b0a0b9bb64201e01ffd1f8bd795344388a09cd27",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 55,
          "line_start": 53,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L53-L55"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5cc40a89a0d52b271243491b95333ae154fd39b30f2ea9f2685465c04845cd27"
      ],
      "text": "Emdash automatically detects installed provider CLIs and supports agents including Claude Code, Codex, Cursor, OpenCode, Amp, Devin, Qwen Code, Droid, and GitHub Copilot."
    },
    {
      "basis": "documented",
      "claim_id": "clm_805b85d9785cb040ac97653d33c1df42f89fd638524b1359c7aad5b0571cc28a",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 59,
          "line_start": 57,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L57-L59"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_07568e75fe24c7b882aae1e34b97e48c681edd849503f61ee05072a3870efb08"
      ],
      "text": "For agents with lifecycle-hook support, Emdash installs marker-tagged hook entries in the agent's user-level config to track status, notifications, and resumable sessions, and the hooks do nothing when the agent runs outside Emdash."
    },
    {
      "basis": "documented",
      "claim_id": "clm_9e7fc5ac97f25d6e15cc3814748100478487b97578df8f9963da3ce9e2a55821",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 68,
          "line_start": 66,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L66-L68"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_0af8880646e011ad0c7119579a288d5b6bde3bb3e298676813d288f22b6bb869"
      ],
      "text": "Remote projects connect over SSH/SFTP with support for SSH agent, key, and password authentication, and credentials are stored in the OS keychain."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a21824de18d7b92dd3510f3c36b0a8a565f0de8bfb0cbd648456d3314f8fdede",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 78,
          "line_start": 77,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L77-L78"
        },
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 75,
          "line_start": 74,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L74-L75"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_82ca6b09ce2749e9cdaead1b29ec581c43116b11b75af5ba67ce28637bebc766",
        "slc_8379ac0dfe1d2a4d92811d97e324e192ef9745cbf3a7e1abdba03b1a93f5d7c7"
      ],
      "text": "The app is local-first: app state lives in a local SQLite database, and Emdash does not send the user's code or chats to Emdash servers, though agent CLIs may send data to their own providers."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3d4cd6a4a9c73b66fe5cf10bc74a617403e06e8f73625ff4489adb8b579ecd83",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 84,
          "line_start": 82,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L82-L84"
        },
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 80,
          "line_start": 80,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L80-L80"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c3e540c47c77a6c3bd90e7f221f2cd7447a3344be5f6e9a5bd8be69275a60188",
        "slc_e864970326e41220d286fbc99937d5f394ce5252c8f5eb9ff41c8e0cc9a49844"
      ],
      "text": "Telemetry is optional and can be disabled in Settings or by launching with TELEMETRY_ENABLED=false."
    },
    {
      "basis": "documented",
      "claim_id": "clm_77cfed20756f688336c7c0254efe2120271531ec035d1bd922fd196624f90964",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 46,
          "line_start": 41,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L41-L46"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_972e4278b6180df27707738e53b22e1359ffa191e4e1e2aa51852b70c9df1ab8"
      ],
      "text": "Desktop builds are distributed for macOS (Homebrew cask plus Apple Silicon and Intel DMGs), Windows (MSI installer and portable exe), and Linux x64/ARM64 (AppImage, DEB, RPM)."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4d7dad5aa85c07803d0b404239d2d754bcdee89d2c16d5841cb68496915c99b7",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
          "commit": "fccf350847097c8f9d9de3e7e5c98b0d292a4554",
          "git_sha": "e01c012df1edfe9f8d5246d5b54426ab5dfd7418",
          "line_end": 78,
          "line_start": 77,
          "path": "README.md",
          "repository": "generalaction/emdash",
          "url": "https://github.com/generalaction/emdash/blob/fccf350847097c8f9d9de3e7e5c98b0d292a4554/README.md#L77-L78"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_82ca6b09ce2749e9cdaead1b29ec581c43116b11b75af5ba67ce28637bebc766"
      ],
      "text": "The README notes that agent CLIs may send code, prompts, and context to their own providers, so data handling depends on which provider the user chooses."
    },
