        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_76427a65e881b98937a0f1a667d6cb9920cbc221078a55f92937414da4a21c16",
        "slc_8b2432cfb373504a23bf3d5e0d0b0e0bacfe024b8e52bdd7af48f79f921d8759"
      ],
      "text": "Repository development practice: the repo is a pnpm workspace monorepo; only pnpm on PATH is needed since package.json pins pnpm 10.28.2 and Node 24.14.0 with onFail download, so the toolchain self-provisions."
    }
