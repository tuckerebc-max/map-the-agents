      "slice_ids": [
        "slc_4f019c2401ded880c812ae3b6851e6ae05f64e1651ceff5f9758ca7701ea3186"
      ],
      "text": "Work is structured hierarchically: a cycle is one unit of orchestrated work, a run spans multiple cycles with summaries bridging context, and stages are independently verifiable plan pieces that run sequentially or in parallel git worktrees."
    },
