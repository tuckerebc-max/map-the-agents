      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d680b2c1ce2f767e67f25f7fd2e020575ef8e1185ec272db7334a7ce754e8987"
      ],
      "text": "The product offers automations: recurring tasks or event-triggered workflows, such as triggers on new issues or pull requests, to automate repetitive development work."
    },
