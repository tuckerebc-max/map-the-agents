      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d680b2c1ce2f767e67f25f7fd2e020575ef8e1185ec272db7334a7ce754e8987"
      ],
      "text": "The product ships a 'terry' CLI for local task takeover and continuation, plus an MCP server so MCP-compatible clients like Cursor and Claude Code can create and manage tasks."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5d77f26f953f0469f28f0fdeb51fa9c2fc8dcac4185ab3bcec0691f6cc67e85a",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "83142a17f3970df3e14d1879234a603db6e4f615",
          "git_sha": "e0d82a5671dd5b743a34b679a847c121bd23d54f",
          "line_end": 20,
          "line_start": 13,
          "path": "README.md",
          "repository": "terragon-labs/terragon-oss",
          "url": "https://github.com/terragon-labs/terragon-oss/blob/83142a17f3970df3e14d1879234a603db6e4f615/README.md#L13-L20"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d680b2c1ce2f767e67f25f7fd2e020575ef8e1185ec272db7334a7ce754e8987"
      ],
      "text": "Terragon supports multiple coding agents—Claude Code, OpenAI Codex, Amp, and Gemini—and is designed so support for additional agents can be added."
    },
    {
      "basis": "documented",
      "claim_id": "clm_80b5f11c0dcbfbf96324b30e75167c52f71866eb3f1095fd8c3d9a7c1cfb33be",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "83142a17f3970df3e14d1879234a603db6e4f615",
          "git_sha": "e0d82a5671dd5b743a34b679a847c121bd23d54f",
          "line_end": 20,
          "line_start": 13,
          "path": "README.md",
          "repository": "terragon-labs/terragon-oss",
          "url": "https://github.com/terragon-labs/terragon-oss/blob/83142a17f3970df3e14d1879234a603db6e4f615/README.md#L13-L20"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d680b2c1ce2f767e67f25f7fd2e020575ef8e1185ec272db7334a7ce754e8987"
      ],
      "text": "Each agent runs in an isolated sandbox container with its own repository copy, letting it read files, edit, and run tests without affecting concurrent tasks or the local environment."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c1c5a01a90d43b81498751c2f48461ded03005c665bca22a3dd20602ce3b5e79",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "83142a17f3970df3e14d1879234a603db6e4f615",
          "git_sha": "e0d82a5671dd5b743a34b679a847c121bd23d54f",
          "line_end": 20,
          "line_start": 13,
          "path": "README.md",
          "repository": "terragon-labs/terragon-oss",
          "url": "https://github.com/terragon-labs/terragon-oss/blob/83142a17f3970df3e14d1879234a603db6e4f615/README.md#L13-L20"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d680b2c1ce2f767e67f25f7fd2e020575ef8e1185ec272db7334a7ce754e8987"
      ],
      "text": "Tasks get unique branches, and agent work is checkpointed to GitHub with AI-generated commits and pull requests; this git workflow can be disabled for flexibility."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a86c9e5a572778cabeeff1d8b431befc950957eb5541254c3e18b6294a47f1a2",
