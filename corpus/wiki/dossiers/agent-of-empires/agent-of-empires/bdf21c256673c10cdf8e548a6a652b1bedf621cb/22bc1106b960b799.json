        "slc_aa839db097fca88e66e687cc79f2c6c58afeee6487daa7a06f8703e0d2c476e5"
      ],
      "text": "AoE is described as a session manager for AI coding agents on Linux and macOS, running agents in parallel across branches with persistent sessions and optional worktree or container isolation."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3c30ecddfee0b9a69b8e49f97128fd9594ff50b02f46c6d6d1942bdcc9975751",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
