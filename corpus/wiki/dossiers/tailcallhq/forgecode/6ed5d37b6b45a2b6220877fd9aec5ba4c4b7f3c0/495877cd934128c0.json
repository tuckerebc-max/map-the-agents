      "slice_ids": [
        "slc_be07bce7a3d5fd3119306caf705f99032f9a928eace03fcbb553ea964933759f"
      ],
      "text": "CLI options include `-p` for direct prompts, `--agent` to pick an agent, `-C` to change directory, `--sandbox` to create an isolated git worktree plus branch, and `--conversation-id` to resume a conversation."
    },
