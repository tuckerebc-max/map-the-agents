          "line_end": 293,
          "line_start": 290,
          "path": "README.md",
          "repository": "legioncodeinc/honeycomb",
          "url": "https://github.com/legioncodeinc/honeycomb/blob/c1cb6bf5674ca169728e79433bf035e0d3d1483c/README.md#L290-L293"
