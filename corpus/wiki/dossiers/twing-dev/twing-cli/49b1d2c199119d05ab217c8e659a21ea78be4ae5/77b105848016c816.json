      "slice_ids": [
        "slc_49e7b22b66087aaf9321c59610228d322d953e690386bf1f830a3f2512792c76"
      ],
      "text": "Bucket 3 conflicts come from Tree-sitter-parsed claims and bucket 4 from an async Bedrock semantic pass, so those findings can arrive after the edit already succeeded via align or an alignment thread."
    },
