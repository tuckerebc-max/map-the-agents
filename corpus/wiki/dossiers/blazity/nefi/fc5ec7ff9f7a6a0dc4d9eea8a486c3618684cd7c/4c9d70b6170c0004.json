      "slice_ids": [
        "slc_b5a4a6d58330393ae337f765e2f5e693029bf654cb1ab6f93cb438497ada3db7"
      ],
      "text": "The tool is designed to reduce manual work on common tasks such as customizing the next-enterprise boilerplate, e.g. removing storybook on request."
