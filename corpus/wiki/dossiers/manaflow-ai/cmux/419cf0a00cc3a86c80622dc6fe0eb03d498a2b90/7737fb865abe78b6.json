      "slice_ids": [
        "slc_15b2a774d2ac779c17b323a73799f4cf50613bb9c2bd92a1529bcfd222ca0168"
      ],
      "text": "When an agent spawns subagents or teammates, cmux turns them into native panes and splits, and supports Claude Code teams and oh-my-opencode multi-model orchestration."
    },
