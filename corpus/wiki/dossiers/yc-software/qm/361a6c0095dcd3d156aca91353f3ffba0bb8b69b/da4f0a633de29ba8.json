      "slice_ids": [
        "slc_16b3d9034201340ff23a6dacc60754695fc4ae899e31b79c6e1abc70fd5ac0e3"
      ],
      "text": "The deployment config root requires contract: 1, orgId, publicUrl, target, and a services list including core; target is docker, fly, or aws, and unknown contract majors fail closed."
    },
