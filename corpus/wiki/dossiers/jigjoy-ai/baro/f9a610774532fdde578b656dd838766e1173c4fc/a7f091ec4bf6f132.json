        "slc_1b83cb6b8facc3914581a746d5644e1455cdc685bc83fc00a68575c8857ba45f",
        "slc_5c4dd57c5df6d0e1cbc1d317cea83cc755a305389cb736eb6c4cb868b25a6efe"
      ],
      "text": "Collective coordination is the CLI default; a legacy Conductor mode (one owner of DAG levels, retries, completion) can be selected with `--coordination legacy` for A/B comparison."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ae96de8fd332dcf0913d4e9163301ad6f790682478413c91bb7fb89f6c980274",
      "evidence_type": "organizational_statement",
