          "line_end": 11,
          "line_start": 8,
          "path": "README.md",
          "repository": "jigjoy-ai/baro",
          "url": "https://github.com/jigjoy-ai/baro/blob/f9a610774532fdde578b656dd838766e1173c4fc/README.md#L8-L11"
        },
        {
