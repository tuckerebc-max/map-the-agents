      "locators": [
        {
          "commit": "f9a610774532fdde578b656dd838766e1173c4fc",
          "git_sha": "fd5857b45f637d23cb1961ff000a385a80ce5aea",
          "line_end": 119,
          "line_start": 116,
          "path": "README.md",
          "repository": "jigjoy-ai/baro",
          "url": "https://github.com/jigjoy-ai/baro/blob/f9a610774532fdde578b656dd838766e1173c4fc/README.md#L116-L119"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_3e152f18d0963f51c7edd3c7465c18d2c62c93f1d3cb110d5c8b00f27a703502"
      ],
      "text": "A cloud option runs the same fleet on a hosted site with isolated sandboxes and provider keys, or users can attach their own machine as a cloud runner via `baro login` and `baro connect --install-service`."
    }
