      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2c4f64602749c880523b7dd64985b44234c400e430e4586a08840b7c83b5d881",
        "slc_e6fe9f4eb4ce38c646b4b12d4d34f77a07f6daef934af062edb927dead15705a"
      ],
      "text": "Codex, OpenCode, and Pi workers are one-shot CLI processes that cannot consume corrective messages after exit; failed verdicts for those backends require a separate recovery execution rather than in-process revision."
    },
    {
      "basis": "documented",
      "claim_id": "clm_9de5bb01170e5a33f41495cc23c00132ee1f87e71bca99c5775edf62c83a7fa6",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
