          "git_sha": "b48cf4ca47126a2d98f9ec005fea207b65650249",
          "line_end": 7,
          "line_start": 7,
          "path": "docs/collective-experiment.md",
          "repository": "jigjoy-ai/baro",
          "url": "https://github.com/jigjoy-ai/baro/blob/f9a610774532fdde578b656dd838766e1173c4fc/docs/collective-experiment.md#L7-L7"
