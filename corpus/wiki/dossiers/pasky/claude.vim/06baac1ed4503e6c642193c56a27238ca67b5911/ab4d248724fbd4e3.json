      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_279cdfe39616034ba9c4b397938e7c7d913857cf8de218c9412b2f50b439dffa",
        "slc_63e04e105105850b1ab980501033dde51e60c8d8ab0f788c62c0f45aeffc8034"
      ],
      "text": "Every Q&A roundtrip sends full chat history and all buffer content, which can consume tokens quickly and incur real API costs; users are advised to prune history and watch billing."
    }
