          "url": "https://github.com/pasky/claude.vim/blob/06baac1ed4503e6c642193c56a27238ca67b5911/README.md#L39-L40"
        },
        {
          "commit": "06baac1ed4503e6c642193c56a27238ca67b5911",
          "git_sha": "ff6edccf754135491167a2af438b1d53a97cecac",
