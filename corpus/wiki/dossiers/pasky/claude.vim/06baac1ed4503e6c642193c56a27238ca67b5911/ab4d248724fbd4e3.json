          "line_end": 147,
          "line_start": 141,
          "path": "README.md",
          "repository": "pasky/claude.vim",
          "url": "https://github.com/pasky/claude.vim/blob/06baac1ed4503e6c642193c56a27238ca67b5911/README.md#L141-L147"
        },
        {
          "commit": "06baac1ed4503e6c642193c56a27238ca67b5911",
          "git_sha": "ff6edccf754135491167a2af438b1d53a97cecac",
          "line_end": 139,
          "line_start": 138,
          "path": "README.md",
          "repository": "pasky/claude.vim",
          "url": "https://github.com/pasky/claude.vim/blob/06baac1ed4503e6c642193c56a27238ca67b5911/README.md#L138-L139"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_4ff98d5100755b12878cba6a72ce308d493195606f640b257ed6affe2b03d2b2",
        "slc_7c7fc992483b5b675fcb09adf909d483392b6c1265d55fd0b93fc2fd7f80ad51"
      ],
      "text": "ClaudeImplement works on a visual-mode selection: the selected block is all Claude sees, with no additional context, and proposed changes are reviewed in diff mode."
    },
    {
      "basis": "documented",
      "claim_id": "clm_102203d8abce7135a0eda9395204ea40176213c405f41e2ddd949ec85a883032",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "06baac1ed4503e6c642193c56a27238ca67b5911",
          "git_sha": "ff6edccf754135491167a2af438b1d53a97cecac",
          "line_end": 153,
          "line_start": 151,
          "path": "README.md",
          "repository": "pasky/claude.vim",
          "url": "https://github.com/pasky/claude.vim/blob/06baac1ed4503e6c642193c56a27238ca67b5911/README.md#L151-L153"
        },
        {
          "commit": "06baac1ed4503e6c642193c56a27238ca67b5911",
          "git_sha": "ff6edccf754135491167a2af438b1d53a97cecac",
          "line_end": 159,
          "line_start": 155,
          "path": "README.md",
          "repository": "pasky/claude.vim",
          "url": "https://github.com/pasky/claude.vim/blob/06baac1ed4503e6c642193c56a27238ca67b5911/README.md#L155-L159"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_99dad68a83ca3852a18cc02bd7c2693804e7b8e923a8f9af10d1d42199c15fbd",
        "slc_d8b962e33c060e416a3e33a342e8d6c419351b9905daef23776e08f546f79047"
      ],
      "text": "In chat mode Claude sees the full content of all buffers listed in :buffers, and proposed code changes pop up a diff mode for review when possible."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7a7f496c7ca0f7e03673acdcd4dc8a08960f48a0ba2816147f5b25b490769ab7",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
      "locators": [
        {
          "commit": "06baac1ed4503e6c642193c56a27238ca67b5911",
          "git_sha": "ff6edccf754135491167a2af438b1d53a97cecac",
          "line_end": 177,
          "line_start": 174,
          "path": "README.md",
          "repository": "pasky/claude.vim",
          "url": "https://github.com/pasky/claude.vim/blob/06baac1ed4503e6c642193c56a27238ca67b5911/README.md#L174-L177"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_0ab9280dff41a672cb9f36ec4f091c8aa55f58bba584130d8f775d90dc6dd849"
      ],
      "text": "Chat history is sent to Claude with each request; previous interactions are folded in the buffer and users can edit or delete the history to redact it."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f8a16fedbc10325381988940ccf8620333b547224957949982543fab8ebe159c",
