      "slice_ids": [
        "slc_654b929a68b2ad46fbbec0ce4f114d068f75201ac4c2765e19f459d077a45c3d"
      ],
      "text": "AGENTS.md project memory is loaded from the repo-level .orb/ directory (alongside project root and legacy .orbital/), shared between the IDE extension and the OrbCode CLI."
    },
