        "slc_807bba01bed1281ebdd662039b8bffee78a3f78438e5250564a841e9903478c7",
        "slc_84bf1f02e8d7bc0934283c19ef9157feaf7573bf07689b2beb2a143c0f63c90c",
        "slc_dcb6d0935be37926d7c8d3d2a26d5e7ae15a3477aa4a92c38fa4890a60fea8a2",
        "slc_eb5b9d7e0beef5dc07df5b06aa0714079273964bbe521431bbc2fb9e11dbdbd4",
        "slc_fb7094626d146a6a1fd69843f59657ceacaa7d9ed0f671a5a2fad43719518ca4"
      ],
      "text": "The product exposes agentic tools including fileEdit, executeCommand, read_multi_file, writeToFile, searchFiles, web_search, web_fetch, newTask, updateTodoList, and code-structure analysis tools."
    },
    {
      "basis": "documented",
      "claim_id": "clm_121f0f46667a72276e0c3450521179690c97553c2e15f35680fe7549075d5d04",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "ac82a92110acff133f618853b5a2318a3be858c8",
          "git_sha": "b2b2265d92d4dca2bac1d04fce929e2150135d4a",
          "line_end": 50,
          "line_start": 45,
          "path": "README.md",
          "repository": "matteraiorg/orbital-extension",
          "url": "https://github.com/MatterAIOrg/Orbital-Extension/blob/ac82a92110acff133f618853b5a2318a3be858c8/README.md#L45-L50"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_272b4693ce7bf40d1d2e481c275f7ad411b27c697e207f55742a8ca9a7c5e2ce"
      ],
      "text": "Orbital ships as a dedicated AI-first IDE plus extensions for VS Code, Cursor, and Windsurf; JetBrains IDEs and a CLI are listed as coming soon."
    },
    {
      "basis": "documented",
      "claim_id": "clm_779ba9109098addc5feddbe48774ce9bc99d5f80a51c570ca4ac5eae3acf85cc",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "ac82a92110acff133f618853b5a2318a3be858c8",
          "git_sha": "b2b2265d92d4dca2bac1d04fce929e2150135d4a",
          "line_end": 88,
          "line_start": 88,
          "path": "README.md",
          "repository": "matteraiorg/orbital-extension",
          "url": "https://github.com/MatterAIOrg/Orbital-Extension/blob/ac82a92110acff133f618853b5a2318a3be858c8/README.md#L88-L88"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_50176f0789087b0f036da3646179632a5de5e8257cb64c0b6f9d6aeadacc6543"
      ],
      "text": "The model catalog is served dynamically from the MatterAI backend, so new models appear in the selector without an extension update."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5c41c45eff133494a955862ad2a3fcc3b5c05073676bd61a8287a4614a9f5524",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "ac82a92110acff133f618853b5a2318a3be858c8",
          "git_sha": "4e7c342166b8a013cb6c7f68678d021ad9a181aa",
          "line_end": 23,
          "line_start": 23,
          "path": "CHANGELOG.md",
          "repository": "matteraiorg/orbital-extension",
          "url": "https://github.com/MatterAIOrg/Orbital-Extension/blob/ac82a92110acff133f618853b5a2318a3be858c8/CHANGELOG.md#L23-L23"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2ec3b86583fb1d095862d6d65f1a57da3b51889533adcb7c959cc93113f0cf6d"
      ],
      "text": "Models are fetched from the backend /v1/models endpoint and registered into the client registry, refreshing on window focus, via a refresh button, and through a 10-minute background poller."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b5262fbb4f45509d498fda953b33db229247b4f4756b6c0fcb5ba7e1fecdfa35",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "ac82a92110acff133f618853b5a2318a3be858c8",
          "git_sha": "4e7c342166b8a013cb6c7f68678d021ad9a181aa",
          "line_end": 36,
          "line_start": 36,
          "path": "CHANGELOG.md",
          "repository": "matteraiorg/orbital-extension",
          "url": "https://github.com/MatterAIOrg/Orbital-Extension/blob/ac82a92110acff133f618853b5a2318a3be858c8/CHANGELOG.md#L36-L36"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6add26880ae396e58c2d108d56a3f7b0361a326ef380972b82ce8636abca8091"
      ],
      "text": "Independent read-only tools (read_file, search_files, list_files, list_code_definition_names, codebase_search, lsp) run concurrently up to 4 at a time, with results committed in model order; mutating and interactive tools stay serialized."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b97dcb4745b89dc4e389bb8187538b90c523817ba4a56b4c74f72b7e1ea422f5",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "ac82a92110acff133f618853b5a2318a3be858c8",
          "git_sha": "4e7c342166b8a013cb6c7f68678d021ad9a181aa",
          "line_end": 111,
          "line_start": 108,
          "path": "CHANGELOG.md",
          "repository": "matteraiorg/orbital-extension",
          "url": "https://github.com/MatterAIOrg/Orbital-Extension/blob/ac82a92110acff133f618853b5a2318a3be858c8/CHANGELOG.md#L108-L111"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_86d4584f53509855fa7ed9ab912001a008c0ac63c4d93e8dd44398cb3c4955ec"
      ],
      "text": "File-edit tools require old_string to match exactly one location copied verbatim from a current read, and replace_all must be set intentionally after verifying all occurrences should change."
    },
    {
      "basis": "documented",
      "claim_id": "clm_48b917c6e30b3d5d9bca9f7730e80d83ca628f6b0092b16634f5e37ba31cf7f0",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "ac82a92110acff133f618853b5a2318a3be858c8",
          "git_sha": "4e7c342166b8a013cb6c7f68678d021ad9a181aa",
          "line_end": 69,
          "line_start": 69,
          "path": "CHANGELOG.md",
          "repository": "matteraiorg/orbital-extension",
          "url": "https://github.com/MatterAIOrg/Orbital-Extension/blob/ac82a92110acff133f618853b5a2318a3be858c8/CHANGELOG.md#L69-L69"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_acfd1394666da2882673065ac5d9375b1508b993596e9126e7953258da5bac4b"
      ],
      "text": "A generate_file native tool produces file artifacts (PDF, DOCX, PPTX, XLSX, CSV, MD, TXT, HTML) via the MatterAI backend, holding binaries in memory until the user explicitly saves to the Downloads folder."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4a6639708a628936ef72a8b27396a72bb4fe2813e0887b9352946354e110d577",
      "evidence_type": "organizational_statement",
      "facet": "skills-patterns",
      "kind": "observation",
      "locators": [
        {
          "commit": "ac82a92110acff133f618853b5a2318a3be858c8",
          "git_sha": "4e7c342166b8a013cb6c7f68678d021ad9a181aa",
          "line_end": 201,
          "line_start": 201,
          "path": "CHANGELOG.md",
          "repository": "matteraiorg/orbital-extension",
          "url": "https://github.com/MatterAIOrg/Orbital-Extension/blob/ac82a92110acff133f618853b5a2318a3be858c8/CHANGELOG.md#L201-L201"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_286e453da28485bf2099e6ca56e66c706e454e1c9ad524c6eca28d4ab0d7575c"
      ],
      "text": "A /create-skill command lets users describe a workflow in plain language and creates or updates a reusable skill under .orb/skills/<skill-name>/ with supporting scripts and assets."
    },
    {
      "basis": "documented",
      "claim_id": "clm_57396ddeffff09e57df546c57b442ba66a1e5bc0b40e1bc5eff2bd86df3eb00f",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
      "locators": [
        {
          "commit": "ac82a92110acff133f618853b5a2318a3be858c8",
          "git_sha": "4e7c342166b8a013cb6c7f68678d021ad9a181aa",
          "line_end": 212,
          "line_start": 209,
          "path": "CHANGELOG.md",
