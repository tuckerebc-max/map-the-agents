          "git_sha": "d56bc653936a770593b9e77a855c6432c6a5d49f",
          "line_end": 20,
          "line_start": 13,
          "path": "README.md",
          "repository": "yanhua1010/build-your-own-coding-agent",
          "url": "https://github.com/yanhua1010/build-your-own-coding-agent/blob/1e607dbb2f0819eda93d3d26d2dbb0b7089a3a2a/README.md#L13-L20"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e8d9b593345ae3f42e1228a891def8e9bbaff7b186726962fe12721e377f4df4"
      ],
      "text": "Six published articles cover the agent loop, unified LLM API and error contracts, tool calling, context compaction and session persistence, and permission/security philosophy, each linked to notes and runnable code."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b6fe8d95a9225345d04da83f13c9dfe92ed6bef7abb28678c2cbf0681013678b",
      "evidence_type": "organizational_statement",
      "facet": "components",
