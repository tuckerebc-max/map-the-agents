          "git_sha": "d56bc653936a770593b9e77a855c6432c6a5d49f",
          "line_end": 32,
          "line_start": 30,
          "path": "README.md",
          "repository": "yanhua1010/build-your-own-coding-agent",
          "url": "https://github.com/yanhua1010/build-your-own-coding-agent/blob/1e607dbb2f0819eda93d3d26d2dbb0b7089a3a2a/README.md#L30-L32"
        }
