        "slc_6fa51750671799f05340cdf6e68d75e67bcb9abc6385ac11cd75471f2a86c480"
      ],
      "text": "The repository is a tutorial series that dissects the internals of coding agents layer by layer while building a runnable mini-agent, using three open-source coding agent projects as references."
    },
    {
      "basis": "documented",
      "claim_id": "clm_214b475617afe5ab5a8a10dd6bacc31f783e10bea3da90ccb87d15e32be4f071",
      "evidence_type": "organizational_statement",
      "facet": "relevance",
      "kind": "observation",
      "locators": [
        {
          "commit": "1e607dbb2f0819eda93d3d26d2dbb0b7089a3a2a",
          "git_sha": "d56bc653936a770593b9e77a855c6432c6a5d49f",
          "line_end": 7,
          "line_start": 5,
          "path": "README.md",
          "repository": "yanhua1010/build-your-own-coding-agent",
          "url": "https://github.com/yanhua1010/build-your-own-coding-agent/blob/1e607dbb2f0819eda93d3d26d2dbb0b7089a3a2a/README.md#L5-L7"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e839d5229c054781537670b82e5c86ec5171c95dbdaa57ed94aff85be8610a7a"
      ],
      "text": "The series uses pi (TypeScript, MIT, ~78k stars) as the main teaching text, with codex (Rust, ~101k stars) and grok-build (Rust, ~23k stars) used for architecture comparison."
    },
    {
      "basis": "documented",
      "claim_id": "clm_9b381d0a85d3702e1ef45d0da39de55edc64335af7d8b33f7c4d4e436f122294",
