          "git_sha": "d56bc653936a770593b9e77a855c6432c6a5d49f",
          "line_end": 9,
          "line_start": 9,
          "path": "README.md",
          "repository": "yanhua1010/build-your-own-coding-agent",
          "url": "https://github.com/yanhua1010/build-your-own-coding-agent/blob/1e607dbb2f0819eda93d3d26d2dbb0b7089a3a2a/README.md#L9-L9"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_1171fea95e021839f0af6401f4a028636fbf367f0501d5295ecb8db77f8c175b"
      ],
      "text": "The series uses domestic Chinese model APIs (DeepSeek, GLM, Kimi), and the code is stated to run directly locally."
    },
    {
      "basis": "documented",
      "claim_id": "clm_bd0249cf9595c292e704a3b2f10b7b0adfb47460bd4e3724a046a87ebc39c83d",
      "evidence_type": "organizational_statement",
