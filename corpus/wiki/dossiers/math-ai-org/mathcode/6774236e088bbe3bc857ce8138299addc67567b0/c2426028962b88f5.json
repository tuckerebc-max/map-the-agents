          "git_sha": "2a2e0ecbe5dc6f054e0be0caf65d3cae4dbf0185",
          "line_end": 455,
          "line_start": 444,
          "path": "README.md",
          "repository": "math-ai-org/mathcode",
          "url": "https://github.com/math-ai-org/mathcode/blob/6774236e088bbe3bc857ce8138299addc67567b0/README.md#L444-L455"
