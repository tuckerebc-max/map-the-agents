      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_753a7948f6df883c40e176ad09ee2bacc3b6678954521eac17d4c6bb09afb20e"
      ],
      "text": "The optional /lean skill gives guidance without imposing a fixed phase, tactic order, retry budget, or planner; former fixed controllers were removed and are not release entrypoints or model-visible tools."
    },
    {
      "basis": "documented",
