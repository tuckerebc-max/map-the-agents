          "git_sha": "bacc2ff01ac36b877f1db7953e8224bf16aa6cbe",
          "line_end": 18,
          "line_start": 18,
          "path": "README.md",
          "repository": "icebaker/nano-bots",
          "url": "https://github.com/icebaker/nano-bots/blob/2bbc92857aa4ca8db5b0af75e96243d2d6ceae62/README.md#L18-L18"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_dcffa2e7df1457f39b6d6d3f6bd568b4292379004c15e998991365962bcc1bb2"
      ],
      "text": "Cartridges can be used by downloading the YAML file or copying its contents into a local YAML file, then running it with an implementation."
    },
