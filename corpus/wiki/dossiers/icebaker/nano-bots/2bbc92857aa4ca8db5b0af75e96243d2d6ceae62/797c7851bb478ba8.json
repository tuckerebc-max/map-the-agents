      ],
      "text": "The repository hosts Nano Bots' Cartridges, which are YAML files that require a separate implementation to run."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a52685c907d49e825bc98da5a2f1834b090b33505e3dad4f02a1f7f9d4e1b260",
