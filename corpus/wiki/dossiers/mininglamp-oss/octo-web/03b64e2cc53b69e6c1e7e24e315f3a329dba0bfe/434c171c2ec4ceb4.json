        "slc_5f46bc58915ef814d9f9265d5ab824cdefb703df4ff1a3ef8fafddf20d08ce48"
      ],
      "text": "octo-web is a TypeScript/React front-end that communicates with octo-server over REST and WebSocket, and ships as both a browser build and an Electron-packaged desktop client."
    },
    {
      "basis": "documented",
      "claim_id": "clm_06ac04a20d191b2643cec1d3105cf59fd4c93b0f93ac305d66dc3a4747478b5f",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "03b64e2cc53b69e6c1e7e24e315f3a329dba0bfe",
          "git_sha": "dcad017f0ecb4cf6ab3183c226603fa28a95de48",
          "line_end": 67,
          "line_start": 59,
          "path": "README.md",
          "repository": "mininglamp-oss/octo-web",
          "url": "https://github.com/Mininglamp-OSS/octo-web/blob/03b64e2cc53b69e6c1e7e24e315f3a329dba0bfe/README.md#L59-L67"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_8a417d75efbef6c2af2c6c0186170558135d8fa38f5ca58b4c183cac45832b46"
      ],
      "text": "The repository layout includes route-level pages (chat, channels, org, settings), a shared UI kit, client state, a REST/WebSocket API client, i18n resources, and an Electron bootstrap directory."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6d8dcf0fffa51a55c83dca8c94ec91aba69f050ddd03015af9de60aa95d59a9d",
      "evidence_type": "organizational_statement",
