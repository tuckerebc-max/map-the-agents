        {
          "commit": "03b64e2cc53b69e6c1e7e24e315f3a329dba0bfe",
          "git_sha": "dcad017f0ecb4cf6ab3183c226603fa28a95de48",
          "line_end": 80,
          "line_start": 78,
          "path": "README.md",
          "repository": "mininglamp-oss/octo-web",
          "url": "https://github.com/Mininglamp-OSS/octo-web/blob/03b64e2cc53b69e6c1e7e24e315f3a329dba0bfe/README.md#L78-L80"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_fad24ec2b0e4f4147273cff0459f455b6a544c279c5a9c65aead494e812a1df9"
      ],
      "text": "The Electron PC shell is intentionally thin: it hosts the same React app and forwards IPC for native capabilities such as tray, notifications, file drop, and auto-update, while the browser build runs without any Electron dependency."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ec08e473455bfef0440bdf4ed256e442fab74e2e2dfc445123ae4f610c1bdcb8",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
