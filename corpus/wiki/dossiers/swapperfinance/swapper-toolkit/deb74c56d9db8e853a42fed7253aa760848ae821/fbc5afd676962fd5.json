      "slice_ids": [
        "slc_e13ff618e5d725858d332b568ded57d2013474f368735d04cc4a6e2736b2d3f5"
      ],
      "text": "The /swapper-deposit skill triggers when a user asks to deposit, fund, top-up or bridge assets, when an agent detects insufficient wallet funds mid-task, or when fiat-to-crypto funding is wanted before a strategy."
    },
