      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6a364bfa6145cb4396026e98a5c8191d26a6b621869096e72f0aeb3ea5f45493"
      ],
      "text": "The save hook sweeps state files whose process has exited on every run, so the state directory does not grow without bound; the persistent sidecar assistant-sessions.json is what restore reads."
    },
