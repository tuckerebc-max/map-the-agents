        "slc_9e7825c0cd0459849e6ce733c0579172b140da8e246bc3156751c09d4bed589f",
        "slc_c095d041f49829f786b80e2e92279508f008d2a04c201f6c9efb56eb76804bea"
      ],
      "text": "Control flow is authored data rather than hidden in prompts: sequence, parallel review, retry paths, delivery, and exit conditions are explicit before a run starts, and no runtime agent chooses the next step."
    },
