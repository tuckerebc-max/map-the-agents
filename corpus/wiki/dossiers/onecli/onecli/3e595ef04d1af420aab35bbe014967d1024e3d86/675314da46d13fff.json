{
  "applied_operation_id": "op_a17826486fe84a1b884b51352ff5dda0",
  "claims": [
    {
      "basis": "documented",
      "claim_id": "clm_ff863f7e4d7efd0d3989321d9308e4ac0d17862d80d28648d33af977834d0074",
      "evidence_type": "organizational_statement",
      "facet": "components",
