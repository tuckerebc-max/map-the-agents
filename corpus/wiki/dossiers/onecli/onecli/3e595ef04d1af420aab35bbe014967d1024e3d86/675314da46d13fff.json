      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_14c94fcdf07dd094a2f24837f00e105ee3d8bea7496927754484476d0e13a162"
      ],
      "text": "Self-hosted upgrades must not use a bare `docker compose pull && up -d`, because the agent sandbox image is set via RUNNER_AGENT_IMAGE on the runner service and would silently stay stale while other services update."
    },
