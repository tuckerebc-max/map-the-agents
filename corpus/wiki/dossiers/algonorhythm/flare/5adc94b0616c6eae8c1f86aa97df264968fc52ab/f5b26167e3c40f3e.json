          "git_sha": "d9a4f48f184e9e2765e9673f5645238273af1814",
          "line_end": 459,
          "line_start": 438,
          "path": "README.md",
          "repository": "algonorhythm/flare",
          "url": "https://github.com/AlgoNoRhythm/Flare/blob/5adc94b0616c6eae8c1f86aa97df264968fc52ab/README.md#L438-L459"
