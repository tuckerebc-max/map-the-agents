      "slice_ids": [
        "slc_d1ab887db8153d84e846054dde113a9e842147e428f887daf79b9d17f9bc61bd"
      ],
      "text": "Architecture separates a pure shared/ engine (import parser, resolver, incremental graph builder, scanner), an Electron-free core in electron/core.ts, desktop and browser adapters, and a React renderer with the three graph views, Monaco, and xterm terminals."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0ccf9434076aa99200562c5c0bc8b209441540fc265463eab365d2191a047f26",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "5adc94b0616c6eae8c1f86aa97df264968fc52ab",
          "git_sha": "d9a4f48f184e9e2765e9673f5645238273af1814",
          "line_end": 436,
          "line_start": 430,
          "path": "README.md",
          "repository": "algonorhythm/flare",
          "url": "https://github.com/AlgoNoRhythm/Flare/blob/5adc94b0616c6eae8c1f86aa97df264968fc52ab/README.md#L430-L436"
