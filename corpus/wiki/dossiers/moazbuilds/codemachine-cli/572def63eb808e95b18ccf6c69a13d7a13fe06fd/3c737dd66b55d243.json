      ],
      "text": "CodeMachine is an orchestration layer that runs AI coding CLIs through structured workflows, handling execution, context passing, and agent coordination."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3b26b58b9f3b782600432c029439547e23c707564aa8938fc07907f140c99dd5",
