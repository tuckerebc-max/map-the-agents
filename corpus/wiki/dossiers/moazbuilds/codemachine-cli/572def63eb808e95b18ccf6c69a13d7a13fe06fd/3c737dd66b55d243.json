          "line_end": 32,
          "line_start": 32,
          "path": "README.md",
          "repository": "moazbuilds/codemachine-cli",
          "url": "https://github.com/moazbuilds/CodeMachine-CLI/blob/572def63eb808e95b18ccf6c69a13d7a13fe06fd/README.md#L32-L32"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_336986ea770742b69d84027768a185b302a468ce469eeff7996fa8b943f6c7c0"
      ],
      "text": "It spawns AI coding engines via CLI using their headless scripting mode, passing appropriate arguments and flags to control agents."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c02fb2a5b3c6ef147e2942a46f3df2a10a0682f70f762da2d3a8c531368808d7",
