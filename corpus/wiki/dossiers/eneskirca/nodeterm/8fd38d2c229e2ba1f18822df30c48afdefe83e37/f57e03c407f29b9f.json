      "locators": [
        {
          "commit": "8fd38d2c229e2ba1f18822df30c48afdefe83e37",
          "git_sha": "943db5b431b1a9c661ae0a5d4286f22db403a1a4",
          "line_end": 79,
          "line_start": 76,
          "path": "README.md",
          "repository": "eneskirca/nodeterm",
          "url": "https://github.com/eneskirca/nodeterm/blob/8fd38d2c229e2ba1f18822df30c48afdefe83e37/README.md#L76-L79"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_509a20f24e0986c210c684f27d36a12a311fcd8ba0f0fe3b961940b1b3821639"
      ],
      "text": "Agent status is hook-driven rather than output-scraped, showing RUNNING / NEEDS YOU badges, subagent cards with live transcripts, a per-node context meter, OS notifications, and in-node permission prompts."
    },
    {
      "basis": "documented",
      "claim_id": "clm_be7cc3e4fd93465e3cfa218f813650761bd9956dd5d486ea8c43f4afbbe2227c",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "8fd38d2c229e2ba1f18822df30c48afdefe83e37",
          "git_sha": "943db5b431b1a9c661ae0a5d4286f22db403a1a4",
          "line_end": 128,
          "line_start": 125,
          "path": "README.md",
          "repository": "eneskirca/nodeterm",
          "url": "https://github.com/eneskirca/nodeterm/blob/8fd38d2c229e2ba1f18822df30c48afdefe83e37/README.md#L125-L128"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ff57bc0518f82445872e07cfe4c17bd04d38c8d4640e65fb66251824567f4932"
      ],
      "text": "Node kinds include terminal (xterm + tmux), agent (Claude Code, Codex, Gemini, Copilot, opencode, Grok, custom), sticky notes linkable as agent context, groups bound to git worktrees, Monaco editors, diff views, and web/video nodes."
    },
    {
      "basis": "documented",
      "claim_id": "clm_737518d05fb0451597e68b750ca1d8e529ab692c5da2529c48ed95fb018cb2b5",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
