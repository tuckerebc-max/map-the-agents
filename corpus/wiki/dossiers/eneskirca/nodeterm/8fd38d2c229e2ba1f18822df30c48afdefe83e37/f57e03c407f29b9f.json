          "url": "https://github.com/eneskirca/nodeterm/blob/8fd38d2c229e2ba1f18822df30c48afdefe83e37/README.md#L132-L161"
        },
        {
          "commit": "8fd38d2c229e2ba1f18822df30c48afdefe83e37",
          "git_sha": "c2229f5c3b8302cc6a6289920d79e290a19481a9",
