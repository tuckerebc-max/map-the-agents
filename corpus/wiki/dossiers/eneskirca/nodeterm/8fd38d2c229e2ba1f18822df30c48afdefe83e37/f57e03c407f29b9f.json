          "line_start": 32,
          "path": "THIRD-PARTY-NOTICES.md",
          "repository": "eneskirca/nodeterm",
          "url": "https://github.com/eneskirca/nodeterm/blob/8fd38d2c229e2ba1f18822df30c48afdefe83e37/THIRD-PARTY-NOTICES.md#L32-L41"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_be9474040cca0c842b2c775f45e3e5ef0f2b577fc5352479f6f9bb88a61177ca",
        "slc_d69f6a6862bb9ec2705152f2a83372283431a61b426fcc2fa963fc96441fe275"
      ],
      "text": "Terminals run in persistent tmux sessions surviving node remounts, app restarts, and machine reboots, restoring scrollback and resuming agent sessions via claude --resume; the macOS app bundles its own tmux, preferring any system tmux."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d0184dba068d5c2ef3ad6babcd347df1e4ce76d794ec9f615e7a8f80f55f5deb",
      "evidence_type": "organizational_statement",
