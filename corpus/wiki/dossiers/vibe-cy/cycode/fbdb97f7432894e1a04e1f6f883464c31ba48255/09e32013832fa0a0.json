          "repository": "vibe-cy/cycode",
          "url": "https://github.com/vibe-cy/CyCode/blob/fbdb97f7432894e1a04e1f6f883464c31ba48255/README.md#L83-L93"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_65f62ffac49f475ffa45e0ee0b81d926540f78ac37fbd58187c01104b0c2824e"
      ],
      "text": "The CLI supports one-shot flags (-m/--message, -p/--prompt), session resume, working directory, model, base URL, API key, version, and help options."
    },
    {
      "basis": "documented",
      "claim_id": "clm_af5a2d5d2b17bf8f7e8f140fbe23659e873b8f824b2275c8c115cf4fda53d494",
