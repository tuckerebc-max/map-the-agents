      ],
      "text": "CyCode is described as a lightweight AI coding agent that runs in the terminal and uses an OpenAI-compatible Chat Completions API."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5b86cc351bf778568327d9f5238ada442b2eeebd013801b1e20ab3ab06e57e48",
