        {
          "commit": "a48e7a9f7e863f85750a98be7452e005c1486ec9",
          "git_sha": "af0fa17aac35716b8cb1919306e611f3acba3ada",
          "line_end": 191,
          "line_start": 137,
          "path": "README.md",
          "repository": "gabrielmaialva33/winx-code-agent",
          "url": "https://github.com/gabrielmaialva33/winx-code-agent/blob/a48e7a9f7e863f85750a98be7452e005c1486ec9/README.md#L137-L191"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_cb3ef2abc9ad8145b3634a4ee4f1b1bd157376a786c84fbbe14aab98d48440ad"
      ],
      "text": "Workspaces have three modes: wcgw (full access), architect (read-only), and code_writer (command allowlist plus write globs), with the allowlist parsed via tree-sitter to check every command including pipelines and substitutions."
    },
