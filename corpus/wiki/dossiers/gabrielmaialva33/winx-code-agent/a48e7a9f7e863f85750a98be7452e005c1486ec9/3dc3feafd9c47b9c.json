          "git_sha": "af0fa17aac35716b8cb1919306e611f3acba3ada",
          "line_end": 333,
          "line_start": 330,
          "path": "README.md",
          "repository": "gabrielmaialva33/winx-code-agent",
          "url": "https://github.com/gabrielmaialva33/winx-code-agent/blob/a48e7a9f7e863f85750a98be7452e005c1486ec9/README.md#L330-L333"
        }
      ],
