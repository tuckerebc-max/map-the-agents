      "slice_ids": [
        "slc_c240f09bd525f93b10ef930589417116fab89d8eaa539b9748a623628ac37e50"
      ],
      "text": "Building requires Rust 1.88+ and bash; the durable daemon runtime is supported on Linux/macOS/WSL2, while native Windows uses an embedded runtime with sessions tied to the server process."
    },
