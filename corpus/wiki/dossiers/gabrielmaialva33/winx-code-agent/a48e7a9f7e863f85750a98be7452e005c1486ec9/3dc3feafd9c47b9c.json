        "slc_08fde4655742d1aee01952b5e7a56e4031f4aa946adf4bc51777a73693626c32",
        "slc_eaf423b31b0d6ad0c36307a0cf499d20d8dccd4f517ca96dfca7bc1359ef8fbf",
        "slc_fb659b1e4396f4c62b3c1207bc7c88436993d68786b425d3b430f92f41166f6b"
      ],
      "text": "The single mutation tool EditFiles supports replace, SEARCH/REPLACE, revision-bound line patches, atomic batches, verification, and undo, with legacy edit names kept as hidden compatibility aliases."
    },
    {
      "basis": "documented",
      "claim_id": "clm_11ff99f9eb38a7e680c02a6444ea1f3dae14710abfec58990717c078d122ee6b",
