      "locators": [
        {
          "commit": "a48e7a9f7e863f85750a98be7452e005c1486ec9",
          "git_sha": "af0fa17aac35716b8cb1919306e611f3acba3ada",
          "line_end": 647,
          "line_start": 643,
          "path": "README.md",
          "repository": "gabrielmaialva33/winx-code-agent",
          "url": "https://github.com/gabrielmaialva33/winx-code-agent/blob/a48e7a9f7e863f85750a98be7452e005c1486ec9/README.md#L643-L647"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5a59c729842f1ce8ac604bad63c2feec981799fcccb67e17267235f20fe64895"
      ],
      "text": "Durable sessions survive HTTP disconnects: guardians are capped at 32 by default with tiered idle retention (30 minutes never-used, 24 hours used), and active commands are never evicted."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ca797917cdac719391d5d6289ae7a93bf16460945d5ba98c6eb1925691caa934",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "a48e7a9f7e863f85750a98be7452e005c1486ec9",
          "git_sha": "af0fa17aac35716b8cb1919306e611f3acba3ada",
          "line_end": 280,
          "line_start": 268,
          "path": "README.md",
          "repository": "gabrielmaialva33/winx-code-agent",
          "url": "https://github.com/gabrielmaialva33/winx-code-agent/blob/a48e7a9f7e863f85750a98be7452e005c1486ec9/README.md#L268-L280"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_050757e7fd9b1a3104bd6edd87a1d4a3c903279ac623c8a2fad54f669936170f"
      ],
      "text": "MCP Tasks on BashCommand are capability-driven: adaptive promotes only after runtime state is running, until_complete creates a Task immediately, and return_early never does; cancellation is generation-bound with a fail-closed fallback."
    },
