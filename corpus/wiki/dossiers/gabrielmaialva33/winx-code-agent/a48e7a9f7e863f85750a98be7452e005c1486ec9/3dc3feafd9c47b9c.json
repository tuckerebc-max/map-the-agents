        "slc_760980da607591c94cde9fde24642aea8c209edc90abc6fb27570a908c30dfe5",
        "slc_fb659b1e4396f4c62b3c1207bc7c88436993d68786b425d3b430f92f41166f6b"
      ],
      "text": "HTTP security defaults include loopback-only binding, 32-byte minimum bearer tokens, chmod-600 token files, DNS-rebinding host checks, 64 MiB body cap, 120 req/min per-IP rate limiting, and delayed invalid-auth responses."
    },
    {
      "basis": "documented",
      "claim_id": "clm_be9e773f1613dfe0ba8f4a425042b68bc83be5f11c0ae3fcba71ea2e1d0128ab",
