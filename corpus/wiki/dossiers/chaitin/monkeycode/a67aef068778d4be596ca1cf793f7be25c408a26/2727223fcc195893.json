      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_04fec04fdf9e2b0d9081a0b1d8bb54ce291bf5a7ecd54b768fec8dde5b220d37",
        "slc_10550eda321237cc5dc3ec2d110357a2812eafca61692f3f42f3b4f360446b38",
        "slc_96b88b63ac2b12984a21f2da5fe81bf7cb22c0bbf116871b66a9d9f9fb3a9bc8",
        "slc_e336b44ccee92979f52c919e15b2ff358413785e7abf1ce177162bfc70cc8d01"
      ],
      "text": "A design-workflow plan proposes extracting design patterns via Skills/Atoms (code-import, design-extract, token-map, rewrite-plan), saved as Design System Packages with revisions so re-extraction creates a new revision rather than overwriting."
    },
    {
      "basis": "documented",
      "claim_id": "clm_bb0c595ad37cead759be14608f5c310a64d9f8337ff3bd0a0b22ccef951e4cf2",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "inference",
      "locators": [
        {
