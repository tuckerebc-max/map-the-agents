        "slc_94121301d6e16bac570fa3df866418b2a1e249e206d06ac6efd6eae9a0b66f67"
      ],
      "text": "Harnss is a cross-platform desktop app providing a single interface to run, manage, and switch between AI coding agents including Claude Code, Codex, and ACP-compatible agents."
    },
    {
      "basis": "documented",
      "claim_id": "clm_cc5acf0bca626beae7a3848c6b0011114324cf0b2c625bd74662f59503c64ed4",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "dc1dfd8a33caa46a1eefcfe9e14697b27ac4c33d",
          "git_sha": "006b4653872e403813be4a852a3a3f3261c676c8",
          "line_end": 153,
          "line_start": 149,
          "path": "README.md",
          "repository": "opensource03/harnss",
          "url": "https://github.com/OpenSource03/harnss/blob/dc1dfd8a33caa46a1eefcfe9e14697b27ac4c33d/README.md#L149-L153"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_bfaf307c39fb4333aaebb7fbf49269467f0c593e08c6ab746738353675e2ecc4"
      ],
      "text": "The app supports three execution engines: Claude Code via the Anthropic Agent SDK, Codex via a JSON-RPC app-server, and ACP agents via the Agent Client Protocol."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ee9c34132fb7cd3faaab7213c9bd19ebd165621de536e281d07e8a6d38dfd274",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "dc1dfd8a33caa46a1eefcfe9e14697b27ac4c33d",
          "git_sha": "006b4653872e403813be4a852a3a3f3261c676c8",
          "line_end": 93,
          "line_start": 93,
          "path": "README.md",
          "repository": "opensource03/harnss",
          "url": "https://github.com/OpenSource03/harnss/blob/dc1dfd8a33caa46a1eefcfe9e14697b27ac4c33d/README.md#L93-L93"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_cf822e0cfa29436c8150f418f556014cccb2e64af9672f1f794c456995288bca"
      ],
      "text": "Tool calls render as interactive cards with word-level diffs, syntax highlighting, inline bash output, nested subagent progress tracking, and a per-turn Changes panel."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b92dd9cb97c61d2f931ca91890f57e2c674f7669593ccb09238f54715ea292de",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
          "commit": "dc1dfd8a33caa46a1eefcfe9e14697b27ac4c33d",
          "git_sha": "006b4653872e403813be4a852a3a3f3261c676c8",
          "line_end": 117,
          "line_start": 117,
          "path": "README.md",
          "repository": "opensource03/harnss",
          "url": "https://github.com/OpenSource03/harnss/blob/dc1dfd8a33caa46a1eefcfe9e14697b27ac4c33d/README.md#L117-L117"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_beeb7077ba6183899fa5fbbed53f978939af44a40c5db8e0211c9396e0392d84"
      ],
      "text": "The product offers three permission levels (Ask First, Accept Edits, Allow All) plus a plan mode where the agent drafts a plan before changes; modes can be switched mid-session without losing context."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a38a80c8d755af0b21b6994f25d266411d4b0ccf1c36cad1deb28eff798fbcd2",
