        "slc_b693e3a30a36645f78d270980d96bbcb6d31ee68896b1cc456ccfdfc68d736b0"
      ],
      "text": "An Agent Store lets users browse and install agents from the ACP community registry, or define custom agents with command, arguments, environment variables, and icon via Settings."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7f1ca87a67f8f38107fe4dc17f40552a69c818cf9d5c19cdbeb50b45842b929e",
