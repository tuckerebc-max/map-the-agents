          "line_end": 153,
          "line_start": 149,
          "path": "README.md",
          "repository": "opensource03/harnss",
          "url": "https://github.com/OpenSource03/harnss/blob/dc1dfd8a33caa46a1eefcfe9e14697b27ac4c33d/README.md#L149-L153"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_bfaf307c39fb4333aaebb7fbf49269467f0c593e08c6ab746738353675e2ecc4"
      ],
      "text": "Running Claude Code requires a Claude account (subscription or API key); Codex requires the Codex CLI in PATH plus an OpenAI API key or ChatGPT account; ACP agents have agent-specific requirements."
    },
    {
      "basis": "documented",
      "claim_id": "clm_683238a7e6f7bd6a2f8d665581adb9bd6667c8d0f1be4e5c0f29d56bb57c233b",
      "evidence_type": "organizational_statement",
