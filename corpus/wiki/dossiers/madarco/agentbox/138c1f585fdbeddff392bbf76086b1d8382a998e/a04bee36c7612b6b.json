      "slice_ids": [
        "slc_e030ebed97104bdcc4d60179336e754ccdb222a903b6b41531de9e01a852ba3b"
      ],
      "text": "A box argument is optional in most commands, defaulting to the current project's box, and can be given as a short index, name, or id prefix."
    },
