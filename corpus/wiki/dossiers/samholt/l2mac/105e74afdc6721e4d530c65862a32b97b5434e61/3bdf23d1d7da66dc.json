          "line_end": 29,
          "line_start": 28,
          "path": "README.md",
          "repository": "samholt/l2mac",
          "url": "https://github.com/samholt/L2MAC/blob/105e74afdc6721e4d530c65862a32b97b5434e61/README.md#L28-L29"
