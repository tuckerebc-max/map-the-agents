          "line_end": 59,
          "line_start": 59,
          "path": "CHANGELOG.md",
          "repository": "luangjokaj/wordpressify",
          "url": "https://github.com/luangjokaj/wordpressify/blob/df91d7e2d2ef991d6818c3ea8ce3d5572b500a56/CHANGELOG.md#L59-L59"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_b1f11864f16bafc50d19d141d5fc7127e0f920532b20f4af6c7c11ce70da906a"
      ],
      "text": "Since v0.4.0, NodeJS is no longer a global dependency; Docker is the only main dependency, enabling cross-platform runs."
    },
    {
      "basis": "documented",
      "claim_id": "clm_81d60215c751a5fef171b8b929b7218da4077ffcbbfe379ce31173947c70359a",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "df91d7e2d2ef991d6818c3ea8ce3d5572b500a56",
          "git_sha": "385d6a8f3e8ad3051933f4efbe5ccdb318c7573b",
          "line_end": 69,
          "line_start": 61,
          "path": "CHANGELOG.md",
          "repository": "luangjokaj/wordpressify",
          "url": "https://github.com/luangjokaj/wordpressify/blob/df91d7e2d2ef991d6818c3ea8ce3d5572b500a56/CHANGELOG.md#L61-L69"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_11e1bed2927d837d100954b177567b018ef057f8a1f954769c8ab958e6a0bfe2"
      ],
      "text": "v0.4.0 replaced older npm tasks with commands such as npm run start, npm run export, npm run export:backup, npm run lintcss, and docker compose equivalents."
    },
    {
      "basis": "documented",
      "claim_id": "clm_9327d227a8f18ce7996c9f88a6b6adda6004d11dfe17a73662a2d3a093a5ffa0",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
