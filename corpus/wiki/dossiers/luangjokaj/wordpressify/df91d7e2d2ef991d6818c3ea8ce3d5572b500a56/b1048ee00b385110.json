        "slc_4d1e12588112cb4b8e8fd36b18681986e091b44e4e46683bac04767876ac42a0"
      ],
      "text": "The default theme was rewritten as a modern block-based theme using HTML markup instead of PHP templates (v0.5.0)."
    },
    {
      "basis": "documented",
      "claim_id": "clm_bc69155ee6e94bd774b0d13ecdc7d014dfd111f75b6824d4c3ed6f0c05e321d5",
