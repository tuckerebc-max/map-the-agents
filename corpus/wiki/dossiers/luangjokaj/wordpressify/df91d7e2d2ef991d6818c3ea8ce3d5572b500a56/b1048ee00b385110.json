          "line_end": 43,
          "line_start": 31,
          "path": "CHANGELOG.md",
          "repository": "luangjokaj/wordpressify",
          "url": "https://github.com/luangjokaj/wordpressify/blob/df91d7e2d2ef991d6818c3ea8ce3d5572b500a56/CHANGELOG.md#L31-L43"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_78ecac2a9f29c8b424b45e9f3011237eb1b7535b8b0874e6cbf3eb626d8c89d9"
      ],
      "text": "v0.6.0 replaced chalk and prompts with native ANSI codes and Node's readline, cutting installer dependencies from over 100 to 18 packages."
    },
