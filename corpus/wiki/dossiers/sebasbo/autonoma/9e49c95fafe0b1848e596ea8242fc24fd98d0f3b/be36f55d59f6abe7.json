        "slc_0849ef9e690906195fbb524273ae85cf7e5be3efc78a342b0ce28f88653abd2e"
      ],
      "text": "Autonoma is described as a Python package that uses AI/language models to analyze and modify codebases, verifying changes through automated testing."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5d438569df69b72944bf874e07f2ef137fd80346e84a9f1e3025d4a69cf15d94",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "9e49c95fafe0b1848e596ea8242fc24fd98d0f3b",
          "git_sha": "c2ed00b25ec48fea855f504fe539c63f444e190a",
          "line_end": 106,
          "line_start": 102,
          "path": "readme.md",
          "repository": "sebasbo/autonoma",
          "url": "https://github.com/Sebasbo/Autonoma/blob/9e49c95fafe0b1848e596ea8242fc24fd98d0f3b/readme.md#L102-L106"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_7067ea948e4f5e59c9e6d32504bff83eca84184604c2d5f76853a74cc44f6b44"
      ],
      "text": "The system comprises a PlannerAgent that plans tasks from a user query, a CoderAgent that generates/modifies code, a Tester that runs tests, and Pydantic models for entities like Project, Task, and CodeFile."
    },
