      "slice_ids": [
        "slc_eb78977db114ea45b946d61539c49647ffab519288f64f5bee0c090e11f39297"
      ],
      "text": "Ollama is supported as an alternative to an Anthropic subscription via ANTHROPIC_AUTH_TOKEN=ollama plus ANTHROPIC_BASE_URL pointing at the Ollama endpoint."
    },
