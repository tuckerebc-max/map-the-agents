      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_02e3b1dd3d8fae07b90464529366dc669d8cb8a9e79357ed19fcb9b39f50bbd6",
        "slc_34210c20ec6898b2c9cf302dfcca8d73d906ad654c5369feb19e2f1ab7aabc40",
        "slc_6bf2a444113092af7dacd62d1ce9e8c9244dedeb5b2047867289d0a8486abab3"
      ],
      "text": "For Alfred 4 installs, configuration is done through environment variables such as language, base_currency, fixer_apikey, coinmarket_apikey, time_format, time_zone and vat_percentage."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1e459434c8680b9e564234c27facf88c0eb80be4e684d7cbfa63bd90f8e23fe1",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "fb98d4a78069c5cf2ced4eea5dffbeef3d10c152",
          "git_sha": "96019b3d3041deff7972e1ce67adbbf0dfc48c5b",
          "line_end": 584,
          "line_start": 584,
          "path": "README.md",
          "repository": "biati-digital/alfred-calculate-anything",
          "url": "https://github.com/biati-digital/alfred-calculate-anything/blob/fb98d4a78069c5cf2ced4eea5dffbeef3d10c152/README.md#L584-L584"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_0e90ae478690564882a76c62b58791a779ba2432458324e41f63d27bd20b724c"
      ],
      "text": "For performance, currency, percentage and unit queries are only processed when they begin with a digit and contain at least three characters."
    },
    {
      "basis": "documented",
      "claim_id": "clm_42f12d303d64f98d69d2e374aed1ce933ea6abf566e03c1b661f1cb729069391",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "inference",
      "locators": [
        {
          "commit": "fb98d4a78069c5cf2ced4eea5dffbeef3d10c152",
          "git_sha": "7f10a3b0c66f7c106b29740f0e7af4abd58c2af8",
          "line_end": 64,
          "line_start": 63,
          "path": "CHANGELOG.md",
          "repository": "biati-digital/alfred-calculate-anything",
          "url": "https://github.com/biati-digital/alfred-calculate-anything/blob/fb98d4a78069c5cf2ced4eea5dffbeef3d10c152/CHANGELOG.md#L63-L64"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6b497d41f48c56ec264ae2f12abfd23c97b3f1a945fed58ed05cf5873818abea"
      ],
      "text": "Currency conversion is prioritized over cryptocurrency when codes collide (e.g. GBP), apparently because many cryptocurrencies share codes with fiat currencies; this is configurable."
    },
    {
      "basis": "documented",
      "claim_id": "clm_427c6c730d5ea8bb88b4a2300d9768e6d9d679c14d08bafdd006a85b8b7fa328",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
          "commit": "fb98d4a78069c5cf2ced4eea5dffbeef3d10c152",
          "git_sha": "7f10a3b0c66f7c106b29740f0e7af4abd58c2af8",
          "line_end": 59,
          "line_start": 42,
          "path": "CHANGELOG.md",
          "repository": "biati-digital/alfred-calculate-anything",
          "url": "https://github.com/biati-digital/alfred-calculate-anything/blob/fb98d4a78069c5cf2ced4eea5dffbeef3d10c152/CHANGELOG.md#L42-L59"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_38214ab38dc5c3d7d89e18ecd05e24ff1c09db332f9fbde4348df76f1c66b27f"
      ],
      "text": "The changelog notes the auto-updater was removed because Alfred 5 handles future updates, and the old 'ca' configuration keyword was removed."
    }
