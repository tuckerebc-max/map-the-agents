          "line_end": 74,
          "line_start": 71,
          "path": "docs/ARCHITECTURE.md",
          "repository": "bytedance/deer-flow",
          "url": "https://github.com/bytedance/deer-flow/blob/d5ae3882b6708fa9af7289a0c3c0be3eee157203/docs/ARCHITECTURE.md#L71-L74"
        },
