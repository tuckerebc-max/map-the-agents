      ],
      "text": "The repository is a curated collection of papers and resources on large language models for code generation, tied to a survey paper accepted by TOSEM."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d2bdae9e7c0fd0169710a1c9684343692969a00ed97e1cf7dd4d62be4115c2d7",
