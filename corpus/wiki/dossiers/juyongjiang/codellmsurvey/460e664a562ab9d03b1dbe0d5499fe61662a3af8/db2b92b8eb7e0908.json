        "slc_9f259ef5570ba35504cf8453b3e35055aaaf6ac7257a7e7fa976eb798f044f3e",
        "slc_abff13eb7e4d0814a0721d9dd96e93b65df4f22f73b2b7b372845abe45886f36"
      ],
      "text": "The associated survey is 'A Survey on Large Language Models for Code Generation' by Jiang, Wang, Shen, Kim, and Kim, available as arXiv preprint 2406.00515 (2024)."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ca93c9b50b62e3e0c51b0eb6195e81753c3b34c86dc503c5f6d19359cac78755",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
      "locators": [
        {
          "commit": "460e664a562ab9d03b1dbe0d5499fe61662a3af8",
          "git_sha": "896c8480953bedd8959b878bfd4183eae4a219a6",
          "line_end": 65,
          "line_start": 48,
          "path": "README.md",
          "repository": "juyongjiang/codellmsurvey",
          "url": "https://github.com/juyongjiang/CodeLLMSurvey/blob/460e664a562ab9d03b1dbe0d5499fe61662a3af8/README.md#L48-L65"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_338edf01af4bd02e132e55dfcafa0abbac5ba3f1926fb773f091e7d887dff95a"
      ],
      "text": "The README organizes the paper list into sections including pre-training, instruction tuning, reinforcement learning with feedback, prompting, data synthesis, repository-level/long context, retrieval augmentation, autonomous coding agents, alignment, and evaluation/benchmarks."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b6c033f175abde19bc3131ceed997742765f9c0515dc72ae2faf9cf3c49d54b6",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
      "locators": [
        {
          "commit": "460e664a562ab9d03b1dbe0d5499fe61662a3af8",
          "git_sha": "896c8480953bedd8959b878bfd4183eae4a219a6",
          "line_end": 23,
          "line_start": 14,
          "path": "README.md",
          "repository": "juyongjiang/codellmsurvey",
          "url": "https://github.com/juyongjiang/CodeLLMSurvey/blob/460e664a562ab9d03b1dbe0d5499fe61662a3af8/README.md#L14-L23"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a3c0a33bb43943cfead20f550efb79977dba93fa93a71d14729fae288c84beab"
      ],
      "text": "The README describes a four-stage training workflow for Code LLMs, where stages 1-2 are pre-training and stages 3-4 are post-training, with stages 2 and 4 optional; examples note StarCoder uses only stage 1 and Code Llama covers stages 2 and 3."
    },
    {
      "basis": "documented",
      "claim_id": "clm_814fa7ed045a48d6e4c0d5c4aedf78a321d37c803fbfdbef787965bb1a0dc075",
      "evidence_type": "organizational_statement",
