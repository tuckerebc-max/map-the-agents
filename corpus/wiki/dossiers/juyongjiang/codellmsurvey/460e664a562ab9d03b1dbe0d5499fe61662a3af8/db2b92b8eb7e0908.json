      "slice_ids": [
        "slc_9ea39a4ff70016943022dbb7e9490e9b79271374066bd70f842cce5b65aaa7fb"
      ],
      "text": "The resource list links to external leaderboards such as BigCodeBench, HumanEval, EvalPlus, CRUXEval, and the Open LLM Leaderboard for comparing code-generation model performance."
    },
    {
