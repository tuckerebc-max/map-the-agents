      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_cec1571e13010b74144bb425857bbea17e823efc6c942180f3993861b8c0502d"
      ],
      "text": "Patchwork is built from three key components: reusable atomic steps (e.g., create PR, commit changes, call an LLM), customizable prompt templates, and patchflows that combine steps and prompts into automations."
    },
    {
      "basis": "documented",
      "claim_id": "clm_75f6254c08b372942de2c68bb5b36429cb3889e0702246025a87d606ae2d89fc",
