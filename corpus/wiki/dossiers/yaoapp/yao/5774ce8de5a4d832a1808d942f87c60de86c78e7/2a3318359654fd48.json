        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_b4e0c699ba423c774723583de0d85054cc4a0193eb7f997837dac8ecbc5ebb83"
      ],
      "text": "The product exposes an Open API built on standard APIs with both SSE and WebSocket support, intended for integrating expert and task agents into external apps and workflows."
    },
    {
      "basis": "documented",
      "claim_id": "clm_87ccd95a98174b9eb878a69532d3f09f6b25fd5c1310ca88293f37e4727f2ce8",
