      ],
      "text": "Yao Agents is described as a self-hosted platform holding all agents and workspaces in one place, accessible from desktop, mobile, browser, or API."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1bc4c70078b70f3b78e23c5235fee21d6ca7dd9ec41402f336ffcbc6fc99ac3a",
