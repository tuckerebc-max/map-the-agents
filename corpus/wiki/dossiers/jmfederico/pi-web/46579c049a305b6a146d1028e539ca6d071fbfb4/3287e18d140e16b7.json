          "line_end": 171,
          "line_start": 171,
          "path": "README.md",
          "repository": "jmfederico/pi-web",
          "url": "https://github.com/jmfederico/pi-web/blob/46579c049a305b6a146d1028e539ca6d071fbfb4/README.md#L171-L171"
        },
        {
          "commit": "46579c049a305b6a146d1028e539ca6d071fbfb4",
          "git_sha": "d60bf298b4413bca11d019349476548c97a44d42",
          "line_end": 169,
          "line_start": 169,
          "path": "README.md",
          "repository": "jmfederico/pi-web",
          "url": "https://github.com/jmfederico/pi-web/blob/46579c049a305b6a146d1028e539ca6d071fbfb4/README.md#L169-L169"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_20d14fccc8c0e7544d078deb63abecff954cb1f0321991225078550ff10f4cd7",
        "slc_41551ebc61db749eea27c37678501df15e653e8fd82efd5403bc4b152aa53bdf"
      ],
      "text": "The security model assumes trusted users, repositories, and server paths; the product is explicitly not a sandbox, permission system, or multi-tenant platform and should not be exposed directly to the public internet."
    },
    {
      "basis": "documented",
      "claim_id": "clm_fa44460aebcf86a4b35d21cf46d876604f4f4c08595a17520f18b6c93974cb11",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "46579c049a305b6a146d1028e539ca6d071fbfb4",
          "git_sha": "d60bf298b4413bca11d019349476548c97a44d42",
          "line_end": 105,
          "line_start": 105,
          "path": "README.md",
          "repository": "jmfederico/pi-web",
          "url": "https://github.com/jmfederico/pi-web/blob/46579c049a305b6a146d1028e539ca6d071fbfb4/README.md#L105-L105"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a29470d7ad0188adc37e3975f983bd081b59b4167677a3725da2cea5c3487042"
      ],
      "text": "PI WEB can register other PI WEB runtimes as remote machines, with one browser-facing instance proxying projects, files, git state, sessions, terminals, and Pi package management from trusted remote machines."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d93387b1a99c554df0f156da90a3c302707cccbcc40c0346c3d9f69519e5bcde",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
      "locators": [
        {
