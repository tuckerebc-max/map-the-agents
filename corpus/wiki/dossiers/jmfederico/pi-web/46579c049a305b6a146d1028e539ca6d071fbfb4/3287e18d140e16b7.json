          "git_sha": "d60bf298b4413bca11d019349476548c97a44d42",
          "line_end": 50,
          "line_start": 50,
          "path": "README.md",
          "repository": "jmfederico/pi-web",
          "url": "https://github.com/jmfederico/pi-web/blob/46579c049a305b6a146d1028e539ca6d071fbfb4/README.md#L50-L50"
        },
        {
          "commit": "46579c049a305b6a146d1028e539ca6d071fbfb4",
          "git_sha": "d60bf298b4413bca11d019349476548c97a44d42",
          "line_end": 48,
          "line_start": 44,
          "path": "README.md",
          "repository": "jmfederico/pi-web",
          "url": "https://github.com/jmfederico/pi-web/blob/46579c049a305b6a146d1028e539ca6d071fbfb4/README.md#L44-L48"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_09153479bf66385f87f79810ab0517cad2c93846b2036864a2e466b669c1d768",
        "slc_5ce822156e5da02819a05ad07302d6c56f44b3d7cd96f5bfe614d5ce589de7c3"
      ],
      "text": "Installation uses npm with the scoped --allow-scripts=node-pty flag so node-pty can build its native module without enabling install scripts for other packages."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d530a1f25c83e05f228999bdb8b54f6c8ade851927ab79df85ac03529400b050",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
          "commit": "46579c049a305b6a146d1028e539ca6d071fbfb4",
