{
  "applied_operation_id": "op_636c316dd368487894232d38f828d83f",
  "claims": [
    {
      "basis": "documented",
      "claim_id": "clm_1589f315b690b13265b2e92e0b57bae1bc305df92dc0668dd4d97ae6e326e6e3",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
