        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_035737208f4a6dc485afd0750df5abfd769addfb2a21af0a82cd58721f7c27d2"
      ],
      "text": "Agentrove is a self-hosted AI coding workspace that runs and orchestrates Antigravity, Claude Code, Codex, Copilot, Cursor, Grok, and OpenCode agents from one interface."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3e8ff4c49e097a084ac2dd6c255fdebdac747699473276d5520e622be0657cf8",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "53ef8fc0dea3a29005d341ad1031014aa07e56b8",
          "git_sha": "eaf6def6d69ce6c8f2a7f081a984829ce08e5f4f",
          "line_end": 22,
          "line_start": 14,
          "path": "README.md",
          "repository": "mng-dev-ai/agentrove",
          "url": "https://github.com/Mng-dev-ai/agentrove/blob/53ef8fc0dea3a29005d341ad1031014aa07e56b8/README.md#L14-L22"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a1f969dfc336c4501121fb24bfe506e299cdc8a7d3c35834099d7892ff83a9a3"
      ],
      "text": "Agents are run through ACP adapters, and each workspace gets its own Docker or host sandbox."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f3bc6146ff4637351677567c2cf95d90e80fe989ee9cdcba1f2635bab51e3d11",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "53ef8fc0dea3a29005d341ad1031014aa07e56b8",
          "git_sha": "eaf6def6d69ce6c8f2a7f081a984829ce08e5f4f",
          "line_end": 26,
          "line_start": 26,
          "path": "README.md",
          "repository": "mng-dev-ai/agentrove",
          "url": "https://github.com/Mng-dev-ai/agentrove/blob/53ef8fc0dea3a29005d341ad1031014aa07e56b8/README.md#L26-L26"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_cf72c56a012c8946c9574dd983f2a2b7bc1ec48929442b30a7364069b70bc6a8"
      ],
      "text": "A bundled MCP server exposes the instance as tools such as send_message, get_messages, list_models, and list_personas, letting any chat's agent act as an orchestrator that decomposes work and reviews results."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2acbee0e8a939871a5c82c573cfeab37ea6a3aa1331b464966774c28c80ad3eb",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "53ef8fc0dea3a29005d341ad1031014aa07e56b8",
          "git_sha": "eaf6def6d69ce6c8f2a7f081a984829ce08e5f4f",
          "line_end": 34,
          "line_start": 30,
          "path": "README.md",
          "repository": "mng-dev-ai/agentrove",
          "url": "https://github.com/Mng-dev-ai/agentrove/blob/53ef8fc0dea3a29005d341ad1031014aa07e56b8/README.md#L30-L34"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c7547ed9ccbbd93c9ed1ef238ae08354dbf7c01f9bec54ce62dd035f4eb3948b"
      ],
      "text": "Sub-threads created via send_message(parent_chat_id=...) are worker chats grouped under the lead in the same workspace and branch, and stay flat with no nesting."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4a1120b3227eba79da191c605a69e8f2f334eb309fd540e8d64e98c65a5329b2",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "53ef8fc0dea3a29005d341ad1031014aa07e56b8",
          "git_sha": "eaf6def6d69ce6c8f2a7f081a984829ce08e5f4f",
          "line_end": 34,
          "line_start": 30,
          "path": "README.md",
          "repository": "mng-dev-ai/agentrove",
          "url": "https://github.com/Mng-dev-ai/agentrove/blob/53ef8fc0dea3a29005d341ad1031014aa07e56b8/README.md#L30-L34"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c7547ed9ccbbd93c9ed1ef238ae08354dbf7c01f9bec54ce62dd035f4eb3948b"
      ],
      "text": "Workers can run on any installed agent, model, and persona; worktree=true gives a worker its own git worktree so parallel workers edit concurrently without conflicts."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c77b49d113a6933f2730bc3722886aec4c4fa81fea79a2bc3125442267fa16e6",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "53ef8fc0dea3a29005d341ad1031014aa07e56b8",
          "git_sha": "eaf6def6d69ce6c8f2a7f081a984829ce08e5f4f",
          "line_end": 34,
          "line_start": 30,
          "path": "README.md",
          "repository": "mng-dev-ai/agentrove",
          "url": "https://github.com/Mng-dev-ai/agentrove/blob/53ef8fc0dea3a29005d341ad1031014aa07e56b8/README.md#L30-L34"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c7547ed9ccbbd93c9ed1ef238ae08354dbf7c01f9bec54ce62dd035f4eb3948b"
      ],
      "text": "The lead polls get_messages until a worker's turn completes, judges results against the code, and sends rework to the worker's thread; follow-ups inherit prior model, persona, and reasoning settings."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1dfbfe277a7c842f13110017175d273c64fe52071a8f9a42946d4a6a39c6e9cb",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
          "commit": "53ef8fc0dea3a29005d341ad1031014aa07e56b8",
          "git_sha": "eaf6def6d69ce6c8f2a7f081a984829ce08e5f4f",
          "line_end": 34,
          "line_start": 30,
          "path": "README.md",
          "repository": "mng-dev-ai/agentrove",
          "url": "https://github.com/Mng-dev-ai/agentrove/blob/53ef8fc0dea3a29005d341ad1031014aa07e56b8/README.md#L30-L34"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c7547ed9ccbbd93c9ed1ef238ae08354dbf7c01f9bec54ce62dd035f4eb3948b"
      ],
      "text": "Orchestrated turns run in the agent's full-execution mode, so workers finish without permission prompts."
    },
    {
      "basis": "documented",
      "claim_id": "clm_35d36aec574f8d37576229b63f62e777349d4ae371fb4c05366f06739cc1aabd",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "53ef8fc0dea3a29005d341ad1031014aa07e56b8",
          "git_sha": "eaf6def6d69ce6c8f2a7f081a984829ce08e5f4f",
          "line_end": 22,
          "line_start": 14,
          "path": "README.md",
          "repository": "mng-dev-ai/agentrove",
          "url": "https://github.com/Mng-dev-ai/agentrove/blob/53ef8fc0dea3a29005d341ad1031014aa07e56b8/README.md#L14-L22"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a1f969dfc336c4501121fb24bfe506e299cdc8a7d3c35834099d7892ff83a9a3"
      ],
      "text": "The workspace combines chat, code editor, terminal, file tree, diffs, secrets, and git tools, and streams agent sessions with cancellation, permission prompts, queued follow-ups, file mentions, slash commands, and attachments."
    },
    {
      "basis": "documented",
      "claim_id": "clm_08fb405b72b2c0bb16a3104a6e87a82a3a492af034239a62dfddca91a2d4ebba",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "53ef8fc0dea3a29005d341ad1031014aa07e56b8",
          "git_sha": "eaf6def6d69ce6c8f2a7f081a984829ce08e5f4f",
          "line_end": 160,
          "line_start": 158,
          "path": "README.md",
          "repository": "mng-dev-ai/agentrove",
          "url": "https://github.com/Mng-dev-ai/agentrove/blob/53ef8fc0dea3a29005d341ad1031014aa07e56b8/README.md#L158-L160"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_f226969729fc2fb62a41e8c45facd85a1c2bfe2564293074ecfd2ad632e65fc7"
      ],
      "text": "The stack is React 19, TypeScript, Vite, Tailwind, Monaco, and xterm.js on the frontend; FastAPI, SQLAlchemy, SQLite, and Redis on the backend; ACP with Docker or host sandboxes at runtime."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0acec8cdfb88ff976cc741d744f39dba0536401929f99dd575c56dfe8042c604",
