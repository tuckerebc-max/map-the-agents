          "url": "https://github.com/snarktank/ralph/blob/6c53cb0b831ebe8739c6a003e22af14902d8b0b5/README.md#L122-L130"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_428911831efd2105297098596f8556174e3ee5214cc070af510c4b9273dce44b"
      ],
      "text": "Each loop iteration creates a feature branch from the PRD branchName, picks the highest-priority story with passes:false, implements it, runs quality checks, commits, marks it passes:true, and repeats until done or max iterations."
    },
    {
      "basis": "documented",
      "claim_id": "clm_924725008f8e5bf781aa2703f913c55af8ca337ae3a13f763bc365c534cab01e",
      "evidence_type": "organizational_statement",
