      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_1f1ff292c6057da56a4f6587bda13643d22312cb77fd697fa0cf4c271c9d0f73"
      ],
      "text": "The only memory between iterations is git history, the append-only progress.txt learnings file, and prd.json story status."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4456223d7175bb2ae9491440dee1bedabe78226ebae884a9882ebb095a7911b4",
      "evidence_type": "organizational_statement",
