          "git_sha": "d79d8b62e25624d0c67387515ed6881bfde56b7a",
          "line_end": 168,
          "line_start": 165,
          "path": "README.md",
          "repository": "snarktank/ralph",
          "url": "https://github.com/snarktank/ralph/blob/6c53cb0b831ebe8739c6a003e22af14902d8b0b5/README.md#L165-L168"
