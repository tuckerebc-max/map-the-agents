      ],
      "text": "This repository is the companion code repository for the Packt book 'Agentic Coding with Claude Code, First Edition' by Eden Marco."
    },
    {
      "basis": "documented",
      "claim_id": "clm_bf3223ed98b30224c316967a0253b04e660594afe9cdf786952b2b8e3c59c411",
