          "git_sha": "76216101bde7186e6f6524ba403ae043ea81db4b",
          "line_end": 33,
          "line_start": 27,
          "path": "README.md",
          "repository": "packtpublishing/agentic-coding-with-claude-code",
          "url": "https://github.com/PacktPublishing/Agentic-Coding-with-Claude-Code/blob/78131f7a050fbf745ea49d321c3a1b44caed2e27/README.md#L27-L33"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_870cd9d132b59e114ead6a9ec75f3a187fdc452d9f02f88b6c30f3e871a0f1e8"
      ],
      "text": "The book teaches designing multi-agent systems using subagents, parallel sessions, and hierarchical delegation."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1efa3524b52f3987b44568202341fb57f9bcc4690f043de7b8cefcdb6ad1a2a4",
