      ],
      "text": "Hands-on examples require a development environment with Node.js and a simple Next.js setup, plus access to Claude Code with appropriate authentication and pricing configuration."
    },
    {
      "basis": "documented",
      "claim_id": "clm_fa977be76ec5f0fc2072538600fb0c53c104162583bd5de3dc0f9d4466a1d06b",
