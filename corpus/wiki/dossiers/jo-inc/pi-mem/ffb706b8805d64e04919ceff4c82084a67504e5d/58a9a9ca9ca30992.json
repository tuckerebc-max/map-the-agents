        "slc_af0b23b6bd34156f14f5c36e55f0661d7056bc19aa8f0562e6e5a760e5fb313f"
      ],
      "text": "pi-mem is a memory package for the pi coding agent, installable via 'pi install git:github.com/jo-inc/pi-mem'."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d99197d77b03246bf9966e916cfebd819dd43c3167bdc2627ee31a99d60690de",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
