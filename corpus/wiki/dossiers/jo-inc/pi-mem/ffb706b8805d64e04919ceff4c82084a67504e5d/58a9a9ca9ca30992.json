          "repository": "jo-inc/pi-mem",
          "url": "https://github.com/jo-inc/pi-mem/blob/ffb706b8805d64e04919ceff4c82084a67504e5d/README.md#L52-L52"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5b996fd7ec2c369cce042781f2709f6c70ce4349519764b6dc8f4f5f5898caea"
      ],
      "text": "Notes files and older daily logs are deliberately not injected into context; they remain accessible on demand via memory_search and memory_read."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8307ac53e12a541524e3f2da5e7e18e92c209253b3fb6d0b946271e0c60d6fcb",
