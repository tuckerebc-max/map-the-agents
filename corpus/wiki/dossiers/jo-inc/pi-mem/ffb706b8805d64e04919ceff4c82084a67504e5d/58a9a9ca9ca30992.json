        "slc_ae92ee6ef3bf2bc2a420f4ce5967f779612b441141441c23a72403b291a6c861"
      ],
      "text": "Supported settings include searchDirs, contextFiles, and autocommit in .pi-mem.json, plus env vars PI_MEMORY_DIR, PI_DAILY_DIR, PI_CONTEXT_FILES, PI_SEARCH_DIRS, PI_AUTOCOMMIT, and PI_TIMEZONE."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6efb3d94c59d592d18e89f0f33ae4ff8382e062f7afbb69c9695155d8f124663",
