        "slc_1dedabbdd8855ef78ba0710b1fe0d97c66f9cae226ebece46b1a10214b9473d9",
        "slc_d2827e23182eafa84fc86d89be60dc4b16e4acc17ae54567f3e904840c5e6d8c"
      ],
      "text": "Before every agent turn, the system prompt is automatically injected with PI_CONTEXT_FILES entries, MEMORY.md, open SCRATCHPAD.md items, and today's and yesterday's daily logs."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e2b150bff901d759eb53891ea1e31a7105affd6394c98af17ffcb1a9b02eba42",
