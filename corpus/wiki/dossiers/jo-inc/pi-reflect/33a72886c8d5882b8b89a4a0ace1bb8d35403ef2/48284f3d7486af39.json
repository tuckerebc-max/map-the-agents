      "slice_ids": [
        "slc_1dbdeb7de74e9f1bed41b107facecb3dcdf7d8a4d2fc54d8a633fbfdbf8c7652"
      ],
      "text": "Each run collects evidence from transcripts, daily logs, and reference files, sends evidence plus the target file and a prompt to an LLM, then applies the LLM's proposed edits with safety checks."
    },
