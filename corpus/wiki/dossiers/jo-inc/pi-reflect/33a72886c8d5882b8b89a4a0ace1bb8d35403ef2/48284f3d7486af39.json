          "line_end": 39,
          "line_start": 32,
          "path": "README.md",
          "repository": "jo-inc/pi-reflect",
          "url": "https://github.com/jo-inc/pi-reflect/blob/33a72886c8d5882b8b89a4a0ace1bb8d35403ef2/README.md#L32-L39"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9e19e67a7175fc9b59870e3615875d90e6d87d9c057afb050e5a3a2658f3fdbb"
      ],
      "text": "The product exposes slash commands: /reflect (optionally with a file path), /reflect-config, /reflect-history, /reflect-stats, and /reflect-backfill."
    },
