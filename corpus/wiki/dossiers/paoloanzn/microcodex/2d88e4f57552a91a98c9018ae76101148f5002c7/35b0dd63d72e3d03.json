        "slc_54f4065d30bdd14d7eb2a49169e77fe2e880f7c69f2fce2fc85c90b97b1dd9e0",
        "slc_8f3d73bb351bdb3ae5f4892f33fe4de2471df9b269979c283ac9302db18d5813"
      ],
      "text": "Linux requires the libcurl and OpenSSL runtime libraries, and prebuilt binaries are published for macOS and Linux on arm64 and x86_64."
    },
