        "slc_2dd8761a89260a4d206b4790d6fbadb0f4d0351af834ec03bc13eafad2ef6afc"
      ],
      "text": "MicroCodex is described as an ultra-lightweight coding agent that runs locally in the terminal and is written in C++23."
    },
    {
      "basis": "documented",
      "claim_id": "clm_476350f166687f7b70dff4932bf3d832b541dcf75ce08797e7620e1c21d693b1",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "2d88e4f57552a91a98c9018ae76101148f5002c7",
          "git_sha": "277f579cef90e2bbb009d9569865de9b368d20b9",
          "line_end": 7,
          "line_start": 1,
          "path": "README.md",
          "repository": "paoloanzn/microcodex",
          "url": "https://github.com/paoloanzn/microcodex/blob/2d88e4f57552a91a98c9018ae76101148f5002c7/README.md#L1-L7"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2dd8761a89260a4d206b4790d6fbadb0f4d0351af834ec03bc13eafad2ef6afc"
      ],
      "text": "The product provides one-shot prompts, an interactive terminal UI, local coding tools, durable conversations, and automatic context compaction."
    },
    {
      "basis": "documented",
      "claim_id": "clm_55199b7ae7bf7b3dc8ef0f368410b4187016dc07503fcc734137ea9c8df8bf7b",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
