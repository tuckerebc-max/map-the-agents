          "url": "https://github.com/paoloanzn/microcodex/blob/2d88e4f57552a91a98c9018ae76101148f5002c7/README.md#L39-L39"
        },
        {
          "commit": "2d88e4f57552a91a98c9018ae76101148f5002c7",
          "git_sha": "277f579cef90e2bbb009d9569865de9b368d20b9",
          "line_end": 33,
          "line_start": 28,
          "path": "README.md",
          "repository": "paoloanzn/microcodex",
          "url": "https://github.com/paoloanzn/microcodex/blob/2d88e4f57552a91a98c9018ae76101148f5002c7/README.md#L28-L33"
        }
      ],
      "review_state": "mechanically_checked",
