  "claims": [
    {
      "basis": "documented",
      "claim_id": "clm_9236783652fb6073241ccd2c6160a2b6df79cef51773d2d8df8258f43f40b27f",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
      "locators": [
        {
          "commit": "43a621ab06ef0198d728b93c93660ce5c381cb11",
          "git_sha": "ecfd367446b14c85de6e9c1eaf37d5ebf254c8e5",
          "line_end": 9,
          "line_start": 9,
          "path": "README.md",
          "repository": "vincentkoc/tokenjuice",
          "url": "https://github.com/vincentkoc/tokenjuice/blob/43a621ab06ef0198d728b93c93660ce5c381cb11/README.md#L9-L9"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c53e6e55b87489118812765b374238ed5487ce5f011f1ff936a451febf5ad979"
      ],
      "text": "tokenjuice is described as a deterministic output compactor for terminal-heavy agent workflows: it observes command output after execution and returns a smaller payload built from rule-driven reducers instead of the full terminal text."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a61f3305173e2669b96b8618c2fcb64b7a5f9cb5f05c4cafdfdbf3a027eaa995",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "43a621ab06ef0198d728b93c93660ce5c381cb11",
          "git_sha": "ecfd367446b14c85de6e9c1eaf37d5ebf254c8e5",
          "line_end": 11,
          "line_start": 11,
          "path": "README.md",
          "repository": "vincentkoc/tokenjuice",
          "url": "https://github.com/vincentkoc/tokenjuice/blob/43a621ab06ef0198d728b93c93660ce5c381cb11/README.md#L11-L11"
        },
        {
          "commit": "43a621ab06ef0198d728b93c93660ce5c381cb11",
          "git_sha": "ecfd367446b14c85de6e9c1eaf37d5ebf254c8e5",
          "line_end": 9,
          "line_start": 9,
          "path": "README.md",
          "repository": "vincentkoc/tokenjuice",
          "url": "https://github.com/vincentkoc/tokenjuice/blob/43a621ab06ef0198d728b93c93660ce5c381cb11/README.md#L9-L9"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_424b68ff8abae0e257123ee28bfb935efabf5ddca69d6da6766739b66e1e3670",
        "slc_c53e6e55b87489118812765b374238ed5487ce5f011f1ff936a451febf5ad979"
      ],
      "text": "The design keeps command semantics untouched, exposes raw output only via explicit --raw/--full or opt-in artifact storage, keeps rules as inspectable JSON, and keeps host integrations as thin wrappers around one shared core reducer."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2aed415c8051e4b113c13b67c42346d05963b8fe58f50e20418c8295f6c44335",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "43a621ab06ef0198d728b93c93660ce5c381cb11",
          "git_sha": "ecfd367446b14c85de6e9c1eaf37d5ebf254c8e5",
          "line_end": 190,
          "line_start": 190,
          "path": "README.md",
          "repository": "vincentkoc/tokenjuice",
          "url": "https://github.com/vincentkoc/tokenjuice/blob/43a621ab06ef0198d728b93c93660ce5c381cb11/README.md#L190-L190"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a9efb0693377eee88a79998a661ba0a6e0cb519dc18192fdf54b18e45ed717a7"
      ],
      "text": "The CLI has three surfaces: `reduce` compacts existing text, `wrap` runs a command and compacts its observed output, and `reduce-json` provides a stable machine protocol for host adapters."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8563deaaa301352baa4c73d3913786e76f8ec4a7f11e3a00d0f27e1c028ed95e",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "43a621ab06ef0198d728b93c93660ce5c381cb11",
          "git_sha": "ecfd367446b14c85de6e9c1eaf37d5ebf254c8e5",
          "line_end": 226,
          "line_start": 218,
          "path": "README.md",
          "repository": "vincentkoc/tokenjuice",
          "url": "https://github.com/vincentkoc/tokenjuice/blob/43a621ab06ef0198d728b93c93660ce5c381cb11/README.md#L218-L226"
        },
        {
          "commit": "43a621ab06ef0198d728b93c93660ce5c381cb11",
          "git_sha": "ecfd367446b14c85de6e9c1eaf37d5ebf254c8e5",
          "line_end": 214,
          "line_start": 214,
          "path": "README.md",
          "repository": "vincentkoc/tokenjuice",
          "url": "https://github.com/vincentkoc/tokenjuice/blob/43a621ab06ef0198d728b93c93660ce5c381cb11/README.md#L214-L214"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_849420ec0596b640e42921ac36d10aea730b5ca0faa9166e2d2659cbefd42c11",
        "slc_ebb4515408a34248d9ba3a1d87572cff2d8757117d14a9b9804685b6691aaedf"
      ],
      "text": "`reduce-json` reads JSON from stdin or a file and always writes JSON to stdout; the documented payload includes fields such as toolName, command, argv, combinedText, and exitCode."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c4076aa8303a4fe2a278b2ee6ba86f0fdb8a1d32183dc38d1d7b2ce591ba1fff",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "43a621ab06ef0198d728b93c93660ce5c381cb11",
          "git_sha": "ecfd367446b14c85de6e9c1eaf37d5ebf254c8e5",
          "line_end": 192,
          "line_start": 192,
          "path": "README.md",
          "repository": "vincentkoc/tokenjuice",
          "url": "https://github.com/vincentkoc/tokenjuice/blob/43a621ab06ef0198d728b93c93660ce5c381cb11/README.md#L192-L192"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_3a1f8db37d7a5007401b082d16e983a5547e7e8ba0c21fb9da2152a99f134e25"
      ],
      "text": "The reduction engine is rule-driven: built-in JSON rules live in src/rules, user overrides in ~/.config/tokenjuice/rules, and project overrides in .tokenjuice/rules, with later layers overriding earlier ones by rule id."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1baf119d122b6de0611f2750b4801eb0a8641396e85f7ac74c4570636c8325f6",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "43a621ab06ef0198d728b93c93660ce5c381cb11",
          "git_sha": "ecfd367446b14c85de6e9c1eaf37d5ebf254c8e5",
          "line_end": 192,
          "line_start": 192,
          "path": "README.md",
          "repository": "vincentkoc/tokenjuice",
          "url": "https://github.com/vincentkoc/tokenjuice/blob/43a621ab06ef0198d728b93c93660ce5c381cb11/README.md#L192-L192"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_3a1f8db37d7a5007401b082d16e983a5547e7e8ba0c21fb9da2152a99f134e25"
      ],
      "text": "Host adapters apply a narrow safe-inventory policy: exact file-content reads stay raw, standalone repository inventory commands can be compacted, and unsafe mixed command sequences stay raw."
    },
    {
      "basis": "documented",
      "claim_id": "clm_798e8d56af8265e89e755d8d3222777cddce51f50f3fbfb205a6d277e166807e",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "43a621ab06ef0198d728b93c93660ce5c381cb11",
          "git_sha": "ecfd367446b14c85de6e9c1eaf37d5ebf254c8e5",
          "line_end": 201,
          "line_start": 201,
          "path": "README.md",
          "repository": "vincentkoc/tokenjuice",
          "url": "https://github.com/vincentkoc/tokenjuice/blob/43a621ab06ef0198d728b93c93660ce5c381cb11/README.md#L201-L201"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d2d91249b38d4f07888310041ca8b3e0d125f3dbc309b62f876ac2b5d1c6128a"
      ],
      "text": "Statistics use bounded metadata segments, support paging via --limit and a returned --cursor, report partial coverage, and can be disabled with TOKENJUICE_STATS=off or --no-stats; artifact retention is opt-in via --store."
    },
    {
