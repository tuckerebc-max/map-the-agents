      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2af1348ddbb7bffd530e32898a4141a5c3369e9e6a92dbcc13dd5f15a7789f8b"
      ],
      "text": "The backend exposes an OpenAPI docs page at /docs and a health check at /api/v1/health in development."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d0566ae51692f2a1218ec2fbbcf7e9b059f7894bc8fb9b23f204121dd9ea85da",
