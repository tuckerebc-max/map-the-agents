        "slc_3ba5278ed1f4f123aae1f48f0cf62ef821424d2b85ba7f30807c41c17a616f55",
        "slc_62b4874f7b3baddb5af210affbfb450d6c7d5bd6892aea08c877e67ab6552b10"
      ],
      "text": "The repo ships an installable Codex skill bundle built around a single public CLI, codekanban-cli, with the skill source at packages/codekanban-cli/skills/codekanban-cli."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f7d11faa42b6be413f538e4b2bab18401eb534542b9615e753d8e7cee18f1758",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "921b2512aeb00ca37b27a8f711ca6479c0d8b9e0",
          "git_sha": "dcc4b729d906ea935316476ec8e0fa34362e9849",
          "line_end": 68,
          "line_start": 65,
          "path": "README.md",
          "repository": "fy0/codekanban",
          "url": "https://github.com/fy0/CodeKanban/blob/921b2512aeb00ca37b27a8f711ca6479c0d8b9e0/README.md#L65-L68"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c30e206f01a979e099ef6a09e283f5efe9d2f27b0d5d9789a006dcfec81cc41e"
      ],
      "text": "codekanban-cli defaults to service URL http://127.0.0.1:3007, supports --base-url overrides, saves auth tokens via `auth save-token --password-stdin`, and stores session.json under %APPDATA% or XDG config paths."
    },
    {
      "basis": "documented",
      "claim_id": "clm_149a190fb794a5c7020cc99802cb63b967a43cc97ccd95cd8bbe6becb0fe0dc2",
      "evidence_type": "organizational_statement",
