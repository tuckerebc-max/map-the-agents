          "git_sha": "dcc4b729d906ea935316476ec8e0fa34362e9849",
          "line_end": 78,
          "line_start": 76,
          "path": "README.md",
          "repository": "fy0/codekanban",
          "url": "https://github.com/fy0/CodeKanban/blob/921b2512aeb00ca37b27a8f711ca6479c0d8b9e0/README.md#L76-L78"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c4fe5735e7b996699bf4b405c21e72284018c18f0ed1ddaec2e720e1589f39f4"
      ],
      "text": "Development requires Node.js v20.19.0+ or v22.12.0+, Go 1.25+, and pnpm 9.15.9."
    },
    {
      "basis": "documented",
      "claim_id": "clm_665a2b565d04a6d93e64ef6234871db8d20d9e5102ad264db40ece396019bf9c",
