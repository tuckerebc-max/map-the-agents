          "line_end": 113,
          "line_start": 110,
          "path": "README.md",
          "repository": "fy0/codekanban",
          "url": "https://github.com/fy0/CodeKanban/blob/921b2512aeb00ca37b27a8f711ca6479c0d8b9e0/README.md#L110-L113"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_836535da2129840b9bc03acbcfb795019098e7edd47fc8e718b83acfc2c0d4fd"
      ],
      "text": "The backend binary accepts flags: -m/--migrate to force database migration, -i/--install to install as a system service, and --uninstall."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c0f1365948313364066c9a61f92f5107f80ab83c1ac25edd46cd4006483d048b",
      "evidence_type": "organizational_statement",
