      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d67252dd423429dfd62c7ea97218e74049c01af06dab6c7e3c2c4c2d9aaa1526"
      ],
      "text": "Repository development practice: commits use imperative mood with issue references in the footer; PRs should describe changes, note config.yaml toggles, and include screenshots or cURL snippets when API responses change."
    }
