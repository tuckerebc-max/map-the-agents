      ],
      "text": "The README describes Melty as an AI code editor whose chats can be reverted, branched, reset, and squashed, with Melty staying in sync like a pair programmer."
    },
    {
      "basis": "documented",
      "claim_id": "clm_098d7ae4a8889ae5edb9793dd50f0c08220493afaf0b58fef7487694cb1d3cce",
      "evidence_type": "organizational_statement",
