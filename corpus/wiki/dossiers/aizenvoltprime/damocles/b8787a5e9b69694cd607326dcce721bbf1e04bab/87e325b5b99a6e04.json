        {
          "commit": "b8787a5e9b69694cd607326dcce721bbf1e04bab",
          "git_sha": "a2d0df4ec3162c91abb6f5b63eb46bc1cd69ee2a",
          "line_end": 18,
          "line_start": 17,
          "path": "docs/hooks.md",
