          "git_sha": "2d6eb1e37f7fe3fa03688d8a168c911e3434d57c",
          "line_end": 104,
          "line_start": 46,
          "path": "README.md",
          "repository": "aizenvoltprime/damocles",
          "url": "https://github.com/AizenvoltPrime/damocles/blob/b8787a5e9b69694cd607326dcce721bbf1e04bab/README.md#L46-L104"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_68f710d69118165e24bdeb47106573cae138f65512f280b2ab3b2291bbdb9b8b"
      ],
      "text": "Voice features require local audio hardware and are unavailable over SSH, since the extension host runs server-side where no microphone exists."
    },
