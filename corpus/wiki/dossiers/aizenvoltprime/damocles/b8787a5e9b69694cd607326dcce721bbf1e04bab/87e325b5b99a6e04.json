          "git_sha": "2d6eb1e37f7fe3fa03688d8a168c911e3434d57c",
          "line_end": 222,
          "line_start": 222,
          "path": "README.md",
          "repository": "aizenvoltprime/damocles",
          "url": "https://github.com/AizenvoltPrime/damocles/blob/b8787a5e9b69694cd607326dcce721bbf1e04bab/README.md#L222-L222"
        },
        {
          "commit": "b8787a5e9b69694cd607326dcce721bbf1e04bab",
          "git_sha": "2d6eb1e37f7fe3fa03688d8a168c911e3434d57c",
          "line_end": 193,
          "line_start": 193,
          "path": "README.md",
          "repository": "aizenvoltprime/damocles",
          "url": "https://github.com/AizenvoltPrime/damocles/blob/b8787a5e9b69694cd607326dcce721bbf1e04bab/README.md#L193-L193"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_7a9c23725ab400536f67d076c672d1efad142f78869bdc9a822870c6ef19632a",
        "slc_fd9394453387239dfb4d2b45b1dce837e9e1f43675eae62e6b998754cad51abf"
      ],
      "text": "Project-scope commands, skills, and instruction files are gated on VS Code workspace trust so an untrusted repository cannot inject prompts or hooks; user-scope assets remain unaffected."
    },
    {
      "basis": "documented",
      "claim_id": "clm_af6a86650e68ad7010a659d641dd17d6cbb5f3439a8f5a7c587dedda7b2347f7",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "b8787a5e9b69694cd607326dcce721bbf1e04bab",
          "git_sha": "2d6eb1e37f7fe3fa03688d8a168c911e3434d57c",
          "line_end": 545,
          "line_start": 543,
          "path": "README.md",
          "repository": "aizenvoltprime/damocles",
          "url": "https://github.com/AizenvoltPrime/damocles/blob/b8787a5e9b69694cd607326dcce721bbf1e04bab/README.md#L543-L545"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_afc347038600ff16d52e4e66addc10d89cef07ffccf6d3820154c15a3ec33caa"
      ],
      "text": "The architecture consists of a Node.js extension host running the pi engine, tools, and permissions; a Vue 3 + Tailwind webview chat interface; and a postMessage bridge between them."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e4ee91bbed4ab23cfac208878aa40c8cb9111274d761c5e26f0dae06987c2e26",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
