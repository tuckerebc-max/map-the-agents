        "slc_be1143bd1479b3a80527088867c8165308f645e3f1760423b012fe1918b203d2"
      ],
      "text": "The handbook is published at agents.anipotts.com, with per-agent guides for codex, claude code, and grok plus handbook sections on setup, history, and method."
    },
    {
      "basis": "documented",
      "claim_id": "clm_71b5cdaf35bb985340bb81898ab05c7fe3a6713c48be738f710b04635a0fb986",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
