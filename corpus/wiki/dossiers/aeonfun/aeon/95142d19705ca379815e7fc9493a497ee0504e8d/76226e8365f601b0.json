      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_7cd8f0339d3921b505328974abdb2601915d32e2b7869b71789d5ebac0ab0b91"
      ],
      "text": "The instance needs at least one model credential (CLAUDE_CODE_OAUTH_TOKEN, ANTHROPIC_API_KEY, or an LLM gateway key), resolved by prefix with auto-cascading."
    },
    {
      "basis": "documented",
