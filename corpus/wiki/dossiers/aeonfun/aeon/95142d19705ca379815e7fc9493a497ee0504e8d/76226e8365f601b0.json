      "slice_ids": [
        "slc_ef69c5f7a1552ec06ffbf0eb18c193937733a1aa6699facfcb02c77fe41e5d2e"
      ],
      "text": "Aeon dispatches to ten coding-agent CLIs via a run-harness contract, including Cursor, Hermes, GLM, and Vercel's fx, with credentials surfaced as dashboard Access Keys rows."
    },
    {
      "basis": "documented",
      "claim_id": "clm_9a8da15adaa4c4cf4254aec05b68ff86678c6f4557b33f58641dd211e3af2c14",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
