      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6589827965ed3041611eaf6039dc702223a97b5551d1c4f407d2e3d745b8fc71"
      ],
      "text": "Documentation states file edits follow a review-before-write flow with path and command permission checks."
    },
    {
      "basis": "documented",
