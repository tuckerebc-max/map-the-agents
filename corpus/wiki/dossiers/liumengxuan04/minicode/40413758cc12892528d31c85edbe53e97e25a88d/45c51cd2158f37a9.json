      "slice_ids": [
        "slc_6589827965ed3041611eaf6039dc702223a97b5551d1c4f407d2e3d745b8fc71"
      ],
      "text": "Documented local skills are discovered through SKILL.md files, alongside MCP tools, resources, and prompts reachable over stdio or remote HTTP."
    },
