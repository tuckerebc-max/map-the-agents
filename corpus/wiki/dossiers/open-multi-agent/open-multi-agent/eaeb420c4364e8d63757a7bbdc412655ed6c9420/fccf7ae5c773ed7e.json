          "url": "https://github.com/open-multi-agent/open-multi-agent/blob/eaeb420c4364e8d63757a7bbdc412655ed6c9420/docs/adaptive-recovery.md#L92-L95"
        },
        {
          "commit": "eaeb420c4364e8d63757a7bbdc412655ed6c9420",
          "git_sha": "412dc237f2f803ee3312cbedc459888f033565c2",
