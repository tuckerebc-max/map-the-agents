      ],
      "text": "Wolfpack is a self-hosted control room for running coding agents remotely, letting users monitor and control persistent agent terminals from a desktop or phone."
    },
    {
      "basis": "documented",
      "claim_id": "clm_902ef62c1703f863b0a8dddd1b789fdbd0162d71bd4ce77e3588973f70f59b4b",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
