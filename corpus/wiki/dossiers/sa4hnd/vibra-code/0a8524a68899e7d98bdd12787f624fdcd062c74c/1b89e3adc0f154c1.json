          "line_end": 304,
          "line_start": 297,
          "path": "README.md",
          "repository": "sa4hnd/vibra-code",
          "url": "https://github.com/sa4hnd/vibra-code/blob/0a8524a68899e7d98bdd12787f624fdcd062c74c/README.md#L297-L304"
        }
      ],
      "review_state": "mechanically_checked",
