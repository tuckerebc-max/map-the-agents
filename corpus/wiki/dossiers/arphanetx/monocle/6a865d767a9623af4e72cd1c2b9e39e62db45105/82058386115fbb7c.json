          "git_sha": "52f91fa9b98d553b981aebb77a044f45f1579d07",
          "line_end": 25,
          "line_start": 25,
          "path": "README.md",
          "repository": "arphanetx/monocle",
          "url": "https://github.com/arphanetx/Monocle/blob/6a865d767a9623af4e72cd1c2b9e39e62db45105/README.md#L25-L25"
        }
