      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_600e384accb43d9a01c20c7e86f294a081cc5fbcadce39c137bc21da5cf752b3"
      ],
      "text": "At least 16GB RAM and a dedicated Nvidia GPU with 4GB+ memory are recommended; lower-spec machines can run it but significantly slower."
    },
    {
      "basis": "documented",
      "claim_id": "clm_78c30067e7dceb7c479ebbff9c6024e17f63eb6cd17807bd119e51b40491252a",
