        "slc_492162a74b3a2ed6241f4406ec0c95e6ac9a00e829f6846a9bafee2071bba0eb"
      ],
      "text": "ReCode unifies plan and action into a single code representation, treating high-level plans as placeholder functions that recursively decompose into executable primitives."
    },
    {
      "basis": "documented",
      "claim_id": "clm_721246fc7c765c90322b6284177c63b2a4c18e25f74fac9250694bcd33ff0be1",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "6e7223f71281d914762e78d7bbcf6446d362ecbc",
          "git_sha": "8331e77673ae438477dcb84e91601d1d4b00a670",
          "line_end": 20,
          "line_start": 17,
          "path": "README.md",
          "repository": "foundationagents/recode",
          "url": "https://github.com/FoundationAgents/ReCode/blob/6e7223f71281d914762e78d7bbcf6446d362ecbc/README.md#L17-L20"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_bb91dcba95e48ad54cd12e0cf75284136cbc7ddbeec4ca0f23693fc6da22b289"
      ],
      "text": "Partial programs are organized in a tree where each node captures one sub-task and records its execution trace."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8a4871abab48bb47d8e6eef15a12b040b4a60235b39a18d3e11020d3bbbd1e26",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "6e7223f71281d914762e78d7bbcf6446d362ecbc",
          "git_sha": "8331e77673ae438477dcb84e91601d1d4b00a670",
          "line_end": 20,
          "line_start": 17,
          "path": "README.md",
          "repository": "foundationagents/recode",
          "url": "https://github.com/FoundationAgents/ReCode/blob/6e7223f71281d914762e78d7bbcf6446d362ecbc/README.md#L17-L20"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_bb91dcba95e48ad54cd12e0cf75284136cbc7ddbeec4ca0f23693fc6da22b289"
      ],
      "text": "A dynamic execution loop executes each node immediately, with fresh observations deciding whether to expand further, retry, or finish."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6eb3a3e434db03eeabec6b8c5c00994b0db0f6aff15dfba227c6dcfb732d7fab",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
