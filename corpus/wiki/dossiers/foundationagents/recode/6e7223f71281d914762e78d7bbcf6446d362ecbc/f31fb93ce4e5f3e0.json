          "git_sha": "8331e77673ae438477dcb84e91601d1d4b00a670",
          "line_end": 20,
          "line_start": 17,
          "path": "README.md",
          "repository": "foundationagents/recode",
          "url": "https://github.com/FoundationAgents/ReCode/blob/6e7223f71281d914762e78d7bbcf6446d362ecbc/README.md#L17-L20"
        }
