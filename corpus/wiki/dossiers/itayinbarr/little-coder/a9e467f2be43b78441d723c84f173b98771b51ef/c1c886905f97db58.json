      "slice_ids": [
        "slc_640d4c7fe37630757074da1496b65f05ff2fcfbb1f68903360e6c0c1b7032f30"
      ],
      "text": "Deep Research (f2 or /deep-research) fans out read-only sub-coders in an ephemeral scratch directory and returns one cited markdown report saved near the working directory."
    },
