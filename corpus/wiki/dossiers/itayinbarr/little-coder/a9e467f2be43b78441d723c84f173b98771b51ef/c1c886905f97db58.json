      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9b0079c04fc3d307fdf9cb2c4b1cc410e9d4d84e133c15677f01187307c8ebc0"
      ],
      "text": "Users can opt into extra extensions via ~/.config/little-coder/extensions/, the LITTLE_CODER_EXTRA_EXTENSIONS variable, or a --with-pi-extensions relaunch; /extensions shows what loaded."
    },
