        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_640d4c7fe37630757074da1496b65f05ff2fcfbb1f68903360e6c0c1b7032f30"
      ],
      "text": "Plan Mode (ctrl+q or --plan-mode) researches with sub-coders, asks 1-3 clarifying questions, writes a plan, and /implement starts a fresh session on the action model; Esc cancels."
    },
