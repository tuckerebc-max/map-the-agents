      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5d4d7c045591c10d15b87bbab79ff2f795a8c49a881aff953fe1ef0c7f07e528"
      ],
      "text": "The API docs state the server can be extended with additional JSON-RPC methods by editing main.rs and registering them, citing language-server-protocol integration or MCP support as example use cases."
    },
