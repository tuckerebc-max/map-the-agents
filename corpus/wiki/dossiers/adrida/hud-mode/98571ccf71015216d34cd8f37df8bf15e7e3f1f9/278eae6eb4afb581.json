      "slice_ids": [
        "slc_f326a78f61aa6172816fa0f393b646bd5fbe9050c304f14ea938f98276265c64"
      ],
      "text": "Interactive commands at the prompt include /model, /effort, /mode, /gauges, /links, /qr, /new, /danger, /id, /exit, and /hud to toggle to the engine's full TUI."
    },
