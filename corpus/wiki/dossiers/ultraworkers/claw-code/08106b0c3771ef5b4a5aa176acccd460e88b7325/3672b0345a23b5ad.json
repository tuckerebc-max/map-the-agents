      "slice_ids": [
        "slc_b8919c95ca221ad43063061f4b412eb5a5d0d7a384ecb5affdfc3e9190d3aba7"
      ],
      "text": "Permission modes include read-only, workspace-write, prompt, and danger-full-access/allow; write_file is unavailable in read-only and prompt modes, and danger modes are forbidden non-interactively without an explicit accept flag."
    },
