          "line_end": 57,
          "line_start": 57,
          "path": "concept.md",
          "repository": "ultraworkers/claw-code",
          "url": "https://github.com/ultraworkers/claw-code/blob/08106b0c3771ef5b4a5aa176acccd460e88b7325/concept.md#L57-L57"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_420f85f5e60f1c92eb6f1b400d7e9c2bafa1be489286ce52a5eba51d2f26700d"
      ],
      "text": "Heavy indexing and embedding storage are deliberately kept out of claw-analog; the agent only calls retrieval over HTTP so the vector store and embedding secrets can be scaled or changed independently."
    },
