      "slice_ids": [
        "slc_97b65b2056e008ea7682e620dfc920606949bf9808f885abb5663f218af350e1"
      ],
      "text": "Documented platform caveats: Windows uses cmd.exe as the default shell so claude must be on PATH, macOS 10.13+ is required, and Linux may need libxtst6 and libnss3 packages."
    },
