        "slc_ee0880efd7e7c83921b7ac4592b5656380ff4b7d979300a806bc12c273e65efd"
      ],
      "text": "OmniDesk is an Electron 28 desktop app using React 18 + TypeScript, xterm.js with node-pty for terminals, Tailwind CSS styling, and Vite with electron-builder for building."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e768f9ec548bf1d2bfe367603ce055fe8a7fa47538a26dd8b27cdc4f9352115e",
      "evidence_type": "organizational_statement",
      "facet": "components",
