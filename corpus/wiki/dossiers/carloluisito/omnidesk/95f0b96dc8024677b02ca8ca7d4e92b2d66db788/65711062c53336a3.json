      "slice_ids": [
        "slc_a83bb1d4d134481c72c340419b8324dfacd0866bff47f386768394b453b64a1b"
      ],
      "text": "A Session History Explorer stores past-session transcripts with cross-session content search, Markdown/JSON export, deletion, storage stats, retention policy, plus a Checkpoints panel for named session checkpoints."
    },
    {
      "basis": "documented",
      "claim_id": "clm_36f87aa766b03a2dd8e163633d39c1c766ad46882a36a0c4a77469899aa99780",
