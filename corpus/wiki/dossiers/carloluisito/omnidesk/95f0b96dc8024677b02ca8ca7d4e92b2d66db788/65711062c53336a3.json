      "slice_ids": [
        "slc_84962ac31ae082d50eb0c596e0fcaab1f156dc5b5f635fe08385a6cb1c10e48a"
      ],
      "text": "Remote access serves the same UI from a browser over a one-click managed Cloudflare tunnel, bound to 127.0.0.1 only with its own access token (cookie plus WebSocket check), off by default, with a QR sign-in and installable PWA."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8d527ad052bb3e8923dbc3c625b5c9d7795ee4eaf86d81ef2642b46ed882965a",
