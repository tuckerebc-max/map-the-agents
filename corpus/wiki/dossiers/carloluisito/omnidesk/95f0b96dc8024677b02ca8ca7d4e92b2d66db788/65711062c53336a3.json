        "slc_583cffe26b290774b39049f2f28ea7f34f67d250e2bb2044f704c00f8570a474"
      ],
      "text": "Prerequisites are Node.js 20+ and the Claude Code CLI (installed globally via npm), with Claude API credentials read from ~/.claude/.credentials.json; the Codex CLI is optional and auto-detected."
    },
    {
      "basis": "documented",
      "claim_id": "clm_de25b3c7ca452a91f22b6e293776f2caf1d3b0300f3178128bf60bfaed9f898b",
