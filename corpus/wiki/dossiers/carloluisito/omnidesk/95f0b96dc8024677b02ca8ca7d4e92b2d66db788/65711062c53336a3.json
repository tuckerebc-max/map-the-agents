      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_74408f4a6f48d69efe867ec923c60f86d2ffba837ea6f1f17edc1a89e59d6b6f"
      ],
      "text": "For Claude sessions, a per-session launch mode picker offers claude, claude --dangerously-skip-permissions, or claude agents, gated by an automatic CLI availability probe at creation time."
    },
