      "slice_ids": [
        "slc_31955b007ce88121282d78b2dc21ddaef9fbe28e0397d2b11450d87bab573b12"
      ],
      "text": "The eval bench changed-file scoring uses `git status --porcelain` against a baseline, so an agent that commits its own changes defeats the expectedChangedFiles check."
    },
