        "slc_913f405935e90279931d753f9c66e043d53a6f54fc5e6e1438da856627d55e36"
      ],
      "text": "Herdr is described as a single Rust binary with no Electron dependency, running inside the user's existing terminal."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ba62e3b07c1ec94ee50962ce29afc060a248fc218d3e5e906c14fe9f0f9bfb4d",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "aa961df943b874730b23f78baf94af7332f7acfa",
          "git_sha": "5fe58ac91a0364b5e20388114c30dd36d208b679",
          "line_end": 38,
          "line_start": 31,
          "path": "README.md",
          "repository": "herdrdev/herdr",
          "url": "https://github.com/herdrdev/herdr/blob/aa961df943b874730b23f78baf94af7332f7acfa/README.md#L31-L38"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_913f405935e90279931d753f9c66e043d53a6f54fc5e6e1438da856627d55e36"
      ],
      "text": "The product keeps terminals running in a background server so work continues after the client closes or SSH drops, and restores saved layout after server or machine restart."
    },
    {
      "basis": "documented",
      "claim_id": "clm_16b2ac86a400ecfc2abd2ad751c23e0c6067d6307ea85e230d1e6aabf09b0b65",
