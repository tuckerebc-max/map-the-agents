      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_7bdbc13f884eafb2d2881936ea20f69435845819bdfaacbb53212ad586ef05d4"
      ],
      "text": "When multiple AGENT.md files exist, tools should merge configurations with more specific files taking precedence over general ones."
    },
