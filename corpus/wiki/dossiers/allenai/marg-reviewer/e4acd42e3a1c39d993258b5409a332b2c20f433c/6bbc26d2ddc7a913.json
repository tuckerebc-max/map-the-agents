      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2cf6e92ee6bcfd143b1ca57052da15fb75002fae460fa2ebea1f3fb74d795917",
        "slc_c3715281fa1f35ee13ae0aea1da346c110f62c9dc621ac47880be2f929a0db26"
      ],
      "text": "Email notifications on review completion are handled through Amazon SES, with the outgoing address configured via OUTGOING_EMAIL in review_worker/run_reviewgen.py."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ed5cd658a9c052d71acbd49d5a3cc81761eaaa64c0d1b786a1f28551858f56f0",
