      "locators": [
        {
          "commit": "e4acd42e3a1c39d993258b5409a332b2c20f433c",
          "git_sha": "47870439fd436a37c398978394afd1204167c236",
          "line_end": 28,
          "line_start": 28,
          "path": "README.md",
          "repository": "allenai/marg-reviewer",
          "url": "https://github.com/allenai/marg-reviewer/blob/e4acd42e3a1c39d993258b5409a332b2c20f433c/README.md#L28-L28"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2ce279393beb723e71df4077430cf0623fb8be2c7dbf682e41402c344b753787"
      ],
      "text": "Alignment/metrics code for reproducing the paper's Table 2 experiments lives in review_worker/paper_align_eval_repro.py, with experiment configs and outputs under review_worker/data/paper_align_eval/."
    },
    {
      "basis": "documented",
      "claim_id": "clm_fa6ba8e7b398de003ebffb5fe8f30b81ed31beb7d4e55f5bac9bed628f8af3d2",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "e4acd42e3a1c39d993258b5409a332b2c20f433c",
          "git_sha": "47870439fd436a37c398978394afd1204167c236",
          "line_end": 34,
          "line_start": 30,
          "path": "README.md",
          "repository": "allenai/marg-reviewer",
          "url": "https://github.com/allenai/marg-reviewer/blob/e4acd42e3a1c39d993258b5409a332b2c20f433c/README.md#L30-L34"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_dee41c69de89518379ce33f540004c278ed83d57a12d33d5f514a0806b38af6f"
      ],
      "text": "Reproducing experiments requires the ARIES dataset (paper texts and human reviewer data) downloaded from a public S3 bucket, plus a provided compressed GPT request cache (gpt3_cache.sqlite.xz)."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a1eac8139e923f61c2d04ba50ac18d766ac0c850117cfe846ed9c4168f04e499",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "e4acd42e3a1c39d993258b5409a332b2c20f433c",
          "git_sha": "47870439fd436a37c398978394afd1204167c236",
          "line_end": 36,
          "line_start": 36,
          "path": "README.md",
          "repository": "allenai/marg-reviewer",
          "url": "https://github.com/allenai/marg-reviewer/blob/e4acd42e3a1c39d993258b5409a332b2c20f433c/README.md#L36-L36"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_07fbe94970e82b9640600f7d3455023787c231b0226e9a2cf8d09ef8f133c34d"
      ],
      "text": "By default the reproduction pipeline uses the cached GPT responses from the paper to ensure reproducibility; the cache can be disabled by deleting the sqlite file or editing align_config.json."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3e79cb9524a663e1123804584369004a0e795290949dd97a8bfba7e731eab4c2",
      "evidence_type": "organizational_statement",
      "facet": "workflows",
      "kind": "observation",
      "locators": [
        {
          "commit": "e4acd42e3a1c39d993258b5409a332b2c20f433c",
          "git_sha": "47870439fd436a37c398978394afd1204167c236",
          "line_end": 34,
          "line_start": 30,
          "path": "README.md",
          "repository": "allenai/marg-reviewer",
          "url": "https://github.com/allenai/marg-reviewer/blob/e4acd42e3a1c39d993258b5409a332b2c20f433c/README.md#L30-L34"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_dee41c69de89518379ce33f540004c278ed83d57a12d33d5f514a0806b38af6f"
      ],
      "text": "The documented reproduction workflow involves decompressing the GPT cache, syncing the ARIES dataset, building and entering the review_worker Docker container, and running paper_align_eval_repro.py per config directory."
    },
