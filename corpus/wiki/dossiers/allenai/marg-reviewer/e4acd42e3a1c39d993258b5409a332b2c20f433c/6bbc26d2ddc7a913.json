        "slc_2cf6e92ee6bcfd143b1ca57052da15fb75002fae460fa2ebea1f3fb74d795917"
      ],
      "text": "The demo runs as a web application on localhost port 8080, where papers can be submitted on the main page and results viewed at a /list-results page."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7590d98a2276240f8b314c203826b7ef66a0fd4ce1d63a4adc32e5597ba110af",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "e4acd42e3a1c39d993258b5409a332b2c20f433c",
          "git_sha": "47870439fd436a37c398978394afd1204167c236",
          "line_end": 21,
          "line_start": 21,
          "path": "README.md",
          "repository": "allenai/marg-reviewer",
          "url": "https://github.com/allenai/marg-reviewer/blob/e4acd42e3a1c39d993258b5409a332b2c20f433c/README.md#L21-L21"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2cf6e92ee6bcfd143b1ca57052da15fb75002fae460fa2ebea1f3fb74d795917"
      ],
      "text": "Submitted papers are reviewed by three methods: SARG-B (\"barebones\"), LiZCa (\"liang_etal\"), and MARG-S (\"multi_agent_specialized\")."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2c835b02424166d36c3e0b4d4144cd2cbdd3838ef07d3a43068858de89b78048",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "e4acd42e3a1c39d993258b5409a332b2c20f433c",
          "git_sha": "47870439fd436a37c398978394afd1204167c236",
          "line_end": 23,
          "line_start": 23,
          "path": "README.md",
          "repository": "allenai/marg-reviewer",
          "url": "https://github.com/allenai/marg-reviewer/blob/e4acd42e3a1c39d993258b5409a332b2c20f433c/README.md#L23-L23"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_066aa322822dcdfde046b046134c4db98ee6004c85b27ed826c4df63d5b2a494"
      ],
      "text": "Results are accessible via two page types: a /result/ page suited to local use, and a /survey/ page that hides method names and randomizes review order."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f30c794b517ee1802d239a08bd3ed92db84bbccb9f1576bc62862149e6e99217",
      "evidence_type": "organizational_statement",
