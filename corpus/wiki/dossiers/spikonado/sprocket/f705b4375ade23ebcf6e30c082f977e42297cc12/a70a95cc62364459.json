          "line_end": 307,
          "line_start": 306,
          "path": "ARCHITECTURE.md",
          "repository": "spikonado/sprocket",
          "url": "https://github.com/spikonado/sprocket/blob/f705b4375ade23ebcf6e30c082f977e42297cc12/ARCHITECTURE.md#L306-L307"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a240efde3f236736dcf5e1bf7be80ba083fba0c4d03f0df1c077d37bdc1e11ba"
      ],
      "text": "Workspace patches and shell commands are not sandboxed; they run with the permissions of the local Sprocket process and are confined only by the OS user."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7fb3923df2fd1b7b5ae8fa22654da66957d938d8fd53d35ec51545b4ac3ad5cc",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
