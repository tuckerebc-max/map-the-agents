          "line_end": 127,
          "line_start": 109,
          "path": "ARCHITECTURE.md",
          "repository": "spikonado/sprocket",
          "url": "https://github.com/spikonado/sprocket/blob/f705b4375ade23ebcf6e30c082f977e42297cc12/ARCHITECTURE.md#L109-L127"
        },
        {
