      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5c40a06fc142e48ad7ef3438fe7684c77349d5e9fbd49824fb1b7efa2a8a36a1",
        "slc_feb4fff700579b1cf1d11bff0ec7c4f96e7457bb18dec11b6db2ab76b5da3eb5"
      ],
      "text": "The system has three planes: a Svelte/Electron/CLI client plane, a local Rust execution plane that authenticates requests and runs tools, and a Convex cloud coordination plane with an AI gateway for completions."
    },
    {
      "basis": "documented",
      "claim_id": "clm_9fd792a930f63d154ac48393eb5a42389b2fd4925b49c959d2e4c000b006deea",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
