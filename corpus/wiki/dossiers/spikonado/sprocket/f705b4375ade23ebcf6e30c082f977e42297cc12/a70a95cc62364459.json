      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_79fc1189133dd0470bf8f473b8ee71f8a0f2e38429811051e04e10a3c84a37f5"
      ],
      "text": "Artifact tools include add_artifact, edit_artifact, list_artifacts, and save_artifact; save_artifact accepts an existing file only when its content is identical and never overwrites differing content."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7e7429d39d5824217c3c5522aecdd1ad5e1cf43414c23621966a5af0faaf5129",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
          "commit": "f705b4375ade23ebcf6e30c082f977e42297cc12",
          "git_sha": "aee79ebafbb29f15b9c66680512dbf639895ce25",
          "line_end": 178,
          "line_start": 175,
          "path": "ARCHITECTURE.md",
          "repository": "spikonado/sprocket",
          "url": "https://github.com/spikonado/sprocket/blob/f705b4375ade23ebcf6e30c082f977e42297cc12/ARCHITECTURE.md#L175-L178"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_16ea38486015d1692db5f4585bb0124f11de6e449b79cd05091cb6506b1ef686"
      ],
      "text": "Artifact-bound files must be UTF-8 text within 500,000 bytes; missing or unreadable files report an error while keeping their last readable content, and the server does not recreate missing files from the cloud copy."
    },
