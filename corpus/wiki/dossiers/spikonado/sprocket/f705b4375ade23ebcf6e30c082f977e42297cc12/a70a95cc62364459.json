          "line_end": 147,
          "line_start": 142,
          "path": "ARCHITECTURE.md",
          "repository": "spikonado/sprocket",
          "url": "https://github.com/spikonado/sprocket/blob/f705b4375ade23ebcf6e30c082f977e42297cc12/ARCHITECTURE.md#L142-L147"
        }
