      "slice_ids": [
        "slc_bad42b11af807403bffe8334941b8717be6a3d7f24ee391ba0594e58db953c2b"
      ],
      "text": "The native authentication migration is incomplete: thread-cache registration, thread commands, cancellation, lifecycle, transcript synchronization, and attachments still pass browser access tokens or user IDs to Rust."
    },
