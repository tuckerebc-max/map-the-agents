        "slc_921307a47146a85be8a563962e24361e85fa9bdfd99bea60f2d77c75b488f150"
      ],
      "text": "Agent runs use idempotent creation keyed by a submission identifier, renewable run claims that reject stale workers, durable tool-job records taken before and after execution, and cancellation propagated from durable state to local operations."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2f6e4ed21fe4740b106ff75adc7cfaf94200325c793442e6835caac4b0afa56b",
      "evidence_type": "organizational_statement",
