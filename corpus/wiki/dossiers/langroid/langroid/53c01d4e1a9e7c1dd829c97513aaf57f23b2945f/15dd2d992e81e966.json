        "slc_3deed355f0930270b81de163e5647fd616d42eb8d61242e47a0766a751aeddcd"
      ],
      "text": "Langroid requires Python 3.11+ and is installable from PyPI, with optional extras including hf-embeddings, doc-chat, db, postgres, and all (the latter increasing install size and startup time)."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4ecd45cf5e980d9619f4da4a10d9a286eb069c826ba5feb85edbf7d2726aa029",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "53c01d4e1a9e7c1dd829c97513aaf57f23b2945f",
          "git_sha": "038442b6b4ebca040309a8d7314c4c61ea8fbf35",
          "line_end": 659,
          "line_start": 626,
          "path": "README.md",
          "repository": "langroid/langroid",
          "url": "https://github.com/langroid/langroid/blob/53c01d4e1a9e7c1dd829c97513aaf57f23b2945f/README.md#L626-L659"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_261a81012f9db01fd2ce5c58697aa0974f279f69b452391379eace243bd45d46"
      ],
      "text": "Supported vector stores include Qdrant cloud, Chroma (local storage, no API key needed), LanceDB, and Milvus; Milvus defaults to local storage at ./milvus.db, and Milvus Lite is unavailable on Windows."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8e3b75c74fb8d812792a7023149e3e7b5cff8f9663d6aa8bad5c08d4e7ebd56d",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
      "locators": [
        {
          "commit": "53c01d4e1a9e7c1dd829c97513aaf57f23b2945f",
          "git_sha": "038442b6b4ebca040309a8d7314c4c61ea8fbf35",
          "line_end": 659,
          "line_start": 626,
          "path": "README.md",
          "repository": "langroid/langroid",
          "url": "https://github.com/langroid/langroid/blob/53c01d4e1a9e7c1dd829c97513aaf57f23b2945f/README.md#L626-L659"
        }
