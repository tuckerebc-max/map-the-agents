          "git_sha": "038442b6b4ebca040309a8d7314c4c61ea8fbf35",
          "line_end": 862,
          "line_start": 857,
          "path": "README.md",
          "repository": "langroid/langroid",
          "url": "https://github.com/langroid/langroid/blob/53c01d4e1a9e7c1dd829c97513aaf57f23b2945f/README.md#L857-L862"
