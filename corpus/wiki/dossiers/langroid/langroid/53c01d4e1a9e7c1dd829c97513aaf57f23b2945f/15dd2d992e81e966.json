      "slice_ids": [
        "slc_f8ce40c27b9d796c2489152de85779aa7251075daa2e62206daf3d5a1d54757e"
      ],
      "text": "Langroid includes an MCP tool adapter that converts an MCP server's tools into Langroid ToolMessage instances so any LLM agent can leverage MCP servers."
    },
