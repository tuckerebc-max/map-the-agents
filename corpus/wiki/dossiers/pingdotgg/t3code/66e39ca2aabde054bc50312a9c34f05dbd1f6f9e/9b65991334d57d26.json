        "slc_57af5d9b0ed2e8b8c99fe6e4d437be9656beb1524cab4ebd4f74c9af7d950d7b",
        "slc_c246d23635a78e7678b4b7c85f973dab6e014dfe326149b7ac534852cc0b68af"
      ],
      "text": "The project charges nothing for the product and states it aims to be performant, remote-ready, and open enough that users can fork and build their own editor."
    },
    {
      "basis": "documented",
      "claim_id": "clm_21c6581f38a29aa5ddaa97430425b0326517ea7485a8c3e357aaa150b2dc2583",
      "evidence_type": "organizational_statement",
      "facet": "workflows",
      "kind": "observation",
      "locators": [
        {
          "commit": "66e39ca2aabde054bc50312a9c34f05dbd1f6f9e",
          "git_sha": "e3b5771d797c550f206a4c27dcb75a59ae0ad540",
          "line_end": 63,
          "line_start": 61,
          "path": "AGENTS.md",
          "repository": "pingdotgg/t3code",
          "url": "https://github.com/pingdotgg/t3code/blob/66e39ca2aabde054bc50312a9c34f05dbd1f6f9e/AGENTS.md#L61-L63"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_7b3518684dea3cf05a185cf0bd8a0317002c6bb9a45d8401f568d277e5f3c1c5"
      ],
      "text": "Repository development practice: AGENTS.md forbids killing processes by name/path matching, forbids starting servers against or writing to the live ~/.t3/userdata database, and forbids setting VITE_HTTP_URL/VITE_WS_URL in dev because Vite proxies /api, /ws, /oauth, and /.well-known."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d5b2b4134a6b5dd9ec3222f3cc9fe8550bc87ad39ddf5c511a70c21578b55ab7",
      "evidence_type": "organizational_statement",
      "facet": "workflows",
      "kind": "observation",
      "locators": [
        {
          "commit": "66e39ca2aabde054bc50312a9c34f05dbd1f6f9e",
          "git_sha": "e3b5771d797c550f206a4c27dcb75a59ae0ad540",
          "line_end": 121,
          "line_start": 115,
          "path": "AGENTS.md",
          "repository": "pingdotgg/t3code",
          "url": "https://github.com/pingdotgg/t3code/blob/66e39ca2aabde054bc50312a9c34f05dbd1f6f9e/AGENTS.md#L115-L121"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c441e57cf4f11c597632b7321ada8e70688b48762636480258060c97a303a925"
      ],
      "text": "Repository development practice: agents must never open a PR unless the developer explicitly asks; PRs use conventional-commit titles, one concern per PR, before/after images for UI changes, and evidence uploaded to GitHub rather than committed."
    },
    {
      "basis": "documented",
      "claim_id": "clm_434357f4a42766d3350f3bc159773965380f148534972aebbff6fd38da314547",
      "evidence_type": "organizational_statement",
      "facet": "workflows",
      "kind": "observation",
      "locators": [
        {
          "commit": "66e39ca2aabde054bc50312a9c34f05dbd1f6f9e",
          "git_sha": "e3b5771d797c550f206a4c27dcb75a59ae0ad540",
          "line_end": 111,
          "line_start": 106,
          "path": "AGENTS.md",
          "repository": "pingdotgg/t3code",
          "url": "https://github.com/pingdotgg/t3code/blob/66e39ca2aabde054bc50312a9c34f05dbd1f6f9e/AGENTS.md#L106-L111"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_eb16954ad3d9afb25c16e5dd22f630afe48edaffdabc4732aa7e2cca6f6f2247"
      ],
      "text": "Repository development practice: verification uses targeted `vp test run` on touched files plus scoped lint/typecheck; repo-wide checks like `vp check` are reserved for CI, and tests must wait on typed receipts rather than sleeps or timeouts."
    },
    {
      "basis": "documented",
