      ],
      "text": "The repo presents a Chinese version of the CS146S course aimed at helping people get started with vibe coding, and is described as unofficial with content credited to the original course provider."
    },
    {
      "basis": "documented",
      "claim_id": "clm_96899baaa7eba154be14c8eb3cd44102ef0caebaa169e7f809d54c789d5bd8aa",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
