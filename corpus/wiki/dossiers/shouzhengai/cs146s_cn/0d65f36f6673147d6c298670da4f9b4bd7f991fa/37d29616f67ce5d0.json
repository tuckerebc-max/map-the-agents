          "git_sha": "dbdeb012ae0c8096f6c78902c673a014110e65a0",
          "line_end": 48,
          "line_start": 48,
          "path": "README.md",
          "repository": "shouzhengai/cs146s_cn",
          "url": "https://github.com/ShouZhengAI/CS146S_CN/blob/0d65f36f6673147d6c298670da4f9b4bd7f991fa/README.md#L48-L48"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_fbd00a6fc9824c19a73532be23ab5e81fcc609b25d9019bb8e5560e1447d04aa"
      ],
      "text": "Prerequisites are programming experience at roughly the CS111 level, with CS221/CS229 knowledge recommended rather than required."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f92e241ec6739f4d718c5cabfc3cc1ad13c1831462a90791fc944169c413d88d",
      "evidence_type": "organizational_statement",
