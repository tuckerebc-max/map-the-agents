        {
          "commit": "0d65f36f6673147d6c298670da4f9b4bd7f991fa",
          "git_sha": "dbdeb012ae0c8096f6c78902c673a014110e65a0",
          "line_end": 43,
          "line_start": 43,
          "path": "README.md",
          "repository": "shouzhengai/cs146s_cn",
          "url": "https://github.com/ShouZhengAI/CS146S_CN/blob/0d65f36f6673147d6c298670da4f9b4bd7f991fa/README.md#L43-L43"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5b5049e99f8fb55c6eb15e59334d30aaa40744bf0ca4ec0817aee5bd2425f1ec"
      ],
      "text": "The course covers emerging AI-native software development practices including MCP, Agent Skills, spec-driven development, loop engineering, and the software factory concept."
    },
    {
      "basis": "documented",
      "claim_id": "clm_748a89fce1c02c59adc99f021ccbe05d4d53307d1f9d19cebd5eb6c9a42c5057",
