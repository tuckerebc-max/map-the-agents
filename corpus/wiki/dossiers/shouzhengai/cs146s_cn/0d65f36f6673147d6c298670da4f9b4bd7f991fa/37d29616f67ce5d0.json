          "url": "https://github.com/ShouZhengAI/CS146S_CN/blob/0d65f36f6673147d6c298670da4f9b4bd7f991fa/README.md#L54-L54"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_f46ded2eaecc093d895ed361bbb66dc04a95790d251743ad7ea1eef05d42983d"
      ],
      "text": "Grading is specified as 50% final project, 15% weekly assignments, 5% open-source contribution, and 5% class participation."
    },
    {
      "basis": "documented",
      "claim_id": "clm_524d7aefae4f4b222d8cfef94541ba4f251110974f54bb8fe1f252fc0aa08c37",
