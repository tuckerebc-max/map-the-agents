      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_f513a3f65ad9cd46103da3fa1680999ea13243dc2d1f9db485c2ffcc52573d8d"
      ],
      "text": "The Fall 2026 schedule includes week 1 on coding agent internals (agent loops, core tools like read/write/edit/bash, system prompts) and week 2 on context engineering, RePPIT, and MCP."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1ffdca08a0af7dea53bf95cf73bd08936594f84d6628e5ffa3c10965e94598b5",
