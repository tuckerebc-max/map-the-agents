        "slc_63d449973ac23dcbfd2261b3598f416fb11251222efcd7180b55b0e18d57ff1f",
        "slc_7872fb14f9599e3aa3380710b9ebfa72b1ca9980a86755a3e02eec81766d78a9"
      ],
      "text": "OpenCursor is a VS Code extension installable from the Marketplace or as a .vsix, providing a multi-tab sidebar chat with @-mentions of files, folders, docs, commits, diffs, terminals, and rules."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5c535319a5999f7395dc6d4a6f638c05ce614dd5e58cc80d85e2ffca75a5137a",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "e94886325f765dc4f98f49b20e3b44af05a2f3d1",
          "git_sha": "e713a9ccabaebf332828df9137f06810c0d49332",
          "line_end": 54,
          "line_start": 45,
          "path": "README.md",
          "repository": "pawanosman/opencursor",
          "url": "https://github.com/PawanOsman/OpenCursor/blob/e94886325f765dc4f98f49b20e3b44af05a2f3d1/README.md#L45-L54"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_63d449973ac23dcbfd2261b3598f416fb11251222efcd7180b55b0e18d57ff1f"
      ],
      "text": "The agent ships a suite of 25 tools including read/write/edit, shell, grep/glob, semantic search, web search/fetch, notebooks, todos, subagents, and MCP."
    },
    {
      "basis": "documented",
      "claim_id": "clm_b3c684dd546ea77944b3b851c385593f71a7094889d3be76f89f62c2d86242ef",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "e94886325f765dc4f98f49b20e3b44af05a2f3d1",
          "git_sha": "e713a9ccabaebf332828df9137f06810c0d49332",
          "line_end": 54,
          "line_start": 45,
          "path": "README.md",
          "repository": "pawanosman/opencursor",
          "url": "https://github.com/PawanOsman/OpenCursor/blob/e94886325f765dc4f98f49b20e3b44af05a2f3d1/README.md#L45-L54"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_63d449973ac23dcbfd2261b3598f416fb11251222efcd7180b55b0e18d57ff1f"
      ],
      "text": "Edits get per-hunk Keep/Undo CodeLenses for inline review, and the README states this works without requiring git."
    },
    {
      "basis": "documented",
      "claim_id": "clm_26a0b7a181ead46788ab7c62b8b61b64d2c4609d2a3134aebce2fef5e884f38c",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
          "commit": "e94886325f765dc4f98f49b20e3b44af05a2f3d1",
          "git_sha": "e713a9ccabaebf332828df9137f06810c0d49332",
          "line_end": 54,
          "line_start": 45,
          "path": "README.md",
          "repository": "pawanosman/opencursor",
          "url": "https://github.com/PawanOsman/OpenCursor/blob/e94886325f765dc4f98f49b20e3b44af05a2f3d1/README.md#L45-L54"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_63d449973ac23dcbfd2261b3598f416fb11251222efcd7180b55b0e18d57ff1f"
      ],
      "text": "A per-action approval policy supports allow/ask/review/deny with risk heuristics (e.g. rm -rf, sudo, .env, secrets) and wildcard allow/deny lists."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6e95d34490d42431b652fc70f354c78150ae10e5b832468d95fdfefeb1bd9aeb",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "e94886325f765dc4f98f49b20e3b44af05a2f3d1",
          "git_sha": "e713a9ccabaebf332828df9137f06810c0d49332",
          "line_end": 65,
          "line_start": 65,
          "path": "README.md",
          "repository": "pawanosman/opencursor",
          "url": "https://github.com/PawanOsman/OpenCursor/blob/e94886325f765dc4f98f49b20e3b44af05a2f3d1/README.md#L65-L65"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_8a90f67625ae8b9a4d87da477496371ddc6481f747df1d93cf40caa053f39102"
      ],
      "text": "Heavy native runtime dependencies such as ONNX runtime and image processing are downloaded on first activation with integrity checks rather than shipped in the VSIX."
    },
    {
      "basis": "documented",
      "claim_id": "clm_54fc169ee2e371772e284ade7e9ac5bd5f9ef57b1be69a80d7eb267128291f1a",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "e94886325f765dc4f98f49b20e3b44af05a2f3d1",
          "git_sha": "e713a9ccabaebf332828df9137f06810c0d49332",
          "line_end": 26,
          "line_start": 23,
          "path": "README.md",
          "repository": "pawanosman/opencursor",
          "url": "https://github.com/PawanOsman/OpenCursor/blob/e94886325f765dc4f98f49b20e3b44af05a2f3d1/README.md#L23-L26"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_da74e40089579bdbd3cc806c9674442d6e70497d7cbcd5ef175c0b7d71dbf4bf"
      ],
      "text": "Local AI support includes built-in llama.cpp management (spawning llama-server with control over context size, GPU layers, flash attention, etc.) and zero-config Ollama integration."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c925998b6f15efe5ad7b675f697a318f7f62a86746b5d1c771a0b5b06e7bab57",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
