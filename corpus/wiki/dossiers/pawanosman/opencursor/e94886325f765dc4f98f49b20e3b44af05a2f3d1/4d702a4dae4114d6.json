      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_66fe7d6f9ca77a11ea6b7084b3dc81564525fcec9dd82e94e8c430729644e311",
        "slc_b24a909cfb2e6ea36b117baa4a8852a6cf740a96bfd966ced176654cee2b0330"
      ],
      "text": "Project mode lets the agent act as a project lead delegating to a team of subagents (TeamDef presets), with subagents running on isolated history so the parent only receives the final Task result."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ef6bc5e03dbaf197aa74ba4e3ec924b5254b884add5de1b693bd6e815e26b825",
