      "kind": "observation",
      "locators": [
        {
          "commit": "e94886325f765dc4f98f49b20e3b44af05a2f3d1",
          "git_sha": "bab51badd601dcbdf61164a1a39e681f60396e2e",
          "line_end": 262,
          "line_start": 257,
          "path": "CHANGELOG.md",
          "repository": "pawanosman/opencursor",
          "url": "https://github.com/PawanOsman/OpenCursor/blob/e94886325f765dc4f98f49b20e3b44af05a2f3d1/CHANGELOG.md#L257-L262"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_a9ff1916060955d3c151739f1dd5b16e00f036588ebeeb2762e001c6560b44ec"
      ],
      "text": "The semantic index persists across VS Code restarts, re-indexes incrementally on changed files, and auto-indexes new/modified files via a workspace file watcher; indexing can be fully disabled in settings."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8a09a8bd0ed738df9e74ee1516d0cfc4a8cd5626da635d01bc633af9d8a76def",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
      "locators": [
        {
          "commit": "e94886325f765dc4f98f49b20e3b44af05a2f3d1",
          "git_sha": "bab51badd601dcbdf61164a1a39e681f60396e2e",
          "line_end": 170,
          "line_start": 164,
          "path": "CHANGELOG.md",
          "repository": "pawanosman/opencursor",
          "url": "https://github.com/PawanOsman/OpenCursor/blob/e94886325f765dc4f98f49b20e3b44af05a2f3d1/CHANGELOG.md#L164-L170"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_e484d18d51f34e124221e4af92639f7db8d3c20817fda20580da74c88b7d69de"
      ],
      "text": "Context management includes auto-compaction with a verbatim tail, lossless persisted chat history for export, and latest-wins deduplication of older tool results for the same target."
    },
