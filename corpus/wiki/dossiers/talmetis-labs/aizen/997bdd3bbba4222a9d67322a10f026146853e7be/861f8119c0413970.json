      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6a253d2ae6102b8ac20888f7a84097ca6301d3001e7705de79ebaf118657c10f",
        "slc_a1305c377284c41913d788e25c101908e077b776f79fd5f46b192c5bed605fcf"
      ],
      "text": "v0.6.1 consolidated tools: multi_edit merged into file_edit (edits[] for atomic multi-edit), and four checkpoint tools collapsed into checkpoint (save/rewind/restore) and read-only checkpoint_view (diff/list)."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8e621931587e82991be770db96578a73805046d928f621a3aa1aca5ce56e4ee7",
      "evidence_type": "organizational_statement",
