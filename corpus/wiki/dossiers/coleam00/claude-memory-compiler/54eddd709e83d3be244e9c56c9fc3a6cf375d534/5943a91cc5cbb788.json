        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_773af6bbb3c42e30f4a42fc870be246e6171d147f673b911f9fc0a47c7b8016d",
        "slc_f3a0e3980341a91015c3e3c26ec99e2dc790787cda9b017fdbdb3b0ab15a9a22"
      ],
      "text": "Retrieval deliberately avoids RAG: no vector database or embeddings, just a markdown index file, on the rationale that at 50-500 articles an LLM reading a structured index outperforms cosine similarity."
    },
    {
