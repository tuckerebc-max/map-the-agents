        "slc_d301f5bcf5f4d325605f46c6beba4e1087c0607a0c0729d2c448f9f1521bd0d2"
      ],
      "text": "Agent loops arrange into a tree of git worktrees: a node iterates toward a goal and spawns child nodes for separable subtasks, so the tree grows to fit the problem rather than following a fixed plan."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7353749749fe72459707aca87dcf12fcf1bb6fd4852ceb9398ad26fc5fe2b76f",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
