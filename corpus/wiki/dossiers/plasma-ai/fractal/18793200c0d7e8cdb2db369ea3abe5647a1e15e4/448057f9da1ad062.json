          "commit": "18793200c0d7e8cdb2db369ea3abe5647a1e15e4",
          "git_sha": "9e0fdbfc3b5c10c5f667bb794ed877b734629904",
          "line_end": 19,
          "line_start": 13,
          "path": "README.md",
          "repository": "plasma-ai/fractal",
          "url": "https://github.com/plasma-ai/fractal/blob/18793200c0d7e8cdb2db369ea3abe5647a1e15e4/README.md#L13-L19"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_2eb357e709185f6936ab61f3fb90c1589bb4bd4d636a58a1be1651a92083c71d"
      ],
      "text": "Each loop is bounded by hard caps on iterations, depth, children, cost, and time, and an operator can steer or stop it at any point."
    },
