      "kind": "observation",
      "locators": [
        {
          "commit": "d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921",
          "git_sha": "ebb66637405091bec69b2fc66ec1aae4d20c1dfd",
          "line_end": 109,
          "line_start": 90,
          "path": "README.md",
          "repository": "exqqstar/exagent",
          "url": "https://github.com/exqqstar/ExAgent/blob/d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921/README.md#L90-L109"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_dbca4e0c38837cfe77e78193dd339f660b909be619fe8291b2d2f5715ef3e274"
      ],
      "text": "The model layer normalizes provider-specific APIs into internal conversation, tool-call, multimodal, reasoning, and streaming types."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2fa82defceb6b657527159a20818cff13f31664cc44bc90f22bb675ac4b9c273",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921",
          "git_sha": "ebb66637405091bec69b2fc66ec1aae4d20c1dfd",
          "line_end": 88,
          "line_start": 86,
          "path": "README.md",
          "repository": "exqqstar/exagent",
          "url": "https://github.com/exqqstar/ExAgent/blob/d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921/README.md#L86-L88"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_43eac45dbf327412d7e062947d3f676cd58a649e82d044c8535f0756d7a3a6c9"
      ],
      "text": "A typed app-server boundary exposes the local Rust runtime to the desktop; the Tauri shell stays project-aware while the runtime owns thread execution, model calls, tools, state, and live events."
    },
