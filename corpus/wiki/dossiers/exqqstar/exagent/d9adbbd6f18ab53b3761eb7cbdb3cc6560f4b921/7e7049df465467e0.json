        "slc_b1f472fdb96967080b004f6392006d36a2a3bba7e47ecf8a0d3ee52b872eabdf"
      ],
      "text": "ExAgent is a desktop-first agent workbench with a Rust runtime and Tauri/React GUI, aimed at long-running coding work in local projects with resumable sessions."
    },
    {
      "basis": "documented",
      "claim_id": "clm_73b8abcfc4bcace2d4eef3909a6d42d70d53bdc8084b051ed31836579b0f9edd",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921",
          "git_sha": "ebb66637405091bec69b2fc66ec1aae4d20c1dfd",
          "line_end": 109,
          "line_start": 90,
          "path": "README.md",
          "repository": "exqqstar/exagent",
          "url": "https://github.com/exqqstar/ExAgent/blob/d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921/README.md#L90-L109"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_dbca4e0c38837cfe77e78193dd339f660b909be619fe8291b2d2f5715ef3e274"
      ],
      "text": "Each thread runs behind an actor-backed ThreadRuntime that serializes turns while streaming snapshots, status, and events back to the GUI."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8db05fe039abe8bf3c7748d54d0cfe1ce3968ddbd79a8bc21fddc178bee1bb3f",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
      "locators": [
        {
          "commit": "d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921",
          "git_sha": "ebb66637405091bec69b2fc66ec1aae4d20c1dfd",
          "line_end": 109,
          "line_start": 90,
          "path": "README.md",
          "repository": "exqqstar/exagent",
          "url": "https://github.com/exqqstar/ExAgent/blob/d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921/README.md#L90-L109"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_dbca4e0c38837cfe77e78193dd339f660b909be619fe8291b2d2f5715ef3e274"
      ],
      "text": "Local durability is append-first: each thread has a rollout.jsonl ledger, and IndexDb stores cross-thread indexes for projects, threads, goals, memory, and review state."
    },
    {
      "basis": "documented",
      "claim_id": "clm_60f4b8e396cf16f26efef8bca8e617537b02d7e8120fe96379715a395f23400b",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
