        {
          "commit": "d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921",
          "git_sha": "ebb66637405091bec69b2fc66ec1aae4d20c1dfd",
          "line_end": 109,
          "line_start": 90,
          "path": "README.md",
          "repository": "exqqstar/exagent",
          "url": "https://github.com/exqqstar/ExAgent/blob/d9adbbd6f18ab53b3761eb7cbdb3cc6560f4b921/README.md#L90-L109"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_dbca4e0c38837cfe77e78193dd339f660b909be619fe8291b2d2f5715ef3e274"
      ],
      "text": "Agent policy gates both tool visibility and execution; tool contracts live in src/tools while per-turn orchestration lives in src/runtime/tool."
    },
    {
      "basis": "documented",
      "claim_id": "clm_c591f429ce11725d0ecf9d96667a542347a3cbe8ff03f98460dea8b492012332",
