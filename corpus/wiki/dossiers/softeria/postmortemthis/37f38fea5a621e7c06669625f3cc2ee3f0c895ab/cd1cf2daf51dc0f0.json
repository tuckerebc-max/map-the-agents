          "git_sha": "3c2b2b8a537d564eb3dbf343c2f822d4e41bfd5a",
          "line_end": 20,
          "line_start": 17,
          "path": "README.md",
          "repository": "softeria/postmortemthis",
          "url": "https://github.com/Softeria/postmortemthis/blob/37f38fea5a621e7c06669625f3cc2ee3f0c895ab/README.md#L17-L20"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c69a7c6801cff14dc6c01a697535fdc475fd1a254a35f97c0189b2a4c3f53093",
        "slc_d4cc99feba8f2726c0a950c59ea2d80e3c2f98e317e0ca56d2e7d2792a0b6490"
      ],
      "text": "Installation is prompt-driven: the user pastes a prompt that makes their coding agent create a /postmortemthis skill, downloading the .cmd script once into the skill folder; the repo's SKILL.md is described as a starting point."
    },
    {
      "basis": "documented",
      "claim_id": "clm_3551f3e984d483d060a6f5956da13eab791355a510486b5a1ab0e5dbb37d6e6e",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
