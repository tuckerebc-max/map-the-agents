          "line_end": 86,
          "line_start": 83,
          "path": "README.md",
          "repository": "podiom/podiom",
          "url": "https://github.com/Podiom/Podiom/blob/78025f74007775e4e161ab5632ee6a19f616fbc1/README.md#L83-L86"
