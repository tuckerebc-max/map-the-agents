          "git_sha": "84cb3dc6019aee0f91d74e444aada34afe3eed71",
          "line_end": 65,
          "line_start": 61,
          "path": "README.md",
          "repository": "podiom/podiom",
          "url": "https://github.com/Podiom/Podiom/blob/78025f74007775e4e161ab5632ee6a19f616fbc1/README.md#L61-L65"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9f30ca25a3352a7c02bccca7c3bbf65ee12bd113d6334c4a814a427ffb771a75"
      ],
      "text": "Goals run deliberately autonomously: the lead agent and linked tasks or schedules run with full access and no per-action approval prompts, while tool activity is recorded on the goal timeline."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5e8e3a9635acf947cdc2955879fa04f99cb272a4b432ede53b7e636e4efa1d5c",
