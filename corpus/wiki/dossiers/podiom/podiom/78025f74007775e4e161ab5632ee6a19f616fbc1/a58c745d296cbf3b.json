      "slice_ids": [
        "slc_aa7f0facd33fa55411b5305dd002646950b2ff24ad9d166bd4cd240f9f55dd61"
      ],
      "text": "Podiom stores a canonical history for every session and can replay that history onto a fresh backing CLI session when the provider or profile changes."
    },
