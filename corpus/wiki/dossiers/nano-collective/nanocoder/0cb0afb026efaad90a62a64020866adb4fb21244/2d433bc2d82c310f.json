        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c8986a7b8270355a9339fdeacb707c25e55aa19c104a47a048c366c646ac09c1"
      ],
      "text": "Two rendering modes exist: a fullscreen alternate-screen layout with in-app scrolling (default, with a --mouse toggle) and an inline mode via --no-alt-screen or an \"alternateScreen\": false preference that prints into the terminal's native scrollback."
    },
    {
      "basis": "documented",
      "claim_id": "clm_97479ad2a9c88ee3de0902260f1a81ed1753c63e9308e3d10d2b43133089d323",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
