        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_8f7afe8114ec558caa5fe0360384e2bf91ed1f05d9309faeb3da73cc85e5e5c1"
      ],
      "text": "A starting development mode can be selected at launch via --mode; documented examples include yolo and plan modes."
    },
    {
      "basis": "documented",
      "claim_id": "clm_531f376dbad83d0cc191fdb0cecddc3f0eaf0505704832b1ac1578f717ef87d3",
