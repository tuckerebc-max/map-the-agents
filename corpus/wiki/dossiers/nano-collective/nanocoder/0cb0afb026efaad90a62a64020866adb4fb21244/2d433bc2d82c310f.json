          "git_sha": "a52159b255a1df895badfba3e113df3e4b8d2b70",
          "line_end": 209,
          "line_start": 209,
          "path": "docs/battlemap.md",
          "repository": "nano-collective/nanocoder",
          "url": "https://github.com/Nano-Collective/nanocoder/blob/0cb0afb026efaad90a62a64020866adb4fb21244/docs/battlemap.md#L209-L209"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ba1ee25989531a65f1258e4a82f7bce3061695b72ce38ed3013ca03020dff810"
      ],
      "text": "Nanocoder can run as an Agent Client Protocol agent via 'nanocoder --acp', exposing conversation, tool-calling, and permission flows to ACP-compatible editors such as Zed."
    },
    {
      "basis": "documented",
      "claim_id": "clm_873b896b0447d5efebc617f6830390d175fce36af2e3cea7443697f22e23b3fc",
      "evidence_type": "organizational_statement",
