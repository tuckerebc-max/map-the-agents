        "slc_eef79f066494a5b9abb5b30cbf132aa02287ca704c55c24cda063985671d59c4"
      ],
      "text": "LocoTrainer-4B is described as a 4B-parameter MS-SWIFT domain expert agent distilled from Qwen3-Coder-Next, combining tool-calling with framework knowledge."
    },
    {
      "basis": "documented",
      "claim_id": "clm_064e83b2c3099b75e6e1a1b6b4cc23fbb12d3a5712cee1df7f2f28ef11c5b4f5",
      "evidence_type": "organizational_statement",
      "facet": "specifications",
      "kind": "observation",
