          "line_end": 333,
          "line_start": 326,
          "path": "README.md",
          "repository": "razzant/claudexor",
          "url": "https://github.com/razzant/claudexor/blob/87f08d28cf3366a27e099e05d489cf4631255c65/README.md#L326-L333"
