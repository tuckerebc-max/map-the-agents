        "slc_5be8e0e40fb4dad2e094eaeaf4ad8503b51883f97bcec0951fb67d41e45f2982"
      ],
      "text": "The system integrates seven coding clients with one local Backend, a capability-oriented modular monolith, surrounded by six client deployment adapters, a shared runtime source layer, and an npm assembly/CLI layer."
    },
    {
      "basis": "documented",
      "claim_id": "clm_74376d914b1cfd1da92279991a398dc08c40b9d10f10db9e750b238ffd11797c",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "1525c20fbcad8c688bfaf4bb54dc117876fd6a09",
          "git_sha": "f2d258bfca7cfe58a13e1dfef8bec6160781bac4",
          "line_end": 138,
          "line_start": 126,
          "path": "ARCHITECTURE.md",
          "repository": "memorax-ai/memorax-code",
          "url": "https://github.com/memorax-ai/memorax-code/blob/1525c20fbcad8c688bfaf4bb54dc117876fd6a09/ARCHITECTURE.md#L126-L138"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_cef46135aedd93bc0d236be6c5dfeb7e118f2debdd8df01078fbb2cd6d6f5aa3"
      ],
      "text": "The Backend owns the local memory service, repository scope, trace, lifecycle, and update scheduling, but must not own model execution, provider credentials, or native transcript creation."
    },
    {
      "basis": "documented",
      "claim_id": "clm_eaebe6aacefec997e47210a9018d2960f8b36aaeb3825a557027bbd36a4e9512",
      "evidence_type": "organizational_statement",
      "facet": "components",
