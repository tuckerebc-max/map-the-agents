      "slice_ids": [
        "slc_054433d81306f9e4994532b14f9e9c680ed2605a4f33963572a405f9929a660d"
      ],
      "text": "Automatic Search on turn-start Hooks is disabled by default; the usual retrieval path is the client invoking memorax-cli through the shared Skill, while Hooks still provide identity, scope, and writeback coordination."
    },
