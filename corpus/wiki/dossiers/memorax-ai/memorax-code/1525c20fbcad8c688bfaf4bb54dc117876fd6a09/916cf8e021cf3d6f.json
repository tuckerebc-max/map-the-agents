          "git_sha": "f2d258bfca7cfe58a13e1dfef8bec6160781bac4",
          "line_end": 387,
          "line_start": 383,
          "path": "ARCHITECTURE.md",
          "repository": "memorax-ai/memorax-code",
          "url": "https://github.com/memorax-ai/memorax-code/blob/1525c20fbcad8c688bfaf4bb54dc117876fd6a09/ARCHITECTURE.md#L383-L387"
