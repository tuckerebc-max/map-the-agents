      "slice_ids": [
        "slc_a6edc68a349ed51fc4b575d84d88c4fb0e2db4bb44e68a84a4d5271a65d5c361"
      ],
      "text": "Local trace capture is on by default for supported clients and retained traces under MEMORAX_CODE_HOME may include prompts, responses, recalled memory, reminder text, and local paths; it can be switched to metadata-only or disabled."
    },
    {
      "basis": "documented",
