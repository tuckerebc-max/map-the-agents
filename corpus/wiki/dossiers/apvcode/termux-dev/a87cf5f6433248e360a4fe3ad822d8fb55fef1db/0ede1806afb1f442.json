        "slc_36512440500fb476e9c9d3277e55739f04e94fdbd76547d310d080a01758b203"
      ],
      "text": "Sessions are saved and can be listed, resumed, or deleted via /resume, /session, and /session del; /resume reportedly renders the last 20 messages of a session."
    },
    {
      "basis": "documented",
      "claim_id": "clm_6ffbb6989f089444878c56ade2c873136f3a49e47dd1853771f56eae738f3aa3",
      "evidence_type": "organizational_statement",
