      "slice_ids": [
        "slc_5069a384b15f4d2c08980e11be100e67cccb0a74ddb7785baad633b46529bfb6"
      ],
      "text": "Generated components run in an iframe jail with connect-src 'none', escalating to a sandboxed server only when needed."
    },
