      "slice_ids": [
        "slc_e5b3d85c944451e094e4f18b562148962b986c1fc09b5deddaea2c149a9bceb6"
      ],
      "text": "Default role chains differ by role: orchestrator and review prefer Claude first, implementation prefers Codex first, and uidocs prefers Gemini first."
    },
    {
