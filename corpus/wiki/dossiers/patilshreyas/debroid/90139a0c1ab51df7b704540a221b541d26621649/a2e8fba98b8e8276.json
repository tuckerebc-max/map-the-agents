      "slice_ids": [
        "slc_2096ee8e159f7d03805d9e4b3a816007524e0936a1276870af3a8600f9439c4f",
        "slc_3cfe0bdebee0b43ba4342268ce2e1c054ee37cb7b93e4b64f2e9ff87f536d586",
        "slc_bb4965b0fcd61ddb68789043e18be18276236a987f1932186313a5fabec46c19",
        "slc_f39e8ec7418f964386901ef599e06f95775c3257e3778b337a42e564076a7f4e"
      ],
      "text": "The CLI auto-extracts AI skill instructions to ~/.debroid/skills/debroid-cli/SKILL.md on first run, and the README documents symlink setup for agents like Claude Code, Cursor, Codex, and OpenCode."
    },
    {
      "basis": "documented",
      "claim_id": "clm_156b4340fb2c227cf29b9282859dd38d5d47228a26ea6ffc925cbbac29893b9d",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "90139a0c1ab51df7b704540a221b541d26621649",
          "git_sha": "035cb7030351e3caa61e8d1a71a436034648b79a",
          "line_end": 174,
          "line_start": 172,
          "path": "README.md",
          "repository": "patilshreyas/debroid",
          "url": "https://github.com/PatilShreyas/debroid/blob/90139a0c1ab51df7b704540a221b541d26621649/README.md#L172-L174"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_38bfb2e5249ad76153de5812340cb591a54a566f27f95568dbbf173eca9b2785"
      ],
      "text": "The daemon listens on localhost (127.0.0.1) without authentication for fast CLI communication, and the README warns it exposes live JVM manipulation and should only run on fully trusted machines."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ae844949d4760acabc8446dea9a2ebbfe3ba00ad105fe17e54f523adfda2f927",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "90139a0c1ab51df7b704540a221b541d26621649",
          "git_sha": "035cb7030351e3caa61e8d1a71a436034648b79a",
          "line_end": 41,
          "line_start": 40,
          "path": "README.md",
          "repository": "patilshreyas/debroid",
          "url": "https://github.com/PatilShreyas/debroid/blob/90139a0c1ab51df7b704540a221b541d26621649/README.md#L40-L41"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ba1bd3ddc4cdc91d1dabe804f496c31e719a717289c7c918b89d7907997aa6b7"
      ],
      "text": "Prerequisites are Java JDK 11+ with JAVA_HOME set, plus Android SDK and adb on the PATH."
    },
    {
      "basis": "documented",
      "claim_id": "clm_750def0d7eee7e9b09a4a97abeef2f2436d351a9d363b8099045acfa4aa2ee49",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
