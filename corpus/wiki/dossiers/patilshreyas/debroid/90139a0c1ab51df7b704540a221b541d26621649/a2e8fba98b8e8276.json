        {
          "commit": "90139a0c1ab51df7b704540a221b541d26621649",
          "git_sha": "035cb7030351e3caa61e8d1a71a436034648b79a",
          "line_end": 29,
          "line_start": 22,
          "path": "README.md",
          "repository": "patilshreyas/debroid",
          "url": "https://github.com/PatilShreyas/debroid/blob/90139a0c1ab51df7b704540a221b541d26621649/README.md#L22-L29"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_7da3cadda72cb342af0181605b7ef75fbc416c5155d60233148a7ac52e4aa625"
      ],
      "text": "Features include recursive deep object inspection with cycle-guards, live variable mutation via set-var, expression evaluation in the target VM, and extraction of shallow locals from Kotlin Continuation frames."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4bfee066c64a4b4e972506915a446bb831af56b8f2b1ff50d0676011568ec1e3",
      "evidence_type": "organizational_statement",
      "facet": "memory-state",
      "kind": "observation",
      "locators": [
        {
          "commit": "90139a0c1ab51df7b704540a221b541d26621649",
          "git_sha": "64c6c2f3ca9e483ec29a868891a61fe112f886a1",
          "line_end": 22,
          "line_start": 19,
          "path": "CHANGELOG.md",
          "repository": "patilshreyas/debroid",
          "url": "https://github.com/PatilShreyas/debroid/blob/90139a0c1ab51df7b704540a221b541d26621649/CHANGELOG.md#L19-L22"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6e48a63b618fe0a8009ef9bf2364cbfff4b343b8f1e3b2b5da96003bea7d121b"
      ],
      "text": "The in-memory event buffer was increased to 10,000 events, and poll output includes droppedEventsSinceLastPoll to signal unnotified event loss under high volume."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5d3c9cb689405016814fcce7f9d94382c350e36570d0ca03bbbcf872ae255fc6",
      "evidence_type": "organizational_statement",
