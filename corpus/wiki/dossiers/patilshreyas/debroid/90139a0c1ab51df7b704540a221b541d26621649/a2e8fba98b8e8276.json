      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_3124ad458fab02678963cd90a7ed2008834aa1674e42b7644a27229688bb4687"
      ],
      "text": "JSON serialization omits null fields (explicitNulls = false) to shrink payloads and save context tokens for AI agents."
    },
