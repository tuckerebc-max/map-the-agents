        "slc_878ad1f4e1e32fd8f63a8653fa42fb756491ed0230f2e169ab1f7bac99e544fe"
      ],
      "text": "Agon exposes four Claude Code slash commands: /idea-tick, /proposal-tick, /experiment-tick, and /deep-lit-tick, which advance the research pipeline stages."
    },
    {
      "basis": "documented",
      "claim_id": "clm_fec97295778d9ab6dbc636a12ef3af5c2db8c9b5c8eac8f3f483472fea66d914",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
