      "slice_ids": [
        "slc_a72d2901d4af01bce8da7aff98952e60260dd9cb21d310c373558176796e063e"
      ],
      "text": "The project is a beta preview with expected breaking changes and incomplete functionality, and supports macOS and Linux only, with WSL suggested on Windows."
    },
