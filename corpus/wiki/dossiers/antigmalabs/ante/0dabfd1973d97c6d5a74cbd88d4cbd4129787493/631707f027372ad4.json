        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_801859998688e85854e3ada7309ea3d008fba733a21f23180bb7ff9edbdb9d34"
      ],
      "text": "The `crates/protocol-shape` crate defines the schema and wire messages spoken by `ante serve`, and `crates/ante-sdk` is a Rust SDK/client for building against agent runtimes."
    },
