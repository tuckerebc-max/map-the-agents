      ],
      "text": "The product is a multi-agent platform for creating, customizing, and sharing AI agents across an organization, built on Amazon Bedrock AgentCore."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5986ecd89c16493d8bc68bb0c106e42de1443bb90f505dfc01611c80dacc020c",
