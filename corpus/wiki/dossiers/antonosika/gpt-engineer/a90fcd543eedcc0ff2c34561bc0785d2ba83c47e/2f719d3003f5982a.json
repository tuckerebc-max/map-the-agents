      ],
      "text": "Users run the `gpte` CLI against a project directory containing an extension-less `prompt` file with natural-language instructions, e.g. `gpte projects/my-new-project`."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8859ccaa32842be75d6a1ef25c537b346822d1fa8949e105c027776d2330b3c7",
