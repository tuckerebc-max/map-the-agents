      "slice_ids": [
        "slc_0aa762dc9bd5dc511f205a792cb031ceb009808176c8382283b4bfb5ee9931a8",
        "slc_b7cae0bbb6fbe9a322f694b499c64b4d1e0511eb4164c590a6348d395b01b126"
      ],
      "text": "Unsupported ACP methods return JSON-RPC -32601 with reason=capability_not_supported; the ACP adapter is additive, leaving --mode rpc unchanged, and unsupported features fail with capability-level rejections rather than crashes."
    },
    {
