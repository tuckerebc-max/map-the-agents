        "slc_7e16a904f28cf58cb2bf88bd160f108dc974e4a353db858c2c55ef2e3422b021",
        "slc_95adec33aea2521c73e1e003c6cfee46ad15a75dbd8808bf432987c79e49a5da"
      ],
      "text": "A README dependency table lists bundled packages including @earendil-works/pi-coding-agent 0.85.1, @actions/core 3.0.1, @actions/github 9.1.1, Octokit packages, simple-git 3.36.0, and typebox 1.3.6; the table is auto-updated by a workflow."
    },
    {
      "basis": "documented",
      "claim_id": "clm_fc800a4e3f127501541213d77e3b301629f9165b6a3c42fbad6a8aa0fbbdcb0e",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
        {
          "commit": "d90187d4bc85ea7c5f8e693575fc817d7447d7c8",
          "git_sha": "c6aa38f6f251035df2f6fd22ecdfa35fa70f1492",
          "line_end": 567,
          "line_start": 566,
          "path": "README.md",
          "repository": "shaftoe/pi-coding-agent-action",
          "url": "https://github.com/shaftoe/pi-coding-agent-action/blob/d90187d4bc85ea7c5f8e693575fc817d7447d7c8/README.md#L566-L567"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_916aa69a19b7c8ca76b1c397ec5da35bb12034c8ceaa2afccb3418ebfb8470a3"
      ],
      "text": "The AWS Bedrock provider and its @aws-sdk/client-bedrock-runtime dependency are bundled into dist/index.js and statically registered at startup, adding roughly 500 KB to the action bundle."
    },
    {
      "basis": "documented",
      "claim_id": "clm_8d2c3d974136cb1e615832831f9942a70a3375da3471d23fad251d57febc4402",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
          "commit": "d90187d4bc85ea7c5f8e693575fc817d7447d7c8",
          "git_sha": "c6aa38f6f251035df2f6fd22ecdfa35fa70f1492",
          "line_end": 49,
          "line_start": 48,
          "path": "README.md",
          "repository": "shaftoe/pi-coding-agent-action",
          "url": "https://github.com/shaftoe/pi-coding-agent-action/blob/d90187d4bc85ea7c5f8e693575fc817d7447d7c8/README.md#L48-L49"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_982f1e635c0afd5136cde6a42e8da9a693e16e5a877586ac0670a87fc93e8ed4"
      ],
      "text": "GitHub's GITHUB_TOKEN can never create or modify files under .github/workflows/ even with contents: write; PRs touching workflow files require a personal access token with the workflow scope."
    },
    {
      "basis": "documented",
      "claim_id": "clm_db19fdfad3373e12209584316d20cc5b0beec70db314d14fd25d780f85d04c44",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
          "commit": "d90187d4bc85ea7c5f8e693575fc817d7447d7c8",
          "git_sha": "c6aa38f6f251035df2f6fd22ecdfa35fa70f1492",
          "line_end": 756,
          "line_start": 755,
          "path": "README.md",
          "repository": "shaftoe/pi-coding-agent-action",
          "url": "https://github.com/shaftoe/pi-coding-agent-action/blob/d90187d4bc85ea7c5f8e693575fc817d7447d7c8/README.md#L755-L756"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_be0dcc61d6101c4e22f5bf01c103243d04fe449110a524171b74fb062f375b31"
      ],
      "text": "Shared secret gists are URL-obscured rather than access-controlled, so anyone with the link can read the rendered session, which may include code or secrets the agent touched."
    }
