      "slice_ids": [
        "slc_018e0c82c93b53244fe6750165b6bc6d8f4b01024b45b515951144b195d5073b"
      ],
      "text": "Because CI has no interactive user to approve trust, the action always marks the workspace as trusted (projectTrusted: true), so repository files like AGENTS.md, .pi settings, and project extensions are loaded and followed by the agent."
    },
