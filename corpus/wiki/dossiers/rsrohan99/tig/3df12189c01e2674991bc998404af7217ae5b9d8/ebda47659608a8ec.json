      "slice_ids": [
        "slc_e80f36a43ce47c6a48975e4ea24873ba494eba473891ae712ac922f6c2af4505"
      ],
      "text": "By default Tig's file read/write/update actions appear to require approval; a --auto-approve flag lets users auto-approve all actions."
    },
