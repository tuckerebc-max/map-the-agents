        "slc_56930dfa9904eb00b80a1a5b12a3e57fb98f85d4a3d6c358578384b83b828083"
      ],
      "text": "Vim Codex is described as a simple Vim plugin that lets users use OpenAI Codex, requiring access to OpenAI's Codex API."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e17213bab87db1f5317748c7a3944be5c4d435147cb29c05e662a3cdbb74c0b7",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "af12d5861cfbfb78d3ca6c6f680838a1449c52ee",
          "git_sha": "78b760d2536bcd6d896787e990ee6614c63fac24",
          "line_end": 65,
          "line_start": 62,
          "path": "README.md",
          "repository": "tom-doerr/vim_codex",
          "url": "https://github.com/tom-doerr/vim_codex/blob/af12d5861cfbfb78d3ca6c6f680838a1449c52ee/README.md#L62-L65"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_93c49fbe0baf95babc9dc4e13e448feec812500bffbcbee29477c40863182da2"
      ],
      "text": "The plugin exposes a CreateCompletion command, invoked by default via the <Leader>co mapping, which accepts a token-count argument such as 'CreateCompletion 1000'."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e4070f02ccc1192f90d12af64f7b6fee59590471618bd15da06922d58fe41a3b",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "af12d5861cfbfb78d3ca6c6f680838a1449c52ee",
          "git_sha": "78b760d2536bcd6d896787e990ee6614c63fac24",
          "line_end": 65,
          "line_start": 62,
          "path": "README.md",
          "repository": "tom-doerr/vim_codex",
          "url": "https://github.com/tom-doerr/vim_codex/blob/af12d5861cfbfb78d3ca6c6f680838a1449c52ee/README.md#L62-L65"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_93c49fbe0baf95babc9dc4e13e448feec812500bffbcbee29477c40863182da2"
      ],
      "text": "A CreateCompletionLine command is provided for completing just the current line."
    },
    {
      "basis": "documented",
      "claim_id": "clm_52e484e2f9080265fc7559ad952838817191443318ee1e2d3ba6b171a3806a86",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
