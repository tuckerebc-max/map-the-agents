          "line_end": 7,
          "line_start": 5,
          "path": "CHANGELOG.md",
          "repository": "fireproof-storage/fireproof",
          "url": "https://github.com/fireproof-storage/fireproof/blob/404e6c5c7f28109c103626c78da845eb95cabcfa/CHANGELOG.md#L5-L7"
