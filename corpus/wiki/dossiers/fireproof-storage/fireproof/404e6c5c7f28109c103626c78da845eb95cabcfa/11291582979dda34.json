      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_8a6bb1949534faae5db9632837be45cae14eeec1c2f9e27a67f6edb55a50554c"
      ],
      "text": "From version 0.19 onward the database format is stated to be stable with no backward-compatibility breaks, though internal APIs changed between the 0.19 and 0.20 series."
