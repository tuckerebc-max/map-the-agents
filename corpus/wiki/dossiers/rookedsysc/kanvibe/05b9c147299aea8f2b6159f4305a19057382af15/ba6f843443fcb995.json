        "slc_f87bffc629f5abe53352c6d869c68b6645da0f0bd3f700f8b0996c9bc9b71ee8"
      ],
      "text": "Tasks move through five statuses (TODO, PROGRESS, PENDING, REVIEW, DONE); moving a task to DONE automatically deletes its branch, worktree, and terminal session."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5f8b496ccf247f5a46663244fd35038467ebeae2b1480461bd42c99c372b3d94",
      "evidence_type": "organizational_statement",
