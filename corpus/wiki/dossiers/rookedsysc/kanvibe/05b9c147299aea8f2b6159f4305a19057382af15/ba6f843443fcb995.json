      "slice_ids": [
        "slc_a05cc376fb1ee439c09a4368bc55fe95b5665155f986a934d0379a1ecf6d8a1a"
      ],
      "text": "Agent hooks call HTTP endpoints: POST /api/hooks/start creates a task, and POST /api/hooks/status updates status by branchName plus projectName, returning 404 with a notification if the target is missing."
    },
