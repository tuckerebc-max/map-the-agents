          "line_end": 353,
          "line_start": 350,
          "path": "README.md",
          "repository": "rookedsysc/kanvibe",
          "url": "https://github.com/rookedsysc/kanvibe/blob/05b9c147299aea8f2b6159f4305a19057382af15/README.md#L350-L353"
