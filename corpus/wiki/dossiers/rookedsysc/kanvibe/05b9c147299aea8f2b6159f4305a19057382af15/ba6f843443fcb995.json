      "basis": "documented",
      "claim_id": "clm_726403198d6dc35d67962823619f1e2f2288872a2160a78e061bb0ae5a6331d3",
      "evidence_type": "organizational_statement",
      "facet": "limitations",
      "kind": "observation",
      "locators": [
        {
          "commit": "05b9c147299aea8f2b6159f4305a19057382af15",
          "git_sha": "e32b26f28c74dc9177c251f0873fe1d459a32ead",
          "line_end": 228,
          "line_start": 221,
          "path": "README.md",
          "repository": "rookedsysc/kanvibe",
          "url": "https://github.com/rookedsysc/kanvibe/blob/05b9c147299aea8f2b6159f4305a19057382af15/README.md#L221-L228"
