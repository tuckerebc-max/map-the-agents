      "slice_ids": [
        "slc_c60e03d190673eeb0a5c76d55eb46115fd887078125bcea8e0dd203c6547de0d"
      ],
      "text": "Gemini CLI lacks an equivalent to Claude Code's AskUserQuestion, so the PENDING status is not available for Gemini-driven tasks."
    },
