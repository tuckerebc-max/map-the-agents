      "slice_ids": [
        "slc_03f143a7a84d3361a246845d72b52c1aab5195a2d0f484de0247a99674f2bd64"
      ],
      "text": "The stack is Next.js 16 with React 19 and TypeScript, SQLite via TypeORM and better-sqlite3, xterm.js with WebSocket and node-pty for terminals, and Electron for desktop packaging."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0ad2729d4952797d7caa3424355902ac4cde1d08fb26097c26c6960bf3a3d8ad",
