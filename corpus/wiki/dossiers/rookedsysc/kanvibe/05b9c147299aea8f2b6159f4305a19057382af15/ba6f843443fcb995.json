        "slc_f6a611ef473450ef92f86cbaf7705d9b3bec0dfb68e834edc85d0c173e3d65b7"
      ],
      "text": "KanVibe integrates Claude Code Hooks, Gemini CLI Hooks, Codex CLI, and OpenCode to track task status automatically; hooks are auto-installed when a project is registered or a worktree task is created."
    },
    {
      "basis": "documented",
      "claim_id": "clm_82aa1ea312ded4869fbf47eb5fab4caf2fe50efb067f20e87f66e6307d4d7931",
