        {
          "commit": "e781c4265b7dbf2203fe0c2a3a5ae4dce6a88bef",
          "git_sha": "48c54e9252fc8ff94e9fe76831e55d241a4e654d",
          "line_end": 59,
          "line_start": 56,
          "path": "README.md",
          "repository": "h0x91b/dev-3.0",
          "url": "https://github.com/h0x91b/dev-3.0/blob/e781c4265b7dbf2203fe0c2a3a5ae4dce6a88bef/README.md#L56-L59"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_f9f332be0e00e013fedea4d464aba646fec1acd4e3d531f2d2874701dac1a056"
      ],
      "text": "Per-task sandboxes include a fresh git worktree off the base branch, a tmux session inside it, a per-project setup script, and optionally reserved free ports for the task's dev server."
    },
    {
      "basis": "documented",
      "claim_id": "clm_407f8a210c0d22558fdc78b7995515c043fc0065574672423902eff7e119f894",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
