      ],
      "text": "Each chat thread runs its own coding agent inside a Cloudflare Durable Object (ChatThreadDO), which owns the agent loop and persistent chat state."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e3b6115fae1f540bc58cf051436693dad2f772e12d44f78a15b70ace82991c4e",
