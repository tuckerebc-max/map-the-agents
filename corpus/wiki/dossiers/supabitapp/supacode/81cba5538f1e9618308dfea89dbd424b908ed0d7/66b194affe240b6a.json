      ],
      "text": "Terminal rendering uses libghostty with tabs, splits, per-surface backgrounds, and theme sync; auto-updates come through Sparkle with a selectable channel."
    },
    {
      "basis": "documented",
      "claim_id": "clm_e9f9f2cc74f20d628e884dc302b8f6db8d319e9f5ce0e1d0789172f7f56c5286",
