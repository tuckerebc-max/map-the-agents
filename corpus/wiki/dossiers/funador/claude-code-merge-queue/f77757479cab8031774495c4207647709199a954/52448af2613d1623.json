        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6fc309e66ae6443f05d3639eea12e3a881ae2859ce788e8a9378ad533b84b14d"
      ],
      "text": "Malformed configuration fails loudly at command load time, listing every problem (empty branch names, negative port, identical integration and production branches) rather than failing later."
    },
    {
      "basis": "documented",
      "claim_id": "clm_f2cf10b8af9e939498d56fef386700b3262b8296964bbd4623851d0cfc138052",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "f77757479cab8031774495c4207647709199a954",
          "git_sha": "47dcce35403637733bd07c073d98800511c0373b",
          "line_end": 90,
          "line_start": 81,
          "path": "README.md",
          "repository": "funador/claude-code-merge-queue",
          "url": "https://github.com/funador/claude-code-merge-queue/blob/f77757479cab8031774495c4207647709199a954/README.md#L81-L90"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ea6af056145f0136cf29cb4235c714dd884e8fa3609277ad92af58ad5e248041"
      ],
      "text": "The land command rebases and pushes a lane onto the integration branch through a FIFO queue so two lanes are never mid-push simultaneously; agents can run it themselves."
    },
    {
      "basis": "documented",
      "claim_id": "clm_a0e10b4bc82e4c5175ff39eb3517c93b07f8522741993a31ef5d8eaf0c99e35b",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
      "kind": "observation",
      "locators": [
        {
          "commit": "f77757479cab8031774495c4207647709199a954",
          "git_sha": "47dcce35403637733bd07c073d98800511c0373b",
          "line_end": 90,
          "line_start": 81,
          "path": "README.md",
          "repository": "funador/claude-code-merge-queue",
          "url": "https://github.com/funador/claude-code-merge-queue/blob/f77757479cab8031774495c4207647709199a954/README.md#L81-L90"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_ea6af056145f0136cf29cb4235c714dd884e8fa3609277ad92af58ad5e248041"
      ],
      "text": "A WorktreeCreate hook plugs the tool's numbered lanes into Claude Code's native worktree creation, and build-lock serializes builds machine-wide across lanes."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2c5447b7d4a3e98ce7f3a6aa9204b70692432ad4db6f735acf6e9f83daa08132",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
          "commit": "f77757479cab8031774495c4207647709199a954",
          "git_sha": "47dcce35403637733bd07c073d98800511c0373b",
          "line_end": 97,
          "line_start": 92,
          "path": "README.md",
          "repository": "funador/claude-code-merge-queue",
          "url": "https://github.com/funador/claude-code-merge-queue/blob/f77757479cab8031774495c4207647709199a954/README.md#L92-L97"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d43960f994cfe8b764a46849516c3783e0cecf1a4183c91e9eba618b214b08aa"
      ],
      "text": "A pre-push hook rejects direct git pushes to the integration branch and runs checkCommand before allowing a landing; with no checkCommand configured, every push fails by default."
    },
    {
      "basis": "documented",
      "claim_id": "clm_edd6b3f90e66cb6c5fa9c17134462523f5cb276206ecf7c83712140f24a87903",
      "evidence_type": "organizational_statement",
      "facet": "tools-permissions",
      "kind": "observation",
      "locators": [
        {
          "commit": "f77757479cab8031774495c4207647709199a954",
          "git_sha": "47dcce35403637733bd07c073d98800511c0373b",
          "line_end": 126,
          "line_start": 125,
          "path": "README.md",
          "repository": "funador/claude-code-merge-queue",
          "url": "https://github.com/funador/claude-code-merge-queue/blob/f77757479cab8031774495c4207647709199a954/README.md#L125-L126"
        },
        {
          "commit": "f77757479cab8031774495c4207647709199a954",
          "git_sha": "47dcce35403637733bd07c073d98800511c0373b",
          "line_end": 119,
          "line_start": 117,
          "path": "README.md",
          "repository": "funador/claude-code-merge-queue",
          "url": "https://github.com/funador/claude-code-merge-queue/blob/f77757479cab8031774495c4207647709199a954/README.md#L117-L119"
        },
