          "line_end": 84,
          "line_start": 84,
          "path": "README.md",
          "repository": "tlbx-ai/tlbx",
          "url": "https://github.com/tlbx-ai/tlbx/blob/f4e92650419094d42b7c9d8f8f516213ef415fbc/README.md#L84-L84"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_994b4271407aaf7679cad70d58b786927fe53035b8b2df8978606fcbb6bbe5d2"
      ],
      "text": "Agent Controller has built-in launch options for Codex, Grok Build, OpenCode, Gemini CLI and GitHub Copilot CLI, and compatible ACP agents can be added via acp-agents.json; Claude Code runs in a normal terminal session."
    },
    {
      "basis": "documented",
      "claim_id": "clm_9252486372b375db29ce38ff427a1fe9c5ccc1a044d0f5485154b8d1c2e29bfa",
