      "slice_ids": [
        "slc_964ec5e0e2898186c5b2483f2ca39baf9cf862adf55983d42d2a2905312151d5"
      ],
      "text": "Repository development practice: every release invocation must explicitly pass -TestCategories from a fixed set (assets, frontend, server, runtime, installers, dependencies, build, or all), and stable releases require all."
    },
