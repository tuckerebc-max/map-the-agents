        "slc_0e1dcbc6d465343ddf1d2924d03f4cb5944ba190473a56768b2ba06c91102f6b"
      ],
      "text": "tlbx offers two session types: a Terminal Session rendering the user's terminal with output retained on the host, and an Agent Controller Session rendering a conversation view with tool calls, code changes, questions and approval buttons."
    },
    {
      "basis": "documented",
      "claim_id": "clm_196dec3902e59da9df7a6975b5b13de182fbbe9ddf316f9b7450781f549e3766",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
