        {
          "commit": "572c7bef8ca00788bb4b986292558e6344681b39",
          "git_sha": "9561bb22aaf3da3ed043135ec46e32553d67aaa0",
          "line_end": 161,
          "line_start": 156,
          "path": "README.md",
          "repository": "agnusdei1207/opencode-orchestrator",
          "url": "https://github.com/agnusdei1207/opencode-orchestrator/blob/572c7bef8ca00788bb4b986292558e6344681b39/README.md#L156-L161"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_6f2228937ce658d000a0c5e11a4544fa565afcbdcb1b2722640326fdd5ab1ebb"
      ],
      "text": "The architecture defines four agents: Commander (orchestrates missions and loop state), Planner (orders file-level tasks), Worker (isolated TDD edits), and Reviewer (verifies test evidence and builds)."
    },
