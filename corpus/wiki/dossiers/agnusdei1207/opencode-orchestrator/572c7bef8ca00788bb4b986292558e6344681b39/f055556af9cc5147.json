      "text": "OpenCode Orchestrator is an MIT-licensed npm package (opencode-orchestrator) at version 1.7.17, described as multi-agent mission control for OpenCode with four agent roles."
    },
    {
      "basis": "documented",
      "claim_id": "clm_4cccb0839fb0030b547acebb00d394882f4a00927ac4ff178f986e7b87911777",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
