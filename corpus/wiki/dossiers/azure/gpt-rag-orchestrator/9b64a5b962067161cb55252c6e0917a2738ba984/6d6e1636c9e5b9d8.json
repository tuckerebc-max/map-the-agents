      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_47a5ce8c8beeaecf81c728efa8c66eaaf4c6a1a206589379c6b5bdbcef5c78ce"
      ],
      "text": "Audit budgets are fixed rather than configurable: 64 events per request, 16 complete tool invocation pairs, and up to 25 grounding-source events per request."
    },
