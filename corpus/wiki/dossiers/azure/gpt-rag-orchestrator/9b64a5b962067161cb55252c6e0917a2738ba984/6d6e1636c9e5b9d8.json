          "git_sha": "6ac7c4075f6aac30e19287b94ad3313bab328fb3",
          "line_end": 124,
          "line_start": 90,
          "path": "README.md",
          "repository": "azure/gpt-rag-orchestrator",
          "url": "https://github.com/Azure/gpt-rag-orchestrator/blob/9b64a5b962067161cb55252c6e0917a2738ba984/README.md#L90-L124"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_73797bb9a5de37595b6c7a56a1af51121b98331e84c1b7c6c6f92a477cd69bc1"
      ],
      "text": "The /responses adapter accepts a plain string input or ordered text-only role/content messages, streaming or synchronous execution, metadata, and platform-injected agent_reference; all other top-level fields are logged and dropped."
    },
    {
      "basis": "documented",
