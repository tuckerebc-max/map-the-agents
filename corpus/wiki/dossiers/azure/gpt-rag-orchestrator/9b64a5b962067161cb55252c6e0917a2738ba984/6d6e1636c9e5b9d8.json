        "slc_d34b61364f9b27a5b13e0f08e525b52ec333c98f92d52986dec6d36f1faea40e"
      ],
      "text": "The hosted entrypoint exposes POST /responses (Foundry Responses v2 protocol), GET /readiness for readiness probes, and a compatibility GET /health route returning image version and hosted-eligible strategies."
    },
    {
      "basis": "documented",
      "claim_id": "clm_1cf55f909357250400eff80514d53ebfa65a2229aa6736b05fe2a8935317f421",
      "evidence_type": "organizational_statement",
