      "claim_id": "clm_88df3552dae7dc4ae3f3023b129fd35c0dac57c33dec62723d4bf68fb68dc54b",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
