          "git_sha": "6ac7c4075f6aac30e19287b94ad3313bab328fb3",
          "line_end": 250,
          "line_start": 246,
          "path": "README.md",
          "repository": "azure/gpt-rag-orchestrator",
          "url": "https://github.com/Azure/gpt-rag-orchestrator/blob/9b64a5b962067161cb55252c6e0917a2738ba984/README.md#L246-L250"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d80f0c64ca45868cdf3e4181ec5582d09ab780a6cf9cebc13dc78b1b6d069fa3"
      ],
      "text": "Audit events are best-effort operational telemetry, not an immutable ledger and not a compliance mechanism; disabling auditing stops new events without deleting already-exported telemetry."
    },
