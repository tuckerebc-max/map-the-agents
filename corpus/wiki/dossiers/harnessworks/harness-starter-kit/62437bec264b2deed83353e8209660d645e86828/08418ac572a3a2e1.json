      "slice_ids": [
        "slc_fae2bea288e8e6263bfdb0b581c08c6d9b3ceb5d638b77c01142f8205d44647e"
      ],
      "text": "The /harness review sub-agent request is treated as explicit permission to use a read-only reviewer subagent when the active runtime and tool instructions permit it; if unavailable, blocked, or failed, the fallback reason must be reported."
    },
