          "line_end": 163,
          "line_start": 160,
          "path": "README.md",
          "repository": "harnessworks/harness-starter-kit",
          "url": "https://github.com/harnessworks/harness-starter-kit/blob/62437bec264b2deed83353e8209660d645e86828/README.md#L160-L163"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_9576d03f2194fc967c010f6732804d3fa80b7355dbf06c3d42f1b8934ebb9787"
      ],
      "text": "The /harness command names are prompt conventions typed into the coding agent chat by default, not built-in editor commands; they appear in editor command palettes only if matching custom slash commands are added separately."
    },
    {
      "basis": "documented",
