        "slc_5e439593fcfd0a2ddbe02394a5426fd9bf05b724c09a88478ff7e38c4e49f422"
      ],
      "text": "IX is described as a platform for designing and deploying autonomous and semi-autonomous LLM agents and workflows that can run in parallel and communicate with each other."
    },
    {
      "basis": "documented",
      "claim_id": "clm_54b58b6d0a5c1e945e0c146d8b7160eee06595aea930d4752cff47f2517f7bc9",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "d5868fc1d56d5616306e15b1a10a06256cc6e4d2",
          "git_sha": "6bd1cb888396000cc41e2e30de6a38cd4786309b",
          "line_end": 56,
          "line_start": 55,
          "path": "README.md",
          "repository": "kreneskyp/ix",
          "url": "https://github.com/kreneskyp/ix/blob/d5868fc1d56d5616306e15b1a10a06256cc6e4d2/README.md#L55-L56"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_d5e95f18f80413bf9d094ad1fdbea8a66712ef522ce6dee8e5494aa6cf0c2f1b"
      ],
      "text": "The product includes a no-code agent editor where users drop and connect nodes into a graph representing an agent's cognitive logic, with embedded chat for testing and debugging."
    },
    {
      "basis": "documented",
      "claim_id": "clm_71eef01b6fe735bbaf83a10d016d4575cce8f208b86fd730d209b726ba376965",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "d5868fc1d56d5616306e15b1a10a06256cc6e4d2",
          "git_sha": "6bd1cb888396000cc41e2e30de6a38cd4786309b",
          "line_end": 63,
          "line_start": 61,
          "path": "README.md",
          "repository": "kreneskyp/ix",
          "url": "https://github.com/kreneskyp/ix/blob/d5868fc1d56d5616306e15b1a10a06256cc6e4d2/README.md#L61-L63"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_5a8bb5481610be08f4f6feb1637b0cad1b2fdbda0436f5084072133517d2b0e4"
      ],
      "text": "A multi-agent chat interface lets users interact with teams of agents; a default IX moderator agent delegates tasks, and specific agents can be targeted via @mentions."
    },
    {
      "basis": "documented",
      "claim_id": "clm_fa5e491a027fb1098749bff86127bc7319c898af3ad5b9c4fbc881ab04f29652",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
      "locators": [
        {
          "commit": "d5868fc1d56d5616306e15b1a10a06256cc6e4d2",
          "git_sha": "6bd1cb888396000cc41e2e30de6a38cd4786309b",
          "line_end": 70,
          "line_start": 70,
          "path": "README.md",
          "repository": "kreneskyp/ix",
          "url": "https://github.com/kreneskyp/ix/blob/d5868fc1d56d5616306e15b1a10a06256cc6e4d2/README.md#L70-L70"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_fc88eef4583292964dc4eface90d972e7ea8c4b631953737a576f39c53203573"
      ],
      "text": "The smart input bar auto-completes agent @mentions and file/data artifacts created by tasks."
    },
    {
      "basis": "documented",
      "claim_id": "clm_826bdb0c3af275c202de633d42ee08bb9adbe977fd9e56fe71feb72d9537a628",
      "evidence_type": "organizational_statement",
      "facet": "orchestration",
