          "git_sha": "92fc5d7115a7d3feb1f3f9580264ffa93524c5a4",
          "line_end": 21,
          "line_start": 21,
          "path": "README.md",
          "repository": "brutusin/instrumentation",
          "url": "https://github.com/brutusin/instrumentation/blob/f1c80c2524a18e9e2080c28748a0f1d5d77d4be8/README.md#L21-L21"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_50551d3c73bb0636a9a7d143f64721609430ec2f73a2d1856af04c6ec34c58e5"
      ],
      "text": "Instrumentation is implemented as a byte[]-to-byte[] class transformation at load time, leveraging the JDK 1.5 java.lang.instrument package's java-agent mechanism."
    },
    {
      "basis": "documented",
      "claim_id": "clm_215c76b1af08b84eb4f57767c371bd3a8d8337a0e04422881bd9b067122752d4",
      "evidence_type": "organizational_statement",
      "facet": "interfaces",
      "kind": "observation",
