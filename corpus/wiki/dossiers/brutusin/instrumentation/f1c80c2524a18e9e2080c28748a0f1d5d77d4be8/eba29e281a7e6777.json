        "slc_ffee9e928120102c5a2d351561260ded87ebc9e1884e2a3281f772e2b7372207"
      ],
      "text": "The project is an extensible Java agent framework that instruments JVM programs by modifying bytecode at class-loading time to capture method invocation events (start, finish, errors) and notify custom listeners."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d521cfbee0422e329b54c9eef3d43c3768770a714eab1e7bb3be5709f0bed160",
      "evidence_type": "organizational_statement",
      "facet": "components",
      "kind": "observation",
      "locators": [
        {
          "commit": "f1c80c2524a18e9e2080c28748a0f1d5d77d4be8",
          "git_sha": "92fc5d7115a7d3feb1f3f9580264ffa93524c5a4",
          "line_end": 23,
          "line_start": 23,
          "path": "README.md",
          "repository": "brutusin/instrumentation",
          "url": "https://github.com/brutusin/instrumentation/blob/f1c80c2524a18e9e2080c28748a0f1d5d77d4be8/README.md#L23-L23"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_81aa10281b34fa8d7b64588d9234b4689e1388b6af228e57bd7baf54d28a3a93"
      ],
      "text": "The module provides an Agent class that instantiates a listener from a concrete Interceptor subclass named in the JVM agent arguments."
    },
    {
      "basis": "documented",
      "claim_id": "clm_24528ca1bdda2761bf77f8f736dfae4976235a918d8b3f6a0a922a980b8a7e55",
      "evidence_type": "organizational_statement",
      "facet": "dependencies",
      "kind": "observation",
      "locators": [
