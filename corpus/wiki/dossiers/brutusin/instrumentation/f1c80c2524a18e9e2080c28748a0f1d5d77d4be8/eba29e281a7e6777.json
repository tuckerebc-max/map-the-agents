          "git_sha": "92fc5d7115a7d3feb1f3f9580264ffa93524c5a4",
          "line_end": 23,
          "line_start": 23,
          "path": "README.md",
          "repository": "brutusin/instrumentation",
          "url": "https://github.com/brutusin/instrumentation/blob/f1c80c2524a18e9e2080c28748a0f1d5d77d4be8/README.md#L23-L23"
        }
      ],
      "review_state": "mechanically_checked",
