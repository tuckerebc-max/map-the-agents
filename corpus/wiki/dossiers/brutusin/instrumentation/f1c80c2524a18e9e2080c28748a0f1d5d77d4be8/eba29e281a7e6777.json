        "slc_81aa10281b34fa8d7b64588d9234b4689e1388b6af228e57bd7baf54d28a3a93"
      ],
      "text": "The framework uses the ASM library to inject instructions into method definitions of classes being loaded."
    },
    {
      "basis": "documented",
      "claim_id": "clm_ab3743db6e359fa943a0a4a1327cea80abf7a3c56154611856997284a59707f1",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
