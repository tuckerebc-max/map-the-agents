      ],
      "text": "Next.js Builder is a tool for interactively generating pages, APIs, and database schemas for Next.js web applications through a multi-step interface."
    },
    {
      "basis": "documented",
      "claim_id": "clm_7e068b4187c7baa8af022500356e3e30cddff641c2963fddc7b07048be4e9ca2",
