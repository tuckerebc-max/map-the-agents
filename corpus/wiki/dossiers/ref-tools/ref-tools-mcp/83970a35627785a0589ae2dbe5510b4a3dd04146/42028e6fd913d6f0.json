        {
          "commit": "83970a35627785a0589ae2dbe5510b4a3dd04146",
          "git_sha": "7f6567de1de41dc85c49ac05f3be536c34431909",
          "line_end": 37,
          "line_start": 37,
          "path": "README.md",
          "repository": "ref-tools/ref-tools-mcp",
          "url": "https://github.com/ref-tools/ref-tools-mcp/blob/83970a35627785a0589ae2dbe5510b4a3dd04146/README.md#L37-L37"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_1d19d2eb0e53ee7a6b2994a1013cfdefe2e229ba26a100c2a4ce9dc63a605320"
      ],
      "text": "Ref uses MCP sessions to track search trajectory and minimize context usage."
    },
    {
      "basis": "documented",
      "claim_id": "clm_5f3b5c11ac21fd3f6fb9fd5eb94b91361a6111842ccea9df18f910b5b6711447",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "83970a35627785a0589ae2dbe5510b4a3dd04146",
          "git_sha": "7f6567de1de41dc85c49ac05f3be536c34431909",
          "line_end": 40,
          "line_start": 40,
          "path": "README.md",
          "repository": "ref-tools/ref-tools-mcp",
          "url": "https://github.com/ref-tools/ref-tools-mcp/blob/83970a35627785a0589ae2dbe5510b4a3dd04146/README.md#L40-L40"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_c90c67762f570ce8ccb4817be1e637dd290d8a697395def69e2284cf8ad6dde0"
      ],
      "text": "Within a session, repeated similar searches never return duplicate results, letting the agent both page deeper and adjust its prompt."
    },
    {
      "basis": "documented",
      "claim_id": "clm_10625900b6bcd50ce341aace770a2ffee83746f000eff44217c40b045277c762",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "83970a35627785a0589ae2dbe5510b4a3dd04146",
          "git_sha": "7f6567de1de41dc85c49ac05f3be536c34431909",
          "line_end": 43,
          "line_start": 43,
          "path": "README.md",
          "repository": "ref-tools/ref-tools-mcp",
          "url": "https://github.com/ref-tools/ref-tools-mcp/blob/83970a35627785a0589ae2dbe5510b4a3dd04146/README.md#L43-L43"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_343080ff1a72cb7343821fe2fc9e4dd1013dde72bc9d6471ce3ce0110eeb0368"
      ],
      "text": "When reading a documentation page, Ref uses the session's search history to drop less relevant sections and return the most relevant 5k tokens instead of pulling in 20k+ tokens."
    },
    {
      "basis": "documented",
      "claim_id": "clm_d4600d40b4ec87764d5a4e3d2bbc4a44181c480908cffe2605fadba37a617de5",
      "evidence_type": "organizational_statement",
      "facet": "design-choices",
      "kind": "observation",
      "locators": [
        {
          "commit": "83970a35627785a0589ae2dbe5510b4a3dd04146",
          "git_sha": "7f6567de1de41dc85c49ac05f3be536c34431909",
          "line_end": 15,
          "line_start": 15,
          "path": "README.md",
          "repository": "ref-tools/ref-tools-mcp",
          "url": "https://github.com/ref-tools/ref-tools-mcp/blob/83970a35627785a0589ae2dbe5510b4a3dd04146/README.md#L15-L15"
        }
      ],
      "review_state": "mechanically_checked",
      "slice_ids": [
        "slc_efcd75f8f890d0a0e259b86b7ce990b3f8da78fd67a3e30b9124694e75f8f348"
      ],
      "text": "The tools are designed to match how models search while minimizing context, aiming to reduce context rot and find exactly the context a coding agent needs."
    },
