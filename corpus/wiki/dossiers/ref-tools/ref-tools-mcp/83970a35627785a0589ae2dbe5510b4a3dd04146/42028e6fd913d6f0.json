        "slc_c772f846f12148a4965079df59290e0eb7d6b796ebeae626c8a1e14f70ba5a3c"
      ],
      "text": "For OpenAI deep-research clients, the same tools are provided under different names: ref_search_documentation(query) becomes search(query) and ref_read_url(url) becomes fetch(id)."
    },
    {
      "basis": "documented",
      "claim_id": "clm_0c1acfce035cac258a4252b9795239285620ac5e4a1367ab0e9a9fe8cc4645eb",
