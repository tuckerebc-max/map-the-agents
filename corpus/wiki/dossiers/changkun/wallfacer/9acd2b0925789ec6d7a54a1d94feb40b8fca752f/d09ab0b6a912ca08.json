      ],
      "text": "Specs serve as an intermediate representation: ideas become structured, versioned, reviewable specs that agents reason about and implement against, rather than going straight to code."
    },
    {
      "basis": "documented",
      "claim_id": "clm_2668981d4fdf7c9838bca14c8b85605ddd9670824ca14194522bc22c226df6a5",
