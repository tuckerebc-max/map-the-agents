{"access":"public","created_at":"2026-09-14T02:11:21Z","created_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_336698533c04cb8a1969d775b9c3be03af53644fbe4882aef159ba88eb19ec37","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"l3yx/intentlang@6ce1cf88eac8 snapshot 1ecf66ae56c28c19","timeframe":null},"slice_ids":["slc_2bb419457bd079e5b0135236498cf6838e16ad8700ed7ad6cc9076062bcf4729","slc_9ebc71a61156bf201e92eebece986b21d5dbdb63ef0d94fcb3dc9a7b7b00e117","slc_c8c7195c16bad063a3598c94eed2165a52c83628c0438c4bdb4b70da587cd677"],"source_ids":["src_d251e6483af75a968d1362f123466bc0"],"text":"Input data is passed by reference and not serialized into the LLM context; the model receives only names and descriptions and must generate code to access in-memory objects.","updated_at":"2026-09-14T02:11:21Z","updated_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d"}
{"access":"public","created_at":"2026-09-14T02:11:21Z","created_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3d5cc94278cea046d8a662d202a7c3210b678c19914fda5cccfb0372df15f8e7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"l3yx/intentlang@6ce1cf88eac8 snapshot 1ecf66ae56c28c19","timeframe":null},"slice_ids":["slc_007cedebc48947472425a1063cf11e340417faa6f63b637af0996238f9387186","slc_5ed48c55f1910d1483ed97fe31fe67a60d9b352ab40eb4649a3ed3e4395ae0da"],"source_ids":["src_d251e6483af75a968d1362f123466bc0"],"text":"The Executor iteratively runs LLM-generated Python until output matches the declared OutputModel or the preset maximum iteration count is reached.","updated_at":"2026-09-14T02:11:21Z","updated_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d"}
{"access":"public","created_at":"2026-09-14T02:11:21Z","created_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4cea85e719945404bfcd175ca632c9ff9ff086d254c3155cb069d513e04caf3a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"l3yx/intentlang@6ce1cf88eac8 snapshot 1ecf66ae56c28c19","timeframe":null},"slice_ids":["slc_44192d2bf73b53e7f8b9df57f2c33b21726db49817b0b517ca9f92000e8ef757","slc_9daa9fc5b96424d3ee4cd60d0851b497793ac2dedd3f94185e2605e4ce3fd30f","slc_aa43b82f37b1d2193bf6e01de153b06996a0f9eda742b603d6a49f709c2b2e58"],"source_ids":["src_d251e6483af75a968d1362f123466bc0"],"text":"LLM configuration is supplied through environment variables (OPENAI_BASE_URL, OPENAI_API_KEY, OPENAI_MODEL_NAME, OPENAI_EXTRA_BODY) set in a .env file, or via an LLMConfig object.","updated_at":"2026-09-14T02:11:21Z","updated_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d"}
{"access":"public","created_at":"2026-09-14T02:11:21Z","created_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6a37d86ecccb7eb9d59f45e6d2c536d8e00f84ccde8d2a40e58b0aa951ac6def","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"l3yx/intentlang@6ce1cf88eac8 snapshot 1ecf66ae56c28c19","timeframe":null},"slice_ids":["slc_4a9a963712abfa3e193bc21108adc2492233fd459a3a1b96e52d69350e3d019e","slc_a29c5811d7465f9ab47c80ceb2cf5ca101aa27ce640a563e81b017f8fbff8616","slc_a43b8c24c45967bbf064055111c2adde0807d490503f0efb110a7ff7fbb52bd5","slc_c2165ba42b474ca8d6034dbd333f5c679684251474a1001c199f145ce0b1afca","slc_d6509d529a62cfa13ebdb7e53c01e6bbccca2c4396cc9ea2378d09458464d6a8"],"source_ids":["src_d251e6483af75a968d1362f123466bc0"],"text":"The README warns that AI-generated code executes in the user's runtime and recommends running in isolated environments such as Docker containers, sandboxed Python environments, or virtual machines.","updated_at":"2026-09-14T02:11:21Z","updated_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d"}
{"access":"public","created_at":"2026-09-14T02:11:21Z","created_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6c1aaf2da36d4586feca8dd80a906e46d52430cb6b9b755437313d03ae128bb9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"l3yx/intentlang@6ce1cf88eac8 snapshot 1ecf66ae56c28c19","timeframe":null},"slice_ids":["slc_5c889d4f8fdeef3fb7f739e4d82a3f9cf597f41d6277645bad33b8f96c4737bd","slc_5ed48c55f1910d1483ed97fe31fe67a60d9b352ab40eb4649a3ed3e4395ae0da","slc_70aa252418a8dda0f3dfb153def1ebd06ae37aab5ccde1c8371fb4835ed79d0a"],"source_ids":["src_d251e6483af75a968d1362f123466bc0"],"text":"Intents execute via compile() returning an Executor, or via run()/run_sync() convenience methods that compile and execute, returning an IntentResult with structured output and usage info.","updated_at":"2026-09-14T02:11:21Z","updated_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d"}
{"access":"public","created_at":"2026-09-14T02:11:21Z","created_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_931fe75c4a5a849156014886c3d880475f188441fe085d1965ee442e06c20dbf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"l3yx/intentlang@6ce1cf88eac8 snapshot 1ecf66ae56c28c19","timeframe":null},"slice_ids":["slc_9faae06295aa74136ecaf459763742de163f1cf911d46349cd47aaad5c83afc0","slc_d27bd043233cd3ae6635a2b7055314e73cc4c9939dbd543d9b4d0998f1621e18"],"source_ids":["src_d251e6483af75a968d1362f123466bc0"],"text":"The runtime captures print output as observations and feeds exceptions back to the LLM so it can self-correct across iterations.","updated_at":"2026-09-14T02:11:21Z","updated_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d"}
{"access":"public","created_at":"2026-09-14T02:11:21Z","created_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_967e305c0b597a66976316159a788428fee4e8011f90759a21f95f3157ee78b4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"l3yx/intentlang@6ce1cf88eac8 snapshot 1ecf66ae56c28c19","timeframe":null},"slice_ids":["slc_f31bea302b30b9a620c88077c587dd7363a8fb75183042468e4287efbb37d936"],"source_ids":["src_d251e6483af75a968d1362f123466bc0"],"text":"Intent elements (Goal, Contexts, Tools, Input, Strategy, Constraints, Output) are transformed into an XML-based Intent IR that guides progressive code generation.","updated_at":"2026-09-14T02:11:21Z","updated_by_operation":"op_ad0a6c12cbd54e1eb3c7e888c1378e8d"}
