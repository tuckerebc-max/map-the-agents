{"access":"public","created_at":"2026-09-14T03:59:40Z","created_by_operation":"op_34234d37e2234dfd85bf80eacde94e76","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d508f7eba59a1b2a3ca8277e5f2c687e017b9f685918b6ba6617dc5c8a6de9c2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"intellegix/intellegix-code-agent-toolkit@852325000c29 snapshot 120c3f08bfd79547","timeframe":null},"slice_ids":["slc_bf0d362d861ec11d91b5b47915f8f694ecb72db83481c6b16464f061fa8c16fd","slc_fb0bc21331166f32d87756f00a2deea40a3095eafaf69f0d20eeacc8d3e43fdf"],"source_ids":["src_11694459cc3d53ff937ab5c48dd8a12a"],"text":"The toolkit ships an automated loop driver (loop_driver.py with NDJSON parser, state tracker, research bridge, and log redactor), agent definitions, hooks, slash commands, council automation, and an MCP browser bridge.","updated_at":"2026-09-14T03:59:40Z","updated_by_operation":"op_34234d37e2234dfd85bf80eacde94e76"}
{"access":"public","created_at":"2026-09-14T03:59:40Z","created_by_operation":"op_34234d37e2234dfd85bf80eacde94e76","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d79326fbc0e435186e89e19645c5156004dd3aa2080e485e94d07be2fd6e54bc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"intellegix/intellegix-code-agent-toolkit@852325000c29 snapshot 120c3f08bfd79547","timeframe":null},"slice_ids":["slc_62834ad9b8919ba4dfa0f24f8d4d6c69bf89209e012c53bfbc8906d49a667e70"],"source_ids":["src_11694459cc3d53ff937ab5c48dd8a12a"],"text":"A SessionSemaphore caps browser concurrency at 3 slots, and 4+ simultaneous queries on one account may still hit Perplexity's own session limits.","updated_at":"2026-09-14T03:59:40Z","updated_by_operation":"op_34234d37e2234dfd85bf80eacde94e76"}
{"access":"public","created_at":"2026-09-14T03:59:40Z","created_by_operation":"op_34234d37e2234dfd85bf80eacde94e76","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e2f41f85cb3c99c109f1481cb7327d019dc8a43c6adba8a759415c1ff2638cd5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"intellegix/intellegix-code-agent-toolkit@852325000c29 snapshot 120c3f08bfd79547","timeframe":null},"slice_ids":["slc_54880cc6e4d73c92e37e36b5c07358f65f98e78ed397e0a00e6ea55b38e18b5b","slc_754157062dfc24393c66be5130653b1cf61f4adfd4712f538882028b6e92982a"],"source_ids":["src_11694459cc3d53ff937ab5c48dd8a12a"],"text":"The loop exits with coded statuses: 0 for completion, 1 for max iterations, 2 for budget exceeded, and 3 for stagnation.","updated_at":"2026-09-14T03:59:40Z","updated_by_operation":"op_34234d37e2234dfd85bf80eacde94e76"}
{"access":"public","created_at":"2026-09-14T03:59:40Z","created_by_operation":"op_34234d37e2234dfd85bf80eacde94e76","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ef39f17872b5d8387855093fa8aeeead6dbe718c0cb235f6c031481752ff5f51","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"intellegix/intellegix-code-agent-toolkit@852325000c29 snapshot 120c3f08bfd79547","timeframe":null},"slice_ids":["slc_ac685d5b66f9781781fb8eb1ba9c823442d7f551f31ff4eba6e3998c54d7c473","slc_e3b8e44fa18e68f05f9f4c93fef9588635ce1a76af82ee178a325699cf4bdea5"],"source_ids":["src_11694459cc3d53ff937ab5c48dd8a12a"],"text":"Orchestrator activation writes a sentinel file (.workflow/orchestrator-mode.json, 24-hour expiry) and a PreToolUse hook blocks source-file access while allowing CLAUDE.md, BLUEPRINT.md, markdown, and .workflow files; the hook is fail-open when no sentinel exists.","updated_at":"2026-09-14T03:59:40Z","updated_by_operation":"op_34234d37e2234dfd85bf80eacde94e76"}
