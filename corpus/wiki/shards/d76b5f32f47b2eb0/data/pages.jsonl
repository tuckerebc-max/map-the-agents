{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_133420f4dd77732e0c2e4b41a5ff5826abac6b40e9da6bff45f0df62049ef718"],"opposing_claim_ids":[],"text":"Research use cases listed include productivity prediction, burnout classifiers, feature-engineering practice with mixed variable types and missing values, analytics dashboards, and AI team simulation."},{"claim_ids":["clm_3728e21889e280730ab313dfa91344b6d4c623b3fe6c7e3b4699db6c0bcc8662"],"opposing_claim_ids":[],"text":"The repo ships the dataset as a CSV file, Developer_Productivity_Synthetic_Syncora.csv, linked for download and described as ready for analysis and modeling."},{"claim_ids":["clm_3801c964b65f7597e9f7d60c83e516427857fc463d38a22dd9951f39b241316c"],"opposing_claim_ids":[],"text":"The dataset was produced by the Syncora.ai synthetic data engine, and the README directs users to that external service to generate their own synthetic datasets."},{"claim_ids":["clm_459d1d3409a0f762b8c5c8a4f05d750889efd66644741280692140c278ae0f57"],"opposing_claim_ids":[],"text":"The data is designed to simulate realistic developer workflows and burnout indicators while ensuring zero risk of personal data exposure, with zero real-user data cited as eliminating privacy liability."},{"claim_ids":["clm_5afac29e65f2a744ccd53415708faba7d284228d4e24087666ba00adb469b167"],"opposing_claim_ids":[],"text":"Intended users are researchers, team leads, and AI modelers studying productivity trends, burnout detection, or time optimization without employee-surveillance ethical concerns."},{"claim_ids":["clm_a196e6acf6b38ed34c09a53d3a17eef2d4471ce58d48636aee99c0aab893dd8c"],"opposing_claim_ids":[],"text":"Suggested applications include ML training for productivity forecasting, time tracking and optimization algorithm design, burnout detection research, and synthetic benchmarking for HR and engineering analytics tools."},{"claim_ids":["clm_ca10673160b6c8c0d06449a0bfeda3d4d41ab9209dad96cfe35ac0ee2ba0f9ef"],"opposing_claim_ids":[],"text":"The repository also includes Jupyter notebooks demonstrating dataset exploration and usage."},{"claim_ids":["clm_dd204cc880db3b1d3d59bef29e7f49bb5b0ec30ee2c7454cb5176801dddab402"],"opposing_claim_ids":[],"text":"Documented columns include focus_hours (0-8), meetings_per_day (0-6), lines_of_code (0-1000), commits_per_day (0-20), task_completion_rate, reported_burnout, debugging_time, tech_stack_complexity, pair_programming, and productivity_score (0-100)."},{"claim_ids":["clm_e0858bc1e1de53a7384d5215cceb8947b4f0dd4996bc0790ee0e32af7fba82cf"],"opposing_claim_ids":[],"text":"The dataset captures behavioral and productivity patterns of AI developers and was generated using Syncora.ai's synthetic data engine."},{"claim_ids":["clm_ea442db9360db0c3bb535b5fcf3892009a02367fb8d3690c4e28ef41ffe3e467"],"opposing_claim_ids":[],"text":"The README states the dataset is 100% synthetic, does not represent real individuals, and is intended solely for research, educational, and experimental use."}],"claim_ids":["clm_133420f4dd77732e0c2e4b41a5ff5826abac6b40e9da6bff45f0df62049ef718","clm_3728e21889e280730ab313dfa91344b6d4c623b3fe6c7e3b4699db6c0bcc8662","clm_3801c964b65f7597e9f7d60c83e516427857fc463d38a22dd9951f39b241316c","clm_459d1d3409a0f762b8c5c8a4f05d750889efd66644741280692140c278ae0f57","clm_5afac29e65f2a744ccd53415708faba7d284228d4e24087666ba00adb469b167","clm_a196e6acf6b38ed34c09a53d3a17eef2d4471ce58d48636aee99c0aab893dd8c","clm_ca10673160b6c8c0d06449a0bfeda3d4d41ab9209dad96cfe35ac0ee2ba0f9ef","clm_dd204cc880db3b1d3d59bef29e7f49bb5b0ec30ee2c7454cb5176801dddab402","clm_e0858bc1e1de53a7384d5215cceb8947b4f0dd4996bc0790ee0e32af7fba82cf","clm_ea442db9360db0c3bb535b5fcf3892009a02367fb8d3690c4e28ef41ffe3e467"],"created_at":"2026-09-14T04:24:35Z","created_by_operation":"op_eb8a43c2a8a94738af90adb18e5e76c3","id":"pg_2f0c43bbe4d75c0e8af56f70fecc5cba","maturity":"draft","page_type":"source","path":"pages/sources/syncora-ai-synthetic-ai-developer-productivity-dataset-readme-md-d9e69-6f70f