{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9863cfd26a467fda82c4be1692baa297cbbfc4b1d2d687a3b1a956b577ca97ad"],"opposing_claim_ids":[],"text":"The monorepo includes packages/server (daemon with agent orchestration, WebSocket API, MCP server), packages/app (Expo client), packages/cli, packages/desktop (Electron), packages/relay, and packages/website."},{"claim_ids":["clm_c23e96086ce2f2ce61e3545c3e5bfa5f750660f0de1a8284832580bc615eae56"],"opposing_claim_ids":[],"text":"Repository development practice: contributors must run typecheck and lint after every change, run only the specific vitest file they changed (never the full suite locally), and push to CI for full-suite verification."}],"claim_ids":["clm_9863cfd26a467fda82c4be1692baa297cbbfc4b1d2d687a3b1a956b577ca97ad","clm_c23e96086ce2f2ce61e3545c3e5bfa5f750660f0de1a8284832580bc615eae56"],"created_at":"2026-09-14T01:51:08Z","created_by_operation":"op_bf679629b4c44e6593d0a01dbe5bb2fa","id":"pg_2f1b470b74a9517e8da8254f601bb22d","maturity":"draft","page_type":"source","path":"pages/sources/getpaseo-paseo-claude-md-d1b705a0cd91-254f601bb22d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9cdaa3379332574ca1ca47b3256d4d2d"],"title":"getpaseo/paseo/CLAUDE.md @ d1b705a0cd91","updated_at":"2026-09-14T01:51:08Z","updated_by_operation":"op_bf679629b4c44e6593d0a01dbe5bb2fa"}
