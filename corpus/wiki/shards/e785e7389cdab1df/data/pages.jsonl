{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_56b57de6a40331a99a3cdbc05b25b9105f794c093ff62757c7ff2b17e6b69a75"],"opposing_claim_ids":[],"text":"NOTICE.md credits ActivePieces for the integrations registry (630+ pieces), Yjs for real-time collaborative editing, and the Model Context Protocol for agentic tool extensibility."}],"claim_ids":["clm_56b57de6a40331a99a3cdbc05b25b9105f794c093ff62757c7ff2b17e6b69a75"],"created_at":"2026-09-14T01:46:25Z","created_by_operation":"op_fb340d411e814b7eaaa1d9e1d16172b3","id":"pg_b4b26a3f922056f793976f3d2173496f","maturity":"draft","page_type":"source","path":"pages/sources/doable-me-doable-notice-md-0be4ebf5df45-6f3d2173496f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_08541aaf957950d1aaeab4357e1c2427"],"title":"doable-me/Doable/NOTICE.md @ 0be4ebf5df45","updated_at":"2026-09-14T01:46:25Z","updated_by_operation":"op_fb340d411e814b7eaaa1d9e1d16172b3"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_682cb12bee88ae9e62aa1a364f5cd61bc82c64d6ad251bad67c5fdedcc9c7837"],"opposing_claim_ids":[],"text":"The provider catalog supports 63 providers and 19+ local model engines via BYOK, with a universal bridge accepting openai, azure, and anthropic wire protocols and six auth methods."},{"claim_ids":["clm_88f196027b89c5b431dd145a3d9d30d0313c296ee63edfa28124ec9d581d80ed"],"opposing_claim_ids":[],"text":"Any OpenAI-compatible endpoint can be added as a custom provider from the admin panel by specifying a display name, base URL, wire protocol, auth header pattern, and model IDs."}],"claim_ids":["clm_682cb12bee88ae9e62aa1a364f5cd61bc82c64d6ad251bad67c5fdedcc9c7837","clm_88f196027b89c5b431dd145a3d9d30d0313c296ee63edfa28124ec9d581d80ed"],"created_at":"2026-09-14T01:46:25Z","created_by_operation":"op_fb340d411e814b7eaaa1d9e1d16172b3","id":"pg_e3e0c2c44ade5d2b8383c272339615f7","maturity":"draft","page_type":"source","path":"pages/sources/doable-me-doable-docs-providers-md-0be4ebf5df45-c272339615f7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ac2081fe692c5b8a9e5c0e1f237b5805"],"title":"doable-me/Doable/docs/PROVIDERS.md @ 0be4ebf5df45","updated_at":"2026-09-14T01:46:25Z","updated_by_operation":"op_fb340d411e814b7eaaa1d9e1d16172b3"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_57178c3f0daa9a446c86d34b3666dbf3d0e8c84a02c408d158fed4560ac6ec76"],"opposing_claim_ids":[],"text":"Deployment is offered via one-click buttons for DigitalOcean, Render, Railway, Heroku, and GitHub Codespaces, plus Coolify, Fly.io, and Kubernetes manifests, all backed by prebuilt ghcr images."},{"claim_ids":["clm_57e3703b5bf6b7c62413a51eb7535bd8f1539f98139d7fff2fdc9d3a43bd52b8"],"opposing_claim_ids":[],"text":"The product advertises multi-tenant workspaces, sandboxed code execution by default, audit logs, MFA, and RBAC, under an MIT license."},{"claim_ids":["clm_6103a2e6e21683255d0c051a5422fafc72653bbaecbe7dfc4552be2edeb21fbc"],"opposing_claim_ids":[],"text":"Tenant isolation is enforced at the PostgreSQL layer via row-level security using doable.current_user_id session variables for workspace-scoped queries."},{"claim_ids":["clm_69aed95c00cfa929d1d1c2456b202a3bae0d3f6a41424994d7a337d0446c822f"],"opposing_claim_ids":[],"text":"AI-generated code runs in per-project Linux UIDs with systemd hardening, seccomp filtering, and an egress firewall, enabled by default; dovault and docore packages provide the bubblewrap jail and process isolation."},{"claim_ids":["clm_7134b2c5333f4fcf94a98cdf89e4e6e2d5fd3e4320d4b052f24aecc3711de8bc"],"opposing_claim_ids":[],"text":"The monorepo uses pnpm workspaces plus Turborepo, with a Next.js web app (port 3000), Hono API (4000), Hono WebSocket service with Yjs (4001), and PostgreSQL 16 (5432)."},{"claim_ids":["clm_78fa8c360733ed2d3e425962a2f47f1798c1c5f7280fbaedac8f2ed72895b619"],"opposing_claim_ids":[],"text":"A Rust TUI CLI named doable can provision a server over SSH and also serves as a platform-admin TUI for users, roles, feature flags, provider keys, credits, and sandbox rules."},{"claim_ids":["clm_8b143e460f7ef20a76818d91116aed8dbda2bb657cdc0bc40c0c82968a0f6983"],"opposing_claim_ids":[],"text":"Doable is described as a self-hosted AI app builder for teams that builds, deploys, and hosts apps on the operator's own infrastructure."},{"claim_ids":["clm_cb4797e39a0e17fee273825fce068cce0adac02712334f487392e1bb29f0111d"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are directed to CONTRIBUTING.md, and local development runs via pnpm install and pnpm dev after forking and cloning."},{"claim_ids":["clm_d2d307c03dce52fd550085c921d8bf4f761df7fbc6f094da60a3722ca84a3234"],"opposing_claim_ids":[],"text":"SSO/SAML and SCIM are stated as roadmap items; the current identity features are TOTP MFA, RBAC, and audit logs."}],"claim_ids":["clm_57178c3f0daa9a446c86d34b3666dbf3d0e8c84a02c408d158fed4560ac6ec76","clm_57e3703b5bf6b7c62413a51eb7535bd8f1539f98139d7fff2fdc9d3a43bd52b8","clm_6103a2e6e21683255d0c051a5422fafc72653bbaecbe7dfc4552be2edeb21fbc","clm_69aed95c00cfa929d1d1c2456b202a3bae0d3f6a41424994d7a337d0446c822f","clm_7134b2c5333f4fcf94a98cdf89e4e6e2d5fd3e4320d4b052f24aecc3711de8bc","clm_78fa8c360733ed2d3e425962a2f47f1798c1c5f7280fbaedac8f2ed72895b619","clm_8b143e460f7ef20a76818d91116aed8dbda2bb657cdc0bc40c0c82968a0f6983","clm_cb4797e39a0e17fee273825fce068cce0adac02712334f487392e1bb29f0111d","clm_d2d307c03dce52fd550085c921d8bf4f761df7fbc6f094da60a3722ca84a3234"],"created_at":"2026-09-14T01:46:25Z","created_by_operation":"op_fb340d411e814b7eaaa1d9e1d16172b3","id":"pg_e426f71abe96504584cf1c831522faf8","maturity":"draft","page_type":"source","path":"pages/sources/doable-me-doable-readme-md-0be4ebf5df45-1c831522faf8.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7f91853cd43c5347b87c1272fd5a8e7b"],"title":"doable-me/Doable/README.md @ 0be4ebf5df45","updated_at":"2026-09-14T01:46:25Z","updated_by_operation":"op_fb340d411e814b7eaaa1d9e1d16172b3"}
