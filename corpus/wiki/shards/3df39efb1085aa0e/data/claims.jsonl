{"access":"public","created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_79f0bccc15085c6d6f5922e37564e57589feb2e4621790fb300e8edc77649634","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"coder/xum@fbbea2b16403 snapshot 519b231f1435b189","timeframe":null},"slice_ids":["slc_073995d34330122dc04dbabe88013e75676f07f165a6515256b71f3aec9d19b5","slc_86cefa550c3cbf327e89bcbb5b12bd3b7a0013e461c6118031c3d061572f51b8","slc_96cbaf79472a431b8b4edb72acd77e902ef54e740b7dbf06a68954e8290ea131","slc_9865b5bf1e54e468e1f062f2c3f2092e79e3343672dd7b42822aceeac16c7dea"],"source_ids":["src_beea4aa40c935a5ea4dd8658dc51ddd9","src_cba1cb1f801256259be40250d6d30a15"],"text":"Xum is a coding-agent multiplexer that runs parallel agents, each in its own isolated workspace, with a central view of git divergence; runtimes include local directories, git worktrees, and SSH remote execution.","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
