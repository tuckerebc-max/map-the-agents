{"access":"public","created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ae4318a0f2f69f6411a51610b4ba2a514d1bd895e79805c447cb395a68f9dd36","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"coder/xum@fbbea2b16403 snapshot 519b231f1435b189","timeframe":null},"slice_ids":["slc_b7f8eca314032cbcc305262417295ebd64978e21514aebcec28081326cf30d62","slc_c33448ed88d33106d3c5970c1b7ca2da1ae5247df37839a95b7bed34cb17c8e8"],"source_ids":["src_beea4aa40c935a5ea4dd8658dc51ddd9","src_cba1cb1f801256259be40250d6d30a15"],"text":"The project is licensed under AGPL-3.0 (version 3 of the GNU Affero General Public License), copyright Coder Technologies, Inc.","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
{"access":"public","created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b916462f5c03094e21402d3237f0369b2dcc8baa35f813b05d6538c51c0597ae","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"coder/xum@fbbea2b16403 snapshot 519b231f1435b189","timeframe":null},"slice_ids":["slc_6b07755c516484dad03e9acdc560d86287c0c668dafa0a33572b496ff42a663a","slc_9ae44d79a7fc56332b3802844b7ac8488b29236152157c635d0d6c7d67635f5c","slc_c2391661d6c8692bb7da7dcf32b830ba09eadb43e5aefba0f2170363417e106f","slc_dc77cf4f93f91321f5c010f2c75aac4a70b851336e0373f561cc6cd518019d9f","slc_f88e96c89975644bce5d8578d7c92219c7f0d6dc11a5ae1905e17789a43e10f9"],"source_ids":["src_04fd2151e4c35bf2be7a571fd807cb92"],"text":"Tool hooks let users run their own scripts around tool executions: `.xum/tool_pre` runs before every tool and a non-zero exit blocks the tool with the error shown to the agent; `.xum/tool_post` runs after tools and reports failures via hook_output.","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
{"access":"public","created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d4f60a455fd7c8c3144c118644502e1dd488a051684758cb7c070e05425de8a3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"coder/xum@fbbea2b16403 snapshot 519b231f1435b189","timeframe":null},"slice_ids":["slc_547e36af1e4695f8fba7969e40481aa0e52ec0a790542ef5593c53f8f1e3e248","slc_96f6a512d60ad571ce239c3e030905343cee8161b5fe9e85209070c4eea608d5","slc_e82c3ae20d98f954676b7bdf3ccd58ae809dc661f3382861aab8bcd5a9239cd3"],"source_ids":["src_04fd2151e4c35bf2be7a571fd807cb92"],"text":"A `.xum/tool_env` file is sourced (not executed) before every bash tool call to configure the shell environment, affecting only bash tools; hooks must finish within 10 seconds or be terminated.","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
{"access":"public","created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d8eec0153141ea63c52567e4958c50d9d903eb666b13d3afee02b3790425a16a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"coder/xum@fbbea2b16403 snapshot 519b231f1435b189","timeframe":null},"slice_ids":["slc_313dc67fdd33cf12c2bc73d2ea44a76643257bd7237381fd9cab8ed7947c08c6","slc_6230e3089c4619a65b590c682e1a38b9aa096177cd4bcdb4325fa7c0dac55ac5","slc_970e7a00c07c749a66106270efc2223933f2beaf1233c8d44f7b01f0e3c9cc36","slc_fe8d5791f425176325dd983d41051effb8ec989a41761f88801fe5d482b4acbf"],"source_ids":["src_04fd2151e4c35bf2be7a571fd807cb92"],"text":"Hooks receive environment variables such as XUM_TOOL, XUM_WORKSPACE_ID, and XUM_TOOL_INPUT_PATH; tool input is flattened into XUM_TOOL_INPUT_<...> variables with fields over 8KB omitted, and hooks are looked up first at project level (.xum/) then user level (~/.xum/).","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
{"access":"public","created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e1015f08e7883bc2517b0f2d8b775ac0aeeba453268062488b79d5fc275a1817","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"coder/xum@fbbea2b16403 snapshot 519b231f1435b189","timeframe":null},"slice_ids":["slc_53a54a0ca852f7449379c4be1109aeeb172142b65240ba2a72fdc3be735d970c","slc_c8ef80cdaa84071d884a955d97c2296abf551ca98b764529e91899adebacd16a","slc_f847ec7024c2063e5f92f954bf348755286b063007905f988319c7ae5ae9bd67"],"source_ids":["src_a0fbf653b13452be8a1581109ea7d98a"],"text":"Release distribution includes signed/notarized macOS DMGs (separate Intel and Apple Silicon builds), a Linux AppImage, and a Windows installer exe; only main-branch builds are signed, so PR builds need Gatekeeper bypass on macOS.","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
{"access":"public","created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ede2b000b3899b1ef050a5e4526d80d4c18de1bc3ee4549498eb6d257d0ccfbc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"coder/xum@fbbea2b16403 snapshot 519b231f1435b189","timeframe":null},"slice_ids":["slc_1bbce693a10b74d5917ee0d508976c16b948641c6b1dbc0e6829e574caa14c5f","slc_513983cf14cb8ff991e09a04ee2656730f719e9e95243e101f84d7766931dd3d","slc_a058077d64b2a3046d926a17ddfb6f78adf7188269944d12bfa3e8fad1d345f0","slc_f847ec7024c2063e5f92f954bf348755286b063007905f988319c7ae5ae9bd67"],"source_ids":["src_04fd2151e4c35bf2be7a571fd807cb92","src_a0fbf653b13452be8a1581109ea7d98a"],"text":"Windows support is in alpha, requires Git for Windows (WSL is explicitly not supported), and tool hooks are documented as experimental with expected breaking changes.","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
