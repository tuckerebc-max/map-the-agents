{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3e69f344286be336ffe7f8c428e1cda6aa1beee7adcc15aa88992ad6ef6ac4c1"],"opposing_claim_ids":[],"text":"A CLI is available via npm: `npx @coder/xum run \"...\"` runs agent tasks and `npx @coder/xum server --port 3000` starts a server for remote/mobile access; the legacy `mux` package forwards to Xum during the rename transition."},{"claim_ids":["clm_e1015f08e7883bc2517b0f2d8b775ac0aeeba453268062488b79d5fc275a1817"],"opposing_claim_ids":[],"text":"Release distribution includes signed/notarized macOS DMGs (separate Intel and Apple Silicon builds), a Linux AppImage, and a Windows installer exe; only main-branch builds are signed, so PR builds need Gatekeeper bypass on macOS."},{"claim_ids":["clm_ede2b000b3899b1ef050a5e4526d80d4c18de1bc3ee4549498eb6d257d0ccfbc"],"opposing_claim_ids":[],"text":"Windows support is in alpha, requires Git for Windows (WSL is explicitly not supported), and tool hooks are documented as experimental with expected breaking changes."}],"claim_ids":["clm_3e69f344286be336ffe7f8c428e1cda6aa1beee7adcc15aa88992ad6ef6ac4c1","clm_e1015f08e7883bc2517b0f2d8b775ac0aeeba453268062488b79d5fc275a1817","clm_ede2b000b3899b1ef050a5e4526d80d4c18de1bc3ee4549498eb6d257d0ccfbc"],"created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","id":"pg_e213c21eb4b7589092f199796353ba23","maturity":"draft","page_type":"source","path":"pages/sources/coder-xum-docs-install-mdx-fbbea2b16403-99796353ba23.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a0fbf653b13452be8a1581109ea7d98a"],"title":"coder/xum/docs/install.mdx @ fbbea2b16403","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
