{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_81ace0a7e8c3b7c7d11b5bd31411a2bf69b207724c032669e198802972f04ed2"],"opposing_claim_ids":[],"text":"Repository development practice: a documentation style guide (STYLE.md) instructs writers to skip obvious or expected behavior, document deviations and complex workflows, and follow conventions for mermaid diagrams; new pages need frontmatter and docs.json navigation entries."}],"claim_ids":["clm_81ace0a7e8c3b7c7d11b5bd31411a2bf69b207724c032669e198802972f04ed2"],"created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","id":"pg_2cf68c4a0ca1579daf2d0d7454210530","maturity":"draft","page_type":"source","path":"pages/sources/coder-xum-docs-style-md-fbbea2b16403-0d7454210530.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_33eb57d139c259aba6d6b5b23925abc5"],"title":"coder/xum/docs/STYLE.md @ fbbea2b16403","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_b916462f5c03094e21402d3237f0369b2dcc8baa35f813b05d6538c51c0597ae"],"opposing_claim_ids":[],"text":"Tool hooks let users run their own scripts around tool executions: `.xum/tool_pre` runs before every tool and a non-zero exit blocks the tool with the error shown to the agent; `.xum/tool_post` runs after tools and reports failures via hook_output."},{"claim_ids":["clm_d4f60a455fd7c8c3144c118644502e1dd488a051684758cb7c070e05425de8a3"],"opposing_claim_ids":[],"text":"A `.xum/tool_env` file is sourced (not executed) before every bash tool call to configure the shell environment, affecting only bash tools; hooks must finish within 10 seconds or be terminated."},{"claim_ids":["clm_d8eec0153141ea63c52567e4958c50d9d903eb666b13d3afee02b3790425a16a"],"opposing_claim_ids":[],"text":"Hooks receive environment variables such as XUM_TOOL, XUM_WORKSPACE_ID, and XUM_TOOL_INPUT_PATH; tool input is flattened into XUM_TOOL_INPUT_<...> variables with fields over 8KB omitted, and hooks are looked up first at project level (.xum/) then user level (~/.xum/)."},{"claim_ids":["clm_ede2b000b3899b1ef050a5e4526d80d4c18de1bc3ee4549498eb6d257d0ccfbc"],"opposing_claim_ids":[],"text":"Windows support is in alpha, requires Git for Windows (WSL is explicitly not supported), and tool hooks are documented as experimental with expected breaking changes."}],"claim_ids":["clm_b916462f5c03094e21402d3237f0369b2dcc8baa35f813b05d6538c51c0597ae","clm_d4f60a455fd7c8c3144c118644502e1dd488a051684758cb7c070e05425de8a3","clm_d8eec0153141ea63c52567e4958c50d9d903eb666b13d3afee02b3790425a16a","clm_ede2b000b3899b1ef050a5e4526d80d4c18de1bc3ee4549498eb6d257d0ccfbc"],"created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","id":"pg_2d80cefa0b8b5446ad9d5ade1a67b669","maturity":"draft","page_type":"source","path":"pages/sources/coder-xum-docs-hooks-tools-mdx-fbbea2b16403-5ade1a67b669.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_04fd2151e4c35bf2be7a571fd807cb92"],"title":"coder/xum/docs/hooks/tools.mdx @ fbbea2b16403","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_79f0bccc15085c6d6f5922e37564e57589feb2e4621790fb300e8edc77649634"],"opposing_claim_ids":[],"text":"Xum is a coding-agent multiplexer that runs parallel agents, each in its own isolated workspace, with a central view of git divergence; runtimes include local directories, git worktrees, and SSH remote execution."},{"claim_ids":["clm_8c2a446b27271eca602381c34353bdc6498f8f8c2a591069699e668ee42a99ce"],"opposing_claim_ids":[],"text":"The product supports multiple model families (sonnet-4-*, grok-*, gpt-5-*, opus-4-*), with Ollama for local LLMs and OpenRouter for a long tail of providers."},{"claim_ids":["clm_ae4318a0f2f69f6411a51610b4ba2a514d1bd895e79805c447cb395a68f9dd36"],"opposing_claim_ids":[],"text":"The project is licensed under AGPL-3.0 (version 3 of the GNU Affero General Public License), copyright Coder Technologies, Inc."}],"claim_ids":["clm_79f0bccc15085c6d6f5922e37564e57589feb2e4621790fb300e8edc77649634","clm_8c2a446b27271eca602381c34353bdc6498f8f8c2a591069699e668ee42a99ce","clm_ae4318a0f2f69f6411a51610b4ba2a514d1bd895e79805c447cb395a68f9dd36"],"created_at":"2026-09-14T03:41:45Z","created_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd","id":"pg_404ca9fa97b25a9e85767e8898ca4d0b","maturity":"draft","page_type":"source","path":"pages/sources/coder-xum-docs-index-mdx-fbbea2b16403-7e8898ca4d0b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_cba1cb1f801256259be40250d6d30a15"],"title":"coder/xum/docs/index.mdx @ fbbea2b16403","updated_at":"2026-09-14T03:41:45Z","updated_by_operation":"op_f2c0ed5113c342dab92b4e5c02ebe0dd"}
