{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5520e7cf4664fe490f8fbf413b110c6800dbc186a494db4386388c40e6d1efc9"],"opposing_claim_ids":[],"text":"Repository development practice: organizational contributions additionally require a CCLA or equivalent written authorization from an authorized signer, with the authorization number registered in corporate-authorizations.json and cited in the PR."}],"claim_ids":["clm_5520e7cf4664fe490f8fbf413b110c6800dbc186a494db4386388c40e6d1efc9"],"created_at":"2026-09-14T03:08:27Z","created_by_operation":"op_418ad8133a844c8fbe550c3cc81c61cb","id":"pg_46b43b7f6a535a739a5aed95ea1d1483","maturity":"draft","page_type":"source","path":"pages/sources/golutra-golutra-cla-md-8b68a14183af-ed95ea1d1483.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5a5ce90dbbab5a3ab5f266ba50923268"],"title":"golutra/golutra/CLA.md @ 8b68a14183af","updated_at":"2026-09-14T03:08:27Z","updated_by_operation":"op_418ad8133a844c8fbe550c3cc81c61cb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5520e7cf4664fe490f8fbf413b110c6800dbc186a494db4386388c40e6d1efc9"],"opposing_claim_ids":[],"text":"Repository development practice: organizational contributions additionally require a CCLA or equivalent written authorization from an authorized signer, with the authorization number registered in corporate-authorizations.json and cited in the PR."},{"claim_ids":["clm_fd9873b6a2fc473dc7f0500500e19e2ef4b381c661443d7cb4e12124ba568670"],"opposing_claim_ids":[],"text":"Repository development practice: contributors must fork, create a feature branch, open a PR with a template disclosing identity, third-party sources, AI assistance, and co-authors, and sign the ICLA via a bot-managed CLA check."}],"claim_ids":["clm_5520e7cf4664fe490f8fbf413b110c6800dbc186a494db4386388c40e6d1efc9","clm_fd9873b6a2fc473dc7f0500500e19e2ef4b381c661443d7cb4e12124ba568670"],"created_at":"2026-09-14T03:08:27Z","created_by_operation":"op_418ad8133a844c8fbe550c3cc81c61cb","id":"pg_505f9d719fb85a009710498ae571de70","maturity":"draft","page_type":"source","path":"pages/sources/golutra-golutra-contributing-md-8b68a14183af-498ae571de70.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1ecb2c0ced425aa5a1b8447ccef7d7ff"],"title":"golutra/golutra/CONTRIBUTING.md @ 8b68a14183af","updated_at":"2026-09-14T03:08:27Z","updated_by_operation":"op_418ad8133a844c8fbe550c3cc81c61cb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2309b0ca8846d5d0ed21469d0219af3a227f69bcb45441899e186f8ebb83503d"],"opposing_claim_ids":[],"text":"The project is distributed under Business Source License 1.1, with commercial use of golutra as a tool allowed and user-produced outputs belonging to users."},{"claim_ids":["clm_2ba93a3f097803dfe4f2057e66d5ab2567a146eae7e2dc5ce55bc69185c83369"],"opposing_claim_ids":[],"text":"The app is built with Vue 3 and Rust as a Tauri desktop application targeting Windows, macOS, and Linux."},{"claim_ids":["clm_4952aae15cc7ebb7e8e739db852811674685bf112259bbd11e1b672592cb4a87"],"opposing_claim_ids":[],"text":"The README states the project is at an early stage, with a CEO Agent layer, agent self-evolution, cross-device migration, and mobile remote control listed as future capabilities rather than current ones."},{"claim_ids":["clm_4a8e2c89256370914e6ba21bd5ac87d0cfb4849b924a1c909d2567e219599ed7"],"opposing_claim_ids":[],"text":"Users can click agent avatars to inspect logs, inject prompts directly into terminal streams, and monitor execution while agents run in the background."},{"claim_ids":["clm_501497353dc2fc7e02a667e906f4d781e8b5ab5b836f904efd0f6c89ed2c0543"],"opposing_claim_ids":[],"text":"The product supports custom workflows with one-click template import/export, aimed at long-running automation across varied scenarios such as novel writing and video production."},{"claim_ids":["clm_853e41970a48b1abc2e321bfcb9a25750a264aab1cde00336ff483cec533e4ba"],"opposing_claim_ids":[],"text":"A companion project, golutra-mcp, provides a way to connect external tools and agents through golutra-cli for MCP-based workflow integration."},{"claim_ids":["clm_87b7e72a5730c92b327a22725230477c8da40cd8a76a7ad79352426f8a77e7a5"],"opposing_claim_ids":[],"text":"The product supports a compatibility layer for multiple CLI agents, listing Claude Code, Gemini CLI, Codex CLI, OpenCode, Qwen Code, OpenClaw, and 'Any CLI'."},{"claim_ids":["clm_af32b348b5ad9f7cf35e3443251466b0aa4c381dc2e93fddef8bf4b62016df53"],"opposing_claim_ids":[],"text":"golutra is described as a multi-agent workspace that turns existing CLI tools into a unified AI collaboration hub, emphasizing parallel execution, orchestration, and real-time result tracking."}],"claim_ids":["clm_2309b0ca8846d5d0ed21469d0219af3a227f69bcb45441899e186f8ebb83503d","clm_2ba93a3f097803dfe4f2057e66d5ab2567a146eae7e2dc5ce55bc69185c83369","clm_4952aae15cc7ebb7e8e739db852811674685bf112259bbd11e1b672592cb4a87","clm_4a8e2c89256370914e6ba21bd5ac87d0cfb4849b924a1c909d2567e219599ed7","clm_501497353dc2fc7e02a667e906f4d781e8b5ab5b836f904efd0f6c89ed2c0543","clm_853e41970a48b1abc2e321bfcb9a25750a264aab1cde00336ff483cec533e4ba","clm_87b7e72a5730c92b327a22725230477c8da40cd8a76a7ad79352426f8a77e7a5","clm_af32b348b5ad9f7cf35e3443251466b0aa4c381dc2e93fddef8bf4b62016df53"],"created_at":"2026-09-14T03:08:27Z","created_by_operation":"op_418ad8133a844c8fbe550c3cc81c61cb","id":"pg_cc599b0a255f5b8997086d5488d8ad09","maturity":"draft","page_type":"source","path":"pages/sources/golutra-golutra-readme-md-8b68a14183af-6d5488d8ad09.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9f8282dbdcfe5a94877bdbe2e19edf92"],"title":"golutra/golutra/README.md @ 8b68a14183af","updated_at":"2026-09-14T03:08:27Z","updated_by_operation":"op_418ad8133a844c8fbe550c3cc81c61cb"}
