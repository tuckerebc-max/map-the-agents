f6b74d0","maturity":"draft","page_type":"entity","path":"pages/entities/openautocoder-agentless-36bd8f6b74d0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"openautocoder/agentless","updated_at":"2026-09-14T04:13:59Z","updated_by_operation":"op_f8378fdd190a43bc88e6c0ac6e900d13"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_26431d3167774d453f21f3f0d6cc485651a9a38155f63fccc0c05e54fae50996"],"opposing_claim_ids":[],"text":"Repair samples multiple candidate patches per bug in a simple diff format, with context windows around each edit location."},{"claim_ids":["clm_499cdd9aa559cbe400f9166db0da9acd32e9a0fe92b031516658c3e5fd974644"],"opposing_claim_ids":[],"text":"Reported results: with Claude 3.5 Sonnet, 40.7% and 50.8% solve rates on SWE-bench Lite and Verified; v1.0 achieved 27.3% (82 fixes) on SWE-bench Lite at ~$0.34 per issue."},{"claim_ids":["clm_a72d597e3d509cc7383c4a2406b18d4b5f4257f3833cd6a77c180f0d22c11895"],"opposing_claim_ids":[],"text":"Localization is hierarchical: faults are first localized to files, then to classes/functions, then to fine-grained edit locations."},{"claim_ids":["clm_be892d20062dc631b9474dbf2160838bd9bf9391131841f9eb34e9bdfa48f3b1"],"opposing_claim_ids":[],"text":"The tool requires an OpenAI API key exported as OPENAI_API_KEY, and requirements include openai, anthropic, tiktoken, libcst, llama-index, and the SWE-bench package."},{"claim_ids":["clm_d51faede34c1415543919d2a51badad21019a37c116123e50ef0634ff8f1dfec"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are asked to install a pre-commit hook for standardized code style."},{"claim_ids":["clm_ea4f1685fabc66a7ba2c25042f1702330a91fd6683a34494797a0b3eab05595b"],"opposing_claim_ids":[],"text":"Agentless solves software development issues without an agent loop, using a three-phase process: localization, repair, and patch validation."},{"claim_ids":["clm_f0e5e51d052be817ae8712f42304656f921c343d5e04e1a47b9ff2117769ec16"],"opposing_claim_ids":[],"text":"Patch validation runs selected regression tests plus generated reproduction tests, and results are used to re-rank and select the final patch."}],"claim_ids":["clm_26431d3167774d453f21f3f0d6cc485651a9a38155f63fccc0c05e54fae50996","clm_499cdd9aa559cbe400f9166db0da9acd32e9a0fe92b031516658c3e5fd974644","clm_a72d597e3d509cc7383c4a2406b18d4b5f4257f3833cd6a77c180f0d22c11895","clm_be892d20062dc631b9474dbf2160838bd9bf9391131841f9eb34e9bdfa48f3b1","clm_d51faede34c1415543919d2a51badad21019a37c116123e50ef0634ff8f1dfec","clm_ea4f1685fabc66a7ba2c25042f1702330a91fd6683a34494797a0b3eab05595b","clm_f0e5e51d052be817ae8712f42304656f921c343d5e04e1a47b9ff2117769ec16"],"created_at":"2026-09-14T04:13:59Z","created_by_operation":"op_f8378fdd190a43bc88e6c0ac6e900d13","id":"pg_6d30c7902287568794b626c761a284f7","maturity":"draft","page_type":"source","path":"pages/sources/openautocoder-agentless-readme-md-5ce5888b9f14-26c761a284f7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_87037666b2445846be7bb1862de8dfb9"],"title":"OpenAutoCoder/Agentless/README.md @ 5ce5888b9f14","updated_at":"2026-09-14T04:13:59Z","updated_by_operation":"op_f8378fdd190a43bc88e6c0ac6e900d13"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_26431d3167774d453f21f3f0d6cc485651a9a38155f63fccc0c05e54fae50996"],"opposing_claim_ids":[],"text":"Repair samples multiple candidate patches per bug in a simple diff format, with context windows around each edit location."},{"claim_ids":["clm_44e59be57b2f874052be59b9133920cb4f4054210d85b168b6f04d2e63404e41"],"opposing_claim_ids":[],"text":"File-level localization combines LLM-predicted suspicious files with embedding-based retrieval, after LLM-identified irrelevant folders are filtered out."},{"claim_ids":["clm_5c1b40b678c008fbaadd96e618ef4eac364ed69af1f7d6d3533b3c5d498b616e"],"opposing_claim_ids":[],"text":"Regression tests are chosen from all tests passing on the original repository rather than the benchmark's PASS_TO_PASS field."},{"claim_ids":["clm_8c6b77670962c4fdc5666434dd14d3270f94de24ddd205c1821bfcfe6c116cbe"],"opposing_claim_ids":[],"text":"Embedding-based retrieval uses OpenAI's text-embedding-3-small model."},{"claim_ids":["clm_a72d597e3d509cc7383c4a2406b18d4b5f4257f3833cd6a77c180f0d22c11895"],"opposing_claim_ids":[],"text":"Localization is hierarchical: faults are first localized to files, then to classes/functions, then to fine-grained edit locations."},{"claim_ids":["clm_be892d20062dc631b9474dbf2160838bd9bf9391131841f9eb34e9bdfa48f3b1"],"opposing_claim_ids":[],"text":"The tool requires an OpenAI API key exported as OPENAI_API_KEY, and requirements include openai, anthropic, tiktoken, libcst, llama-index, and the SWE-bench package."},{"claim_ids":["clm_ca3c3a89874780b424d41fb68f2146326b1e460d34bdbafac0ee087440018ae2"],"opposing_claim_ids":[],"text":"The benchmark dataset is selectable via --dataset, defaulting to SWE-bench Lite, with SWE-bench Verified also supported."},{"claim_ids":["clm_ed3ce18c5b72eb6be11eb06fef3ca810f7d69e53c7d5cc26956a9fce0cbbe64b"],"opposing_claim_ids":[],"text":"The tool is operated via CLI scripts (e.g., agentless/fl/localize.py, repair/repair.py, rerank.py) with flags like --dataset, --target_id, --num_threads, and --max_samples."},{"claim_ids":["clm_f0e5e51d052be817ae8712f42304656f921c343d5e04e1a47b9ff2117769ec16"],"opposing_claim_ids":[],"text":"Patch validation runs selected regression tests plus generated reproduction tests, and results are used to re-rank and select the final patch."}],"claim_ids":["clm_26431d3167774d453f21f3f0d6cc485651a9a38155f63fccc0c05e54fae50996","clm_44e59be57b2f874052be59b9133920cb4f4054210d85b168b6f04d2e63404e41","clm_5c1b40b678c008fbaadd96e618ef4eac364ed69af1f7d6d3533b3c5d498b616e","clm_8c6b77670962c4fdc5666434dd14d3270f94de24ddd205c1821bfcfe6c116cbe","clm_a72d597e3d509cc7383c4a2406b18d4b5f4257f3833cd6a77c180f0d22c11895","clm_be892d20062dc631b9474dbf2160838bd9bf9391131841f9eb34e9bdfa48f3b1","clm_ca3c3a89874780b424d41fb68f2146326b1e460d34bdbafac0ee087440018ae2","clm_ed3ce18c5b72eb6be11eb06fef3ca810f7d69e53c7d5cc26956a9fce0cbbe64b","clm_f0e5e51d052be817ae8712f42304656f921c343d5e04e1a47b9ff2117769ec16"],"created_at":"2026-09-14T04:13:59Z","created_by_operation":"op_f8378fdd190a43bc88e6c0ac6e900d13","id":"pg_7fb653b1ca8955d0a323173d73fc7966","maturity":"draft","page_type":"source","path":"pages/sources/openautocoder-agentless-readme-swebench-md-5ce5888b9f14-173d73fc7966.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_250162f4fa4f55e59e05634f77d12fab"],"title":"OpenAutoCoder/Agentless/README_swebench.md @ 5ce5888b9f14","updated_at":"2026-09-14T04:13:59Z","updated_by_operation":"op_f8378fdd190a43bc88e6c0ac6e900d13"}
