{"access":"public","created_at":"2026-09-14T01:33:23Z","created_by_operation":"op_d5ea6a7300a44eb09cc27720437ea275","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_995cc8bc0a92f10e884a566b4cc04a29fd2f1c0402e50d2f6ac6bcec4a363058","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"amersarhan/darce-cli@1b90c379ab74 snapshot edcbe6956310fb55","timeframe":null},"slice_ids":["slc_8b20af5ef9c1798c7e5999b79d982bff03dd91d769cf289655fce84aa3dbc94d","slc_d5b6815da267739f2f7c352d1a7a1fa46877e3a3093f9c3945202722fb92973c"],"source_ids":["src_5b993453bf495e249f5f9762f2459fb8"],"text":"Darce includes smart routing that automatically picks a model per task, and users can override routing with rules in a ~/.darcerc config file mapping conditions like large-context or complex-reasoning to specific models.","updated_at":"2026-09-14T01:33:23Z","updated_by_operation":"op_d5ea6a7300a44eb09cc27720437ea275"}
