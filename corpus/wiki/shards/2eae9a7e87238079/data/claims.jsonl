{"access":"public","created_at":"2026-09-14T04:33:00Z","created_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2638e2eca2b71744afad6bfde96cadb892cca5a2a8d10ed60f8f2efc92f90acf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"xmudeeplit/legalgraphrag@a3c9c3070cad snapshot 5a8097f9031a88cf","timeframe":null},"slice_ids":["slc_1b0473f47efae135c9866a16f18a141663f5bcdf3b21aecbd0a52f35c1aae276"],"source_ids":["src_b5791b2764635c33b58ac93e89a92955"],"text":"The default embedding endpoint is http://localhost:11434/api/embed with model bge-m3; both are configurable in configs/main.env and used by graph construction and retrieval.","updated_at":"2026-09-14T04:33:00Z","updated_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed"}
{"access":"public","created_at":"2026-09-14T04:33:00Z","created_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3deeee6918b08e5091745913ea9dc4decb462e0fe2c434e7a90f2365a2c71cb9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"xmudeeplit/legalgraphrag@a3c9c3070cad snapshot 5a8097f9031a88cf","timeframe":null},"slice_ids":["slc_54785d9084450ba7e6c9b9860e1a2556ab2f1f7f5864abaa9d2a0b34d11ce0ec","slc_8533d1c37d64be00b7d8ea10cbce98a8beb5f13bc5417381155383b50f190dde"],"source_ids":["src_b5791b2764635c33b58ac93e89a92955"],"text":"The constructed graph is persisted to a pickle file (e.g. outputs/main_experiment/qwen3_graph_db.pkl); later runs can skip construction, and changing the construction model requires --force-rebuild or a different graph_db_path.","updated_at":"2026-09-14T04:33:00Z","updated_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed"}
{"access":"public","created_at":"2026-09-14T04:33:00Z","created_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_43bbceab113b58c7ba6290df541a0bda88203cb3cf67f3f03f3f628e5980aba8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"xmudeeplit/legalgraphrag@a3c9c3070cad snapshot 5a8097f9031a88cf","timeframe":null},"slice_ids":["slc_8760f18a9c278de20fd8c66495c9531cc3db45c6b8776201917cbe65323303f3","slc_b9218de73726f3c6f56260c925944b939e6f2d6b16025154595ee8667357e209"],"source_ids":["src_b5791b2764635c33b58ac93e89a92955"],"text":"The framework computes legal judgment prediction metrics: charge and law-article exact-match accuracy and Micro-F1, plus imprisonment term exact match and mean absolute error in months.","updated_at":"2026-09-14T04:33:00Z","updated_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed"}
{"access":"public","created_at":"2026-09-14T04:33:00Z","created_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_76fa19e420250ca5f943589b6273de2b3d3684a1b472083a6f3b004453f33ef5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"xmudeeplit/legalgraphrag@a3c9c3070cad snapshot 5a8097f9031a88cf","timeframe":null},"slice_ids":["slc_24a1b7ad476c55795e9284ec99afa1bd61c8c13fdf67bd52330f5de251cb79d9","slc_83b355f2f592df10b0fb2d05924b8c8bd41713d74d5518db2f8bae95d37ef741"],"source_ids":["src_25f9af1c0dcd587f85e08e09bdf8f74d","src_b5791b2764635c33b58ac93e89a92955"],"text":"Baseline systems such as HippoRAG2, RAPTOR, LightRAG, LegalDelta, and ADAPT are not included in the repository; their outputs can be compared externally if converted to the same result schema.","updated_at":"2026-09-14T04:33:00Z","updated_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed"}
{"access":"public","created_at":"2026-09-14T04:33:00Z","created_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7bcf281d59c4c4eb0f8b23ad8d84584d263161c473053741723deda57ca97bd0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"xmudeeplit/legalgraphrag@a3c9c3070cad snapshot 5a8097f9031a88cf","timeframe":null},"slice_ids":["slc_2c439638a439ec7222f5a9b6f558eb87ca44ba6e7fe2a321e578c04a47cbaae5","slc_f9b2c54914394c4e5ddfa4eb5a398589adaeabf2c4310a0bcc5851ce75adf8f1"],"source_ids":["src_23653b1cd0d2544cab566501d8dd65f6"],"text":"Declared dependencies include torch>=2.6.0, transformers>=4.51.0, accelerate, numpy, scipy, networkx, tqdm, requests, python-dotenv, and openai>=1.0.0 for the DeepSeek/GPT-4o-mini API client.","updated_at":"2026-09-14T04:33:00Z","updated_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed"}
{"access":"public","created_at":"2026-09-14T04:33:00Z","created_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7dfabf1b7d113fd9093664ff4388bb23dc5d965c4fc71bca532a14965288d19c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"xmudeeplit/legalgraphrag@a3c9c3070cad snapshot 5a8097f9031a88cf","timeframe":null},"slice_ids":["slc_bd32fd981e1d0a74888af9c9f186351470a48e65716de01b86f59513db71efc4","slc_d8661ddbe8553ac0b153e4407b6acbf35c9f8ed57807cc84a7d599cb6c6a22d6"],"source_ids":["src_b5791b2764635c33b58ac93e89a92955"],"text":"Supported model choices include qwen3, qwen2_5, gemma3, internlm3, glm4, deepseek_v3, and gpt4o_mini; prompt_language=zh or en in .env selects Chinese or English prompts.","updated_at":"2026-09-14T04:33:00Z","updated_by_operation":"op_7902b62292994c7dbf7fd2daef5812ed"}
