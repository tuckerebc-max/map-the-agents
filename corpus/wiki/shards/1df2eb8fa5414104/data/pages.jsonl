c2650","maturity":"draft","page_type":"entity","path":"pages/entities/cactus-compute-needle-d821e7cc2650.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"cactus-compute/needle","updated_at":"2026-09-14T03:40:37Z","updated_by_operation":"op_ed8b945d28aa4763ae4aa9f74db5227c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1d420df65fb5faf82007fa72f2259b0162051296301856c51f473b188d73b4ee"],"opposing_claim_ids":[],"text":"The repository is the Python package cactus-needle covering inference, LoRA fine-tuning, and export; the inference engine is fetched once from Hugging Face and cached."},{"claim_ids":["clm_270696d65805383ec97ef3c7814e31ec64b6b883df3b13e64def131e237f870e"],"opposing_claim_ids":[],"text":"Every response carries a calibrated confidence score from a learned head, defined as the minimum of a post-hoc head score and the decoding probability of the call tokens; users set a threshold and escalate below it."},{"claim_ids":["clm_348d2201733e5695078f30a40b91ddafa25cf0cd2b2e0e7d87ac019012ff9b96"],"opposing_claim_ids":[],"text":"The documented fine-tuning workflow is: optionally synthesize data via needle generate-data (needs OPENROUTER_API_KEY), LoRA fine-tune with needle finetune (defaults epochs 3, lora-rank 16, lr 1e-4), then merge and quantize with needle build into a .cact archive."},{"claim_ids":["clm_527cef466feb87996281312d8fba7dd5282bf122bbcd45f59b202a367e63e0c3"],"opposing_claim_ids":[],"text":"The model is said to be compressed to CQ2-bit via Cactus Quants and built on the Simple Attention Network findings, baked into its own engine."},{"claim_ids":["clm_5ed679f2e3751906f4447a3da39fcd759fca00470c005f58ce48157e09f8fb21"],"opposing_claim_ids":[],"text":"Needle 2 is described as an open 45M-parameter model for tool calling, device use and structured extraction, shipped as a single 14MB binary that runs a session in about 28MB of RAM."},{"claim_ids":["clm_6dc5efe24d6c7f87c67060a7435ab98d951335969ae7f7e09b193b4d8c77b5ee"],"opposing_claim_ids":[],"text":"The runtime install excludes training; fine-tuning and export need the [train] extra (JAX, imported lazily), with [train,gpu] for CUDA and [train,metal] for Apple Silicon; Pydantic is used for typed extraction."},{"claim_ids":["clm_d8073d6887fd543270ac5fc17e391f6154679e4a3bb9390a7be34bc512635444"],"opposing_claim_ids":[],"text":"Tool calls are constrained by a byte-level grammar compiled from the declared schemas, so output is structured JSON and cannot be malformed; the reasoning field is generated unconstrained."},{"claim_ids":["clm_df2769309b4444b276236564b419700a85cde2a56aa5b21b4954b96582998b69"],"opposing_claim_ids":[],"text":"The runtime uses a 256-token sliding window with tools pinned as KV sinks, which the README says keeps total memory near 28MB regardless of conversation length."},{"claim_ids":["clm_f170c7f8620d525fa3b69b90323ac4653aa4e10ee719e0d73995ee1b1e7814fe"],"opposing_claim_ids":[],"text":"For catalogues above five tools, a built-in contrastive retrieval head embeds schemas at init and renders only the top five tools per turn, rebuilding the grammar over that subset."}],"claim_ids":["clm_1d420df65fb5faf82007fa72f2259b0162051296301856c51f473b188d73b4ee","clm_270696d65805383ec97ef3c7814e31ec64b6b883df3b13e64def131e237f870e","clm_348d2201733e5695078f30a40b91ddafa25cf0cd2b2e0e7d87ac019012ff9b96","clm_527cef466feb87996281312d8fba7dd5282bf122bbcd45f59b202a367e63e0c3","clm_5ed679f2e3751906f4447a3da39fcd759fca00470c005f58ce48157e09f8fb21","clm_6dc5efe24d6c7f87c67060a7435ab98d951335969ae7f7e09b193b4d8c77b5ee","clm_d8073d6887fd543270ac5fc17e391f6154679e4a3bb9390a7be34bc512635444","clm_df2769309b4444b276236564b419700a85cde2a56aa5b21b4954b96582998b69","clm_f170c7f8620d525fa3b69b90323ac4653aa4e10ee719e0d73995ee1b1e7814fe"],"created_at":"2026-09-14T03:40:37Z","created_by_operation":"op_ed8b945d28aa4763ae4aa9f74db5227c","id":"pg_5ab77cba061655a4ac8310e1007c93e9","maturity":"draft","page_type":"source","path":"pages/sources/cactus-compute-needle-readme-md-956840ff176b-10e1007c93e9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b88739974450536385313501a8bc2262"],"title":"cactus-compute/needle/README.md @ 956840ff176b","updated_at":"2026-09-14T03:40:37Z","updated_by_operation":"op_ed8b945d28aa4763ae4aa9f74db5227c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_10ec3ced1b0716cebbcbd2a2c3d7862b2d8fcb258afb359b76c7612a6414e80e"],"opposing_claim_ids":[],"text":"The Python API exposes needle.Needle(tools, system, weights, tool_index_path, buffer_size), agent.run/complete/embed/reset, needle.tool, needle.Field, and needle.extract; tools can be decorated functions, Pydantic models, raw JSON schemas, or a JSON string."},{"claim_ids":["clm_6dc5efe24d6c7f87c67060a7435ab98d951335969ae7f7e09b193b4d8c77b5ee"],"opposing_claim_ids":[],"text":"The runtime install excludes training; fine-tuning and export need the [train] extra (JAX, imported lazily), with [train,gpu] for CUDA and [train,metal] for Apple Silicon; Pydantic is used for typed extraction."},{"claim_ids":["clm_b073d68618295e2f8c1f250d99780f2a392de26d6043f2bd702bafa0c830bf56"],"opposing_claim_ids":[],"text":"Each turn returns one JSON object with fields including type, success, error, function_calls, reasoning, confidence, prefill_tps, decode_tps, and peak_ram_mb; empty function_calls is the off-topic refusal."}],"claim_ids":["clm_10ec3ced1b0716cebbcbd2a2c3d7862b2d8fcb258afb359b76c7612a6414e80e","clm_6dc5efe24d6c7f87c67060a7435ab98d951335969ae7f7e09b193b4d8c77b5ee","clm_b073d68618295e2f8c1f250d99780f2a392de26d6043f2bd702bafa0c830bf56"],"created_at":"2026-09-14T03:40:37Z","created_by_operation":"op_ed8b945d28aa4763ae4aa9f74db5227c","id":"pg_a26bf5e5992152a3bfe5caab0b0a9828","maturity":"draft","page_type":"source","path":"pages/sources/cactus-compute-needle-llms-txt-956840ff176b-caab0b0a9828.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_76c380e9f3915540bfc83d876ba7e8f5"],"title":"cactus-compute/needle/llms.txt @ 956840ff176b","updated_at":"2026-09-14T03:40:37Z","updated_by_operation":"op_ed8b945d28aa4763ae4aa9f74db5227c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_10ec3ced1b0716cebbcbd2a2c3d7862b2d8fcb258afb359b76c7612a6414e80e"],"opposing_claim_ids":[],"text":"The Python API exposes needle.Needle(tools, system, weights, tool_index_path, buffer_size), agent.run/complete/embed/reset, needle.tool, needle.Field, and needle.extract; tools can be decorated functions, Pydantic models, raw JSON schemas, or a JSON string."},{"claim_ids":["clm_270696d65805383ec97ef3c7814e31ec64b6b883df3b13e64def131e237f870e"],"opposing_claim_ids":[],"text":"Every response carries a calibrated confidence score from a learned head, defined as the minimum of a post-hoc head score and the decoding probability of the call tokens; users set a threshold and escalate below it."},{"claim_ids":["clm_91ac23d2434e7ee7770189d0be48da5f1878558cfb6ba0ee877e442f96305f56"],"opposing_claim_ids":[],"text":"agent.run() drives a full agentic loop (max_steps=8 default): the model picks calls, Needle executes the user's Python functions, feeds results back, and returns final results; ungrounded fields are refused unless strict=False."},{"claim_ids":["clm_b073d68618295e2f8c1f250d99780f2a392de26d6043f2bd702bafa0c830bf56"],"opposing_claim_ids":[],"text":"Each turn returns one JSON object with fields including type, success, error, function_calls, reasoning, confidence, prefill_tps, decode_tps, and peak_ram_mb; empty function_calls is the off-topic refusal."},{"claim_ids":["clm_d8073d6887fd543270ac5fc17e391f6154679e4a3bb9390a7be34bc512635444"],"opposing_claim_ids":[],"text":"Tool calls are constrained by a byte-level grammar compiled from the declared schemas, so output is structured JSON and cannot be malformed; the reasoning field is generated unconstrained."},{"claim_ids":["clm_f170c7f8620d525fa3b69b90323ac4653aa4e10ee719e0d73995ee1b1e7814fe"],"opposing_claim_ids":[],"text":"For catalogues above five tools, a built-in contrastive retrieval head embeds schemas at init and renders only the top five tools per turn, rebuilding the grammar over that subset."}],"claim_ids":["clm_10ec3ced1b0716cebbcbd2a2c3d7862b2d8fcb258afb359b76c7612a6414e80e","clm_270696d65805383ec97ef3c7814e31ec64b6b883df3b13e64def131e237f870e","clm_91ac23d2434e7ee7770189d0be48da5f1878558cfb6ba0ee877e442f96305f56","clm_b073d68618295e2f8c1f250d99780f2a392de26d6043f2bd702bafa0c830bf56","clm_d8073d6887fd543270ac5fc17e391f6154679e4a3bb9390a7be34bc512635444","clm_f170c7f8620d525fa3b69b90323ac4653aa4e10ee719e0d73995ee1b1e7814fe"],"created_at":"2026-09-14T03:40:37Z","created_by_operation":"op_ed8b945d28aa4763ae4aa9f74db5227c","id":"pg_ec614d6e152b50c6b07dea23974a9df5","maturity":"draft","page_type":"source","path":"pages/sources/cactus-compute-needle-doc-apis-md-956840ff176b-ea23974a9df5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6559d3ef6e4d5fb5b8414d9e38d4fe96"],"title":"cactus-compute/needle/doc/apis.md @ 956840ff176b","updated_at":"2026-09-14T03:40:37Z","updated_by_operation":"op_ed8b945d28aa4763ae4aa9f74db5227c"}
