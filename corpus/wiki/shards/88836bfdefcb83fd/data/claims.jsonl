{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1e2f175ef1c4747f7b1aa4e44fc2f010bb5954e1300de34d9e33e7c8373b4158","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_209ffe2dc0514626afb6ca9e56c805bfd49cd233293a282de4e44c78ac850fc9","slc_33205c49ab82321c18e456a9c3ceac56a66aec13c1340ce04f49bf125268e65e"],"source_ids":["src_1c341940c7515a309ea0b7fd5ef74e2a"],"text":"The product is BYOK: it does not force a specific AI provider, and documentation lists supported keys including OpenAI, Anthropic, OpenRouter, Google Gemini, Mistral, Groq, xAI, DeepSeek, and Ollama/LM Studio or custom OpenAI-compatible endpoints.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_35065921992e004b63afc5b65fdd405026d2a867d0eca8cd5d0ee2338084c472","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_61a9502d8b2eda0a5c096576e9b069158514257c61318835323ede2ec893890e","slc_bbfd5213e37f1051b8bd6ef536996aea9c9e1d3a218a77520f6857168e7e5393","slc_be8d1a71ed395510b06f0d7fc54e24c438bef2ccf8d36113b7671e7c16448f80"],"source_ids":["src_3a2fe95fd7fc5e1e9be358dbc96bf5d5"],"text":"The spec calls for both single-user mode (first user becomes instance admin owning everything) and multi-user organization mode with teams, roles, groups, permissions, shared keys, quotas, and scoped environments.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5bdfb26ef1e354f8cbbe5e8baa9786fcfc96754272cc7bd00ca44506ff399ed3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_9e9e94179061afb4212a6112d4cfc8418cc0cfecd4ddbbcc21dd19199fee2d89"],"source_ids":["src_3a2fe95fd7fc5e1e9be358dbc96bf5d5"],"text":"The project specification targets a self-hostable alternative to tools like v0, Lovable, Bolt, Replit Agent, or Cursor-style agents, emphasizing local-first development, BYOK access, Docker-based execution, multi-project workspaces, and auditable AI-driven changes.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.5,"id":"clm_5c1bcd742bb9dad38d3646a731a70163d67878a6e7d4c1fd23eaa9adf832ed1e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=inference; facet=tools-permissions","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_179833f04463a97c1939abb845a2000f8ce7ef9d357eb0003248223c6e33defd","slc_61a7748ce926d05b17ae7c88443fccebf9a836bde421e9f0cd1b259d4d1b18f1","slc_b0dc163bc4052afa8b0d18bbbf4589739330dce0845c2e30d8be420764c22018","slc_b56f4ccd1a6d05aea77bb83fe8128d7f684bfed1aa277bd141bdf3d652603514","slc_f113a3da36ef00d63a5d038d730647d4ae2d2f27152f192593639920f9cb6842"],"source_ids":["src_3a2fe95fd7fc5e1e9be358dbc96bf5d5"],"text":"The specification envisions a permissioned tool system (filesystem, shell, docker, env, database, network tools) with risk levels and approval requirements, and states the agent should never have raw unrestricted access; this is a design goal, not verified runtime behavior.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5d9100d5c44897ec2ac9e389f8ba0a6907932f67d63eeae6232aad31ff52363a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_0e8afc225009c212735f5db5a3ca3aaf816dcd6b73397761d2d7c3a1854a6840"],"source_ids":["src_92d709ad7385564a852f5e97e513e5af"],"text":"The backend (apps/server) is an Express application on Node.js using TypeScript, responsible for API routing, an agent loop with SSE-streamed LLM responses, Docker orchestration, and SQLite metadata storage.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b612a2d4c7c9abb771f957328717229e629414a48adcb5bc701ef21252950550","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_3b66e862d087f40ccc1585936931f93475e2b60b580ce99df8d05ab57b34d853","slc_622e0b59328b9c01bc776fb0542277c294882bab767f9d86bddcd550a4e78f52"],"source_ids":["src_1c341940c7515a309ea0b7fd5ef74e2a"],"text":"Provider and service credentials can be configured at personal-user, workspace, organization, and global admin-managed levels, and all keys are AES-GCM encrypted at rest.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c29a242e29d2aaa2b2e09f37629326a9db8e9ad257196324124698b97d2d5f17","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_0e8afc225009c212735f5db5a3ca3aaf816dcd6b73397761d2d7c3a1854a6840","slc_91b1dc03b26424d7a8c515aa3f063809e03e9d4b99568f2a616dcb815c5bf5f3"],"source_ids":["src_92d709ad7385564a852f5e97e513e5af"],"text":"The browser client communicates with the Express API over REST, SSE, and WebSocket, and the backend manages interactive shells via WebSocket.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e007aa779d0827cb75d9e77a4d5dffc2eb2ad237cee1d1197e549223957fe770","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_282db1cc8ef7f3c4dbb56486ca4a5adf2860d146997ebc098a63b14acd987862","slc_d74e959ea06c2aa5e9c34616052cefedb57ebd7b3af5d0de95a95cba6795c43f"],"source_ids":["src_92d709ad7385564a852f5e97e513e5af"],"text":"Singulary is a monorepo with a React frontend and an Express backend; in production the frontend is built to static assets and served by the same Express process that exposes the API under /api.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e6be9196497b053573dee7d3a6fdcd15fb7ec8ac364a14c07270e61f8c58fa76","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_12aaba0fb8fd77de1f0b3831a04b62fd5865682c4656c47d82c70c323645c4e2","slc_808e1e078e103fe0f06955aea037012db328bd74fef9c0424824c108a72466fd","slc_b47f92f28886ca3da5257d361f3e606e3faae73558c7dd01faa95526aa04e531"],"source_ids":["src_92d709ad7385564a852f5e97e513e5af"],"text":"Frontend data flow follows View -> hook -> service -> API, with hooks writing results into Zustand stores that cache fetched data; mutations update stores and hooks may expose refetch() to bypass the cache.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f0aa1e354583391d27e16712a01167dbf73da0dd39532d9279fc33f1294d4288","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_0e8afc225009c212735f5db5a3ca3aaf816dcd6b73397761d2d7c3a1854a6840","slc_d74e959ea06c2aa5e9c34616052cefedb57ebd7b3af5d0de95a95cba6795c43f"],"source_ids":["src_92d709ad7385564a852f5e97e513e5af"],"text":"SQLite stores instance metadata by default at storage/singulary.sqlite, tracking user accounts, token limits, rules, and workspace topology.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","evidence_type":"organizational_statement","extraction_confidence":0.5,"id":"clm_f239b708e01d83ee9c63082dc710844c3f8cf8c799b35469ad4ed159f7cd1b57","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=inference; facet=memory-state","setting":"sammwyy/singulary@5b51298504a4 snapshot 27be8bccf199f5ab","timeframe":null},"slice_ids":["slc_1984ff12249caa43c86432e5c708053bd21efb1e7ff95b956374865d45ed8c41","slc_878ec644da2ae256d8a58b924e80c81735e4dcde6f3973d3489b09480c30e666","slc_9a04e18c33163fd2cc28394e26c1578242532a00b2131bb56a57671460cf1e74","slc_9ff576dddc4e47638010e9f9cb8a733484a68d0eeb0a1594077ca37dee69a965","slc_e4a0f75d4b1b6856a3652d3be41cd67b27665331f284e862ac3d44f281170285"],"source_ids":["src_3a2fe95fd7fc5e1e9be358dbc96bf5d5"],"text":"The spec describes a snapshot-based filesystem where every AI change should be reversible, using content-addressed blobs, tree objects, diffs, branching, and restore operations similar to Git internally; this is stated as a design target rather than confirmed implemented behavior.","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
