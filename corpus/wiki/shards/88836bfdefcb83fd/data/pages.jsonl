{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1e2f175ef1c4747f7b1aa4e44fc2f010bb5954e1300de34d9e33e7c8373b4158"],"opposing_claim_ids":[],"text":"The product is BYOK: it does not force a specific AI provider, and documentation lists supported keys including OpenAI, Anthropic, OpenRouter, Google Gemini, Mistral, Groq, xAI, DeepSeek, and Ollama/LM Studio or custom OpenAI-compatible endpoints."},{"claim_ids":["clm_b612a2d4c7c9abb771f957328717229e629414a48adcb5bc701ef21252950550"],"opposing_claim_ids":[],"text":"Provider and service credentials can be configured at personal-user, workspace, organization, and global admin-managed levels, and all keys are AES-GCM encrypted at rest."}],"claim_ids":["clm_1e2f175ef1c4747f7b1aa4e44fc2f010bb5954e1300de34d9e33e7c8373b4158","clm_b612a2d4c7c9abb771f957328717229e629414a48adcb5bc701ef21252950550"],"created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","id":"pg_0d77b0696c585924967b7f5d9a4ee68d","maturity":"draft","page_type":"source","path":"pages/sources/sammwyy-singulary-docs-byok-md-5b51298504a4-7f5d9a4ee68d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1c341940c7515a309ea0b7fd5ef74e2a"],"title":"sammwyy/singulary/docs/byok.md @ 5b51298504a4","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","id":"pg_2033abe4681e55c395a5f7126e24223d","maturity":"draft","page_type":"source","path":"pages/sources/sammwyy-singulary-roadmap-md-5b51298504a4-f7126e24223d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_066d644dcba259a981e03525c68f908a"],"title":"sammwyy/singulary/ROADMAP.md @ 5b51298504a4","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","id":"pg_27873e2e57a850c19bbb9f772aabd2d2","maturity":"draft","page_type":"source","path":"pages/sources/sammwyy-singulary-todo-md-5b51298504a4-9f772aabd2d2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3ece6d1a3d5757cfa85a37ced375bb54"],"title":"sammwyy/singulary/TODO.md @ 5b51298504a4","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_35065921992e004b63afc5b65fdd405026d2a867d0eca8cd5d0ee2338084c472"],"opposing_claim_ids":[],"text":"The spec calls for both single-user mode (first user becomes instance admin owning everything) and multi-user organization mode with teams, roles, groups, permissions, shared keys, quotas, and scoped environments."},{"claim_ids":["clm_5bdfb26ef1e354f8cbbe5e8baa9786fcfc96754272cc7bd00ca44506ff399ed3"],"opposing_claim_ids":[],"text":"The project specification targets a self-hostable alternative to tools like v0, Lovable, Bolt, Replit Agent, or Cursor-style agents, emphasizing local-first development, BYOK access, Docker-based execution, multi-project workspaces, and auditable AI-driven changes."},{"claim_ids":["clm_5c1bcd742bb9dad38d3646a731a70163d67878a6e7d4c1fd23eaa9adf832ed1e"],"opposing_claim_ids":[],"text":"The specification envisions a permissioned tool system (filesystem, shell, docker, env, database, network tools) with risk levels and approval requirements, and states the agent should never have raw unrestricted access; this is a design goal, not verified runtime behavior."},{"claim_ids":["clm_f239b708e01d83ee9c63082dc710844c3f8cf8c799b35469ad4ed159f7cd1b57"],"opposing_claim_ids":[],"text":"The spec describes a snapshot-based filesystem where every AI change should be reversible, using content-addressed blobs, tree objects, diffs, branching, and restore operations similar to Git internally; this is stated as a design target rather than confirmed implemented behavior."}],"claim_ids":["clm_35065921992e004b63afc5b65fdd405026d2a867d0eca8cd5d0ee2338084c472","clm_5bdfb26ef1e354f8cbbe5e8baa9786fcfc96754272cc7bd00ca44506ff399ed3","clm_5c1bcd742bb9dad38d3646a731a70163d67878a6e7d4c1fd23eaa9adf832ed1e","clm_f239b708e01d83ee9c63082dc710844c3f8cf8c799b35469ad4ed159f7cd1b57"],"created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","id":"pg_5effa74a015b5a7697ca8c71572491f6","maturity":"draft","page_type":"source","path":"pages/sources/sammwyy-singulary-project-md-5b51298504a4-8c71572491f6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3a2fe95fd7fc5e1e9be358dbc96bf5d5"],"title":"sammwyy/singulary/PROJECT.md @ 5b51298504a4","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5d9100d5c44897ec2ac9e389f8ba0a6907932f67d63eeae6232aad31ff52363a"],"opposing_claim_ids":[],"text":"The backend (apps/server) is an Express application on Node.js using TypeScript, responsible for API routing, an agent loop with SSE-streamed LLM responses, Docker orchestration, and SQLite metadata storage."},{"claim_ids":["clm_c29a242e29d2aaa2b2e09f37629326a9db8e9ad257196324124698b97d2d5f17"],"opposing_claim_ids":[],"text":"The browser client communicates with the Express API over REST, SSE, and WebSocket, and the backend manages interactive shells via WebSocket."},{"claim_ids":["clm_e007aa779d0827cb75d9e77a4d5dffc2eb2ad237cee1d1197e549223957fe770"],"opposing_claim_ids":[],"text":"Singulary is a monorepo with a React frontend and an Express backend; in production the frontend is built to static assets and served by the same Express process that exposes the API under /api."},{"claim_ids":["clm_e6be9196497b053573dee7d3a6fdcd15fb7ec8ac364a14c07270e61f8c58fa76"],"opposing_claim_ids":[],"text":"Frontend data flow follows View -> hook -> service -> API, with hooks writing results into Zustand stores that cache fetched data; mutations update stores and hooks may expose refetch() to bypass the cache."},{"claim_ids":["clm_f0aa1e354583391d27e16712a01167dbf73da0dd39532d9279fc33f1294d4288"],"opposing_claim_ids":[],"text":"SQLite stores instance metadata by default at storage/singulary.sqlite, tracking user accounts, token limits, rules, and workspace topology."},{"claim_ids":["clm_fd3cdf004ae18f452e19063e3fef75fafd7efe0110999b0fcf7c5c29408993d6"],"opposing_claim_ids":[],"text":"The frontend (apps/web) is a React app powered by Vite and styled with Tailwind CSS, organized into components, hooks, services, Zustand stores, utils, and views directories."}],"claim_ids":["clm_5d9100d5c44897ec2ac9e389f8ba0a6907932f67d63eeae6232aad31ff52363a","clm_c29a242e29d2aaa2b2e09f37629326a9db8e9ad257196324124698b97d2d5f17","clm_e007aa779d0827cb75d9e77a4d5dffc2eb2ad237cee1d1197e549223957fe770","clm_e6be9196497b053573dee7d3a6fdcd15fb7ec8ac364a14c07270e61f8c58fa76","clm_f0aa1e354583391d27e16712a01167dbf73da0dd39532d9279fc33f1294d4288","clm_fd3cdf004ae18f452e19063e3fef75fafd7efe0110999b0fcf7c5c29408993d6"],"created_at":"2026-09-14T02:38:43Z","created_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd","id":"pg_61dc97eed4e856258839c8ba5a1cea20","maturity":"draft","page_type":"source","path":"pages/sources/sammwyy-singulary-architecture-md-5b51298504a4-c8ba5a1cea20.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_92d709ad7385564a852f5e97e513e5af"],"title":"sammwyy/singulary/ARCHITECTURE.md @ 5b51298504a4","updated_at":"2026-09-14T02:38:43Z","updated_by_operation":"op_bbcd3e39ac324605a577049e9e1c08cd"}
