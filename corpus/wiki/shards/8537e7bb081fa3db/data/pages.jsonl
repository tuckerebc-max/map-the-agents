4d41d28b389f0","maturity":"draft","page_type":"entity","path":"pages/entities/ivan-magda-swift-coding-agent-d41d28b389f0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"ivan-magda/swift-coding-agent","updated_at":"2026-09-14T02:06:02Z","updated_by_operation":"op_d8f1370880f54e9e9262a4f628e5477f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5601df09bb8dad95d73edc0f749ecee859d71fb5bded3288e1a217f90834e305"],"opposing_claim_ids":[],"text":"Stage 01 gives the model a single bash tool, executed via Foundation's Process running /bin/bash -c, with pipe data read before waitUntilExit to avoid a roughly 64 KB buffer deadlock."},{"claim_ids":["clm_573f0405798151bd993c21f5aa24d5deb4759da65039fad1081e0ec518841e03"],"opposing_claim_ids":[],"text":"The loop body is invariant across stages; each stage only adds tool handler entries and injection points before the API call, with tools varying while the loop stays identical."},{"claim_ids":["clm_924396de8ef692691ef2d159ba6a789a144038b0b84c8766fd8c8bc7a9504ee5"],"opposing_claim_ids":[],"text":"The messages array lives on the Agent instance so conversation history persists across REPL turns, and each API call sends the entire accumulated history, which grows without bound until later context compaction."}],"claim_ids":["clm_5601df09bb8dad95d73edc0f749ecee859d71fb5bded3288e1a217f90834e305","clm_573f0405798151bd993c21f5aa24d5deb4759da65039fad1081e0ec518841e03","clm_924396de8ef692691ef2d159ba6a789a144038b0b84c8766fd8c8bc7a9504ee5"],"created_at":"2026-09-14T02:06:02Z","created_by_operation":"op_d8f1370880f54e9e9262a4f628e5477f","id":"pg_43b2900c0bd950539f6236bf9c1bbe03","maturity":"draft","page_type":"source","path":"pages/sources/ivan-magda-swift-coding-agent-docs-s01-md-88ed290dff95-36bf9c1bbe03.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_752caaa0b274585cb48780183a4634f3"],"title":"ivan-magda/swift-coding-agent/docs/s01.md @ 88ed290dff95","updated_at":"2026-09-14T02:06:02Z","updated_by_operation":"op_d8f1370880f54e9e9262a4f628e5477f"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:06:02Z","created_by_operation":"op_d8f1370880f54e9e9262a4f628e5477f","id":"pg_778053dcfe245d90b3faec3d152f6d06","maturity":"draft","page_type":"source","path":"pages/sources/ivan-magda-swift-coding-agent-docs-s04-md-88ed290dff95-ec3d152f6d06.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5481821c162758108e3ab19e04ad75e9"],"title":"ivan-magda/swift-coding-agent/docs/s04.md @ 88ed290dff95","updated_at":"2026-09-14T02:06:02Z","updated_by_operation":"op_d8f1370880f54e9e9262a4f628e5477f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0e977347b396a584775b1845f3bdd2f7bf5e5a3c6a5f7c39262396efd8a83e6f"],"opposing_claim_ids":[],"text":"Tool dispatch is a dictionary mapping tool names to handlers (bash, read_file, write_file, edit_file), returning an unknownTool failure for unregistered names, chosen over a protocol registry for its simplicity."},{"claim_ids":["clm_15612b25f88a32f89245cdbcc3f944aff628a6f7662223c8638da6631f2ca647"],"opposing_claim_ids":[],"text":"File tools enforce path sandboxing: paths are resolved against the working directory and any resolved location that escapes it is rejected with an executionFailed error."}],"claim_ids":["clm_0e977347b396a584775b1845f3bdd2f7bf5e5a3c6a5f7c39262396efd8a83e6f","clm_15612b25f88a32f89245cdbcc3f944aff628a6f7662223c8638da6631f2ca647"],"created_at":"2026-09-14T02:06:02Z","created_by_operation":"op_d8f1370880f54e9e9262a4f628e5477f","id":"pg_7cf2423c5d8652988615e58831d10811","maturity":"draft","page_type":"source","path":"pages/sources/ivan-magda-swift-coding-agent-docs-s02-md-88ed290dff95-e58831d10811.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dc57c4eef518526f9c95b45cf7b3132c"],"title":"ivan-magda/swift-coding-agent/docs/s02.md @ 88ed290dff95","updated_at":"2026-09-14T02:06:02Z","updated_by_operation":"op_d8f1370880f54e9e9262a4f628e5477f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0559886f40371a94cc44038d98afcf1d5526e595ac5604ee00dd42030966ae81"],"opposing_claim_ids":[],"text":"The README states the project is explicitly not a full Claude Code clone, a general-purpose multi-agent framework, or production-ready IDE tooling; the gaps are deliberate."},{"claim_ids":["clm_573f0405798151bd993c21f5aa24d5deb4759da65039fad1081e0ec518841e03"],"opposing_claim_ids":[],"text":"The loop body is invariant across stages; each stage only adds tool handler entries and injection points before the API call, with tools varying while the loop stays identical."},{"claim_ids":["clm_7447858dcbdcaaab82e209d5632265ba932ebf12cde85ecddd1a98d0ed5276e5"],"opposing_claim_ids":[],"text":"The package depends on AsyncHTTPClient (from 1.32.0, SwiftNIO-based) rather than URLSession for cross-platform macOS/Linux HTTP and streaming SSE, built with Swift 6.2 strict concurrency."},{"claim_ids":["clm_77541a28832fe82155a6c0d3835a0406919afbc5387de7db5e727a5039f04db3"],"opposing_claim_ids":[],"text":"The agent runs a fixed while-true loop: append the user query, call the Anthropic API, and if the stop reason is tool use, execute tools and append results as a user message; otherwise return the text content."},{"claim_ids":["clm_b345c5f2e5bf97a35f9c545bfff0620a6c7a5adeeecd3abe1a672b519bb6b281"],"opposing_claim_ids":[],"text":"It is a two-target Swift Package Manager project: a Core library holding the API client, shell executor, agent loop, and tools, plus a thin CLI entry point."},{"claim_ids":["clm_b7841256fffa30db1bd6bcb091df7255cd1d760c01aeba69c1c2f0ca2f83c4f7"],"opposing_claim_ids":[],"text":"The project's thesis is that coding agents benefit more from a small set of excellent tools and a tight loop than from large orchestration layers, deliberately rebuilding Claude Code's restrained design in Swift."},{"claim_ids":["clm_fcfa9bdf7269b6fa9e851458f14f25b152fa49487509ccfce62586eeaf5e7e2d"],"opposing_claim_ids":[],"text":"The agent communicates with POST https://api.anthropic.com/v1/messages over raw HTTP built on AsyncHTTPClient, and the CLI executable is named `agent`."}],"claim_ids":["clm_0559886f40371a94cc44038d98afcf1d5526e595ac5604ee00dd42030966ae81","clm_573f0405798151bd993c21f5aa24d5deb4759da65039fad1081e0ec518841e03","clm_7447858dcbdcaaab82e209d5632265ba932ebf12cde85ecddd1a98d0ed5276e5","clm_77541a28832fe82155a6c0d3835a0406919afbc5387de7db5e727a5039f04db3","clm_b345c5f2e5bf97a35f9c545bfff0620a6c7a5adeeecd3abe1a672b519bb6b281","clm_b7841256fffa30db1bd6bcb091df7255cd1d760c01aeba69c1c2f0ca2f83c4f7","clm_fcfa9bdf7269b6fa9e851458f14f25b152fa49487509ccfce62586eeaf5e7e2d"],"created_at":"2026-09-14T02:06:02Z","created_by_operation":"op_d8f1370880f54e9e9262a4f628e5477f","id":"pg_a8f58d1422e7588dae5fd80d18c2bb68","maturity":"draft","page_type":"source","path":"pages/sources/ivan-magda-swift-coding-agent-readme-md-88ed290dff95-d80d18c2bb68.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c09e10ca46a8511fb4e20457226b4654"],"title":"ivan-magda/swift-coding-agent/README.md @ 88ed290dff95","updated_at":"2026-09-14T02:06:02Z","updated_by_operation":"op_d8f1370880f54e9e9262a4f628e5477f"}
