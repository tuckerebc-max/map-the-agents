{"access":"public","created_at":"2026-09-14T05:10:29Z","created_by_operation":"op_f5817c4682684389aac22796919f2677","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_af7ff1c591f5c1fdfbf13cdef200f9519480427c2296d09e0322194db337484f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"youssefvdel/qwengate@5220f7d3c50c snapshot f54d993c12067f27","timeframe":null},"slice_ids":["slc_0f0243097b42d85222d6c495301c86548ca6a8405be86560f7258ee89c388336","slc_1c820f15b30451a367d75082669377e07145cb8115a0ebb66e676006c224eeac","slc_558cb57f098525ab081558b0856cc0f50000a04de747c1fb40fd606d2242e450","slc_e40ed08dd023cb217470f51c78d40a8e83ccf5250074519d0e121812426395f0"],"source_ids":["src_a56d4e5f518357be9dcd744c3704c43e","src_eafbf75854c659f28d24f863e771642b"],"text":"Multiple Qwen accounts are rotated round-robin with automatic failover, health-weighted load balancing, rate-limit tracking, and a configurable cooldown (default 2 minutes via RATE_LIMIT_COOLDOWN_MS); sessions are pooled, reused, auto-scaled, and idle-cleaned.","updated_at":"2026-09-14T05:10:29Z","updated_by_operation":"op_f5817c4682684389aac22796919f2677"}
