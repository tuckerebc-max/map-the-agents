{"access":"public","created_at":"2026-09-14T05:10:29Z","created_by_operation":"op_f5817c4682684389aac22796919f2677","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c2003f50adea8886875d8e218602a08f4d9bae63ba63996f0f93370a401e46ab","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"youssefvdel/qwengate@5220f7d3c50c snapshot f54d993c12067f27","timeframe":null},"slice_ids":["slc_150c35917239dbdaa111c47c8cbb94ce62d8f05fea75c58648fab9839488d28c","slc_5ef2a14bd950861454339747fe25b5870e2f5f82328c75671ecc2befa95064c0","slc_6c31658b56db76f8b249e42b94c2b0bf655141d70caea7735d9d0678db92f9ee","slc_a282dc5b8a130ecd90b544a276bcb922ad8250113ee150b8cec60f1a056cd21f","slc_e7ba5745cd3d0c8394351827dcbfb032da055141457038b633ca2639a7680cc6"],"source_ids":["src_a56d4e5f518357be9dcd744c3704c43e"],"text":"Streaming responses use SSE with an initial heartbeat, OpenAI-format chunks, optional reasoning_content deltas for thinking models, and a data: [DONE] terminator; usage appears in the final chunk when requested.","updated_at":"2026-09-14T05:10:29Z","updated_by_operation":"op_f5817c4682684389aac22796919f2677"}
