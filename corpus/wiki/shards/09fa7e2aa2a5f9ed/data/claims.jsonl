{"access":"public","created_at":"2026-09-14T05:10:29Z","created_by_operation":"op_f5817c4682684389aac22796919f2677","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f1f3d12802ca6b66a7c0b30c4f3e4ae695990f3cf3e086089527785f3c746be6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"youssefvdel/qwengate@5220f7d3c50c snapshot f54d993c12067f27","timeframe":null},"slice_ids":["slc_7dc957779d9a29a31642400111e4c8ba483751dc7f39ddbab60be4cfb93629fd","slc_8ecbad17c7d004fa1fa05e39dc6d7a43fd6724e77c7a781ed40cd625625fcdae","slc_94f881b310152ec0d63fa22d7660165966dfe75eee6d0d84094a8cbe3225d4d8","slc_b1d6e7e32ed75d60df76b90fa49f99afa798fff133fb941ec4e2038808faa6bb","slc_d42b3979f306562761c00832827942a36190584840e28730d37d4b7ee6a2909b"],"source_ids":["src_a56d4e5f518357be9dcd744c3704c43e"],"text":"API requests authenticate with an Authorization: Bearer header carrying an API key configured in .env or config.json; leaving API_KEY empty disables authentication.","updated_at":"2026-09-14T05:10:29Z","updated_by_operation":"op_f5817c4682684389aac22796919f2677"}
