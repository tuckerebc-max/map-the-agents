{"access":"public","created_at":"2026-09-14T05:10:29Z","created_by_operation":"op_f5817c4682684389aac22796919f2677","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5fef9a8fea1659b3d876687b845697d7f5e46eb84f2a1504eeb69e00b56aaf41","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"youssefvdel/qwengate@5220f7d3c50c snapshot f54d993c12067f27","timeframe":null},"slice_ids":["slc_1dc4e2988f8130ce01648dc2d159dee86fdca9623aad4e49eac76c700486f8b8","slc_92792603af324697e2e843e9473e6c7ead16812eec2c99ef73021e3b771271c0","slc_969e61fc528d4686efc344542e38c658c5ab0f652ed9490bc8285e7df0b17de3"],"source_ids":["src_eafbf75854c659f28d24f863e771642b"],"text":"A dual-transport design uses Node.js fetch via wreq-js (with TLS fingerprinting) for API calls and reserves Playwright browser automation only for login/auth and initial header extraction.","updated_at":"2026-09-14T05:10:29Z","updated_by_operation":"op_f5817c4682684389aac22796919f2677"}
