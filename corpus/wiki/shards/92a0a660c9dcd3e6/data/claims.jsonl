{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1b3d51ea9be8a14243702471800d099f18f8c626489a1d9f00ba8c6624724018","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_1a3240f0af8afda89a7dafb29d258f54677b4b8b5b9d336248b444fe8c13f8e1","slc_25d42bb162e04d1e6d012ddd15baa0962d5eaf876a74206e71b6d584989a703b","slc_6555e05da640df612d1756431103f67df542e4bbef86590b7a726824cd8f3cf6","slc_6cb10a959c7f5d5a8113cefa319899a3a1059d080328adf3870a3cda141958a9","slc_f2ee146a75cb9041fcda3371e0eea417f25caf9f62b92d8ad869f6201111566b"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"UmaDev is a single Rust binary distributed via an npm shim; the architecture diagram names internal components umadev-agent, umadev-spec, umadev-knowledge, umadev-governance, umadev-contract, umadev-runtime, and umadev-host.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5ff49b74364933a72382a1933458e46ce7217d19863319d9e41708d86e054449","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_981d37e19cf6d4502cfa9cbf52c0e342042b33ffcd1c29dd8fcea4235ef2b036","slc_a7df7515283ca9b72bfa22725ec850793df19ba049920c1d2440e133ef028d5e","slc_d5a15daa948b37e1c7184e3fb8967059273730fa7261b4b76b21b28d6d0db8d8"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"The project's source of truth is the UMADEV_HOST_SPEC_V1 spec document, described as containing 34 normative clauses backed by 113 governance content checks.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6237aa59e5a11703de00c3897d9cbf216bb554ea75f4e4e60e793eee3952706c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_2a393b09e911593b21738430e75085bc3e1b99e1e6e98e0b23e697e9d71aaf24","slc_9020a20258664096c458982849b3016d92f6fb402b3b36c6914ed7cbbb870901","slc_ef9c0ecdfbe2c3a5443c1625a8a7a708eb8950f72684f12c2d004e64f64645e8"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"Five backend integrations are supported via --backend: claude-code (stream-json), codex (app-server JSON-RPC), opencode (serve HTTP/SSE), and grok-build and kimi-code over ACP v1 stdio, each with its own session transport, permission mapping, and resume behavior.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6f75512dcdf1e5ff0b7969397e43ada06d7de53271725b63e37bd72d3eb70f6d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_1687bbcaa6050605b9c56fc4c4997484d40159cd8a30f3320e75d902dfa6f141","slc_354a98e1761e0e72d86cc0c2d433f3801a6352ed0e485f9612d4a8eab43b456d","slc_68cd6c34e2e0257f89cff2d0620182934a0440c179f121ae0b0c02ac670b06fe","slc_df74195fc90a5077e31ea851bc2425be82e0e0a439d804b302d01e763ed647ec"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"A nine-seat team model is described: eight specialist roles (product, architecture, UI/UX, frontend, backend, QA, security, DevOps) plus a coordinator that routes intent, owns the plan, schedules roles, and keeps the audit trail; role verdicts are advisory.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_993ebb77e8a91eeae2fb950504982a6a9134a7d001a83fd63036c40515a3f02b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_3a0dd3c79b7b262ee2444dfdfe77e8b939d8f3d92e5da913e8737d5a05881580","slc_b4d0d690269d92675cfce829756104c210ae7cc6423cb9ee9852ed60a07389e4"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"Governance is fail-open by design: an error path in the governor returns pass rather than a block, and at write time only irreversible findings (leaked secrets, sensitive paths, destructive shell) are hard-blocked while craft issues are flagged for post-write repair.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9e3128113e7a80c2ce9380ed64731374058f6241c5b8b934a65b5c27e2c1da84","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_5fa473c36cb9c162b89d18f6a4ff88116517a372ea0e7801bd05f93557162824","slc_ad2db6f89994616b4ffaac13934dd9297ddc2d29b128e761f73eb851126c8850","slc_e0aa57e5ba4caee72198eb4ac32efebc3462eeec8704ef53fb57a0710094142e"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"Writing roles drive the main session serially under a single-writer rule, while reviewing roles run in parallel on fresh Plan-profile child sessions and return typed RoleVerdicts (accepts, blocking, advisory) over shared blackboard artifacts rather than free-form cross-talk.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_be52936ff546d1358282511ef768887912ba12b5540c9088ed034f03392c1aec","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_637fc236d9f12330a17a0c6e719fe6d690de64c09dcd609d972b1175013b3722","slc_e0aa57e5ba4caee72198eb4ac32efebc3462eeec8704ef53fb57a0710094142e"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"Failures are surfaced honestly as degraded, paused, blocked, incompatible, or failed rather than converted into success; a missing required review becomes an operational Unavailable pause, and critic opinions never replace the deterministic acceptance floor.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cf696fd1ce095f346942e4cb13bf3c392bc7cc8967e15909874b20c79e4f8417","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_96d690fc01e11b8211b76e8fbd1ea65b25daaa421c1038b3fbfbdf4b8d59a77f","slc_d6916868bf108deabe4e1047e5595ea38c89ec1a26ac655c1a27ecc284d7e4e5","slc_e2f4f8e6559f78d61dde80c5aeb173495c7300480d43301127e06ccafa729eac"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"Audit evidence (tool calls, verification runs, critic verdicts) is written as JSONL under .umadev/audit/, and plans are stored in .umadev/plan.json as a dependency plan rendered as a live checklist steerable via /plan.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e582b6fb960e905f2eb96f465b3b540ec8cb2e02347aa603ce4cb784516abd57","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_1320bafd2326abe817e3bd2b93af151a4e7b9f0c2f9dc22e9872ef702a194d34","slc_70bd368f8b676be26b47e1cfdf3befd39d2b6b34a7620234896f05b027ec4ba1","slc_b9d538e190e6ce0a04fda71d3bc92ee2ae6689a3241cdc9734815c66663a7aad","slc_eb1e7c69d90a99d5ff2fdc213ca8387c3871a7005e5ce943d83aa33a809689d8"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"UmaDev owns no model endpoint and requires an externally installed, authenticated base CLI (Claude Code, Codex, OpenCode, Grok Build, or Kimi Code); it never stores or silently replaces the base's credentials or model configuration.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fc17fd496d1c62237bb5bda0189754abb5233946b563b3c0c5148fe00c4e7ce1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_ad2db6f89994616b4ffaac13934dd9297ddc2d29b128e761f73eb851126c8850"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"Plan intent is mapped to each vendor's real permission surface rather than advertised as a uniform hard sandbox; explicit no-write intent, the single-writer rule, and irreversible-action safeguards are described as hard ceilings.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
{"access":"public","created_at":"2026-09-14T03:21:03Z","created_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ffd5082257b0b7b9730df80a1a7a071692e363fa9a7de7f5153c66700bbbee96","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"umacloud/umadev@585262706174 snapshot cf947f1456377b10","timeframe":null},"slice_ids":["slc_492f6c93b58b8970195b9f5f01f60e8664ac20726d02addb773a85876c4961a7","slc_7fe986d576a1a1cb78187d180a7459e9a4656497d74c1bec37686682cbf6a32c","slc_c290323032c154e2c7684d1b527d91a123da3eaeafc385538f60f948a39fecfb"],"source_ids":["src_3fc2b08febc65004b1663af5ef6b3a85"],"text":"A curated markdown knowledge corpus is embedded in the binary and extracted to ~/.umadev/knowledge on first launch; retrieval uses BM25 plus optional vector embeddings fused with RRF and HyDE-style expansion, falling back to BM25-only when vectors are unavailable.","updated_at":"2026-09-14T03:21:03Z","updated_by_operation":"op_07d7c4d3b7ca446a873b55eff04923d3"}
