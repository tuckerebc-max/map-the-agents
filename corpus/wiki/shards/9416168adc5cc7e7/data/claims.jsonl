{"access":"public","created_at":"2026-09-14T02:15:17Z","created_by_operation":"op_949d0912ed0345f095bcb55767adca78","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ee0a970facdf5a50ca9e1417629b50aa5ddf188fc60d7be2002631adcaa26010","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"madarco/agentbox@138c1f585fdb snapshot a04bee36c7612b6b","timeframe":null},"slice_ids":["slc_25828c9126b0773e6dcc3495ebc9ec30855748266b2552ef1b7577ab02e32e00"],"source_ids":["src_7d1b807eeb835257ae2e20000e8b398b"],"text":"Multiple sandbox backends are supported: local Docker, remote Docker, Hetzner, Vercel, and E2B fully supported, with Daytona marked partial; each differs in base image source, snapshot support, and preview URL mechanism.","updated_at":"2026-09-14T02:15:17Z","updated_by_operation":"op_949d0912ed0345f095bcb55767adca78"}
