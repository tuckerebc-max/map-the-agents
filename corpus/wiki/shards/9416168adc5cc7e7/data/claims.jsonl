{"access":"public","created_at":"2026-09-14T02:15:17Z","created_by_operation":"op_949d0912ed0345f095bcb55767adca78","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c0ee8c0af87bc4ac86a6577db657a9bdeb21dc6c2bf753747dc4d9d8b0729427","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"madarco/agentbox@138c1f585fdb snapshot a04bee36c7612b6b","timeframe":null},"slice_ids":["slc_21afb96d724eaf1221ba53a15dd6b57055114fb92efa6a96c975279256bf56ae","slc_5dfab3e400b771427144ff3573de9a0c026924d1fa7e84d812d834a8ded50472","slc_926385478d1a1fe3c43d63c6ff64a8f518e846273e2fb0bb979f3c57aaab8f2f","slc_a17a5aa60d8b7c2bacef76f199f6eb47cc6200f4a71113bb3af1e563c96b15be","slc_abaa3a5cfa801a5da7e0f979513a3843fa0e384fdaf81a56613d56aab80723e0","slc_be2112026b4060bb27f11b606ab5b70dcb79663ec84a80d362ad28c8f82259a2"],"source_ids":["src_7d1b807eeb835257ae2e20000e8b398b"],"text":"The CLI exposes commands grouped as create/run (create, claude), access (url, screen, code, shell, open, logs, dashboard), inspect (list, status, top), lifecycle (start, stop, destroy, pause/unpause), sync (download, cp, checkpoint), and advanced (wait, prune, self-update, config, relay, app).","updated_at":"2026-09-14T02:15:17Z","updated_by_operation":"op_949d0912ed0345f095bcb55767adca78"}
{"access":"public","created_at":"2026-09-14T02:15:17Z","created_by_operation":"op_949d0912ed0345f095bcb55767adca78","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c19d1ef74a63224219b7f6ee6bf44a94476d92f871ae272cb0fe17b21d7caad6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"madarco/agentbox@138c1f585fdb snapshot a04bee36c7612b6b","timeframe":null},"slice_ids":["slc_1c2f834f963a7ac0265a9a4eef330ff97ef96ae8612fcb3bb2ac3ed6b6679990"],"source_ids":["src_7d1b807eeb835257ae2e20000e8b398b"],"text":"Requirements are macOS (arm64 or Intel) or Linux, Docker Desktop or OrbStack, and Node >=20.10; the first create/claude builds a ~1 GB agentbox/box:dev image once, and portless gives box web apps consistent URLs.","updated_at":"2026-09-14T02:15:17Z","updated_by_operation":"op_949d0912ed0345f095bcb55767adca78"}
