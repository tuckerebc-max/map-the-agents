{"access":"public","created_at":"2026-09-14T02:15:17Z","created_by_operation":"op_949d0912ed0345f095bcb55767adca78","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_99bf147b6880b03e234149178b4d9e520a629e84910f95181e7994c58459762c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"madarco/agentbox@138c1f585fdb snapshot a04bee36c7612b6b","timeframe":null},"slice_ids":["slc_912e55322eedf5901ba683456d2ba899ac842948289bfcff74480dbb400e0a72"],"source_ids":["src_7d1b807eeb835257ae2e20000e8b398b"],"text":"Git credentials stay on the local machine, and pushing to the remote repository requires permission requests, as a safety design.","updated_at":"2026-09-14T02:15:17Z","updated_by_operation":"op_949d0912ed0345f095bcb55767adca78"}
