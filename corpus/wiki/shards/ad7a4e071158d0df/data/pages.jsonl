06be30","clm_f0b4eaff9bfd61dfadafa779c03cc1c0b52b1c552efc8a99f4004fc631b0648e","clm_f0bc719b51a6cc4d8cf651e6d7eff4be25db7c6744f706fb35dac3bd80e84735","clm_f4fff1acc6c3d05064011205cbb518bb9045cfe810580aeb275958d2f4ca817b","clm_fd85ed7b6b3d99205c1a0f16c04e6a985ab953ba883efdc8a909df7d1d550203"],"created_at":"2026-09-14T03:28:20Z","created_by_operation":"op_bbf049a53bae4bd6b7b11bf720ea3aac","id":"pg_c59e9e6abc0c597fb39306b7ac35c212","maturity":"draft","page_type":"entity","path":"pages/entities/zoo-code-org-zoo-code-06b7ac35c212.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"zoo-code-org/zoo-code","updated_at":"2026-09-14T03:28:20Z","updated_by_operation":"op_bbf049a53bae4bd6b7b11bf720ea3aac"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_04840c07d9cfa1eecca629a280f5f98b562667278372bb5f8f40ec69e7de273d"],"opposing_claim_ids":[],"text":"Zoo Code is distributed as a VS Code extension (a VS Code Marketplace badge and VSIX installation instructions appear in the README)."},{"claim_ids":["clm_2c8457b16ee28fa59f5b6aaae4738aac0d894c579030d0ac44ab5cd71ddc5bc7"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are welcomed via CONTRIBUTING.md, and the project is licensed Apache 2.0."},{"claim_ids":["clm_68d8c4ca74d8fbd7b7b3989ec690521379ec21ce61598ed9eda4edac72f2685c"],"opposing_claim_ids":[],"text":"The README lists supported model families (Claude, GPT, Gemini, Kimi, GLM, Grok, MiniMax, and others) and providers including Zoo Gateway, Moonshot, Kimi Code, Kenari, Friendli, and OpenCode Go."},{"claim_ids":["clm_723b955f8b99fd97ca4e420cd72e83fb35178aeb8641e91280ebc65061a1f74f"],"opposing_claim_ids":[],"text":"The README disclaimer states Zoo Code provides no warranties for its tools, models, or outputs, which are offered AS IS, and users assume all risks of use."},{"claim_ids":["clm_8272559b96bd282f4815794baeaf08123f373f5b2718f05b1f4dd0eaf88072c4"],"opposing_claim_ids":[],"text":"Repository development practice: versioning and publishing use changesets, with release notes in CHANGELOG.md."},{"claim_ids":["clm_ea1b08c665096b9a098a507087758e8f3dc252f275a0ba4905fce4f3ac5d7b47"],"opposing_claim_ids":[],"text":"Additions over Roo Code include Semble semantic code search, stronger orchestrator delegation with parent/child task recovery, and a Destructive Command Guard that blocks dangerous commands during autonomous runs."},{"claim_ids":["clm_f0b4eaff9bfd61dfadafa779c03cc1c0b52b1c552efc8a99f4004fc631b0648e"],"opposing_claim_ids":[],"text":"Repository development practice: local setup uses pnpm install, the extension runs via VS Code F5 debugging with hot reload, and VSIX builds install through pnpm install:vsix or manual code --install-extension."},{"claim_ids":["clm_f0bc719b51a6cc4d8cf651e6d7eff4be25db7c6744f706fb35dac3bd80e84735"],"opposing_claim_ids":[],"text":"The product is described as an AI-powered dev team inside the editor that can generate and refactor code, write documentation, answer codebase questions, automate tasks, and use MCP servers."},{"claim_ids":["clm_f4fff1acc6c3d05064011205cbb518bb9045cfe810580aeb275958d2f4ca817b"],"opposing_claim_ids":[],"text":"Zoo Code continues development of Roo Code after the Roo team wound down, with a core team of former Roo contributors planning model updates, bug fixes, and features."},{"claim_ids":["clm_fd85ed7b6b3d99205c1a0f16c04e6a985ab953ba883efdc8a909df7d1d550203"],"opposing_claim_ids":[],"text":"The assistant operates through modes: Code, Architect, Ask, Debug, and user-defined Custom Modes for specialized team workflows."}],"claim_ids":["clm_04840c07d9cfa1eecca629a280f5f98b562667278372bb5f8f40ec69e7de273d","clm_2c8457b16ee28fa59f5b6aaae4738aac0d894c579030d0ac44ab5cd71ddc5bc7","clm_68d8c4ca74d8fbd7b7b3989ec690521379ec21ce61598ed9eda4edac72f2685c","clm_723b955f8b99fd97ca4e420cd72e83fb35178aeb8641e91280ebc65061a1f74f","clm_8272559b96bd282f4815794baeaf08123f373f5b2718f05b1f4dd0eaf88072c4","clm_ea1b08c665096b9a098a507087758e8f3dc252f275a0ba4905fce4f3ac5d7b47","clm_f0b4eaff9bfd61dfadafa779c03cc1c0b52b1c552efc8a99f4004fc631b0648e","clm_f0bc719b51a6cc4d8cf651e6d7eff4be25db7c6744f706fb35dac3bd80e84735","clm_f4fff1acc6c3d05064011205cbb518bb9045cfe810580aeb275958d2f4ca817b","clm_fd85ed7b6b3d99205c1a0f16c04e6a985ab953ba883efdc8a909df7d1d550203"],"created_at":"2026-09-14T03:28:20Z","created_by_operation":"op_bbf049a53bae4bd6b7b11bf720ea3aac","id":"pg_cb291c82f59c5fa5b17d5276c8e5f1fd","maturity":"draft","page_type":"source","path":"pages/sources/zoo-code-org-zoo-code-readme-md-ba46d1f34a5b-5276c8e5f1fd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f9e1bc5eb05f5f1f951c5590d5f9ee81"],