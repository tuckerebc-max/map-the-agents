{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_830cd6e3f84c14e325d1986c8042ea17ec12ffa4249969b18bfbe7f60b1737dc"],"opposing_claim_ids":[],"text":"In Zoo Code Cloud proxy mode, code and prompts transit Zoo Code servers only for forwarding to the upstream provider and are not stored; otherwise data goes directly to the chosen AI provider."},{"claim_ids":["clm_a3a9f3c88d772abd158c512f923556f9f9a32649349928e3129f44e476843c09"],"opposing_claim_ids":[],"text":"Per the privacy policy, telemetry is enabled by default but can be opted out via settings, and users can run models locally to avoid sending data to third parties."}],"claim_ids":["clm_830cd6e3f84c14e325d1986c8042ea17ec12ffa4249969b18bfbe7f60b1737dc","clm_a3a9f3c88d772abd158c512f923556f9f9a32649349928e3129f44e476843c09"],"created_at":"2026-09-14T03:28:20Z","created_by_operation":"op_bbf049a53bae4bd6b7b11bf720ea3aac","id":"pg_d174f9314dad5eae97e13090d506d19d","maturity":"draft","page_type":"source","path":"pages/sources/zoo-code-org-zoo-code-privacy-md-ba46d1f34a5b-3090d506d19d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_02de340ef9b457cfb91670ed2dab85b8"],"title":"Zoo-Code-Org/Zoo-Code/PRIVACY.md @ ba46d1f34a5b","updated_at":"2026-09-14T03:28:20Z","updated_by_operation":"op_bbf049a53bae4bd6b7b11bf720ea3aac"}
