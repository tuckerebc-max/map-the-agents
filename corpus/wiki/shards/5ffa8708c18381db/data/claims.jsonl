{"access":"public","created_at":"2026-09-14T02:28:52Z","created_by_operation":"op_197f536722ff48ab94d5db94f84c676a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7755b96dec60b4b49e49995c580fe658e22ab47a352fddafd92f12cda2e81bc4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"paean-ai/deeptide@b48688d56c3e snapshot b47b4daf011a3fc2","timeframe":null},"slice_ids":["slc_1c653d7e332eea2f7f6a27a06002769ed60519501820b2418bd5a117524d4db1","slc_2f1473317ce2a6e499b149b64afd11c768d283cfe279dd22a5deae1c6523dc26","slc_490f6eebd0fe50033691374170015255c138614582efec2fe2dd56794882525c"],"source_ids":["src_494442f144e9507ca69f92e0f116cfbc"],"text":"The repository also contains a native local inference runtime under native/: a hard-forked ds4 DeepSeek V4 Flash Metal engine and dsgo, an OpenAI/Anthropic-compatible local gateway, built via npm run build:native on macOS.","updated_at":"2026-09-14T02:28:52Z","updated_by_operation":"op_197f536722ff48ab94d5db94f84c676a"}
