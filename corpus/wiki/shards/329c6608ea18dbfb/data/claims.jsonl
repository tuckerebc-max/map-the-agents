{"access":"public","created_at":"2026-09-14T03:16:52Z","created_by_operation":"op_eca2413b63fe49f8afdb73ec43d8f5e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d3904c4d6bc7a65e67f1eef81e37840b294859eab100143f4a785b2c4696d0a2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"swival/swival@fabd2fbc43e3 snapshot e9e7934bcfa0719d","timeframe":null},"slice_ids":["slc_8b71d4f7c6ebcfa70f59ae90c0135b02d4134cad1679afb1f4f3970bd0225131"],"source_ids":["src_889217383b6d5512a3001db1cb368ae0"],"text":"Context management targets small models: graduated compaction, persistent thinking notes, and a todo checklist survive context resets, per the README's design description.","updated_at":"2026-09-14T03:16:52Z","updated_by_operation":"op_eca2413b63fe49f8afdb73ec43d8f5e9"}
