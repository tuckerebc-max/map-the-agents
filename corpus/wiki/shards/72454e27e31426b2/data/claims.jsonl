{"access":"public","created_at":"2026-09-14T01:33:24Z","created_by_operation":"op_bdfe7ea9569c487f9a6531d7dc48b162","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_17d251135130b3e5c741a1c668b4f49c9d629b534c35a798b1cb6e707e0e0be9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"andrefetch/postal@240622b0c2dc snapshot d2cc8dfe1c666ebc","timeframe":null},"slice_ids":["slc_6168df7e1c422e161499e29835d507b24605237d4e6a2b82e88e7222932ac174","slc_8e013e10b7f58491f31ee5c31ac3496e8211cbb25a1a31eed3c578dd7c816e59","slc_b3a8aeac4b4e1548227e9e4ebfa0a0b5e1518512f4dad282459b11fdec0979f6"],"source_ids":["src_22f56ca5b9c9557a873e173ad92b5905","src_e013041a81735954904485f869b363ff"],"text":"Context handling uses two loop-side mechanisms: pruning clears stale tool outputs to reclaim tokens, and compaction summarizes history into a continuation brief when the context window fills, instead of erroring out.","updated_at":"2026-09-14T01:33:24Z","updated_by_operation":"op_bdfe7ea9569c487f9a6531d7dc48b162"}
