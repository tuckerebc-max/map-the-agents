{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4655d2b691efddd4381944f048c288ba152fba496a59747138c1fdf667605e9f"],"opposing_claim_ids":[],"text":"The CLI supports non-interactive scripting via -p, with --output-format json for structured output and stream-json for newline-delimited event streaming."},{"claim_ids":["clm_60cd23edbfb59b0c4a35838142e40e404b0be78273a0383ad6d1d66516370509"],"opposing_claim_ids":[],"text":"Weekly preview releases are not fully vetted and may contain regressions; nightly builds should be assumed to carry pending validations and issues."},{"claim_ids":["clm_661b9302c5c469c85a438d1946120dd86cee1fd1fe54d87bcb0922034ae84b4c"],"opposing_claim_ids":[],"text":"Built-in tools include Google Search grounding, file operations, shell commands, and web fetching, with MCP support for custom integrations."},{"claim_ids":["clm_9fbdd939d6e6ca9d7e232806e439f93ea683f18e7777064edf11efcf8d985703"],"opposing_claim_ids":[],"text":"Gemini CLI is an open-source AI agent that brings Gemini into the terminal, providing lightweight access from the user's prompt to the model."},{"claim_ids":["clm_acc13d43e32f438a4368464e6c7b3702c5b9f23e2bf13d94e75772d93b6a135b"],"opposing_claim_ids":[],"text":"CLI flags include --include-directories for multiple directories, -m for model selection, and -s for sandboxing."}],"claim_ids":["clm_4655d2b691efddd4381944f048c288ba152fba496a59747138c1fdf667605e9f","clm_60cd23edbfb59b0c4a35838142e40e404b0be78273a0383ad6d1d66516370509","clm_661b9302c5c469c85a438d1946120dd86cee1fd1fe54d87bcb0922034ae84b4c","clm_9fbdd939d6e6ca9d7e232806e439f93ea683f18e7777064edf11efcf8d985703","clm_acc13d43e32f438a4368464e6c7b3702c5b9f23e2bf13d94e75772d93b6a135b"],"created_at":"2026-09-14T02:01:21Z","created_by_operation":"op_e76da10d4b424b98b449ab538c4e0f64","id":"pg_e32be870d3cd5f9a8fdb4a3aac1e1ce2","maturity":"draft","page_type":"source","path":"pages/sources/google-gemini-gemini-cli-readme-md-9c1b0a610534-4a3aac1e1ce2.md","record_type":"page