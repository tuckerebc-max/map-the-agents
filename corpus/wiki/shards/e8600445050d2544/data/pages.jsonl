f8d985703","clm_a6fbf314d1e399f0be2495ec00624f3f82338299fa7a679e01bd9ae0c1d83aa5","clm_a92d62d09cdca7dcdda48591d72342e5f5200b848c49ebc12c1fd107742cec60","clm_acc13d43e32f438a4368464e6c7b3702c5b9f23e2bf13d94e75772d93b6a135b","clm_baa1e7a57911f79245ef86de0c134645beb291a6dd3b7d096491a7807dbd84c4"],"created_at":"2026-09-14T02:01:21Z","created_by_operation":"op_e76da10d4b424b98b449ab538c4e0f64","id":"pg_2bb69d656e3256ca8d88ebac7fa0f24b","maturity":"draft","page_type":"entity","path":"pages/entities/google-gemini-gemini-cli-ebac7fa0f24b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"google-gemini/gemini-cli","updated_at":"2026-09-14T02:01:21Z","updated_by_operation":"op_e76da10d4b424b98b449ab538c4e0f64"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_24a467f8475aec0c19157464f21de1fe4a271062760bc935db5b687281bd899c"],"opposing_claim_ids":[],"text":"Repository development practice: PRs should be small and issue-linked, commits follow Conventional Commits, and new source files need Apache-2.0 license headers enforced by ESLint."},{"claim_ids":["clm_24f52035b123cf9b108c200bbb4cd59727796633d821cccc53de7b149ccad2ad"],"opposing_claim_ids":[],"text":"The project uses Node.js (>=20), TypeScript, React with Ink for CLI rendering, Vitest, esbuild, ESLint, and Prettier, in an npm-workspaces monorepo."},{"claim_ids":["clm_2c93bcd2fda4a0dafab6a5dfa2ae0e423f2567dc9709c01aab7e54135fee4ebb"],"opposing_claim_ids":[],"text":"Repository development practice: tests depending on environment variables should use vi.stubEnv in beforeEach and vi.unstubAllEnvs in afterEach rather than mutating process.env directly."},{"claim_ids":["clm_a92d62d09cdca7dcdda48591d72342e5f5200b848c49ebc12c1fd107742cec60"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run npm run test for unit tests, test:e2e for integration, and preflight (clean, install, build, lint, type check, tests) before submitting PRs."}],"claim_ids":["clm_24a467f8475aec0c19157464f21de1fe4a271062760bc935db5b687281bd899c","clm_24f52035b123cf9b108c200bbb4cd59727796633d821cccc53de7b149ccad2ad","clm_2c93bcd2fda4a0dafab6a5dfa2ae0e423f2567dc9709c01aab7e54135fee4ebb","clm_a92d62d09cdca7dcdda48591d72342e5f5200b848c49ebc12c1fd107742cec60"],"created_at":"2026-09-14T02:01:21Z","created_by_operation":"op_e76da10d4b424b98b449ab538c4e0f64","id":"pg_2c8ad6e5579f53e2b92ff650167deb66","maturity":"draft","page_type":"source","path":"pages/sources/google-gemini-gemini-cli-gemini-md-9c1b0a610534-f650167deb66.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d41cbdc5e7065844912accafccc1fc17"],"title":"google-gemini/gemini-cli/GEMINI.md @ 9c1b0a610534","updated_at":"2026-09-14T02:01:21Z","updated_by_operation":"op_e76da10d4b424b98b449ab538c4e0f64"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_131d88c79568389693c0823e748ade39c45712cccc5971f6d61ea9a9c2a8e461"],"opposing_claim_ids":[],"text":"Tool-level sandboxing isolates individual tool executions such as shell_exec and write_file, and can be disabled via security.toolSandboxing=false in settings.json (restart required)."},{"claim_ids":["clm_4866bb9642529f95ae4cca923fde2a3abbf83f0dd82cbe9761050a175f444f9b"],"opposing_claim_ids":[],"text":"LXC sandboxing is Linux-only and requires the container to already exist and be running, as Gemini does not create it automatically."},{"claim_ids":["clm_a6fbf314d1e399f0be2495ec00624f3f82338299fa7a679e01bd9ae0c1d83aa5"],"opposing_claim_ids":[],"text":"Sandboxing can be enabled via the -s/--sandbox flag, the GEMINI_SANDBOX env var, or settings.json, with providers including docker, podman, sandbox-exec, runsc, and lxc."},{"claim_ids":["clm_acc13d43e32f438a4368464e6c7b3702c5b9f23e2bf13d94e75772d93b6a135b"],"opposing_claim_ids":[],"text":"CLI flags include --include-directories for multiple directories, -m for model selection, and -s for sandboxing."},{"claim_ids":["clm_baa1e7a57911f79245ef86de0c134645beb291a6dd3b7d096491a7807dbd84c4"],"opposing_claim_ids":[],"text":"A sandbox expansion mechanism detects permission denials or proactively identified needs and shows a modal request; approval grants extended permissions for that specific run."}],"claim_ids":["clm_131d88c79568389693c0823e748ade39c45712cccc5971f6d61ea9a9c2a8e461","clm_4866bb9642529f95ae4cca923fde2a3abbf83f0dd82cbe9761050a175f444f9b","clm_a6fbf314d1e399f0be2495ec00624f3f82338299fa7a679e01bd9ae0c1d83aa5","clm_acc13d43e32f438a4368464e6c7b3702c5b9f23e2bf13d94e75772d93b6a135b","clm_baa1e7a57911f79245ef86de0c134645beb291a6dd3b7d096491a7807dbd84c4"],"created_at":"2026-09-14T02:01:21Z","created_by_operation":"op_e76da10d4b424b98b449ab538c4e0f64","id":"pg_4fcb65d85c14532f96e0c60babb00ceb","maturity":"draft","page_type":"source","path":"pages/sources/google-gemini-gemini-cli-docs-cli-sandbox-md-9c1b0a610534-c60babb00ceb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7a000dc988405f3fa1dacecdde66dacd"],"title":"google-gemini/gemini-cli/docs/cli/sandbox.md @ 9c1b0a610534","updated_at":"2026-09-14T02:01:21Z","updated_by_operation":"op_e76da10d4b424b98b449ab538c4e0f64"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_48736525dd1831b9c0a6df0ba34afec671bb315500be61ef6a4fa6619404dcd7"],"opposing_claim_ids":[],"text":"Stored memories are edited with write_file or replace and are automatically included in the hierarchical context system for all future sessions."},{"claim_ids":["clm_7e769d39d49000003db4303dffdf61163a996745410b1f7f373707c21917b33e"],"opposing_claim_ids":[],"text":"The agent persists durable facts by editing Markdown memory files, routing shared project instructions to GEMINI.md and personal preferences to the global ~/.gemini/GEMINI.md."}],"claim_ids":["clm_48736525dd1831b9c0a6df0ba34afec671bb315500be61ef6a4fa6619404dcd7","clm_7e769d39d49000003db4303dffdf61163a996745410b1f7f373707c21917b33e"],"created_at":"2026-09-14T02:01:21Z","created_by_operation":"op_e76da10d4b424b98b449ab538c4e0f64","id":"pg_93b6d99454ec546e87fb39eb53767e49","maturity":"draft","page_type":"source","path":"pages/sources/google-gemini-gemini-cli-docs-tools-memory-md-9c1b0a610534-39eb53767e49.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8e1c089fcf94562ebab435906c7b61cf"],"title":"google-gemini/gemini-cli/docs/tools/memory.md @ 9c1b0a610534","updated_at":"2026-09-14T02:01:21Z","updated_by_operation":"op_e76da10d4b424b98b449ab538c4e0f64"}
