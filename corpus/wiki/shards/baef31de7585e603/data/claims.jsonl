{"access":"public","created_at":"2026-09-14T02:37:20Z","created_by_operation":"op_bd877ed173204a6590b5e3ea5655dd53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ee61f2a2f45d79041ef15196f6088a9e103a38871fb9e25de82cc1c08cad9f78","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"rsrohan99/tig@3df12189c01e snapshot ebda47659608a8ec","timeframe":null},"slice_ids":["slc_9d3f32e4923a63a454dd661b5b196f7f32a2b65b04caa7a93affb2d181eaebc0"],"source_ids":["src_943392479c4c58a18175c7031ad2563e"],"text":"The toolchain uses LlamaIndex Workflows for orchestration and multi-LLM support, Tree-sitter for code-definition search and syntax-error checking, Ripgrep for regex search, and diff-match-patch for displaying diffs.","updated_at":"2026-09-14T02:37:20Z","updated_by_operation":"op_bd877ed173204a6590b5e3ea5655dd53"}
