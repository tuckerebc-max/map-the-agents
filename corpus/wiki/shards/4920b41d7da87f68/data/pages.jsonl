{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_678b44423901ea20ead258b2efa6f9ff3fc241485e6a476c07fdb9c754f9aaa8"],"opposing_claim_ids":[],"text":"LEGAL.md states that Chinese code comments are the original governing version, comments in other languages are reference only, and the Chinese version prevails in case of conflict."}],"claim_ids":["clm_678b44423901ea20ead258b2efa6f9ff3fc241485e6a476c07fdb9c754f9aaa8"],"created_at":"2026-09-14T02:00:19Z","created_by_operation":"op_d5a5a620184b4a13b114cb0e5a2b52a4","id":"pg_14b8770cb57e54db8db9548add745856","maturity":"draft","page_type":"source","path":"pages/sources/codefuse-ai-codefuse-chatbot-legal-md-d6932ecfc855-548add745856.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_fb0cad1ff8755902b91528764f0da958"],"title":"codefuse-ai/codefuse-chatbot/LEGAL.md @ d6932ecfc855","updated_at":"2026-09-14T02:00:19Z","updated_by_operation":"op_d5a5a620184b4a13b114cb0e5a2b52a4"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:00:19Z","created_by_operation":"op_d5a5a620184b4a13b114cb0e5a2b52a4","id":"pg_1ef156b520ba5ce5a574ea26501f2762","maturity":"draft","page_type":"source","path":"pages/sources/codefuse-ai-codefuse-chatbot-license-md-d6932ecfc855-ea26501f2762.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_780a831975e5523096647236b4fad758"],"title":"codefuse-ai/codefuse-chatbot/LICENSE.md @ d6932ecfc855","updated_at":"2026-09-14T02:00:19Z","updated_by_operation":"op_d5a5a620184b4a13b114cb0e5a2b52a4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_101f7e00ff34f7ccea06b203ff83aa3ab87ff1a413b252b32e6a4cc7926f5211"],"opposing_claim_ids":[],"text":"Offline private deployment is possible using open-source LLM and embedding models, and calling the OpenAI API is also supported."},{"claim_ids":["clm_203167658e9a2e03be549e03c232da21291494f5abbc9226c168f3b7a9fcfc9c"],"opposing_claim_ids":[],"text":"Setup documentation recommends optionally managing Python 3.9 with conda, installing dependencies via pip install -r requirements.txt, and starting services from the examples directory with start.sh."},{"claim_ids":["clm_2a37d36a83cf4d8675b278742d6b6c5337765261a76de7dadb396ade4ece8a84"],"opposing_claim_ids":[],"text":"A model table lists chatgpt and codellama-34b-int4 (34B, int4 quantization, about 20GB GPU memory), with the latter's Hugging Face availability marked 'coming soon' and a ModelScope link provided."},{"claim_ids":["clm_5b09faba5a4f174ff7a23f395e99cdbd3de749800ec582886281c587518497be"],"opposing_claim_ids":[],"text":"The documented roadmap lists a multi-agent scheduling core, multi-source web crawler, data processor for document loading/cleaning/splitting, text embedding and indexing, vector and graph databases, prompt management, a sandbox, LLM integration, and API management."},{"claim_ids":["clm_7117449dacc0dcbfd7408e9cbb45b91546ed513da3b64cab26eeeeda4fbfe30f"],"opposing_claim_ids":[],"text":"The project was tested under Python 3.9.18 with CUDA 11.7 on Windows and X86-architecture macOS; users install NVIDIA drivers themselves, and Apple Silicon users may need qpdf installed via brew."},{"claim_ids":["clm_886b11ce4d897bd6ec6cb1b66b4b4079b2e8a7abd2762495533131dfcea78ef9"],"opposing_claim_ids":[],"text":"The stated approach uses retrieval-augmented generation, tool learning, and sandbox environments to build an assistant spanning design, coding, testing, deployment, and operations phases."},{"claim_ids":["clm_b4a9b5b818c4783eeae5a055490de74356fc260d486e728a1a66bbf1dd7803f1"],"opposing_claim_ids":[],"text":"CodeFuse-ChatBot is described as an open-source AI assistant from Ant Group's CodeFuse team that combines multi-agent coordination with tool, code, and knowledge bases plus a sandbox so LLMs can handle DevOps tasks."},{"claim_ids":["clm_c37f543125b41806690d40c2f5c0ac9e9305e5b2bdf98c5488a5358a612a43d8"],"opposing_claim_ids":[],"text":"Repository development practice: suggestions, comments, and contributions (code, tests, tooling, documentation) are welcomed via GitHub Issues and an external contribution guide, with contributors added to a contributor list."},{"claim_ids":["clm_c5c482f23db77414b49daaaf4c6a80a711fed9b756f7ae283c68db604ac60510"],"opposing_claim_ids":[],"text":"The project acknowledges being built on the open-source projects langchain-chatchat and codebox-api."},{"claim_ids":["clm_d457024e103612076e6bde7b550beafc7afd7ba6f3aa3a1a5b835227302c9f52"],"opposing_claim_ids":[],"text":"A configurable multi-agent framework, codefuse-muAgent, was announced in January 2024 and is installable via pip (pip install codefuse-muagent), with documentation hosted externally."}],"claim_ids":["clm_101f7e00ff34f7ccea06b203ff83aa3ab87ff1a413b252b32e6a4cc7926f5211","clm_203167658e9a2e03be549e03c232da21291494f5abbc9226c168f3b7a9fcfc9c","clm_2a37d36a83cf4d8675b278742d6b6c5337765261a76de7dadb396ade4ece8a84","clm_5b09faba5a4f174ff7a23f395e99cdbd3de749800ec582886281c587518497be","clm_7117449dacc0dcbfd7408e9cbb45b91546ed513da3b64cab26eeeeda4fbfe30f","clm_886b11ce4d897bd6ec6cb1b66b4b4079b2e8a7abd2762495533131dfcea78ef9","clm_b4a9b5b818c4783eeae5a055490de74356fc260d486e728a1a66bbf1dd7803f1","clm_c37f543125b41806690d40c2f5c0ac9e9305e5b2bdf98c5488a5358a612a43d8","clm_c5c482f23db77414b49daaaf4c6a80a711fed9b756f7ae283c68db604ac60510","clm_d457024e103612076e6bde7b550beafc7afd7ba6f3aa3a1a5b835227302c9f52"],"created_at":"2026-09-14T02:00:19Z","created_by_operation":"op_d5a5a620184b4a13b114cb0e5a2b52a4","id":"pg_9541b7778514546887cf2c03904cddea","maturity":"draft","page_type":"source","path":"pages/sources/codefuse-ai-codefuse-chatbot-readme-md-d6932ecfc855-2c03904cddea.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6ea2cc2a460755b08a5902ec415e782e"],"title":"codefuse-ai/codefuse-chatbot/README.md @ d6932ecfc855","updated_at":"2026-09-14T02:00:19Z","updated_by_operation":"op_d5a5a620184b4a13b114cb0e5a2b52a4"}
