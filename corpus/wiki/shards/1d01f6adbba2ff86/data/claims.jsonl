{"access":"public","created_at":"2026-09-14T03:58:07Z","created_by_operation":"op_c2063f765ef94f9196ed887e45ae668b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ac5aba8aa994bd01719dae06cc7914b0b467aabf92d8e536a2ed49bc97d5a47a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"husnainpk/symdex@257bb3c215b3 snapshot a1afcb7025639afb","timeframe":null},"slice_ids":["slc_0591fd94897431f2e1e52a55458b044bac779212ef89ca0cf0cb534d10da12d2","slc_32facb38c0f2795cfbc8206b43ee1dadb55255bbd80f98ca1c499bc1f1ed3cae","slc_4ee74837dfde7bcb5a4869bcabc855f070155e5761d607372b6e5c5868fbd3c2","slc_6acc26820b2fb4a074bbc583d73095d176468209d075923ada60cc3cfa098812"],"source_ids":["src_cf470e97e5b558b38a75f7e0c676b687"],"text":"The product exposes both CLI commands and an MCP server; the MCP server reportedly exposes 21 tools covering indexing, search, context packs, outlines, routes, stats, graphs, cache invalidation, and stale-index cleanup.","updated_at":"2026-09-14T03:58:07Z","updated_by_operation":"op_c2063f765ef94f9196ed887e45ae668b"}
