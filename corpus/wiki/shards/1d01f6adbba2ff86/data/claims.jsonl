{"access":"public","created_at":"2026-09-14T03:58:07Z","created_by_operation":"op_c2063f765ef94f9196ed887e45ae668b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_88b9268644ea19ab43acedea4ad73eefabcea4d249ae6f1c7c56a1f7eb8098f6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"husnainpk/symdex@257bb3c215b3 snapshot a1afcb7025639afb","timeframe":null},"slice_ids":["slc_675132f4c29c1fe1d6023dcff2f77295c89d522f2436cb974fd3dc34f5bf176a","slc_86ffece1c3a11c60e031204d6c3f4862ee5a25941d24527dcc790f0d93676e34","slc_8dee141e8e84f81bee19222eafc79eebd1e11f2a897b7984c4fbfb88cb31930b"],"source_ids":["src_cf470e97e5b558b38a75f7e0c676b687"],"text":"A symdex-code-search agent skill ships at skills/symdex-code-search/SKILL.md, installable via the skills CLI, instructing agents to check index readiness, prefer symbol/outline retrieval, and use context packs before broad file reads.","updated_at":"2026-09-14T03:58:07Z","updated_by_operation":"op_c2063f765ef94f9196ed887e45ae668b"}
