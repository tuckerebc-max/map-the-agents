{"access":"public","created_at":"2026-09-14T03:58:07Z","created_by_operation":"op_c2063f765ef94f9196ed887e45ae668b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d083de3891ee07a196a2c2a77ce81de01fb78199aac20030d94dba54d4c87f49","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"husnainpk/symdex@257bb3c215b3 snapshot a1afcb7025639afb","timeframe":null},"slice_ids":["slc_4e68ca53103c346b41ef19fa070c8af9b74afa99a04e456ee48233b5d7dc5d78","slc_fc008b3c1e610b589a70be548e33674a22a1cd61b2aa31ded1df72dc14bd6b62"],"source_ids":["src_cf470e97e5b558b38a75f7e0c676b687"],"text":"Parsing is documented as powered by tree-sitter with language-pack grammar fallbacks and a native Markdown scanner; remote OpenAI-compatible and Gemini backends use the Python standard library HTTP client so they add no required dependency.","updated_at":"2026-09-14T03:58:07Z","updated_by_operation":"op_c2063f765ef94f9196ed887e45ae668b"}
{"access":"public","created_at":"2026-09-14T03:58:07Z","created_by_operation":"op_c2063f765ef94f9196ed887e45ae668b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d79428f6222ace19b9ec747c5e837929dabe1d814f52d2ce2cb4b3aae36b996a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"husnainpk/symdex@257bb3c215b3 snapshot a1afcb7025639afb","timeframe":null},"slice_ids":["slc_85c76635528af7ec845e0539435c95e63b34cb93769d4325cd5763d62a1cc677","slc_b7be0af505b7eedf6f677e170ecb6d5bb20e67550435f2a5513a6061e5fbd047","slc_f7ae3ddc2271202196b3324d44b5fd324af1f8b215c3a63bbbb5776d868b279e"],"source_ids":["src_cf470e97e5b558b38a75f7e0c676b687"],"text":"The README states SymDex is not a full static analyzer, type checker, or refactoring engine, and semantic search requires stored embeddings, so repos indexed without a backend must be re-indexed.","updated_at":"2026-09-14T03:58:07Z","updated_by_operation":"op_c2063f765ef94f9196ed887e45ae668b"}
