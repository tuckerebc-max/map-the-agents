{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_288afd6b7ce5fe7b1dfe9a23b95d8bf084c8ba7f81500cc47b44489156f3157b"],"opposing_claim_ids":[],"text":"Repository development practice: bug reports should include reproduction steps, expected vs actual behavior, OS and compiler version, and must never contain credentials or tokens."},{"claim_ids":["clm_ebad30167bd4811b9cc00f034200442687eccdefa277ca2ee6010644fa70b90d"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are warned not to submit unreviewed AI-generated PR descriptions or diffs and remain responsible for validating their submissions."},{"claim_ids":["clm_ff6c8461d7d81a1b31595b9e17a5becf3b39f2fad5b3e9b6c31e118ed52ed07f"],"opposing_claim_ids":[],"text":"Repository development practice: contributors build with a C++23 compiler, make, libcurl and OpenSSL dev files, run `make` and `make test`, and should keep PRs to one logical change with tests passing and no warnings."}],"claim_ids":["clm_288afd6b7ce5fe7b1dfe9a23b95d8bf084c8ba7f81500cc47b44489156f3157b","clm_ebad30167bd4811b9cc00f034200442687eccdefa277ca2ee6010644fa70b90d","clm_ff6c8461d7d81a1b31595b9e17a5becf3b39f2fad5b3e9b6c31e118ed52ed07f"],"created_at":"2026-09-14T02:28:51Z","created_by_operation":"op_d7d19db50e414665b59288addef520dc","id":"pg_4b71858e67e657bfaed209bc87f563a5","maturity":"draft","page_type":"source","path":"pages/sources/paoloanzn-microcodex-contributing-md-2d88e4f57552-09bc87f563a5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6111715d57545a2caa9a2d43f16d851b"],"title":"paoloanzn/microcodex/CONTRIBUTING.md @ 2d88e4f57552","updated_at":"2026-09-14T02:28:51Z","updated_by_operation":"op_d7d19db50e414665b59288addef520dc"}
