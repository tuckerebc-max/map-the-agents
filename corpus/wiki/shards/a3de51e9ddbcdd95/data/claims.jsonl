{"access":"public","created_at":"2026-09-14T02:28:51Z","created_by_operation":"op_d7d19db50e414665b59288addef520dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2c5a4bb56f1348950c2f8fe10bc20b679ce23821e6f65b0d82ef20c4fddcedcc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"paoloanzn/microcodex@2d88e4f57552 snapshot 35b0dd63d72e3d03","timeframe":null},"slice_ids":["slc_f1b825334662dac14ae03157ff4d71897d38e8a9ae2d00cfb905df39d7cec1cc"],"source_ids":["src_49444f9139f952da91f5c98fc1682d84"],"text":"The agent is not a sandbox: before running the user's shell it applies a lexical denylist (e.g. `rm -rf`, `git reset --hard`, shutdown commands); other commands and file operations run with the process's own permissions.","updated_at":"2026-09-14T02:28:51Z","updated_by_operation":"op_d7d19db50e414665b59288addef520dc"}
{"access":"public","created_at":"2026-09-14T02:28:51Z","created_by_operation":"op_d7d19db50e414665b59288addef520dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_476350f166687f7b70dff4932bf3d832b541dcf75ce08797e7620e1c21d693b1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"paoloanzn/microcodex@2d88e4f57552 snapshot 35b0dd63d72e3d03","timeframe":null},"slice_ids":["slc_2dd8761a89260a4d206b4790d6fbadb0f4d0351af834ec03bc13eafad2ef6afc"],"source_ids":["src_49444f9139f952da91f5c98fc1682d84"],"text":"The product provides one-shot prompts, an interactive terminal UI, local coding tools, durable conversations, and automatic context compaction.","updated_at":"2026-09-14T02:28:51Z","updated_by_operation":"op_d7d19db50e414665b59288addef520dc"}
{"access":"public","created_at":"2026-09-14T02:28:51Z","created_by_operation":"op_d7d19db50e414665b59288addef520dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_55199b7ae7bf7b3dc8ef0f368410b4187016dc07503fcc734137ea9c8df8bf7b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"paoloanzn/microcodex@2d88e4f57552 snapshot 35b0dd63d72e3d03","timeframe":null},"slice_ids":["slc_3edadce8595de117155781412cbbe8bb5c382221e65a2eec896296fc67ee8ce7","slc_bc82046ceca4f4b38e0617c8629e8f6bf81397eed844c497ec58489dbafaf813"],"source_ids":["src_49444f9139f952da91f5c98fc1682d84"],"text":"Users sign in with `microcodex login` (a `--device-auth` option exists for remote or headless machines) and can run interactively or pass a one-shot prompt as an argument.","updated_at":"2026-09-14T02:28:51Z","updated_by_operation":"op_d7d19db50e414665b59288addef520dc"}
{"access":"public","created_at":"2026-09-14T02:28:51Z","created_by_operation":"op_d7d19db50e414665b59288addef520dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6d2a08efa679accbe146a3243a301e0f555d07b72559ea8478ee75038ac8f9c4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"paoloanzn/microcodex@2d88e4f57552 snapshot 35b0dd63d72e3d03","timeframe":null},"slice_ids":["slc_15a00bb676c03a3f1046046d0953c0f9d356db00de174873df7652ecdb473c18","slc_8e0dae417002893a5495b04786647d1112f06f3dca67f87523e0408453f8cfd4","slc_96b14b95e9e14d7ca57e6ac8e49bde6ff18b3d9772bb25eed15db720e98a37fa","slc_f6e1a890a29ecd5ac6661b996139a3da1461db1da9c6d07490f6bfac767d8ded"],"source_ids":["src_49444f9139f952da91f5c98fc1682d84"],"text":"Installation is via a curl-piped install script (with `MICROCODEX_RELEASE` selecting a specific release) or by downloading a platform archive from GitHub Releases.","updated_at":"2026-09-14T02:28:51Z","updated_by_operation":"op_d7d19db50e414665b59288addef520dc"}
{"access":"public","created_at":"2026-09-14T02:28:51Z","created_by_operation":"op_d7d19db50e414665b59288addef520dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_814b5eff35a095df5a6df22fcac21d114de019fe310cabc542827004c887126b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"paoloanzn/microcodex@2d88e4f57552 snapshot 35b0dd63d72e3d03","timeframe":null},"slice_ids":["slc_3edadce8595de117155781412cbbe8bb5c382221e65a2eec896296fc67ee8ce7"],"source_ids":["src_49444f9139f952da91f5c98fc1682d84"],"text":"OAuth credentials from login are stored under `$CODEX_HOME`, or `~/.codex` when that variable is unset.","updated_at":"2026-09-14T02:28:51Z","updated_by_operation":"op_d7d19db50e414665b59288addef520dc"}
{"access":"public","created_at":"2026-09-14T02:28:51Z","created_by_operation":"op_d7d19db50e414665b59288addef520dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a80d3c7460f983b1f820ed26f27f962f064c2f8c11f4218fc7c8687b5ed4a81c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"paoloanzn/microcodex@2d88e4f57552 snapshot 35b0dd63d72e3d03","timeframe":null},"slice_ids":["slc_419fba7dd4bc4a13e951da11dd5a25b604874b56389d4cd4d24e6ea417a95bc7"],"source_ids":["src_49444f9139f952da91f5c98fc1682d84"],"text":"Skills are discovered under `$CODEX_HOME/skills` (default `~/.codex/skills`); each needs a `SKILL.md` with YAML frontmatter name and description, and the full skill is read only when its metadata matches the task.","updated_at":"2026-09-14T02:28:51Z","updated_by_operation":"op_d7d19db50e414665b59288addef520dc"}
{"access":"public","created_at":"2026-09-14T02:28:51Z","created_by_operation":"op_d7d19db50e414665b59288addef520dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d639afff502118d2d83cba42a52c2925f46745400f888d15e7de03211be245a1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"paoloanzn/microcodex@2d88e4f57552 snapshot 35b0dd63d72e3d03","timeframe":null},"slice_ids":["slc_54f4065d30bdd14d7eb2a49169e77fe2e880f7c69f2fce2fc85c90b97b1dd9e0","slc_8f3d73bb351bdb3ae5f4892f33fe4de2471df9b269979c283ac9302db18d5813"],"source_ids":["src_49444f9139f952da91f5c98fc1682d84"],"text":"Linux requires the libcurl and OpenSSL runtime libraries, and prebuilt binaries are published for macOS and Linux on arm64 and x86_64.","updated_at":"2026-09-14T02:28:51Z","updated_by_operation":"op_d7d19db50e414665b59288addef520dc"}
{"access":"public","created_at":"2026-09-14T02:28:51Z","created_by_operation":"op_d7d19db50e414665b59288addef520dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d783119fdc45814c405ba90a1796dc801ee3dcc358ade78e035eff3bafdf1d24","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"paoloanzn/microcodex@2d88e4f57552 snapshot 35b0dd63d72e3d03","timeframe":null},"slice_ids":["slc_2dd8761a89260a4d206b4790d6fbadb0f4d0351af834ec03bc13eafad2ef6afc"],"source_ids":["src_49444f9139f952da91f5c98fc1682d84"],"text":"MicroCodex is described as an ultra-lightweight coding agent that runs locally in the terminal and is written in C++23.","updated_at":"2026-09-14T02:28:51Z","updated_by_operation":"op_d7d19db50e414665b59288addef520dc"}
