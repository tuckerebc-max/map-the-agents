{"access":"public","created_at":"2026-09-14T02:14:03Z","created_by_operation":"op_35a7527967d54f15ab150edcd15a3dfd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8912bb102544e7a90cd257560faf738801c5480bc278e803d8a2ec7fbeac0bab","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"lore-hex/quillcode@9f412834f0d6 snapshot c9647230348e1d7f","timeframe":null},"slice_ids":["slc_06b3945dad6e87b09e8ed8dbb2fb020ab896734062b01f5b5a9e767808ab4eab"],"source_ids":["src_1b54b60d2dde5d41b8a085963dd020b8"],"text":"Confidential Cowork defaults to trustedrouter/confidential, requires Confidential-tier providers for every model-backed request, supports US/EU processing policy, and fails closed rather than using a standard route.","updated_at":"2026-09-14T02:14:03Z","updated_by_operation":"op_35a7527967d54f15ab150edcd15a3dfd"}
