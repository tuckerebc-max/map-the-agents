{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_59937a725569c012f463e3acb5982ce2722d93cf6e2c94aeec187b09ab69c0b2"],"opposing_claim_ids":[],"text":"A merge/extraction data-loss gate (F21) was attempted twice and deliberately not shipped after reviews found both designs' premises false; merge verification remains with the human or an explicit per-task check."}],"claim_ids":["clm_59937a725569c012f463e3acb5982ce2722d93cf6e2c94aeec187b09ab69c0b2"],"created_at":"2026-09-14T02:14:03Z","created_by_operation":"op_35a7527967d54f15ab150edcd15a3dfd","id":"pg_f2acc7a23a405d49a5ffe4ed17c590e2","maturity":"draft","page_type":"source","path":"pages/sources/lore-hex-quillcode-docs-cline-tool-learnings-md-9f412834f0d6-e4ed17c590e2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_eb16fc7ea9475dc3be027980d57ba138"],"title":"Lore-Hex/QuillCode/docs/CLINE_TOOL_LEARNINGS.md @ 9f412834f0d6","updated_at":"2026-09-14T02:14:03Z","updated_by_operation":"op_35a7527967d54f15ab150edcd15a3dfd"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_27c081171bad06164eb93a426a4566c05ca9d3c6223a164dd499a368d6236e0f"],"opposing_claim_ids":[],"text":"A documented safety limitation: background desktop clicks via the opt-in cua-driver backend can actuate unapproved background apps because the Approved-Apps gate checks only the frontmost app."},{"claim_ids":["clm_be3265a7dcc14ed8a7573a171401d3b9d450c535f19de110ca5c163967454220"],"opposing_claim_ids":[],"text":"The computer-use backend adopts TryCua's MIT-licensed cua-driver behind the existing ComputerUseBackend seam, verified live against cua-driver 0.8.3."},{"claim_ids":["clm_f40285223b5560d9e448ea6dc191593959ffc864c6f687d4383bbfac80190330"],"opposing_claim_ids":[],"text":"The cua-driver computer-use backend is off by default and enabled via QUILLCODE_USE_CUA_DRIVER=1, with an optional path override; the agent-facing tools and approval gate are unchanged."}],"claim_ids":["clm_27c081171bad06164eb93a426a4566c05ca9d3c6223a164dd499a368d6236e0f","clm_be3265a7dcc14ed8a7573a171401d3b9d450c535f19de110ca5c163967454220","clm_f40285223b5560d9e448ea6dc191593959ffc864c6f687d4383bbfac80190330"],"created_at":"2026-09-14T02:14:03Z","created_by_operation":"op_35a7527967d54f15ab150edcd15a3dfd","id":"pg_fd91b2d75f7a5b50b827032c4a3dc381","maturity":"draft","page_type":"source","path":"pages/sources/lore-hex-quillcode-docs-cua-computer-use-test-plan-md-9f412834f0d6-032c4a3dc381.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_bede5d17f0a65650a67cfb0522ae3c39"],"title":"Lore-Hex/QuillCode/docs/CUA_COMPUTER_USE_TEST_PLAN.md @ 9f412834f0d6","updated_at":"2026-09-14T02:14:03Z","updated_by_operation":"op_35a7527967d54f15ab150edcd15a3dfd"}
