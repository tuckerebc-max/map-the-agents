{"access":"public","created_at":"2026-09-14T01:37:58Z","created_by_operation":"op_25d17800b46f456f8ba4aea0cdc352b4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c8ea8456ee61f3d65b0718c09571cc313b30d3d416b1b9c84af419d7e69e5110","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"big-pony/pocketshell@8aa6474e8140 snapshot ee6c89f3609269d6","timeframe":null},"slice_ids":["slc_a62afe326316f7ed960bf88085db08c101f328dd640436241d91c59aff34f72e","slc_ccc956852096942a91ae3a4c2d14722a36dfefcc7da1163a622ef63ad74303f5"],"source_ids":["src_7665d5b4c720530e8b9a2ada40835f17"],"text":"Sessions are tmux-managed server-side so tasks keep running while the phone is offline; on reconnect, per-session lastSeq accounting replays only the missing output gap.","updated_at":"2026-09-14T01:37:58Z","updated_by_operation":"op_25d17800b46f456f8ba4aea0cdc352b4"}
