b08a","maturity":"draft","page_type":"entity","path":"pages/entities/big-pony-pocketshell-04f5eb31b08a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"big-pony/pocketshell","updated_at":"2026-09-14T01:37:58Z","updated_by_operation":"op_25d17800b46f456f8ba4aea0cdc352b4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_ab2b9420a2497a7cebb8556c20256ceafc10fb51c929a8b8ac5e01becb986b48"],"opposing_claim_ids":[],"text":"The Agent CLI includes install (requiring --advertise, default port 8722 bound to 127.0.0.1), pair, devices list/remove, uninstall, and tunnel setup subcommands."}],"claim_ids":["clm_ab2b9420a2497a7cebb8556c20256ceafc10fb51c929a8b8ac5e01becb986b48"],"created_at":"2026-09-14T01:37:58Z","created_by_operation":"op_25d17800b46f456f8ba4aea0cdc352b4","id":"pg_0b343f79fbe35cc8aa16234c7e9c9399","maturity":"draft","page_type":"source","path":"pages/sources/big-pony-pocketshell-deployment-cn-md-8aa6474e8140-234c7e9c9399.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7af9268fd56c5d8ab238e978d4f47d87"],"title":"Big-Pony/pocketshell/DEPLOYMENT-CN.md @ 8aa6474e8140","updated_at":"2026-09-14T01:37:58Z","updated_by_operation":"op_25d17800b46f456f8ba4aea0cdc352b4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_02757861e6bb828e8a86aef7a0aa71744bb668ab03c763274fcd1b55208479f3"],"opposing_claim_ids":[],"text":"Every connection performs a Noise IK handshake with mutual authentication and forward secrecy; unregistered devices cannot pass it, and keys live only in KEY_DIR."},{"claim_ids":["clm_16692059aaa17a7c3964ce2840fa0b2389dc48d817c6680aa38b22cea81db380"],"opposing_claim_ids":[],"text":"Windows hosts are not supported yet; the auth boundary is the Agent process's own permissions with no extra sandbox, so access should be constrained via process permissions."},{"claim_ids":["clm_273ecf2e26657f36e9b4e1e39db069e89145da377309e5a78d35f8cf641b7377"],"opposing_claim_ids":[],"text":"PocketShell is described as a self-hosted, mobile-first remote terminal that brings a dev machine's terminal sessions into a phone browser for CLI/TUI coding agents or plain shell use."},{"claim_ids":["clm_2ef47e41acfb022f1ee4994e8ef68c52b78ef2b205f81448db759ee4898d4e94"],"opposing_claim_ids":[],"text":"The Agent idempotently writes a notify hook into supported tools' configs (Claude Code, Codex, opencode, Kimi CLI), each toggleable in settings, and removes exactly that entry when disabled."},{"claim_ids":["clm_488a8832d978b452e10467b08271331b7456bb02e9fbac74af5e4d3ccdf19d4b"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork, branch as feat/your-feature, and open PRs; protocol changes start in agent/src/protocol.ts with app/src/lib/protocol.ts as a verbatim mirror, and bun test plus bun run typecheck must pass on both sides."},{"claim_ids":["clm_ab2b9420a2497a7cebb8556c20256ceafc10fb51c929a8b8ac5e01becb986b48"],"opposing_claim_ids":[],"text":"The Agent CLI includes install (requiring --advertise, default port 8722 bound to 127.0.0.1), pair, devices list/remove, uninstall, and tunnel setup subcommands."},{"claim_ids":["clm_be6b8b7162cd6dd706e6119385554312d22b94bb4b10c697b8160f3e37a26cbe"],"opposing_claim_ids":[],"text":"The host needs tmux and git; the binary is a single-file Bun compile with pure-JS crypto (sodium-javascript, noise-handshake) and no native addons."},{"claim_ids":["clm_c557c737ac4d5c7a3ac50515bd4075576dd0318e0456fa23eca6d7c8572a6a28"],"opposing_claim_ids":[],"text":"Repository development practice: running from source uses Bun — backend via 'cd agent && bun install && bun run start', frontend via 'cd app && bun install && bun run dev' on port 5173; building requires Bun >= 1.3."},{"claim_ids":["clm_c6a5e8b9e258e7546ca0f291a608380a3fb8d46115e82390ae30d42525044125"],"opposing_claim_ids":[],"text":"The phone UI offers three keyboard layouts (Classic default, Layered, Flick), an IME whole-segment input mode whose buffer survives disconnects, and a quick-actions panel."},{"claim_ids":["clm_c8ea8456ee61f3d65b0718c09571cc313b30d3d416b1b9c84af419d7e69e5110"],"opposing_claim_ids":[],"text":"Sessions are tmux-managed server-side so tasks keep running while the phone is offline; on reconnect, per-session lastSeq accounting replays only the missing output gap."},{"claim_ids":["clm_c92c27e17d99410b79ddf603180a2e429b34d19daca72a5a9854925a3c41c780"],"opposing_claim_ids":[],"text":"The stack comprises a Svelte 5 + Vite + xterm.js + CodeMirror 6 frontend, a Bun/TypeScript backend serving the embedded frontend and WebSocket on one port, tmux-managed PTYs, and bun:sqlite storage."},{"claim_ids":["clm_e0431ba3e449a8844be2faa0dc6f0ab1e20200d4061e717afec37fbab87fa9be"],"opposing_claim_ids":[],"text":"The Agent supports in-app auto-update via GitHub Releases with SHA256 verification and automatic binary swap and restart, disableable with POCKETSHELL_UPDATE=0."}],"claim_ids":["clm_02757861e6bb828e8a86aef7a0aa71744bb668ab03c763274fcd1b55208479f3","clm_16692059aaa17a7c3964ce2840fa0b2389dc48d817c6680aa38b22cea81db380","clm_273ecf2e26657f36e9b4e1e39db069e89145da377309e5a78d35f8cf641b7377","clm_2ef47e41acfb022f1ee4994e8ef68c52b78ef2b205f81448db759ee4898d4e94","clm_488a8832d978b452e10467b08271331b7456bb02e9fbac74af5e4d3ccdf19d4b","clm_ab2b9420a2497a7cebb8556c20256ceafc10fb51c929a8b8ac5e01becb986b48","clm_be6b8b7162cd6dd706e6119385554312d22b94bb4b10c697b8160f3e37a26cbe","clm_c557c737ac4d5c7a3ac50515bd4075576dd0318e0456fa23eca6d7c8572a6a28","clm_c6a5e8b9e258e7546ca0f291a608380a3fb8d46115e82390ae30d42525044125","clm_c8ea8456ee61f3d65b0718c09571cc313b30d3d416b1b9c84af419d7e69e5110","clm_c92c27e17d99410b79ddf603180a2e429b34d19daca72a5a9854925a3c41c780","clm_e0431ba3e449a8844be2faa0dc6f0ab1e20200d4061e717afec37fbab87fa9be"],"created_at":"2026-09-14T01:37:58Z","created_by_operation":"op_25d17800b46f456f8ba4aea0cdc352b4","id":"pg_0f033bc75d925272beddb692ce484ee9","maturity":"draft","page_type":"source","path":"pages/sources/big-pony-pocketshell-readme-md-8aa6474e8140-b692ce484ee9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7665d5b4c720530e8b9a2ada40835f17"],"title":"Big-Pony/pocketshell/README.md @ 8aa6474e8140","updated_at":"2026-09-14T01:37:58Z","updated_by_operation":"op_25d17800b46f456f8ba4aea0cdc352b4"}
