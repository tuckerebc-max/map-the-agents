{"access":"public","created_at":"2026-09-14T03:37:27Z","created_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d009005c4f2750eff47d27b58bb84141913fda465a84e6fc2e853059f4a0f418","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"aws-solutions-library-samples/guidance-for-multi-agent-orchestration-on-aws@092b5d81c5dc snapshot 80f619fc8f826a70","timeframe":null},"slice_ids":["slc_628a1a289194da40b66ae6141e489cab332dad57896fd4c1e8d18566dffee898"],"source_ids":["src_45f3744283755ba6a6684e820468cd68"],"text":"The Bedrock Supervisor Agent analyzes user queries for intent, routes them to suitable sub-agents, and maintains conversation context as the central orchestrator.","updated_at":"2026-09-14T03:37:27Z","updated_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd"}
{"access":"public","created_at":"2026-09-14T03:37:27Z","created_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f26a783b75d186b1cc6cbde785c1c7acf10460c68c1ef2e7c546c4dfba651c89","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"aws-solutions-library-samples/guidance-for-multi-agent-orchestration-on-aws@092b5d81c5dc snapshot 80f619fc8f826a70","timeframe":null},"slice_ids":["slc_2d569c995111f5f25b4f8cc5394d7a3ad1882db14e6f5826ebbb7ce0062ee085"],"source_ids":["src_45f3744283755ba6a6684e820468cd68"],"text":"The system uses five agents: a Supervisor Agent plus Order Management, Product Recommendation, Troubleshooting, and Personalization agents.","updated_at":"2026-09-14T03:37:27Z","updated_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd"}
