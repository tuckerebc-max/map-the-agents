{"access":"public","created_at":"2026-09-14T03:37:27Z","created_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0bfb7b9fa279a5d645b2481181c9e23318a782c21f652b2ead36e10e4a984d7f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"aws-solutions-library-samples/guidance-for-multi-agent-orchestration-on-aws@092b5d81c5dc snapshot 80f619fc8f826a70","timeframe":null},"slice_ids":["slc_50be1a6972ab07f70859088cf2043be2cb439e761a24105bc43de53bed38b822","slc_55997b9dfd852c442b72b4206af5a55c2e28ac5483f3aff6b9cfc2d1c545d505"],"source_ids":["src_3b78bc6244ad5ab1a2a293e2e9793850","src_45f3744283755ba6a6684e820468cd68"],"text":"The frontend is served from a private S3 bucket via CloudFront with Origin Access Control, protected by a CloudFront-scoped WAF using AWS managed rule sets, with Cognito handling authentication.","updated_at":"2026-09-14T03:37:27Z","updated_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd"}
{"access":"public","created_at":"2026-09-14T03:37:27Z","created_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3b005c62cdff2c918ddb4511f25ce9ebd1038d455eb7d1debd2b97ee0a29a45f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"aws-solutions-library-samples/guidance-for-multi-agent-orchestration-on-aws@092b5d81c5dc snapshot 80f619fc8f826a70","timeframe":null},"slice_ids":["slc_6a7d58556a9f539ec07d1d6a9eefcdfd267f51d7756550695620017c2f1bb337","slc_75d33d7ab45a0da294739d7360a281cfc05ca483b9ea01154e268315d7bf71fd","slc_bf9ff46a93c7f85110d126dc7c377bf530f5a9390c684bd40f44e6ceed387bc5"],"source_ids":["src_3e1e634a91485184b21ba92ea00a1390"],"text":"The GraphQL schema defines Chat and Session models with owner-based auth rules, plus a custom sendChat mutation restricted to Cognito user pools.","updated_at":"2026-09-14T03:37:27Z","updated_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd"}
{"access":"public","created_at":"2026-09-14T03:37:27Z","created_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4f491900a0c01084876d568fa99068540f4811b9919243833ec551eb93f734bf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"aws-solutions-library-samples/guidance-for-multi-agent-orchestration-on-aws@092b5d81c5dc snapshot 80f619fc8f826a70","timeframe":null},"slice_ids":["slc_15104f30bdd3bd1cceb131d847499f0d9f10c6472af4f3f3f04b0e78b0ef7463","slc_63eefb021f22b0bc0a8bf8b969af6750d57a225519be1778e6ce7fe26d07fe85"],"source_ids":["src_45f3744283755ba6a6684e820468cd68"],"text":"Session data is stored in Amazon DynamoDB, and the Personalization Agent maintains a persistent customer profile recalling prior interactions across support sessions.","updated_at":"2026-09-14T03:37:27Z","updated_by_operation":"op_b29132fd10404e2cb41a1b696f8176bd"}
