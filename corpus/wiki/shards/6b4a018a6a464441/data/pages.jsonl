","maturity":"draft","page_type":"entity","path":"pages/entities/stitionai-devika-3091d6d5de48.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"stitionai/devika","updated_at":"2026-09-14T02:43:27Z","updated_by_operation":"op_76ece0e063fb4365bc055e961d3f1825"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_14bdfab44509b1b44797209d949e2219ac69d15dfa2219608fb568681b4235c9"],"opposing_claim_ids":[],"text":"Devika supports multiple LLM providers including Claude, GPT-4/GPT-3, Gemini, Mistral, Groq, and self-hosted models via Ollama, with a unified LLM class abstracting provider APIs; the README recommends the Claude 3 family for optimal performance."},{"claim_ids":["clm_3c9ab9f86d4953be3311393b64c74883d9e292d0b0a6f77c785a66283b291de8"],"opposing_claim_ids":[],"text":"The Agent Core runs a loop where a user prompt goes to the Planner for a step plan, the Researcher extracts search queries, web results are formatted, and the Coder generates code saved to disk; follow-up prompts route through an Action agent to Runner, Feature, Patcher, or Reporter agents."}],"claim_ids":["clm_14bdfab44509b1b44797209d949e2219ac69d15dfa2219608fb568681b4235c9","clm_3c9ab9f86d4953be3311393b64c74883d9e292d0b0a6f77c785a66283b291de8"],"created_at":"2026-09-14T02:43:27Z","created_by_operation":"op_76ece0e063fb4365bc055e961d3f1825","id":"pg_114bcaae6a935e2290825ad61ee1e1ac","maturity":"draft","page_type":"source","path":"pages/sources/stitionai-devika-architecture-md-80bb343cbe4a-5ad61ee1e1ac.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6db95606c41d5a9ba641a3d0bd4d9ed0"],"title":"stitionai/devika/ARCHITECTURE.md @ 80bb343cbe4a","updated_at":"2026-09-14T02:43:27Z","updated_by_operation":"op_76ece0e063fb4365bc055e961d3f1825"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_14bdfab44509b1b44797209d949e2219ac69d15dfa2219608fb568681b4235c9"],"opposing_claim_ids":[],"text":"Devika supports multiple LLM providers including Claude, GPT-4/GPT-3, Gemini, Mistral, Groq, and self-hosted models via Ollama, with a unified LLM class abstracting provider APIs; the README recommends the Claude 3 family for optimal performance."},{"claim_ids":["clm_1d7a27b8b04ec56728b0ac5bdb318ef6fa6ba9df9294894b80e6d8f7977c6f1d"],"opposing_claim_ids":[],"text":"Runtime requirements are Python >= 3.10 and < 3.12, Node.js >= 18, and bun; Playwright is installed for browser capabilities, and API keys (OpenAI, Claude, Bing, Google, Netlify, etc.) are configured via a config.toml file and the UI settings page."},{"claim_ids":["clm_281ba8de7fae4deccd59510211fefbd5ec291a194aa052e328aba38ef476de70"],"opposing_claim_ids":[],"text":"Devika is positioned as an open-source alternative to Cognition AI's Devin, with the stated goal of matching and eventually beating Devin's SWE-bench score; the README also points to Opcode as its successor iteration."},{"claim_ids":["clm_a4fae0888b325dc2e1ba1e5a692f4777f4377a53e981e12205ce66a880022664"],"opposing_claim_ids":[],"text":"The README states the project is in a very early development/experimental stage with many unimplemented or broken features at the time of writing."}],"claim_ids":["clm_14bdfab44509b1b44797209d949e2219ac69d15dfa2219608fb568681b4235c9","clm_1d7a27b8b04ec56728b0ac5bdb318ef6fa6ba9df9294894b80e6d8f7977c6f1d","clm_281ba8de7fae4deccd59510211fefbd5ec291a194aa052e328aba38ef476de70","clm_a4fae0888b325dc2e1ba1e5a692f4777f4377a53e981e12205ce66a880022664"],"created_at":"2026-09-14T02:43:27Z","created_by_operation":"op_76ece0e063fb4365bc055e961d3f1825","id":"pg_14161599d60e54c1ba354372cf03dce4","maturity":"draft","page_type":"source","path":"pages/sources/stitionai-devika-readme-md-80bb343cbe4a-4372cf03dce4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4e3dce47cb5256e68ee1492dbd788c6a"],"title":"stitionai/devika/README.md @ 80bb343cbe4a","updated_at":"2026-09-14T02:43:27Z","updated_by_operation":"op_76ece0e063fb4365bc055e961d3f1825"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_c01d4593d3c981c9ef79be09549b11dc4cf1fc31cc8b3357d63fb78d62e153af"],"opposing_claim_ids":[],"text":"Devika's documented architecture includes a web chat UI, an Agent Core orchestrating planning and execution, specialized sub-agents, LLM integration, browser interaction, project/state management, and a database layer."}],"claim_ids":["clm_c01d4593d3c981c9ef79be09549b11dc4cf1fc31cc8b3357d63fb78d62e153af"],"created_at":"2026-09-14T02:43:27Z","created_by_operation":"op_76ece0e063fb4365bc055e961d3f1825","id":"pg_3c95d0470b6952d8affa4dd302441635","maturity":"draft","page_type":"source","path":"pages/sources/stitionai-devika-docs-architecture-readme-md-80bb343cbe4a-4dd302441635.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ab94924805e15fb0bcc0479857a9a070"],"title":"stitionai/devika/docs/architecture/README.md @ 80bb343cbe4a","updated_at":"2026-09-14T02:43:27Z","updated_by_operation":"op_76ece0e063fb4365bc055e961d3f1825"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:43:27Z","created_by_operation":"op_76ece0e063fb4365bc055e961d3f1825","id":"pg_89c90c740586544b9e7e92b9ff07aad2","maturity":"draft","page_type":"source","path":"pages/sources/stitionai-devika-requirements-txt-80bb343cbe4a-92b9ff07aad2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dea4898b7b8159a5926c4c2e810809c0"],"title":"stitionai/devika/requirements.txt @ 80bb343cbe4a","updated_at":"2026-09-14T02:43:27Z","updated_by_operation":"op_76ece0e063fb4365bc055e961d3f1825"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_14bdfab44509b1b44797209d949e2219ac69d15dfa2219608fb568681b4235c9"],"opposing_claim_ids":[],"text":"Devika supports multiple LLM providers including Claude, GPT-4/GPT-3, Gemini, Mistral, Groq, and self-hosted models via Ollama, with a unified LLM class abstracting provider APIs; the README recommends the Claude 3 family for optimal performance."},{"claim_ids":["clm_2ef8170cd13868481f5a1cc711be6664a05135f2cbd9dcb5048a2370e1121e50"],"opposing_claim_ids":[],"text":"Agents are designed to be stateless and idempotent where possible, with state and history managed centrally by the Agent Core and passed into agents as needed."},{"claim_ids":["clm_3c9ab9f86d4953be3311393b64c74883d9e292d0b0a6f77c785a66283b291de8"],"opposing_claim_ids":[],"text":"The Agent Core runs a loop where a user prompt goes to the Planner for a step plan, the Researcher extracts search queries, web results are formatted, and the Coder generates code saved to disk; follow-up prompts route through an Action agent to Runner, Feature, Patcher, or Reporter agents."},{"claim_ids":["clm_49b8fe536eac252e34cf122a6ad079b9c1d8818b99b8afd95bd176e16f50c2da"],"opposing_claim_ids":[],"text":"Devika integrates external services through GitHub and Netlify wrapper classes for git operations (clone, listing repos) and deploying web apps, returning deployed site URLs to the user."},{"claim_ids":["clm_622d45aa66c0f7e051e9bfcd0bd046cde791790c992cd8d7dd934e255462c8eb"],"opposing_claim_ids":[],"text":"Each sub-agent is implemented as a separate Python class and communicates with LLMs via Jinja2 prompt templates, following a render-query-validate-return pattern."},{"claim_ids":["clm_89017ea5798b949442207ac1ef8d483e87e6eb39ea8761c48b4340ddc3709084"],"opposing_claim_ids":[],"text":"Browser automation is provided by Browser and Crawler classes built on Playwright (Chromium), supporting navigation, DOM queries, content extraction, screenshots, and an LLM-driven action loop (e.g. CLICK or TYPE commands) over live pages."},{"claim_ids":["clm_90899b63be99daf23563bbde8a4a20e8f08584d2892cbdbe472bb33f86c51198"],"opposing_claim_ids":[],"text":"Project metadata and agent state (steps, internal monologue, browser/terminal interactions, token usage) are persisted in SQLite via SQLModel, enabling multi-project work, session continuity, auditing, and resume after interruptions."},{"claim_ids":["clm_c01d4593d3c981c9ef79be09549b11dc4cf1fc31cc8b3357d63fb78d62e153af"],"opposing_claim_ids":[],"text":"Devika's documented architecture includes a web chat UI, an Agent Core orchestrating planning and execution, specialized sub-agents, LLM integration, browser interaction, project/state management, and a database layer."},{"claim_ids":["clm_ddd283470e3650deea1e05350d740f41f84009a25061643cfc909d39a2f3b6e9"],"opposing_claim_ids":[],"text":"Stated design principles include modularity via specialized agents, pluggable LLMs and services, persistence for pause/resume and auditing, and real-time transparency of the agent's thought process to the user."}],"claim_ids":["clm_14bdfab44509b1b44797209d949e2219ac69d15dfa2219608fb568681b4235c9","clm_2ef8170cd13868481f5a1cc711be6664a05135f2cbd9dcb5048a2370e1121e50","clm_3c9ab9f86d4953be3311393b64c74883d9e292d0b0a6f77c785a66283b291de8","clm_49b8fe536eac252e34cf122a6ad079b9c1d8818b99b8afd95bd176e16f50c2da","clm_622d45aa66c0f7e051e9bfcd0bd046cde791790c992cd8d7dd934e255462c8eb","clm_89017ea5798b949442207ac1ef8d483e87e6eb39ea8761c48b4340ddc3709084","clm_90899b63be99daf23563bbde8a4a20e8f08584d2892cbdbe472bb33f86c51198","clm_c01d4593d3c981c9ef79be09549b11dc4cf1fc31cc8b3357d63fb78d62e153af","clm_ddd283470e3650deea1e05350d740f41f84009a25061643cfc909d39a2f3b6e9"],"created_at":"2026-09-14T02:43:27Z","created_by_operation":"op_76ece0e063fb4365bc055e961d3f1825","id":"pg_9485354f64be55a4b7abde710a11e4d1","maturity":"draft","page_type":"source","path":"pages/sources/stitionai-devika-docs-architecture-architecture-md-80bb343cbe4a-de710a11e4d1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_182c87c260b85aec966fa770f29052f6"],"title":"stitionai/devika/docs/architecture/ARCHITECTURE.md @ 80bb343cbe4a","updated_at":"2026-09-14T02:43:27Z","updated_by_operation":"op_76ece0e063fb4365bc055e961d3f1825"}
