{"access":"public","created_at":"2026-09-14T04:22:22Z","created_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_44d7ace5bf347adac4a794687072ae1f962ffb53c3de4f6aac4a83171baa1e85","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"soldatov-ss/django-completion@924dfae6094c snapshot 115737500698c399","timeframe":null},"slice_ids":["slc_38e018a863ae3be72c3574cf3c4ed562252492e49eba2cd689d3d3e2d646ecd8"],"source_ids":["src_bb9a7dbe414d55da8c79f80fa35692da"],"text":"The package exposes no stable public Python API for applications; it is primarily a Django management-command integration.","updated_at":"2026-09-14T04:22:22Z","updated_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef"}
{"access":"public","created_at":"2026-09-14T04:22:22Z","created_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4e162e1f946ed82c8252fd2ae8e299e70fb59cd6b90b047e6b24dd861b961bd0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"soldatov-ss/django-completion@924dfae6094c snapshot 115737500698c399","timeframe":null},"slice_ids":["slc_1909e61120a74bec0017590f7e26252c794a4ca5fd4dd7092772576dddf14f25","slc_640b8abdcffec6286be76ad21fcec36182ad73f8cfbd15b84ad27dea8026c4fd","slc_88f937dd8fde58ecb0723ca564fc59a4c6442b0f40d3c39e010efdac46944a06","slc_8e02805e071fe87840d9992211bb00a7601a437415a8000a70af0187345a42bf"],"source_ids":["src_539d3c4ead475a54b162944afabb9ec4"],"text":"Migration completion is based on migration files on disk rather than database state, respects settings.MIGRATION_MODULES, ignores private, hidden, and non-Python files, and adds `zero` at completion time rather than storing it in the cache.","updated_at":"2026-09-14T04:22:22Z","updated_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef"}
{"access":"public","created_at":"2026-09-14T04:22:22Z","created_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4e52f806e8f3f8447e18ba1b06f266b5c7d30f926a9952858b57486b32268a2f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"soldatov-ss/django-completion@924dfae6094c snapshot 115737500698c399","timeframe":null},"slice_ids":["slc_3fa032465e463864f2917c99750548974c3afe30a80afca917ee2c2104c78bae","slc_590a532ec542d77f2d84d806a0c3e8a53d0fd019caad86cc5497c36362c1f282","slc_b3f49913f6c91a41edefef3ead3ba11126f8d05ebab1f8a0b24480d023e8a9b1"],"source_ids":["src_60e787158c22502284f05fbef25f958a","src_bb9a7dbe414d55da8c79f80fa35692da"],"text":"The app registers a single `autocomplete` management command with subcommands install, status, refresh, context, and uninstall, invoked as `python manage.py autocomplete ...`.","updated_at":"2026-09-14T04:22:22Z","updated_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef"}
{"access":"public","created_at":"2026-09-14T04:22:22Z","created_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_57cae18fe09ba3e0f77ec588f7577f77af4ea4b206b96001c45aaa921978c88e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"soldatov-ss/django-completion@924dfae6094c snapshot 115737500698c399","timeframe":null},"slice_ids":["slc_15e14dee94001ebddc79f79665ce45d6da00543b472d5e6cb5e43a136f7679b3","slc_2f0fc1ec738545ffd820556ea751147741bf51b2ac0e0414dc0aafbb355852ef","slc_b46bb8e8858f55251400f08ce99f45bc4564d60f200a3b45fd0413fc89056772","slc_c471aeb059dd236fb28038acef9ecfdb9de59e893db0b57758220e427f5c82c5"],"source_ids":["src_539d3c4ead475a54b162944afabb9ec4","src_bb9a7dbe414d55da8c79f80fa35692da"],"text":"When the app is in INSTALLED_APPS, its AppConfig wraps Django's command execution so a background thread refreshes the cache after manage.py runs, with a 60-second cooldown, a process-local lock, and no blocking of the triggering command.","updated_at":"2026-09-14T04:22:22Z","updated_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef"}
{"access":"public","created_at":"2026-09-14T04:22:22Z","created_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_63e4d8753bed330a8626d0f876b840cac58bac1fbd4bb652c7ff9cbb837e3cfd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"soldatov-ss/django-completion@924dfae6094c snapshot 115737500698c399","timeframe":null},"slice_ids":["slc_16f3adeda4b66e80957c76e19db82799dfafe3f87fe8018ed9b3d89916b433b5","slc_1d17e2062795c82d1ecce721e78b304727c2b9442d163def0fb52d0c28236712","slc_965a056bb49456b29cce3e1f36e213870e9d91c425e6712876ff18825ea3c8a4","slc_fa986efaa35cfa2b6c6dc50ddaa28b9f61c9b791199e75e63920fb1167591772"],"source_ids":["src_539d3c4ead475a54b162944afabb9ec4","src_bb9a7dbe414d55da8c79f80fa35692da"],"text":"State lives in `{project_root}/.django-completion-cache.json` (schema version 2), holding command names, app labels with local/pip origin, per-command options and help, migration names, warnings, and a generated_at timestamp.","updated_at":"2026-09-14T04:22:22Z","updated_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef"}
{"access":"public","created_at":"2026-09-14T04:22:22Z","created_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_70aff5eb5918dd18f410efe9b79d0294a72452dbf16116dc87aad119b2babaef","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"soldatov-ss/django-completion@924dfae6094c snapshot 115737500698c399","timeframe":null},"slice_ids":["slc_331da164d038ae1fea51b2d4e7762219a18cfbc63ee67c889d93c28c7aa98020"],"source_ids":["src_60e787158c22502284f05fbef25f958a"],"text":"Stated limitations include bash/zsh only (fish planned), no django-admin support, no global options before the command, no custom alias support, and no database-aware applied/unapplied migration filtering.","updated_at":"2026-09-14T04:22:22Z","updated_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef"}
{"access":"public","created_at":"2026-09-14T04:22:22Z","created_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_90afabb4a6dc2077803923501739316bc6804e2f95d174ef8d3b35c3055d4eca","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"soldatov-ss/django-completion@924dfae6094c snapshot 115737500698c399","timeframe":null},"slice_ids":["slc_ccb97e3b316183c07e9b5616c27a4fd030fd8697052f670749160479d5900656","slc_d4abcbc62c6ddb88b49a97529f5cb24adc6102851b68594589554cf2bab2306d"],"source_ids":["src_539d3c4ead475a54b162944afabb9ec4","src_bb9a7dbe414d55da8c79f80fa35692da"],"text":"The cache is machine-specific runtime state not meant to be committed, and its format is a documented contract: additive changes do not bump schema_version, breaking changes do, and consumers must ignore unknown fields.","updated_at":"2026-09-14T04:22:22Z","updated_by_operation":"op_2e139ab72bc74059bb2a86e81a12a4ef"}
