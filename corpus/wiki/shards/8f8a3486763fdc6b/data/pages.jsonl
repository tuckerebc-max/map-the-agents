cf62c683ea13d381"],"created_at":"2026-09-14T01:42:04Z","created_by_operation":"op_ef565b4f361a4d8fbb373d273122e2b0","id":"pg_117d0ebeb1625d93b7eba5134d7d7891","maturity":"draft","page_type":"entity","path":"pages/entities/code4delphi-delphi-ai-developer-a5134d7d7891.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"code4delphi/delphi-ai-developer","updated_at":"2026-09-14T01:42:04Z","updated_by_operation":"op_ef565b4f361a4d8fbb373d273122e2b0"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_260c0537f9c89b6ae9e57197566c8cd48d49986cc1dd39613bd61cb08cacd56a"],"opposing_claim_ids":[],"text":"Per its LGPD statement, the plugin sends code snippets and database structure to AI APIs but claims not to store user information on external servers and not to access or send database data itself."},{"claim_ids":["clm_607423b8774f7344680b64d49f3631a73ae27ddad5ac50bdd98f918cfe51da69"],"opposing_claim_ids":[],"text":"Database structure metadata (database name, table names, field names, types, sizes) is stored locally in a JSON file on the user's computer, not exposed to any server."}],"claim_ids":["clm_260c0537f9c89b6ae9e57197566c8cd48d49986cc1dd39613bd61cb08cacd56a","clm_607423b8774f7344680b64d49f3631a73ae27ddad5ac50bdd98f918cfe51da69"],"created_at":"2026-09-14T01:42:04Z","created_by_operation":"op_ef565b4f361a4d8fbb373d273122e2b0","id":"pg_d22397a7ab765b1e8ddbdc66e9c1c2ef","maturity":"draft","page_type":"source","path":"pages/sources/code4delphi-delphi-ai-developer-lgpd-md-3d979ffc33a8-dc66e9c1c2ef.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6ecda9e4e0965a5b9f1ad1a4b8da8fa1"],"title":"Code4Delphi/Delphi-AI-Developer/LGPD.md @ 3d979ffc33a8","updated_at":"2026-09-14T01:42:04Z","updated_by_operation":"op_ef565b4f361a4d8fbb373d273122e2b0"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0eefad283aa7d81b7fe44994c4ed6e7e3b9041f36e0c9721ea8440423d5372cf"],"opposing_claim_ids":[],"text":"The plugin aims to assist with generating and refactoring code, and offers suggestions in the IDE plus user-defined predefined questions to speed up searches."},{"claim_ids":["clm_19958d98d5b56af9fecc74a02ba18c1f2501edebf7117bcaf3131834eef0fe5c"],"opposing_claim_ids":[],"text":"Online AI configuration offers a choice among Gemini, ChatGPT (OpenAI) and Groq APIs, with model selection, a key-generation link, and an API key field; Gemini and Groq are noted as free."},{"claim_ids":["clm_28646df33be5940fac2ee4d31d371e03f5f8e2601d30254bdbd663e8f0fd5e95"],"opposing_claim_ids":[],"text":"A database chat lets users register databases, generate a structure reference, ask questions, execute the returned SQL, and view, copy or export results in a grid."},{"claim_ids":["clm_72a231863161d9de5b6eb6c359d383f0cdca74f27d716e3cee3e844eb368927a"],"opposing_claim_ids":[],"text":"Installation is done by opening Package\\DelphiAIDeveloper.dpk in Delphi and installing the package; afterwards an \"AI Developer\" item appears in the IDE's main menu."},{"claim_ids":["clm_7465a5ec90899b9967a23e91eb936bd2942bae53120aa913e382611f3be9b78c"],"opposing_claim_ids":[],"text":"Users can set default prompts sent with every request to improve response quality, and can toggle modes where the AI returns only code or only SQL without comments."},{"claim_ids":["clm_74fe267cbc997e95a6d0d45a7be5e70783db5427b95750cceed7e5a76f76c021"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are welcomed via pull requests or by opening an issue in the repository."},{"claim_ids":["clm_765bca04a51544011d098dd1f8066fcf33271c4ad98fd8bc1f58d6caff593b6b"],"opposing_claim_ids":[],"text":"Offline AI relies on Ollama: users install Ollama, pick a model from its library, run \"ollama run <name_model>\", then configure the plugin's AI off-Line tab."},{"claim_ids":["clm_9dc938ff40ea5e4abf375ca5a25b751edb1e99b046887257495ff436f5b3c5bc"],"opposing_claim_ids":[],"text":"A Delphi IDE plugin, inspired by GitHub Copilot, that adds AI interaction to the Delphi IDE using the OpenAI, Gemini, Mistral and Groq APIs plus offline AI support."},{"claim_ids":["clm_cfb0d9154ee90631def244b05f9d87c8cb19f30fb2adb98d17b34f4186b23323"],"opposing_claim_ids":[],"text":"Both chats can optionally include the current unit's source code as prompt context; if code is selected only the selection is used, otherwise the entire unit."},{"claim_ids":["clm_fa9c900706e0b7024505269586b0a09f8507374388a8ea842ffa0cfac8a19c90"],"opposing_claim_ids":[],"text":"A code completion feature can be toggled on/off, configured with a default AI, suggestion highlight color, and a shortcut (default Alt+Enter, requiring IDE restart); Tab accepts the suggestion."},{"claim_ids":["clm_ff99b12755c1ec73e29cf6156a4d21fa90bd7abd49be9254cf62c683ea13d381"],"opposing_claim_ids":[],"text":"An AI chat panel is opened via the \"AI Developer\" menu or Ctrl+Shift+Alt+A, with prompt and response fields, pre-registered questions, and actions to insert selected text at the cursor, create a new unit, or copy text."}],"claim_ids":["clm_0eefad283aa7d81b7fe44994c4ed6e7e3b9041f36e0c9721ea8440423d5372cf","clm_19958d98d5b56af9fecc74a02ba18c1f2501edebf7117bcaf3131834eef0fe5c","clm_28646df33be5940fac2ee4d31d371e03f5f8e2601d30254bdbd663e8f0fd5e95","clm_72a231863161d9de5b6eb6c359d383f0cdca74f27d716e3cee3e844eb368927a","clm_7465a5ec90899b9967a23e91eb936bd2942bae53120aa913e382611f3be9b78c","clm_74fe267cbc997e95a6d0d45a7be5e70783db5427b95750cceed7e5a76f76c021","clm_765bca04a51544011d098dd1f8066fcf33271c4ad98fd8bc1f58d6caff593b6b","clm_9dc938ff40ea5e4abf375ca5a25b751edb1e99b046887257495ff436f5b3c5bc","clm_cfb0d9154ee90631def244b05f9d87c8cb19f30fb2adb98d17b34f4186b23323","clm_fa9c900706e0b7024505269586b0a09f8507374388a8ea842ffa0cfac8a19c90","clm_ff99b12755c1ec73e29cf6156a4d21fa90bd7abd49be9254cf62c683ea13d381"],"created_at":"2026-09-14T01:42:04Z","created_by_operation":"op_ef565b4f361a4d8fbb373d273122e2b0","id":"pg_e502ca7b35195645b3294c78112a535f","maturity":"draft","page_type":"source","path":"pages/sources/code4delphi-delphi-ai-developer-readme-md-3d979ffc33a8-4c78112a535f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f1105cbff9ba55fc8ba7d46063c42208"],"title":"Code4Delphi/Delphi-AI-Developer/README.md @ 3d979ffc33a8","updated_at":"2026-09-14T01:42:04Z","updated_by_operation":"op_ef565b4f361a4d8fbb373d273122e2b0"}
