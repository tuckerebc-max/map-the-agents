{"access":"public","created_at":"2026-09-14T01:42:04Z","created_by_operation":"op_ef565b4f361a4d8fbb373d273122e2b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cfb0d9154ee90631def244b05f9d87c8cb19f30fb2adb98d17b34f4186b23323","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"code4delphi/delphi-ai-developer@3d979ffc33a8 snapshot 2d3e54b5de481a65","timeframe":null},"slice_ids":["slc_43580b27c8cba2f52584d05c1cdda90a0e9d0b6cc7efc19fd46476dc0cb4eba2","slc_e6e56ca49f0fb55b1170b38f26e4778fec3713b92f178c9d3e0b144c538793da"],"source_ids":["src_f1105cbff9ba55fc8ba7d46063c42208"],"text":"Both chats can optionally include the current unit's source code as prompt context; if code is selected only the selection is used, otherwise the entire unit.","updated_at":"2026-09-14T01:42:04Z","updated_by_operation":"op_ef565b4f361a4d8fbb373d273122e2b0"}
