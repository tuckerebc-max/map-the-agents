{"access":"public","created_at":"2026-09-14T02:17:46Z","created_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_65bb3e9986beb8e87c4acd126a61f3302b1e8e832d41cb4b8b06ea1cd3aa514f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"md-ashraful-pramanik/mapcoder@c87e6d914d19 snapshot 2850d7b1842d8acf","timeframe":null},"slice_ids":["slc_240ebff84dcb12a5b8c4050843434c9b5a51703cdd22d6ff36dbaaf723de3dfa","slc_7e6a4c128828be539d56af8b594f74023e4a18a651bb315f252491957c226a91"],"source_ids":["src_c6aafec9faef522795fb398a0f98c078"],"text":"MapCoder uses four LLM agents mirroring the human programming cycle: retrieval, planning, code generation, and debugging.","updated_at":"2026-09-14T02:17:46Z","updated_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28"}
{"access":"public","created_at":"2026-09-14T02:17:46Z","created_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6e57b8870ee84ed513f5c2ef1d953f2b15e2f7aa7676beeb4c8fa29b00eb85f4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"md-ashraful-pramanik/mapcoder@c87e6d914d19 snapshot 2850d7b1842d8acf","timeframe":null},"slice_ids":["slc_596d7d45fdd4e1a3d2a2a746fe6a20f81cfa873ae786127fffdf300d26890544","slc_7e6a4c128828be539d56af8b594f74023e4a18a651bb315f252491957c226a91"],"source_ids":["src_c6aafec9faef522795fb398a0f98c078"],"text":"Reported pass@1 results include HumanEval 93.9%, MBPP 83.1%, APPS 22.0%, CodeContests 28.5%, and xCodeEval 45.3%.","updated_at":"2026-09-14T02:17:46Z","updated_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28"}
{"access":"public","created_at":"2026-09-14T02:17:46Z","created_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ac44dfdac7f8f2b421de1ee901045777f8432fc23e21a3c6939818cc5bfd04a8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"md-ashraful-pramanik/mapcoder@c87e6d914d19 snapshot 2850d7b1842d8acf","timeframe":null},"slice_ids":["slc_57e27a151a686bac2f2b00c88a815c59582b445f66269867fc3cce092e6dab9e"],"source_ids":["src_c6aafec9faef522795fb398a0f98c078"],"text":"The maintainers state this repository will no longer be maintained, pointing users to an improved model called CodeSIM.","updated_at":"2026-09-14T02:17:46Z","updated_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28"}
{"access":"public","created_at":"2026-09-14T02:17:46Z","created_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c627d387a63a52867a02a44c4075f93d34f10b7af632d43a8b8d1594783151ae","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"md-ashraful-pramanik/mapcoder@c87e6d914d19 snapshot 2850d7b1842d8acf","timeframe":null},"slice_ids":["slc_240ebff84dcb12a5b8c4050843434c9b5a51703cdd22d6ff36dbaaf723de3dfa"],"source_ids":["src_c6aafec9faef522795fb398a0f98c078"],"text":"MapCoder features an adaptive agent traversal schema that dynamically routes among agents, e.g. iteratively fixing bugs, rather than a fixed pipeline.","updated_at":"2026-09-14T02:17:46Z","updated_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28"}
{"access":"public","created_at":"2026-09-14T02:17:46Z","created_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_dfcc1581b76db3195dc0ae2686f8f7cbd82de3e7cd383edb9faabec05e0005f7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"md-ashraful-pramanik/mapcoder@c87e6d914d19 snapshot 2850d7b1842d8acf","timeframe":null},"slice_ids":["slc_5137c52f8f71deb737982d541a49c359abda263ba8ec366529a1fbe9da17697d"],"source_ids":["src_c6aafec9faef522795fb398a0f98c078"],"text":"The retrieval agent generates k user-defined similar problems using the LLM itself, without manual crafting or external retrieval models.","updated_at":"2026-09-14T02:17:46Z","updated_by_operation":"op_fccde22f514547aaab5ff9382ca8aa28"}
