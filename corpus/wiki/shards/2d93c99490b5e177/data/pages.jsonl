{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_04a98cac8e4fc7c8e9db652046fe608912d50bba946e90c2d257d7946adc6a48"],"opposing_claim_ids":[],"text":"The account plans include open-weight models (Kimi, Qwen, DeepSeek, GLM, MiniMax, MiMo, Mistral) and proprietary models from Anthropic, OpenAI, Google, and xAI."},{"claim_ids":["clm_141ddc97ea628b2dff42cc6c20422bbaaccfc7fb171cca998f2a974577eafff8"],"opposing_claim_ids":[],"text":"A stagewise Account offers Free, Pro ($20/mo), and Ultra ($200/mo) plans with differing model access and usage limits."},{"claim_ids":["clm_31abc05228e515e9f81c9383413b7945e397357f0ef0fc74408125cc92db5967"],"opposing_claim_ids":[],"text":"Documented provider integrations include Moonshot Kimi, Alibaba Qwen, MiniMax, Xiaomi MiMo, Mistral, and OpenRouter access to 345+ models via one API key."},{"claim_ids":["clm_9268d1fd3bd3de6efa18672a572c259350fccf3c73646a4510db68276bf69387"],"opposing_claim_ids":[],"text":"The product supports bring-your-own-key for all AI providers, including registering fully custom providers such as local inference and defining custom models."},{"claim_ids":["clm_942b279636b539922f7565ab05eb92094356585979b38b5180834ccd7aed80ad"],"opposing_claim_ids":[],"text":"The product lets users work with a coding agent that has access to the browser tab's console and debugger, and supports IDE integration to view and apply code changes."},{"claim_ids":["clm_9cd993e3677fd0a308661d28ddc7d4416f03e53d69c903c2d274a1e261939900"],"opposing_claim_ids":[],"text":"Stagewise is developed by stagewise GmbH and offered under the AGPLv3 license, with out-of-scope use cases handled by contacting sales."},{"claim_ids":["clm_9e0c21fc0516a7b0fd91e199459584f4dee66bd565d4d57e4aca0bde881c5da0"],"opposing_claim_ids":[],"text":"Stagewise is described as an open-source agentic IDE for developers with a coding agent built in."}],"claim_ids":["clm_04a98cac8e4fc7c8e9db652046fe608912d50bba946e90c2d257d7946adc6a48","clm_141ddc97ea628b2dff42cc6c2042