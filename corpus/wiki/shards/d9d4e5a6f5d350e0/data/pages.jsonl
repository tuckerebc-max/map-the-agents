{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_09469cabc0cfcbd4fe0a29f641cec7be66ee1c2a6f5948a1d63c9031d608c306"],"opposing_claim_ids":[],"text":"Repository development practice: the security policy asks vulnerability reports be emailed to security@roocode.com with summary, reproduction steps, and logs; reports are acknowledged within 48 hours with fixes targeted within 30 days."}],"claim_ids":["clm_09469cabc0cfcbd4fe0a29f641cec7be66ee1c2a6f5948a1d63c9031d608c306"],"created_at":"2026-09-14T02:36:12Z","created_by_operation":"op_6364ac892dd840bb952f861733346b60","id":"pg_df70a3b53254500a9e2a81ea5888b549","maturity":"draft","page_type":"source","path":"pages/sources/roocodeinc-roo-code-security-md-b867ec914575-81ea5888b549.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_092b6deed7045aed8bf2efb8ce941378"],"title":"RooCodeInc/Roo-Code/SECURITY.md @ b867ec914575","updated_at":"2026-09-14T02:36:12Z","updated_by_operation":"op_6364ac892dd840bb952f861733346b60"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_03de8174369f630fed76fa9f136d65601e355b7d5fe269b64bce50bd2c556c53"],"opposing_claim_ids":[],"text":"Commands executed through Roo Code run in the user's local environment, and users can run models locally to avoid third-party data transmission."},{"claim_ids":["clm_0e391553f12f7176a2f6c321968ae6160fc933429054b446e80fab6305a02c46"],"opposing_claim_ids":[],"text":"Anonymous telemetry via PostHog (VS Code machine ID, usage patterns, exception reports) is enabled by default but can be opted out in settings."},{"claim_ids":["clm_1512bb45e905b5c6c31a1bc4e354d5e95205b6b764a4a6e18d924be545942bdb"],"opposing_claim_ids":[],"text":"The extension sends prompts and relevant project context to a user-chosen AI model provider such as OpenAI, Anthropic, or OpenRouter."},{"claim_ids":["clm_c95d13fc6d6aed343908e6b7dfbb03aac1e38fc9cca715d901b52224fb422671"],"opposing_claim_ids":[],"text":"API keys entered by the user are stored locally on the device and are not sent to Roo Code or third parties other than the chosen provider."}],"claim_ids":["clm_03de8174369f630fed76fa9f136d65601e355b7d5fe269b64bce50bd2c556c53","clm_0e391553f12f7176a2f6c321968ae6160fc933429054b446e80fab6305a02c46","clm_1512bb45e905b5c6c31a1bc4e354d5e95205b6b764a4a6e18d924be545942bdb","clm_c95d13fc6d6aed343908e6b7dfbb03aac1e38fc9cca715d901b52224fb422671"],"created_at":"2026-09-14T02:36:12Z","created_by_operation":"op_6364ac892dd840bb952f861733346b60","id":"pg_ec21788726d05eaf8571dc27c7bab379","maturity":"draft","page_type":"source","path":"pages/sources/roocodeinc-roo-code-privacy-md-b867ec914575-dc27c7bab379.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_85dc33b403c25338b03959e048ffc9da"],"title":"RooCodeInc/Roo-Code/PRIVACY.md @ b867ec914575","updated_at":"2026-09-14T02:36:12Z","updated_by_operation":"op_6364ac892dd840bb952f861733346b60"}
