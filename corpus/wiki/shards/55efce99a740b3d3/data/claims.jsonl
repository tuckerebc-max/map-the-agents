{"access":"public","created_at":"2026-09-14T02:41:10Z","created_by_operation":"op_a9f6111b00014f6aa593f43ed717f950","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_47b5afd707d9cc986839d139be55dbfbcc73b24ae3b0cb0f0a93e083f74c254c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"snarktank/ralph@6c53cb0b831e snapshot 5018f9fc18d59882","timeframe":null},"slice_ids":["slc_2d6e4e04b4dc67c0334cc56d49acb48922127d006edab27cfa6751317fa272b6","slc_ee31509558238e8ce2cdfd026a48897a6dfba76b420542954b1d3c5b87be9c86"],"source_ids":["src_66f1076290e15f17885d25439df8c72a"],"text":"A recommended Amp auto-handoff setting (context 90) enables automatic handoff when context fills, letting Ralph handle stories larger than one context window.","updated_at":"2026-09-14T02:41:10Z","updated_by_operation":"op_a9f6111b00014f6aa593f43ed717f950"}
{"access":"public","created_at":"2026-09-14T02:41:10Z","created_by_operation":"op_a9f6111b00014f6aa593f43ed717f950","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_54a1a0f5098ee00a2e3990252799d74d4bb67491bccd573b68936b6dec47101c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"snarktank/ralph@6c53cb0b831e snapshot 5018f9fc18d59882","timeframe":null},"slice_ids":["slc_428911831efd2105297098596f8556174e3ee5214cc070af510c4b9273dce44b"],"source_ids":["src_66f1076290e15f17885d25439df8c72a"],"text":"Each loop iteration creates a feature branch from the PRD branchName, picks the highest-priority story with passes:false, implements it, runs quality checks, commits, marks it passes:true, and repeats until done or max iterations.","updated_at":"2026-09-14T02:41:10Z","updated_by_operation":"op_a9f6111b00014f6aa593f43ed717f950"}
