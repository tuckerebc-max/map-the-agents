{"access":"public","created_at":"2026-09-14T01:37:43Z","created_by_operation":"op_f839a6060e9a42d3a170c71f3fe3b8f4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8d4a16d014f6a851e63fb00ead2cbe9f5c82a76b88cbef174bf913669e57d5db","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"bhouston/mycoder@774e068e5dae snapshot 3e0884f69cea3872","timeframe":null},"slice_ids":["slc_3ffa49203a5b32b08568031f0b966d76bf903c8c2b65108d557eb549bdf9d598","slc_d55f7fb506b5a5fc4d9485ba9c94db4abc2baea39d899fdb1d2085035cd9eec8"],"source_ids":["src_f04ea5b7b3615a67bd10d659bf81662c"],"text":"The agent leverages Anthropic's Claude, OpenAI models, and Ollama, and uses Playwright for browser automation, which normally requires separate browser installation.","updated_at":"2026-09-14T01:37:43Z","updated_by_operation":"op_f839a6060e9a42d3a170c71f3fe3b8f4"}
