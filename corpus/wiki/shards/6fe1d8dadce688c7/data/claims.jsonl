{"access":"public","created_at":"2026-09-14T01:37:43Z","created_by_operation":"op_f839a6060e9a42d3a170c71f3fe3b8f4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ecf349c0bd1940a90fbc41b5f8c43b29846c156987b03855a328e2adb04fecae","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"bhouston/mycoder@774e068e5dae snapshot 3e0884f69cea3872","timeframe":null},"slice_ids":["slc_094c08e9844d02c205e6caca2ab3d3362d8941af66cb52b0d63b0203c2cb5289","slc_625dd3740a15f3c8e4c3953742dfa2dc084c5c088f5971ec811762cb6337e6ec","slc_6728743b1769d0f652f9c20170f18483ee8dc4f3960fb8eafe9cc9136f46a9b3","slc_d08ca604e3d9fa87b18a04a1e4e5d51f6d9ad35c9f16b95249271f8e855cb876"],"source_ids":["src_806b1848d4e150229786b012fb157f31"],"text":"Status updates are sent every 5 interactions and when token usage exceeds 50%, and above 70% usage the agent is reminded to use the compactHistory tool, which summarizes all but a configurable number of recent messages.","updated_at":"2026-09-14T01:37:43Z","updated_by_operation":"op_f839a6060e9a42d3a170c71f3fe3b8f4"}
