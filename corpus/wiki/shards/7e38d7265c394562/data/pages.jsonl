{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4d2469188cca33a84190b73e85f0dfe5f2b3b8be6a8b5419247e1ae0703d6645"],"opposing_claim_ids":[],"text":"The proxy listens on localhost port 8317; Amp routes /auth/cli-login and /api/* to ampcode.com and /provider/* to CLIProxyAPI on port 8318."},{"claim_ids":["clm_7dd0a1f0c84cdae1d84dc655a5af37530b11c8adbd35eccf469d1c48464957f2"],"opposing_claim_ids":[],"text":"Multiple accounts per provider are supported with automatic round-robin distribution and failover when rate-limited; provider enable/disable toggles hot-reload instantly without restart."}],"claim_ids":["clm_4d2469188cca33a84190b73e85f0dfe5f2b3b8be6a8b5419247e1ae0703d6645","clm_7dd0a1f0c84cdae1d84dc655a5af37530b11c8adbd35eccf469d1c48464957f2"],"created_at":"2026-09-14T03:36:16Z","created_by_operation":"op_fccc64fe984a4a3bb15e1ad6648f64fa","id":"pg_6702886ef45b5fba83409537d73d8156","maturity":"draft","page_type":"source","path":"pages/sources/automazeio-vibeproxy-ampcode-setup-md-083c13220691-9537d73d8156.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_63fc338067e55fa3b7fcfbb093d44299"],"title":"automazeio/vibeproxy/AMPCODE_SETUP.md @ 083c13220691","updated_at":"2026-09-14T03:36:16Z","updated_by_operation":"op_fccc64fe984a4a3bb15e1ad6648f64fa"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_67cff387cb084f210552ee6a206d247a3144b2988d37b028466c44fe9bc452ea"],"opposing_claim_ids":[],"text":"ServerManager controls the cli-proxy-api server process and OAuth authentication; AuthStatus monitors ~/.cli-proxy-api/ for auth files with real-time updates when files are added or removed."},{"claim_ids":["clm_6efbb2bee8d58a96595c15b4a097df464bbf24f615f1a118a2331b6d8d9eac0a"],"opposing_claim_ids":[],"text":"The app consists of Swift sources (AppDelegate, ServerManager, SettingsView, AuthStatus) plus a bundled cli-proxy-api-plus binary, config.yaml, and icon resources inside the .app."},{"claim_ids":["clm_7dd0a1f0c84cdae1d84dc655a5af37530b11c8adbd35eccf469d1c48464957f2"],"opposing_claim_ids":[],"text":"Multiple accounts per provider are supported with automatic round-robin distribution and failover when rate-limited; provider enable/disable toggles hot-reload instantly without restart."},{"claim_ids":["clm_982b0196c9f614c2b3ea75b14c96a1f92b4f8e3a43b48c6402cb2a7a90d60933"],"opposing_claim_ids":[],"text":"VibeProxy is built on CLIProxyAPIPlus (CLIProxyAPI), which provides the core OAuth handling, token management, and API routing; the binary is bundled in the app."},{"claim_ids":["clm_f2ed4425d9833dae9312eb707ad4d498dc777c463e8ce2e4d0154e09d24797ab"],"opposing_claim_ids":[],"text":"The Intel build is marked untested with users asked to report issues; the app requires macOS 13 (Ventura) or later."}],"claim_ids":["clm_67cff387cb084f210552ee6a206d247a3144b2988d37b028466c44fe9bc452ea","clm_6efbb2bee8d58a96595c15b4a097df464bbf24f615f1a118a2331b6d8d9eac0a","clm_7dd0a1f0c84cdae1d84dc655a5af37530b11c8adbd35eccf469d1c48464957f2","clm_982b0196c9f614c2b3ea75b14c96a1f92b4f8e3a43b48c6402cb2a7a90d60933","clm_f2ed4425d9833dae9312eb707ad4d498dc777c463e8ce2e4d0154e09d24797ab"],"created_at":"2026-09-14T03:36:16Z","created_by_operation":"op_fccc64fe984a4a3bb15e1ad6648f64fa","id":"pg_a1f69e7151075e0896073146fde78bad","maturit