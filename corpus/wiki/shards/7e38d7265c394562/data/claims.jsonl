{"access":"public","created_at":"2026-09-14T03:36:16Z","created_by_operation":"op_fccc64fe984a4a3bb15e1ad6648f64fa","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1ca2a64908f966c79e9e393fe9ceb99bbd05bab845401b9f80d2b3959f69bde5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"automazeio/vibeproxy@083c13220691 snapshot 3fe5e881ed22f24d","timeframe":null},"slice_ids":["slc_6fbd0c8971d91d1ddb76fc8193f3809f5738589b70b20b441623ea3cd53fca1e"],"source_ids":["src_44392680481757d8a3daa80d6965b223"],"text":"Invalid thinking suffixes (non-integer) are stripped and the vanilla model is used without thinking.","updated_at":"2026-09-14T03:36:16Z","updated_by_operation":"op_fccc64fe984a4a3bb15e1ad6648f64fa"}
{"access":"public","created_at":"2026-09-14T03:36:16Z","created_by_operation":"op_fccc64fe984a4a3bb15e1ad6648f64fa","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3c8f1fd78531f4f707a264dbc25b58634b776715c51d27b8bbbc92181db2a2d6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"automazeio/vibeproxy@083c13220691 snapshot 3fe5e881ed22f24d","timeframe":null},"slice_ids":["slc_7055401d7dba8afa09d69ebbf1b20d448fe005157ad78bd6d774f56d092c8181","slc_abbb115e800173c25855db4eb724a23757de1ee2e751dafa56b141ae788f4b60","slc_bc21d382bc9c082307f4474be109a00da004a45978a480b9fe80bf964b7177b2"],"source_ids":["src_44392680481757d8a3daa80d6965b223"],"text":"VibeProxy supports a custom model-name suffix pattern {model}-thinking-{NUMBER} that it intercepts, strips, and converts into a thinking token-budget parameter before forwarding to CLIProxyAPI.","updated_at":"2026-09-14T03:36:16Z","updated_by_operation":"op_fccc64fe984a4a3bb15e1ad6648f64fa"}
{"access":"public","created_at":"2026-09-14T03:36:16Z","created_by_operation":"op_fccc64fe984a4a3bb15e1ad6648f64fa","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4d2469188cca33a84190b73e85f0dfe5f2b3b8be6a8b5419247e1ae0703d6645","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"automazeio/vibeproxy@083c13220691 snapshot 3fe5e881ed22f24d","timeframe":null},"slice_ids":["slc_4c481d49ad67063480226d8ebdad8319ab4c4fa32d97b7853745de1583f23f16","slc_9c39286ad77d2e86a3d46bdd81b90d510ef91a5a52494b5402a7f37238211085"],"source_ids":["src_44392680481757d8a3daa80d6965b223","src_63fc338067e55fa3b7fcfbb093d44299"],"text":"The proxy listens on localhost port 8317; Amp routes /auth/cli-login and /api/* to ampcode.com and /provider/* to CLIProxyAPI on port 8318.","updated_at":"2026-09-14T03:36:16Z","updated_by_operation":"op_fccc64fe984a4a3bb15e1ad6648f64fa"}
