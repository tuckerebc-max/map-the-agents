{"access":"public","created_at":"2026-09-14T01:49:13Z","created_by_operation":"op_37ca757c4a3b44eaa619516d17658b4e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0d4acf8c87ce6457c0b4373cb82e21077c86bb58297f90ec4fc45e2218f7497f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"fsoft-ai4code/hyperagent@c3092f2601ab snapshot 0c32860f5740328f","timeframe":null},"slice_ids":["slc_e647615b51da790d9894d0048161adf1e915e2c799c4e919055c3af51c619174"],"source_ids":["src_eb58e1a14bea52ef835d736e6128fdf6"],"text":"The system comprises four specialized agents: Planner, Navigator, Code Editor, and Executor, covering the SE task lifecycle from conception to verification.","updated_at":"2026-09-14T01:49:13Z","updated_by_operation":"op_37ca757c4a3b44eaa619516d17658b4e"}
{"access":"public","created_at":"2026-09-14T01:49:13Z","created_by_operation":"op_37ca757c4a3b44eaa619516d17658b4e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3583f0bab1f1da9c69758a7f5a1c737fe396a5711ae11a14173817037a38aaee","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"fsoft-ai4code/hyperagent@c3092f2601ab snapshot 0c32860f5740328f","timeframe":null},"slice_ids":["slc_86e389cd06f65b90a69afebe0292bca4217b9dfd23e1949048e51d3d3b4b0e15"],"source_ids":["src_eb58e1a14bea52ef835d736e6128fdf6"],"text":"Agent configuration is per-role: the config dict keys nav, edit, exec, and plan each take model settings (e.g., Claude models with API keys, stop sequences, base URLs), plus a 'type' field such as 'patch'.","updated_at":"2026-09-14T01:49:13Z","updated_by_operation":"op_37ca757c4a3b44eaa619516d17658b4e"}
