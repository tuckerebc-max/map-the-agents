{"access":"public","created_at":"2026-09-14T01:49:13Z","created_by_operation":"op_37ca757c4a3b44eaa619516d17658b4e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_abfadf4a69b40849c0a722fb0645406439abab413aa92dbe0d01f813cf71d45d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"fsoft-ai4code/hyperagent@c3092f2601ab snapshot 0c32860f5740328f","timeframe":null},"slice_ids":["slc_6c02fd9e84139cea38ef617fa9bb8b370de5a3b7f99bf082099196c7e1054e9b","slc_9c7ac8f6c018e73333611f99d5709dd785df2425bc1d8582e63df59fa19ce6b5","slc_b7ceae94cc78a5db7523f968004c1ea5646148c3d6a177560989c004bc1a0821","slc_fe299955ca1f9b375864b94027318a4317b6d25c64f18b9df334feb2ff42ebe2"],"source_ids":["src_eb58e1a14bea52ef835d736e6128fdf6"],"text":"Repository development practice: reproduction scripts are provided in the scripts folder for SWE-Bench, RepoExec, and Defects4J, e.g. run_swe_bench.py, run_defects4j_fl.py, and run_defects4j_apr.py.","updated_at":"2026-09-14T01:49:13Z","updated_by_operation":"op_37ca757c4a3b44eaa619516d17658b4e"}
