{"access":"public","created_at":"2026-09-14T01:49:13Z","created_by_operation":"op_37ca757c4a3b44eaa619516d17658b4e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4ac07b97f002f03fba8240f94ac5a77e39a02828ea07027ebe5de00f3eb3a309","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"fsoft-ai4code/hyperagent@c3092f2601ab snapshot 0c32860f5740328f","timeframe":null},"slice_ids":["slc_e647615b51da790d9894d0048161adf1e915e2c799c4e919055c3af51c619174"],"source_ids":["src_eb58e1a14bea52ef835d736e6128fdf6"],"text":"HyperAgent is described as a generalist multi-agent system for a wide range of software engineering tasks across programming languages, mimicking human developer workflows.","updated_at":"2026-09-14T01:49:13Z","updated_by_operation":"op_37ca757c4a3b44eaa619516d17658b4e"}
