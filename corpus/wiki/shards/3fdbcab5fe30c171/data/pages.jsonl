{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4d8ade6f032e585ff1b1867a0830685d98e720922af745138e0939760ba18cf6"],"opposing_claim_ids":[],"text":"The CLI positions itself as a safety layer: it runs agent output in isolated Docker containers locally, auto-redacts secrets and API keys, and provides observability via real-time logs, traces, and metrics."},{"claim_ids":["clm_6aa1bc9760bd5f3025e1ca6853338fa824fd31283901a480bb54f2347d0f4f59"],"opposing_claim_ids":[],"text":"The README advertises related packages installable as @vibe-kit/sdk (run coding agents in secure sandboxes) and @vibe-kit/auth (handle authentication flows for VibeKit-powered applications)."},{"claim_ids":["clm_854517df0732636e175bcfcb5e1642a2907a480af35a3cb61fbc533cfd395f31"],"opposing_claim_ids":[],"text":"The CLI claims to work entirely offline and locally with no cloud dependencies, and to support Claude Code, Gemini CLI, Grok CLI, Codex CLI, OpenCode, and more."}],"claim_ids":["clm_4d8ade6f032e585ff1b1867a0830685d98e720922af745138e0939760ba18cf6","clm_6aa1bc9760bd5f3025e1ca6853338fa824fd31283901a480bb54f2347d0f4f59","clm_854517df0732636e175bcfcb5e1642a2907a480af35a3cb61fbc533cfd395f31"],"created_at":"2026-09-14T03:17:07Z","created_by_operation":"op_a2f1c14b46044abfa55e0d3366823de6","id":"pg_07e80429953b5f6dbf926c4fd7aef661","maturity":"draft","page_type":"source","path":"pages/sources/superagent-ai-vibekit-readme-md-c670afd2e332-6c4fd7aef661.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_61da90686b575a9b8a76e4882cfcc4e5"],"title":"superagent-ai/vibekit/README.md @ c670afd2e332","updated_at":"2026-09-14T03:17:07Z","updated_by_operation":"op_a2f1c14b46044abfa55e0d3366823de6"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_06bb76789dfc3e916b0109c921b13b6eb23f90a16f7f92d1488d4dee025098de"],"opposing_claim_ids":[],"text":"The core package is @vibe-kit/vibekit at version 0.0.43 with main entry dist/index.js."},{"claim_ids":["clm_0e9f065cdf2484fe05d6b3b70664c9a3b0b93767e7f9425889f11527a1449b93"],"opposing_claim_ids":[],"text":"The SDK exposes event listeners via .on('update') and .on('error') for streaming progress and errors."},{"claim_ids":["clm_13ca6cdd1bebbe1eb04971d6171499b0bf4e64ab2be3562bbf571eef5fa22d3d"],"opposing_claim_ids":[],"text":"Common environment variables include OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY, E2B_API_KEY, DAYTONA_API_KEY, NORTHFLANK_API_KEY, and GITHUB_TOKEN."},{"claim_ids":["clm_1a03d8f7ebe2fd511a51c2b51785c7078dc7761c1aa4d92dc0ae29b4b84cced9"],"opposing_claim_ids":[],"text":"The SDK uses a builder pattern: new VibeKit() configured via withAgent (type, provider, apiKey, model), withSandbox, withGithub, withSecrets, and withWorkingDirectory."},{"claim_ids":["clm_2d356680516396ac4bd74b9fa23af0464fac7f7bb24a977270aba83a8876a183"],"opposing_claim_ids":[],"text":"Sandbox providers are separate packages: @vibe-kit/e2b, @vibe-kit/daytona, @vibe-kit/northflank, @vibe-kit/cloudflare (Workers only), and @vibe-kit/modal."},{"claim_ids":["clm_657aa16d28ceeacc66b5e731fad36e26a1e856498ff0af666df1ec2715583279"],"opposing_claim_ids":[],"text":"Documented SDK methods include generateCode(prompt, mode) with 'code' or 'ask' modes, executeCommand, getHost(port), pause, resume, createPullRequest, and kill."},{"claim_ids":["clm_69578c6cef61e07b6ae58db8535d69a7faece0a88d01872ac8df0344f2bf4f01"],"opposing_claim_ids":[],"text":"VibeKit is described as a TypeScript SDK for running AI coding agents (Claude, Codex, Gemini, OpenCode) in secure sandboxes with GitHub integration."},{"claim_ids":["clm_e3930ee3d6991f6f0073ce384a48e199b5e2ae7b6cae66b1cc93d16496d1b4aa"],"opposing_claim_ids":[],"text":"Cloudflare sandboxes only work inside Cloudflare Workers and cannot be used in regular Node.js applications or other environments; they use Durable Object bindings instead of API keys."},{"claim_ids":["clm_f75c71fdbafcf0cd881c6b47ec33712830ef9b89af499a6ccf7306ca5c0066a2"],"opposing_claim_ids":[],"text":"The SDK is documented as fully typed with TypeScript definitions, exporting types such as VibeKit, AgentResponse, AgentType, ModelProvider, and per-provider config types."}],"claim_ids":["clm_06bb76789dfc3e916b0109c921b13b6eb23f90a16f7f92d1488d4dee025098de","clm_0e9f065cdf2484fe05d6b3b70664c9a3b0b93767e7f9425889f11527a1449b93","clm_13ca6cdd1bebbe1eb04971d6171499b0bf4e64ab2be3562bbf571eef5fa22d3d","clm_1a03d8f7ebe2fd511a51c2b51785c7078dc7761c1aa4d92dc0ae29b4b84cced9","clm_2d356680516396ac4bd74b9fa23af0464fac7f7bb24a977270aba83a8876a183","clm_657aa16d28ceeacc66b5e731fad36e26a1e856498ff0af666df1ec2715583279","clm_69578c6cef61e07b6ae58db8535d69a7faece0a88d01872ac8df0344f2bf4f01","clm_e3930ee3d6991f6f0073ce384a48e199b5e2ae7b6cae66b1cc93d16496d1b4aa","clm_f75c71fdbafcf0cd881c6b47ec33712830ef9b89af499a6ccf7306ca5c0066a2"],"created_at":"2026-09-14T03:17:07Z","created_by_operation":"op_a2f1c14b46044abfa55e0d3366823de6","id":"pg_1da2138217e957148a33ff12ce91d82a","maturity":"draft","page_type":"source","path":"pages/sources/superagent-ai-vibekit-llm-md-c670afd2e332-ff12ce91d82a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_49a8b5e9f0ac576a9683d64fb5fc3068"],"title":"superagent-ai/vibekit/LLM.md @ c670afd2e332","updated_at":"2026-09-14T03:17:07Z","updated_by_operation":"op_a2f1c14b46044abfa55e0d3366823de6"}
