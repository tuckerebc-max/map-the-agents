{"access":"public","created_at":"2026-09-14T02:10:53Z","created_by_operation":"op_820005116da34a28b4dc8c56001d0728","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_64653353ca8da447f4a4ba884515fc556945824ab132da7f8f41c7ef6493ff98","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"kunagent/kun@e67f656bca57 snapshot 2169da6efe174106","timeframe":null},"slice_ids":["slc_75ab02f5a2a243837ab85f2e28a70b6930d13d8c7927b6591a78693034a8167d","slc_afd7df36e58c6718329ee6989f8b923a4af929f6201904d85e87da2d4ee91aca"],"source_ids":["src_c9098ce3c4405c8c8eb35e3894c9a7f8"],"text":"The desktop GUI and terminal TUI share a single local `kun serve` runtime, sharing threads, goals, plans, approvals, and background tasks rather than separate sessions.","updated_at":"2026-09-14T02:10:53Z","updated_by_operation":"op_820005116da34a28b4dc8c56001d0728"}
{"access":"public","created_at":"2026-09-14T02:10:53Z","created_by_operation":"op_820005116da34a28b4dc8c56001d0728","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7690a1605aa9636a6b79c4646b81f7440fc476eda6c11ff053a5ceddcd1e7850","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"kunagent/kun@e67f656bca57 snapshot 2169da6efe174106","timeframe":null},"slice_ids":["slc_5574012fd8a3760b79ec3ec260b8315df220f60f42a6eb9b655ab8ce2d2a983f"],"source_ids":["src_c9098ce3c4405c8c8eb35e3894c9a7f8"],"text":"Kun is described as a local-first AI agent workbench with two main modes: Code for software delivery (with a Design canvas in the same task) and Work for writing, document analysis, and presentations.","updated_at":"2026-09-14T02:10:53Z","updated_by_operation":"op_820005116da34a28b4dc8c56001d0728"}
{"access":"public","created_at":"2026-09-14T02:10:53Z","created_by_operation":"op_820005116da34a28b4dc8c56001d0728","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_aabd013dc46c2cb796d9ffda0973ad3f64ce925657bf582c5225eed4243bf84a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"kunagent/kun@e67f656bca57 snapshot 2169da6efe174106","timeframe":null},"slice_ids":["slc_5ab8b73c55060601281cfcb70dfec6cd3039b58401461634ac24e5eb2456f3ae"],"source_ids":["src_c9098ce3c4405c8c8eb35e3894c9a7f8"],"text":"Sessions, preferences, logs, and runtime data are stored locally by default; when a cloud model is chosen, prompts, attachments, and task context are sent to the selected provider, and tool/extension permissions are surfaced in the UI for user approval.","updated_at":"2026-09-14T02:10:53Z","updated_by_operation":"op_820005116da34a28b4dc8c56001d0728"}
