{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_283f95b00a318f8a9f87b30765e6882540ca3a7282fad85c164f2ffd5918e9c0"],"opposing_claim_ids":[],"text":"Repository development practice: bug reports, pull requests, and documentation improvements are welcome, and a Contributor Covenant-based code of conduct governs the community."},{"claim_ids":["clm_3dcb2265348d48aaf20cbf42c0fb80205c81b2a3ee22178192f6e88bb2d40b76"],"opposing_claim_ids":[],"text":"Repository development practice: dev setup installs pytest, mypy, ruff, and types-PyYAML; tests run with 'pytest tests -v', linting via ruff, and type checking via mypy codefox."},{"claim_ids":["clm_4b41872cc74b3cdd194e465d7060119be7b71b40fb127436a0d7f3491c499b46"],"opposing_claim_ids":[],"text":"The tool is positioned as a CLI-first diff review tool, explicitly not an IDE coding assistant like Cursor or Claude Code."},{"claim_ids":["clm_790326232abb5c5523f567e39d219b0ffedeaff9b2676a35e131d2769129637a"],"opposing_claim_ids":[],"text":"Configuration uses ./.codefox.yml for model and analysis settings, ./.codefoxignore for excluded paths, and ./codefoxenv for the API token."},{"claim_ids":["clm_aa3bd5cdb417dd33d5c20697b78fc9637600c52a86016c2acfcd80a9fc7b80fb"],"opposing_claim_ids":[],"text":"The scan command collects the current git diff, loads project context, sends a review request to the configured model, and returns review comments with optional fix suggestions."},{"claim_ids":["clm_b8c3c78c82174558adf84c5c709c2d993c95dd72a7d2405468359489cbdb016b"],"opposing_claim_ids":[],"text":"The CLI exposes commands: init, list, scan, version, clean, and --help, per the commands table."},{"claim_ids":["clm_bddcabe4e1e06c7aa3522a1051b41015d54d265af12f37239c4b6539661b75a0"],"opposing_claim_ids":[],"text":"Supported providers are Gemini (default), Ollama for local/remote servers, and OpenRouter; Ollama allows fully local reviews."}],"claim_ids":["clm_283f95b00a318f8a9f87b30765e6882540ca3a7282fad85c164f2ffd5918e9c0","clm_3dcb2265348d48aaf20cbf42c0fb80205c81b2a3ee22178192f6e88bb2d40b76","clm_4b41872cc74b3cdd194e465d7060119be7b71b40fb127436a0d7f3491c499b46","clm_790326232abb5c5523f567e39d219b0ffedeaff9b2676a35e131d2769129637a","clm_aa3bd5cdb417dd33d5c20697b78fc9637600c52a86016c2acfcd80a9fc7b80fb","clm_b8c3c78c82174558adf84c5c709c2d993c95dd72a7d2405468359489cbdb016b","clm_bddcabe4e1e06c7aa3522a1051b41015d54d265af12f37239c4b6539661b75a0"],"created_at":"2026-09-14T03:41:04Z","created_by_operation":"op_37873c8190ce4e87947e6595e035476f","id":"pg_bc4082432e175c57811a1d1121eb82d2","maturity":"draft","page_type":"source","path":"pages/sources/codefox-lab-codefox-cli-readme-md-7b5f855fb6b5-1d1121eb82d2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8fc8adbae2425a21a46085a4f2f80203"],"title":"codefox-lab/CodeFox-CLI/README.md @ 7b5f855fb6b5","updated_at":"2026-09-14T03:41:04Z","updated_by_operation":"op_37873c8190ce4e87947e6595e035476f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_85429c59af7c20ec475ff145d3a4b3d1507942d7120fa382cf5d5aeca9af38b7"],"opposing_claim_ids":[],"text":"Analysis rule categories cover security (vulnerabilities, secret leaks), performance, and style, toggleable in the ruler config section."},{"claim_ids":["clm_bddcabe4e1e06c7aa3522a1051b41015d54d265af12f37239c4b6539661b75a0"],"opposing_claim_ids":[],"text":"Supported providers are Gemini (default), Ollama for local/remote servers, and OpenRouter; Ollama allows fully local reviews."},{"claim_ids":["clm_e31ee75fc39008345d739c17892878e761989d34c69e1a7fcea72c8c6e33cbdf"],"opposing_claim_ids":[],"text":"The system prompt can be fully overridden via prompt.system, and prompt options include hard_mode, short_mode, and strict_facts."},{"claim_ids":["clm_f94f33ccd8cd547116554f21493e51889dbddd8d125e76d37f2cf78aba797c3c"],"opposing_claim_ids":[],"text":"RAG-based context retrieval is configurable: chunk size, overlap, max RAG characters, embedding batch size, and lazy loading, with fastembed embedding defaulting to BAAI/bge-small-en-v1.5."}],"claim_ids":["clm_85429c59af7c20ec475ff145d3a4b3d1507942d7120fa382cf5d5aeca9af38b7","clm_bddcabe4e1e06c7aa3522a1051b41015d54d265af12f37239c4b6539661b75a0","clm_e31ee75fc39008345d739c17892878e761989d34c69e1a7fcea72c8c6e33cbdf","clm_f94f33ccd8cd547116554f21493e51889dbddd8d125e76d37f2cf78aba797c3c"],"created_at":"2026-09-14T03:41:04Z","created_by_operation":"op_37873c8190ce4e87947e6595e035476f","id":"pg_f38db79ef6d55a7b8c5463e12717b2f4","maturity":"draft","page_type":"source","path":"pages/sources/codefox-lab-codefox-cli-wiki-md-7b5f855fb6b5-63e12717b2f4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c4513fc2028d58c281f20900f262d2d0"],"title":"codefox-lab/CodeFox-CLI/WIKI.md @ 7b5f855fb6b5","updated_at":"2026-09-14T03:41:04Z","updated_by_operation":"op_37873c8190ce4e87947e6595e035476f"}
