{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0b941c6f97c66cb7d9beb6a957b1a2ff36f5da1485463d1811a7381500b2ef3a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_62c9e89ea63c21f02550142ad68424753bca9cd99740dd1bd31354e6301375da"],"source_ids":["src_7305b7512bc25bbaa92b5721bc981ef2"],"text":"The installer requires HTTPS for release downloads and verifies the archive against the release origin's SHA-256 inventory; the README notes HTTPS itself is the authenticity boundary since inventory and archive share an origin.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_10f22556452cb5352867155618ce28444e071b1faad62052e54f69164c3d7ce5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_180fcff24662d44bc2b7d61463e1aa4c8ba2206c4f5a4fc0f40595c9abf7d4ba"],"source_ids":["src_790fb802493a5233be0f69b905c98090"],"text":"Repository development practice: daemon protocol changes must be classified as backward-compatible, capability-gated, or incompatible; incompatible changes require bumping DAEMON_PROTOCOL_VERSION and updating schema revision and compatibility tests.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3a103463d5a6d4767b5c300625bdee71a25cc1fd7237eff4073f91752785ac62","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_5e45a710312df5f453955d2a913fd4b62c7aff9f0d8360cdfecaa55de61eedee","slc_82ee781e06eb284f239735c8b27b83af71f496e55a76b57b4d856a59f2657c67"],"source_ids":["src_790fb802493a5233be0f69b905c98090","src_af2c932bea7354d38dd5566e43af546b"],"text":"Repository development practice: changelog entries are added as fragment files under packages/<pkg>/.changes/ rather than editing CHANGELOG.md directly, and PRs touching package src without a fragment fail CI unless labeled no-changelog.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3c33ddd33cb35a484a2cb9490e2faec4c8cf4d0dee9eac6761b193656bed4dd8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_03103c19c8138e6e3fcfb6873dd29190d0479f25d45d40be138066b6fd3fc5f2","slc_e1c22551f3c19c8691aefa727ddb5141df0386a064653779dd6c29ed486cd344","slc_fa8fbd109fdf6eefaeb40c5913f943fac44aca21cc14cacbc73914c3cdcf0744","slc_fbd3dd0712bbef5ff8aa31a5f909cc97bb6cae63ee707b8c716f02dd603e8f28"],"source_ids":["src_af2c932bea7354d38dd5566e43af546b"],"text":"Repository development practice: public contributions start in GitHub Discussions; unsolicited pull requests are not reviewed, and PRs are limited to maintainers and explicitly vouched trusted contributors, with unvouched PRs automatically closed.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4b0d22519987c8435f5ce90f15786149e6ebaf8d09b5b56fbd843ed2eae7da76","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_ce07b7a70fbc5a4311ac936c2b5a2bb17818428c31a45bf25ff2105a9744140e"],"source_ids":["src_7305b7512bc25bbaa92b5721bc981ef2"],"text":"Skills are importable Python packages, and a built-in skill creator can turn recurring workflows into project or personal skills.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5d063fda099910beb7928a5bcaa44ea620041349f2e50eb321101157d5ffc111","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_6190932a3a2c70cd797ff55826db1cf77ec0f191d42c3998d747f950f7b5c7f7"],"source_ids":["src_7305b7512bc25bbaa92b5721bc981ef2"],"text":"The README warns that Prime Agent executes model-generated Python and project commands with the user's permissions; worker and kernel processes improve lifecycle isolation but are not a security sandbox.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_70b43fb7575e858260bd5ffdfb710010c9ddc07fff55009392bf4f487892f316","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_e7cf048d8aed690776616e28cbb344d420b344b6bcc50f59c6e59ff596eb5cc4"],"source_ids":["src_790fb802493a5233be0f69b905c98090"],"text":"Repository development practice: dependency updates are subject to a 7-day minimum release age enforced via .npmrc min-release-age=7 and a matching Dependabot cooldown, with an explicit override flag for urgent security patches.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7f85d34bce0cd37760c01d05c9775f0848bbbaf83ccaf0ef70027028aa512740","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_af4872680e8a7e60c777d2d278e9833b755002dee394387d3a4d3895ccf97272","slc_c953d583ce3d1da0c7a82f4381e73e7d835872c9ae5c318581d55fe299bb99f8"],"source_ids":["src_8365574d48495dac9bc43e6f63abd87d"],"text":"Repository development practice: security vulnerabilities must be reported privately to security@primeintellect.ai, never through public Issues, Discussions, or pull requests.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_87edfd5b81ea0ea137590a463c845eaa3fa78c95cd2c38e6406e34f9baed78e5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_150039d9d4dd5d483b8264117d9ade701f30e3382047468bd93cc2f43efee415","slc_ce07b7a70fbc5a4311ac936c2b5a2bb17818428c31a45bf25ff2105a9744140e"],"source_ids":["src_7305b7512bc25bbaa92b5721bc981ef2"],"text":"rlm.spawn(...) creates real child agents for parallel or background work and returns their results programmatically; running agents can also discover and message each other directly without routing through the user.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a6c11274fc4d88ec8234e80fcb71a122220c0dd8ca6197b8fabcafdaa0ec57a8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_7825d49e6eee92af8efa276fc3f1a48437a0aea31c2c214a0f9911401aa02bf2","slc_b1a739374ba3293d779e6ea890a03814d026b4f392ce8575413a8b553580210f"],"source_ids":["src_790fb802493a5233be0f69b905c98090"],"text":"Repository development practice: parallel agents in one worktree must stage only their own files (never git add -A), and destructive operations like git reset --hard, git clean -fd, and commit --no-verify are forbidden.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b04524e197dab269ff66e0c843216a1797ccd61b8bf14b515393a8dfa89c6410","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_ce07b7a70fbc5a4311ac936c2b5a2bb17818428c31a45bf25ff2105a9744140e"],"source_ids":["src_7305b7512bc25bbaa92b5721bc981ef2"],"text":"A persistent Python REPL is the built-in model tool; file operations, shell commands, tool use, subagents, and context management all happen through code in that environment.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
{"access":"public","created_at":"2026-09-14T02:32:27Z","created_by_operation":"op_177575d15fca43ad8a67b42c36670c89","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b5b07ce0d0748a7343ff6dbb7bd2aa2090b114eca059631e075abcbf3cd6eee0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"primeintellect-ai/prime-agent@1fc1adb6e806 snapshot 500e7d550bac7429","timeframe":null},"slice_ids":["slc_150039d9d4dd5d483b8264117d9ade701f30e3382047468bd93cc2f43efee415","slc_ce07b7a70fbc5a4311ac936c2b5a2bb17818428c31a45bf25ff2105a9744140e"],"source_ids":["src_7305b7512bc25bbaa92b5721bc981ef2"],"text":"The /refine command reviews the current trajectory and can apply small, evidence-backed updates to supplemental harness state (prompts, memories, skill descriptions, subagent specs), never rewriting the immutable base system prompt, with snapshots supporting rollback.","updated_at":"2026-09-14T02:32:27Z","updated_by_operation":"op_177575d15fca43ad8a67b42c36670c89"}
