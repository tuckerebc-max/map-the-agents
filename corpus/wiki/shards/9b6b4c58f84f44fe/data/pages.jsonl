{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_d29a9a19c3f403e6dbdb850a7db353ec9e33bf75158d4c4daffbe28386069613"],"opposing_claim_ids":[],"text":"Ask Replay is documented as a read-only assistant: it can inspect data and navigate the editor but never edits files, publishes, or mutates state; requested mutations are returned to the user as handoff data for review."},{"claim_ids":["clm_f24a361e3953ef8183d1714ac85a48a3dcc82d45033041cce148e0c60a4d081d"],"opposing_claim_ids":[],"text":"Ask Replay exposes bounded read-only server tools such as search_sessions, get_session_summary, get_session_content, get_scene, get_session_annotations, get_session_overlays, and get_insights with time ranges like 7d/30d/90d/all."}],"claim_ids":["clm_d29a9a19c3f403e6dbdb850a7db353ec9e33bf75158d4c4daffbe28386069613","clm_f24a361e3953ef8183d1714ac85a48a3dcc82d45033041cce148e0c60a4d081d"],"created_at":"2026-09-14T04:27:41Z","created_by_operation":"op_cf752dc9528b49f793d18000340fff9b","id":"pg_68635029fbbe58989ed00e274ff3ace4","maturity":"draft","page_type":"source","path":"pages/sources/tuo-lei-vibe-replay-docs-ai-chat-feature-parity-md-1f8645e80775-0e274ff3ace4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_03f1411c3de55579a7c04ce1bd6c34f1"],"title":"tuo-lei/vibe-replay/docs/ai-chat-feature-parity.md @ 1f8645e80775","updated_at":"2026-09-14T04:27:41Z","updated_by_operation":"op_cf752dc9528b49f793d18000340fff9b"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:27:41Z","created_by_operation":"op_cf752dc9528b49f793d18000340fff9b","id":"pg_6ddd0a9c586952cd8794e8dc5d7e719e","maturity":"draft","page_type":"source","path":"pages/sources/tuo-lei-vibe-replay-claude-md-1f8645e80775-e8dc5d7e719e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6114e9b0dd2358a68aff2bc7daa618fa"],"title":"tuo-lei/vibe-replay/CLAUDE.md @ 1f8645e80775","updated_at":"2026-09-14T04:27:41Z","updated_by_operation":"op_cf752dc9528b49f793d18000340fff9b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_392d2a8c9cd576cdbee8b1aa7e2cc36e0db240cd44856d7dc37de487e51ece44"],"opposing_claim_ids":[],"text":"Remote SSH sources are configured in ~/.vibe-replay/config.json with id, label, sshHost, and provider list; the tool reuses existing OpenSSH keys, aliases, and ProxyJump settings and stores no credentials itself."},{"claim_ids":["clm_725c6e2c3ce09f0d7c33efd010f893bfe328b2c5312dd2bf6e5113acfa999bc2"],"opposing_claim_ids":[],"text":"The product is invoked via an npx CLI (e.g. `npx vibe-replay`, `-d` for dashboard, `-p grok-bot`) that auto-discovers sessions and emits a single self-contained HTML replay file."},{"claim_ids":["clm_af1f320f794a3bda267039348f24480a43397405f16dbf6ee97a90c2258e50a6"],"opposing_claim_ids":[],"text":"SSH remote indexing of Grok Bot transcripts is not included yet, per the provider documentation."},{"claim_ids":["clm_b140e9b755925363aefbba99dd95546395b462c30d0f4f5373e7c89bb72ea838"],"opposing_claim_ids":[],"text":"Generated replays are self-contained HTML files that make no automatic external requests; remote HTTP(S) images load only after an explicit per-image click, and data URLs render immediately."},{"claim_ids":["clm_b69b00d3dab62412ca4e1edc7ab43220c15ec2fe25d3bbe5423dce60c630426e"],"opposing_claim_ids":[],"text":"The tool is local-first: it reads session files and generates local HTML without an account, and data leaves the machine only on explicit Gist/cloud publish or login, when aggregated (non-conversation) insights sync daily."},{"claim_ids":["clm_cdfd3d88ed9d6a38d0ba0ab9541fb8dad15ac24c557b5a94cf1559d017cce07e"],"opposing_claim_ids":[],"text":"A portable replay skill ships at skills/replay/SKILL.md for the Agent Skills standard, installable via `npx skills add tuo-lei/vibe-replay --skill replay -g` or by manually downloading the file into ~/.claude/skills/replay."},{"claim_ids":["clm_d29a9a19c3f403e6dbdb850a7db353ec9e33bf75158d4c4daffbe28386069613"],"opposing_claim_ids":[],"text":"Ask Replay is documented as a read-only assistant: it can inspect data and navigate the editor but never edits files, publishes, or mutates state; requested mutations are returned to the user as handoff data for review."},{"claim_ids":["clm_db54421ba4b204701dc539f7fad789fdd4583af7e309a27168086c1cf05d2a8d"],"opposing_claim_ids":[],"text":"Secret redaction is built in: API keys, tokens, PEM keys, and sensitive paths are detected and redacted before replay generation."},{"claim_ids":["clm_f5c7c9e929bd6337be9e877c74d160c1da8310121d2d9dc3d5fbedaf61e276f0"],"opposing_claim_ids":[],"text":"AI provider credentials and OAuth refresh tokens are stored in ~/.vibe-replay/ai-auth.json with restricted permissions, with the path overridable via VIBE_REPLAY_AI_AUTH; credentials stay out of replay files and cloud uploads."}],"claim_ids":["clm_392d2a8c9cd576cdbee8b1aa7e2cc36e0db240cd44856d7dc37de487e51ece44","clm_725c6e2c3ce09f0d7c33efd010f893bfe328b2c5312dd2bf6e5113acfa999bc2","clm_af1f320f794a3bda267039348f24480a43397405f16dbf6ee97a90c2258e50a6","clm_b140e9b755925363aefbba99dd95546395b462c30d0f4f5373e7c89bb72ea838","clm_b69b00d3dab62412ca4e1edc7ab43220c15ec2fe25d3bbe5423dce60c630426e","clm_cdfd3d88ed9d6a38d0ba0ab9541fb8dad15ac24c557b5a94cf1559d017cce07e","clm_d29a9a19c3f403e6dbdb850a7db353ec9e33bf75158d4c4daffbe28386069613","clm_db54421ba4b204701dc539f7fad789fdd4583af7e309a27168086c1cf05d2a8d","clm_f5c7c9e929bd6337be9e877c74d160c1da8310121d2d9dc3d5fbedaf61e276f0"],"created_at":"2026-09-14T04:27:41Z","created_by_operation":"op_cf752dc9528b49f793d18000340fff9b","id":"pg_7380213da6645058b08b6693d4750dfa","maturity":"draft","page_type":"source","path":"pages/sources/tuo-lei-vibe-replay-readme-md-1f8645e80775-6693d4750dfa.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4d26b8aaa2aa5c5ba7ca96d97f05ee05"],"title":"tuo-lei/vibe-replay/README.md @ 1f8645e80775","updated_at":"2026-09-14T04:27:41Z","updated_by_operation":"op_cf752dc9528b49f793d18000340fff9b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_b140e9b755925363aefbba99dd95546395b462c30d0f4f5373e7c89bb72ea838"],"opposing_claim_ids":[],"text":"Generated replays are self-contained HTML files that make no automatic external requests; remote HTTP(S) images load only after an explicit per-image click, and data URLs render immediately."},{"claim_ids":["clm_f6920e88e359fe8570f0f995113b7a5b07dc46e41557bf58e6bc802487af3101"],"opposing_claim_ids":[],"text":"Repository development practice: AGENTS.md is the single source of truth for coding agents (CLAUDE.md is an @AGENTS.md shim), with pnpm-only tooling, oxlint/oxfmt via lefthook pre-commit, `pnpm verify` as the pre-PR gate, and a guard test enforcing the agent-instruction wiring and a 32 KiB AGENTS.md size limit."}],"claim_ids":["clm_b140e9b755925363aefbba99dd95546395b462c30d0f4f5373e7c89bb72ea838","clm_f6920e88e359fe8570f0f995113b7a5b07dc46e41557bf58e6bc802487af3101"],"created_at":"2026-09-14T04:27:41Z","created_by_operation":"op_cf752dc9528b49f793d18000340fff9b","id":"pg_85e69f7d7c67511cb4c0c37344d35cec","maturity":"draft","page_type":"source","path":"pages/sources/tuo-lei-vibe-replay-agents-md-1f8645e80775-c37344d35cec.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6b2e7765935d5d48b906f8a618b8c80f"],"title":"tuo-lei/vibe-replay/AGENTS.md @ 1f8645e80775","updated_at":"2026-09-14T04:27:41Z","updated_by_operation":"op_cf752dc9528b49f793d18000340fff9b"}
