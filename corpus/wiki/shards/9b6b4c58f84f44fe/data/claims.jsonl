{"access":"public","created_at":"2026-09-14T04:27:41Z","created_by_operation":"op_cf752dc9528b49f793d18000340fff9b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b140e9b755925363aefbba99dd95546395b462c30d0f4f5373e7c89bb72ea838","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"tuo-lei/vibe-replay@1f8645e80775 snapshot 76aec0fa0043c673","timeframe":null},"slice_ids":["slc_003e512c025dec8f50020c037d84ea52e6a90dab115c80f63bae0b7d3d3c6af3","slc_40bf80aaf20bf9ef5cca24e0016c401e36465827ef8f8dcfae321caad287d789","slc_cb9652f458ff8cb42e502e203fddc26a28a8c6ac021db9e53f42557d35fafa44"],"source_ids":["src_4d26b8aaa2aa5c5ba7ca96d97f05ee05","src_6b2e7765935d5d48b906f8a618b8c80f"],"text":"Generated replays are self-contained HTML files that make no automatic external requests; remote HTTP(S) images load only after an explicit per-image click, and data URLs render immediately.","updated_at":"2026-09-14T04:27:41Z","updated_by_operation":"op_cf752dc9528b49f793d18000340fff9b"}
{"access":"public","created_at":"2026-09-14T04:27:41Z","created_by_operation":"op_cf752dc9528b49f793d18000340fff9b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b69b00d3dab62412ca4e1edc7ab43220c15ec2fe25d3bbe5423dce60c630426e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"tuo-lei/vibe-replay@1f8645e80775 snapshot 76aec0fa0043c673","timeframe":null},"slice_ids":["slc_003e512c025dec8f50020c037d84ea52e6a90dab115c80f63bae0b7d3d3c6af3","slc_cb9652f458ff8cb42e502e203fddc26a28a8c6ac021db9e53f42557d35fafa44"],"source_ids":["src_4d26b8aaa2aa5c5ba7ca96d97f05ee05"],"text":"The tool is local-first: it reads session files and generates local HTML without an account, and data leaves the machine only on explicit Gist/cloud publish or login, when aggregated (non-conversation) insights sync daily.","updated_at":"2026-09-14T04:27:41Z","updated_by_operation":"op_cf752dc9528b49f793d18000340fff9b"}
{"access":"public","created_at":"2026-09-14T04:27:41Z","created_by_operation":"op_cf752dc9528b49f793d18000340fff9b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cdfd3d88ed9d6a38d0ba0ab9541fb8dad15ac24c557b5a94cf1559d017cce07e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"tuo-lei/vibe-replay@1f8645e80775 snapshot 76aec0fa0043c673","timeframe":null},"slice_ids":["slc_3a799ec88ba9314e78d03970caa444b22676634464972a2f1ab9b11db97dd56f","slc_cd8e6c3321675479c3412759db09fceafcd6a81c72fa84264dff52b0a7a2dbf8","slc_f421cae9258dfb1aba4705397081f44a721e3e7a31def9617bc4ae9a6604ddca"],"source_ids":["src_4d26b8aaa2aa5c5ba7ca96d97f05ee05"],"text":"A portable replay skill ships at skills/replay/SKILL.md for the Agent Skills standard, installable via `npx skills add tuo-lei/vibe-replay --skill replay -g` or by manually downloading the file into ~/.claude/skills/replay.","updated_at":"2026-09-14T04:27:41Z","updated_by_operation":"op_cf752dc9528b49f793d18000340fff9b"}
{"access":"public","created_at":"2026-09-14T04:27:41Z","created_by_operation":"op_cf752dc9528b49f793d18000340fff9b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d29a9a19c3f403e6dbdb850a7db353ec9e33bf75158d4c4daffbe28386069613","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"tuo-lei/vibe-replay@1f8645e80775 snapshot 76aec0fa0043c673","timeframe":null},"slice_ids":["slc_101ff45ec280ca440e858b166b4651a1d309be0661906cfc1ff05f0669a88abb","slc_4fefb9bf54720a0e8fc9e8ab6eaafabe890d4ade33adec5b330234ab62ac99c8","slc_99105c09e9b9b11e9a397292923b9d1b66118c70fa648900ef0a8c980e1d2b83","slc_baccf8d7dbf96cc3d9d53587e2bfabc40f21adde937cd91104ea69c51edc4d93"],"source_ids":["src_03f1411c3de55579a7c04ce1bd6c34f1","src_4d26b8aaa2aa5c5ba7ca96d97f05ee05"],"text":"Ask Replay is documented as a read-only assistant: it can inspect data and navigate the editor but never edits files, publishes, or mutates state; requested mutations are returned to the user as handoff data for review.","updated_at":"2026-09-14T04:27:41Z","updated_by_operation":"op_cf752dc9528b49f793d18000340fff9b"}
{"access":"public","created_at":"2026-09-14T04:27:41Z","created_by_operation":"op_cf752dc9528b49f793d18000340fff9b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_db54421ba4b204701dc539f7fad789fdd4583af7e309a27168086c1cf05d2a8d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"tuo-lei/vibe-replay@1f8645e80775 snapshot 76aec0fa0043c673","timeframe":null},"slice_ids":["slc_003e512c025dec8f50020c037d84ea52e6a90dab115c80f63bae0b7d3d3c6af3","slc_cb9652f458ff8cb42e502e203fddc26a28a8c6ac021db9e53f42557d35fafa44"],"source_ids":["src_4d26b8aaa2aa5c5ba7ca96d97f05ee05"],"text":"Secret redaction is built in: API keys, tokens, PEM keys, and sensitive paths are detected and redacted before replay generation.","updated_at":"2026-09-14T04:27:41Z","updated_by_operation":"op_cf752dc9528b49f793d18000340fff9b"}
