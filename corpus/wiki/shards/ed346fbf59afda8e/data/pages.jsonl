{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_00e0a0dbccfddf0ee5753be68f079ea20649927a11074033e2558446d9ec4b09"],"opposing_claim_ids":[],"text":"Usage is via HuggingFace transformers AutoModelForCausalLM/AutoTokenizer with trust_remote_code=True, bfloat16 dtype, and a chat template applied to system/user messages."},{"claim_ids":["clm_0c125202b6bd872a8a252cf537cb04a9649ffb8a773125c541187c9ccdaeef1a"],"opposing_claim_ids":[],"text":"Users are prohibited from malicious activities that could induce outputs violating LG AI's ethical principles."},{"claim_ids":["clm_39d312300d6de95fbec54df150f9c3a6e6976d1bff70176d1e4eacd379045c53"],"opposing_claim_ids":[],"text":"The 7.8B instruction-tuned model was released 2024.08.07 by LG AI Research, with a technical report at arXiv:2408.03541."},{"claim_ids":["clm_4489d5f861caa38c721cf41a83a1663011e8e9b1ec2d409fa42b1fb4ff730811"],"opposing_claim_ids":[],"text":"README reports benchmark results including MT-Bench 9.01, Arena-Hard-v0.1 46.8, WildBench 48.2, and Korean KoMT-Bench 8.92, compared against similar-size open models."},{"claim_ids":["clm_5a725f1ed180e5705a81a70e97381775ab04d8649a63689a73067e333e913fad"],"opposing_claim_ids":[],"text":"The model was post-trained with supervised fine-tuning followed by direct preference optimization."},{"claim_ids":["clm_5c4bf45611c3c7c0e5226ac74b0f07c06eab37b73fe99d4268f37457df610a72"],"opposing_claim_ids":[],"text":"EXAONE-3.0-7.8B-Instruct is a bilingual English/Korean generative model with 7.8 billion parameters, pre-trained on 8T curated tokens."},{"claim_ids":["clm_5fa1e394c5ee5e1b5ef33528c0723338d68f3065555d87422be0fc5821fe2d9c"],"opposing_claim_ids":[],"text":"The instruction-tuned model was trained to use a system prompt, and the README highly recommends the provided system prompt in code examples."},{"claim_ids":["clm_686fba8590bb5182c2a961f88712a798a7792fa7e70264edf2c37281760c2db2"],"opposing_claim_ids":[],"text":"Documented limitations include possible inappropriate or biased responses, statistically driven errors, and outdated knowledge leading to false or contradictory answers."},{"claim_ids":["clm_a85936701dfac99ea85651f6844d7a5f3b98abaafc26d935ebbeda8ee55f8279"],"opposing_claim_ids":[],"text":"The model is licensed under the EXAONE AI Model License Agreement 1.1 - NC, revised in August 2024."},{"claim_ids":["clm_de22e15e417da20341e0280a3b0d1d3a3044d8830ac850786d4239b41021d7ba"],"opposing_claim_ids":[],"text":"The model requires transformers>=4.41.0, with the latest version recommended."}],"claim_ids":["clm_00e0a0dbccfddf0ee5753be68f079ea20649927a11074033e2558446d9ec4b09","clm_0c125202b6bd872a8a252cf537cb04a9649ffb8a773125c541187c9ccdaeef1a","clm_39d312300d6de95fbec54df150f9c3a6e6976d1bff70176d1e4eacd379045c53","clm_4489d5f861caa38c721cf41a83a1663011e8e9b1ec2d409fa42b1fb4ff730811","clm_5a725f1ed180e5705a81a70e97381775ab04d8649a63689a73067e333e913fad","clm_5c4bf45611c3c7c0e5226ac74b0f07c06eab37b73fe99d4268f37457df610a72","clm_5fa1e394c5ee5e1b5ef33528c0723338d68f3065555d87422be0fc5821fe2d9c","clm_686fba8590bb5182c2a961f88712a798a7792fa7e70264edf2c37281760c2db2","clm_a85936701dfac99ea85651f6844d7a5f3b98abaafc26d935ebbeda8ee55f8279","clm_de22e15e417da20341e0280a3b0d1d3a3044d8830ac850786d4239b41021d7ba"],"created_at":"2026-09-14T04:05:51Z","created_by_operation":"op_ebbfc8e8b45a4526a43d12358f44d94c","id":"pg_4e15951de0385594a5de5354ec1fb35c","maturity":"draft","page_type":"source","path":"pages/sources/lg-ai-exaone-exaone-3-0-readme-md-3edac90ae905-5354ec1fb35c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_97ade492e3d95803b1df01893d47d6e4"],"title":"LG-AI-EXAONE/EXAONE-3.0/README.md @ 3edac90ae905","updated_at":"2026-09-14T04:05:51Z","updated_by_operation":"op_ebbfc8e8b45a4526a43d12358f44d94c"}
