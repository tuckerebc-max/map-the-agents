{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2fdf816320ad063a2e5f8e55f6ce04941d09f52d36528d14229180c80f87d79f"],"opposing_claim_ids":[],"text":"Repository development practice: PRs should be focused (one fix or feature), pass the build, use the PR template, target main, and avoid non-ASCII characters in TS/JS string literals."},{"claim_ids":["clm_347c5aae074284cf8093545186ee780273a2de1ad5dcf43f01a262cadfcaa8a8"],"opposing_claim_ids":[],"text":"Repository development practice: contributors build from source with npm install, npm run watch and watchreact watchers, and launch a dev instance via scripts/code.sh or code.bat; Node 20.18.2 is specified via .nvmrc."},{"claim_ids":["clm_77b3f5647a2ab4bd0aaa53a815091dae89240b4e37ccfafdc325e74c3e92244f"],"opposing_claim_ids":[],"text":"CE-specific code is organized under src/vs/workbench/contrib/ in modules for AI chat (void/), Power Mode, Agent Manager (neuralInverse/), firmware, and modernisation."}],"claim_ids":["clm_2fdf816320ad063a2e5f8e55f6ce04941d09f52d36528d14229180c80f87d79f","clm_347c5aae074284cf8093545186ee780273a2de1ad5dcf43f01a262cadfcaa8a8","clm_77b3f5647a2ab4bd0aaa53a815091dae89240b4e37ccfafdc325e74c3e92244f"],"created_at":"2026-09-14T02:21:25Z","created_by_operation":"op_6093a3234cd243d5b68cca75939ffae0","id":"pg_22156bdb95e75228b9abfad467fcd47c","maturity":"draft","page_type":"source","path":"pages/sources/neuralinverse-neuralinverse-how-to-contribute-md-2d68ded2f2b7-fad467fcd47c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ba33cbb4e4285d3aaf3aadaec351b435"],"title":"NeuralInverse/neuralinverse/HOW_TO_CONTRIBUTE.md @ 2d68ded2f2b7","updated_at":"2026-09-14T02:21:25Z","updated_by_operation":"op_6093a3234cd243d5b68cca75939ffae0"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_60ebe396ad28e37aa93ef174f0bba34f73b811a6640bf67dcb65ec9ffea16e7d"],"opposing_claim_ids":[],"text":"Apply has two modes: Fast Apply prompts the LLM for Search/Replace blocks for quick edits on large files, while Slow Apply rewrites the whole file; edits render as red/green DiffZones."},{"claim_ids":["clm_716a94ee2df9d2cc27e347a3f74868aa61fd6730ad2735e8c8ad8f5e50a48d48"],"opposing_claim_ids":[],"text":"Code changes are written to a text model identified only by the file's URI via voidModelService, without requiring the file to be loaded or saved."},{"claim_ids":["clm_77b3f5647a2ab4bd0aaa53a815091dae89240b4e37ccfafdc325e74c3e92244f"],"opposing_claim_ids":[],"text":"CE-specific code is organized under src/vs/workbench/contrib/ in modules for AI chat (void/), Power Mode, Agent Manager (neuralInverse/), firmware, and modernisation."},{"claim_ids":["clm_b4658a6f8b56d4e4b54e99bb5ba3269473613d12a0c19b50af2133d76c572ac0"],"opposing_claim_ids":[],"text":"LLM messages are sent from the Electron main process, which the guide says avoids CSP issues with local providers and allows use of node_modules."},{"claim_ids":["clm_f5f5e5080557dcf8eaafc9876e1c021ef7fe57bbfe765dec709a531877b301db"],"opposing_claim_ids":[],"text":"voidSettingsService stores all settings including providers, models, and global preferences, and is an implicit dependency of core services; chat modes include normal, gather, and agent."}],"claim_ids":["clm_60ebe396ad28e37aa93ef174f0bba34f73b811a6640bf67dcb65ec9ffea16e7d","clm_716a94ee2df9d2cc27e347a3f74868aa61fd6730ad2735e8c8ad8f5e50a48d48","clm_77b3f5647a2ab4bd0aaa53a815091dae89240b4e37ccfafdc325e74c3e92244f","clm_b4658a6f8b56d4e4b54e99bb5ba3269473613d12a0c19b50af2133d76c572ac0","clm_f5f5e5080557dcf8eaafc9876e1c021ef7fe57bbfe765dec709a531877b301db"],"created_at":"2026-09-14T02:21:25Z","created_by_operation":"op_6093a3234cd243d5b68cca75939ffae0","id":"pg_6b0706b73c0b5c1bba71a87587e12420","maturity":"draft","page_type":"source","path":"pages/sources/neuralinverse-neuralinverse-neuralinverse-codebase-guide-md-2d68ded2f2-a87587e12420.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c471c5a913f858139dd45ad896f316e4"],"title":"NeuralInverse/neuralinverse/NEURALINVERSE_CODEBASE_GUIDE.md @ 2d68ded2f2b7","updated_at":"2026-09-14T02:21:25Z","updated_by_operation":"op_6093a3234cd243d5b68cca75939ffae0"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_01f5e19021dc4290a8fd9a00bbcdeb6d986495a85e991f82c986b34febcd962a"],"opposing_claim_ids":[],"text":"The project is built on Microsoft's VS Code (MIT-licensed); the OSS edition's additions are licensed under Apache 2.0, and the commercial NeuralInverse product adds proprietary features."}],"claim_ids":["clm_01f5e19021dc4290a8fd9a00bbcdeb6d986495a85e991f82c986b34febcd962a"],"created_at":"2026-09-14T02:21:25Z","created_by_operation":"op_6093a3234cd243d5b68cca75939ffae0","id":"pg_7607b2ddaf7b54b9a5da69eb56890a53","maturity":"draft","page_type":"source","path":"pages/sources/neuralinverse-neuralinverse-license-vs-code-txt-2d68ded2f2b7-69eb56890a53.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_06fd4858a456544e9181bb2f1fae5572"],"title":"NeuralInverse/neuralinverse/LICENSE-VS-Code.txt @ 2d68ded2f2b7","updated_at":"2026-09-14T02:21:25Z","updated_by_operation":"op_6093a3234cd243d5b68cca75939ffae0"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_01f5e19021dc4290a8fd9a00bbcdeb6d986495a85e991f82c986b34febcd962a"],"opposing_claim_ids":[],"text":"The project is built on Microsoft's VS Code (MIT-licensed); the OSS edition's additions are licensed under Apache 2.0, and the commercial NeuralInverse product adds proprietary features."},{"claim_ids":["clm_162a7d2e8c1640cc9d5a19a9d0e17a2f389d1ca9d45a6492822e89fe1e567f27"],"opposing_claim_ids":[],"text":"Power Mode (Cmd+Alt+P) is an autonomous coding agent with 22+ tools and concurrent sub-agents; Agent Manager (Cmd+Alt+A) handles model management and orchestration."},{"claim_ids":["clm_1c28f692173bd31c4f2d762a0612d63667ab3464043a61f684d94870b4738fe7"],"opposing_claim_ids":[],"text":"The IDE exposes AI chat and inline edit via Ctrl+L/Ctrl+K keybindings, with sidebar chat, inline diffs, autocomplete, and Fast Apply."},{"claim_ids":["clm_30cbb58265061dd19205a8e14b540c65b087c7c18f7df3300a53ae1fd6313e79"],"opposing_claim_ids":[],"text":"The project targets AI-assisted work on legacy modernization, firmware development, and regulated or safety-critical codebases, positioning itself as an open-source Cursor alternative."},{"claim_ids":["clm_347c5aae074284cf8093545186ee780273a2de1ad5dcf43f01a262cadfcaa8a8"],"opposing_claim_ids":[],"text":"Repository development practice: contributors build from source with npm install, npm run watch and watchreact watchers, and launch a dev instance via scripts/code.sh or code.bat; Node 20.18.2 is specified via .nvmrc."},{"claim_ids":["clm_61b2875ed31f9b14a511b022de11d8303e93564374c3e7bc9b2569c17bb4c3b2"],"opposing_claim_ids":[],"text":"The product supports a bring-your-own-LLM model across 20 providers (cloud, local, gateway) with per-feature model selection, and the README states API keys never leave the user's machine."},{"claim_ids":["clm_70d444e2b608a2b5066b3fa2537f14ef1b22c3079dd0db567d1d503eda9fc66b"],"opposing_claim_ids":[],"text":"Repository development practice: the repo ships a Dev Containers/Codespaces container, with at least 4 cores and 6 GB RAM (8 GB recommended) needed for a full build."},{"claim_ids":["clm_77b3f5647a2ab4bd0aaa53a815091dae89240b4e37ccfafdc325e74c3e92244f"],"opposing_claim_ids":[],"text":"CE-specific code is organized under src/vs/workbench/contrib/ in modules for AI chat (void/), Power Mode, Agent Manager (neuralInverse/), firmware, and modernisation."},{"claim_ids":["clm_f387c6efa74b31f252a990c48b24ad3573d6dbff336cd769c32181106591030c"],"opposing_claim_ids":[],"text":"Specialized modules include Firmware & Embedded (Cmd+Alt+F) with 357 MCU variants, SVD register maps, 22 fw_* tools, and Legacy Modernisation (Cmd+Alt+M) with a 5-stage pipeline and 61 translation profiles."}],"claim_ids":["clm_01f5e19021dc4290a8fd9a00bbcdeb6d986495a85e991f82c986b34febcd962a","clm_162a7d2e8c1640cc9d5a19a9d0e17a2f389d1ca9d45a6492822e89fe1e567f27","clm_1c28f692173bd31c4f2d762a0612d63667ab3464043a61f684d94870b4738fe7","clm_30cbb58265061dd19205a8e14b540c65b087c7c18f7df3300a53ae1fd6313e79","clm_347c5aae074284cf8093545186ee780273a2de1ad5dcf43f01a262cadfcaa8a8","clm_61b2875ed31f9b14a511b022de11d8303e93564374c3e7bc9b2569c17bb4c3b2","clm_70d444e2b608a2b5066b3fa2537f14ef1b22c3079dd0db567d1d503eda9fc66b","clm_77b3f5647a2ab4bd0aaa53a815091dae89240b4e37ccfafdc325e74c3e92244f","clm_f387c6efa74b31f252a990c48b24ad3573d6dbff336cd769c32181106591030c"],"created_at":"2026-09-14T02:21:25Z","created_by_operation":"op_6093a3234cd243d5b68cca75939ffae0","id":"pg_7f0938fcec825ea18410be67b0b6423f","maturity":"draft","page_type":"source","path":"pages/sources/neuralinverse-neuralinverse-readme-md-2d68ded2f2b7-be67b0b6423f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5bc9b497b35257bda2c1f6f25db3a70d"],"title":"NeuralInverse/neuralinverse/README.md @ 2d68ded2f2b7","updated_at":"2026-09-14T02:21:25Z","updated_by_operation":"op_6093a3234cd243d5b68cca75939ffae0"}
