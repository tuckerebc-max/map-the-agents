f65ec93d0","maturity":"draft","page_type":"entity","path":"pages/entities/holasoymalva-deepseek-cli-a33f65ec93d0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"holasoymalva/deepseek-cli","updated_at":"2026-09-14T02:04:22Z","updated_by_operation":"op_734036aed21f4727a48273ff76fcf2b6"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3709556df144f9e03e1d826f757a93068fb82e85577181c9d2b036acdae5969c"],"opposing_claim_ids":[],"text":"It uses DeepSeek Coder models in 1.3B, 6.7B, and 33B sizes, with documented RAM needs of 2GB, 8GB, and 32GB respectively."},{"claim_ids":["clm_dcc7e99694ef5f102d29380e020b52d19d47e78e9a8bfe9411026ef58579466a"],"opposing_claim_ids":[],"text":"A --ollama-host flag lets users point the CLI at a custom Ollama server URL, e.g. a remote host on the LAN."}],"claim_ids":["clm_3709556df144f9e03e1d826f757a93068fb82e85577181c9d2b036acdae5969c","clm_dcc7e99694ef5f102d29380e020b52d19d47e78e9a8bfe9411026ef58579466a"],"created_at":"2026-09-14T02:04:22Z","created_by_operation":"op_734036aed21f4727a48273ff76fcf2b6","id":"pg_717ac54a14825a10bda7b42346786777","maturity":"draft","page_type":"source","path":"pages/sources/holasoymalva-deepseek-cli-local-setup-md-18f5c57f0a53-b42346786777.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_46ee8864871556e594ec265c7d1c2f1a"],"title":"holasoymalva/deepseek-cli/LOCAL-SETUP.md @ 18f5c57f0a53","updated_at":"2026-09-14T02:04:22Z","updated_by_operation":"op_734036aed21f4727a48273ff76fcf2b6"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0b49e44eae0d6f75000740e730fd9bb0c31499e52951f11f4a3172b43ff0a457"],"opposing_claim_ids":[],"text":"Local Ollama mode is the default (DEEPSEEK_USE_LOCAL defaults to true), with cloud API mode available when an API key is configured."},{"claim_ids":["clm_23a99ad150f103d31f45d2502bc2a64c40907e9686cf88b1ec1cb1dad0732cf7"],"opposing_claim_ids":[],"text":"The project is a command-line AI coding assistant for code generation, refactoring, debugging, review, and scaffolding, built on Gemini CLI's foundation and DeepSeek Coder models."},{"claim_ids":["clm_285caf2684ad69c68f08dd3bf292f5e471e5a4e54de134aa96a10d34849672f0"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork and clone, run npm install, npm test, and npm run dev; building from source uses npm run build and npm run package."},{"claim_ids":["clm_3709556df144f9e03e1d826f757a93068fb82e85577181c9d2b036acdae5969c"],"opposing_claim_ids":[],"text":"It uses DeepSeek Coder models in 1.3B, 6.7B, and 33B sizes, with documented RAM needs of 2GB, 8GB, and 32GB respectively."},{"claim_ids":["clm_54dc8ead1474aa04af021fab0527ebd6e3ffd3478aa20820cb261f510bcf471d"],"opposing_claim_ids":[],"text":"The setup command checks for Ollama, starts the service if needed, downloads the specified model, and verifies the installation."},{"claim_ids":["clm_62fcda64728896ed31da080e7c2e724c24c8bf511400a65fc2d66ebc779f6061"],"opposing_claim_ids":[],"text":"The CLI maintains context across interactions in multi-turn conversations and automatically includes relevant project files as context."},{"claim_ids":["clm_8e8c81f1842663578b7239f0dccdf34ef0585f5afd2988aec1a945aa647a96ce"],"opposing_claim_ids":[],"text":"The tool requires Node.js 18 or higher and Ollama for local operation; the npm package is run-deepseek-cli installed globally."},{"claim_ids":["clm_9d59647431191d78e427360bbdb7cbdae2094d0d0f7131fb9b6dd4fc66beddc1"],"opposing_claim_ids":[],"text":"Repository context can be controlled via flags such as --include-all for the whole repo and --include with specific files or directories."},{"claim_ids":["clm_9e3ca3eb82627843c6e15e661055d3f76d90d809f79d54b19c967792f01bc761"],"opposing_claim_ids":[],"text":"The CLI exposes commands including interactive mode (deepseek), single-prompt mode (deepseek chat), setup, --local, --model, --help, and --version."},{"claim_ids":["clm_d9b9c25e69d44e022c6ac93bc017953783a158987342ec87fd19ba537e58b69f"],"opposing_claim_ids":[],"text":"Interactive mode is described as a REPL with syntax highlighting, session history, automatic file-context inclusion, and multi-turn conversations."},{"claim_ids":["clm_ed3777558493ccb1fbf7d1877f1d1fb0383571cad9e1ab4c254a48311be1056c"],"opposing_claim_ids":[],"text":"Documented model context windows are 16K tokens for the 1.3b, 6.7b, and 33b instruct variants, and the 33b model is noted as slower."}],"claim_ids":["clm_0b49e44eae0d6f75000740e730fd9bb0c31499e52951f11f4a3172b43ff0a457","clm_23a99ad150f103d31f45d2502bc2a64c40907e9686cf88b1ec1cb1dad0732cf7","clm_285caf2684ad69c68f08dd3bf292f5e471e5a4e54de134aa96a10d34849672f0","clm_3709556df144f9e03e1d826f757a93068fb82e85577181c9d2b036acdae5969c","clm_54dc8ead1474aa04af021fab0527ebd6e3ffd3478aa20820cb261f510bcf471d","clm_62fcda64728896ed31da080e7c2e724c24c8bf511400a65fc2d66ebc779f6061","clm_8e8c81f1842663578b7239f0dccdf34ef0585f5afd2988aec1a945aa647a96ce","clm_9d59647431191d78e427360bbdb7cbdae2094d0d0f7131fb9b6dd4fc66beddc1","clm_9e3ca3eb82627843c6e15e661055d3f76d90d809f79d54b19c967792f01bc761","clm_d9b9c25e69d44e022c6ac93bc017953783a158987342ec87fd19ba537e58b69f","clm_ed3777558493ccb1fbf7d1877f1d1fb0383571cad9e1ab4c254a48311be1056c"],"created_at":"2026-09-14T02:04:22Z","created_by_operation":"op_734036aed21f4727a48273ff76fcf2b6","id":"pg_8fd096a6cc8a5cca84184444e6ffdf2d","maturity":"draft","page_type":"source","path":"pages/sources/holasoymalva-deepseek-cli-readme-md-18f5c57f0a53-4444e6ffdf2d.md","record_ty