{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2ed87cb117ae99144b71053e3d29e88836c947f4a30d6b653d8d3042ba2ed023"],"opposing_claim_ids":[],"text":"Reusable prompts stored as markdown files with frontmatter under .augment/commands/ become slash commands such as /code-review."},{"claim_ids":["clm_3c2c4447623f72b7be2d09f70bec4eac5a37ea50553995e54235d14286076702"],"opposing_claim_ids":[],"text":"Auggie is described as Augment's agentic coding CLI that runs in a terminal, analyzing code, making safe edits, and automating routine tasks via natural language."},{"claim_ids":["clm_56a8f23a947aba7418594f7fc74e95c7c415ea60f30e203d72a36e159dc97cca"],"opposing_claim_ids":[],"text":"The CLI supports a login command, running with an optional initial prompt, a --print mode that runs once and writes to stdout (suited to CI), and --quiet to return only final output."},{"claim_ids":["clm_59a1db976d28485a16da54a9172dc5f2610d0bf8fb4a5d5a14c5fea51e132728"],"opposing_claim_ids":[],"text":"The package is published as @augmentcode/auggie on npm and requires Node.js 22 or later."}],"claim_ids":["clm_2ed87cb117ae99144b71053e3d29e88836c947f4a30d6b653d8d3042ba2ed023","clm_3c2c4447623f72b7be2d09f70bec4eac5a37ea50553995e54235d14286076702","clm_56a8f23a947aba7418594f7fc74e95c7c415ea60f30e203d72a36e159dc97cca","clm_59a1db976d28485a16da54a9172dc5f2610d0bf8fb4a5d5a14c5fea51e132728"],"created_at":"2026-09-14T01:35:48Z","created_by_operation":"op_f5ff64c15c4e430ea937a97c73c8bec8","id":"pg_0203c21bf06855a595ca2350b1a4017c","maturity":"draft","page_type":"source","path":"pages/sources/augmentcode-auggie-readme-md-9cc3ead419db-2350b1a4017c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8cfe790782db5b91aa33111b29c20c47"],"title":"augmentcode/auggie/README.md @ 9cc3ead419db","updated_at":"2026-09-14T01:35:48Z","updated_by_operation":"op_f5ff64c15c4e430ea937a97c73c8bec8"}
