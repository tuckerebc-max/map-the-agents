{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0347fc06cd25320cbcfff0e1a47b120b65f0d1a7e260f64fb9b4fcf72826693d"],"opposing_claim_ids":[],"text":"The main component is the chat_cli crate, the `q` CLI for interfacing with Amazon Q Developer from the command line; the repo also contains crates, scripts, and docs directories."},{"claim_ids":["clm_2983288e6f8844552e4040f302925ec47a6bce3b5b90f6dbaf1b4984126eee0c"],"opposing_claim_ids":[],"text":"The README states this open-source project is no longer actively maintained and will only receive critical security fixes; Amazon Q Developer CLI continues as the closed-source Kiro CLI."},{"claim_ids":["clm_3e682aabc706c0737272b81f88722d17e5bd166111b55b7246566d6e4cca40fc"],"opposing_claim_ids":[],"text":"Repository development practice: contributors need macOS with Xcode 13+ and Brew, install the Rust toolchain via rustup (stable plus nightly) and typos-cli, then build with cargo run --bin chat_cli, test with cargo test, lint with cargo clippy, and format with cargo +nightly fmt."},{"claim_ids":["clm_7451d006a5619d5533b960dffee79cf6d97616c0c27a6a6636d9e3ebe58f24ab"],"opposing_claim_ids":[],"text":"The project is written in Rust; contributor setup instructions require installing the Rust toolchain via rustup with stable as default plus the nightly toolchain."}],"claim_ids":["clm_0347fc06cd25320cbcfff0e1a47b120b65f0d1a7e260f64fb9b4fcf72826693d","clm_2983288e6f8844552e4040f302925ec47a6bce3b5b90f6dbaf1b4984126eee0c","clm_3e682aabc706c0737272b81f88722d17e5bd166111b55b7246566d6e4cca40fc","clm_7451d006a5619d5533b960dffee79cf6d97616c0c27a6a6636d9e3ebe58f24ab"],"created_at":"2026-09-14T01:59:48Z","created_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286","id":"pg_3026c2c5856750be9cf21d6cd7725b71","maturity":"draft","page_type":"source","path":"pages/sources/aws-amazon-q-developer-cli-readme-md-15cc8f3cd18c-1d6cd7725b71.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5dd42030269053d5a055ea365763dfca"],"title":"aws/amazon-q-developer-cli/README.md @ 15cc8f3cd18c","updated_at":"2026-09-14T01:59:48Z","updated_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9588730130eae209277eb1411013cf5ee0f6c00f94cf86f230e03afe80245f6a"],"opposing_claim_ids":[],"text":"By default fs_read and report_issue are trusted, while execute_bash, fs_write, and use_aws prompt for permission; toolsSettings can pre-allow specific commands, paths, or AWS services, with deny rules evaluated before allow rules."}],"claim_ids":["clm_9588730130eae209277eb1411013cf5ee0f6c00f94cf86f230e03afe80245f6a"],"created_at":"2026-09-14T01:59:48Z","created_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286","id":"pg_406cf6302df159c68e57826332857760","maturity":"draft","page_type":"source","path":"pages/sources/aws-amazon-q-developer-cli-docs-built-in-tools-md-15cc8f3cd18c-826332857760.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0f384a675e3b57c797ff90fbd4a6bb22"],"title":"aws/amazon-q-developer-cli/docs/built-in-tools.md @ 15cc8f3cd18c","updated_at":"2026-09-14T01:59:48Z","updated_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T01:59:48Z","created_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286","id":"pg_433c852bcb835336a9d7043fe357261a","maturity":"draft","page_type":"source","path":"pages/sources/aws-amazon-q-developer-cli-docs-experiments-md-15cc8f3cd18c-043fe357261a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ab681ee5c84a5c92a799ad96fd59777a"],"title":"aws/amazon-q-developer-cli/docs/experiments.md @ 15cc8f3cd18c","updated_at":"2026-09-14T01:59:48Z","updated_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9a049dcd95f0f40120b9ef413d96e2b257fb9044fb65bcf28f5ed458e3edb1ec"],"opposing_claim_ids":[],"text":"Agent files resolve local-first: .amazonq/cli-agents/ in the working directory takes precedence over ~/.aws/amazonq/cli-agents/, with a warning on name conflicts; the global directory is auto-created while the local one must be created manually."}],"claim_ids":["clm_9a049dcd95f0f40120b9ef413d96e2b257fb9044fb65bcf28f5ed458e3edb1ec"],"created_at":"2026-09-14T01:59:48Z","created_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286","id":"pg_544b5106362458cebc6aee30a4a9f4ce","maturity":"draft","page_type":"source","path":"pages/sources/aws-amazon-q-developer-cli-docs-agent-file-locations-md-15cc8f3cd18c-ee30a4a9f4ce.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f79eadb8f0a05fe387430f404c3011a2"],"title":"aws/amazon-q-developer-cli/docs/agent-file-locations.md @ 15cc8f3cd18c","updated_at":"2026-09-14T01:59:48Z","updated_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9f9dbec13c96aa90485a5264c296454d5fe870c6d999f4073489024bb72706d0"],"opposing_claim_ids":[],"text":"Agent selection follows a fallback hierarchy: the --agent flag first, then the chat.defaultAgent setting, then a built-in default agent (all tools, fs_read pre-approved, legacy MCP enabled); a q_cli_default agent file can override the built-in default."}],"claim_ids":["clm_9f9dbec13c96aa90485a5264c296454d5fe870c6d999f4073489024bb72706d0"],"created_at":"2026-09-14T01:59:48Z","created_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286","id":"pg_600af0dd505c55c383de866c9f222a45","maturity":"draft","page_type":"source","path":"pages/sources/aws-amazon-q-developer-cli-docs-default-agent-behavior-md-15cc8f3cd18c-866c9f222a45.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_312307095acc559f848c8a1c96cec2ba"],"title":"aws/amazon-q-developer-cli/docs/default-agent-behavior.md @ 15cc8f3cd18c","updated_at":"2026-09-14T01:59:48Z","updated_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_11c8952ee4dd045db2b1fbf14af4701ddfc82f9c64f2da36143ddb7ad079735a"],"opposing_claim_ids":[],"text":"Each MCP server is configured with a required command plus optional args, env variables, and a per-request timeout in milliseconds defaulting to 120000."},{"claim_ids":["clm_38051fa623c098bb314426402b8dabfb3b1c0c20d449a21a2eb35b7d131dd7b0"],"opposing_claim_ids":[],"text":"Agent configurations are JSON files whose filename (minus .json) becomes the agent name; sections include name, description, prompt, mcpServers, tools, toolAliases, allowedTools, toolsSettings, resources, hooks, useLegacyMcpJson, and model."},{"claim_ids":["clm_b400a4c7ebbb5a9d4ec926f0792c8c0de9874fbd1a0c8c6bb60e5425a4fdd314"],"opposing_claim_ids":[],"text":"The prompt field accepts inline text or file:// URIs; relative paths resolve against the agent config file's directory and absolute paths are used as-is."},{"claim_ids":["clm_e73a9f1cec7ee8e60e3c1afbf841c371d725b5d8b6390a1ca2ef22aba960911b"],"opposing_claim_ids":[],"text":"Hooks run commands at lifecycle trigger points: agentSpawn, userPromptSubmit, preToolUse (which can block tool use), postToolUse, and stop; each hook has a required command and an optional tool-name matcher."}],"claim_ids":["clm_11c8952ee4dd045db2b1fbf14af4701ddfc82f9c64f2da36143ddb7ad079735a","clm_38051fa623c098bb314426402b8dabfb3b1c0c20d449a21a2eb35b7d131dd7b0","clm_b400a4c7ebbb5a9d4ec926f0792c8c0de9874fbd1a0c8c6bb60e5425a4fdd314","clm_e73a9f1cec7ee8e60e3c1afbf841c371d725b5d8b6390a1ca2ef22aba960911b"],"created_at":"2026-09-14T01:59:48Z","created_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286","id":"pg_d27cb5e1b6a05b458b4d5e8fd9fa76dd","maturity":"draft","page_type":"source","path":"pages/sources/aws-amazon-q-developer-cli-docs-agent-format-md-15cc8f3cd18c-5e8fd9fa76dd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5f5191cabf8754eda03cc24c4622618c"],"ti