{"access":"public","created_at":"2026-09-14T01:59:48Z","created_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b400a4c7ebbb5a9d4ec926f0792c8c0de9874fbd1a0c8c6bb60e5425a4fdd314","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"aws/amazon-q-developer-cli@15cc8f3cd18c snapshot 1a8a017dfd018fb0","timeframe":null},"slice_ids":["slc_0402034aeec774f28578d329ec847e8a31c0fca626fcd1befa97b4579837a020","slc_b1c6169d847f16406735e2cd5a2b8951ba627e5aabd42e2a3f0a79ddb9435340"],"source_ids":["src_5f5191cabf8754eda03cc24c4622618c"],"text":"The prompt field accepts inline text or file:// URIs; relative paths resolve against the agent config file's directory and absolute paths are used as-is.","updated_at":"2026-09-14T01:59:48Z","updated_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286"}
{"access":"public","created_at":"2026-09-14T01:59:48Z","created_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e73a9f1cec7ee8e60e3c1afbf841c371d725b5d8b6390a1ca2ef22aba960911b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"aws/amazon-q-developer-cli@15cc8f3cd18c snapshot 1a8a017dfd018fb0","timeframe":null},"slice_ids":["slc_2e6850619e4e55ef898e88899aea9105a79dd7302efbda786e57405a983d73b3","slc_38368596034e3e797dfc268c8893e6694aed35bf4f883ea66cb4f902b90f9b07"],"source_ids":["src_5f5191cabf8754eda03cc24c4622618c"],"text":"Hooks run commands at lifecycle trigger points: agentSpawn, userPromptSubmit, preToolUse (which can block tool use), postToolUse, and stop; each hook has a required command and an optional tool-name matcher.","updated_at":"2026-09-14T01:59:48Z","updated_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286"}
