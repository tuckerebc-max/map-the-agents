{"access":"public","created_at":"2026-09-14T01:59:48Z","created_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_38051fa623c098bb314426402b8dabfb3b1c0c20d449a21a2eb35b7d131dd7b0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"aws/amazon-q-developer-cli@15cc8f3cd18c snapshot 1a8a017dfd018fb0","timeframe":null},"slice_ids":["slc_8999d6f4b1f922d8ee743468f4b2b7c2c731564385ce64d9ac5cf34bf4f5a216","slc_de86eee2d779c6d4b9a8ffa7864e8894da7b30212158fb84da748457d4e397b2"],"source_ids":["src_5f5191cabf8754eda03cc24c4622618c"],"text":"Agent configurations are JSON files whose filename (minus .json) becomes the agent name; sections include name, description, prompt, mcpServers, tools, toolAliases, allowedTools, toolsSettings, resources, hooks, useLegacyMcpJson, and model.","updated_at":"2026-09-14T01:59:48Z","updated_by_operation":"op_408d7b427b5a4dada2eb0a84538ef286"}
