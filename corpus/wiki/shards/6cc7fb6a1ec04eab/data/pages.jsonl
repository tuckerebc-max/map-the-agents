{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3aca079e67dab1ac71213b2df71d0b370a09023ea41155b149fa449f0e410334"],"opposing_claim_ids":[],"text":"The desktop UI uses a restrained neutral OKLCH-token palette with a semantic primary accent, a 4px spacing rhythm, and a sidebar/chat/inspector layout that collapses responsively below 1200px."},{"claim_ids":["clm_87e77132903f85b0b5c6010b6c23a53e29d920560f32c22a62a282a918901dda"],"opposing_claim_ids":[],"text":"The frontend uses shadcn/ui (new-york style, Radix primitives) as its component source system, with product components kept separate from low-level UI primitives."}],"claim_ids":["clm_3aca079e67dab1ac71213b2df71d0b370a09023ea41155b149fa449f0e410334","clm_87e77132903f85b0b5c6010b6c23a53e29d920560f32c22a62a282a918901dda"],"created_at":"2026-09-14T03:07:36Z","created_by_operation":"op_eb7679b0425847648add0411ddf6185d","id":"pg_38ef6fd185ce56c19e61444e3949b74c","maturity":"draft","page_type":"source","path":"pages/sources/exqqstar-exagent-design-md-d9adbbd6f18a-444e3949b74c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_24484d32bd095506bdfee91fa154669f"],"title":"exqqstar/ExAgent/DESIGN.md @ d9adbbd6f18a","updated_at":"2026-09-14T03:07:36Z","updated_by_operation":"op_eb7679b0425847648add0411ddf6185d"}
