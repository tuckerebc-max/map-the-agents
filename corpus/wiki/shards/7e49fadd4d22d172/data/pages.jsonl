{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_b53cc0e6518c4d47f6ba310d2a520907f1b717633cd63127d8bf0137f8844c62"],"opposing_claim_ids":[],"text":"An execution policy labels each command as safe, unsafe, or forbid before it runs; forbid blocks outright, safe runs without prompting, and unsafe defers to the approval mode."}],"claim_ids":["clm_b53cc0e6518c4d47f6ba310d2a520907f1b717633cd63127d8bf0137f8844c62"],"created_at":"2026-09-14T02:27:12Z","created_by_operation":"op_2f1e21cfadf247d3be317b78ea325fec","id":"pg_1673f2670c9b506c94dce46a299251c4","maturity":"draft","page_type":"source","path":"pages/sources/openinterpreter-openinterpreter-docs-execpolicy-md-860153a5318d-e46a299251c4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f060fd0a69db5343841019495146f9cc"],"title":"openinterpreter/openinterpreter/docs/execpolicy.md @ 860153a5318d","updated_at":"2026-09-14T02:27:12Z","updated_by_operation":"op_2f1e21cfadf247d3be317b78ea325fec"}
