f6c0526312c0865105","clm_65bbbb870160779148f4342d46b550acc60a692df498c33445d95a753c70621b","clm_67c0276a0c8ac364e7efe91a790646585c199771f0a3a21db615d237745e1f19","clm_6b47efb18c8ebf2ffa815b4409fe0355f34f377c673f389911c346f4218a119f","clm_6ed6e37bf4f83150533190d86433525a25571b3167868bbfefc909aaa9447ebb","clm_8b795014839e08d1f7e7c0910b3b6b192a7187fd9b178f6b5f814a92f03ca156","clm_95a5fb2e98f1eb12ccf26f0165993e9d7a4a48a72334eef016a89807861cf437","clm_ac45c502b5455375c57935f27315b01541cb76c939e2d175b11d8d1e183e656a","clm_bda2774173097270afa60f1e9297c0182df02be3a4509184d8fc8b4ce8e651da","clm_d7838936fa626d94250d46eafb08c80c9d3441c6a2a469cfb6c0b45600043de6","clm_e7ffc10be066676ba76f6955a7fdaa867a4de34527d6d86821e824b1d74290f4"],"created_at":"2026-09-14T04:10:38Z","created_by_operation":"op_3eecbc4445704752a528cd8eb2eefaa2","id":"pg_7e6c5e288d7e5f2a96b12d10af7c1f2f","maturity":"draft","page_type":"entity","path":"pages/entities/mulkymalikuldhrs-opencode-android-2d10af7c1f2f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"mulkymalikuldhrs/opencode-android","updated_at":"2026-09-14T04:10:38Z","updated_by_operation":"op_3eecbc4445704752a528cd8eb2eefaa2"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_06b73ef2e169bc74cc2449be74467790642436374b82494973419253dfdc50e0"],"opposing_claim_ids":[],"text":"The OpenCodeClient implements 50+ API endpoints spanning sessions, messages, files, providers, commands, LSP, MCP, auth, and TUI control categories."},{"claim_ids":["clm_1a302757549887bb2be1a7e096be004c28f5913dd521427e6f69a6c1e7f9fc5d"],"opposing_claim_ids":[],"text":"The project intentionally keeps dependencies minimal, using OkHttp for HTTP/SSE, AndroidX for UI, Kotlin coroutines and Flow for async work, and org.json for parsing."},{"claim_ids":["clm_2300c952f365aae8c47c31b67948fd703cb149658e6eddc2ab92b536e8813d8d"],"opposing_claim_ids":[],"text":"The app requests INTERNET, ACCESS_NETWORK_STATE, legacy external storage, FOREGROUND_SERVICE, POST_NOTIFICATIONS (SDK 33+), and WAKE_LOCK permissions."},{"claim_ids":["clm_35ffb6c285e1acd8c72a531b01c3bdcec719899648a8e4cc4380abace37f9e51"],"opposing_claim_ids":[],"text":"SessionManager is the central state coordinator tracking current session, session list, SSE event stream, message state, and connection state, exposed via StateFlow/SharedFlow."},{"claim_ids":["clm_39d0b98d3dd9dda9e4f9b0ba2e016407aa721bf8374bf06a1edcb7af3ada43d7"],"opposing_claim_ids":[],"text":"The UI uses Material Design 3 with a dark theme as primary identity, bottom-tab navigation with four sections, and dynamic color support on Android 12+."},{"claim_ids":["clm_65bbbb870160779148f4342d46b550acc60a692df498c33445d95a753c70621b"],"opposing_claim_ids":[],"text":"Main UI components include ConnectionActivity (connection wizard with health check), MainActivity with bottom navigation, and Chat, Terminal, FileManager, and CodeEditor fragments."},{"claim_ids":["clm_6ed6e37bf4f83150533190d86433525a25571b3167868bbfefc909aaa9447ebb"],"opposing_claim_ids":[],"text":"Connection settings (server URL, username, password, auto-connect) are persisted in SharedPreferences, using EncryptedSharedPreferences when available on newer Android versions."},{"claim_ids":["clm_8b795014839e08d1f7e7c0910b3b6b192a7187fd9b178f6b5f814a92f03ca156"],"opposing_claim_ids":[],"text":"The app communicates with the server over HTTP with SSE for real-time streaming, WebSocket for the terminal shell, and TLS (HTTPS/WSS) as the transport security layer."},{"claim_ids":["clm_95a5fb2e98f1eb12ccf26f0165993e9d7a4a48a72334eef016a89807861cf437"],"opposing_claim_ids":[],"text":"The app uses HTTP Basic Authentication included in the Authorization header of every request; cleartext traffic is disabled by default except for localhost in development."},{"claim_ids":["clm_ac45c502b5455375c57935f27315b01541cb76c939e2d175b11d8d1e183e656a"],"opposing_claim_ids":[],"text":"OpenCodeService is a foreground service (dataSync type) that keeps the SSE connection alive in the background and shows a persistent notification."},{"claim_ids":["clm_bda2774173097270afa60f1e9297c0182df02be3a4509184d8fc8b4ce8e651da"],"opposing_claim_ids":[],"text":"The architecture follows a thin client-server model: AI processing, file operations, and command execution happen on the server, while the app handles only UI presentation and interaction."},{"claim_ids":["clm_e7ffc10be066676ba76f6955a7fdaa867a4de34527d6d86821e824b1d74290f4"],"opposing_claim_ids":[],"text":"The app targets Android 7.0 (API 24) minimum and SDK 34, is written in Kotlin, uses package ai.opencode.mobile, and is version 2.0.0 (versionCode 2)."}],"claim_ids":["clm_06b73ef2e169bc74cc2449be74467790642436374b82494973419253dfdc50e0","clm_1a302757549887bb2be1a7e096be004c28f5913dd521427e6f69a6c1e7f9fc5d","clm_2300c952f365aae8c47c31b67948fd703cb149658e6eddc2ab92b536e8813d8d","clm_35ffb6c285e1acd8c72a531b01c3bdcec719899648a8e4cc4380abace37f9e51","clm_39d0b98d3dd9dda9e4f9b0ba2e016407aa721bf8374bf06a1edcb7af3ada43d7","clm_65bbbb870160779148f4342d46b550acc60a692df498c33445d95a753c70621b","clm_6ed6e37bf4f83150533190d86433525a25571b3167868bbfefc909aaa9447ebb","clm_8b795014839e08d1