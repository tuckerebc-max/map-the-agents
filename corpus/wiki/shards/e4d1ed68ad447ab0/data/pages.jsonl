{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9051264088e7623642fe366d273f4b48d52c82d2f6c11562bcb7321963cf978d"],"opposing_claim_ids":[],"text":"Repository development practice: PRs must stay focused on a single concern, oversized 'mega PRs' are rejected, significant features require an issue discussion first, and AI-generated code must disclose the model used in the PR description."},{"claim_ids":["clm_b35d425c9aa09593d3ccb40719ad001753f42b90106d93c6cfbe520273d0e7cb"],"opposing_claim_ids":[],"text":"Repository development practice: contributors use Bun workspaces (cli, shared, hub, web, website, docs, relay) with TypeScript strict typing, and root scripts `bun typecheck` and `bun run test` cover CLI/Web Vitest and Hub/Shared/Relay Bun tests."}],"claim_ids":["clm_9051264088e7623642fe366d273f4b48d52c82d2f6c11562bcb7321963cf978d","clm_b35d425c9aa09593d3ccb40719ad001753f42b90106d93c6cfbe520273d0e7cb"],"created_at":"2026-09-14T03:18:52Z","created_by_operation":"op_cddc5138782d4fe2ad4b3547ad1130f9","id":"pg_b4e4b0d9e6e459ef96e9765154ecfc9b","maturity":"draft","page_type":"source","path":"pages/sources/tiann-hapi-contributing-md-de6c9dee2032-765154ecfc9b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_273562b9fd5d5812ae29decbf85bc267"],"title":"tiann/hapi/CONTRIBUTING.md @ de6c9dee2032","updated_at":"2026-09-14T03:18:52Z","updated_by_operation":"op_cddc5138782d4fe2ad4b3547ad1130f9"}
