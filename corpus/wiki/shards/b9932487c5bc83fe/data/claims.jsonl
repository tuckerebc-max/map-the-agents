{"access":"public","created_at":"2026-09-14T04:29:12Z","created_by_operation":"op_86ea5abc6f9243168ea093ee895997e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5f15ce7e7b9ef3f951eeecaa96d46cdd6337ac19bba5df7aa3044993f49a4b65","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"urigo/graphql-cli@aa709566b74a snapshot a1fae112f055a480","timeframe":null},"slice_ids":["slc_2788402eb4747088131b7354e0fb0f1acd14ecf4a1fe3c184183546a280b87cb","slc_8d8a43c1d36854d425714153e642446cf9e91c14a2597364fdcc617da90bb787","slc_cc4442d03d071755cc2ece2ca20d825d79d94a202d3ea4f3b3c8ee3639638638"],"source_ids":["src_78a5f297319957d4a23a3a6411b76b72","src_bf8290ae18535524bfde9ce592462495"],"text":"The `diff` command compares the configured schema against another schema given on the command line as a URL, Git reference, or local file pointer, e.g. `graphql diff git:origin/master:schema.graphql`.","updated_at":"2026-09-14T04:29:12Z","updated_by_operation":"op_86ea5abc6f9243168ea093ee895997e9"}
{"access":"public","created_at":"2026-09-14T04:29:12Z","created_by_operation":"op_86ea5abc6f9243168ea093ee895997e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_621c23f0fed67734c41c074db6bcb4c673b05de82d83594ffb333eeb39c5ec51","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"urigo/graphql-cli@aa709566b74a snapshot a1fae112f055a480","timeframe":null},"slice_ids":["slc_220e65e7c1ad1540f8c5296e48e9802099e105ac96bdf51788d09d7c9ba94d53","slc_521d9c38676a45009eecc5529dfadc386059f921cac70f18ee4ca9d479f32660","slc_a08e39b3c12e387146efe238c32cd15b15ac0d467e3b0b3de9b45361ab65345a"],"source_ids":["src_78a5f297319957d4a23a3a6411b76b72","src_bf8290ae18535524bfde9ce592462495"],"text":"The CLI is built around GraphQL Config: the config file tells the tools where GraphQL documents and operations live, and the `schema` field accepts URL endpoints, Git URLs, or local file globs and is used by all commands and plugins.","updated_at":"2026-09-14T04:29:12Z","updated_by_operation":"op_86ea5abc6f9243168ea093ee895997e9"}
{"access":"public","created_at":"2026-09-14T04:29:12Z","created_by_operation":"op_86ea5abc6f9243168ea093ee895997e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_85d2e6c5e459a9c4debfe69bc38d8c3634831d5484052752daa242f1f613ee2b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"urigo/graphql-cli@aa709566b74a snapshot a1fae112f055a480","timeframe":null},"slice_ids":["slc_338da72c223a4525f34376004c7f4ad2a89ba99afa79cafa11ef6a69e0193c65","slc_44d7e24173f52f4ef1b4306d1cd73b9a4b4a8f3bb968677a724e17b232cedfbf","slc_5d6a876419149313c509697233710f40878730c3def576f9174ecb96a019c75e","slc_7d5e1f34a481842cf6527fcddc2f3de85aa8ed411e399db70f6edbcd329d68a7"],"source_ids":["src_78a5f297319957d4a23a3a6411b76b72"],"text":"The CLI exposes an `init` command that asks prompt questions and generates a project with a GraphQL Config setup, and can also generate a project from an existing `.graphqlrc.yml` file's instructions.","updated_at":"2026-09-14T04:29:12Z","updated_by_operation":"op_86ea5abc6f9243168ea093ee895997e9"}
{"access":"public","created_at":"2026-09-14T04:29:12Z","created_by_operation":"op_86ea5abc6f9243168ea093ee895997e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_979f780a01d6ddc74c5dbb28b6bef53bc0897f685bdd1211cd6bc80c1e430529","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"urigo/graphql-cli@aa709566b74a snapshot a1fae112f055a480","timeframe":null},"slice_ids":["slc_fba2c0be6498554837e804884654e626e475ea84cff54e1e37891f40196d01b4"],"source_ids":["src_78a5f297319957d4a23a3a6411b76b72"],"text":"Each GraphQL CLI command is a separate npm package installed under the `@graphql-cli/[COMMAND-NAME]` naming scheme, so users can add their own plugins or maintained ones.","updated_at":"2026-09-14T04:29:12Z","updated_by_operation":"op_86ea5abc6f9243168ea093ee895997e9"}
{"access":"public","created_at":"2026-09-14T04:29:12Z","created_by_operation":"op_86ea5abc6f9243168ea093ee895997e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cdae27720466d25922ac09f521107c3a966a1a2363c3147211d1a7549e7548fa","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"urigo/graphql-cli@aa709566b74a snapshot a1fae112f055a480","timeframe":null},"slice_ids":["slc_07935a26ade00b21ff7aa3b5c51b619b92185eacd62a0d65c650456c132d2ce9","slc_8a7bf0424c5217aac42537c152d360ecd871f6d374c2f6e4b49b4b6b06214b88"],"source_ids":["src_8b068587ef5b52348e6bfab27deb01b4"],"text":"The CLI's command management is implemented with Yargs, and plugins/extensions are NodeJS modules written in JavaScript or TypeScript, loaded by name from `node_modules`.","updated_at":"2026-09-14T04:29:12Z","updated_by_operation":"op_86ea5abc6f9243168ea093ee895997e9"}
{"access":"public","created_at":"2026-09-14T04:29:12Z","created_by_operation":"op_86ea5abc6f9243168ea093ee895997e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e290a127ca32f945e7675e72cb8b4ecf24629815ed547f5e623775d81e1398fa","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"urigo/graphql-cli@aa709566b74a snapshot a1fae112f055a480","timeframe":null},"slice_ids":["slc_2aa5e45ea45316f5b5ee151cb45e60bf20052f8fb773ecf773e033772db99a57","slc_91600dfe9f1a2de58b7134b33bd986944ea602ecfeb526fc88d584ba9620d1d8","slc_e511b35780e1cbf60da4d01e822b113b1fa4e70a83d5ec18b59a274582462b90"],"source_ids":["src_35979bc0c7115856a164557fc8209d00"],"text":"The `codegen` command runs GraphQL Code Generator with no positional arguments, supporting options `--config`/`-c`, `--watch`/`-w`, `--require`/`-r`, `--overwrite`/`-o`, `--silent`/`-s`, and `--project`/`-p`.","updated_at":"2026-09-14T04:29:12Z","updated_by_operation":"op_86ea5abc6f9243168ea093ee895997e9"}
