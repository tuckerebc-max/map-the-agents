{"access":"public","created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a0074d620198de57396be460aaa841b5c8891ac4fe8d46cc4f7e05f1bf41f9bd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"yusifeng/formax@1b0c3f32eb20 snapshot d2824f0bf33bfc75","timeframe":null},"slice_ids":["slc_41c86c0f63e61921f3f07835349ee523270d3b06dab9875dcaf3a295d52cf429","slc_d2483cfd5ce42a4ffa7dffb0b1ac3e1836d5f114db0ef017041962b35cbf1c39"],"source_ids":["src_c7490f2f0d6c5b8c8829b91434f558ee"],"text":"The package is published to npm as `@yusifeng/formax` (installed via `npm i -g @yusifeng/formax@beta`) and requires Node.js >= 20 per the README badge.","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
{"access":"public","created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a2b72fe6c9159f1cc7ca9e7411e9c792349829a39505fa5b21ecf28608fed28a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"yusifeng/formax@1b0c3f32eb20 snapshot d2824f0bf33bfc75","timeframe":null},"slice_ids":["slc_d88b9a60f0a8a5311deffbfb86e03f63af9ce4b95d4cbb29b3e8da5af46c95f4","slc_e7ed60b454aeccba9a9ce03c067715b3f75feef15f34ba05d7d3eb7cc438c95b"],"source_ids":["src_38a480eaa5db5229af249c1ae39b4326","src_69eb142128df5bf28646cfb47831aaa0"],"text":"Permissions use a deny/ask/allow rule matcher, a policy engine with preflight enforcement before tool execution, and an approval service with user prompts and remember behavior.","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
{"access":"public","created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cc8cb60de48d7c35b4add6729d9b0720dcea386713ff74bc9e7a412dbef17bb5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"yusifeng/formax@1b0c3f32eb20 snapshot d2824f0bf33bfc75","timeframe":null},"slice_ids":["slc_3b1c6f0841bd7788959d95646ca55305e58335c7de8701bb3ec7c942f296d63b","slc_ab5b980779c9315c63202cdf3ed6f5a56d87c58861ed920a9899c0269d51ff78"],"source_ids":["src_0364f5326eae5be39b1a4cfaf9ed5555","src_69eb142128df5bf28646cfb47831aaa0"],"text":"Session save/replay is supported with writer/reader modules and durable transcript turn snapshots; session saving is enabled by default and can be disabled via `FORMAX_SESSION_SAVE`.","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
{"access":"public","created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d1ae779c5821a002ca883b7805e586d448a0ce5b93da7590669ac9b1898de270","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"yusifeng/formax@1b0c3f32eb20 snapshot d2824f0bf33bfc75","timeframe":null},"slice_ids":["slc_66c6d0eb41a204b240fe000096a8f5cdb25679b0616e07d2bf4f77d35514ac8e","slc_a2fb7f79bfd76da2f07b521a1ece2e9f32bd999f40b2aac7e593dd79dc364c13"],"source_ids":["src_38a480eaa5db5229af249c1ae39b4326","src_c7490f2f0d6c5b8c8829b91434f558ee"],"text":"Repository development practice: the project is built 100% with Codex, keeping `.codex/skills`, `docs/`, and `plans/` as traces of AI-assisted development, and semantic changes follow a contract-first change workflow.","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
{"access":"public","created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d7f55ec8a4496a4ea4b97386c4ea2e623b55cde5467fcddeac95f3fbb40b6e19","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"yusifeng/formax@1b0c3f32eb20 snapshot d2824f0bf33bfc75","timeframe":null},"slice_ids":["slc_690c182721458d9532466ea740d1e70433f37a28399be4225557aa19b57bb5d7","slc_b1cfe805e5af5be2607be3101a141932ddc90818af3abf2fe49126004f16d374","slc_d7743e4612283b8d2e60e19c4fe6b03ea6c380e09333bcdff376aeac9bb6f921"],"source_ids":["src_38a480eaa5db5229af249c1ae39b4326","src_c7490f2f0d6c5b8c8829b91434f558ee"],"text":"`formax app-server` provides a JSON-RPC backend over stdio for GUI/IDE clients, and `formax serve` starts only the WebSocket bridge for advanced debugging or split deployments.","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
{"access":"public","created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ed683449e8d0df4a65abcc2b2db7d895e48f44cc2d280aca5d2a104cd53b22c6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"yusifeng/formax@1b0c3f32eb20 snapshot d2824f0bf33bfc75","timeframe":null},"slice_ids":["slc_a76c0c4f2883fb78bf0658e5857d59326bf983bb35f02d10af389a83b57b46cb"],"source_ids":["src_69eb142128df5bf28646cfb47831aaa0"],"text":"The codebase includes a hooks system (PreToolUse, PermissionRequest, PostToolUse) configured via `.formax/settings.local.json` with scripts under `.formax/hooks/*`, plus audit fields and a debug env flag.","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
{"access":"public","created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_eda160accb8e372065199d6a12c3dd5e94a6018276819f4488040d0f9f712eaf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"yusifeng/formax@1b0c3f32eb20 snapshot d2824f0bf33bfc75","timeframe":null},"slice_ids":["slc_613bff399150a5b83dae90b36ee159f0379e0c6f3f187d08949df26bd4ca62f3","slc_690c182721458d9532466ea740d1e70433f37a28399be4225557aa19b57bb5d7","slc_8f4c54c9cdb633c186c14cb93fb25b4f4dddc0025f4e58236343d23393e1b650"],"source_ids":["src_38a480eaa5db5229af249c1ae39b4326"],"text":"The architecture follows a single shared semantic core (packages/core semantics) consumed by three entry points — TUI, app-server, and Web — with renderers forbidden from forking semantic state.","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
{"access":"public","created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f98e8bbb0a2456f0f2bba89f79051234fa48d58bc0b12048bca499a73e826acb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"yusifeng/formax@1b0c3f32eb20 snapshot d2824f0bf33bfc75","timeframe":null},"slice_ids":["slc_1a17e137d8a0f58c8cd81798fc6e2f9ab63130fcbc08bab208b59b86301a0f38","slc_bf262ae399b49e408eaf561b4decd654459bd5a134b25ca40cf25e825bb296e7"],"source_ids":["src_ed000febfd8c547d80e4390007ecc322"],"text":"Repository development practice: a review-findings log records code-review rounds (e.g. `codex review --uncommitted`) with P1–P3 findings, fixes verified by targeted test runs and type-checks.","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
{"access":"public","created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fdbed5c714abe7de13d4cd1926db43328a0c1cc8c568163fefc94aab7c1c6bc4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"yusifeng/formax@1b0c3f32eb20 snapshot d2824f0bf33bfc75","timeframe":null},"slice_ids":["slc_9c82d7713e12a698c3a02f8bc991c0299106a3c98dc20b9857dbc4a678c79ec6"],"source_ids":["src_38a480eaa5db5229af249c1ae39b4326"],"text":"Architectural invariants include transcript truth from semantics projection, single-writer discipline, replay parity, `replaySeq` as ordering authority, and input lifecycle closure.","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
