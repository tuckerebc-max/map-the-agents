{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3a1f0e62659b41600126be7b4c6929462af4abbb92205d9f0971f3be959e20b4"],"opposing_claim_ids":[],"text":"Documented gaps: hooks support is incomplete, WebFetch/WebSearch have known stability and behavior gaps, MCP is not supported in this version, and the Web UI is minimal."},{"claim_ids":["clm_62d4e197ca0260a7c7725bfc4927cb52562edbf2664c51a77b19df0e809d2cc7"],"opposing_claim_ids":[],"text":"The CLI exposes commands including bare `formax` (REPL in a project directory), `formax setup`, `formax web`, `formax app-server`, and `formax serve`."},{"claim_ids":["clm_78387d22ebf55ebcddfe5bde6533ae6cdf03ffa18bb081894f450f4ab705f7ce"],"opposing_claim_ids":[],"text":"Formax is an open-source implementation of a Claude Code-style AI assistant for software engineering tasks, offering both TUI and GUI workflows."},{"claim_ids":["clm_7d3f3bbb38fb44ca01152792aea227f19d5d381c3b2a4b91aac84bdd0d7fff52"],"opposing_claim_ids":[],"text":"The project is in Beta and is positioned as better suited for learning, experimentation, and architecture study than for stable production daily use."},{"claim_ids":["clm_8531910071aaa72815c09764c3809ff19e50d1d3fd0c3b76400c8b0afa1f4100"],"opposing_claim_ids":[],"text":"Anthropic and OpenAI-compatible providers work in setup/runtime flows, while Gemini appears in config surfaces but is not fully supported in runtime execution yet."},{"claim_ids":["clm_a0074d620198de57396be460aaa841b5c8891ac4fe8d46cc4f7e05f1bf41f9bd"],"opposing_claim_ids":[],"text":"The package is published to npm as `@yusifeng/formax` (installed via `npm i -g @yusifeng/formax@beta`) and requires Node.js >= 20 per the README badge."},{"claim_ids":["clm_d1ae779c5821a002ca883b7805e586d448a0ce5b93da7590669ac9b1898de270"],"opposing_claim_ids":[],"text":"Repository development practice: the project is built 100% with Codex, keeping `.codex/skills`, `docs/`, and `plans/` as traces of AI-assisted development, and semantic changes follow a contract-first change workflow."},{"claim_ids":["clm_d7f55ec8a4496a4ea4b97386c4ea2e623b55cde5467fcddeac95f3fbb40b6e19"],"opposing_claim_ids":[],"text":"`formax app-server` provides a JSON-RPC backend over stdio for GUI/IDE clients, and `formax serve` starts only the WebSocket bridge for advanced debugging or split deployments."}],"claim_ids":["clm_3a1f0e62659b41600126be7b4c6929462af4abbb92205d9f0971f3be959e20b4","clm_62d4e197ca0260a7c7725bfc4927cb52562edbf2664c51a77b19df0e809d2cc7","clm_78387d22ebf55ebcddfe5bde6533ae6cdf03ffa18bb081894f450f4ab705f7ce","clm_7d3f3bbb38fb44ca01152792aea227f19d5d381c3b2a4b91aac84bdd0d7fff52","clm_8531910071aaa72815c09764c3809ff19e50d1d3fd0c3b76400c8b0afa1f4100","clm_a0074d620198de57396be460aaa841b5c8891ac4fe8d46cc4f7e05f1bf41f9bd","clm_d1ae779c5821a002ca883b7805e586d448a0ce5b93da7590669ac9b1898de270","clm_d7f55ec8a4496a4ea4b97386c4ea2e623b55cde5467fcddeac95f3fbb40b6e19"],"created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","id":"pg_2c830f0481a1548f96cc646314909825","maturity":"draft","page_type":"source","path":"pages/sources/yusifeng-formax-readme-md-1b0c3f32eb20-646314909825.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c7490f2f0d6c5b8c8829b91434f558ee"],"title":"yusifeng/formax/README.md @ 1b0c3f32eb20","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_a2b72fe6c9159f1cc7ca9e7411e9c792349829a39505fa5b21ecf28608fed28a"],"opposing_claim_ids":[],"text":"Permissions use a deny/ask/allow rule matcher, a policy engine with preflight enforcement before tool execution, and an approval service with user prompts and remember behavior."},{"claim_ids":["clm_d1ae779c5821a002ca883b7805e586d448a0ce5b93da7590669ac9b1898de270"],"opposing_claim_ids":[],"text":"Repository development practice: the project is built 100% with Codex, keeping `.codex/skills`, `docs/`, and `plans/` as traces of AI-assisted development, and semantic changes follow a contract-first change workflow."},{"claim_ids":["clm_d7f55ec8a4496a4ea4b97386c4ea2e623b55cde5467fcddeac95f3fbb40b6e19"],"opposing_claim_ids":[],"text":"`formax app-server` provides a JSON-RPC backend over stdio for GUI/IDE clients, and `formax serve` starts only the WebSocket bridge for advanced debugging or split deployments."},{"claim_ids":["clm_eda160accb8e372065199d6a12c3dd5e94a6018276819f4488040d0f9f712eaf"],"opposing_claim_ids":[],"text":"The architecture follows a single shared semantic core (packages/core semantics) consumed by three entry points — TUI, app-server, and Web — with renderers forbidden from forking semantic state."},{"claim_ids":["clm_fdbed5c714abe7de13d4cd1926db43328a0c1cc8c568163fefc94aab7c1c6bc4"],"opposing_claim_ids":[],"text":"Architectural invariants include transcript truth from semantics projection, single-writer discipline, replay parity, `replaySeq` as ordering authority, and input lifecycle closure."}],"claim_ids":["clm_a2b72fe6c9159f1cc7ca9e7411e9c792349829a39505fa5b21ecf28608fed28a","clm_d1ae779c5821a002ca883b7805e586d448a0ce5b93da7590669ac9b1898de270","clm_d7f55ec8a4496a4ea4b97386c4ea2e623b55cde5467fcddeac95f3fbb40b6e19","clm_eda160accb8e372065199d6a12c3dd5e94a6018276819f4488040d0f9f712eaf","clm_fdbed5c714abe7de13d4cd1926db43328a0c1cc8c568163fefc94aab7c1c6bc4"],"created_at":"2026-09-14T03:26:09Z","created_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2","id":"pg_2f5d1884e760577f9f37434a6cda0824","maturity":"draft","page_type":"source","path":"pages/sources/yusifeng-formax-architecture-md-1b0c3f32eb20-434a6cda0824.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_38a480eaa5db5229af249c1ae39b4326"],"title":"yusifeng/formax/ARCHITECTURE.md @ 1b0c3f32eb20","updated_at":"2026-09-14T03:26:09Z","updated_by_operation":"op_7e5899804b244d2ebfd863e7bd58cea2"}
