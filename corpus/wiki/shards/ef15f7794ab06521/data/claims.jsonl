{"access":"public","created_at":"2026-09-14T02:08:07Z","created_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b42af8a303167c3a5c0f2f1c56e09a13eff3d6772b68d25a5034f09ea1bd90a8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"juggler-ai/juggler@9446fd2936f0 snapshot c554519a9ceb4f47","timeframe":null},"slice_ids":["slc_4c7e5505f4c6e673ff5dd2258ffbfd82be2abf4e8cde44802474f219b95e4192","slc_52d0c58d8ed85d3f112833f8d9212da57d6fb2410f2bae0ba3d1218efc3707ca","slc_a15761709106cc403419fde762bb3222908f3376b8e6eff0ef4e77c314d15005"],"source_ids":["src_38d8162ff33b59dab96bb9f120ae4bf5","src_abef64ca721a5951a69503b7b7f626e6"],"text":"Repository development practice: every commit must carry a DCO `Signed-off-by:` line, and corporate or employer-owned contributions require executing the CCLA/CLA privately, not in public PRs.","updated_at":"2026-09-14T02:08:07Z","updated_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d"}
{"access":"public","created_at":"2026-09-14T02:08:07Z","created_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b95af7fbd951d9cb749761dd37c79fcf41fa575ee8f043a2a2374d17ea8a3a29","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"juggler-ai/juggler@9446fd2936f0 snapshot c554519a9ceb4f47","timeframe":null},"slice_ids":["slc_733e253c1deea901b6133af0d1f7d6fbae6d74db05f129eb32c6fb2b67610fed","slc_76b019af407236c1a271c2240fcf1d3571ef3b0341e9ec15a3ae29e37e8d9736"],"source_ids":["src_e4bc001edfa45da0ad29d33db1702160"],"text":"Context is editable: history can be folded into a thread, items moved or copied between branches, branches expanded back, and structural changes undone.","updated_at":"2026-09-14T02:08:07Z","updated_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d"}
{"access":"public","created_at":"2026-09-14T02:08:07Z","created_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ba26792d73d995f3e64a47691a543e8f9a86d4db83fae08709cb4abd6e8c470e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"juggler-ai/juggler@9446fd2936f0 snapshot c554519a9ceb4f47","timeframe":null},"slice_ids":["slc_2957754a9c85c9b4442c73baec6cea081479d8272f0a6d9b31b560d9a026274e"],"source_ids":["src_e4bc001edfa45da0ad29d33db1702160"],"text":"Juggler measures the full request before each model call, leaves room for the answer, and automatically compacts old history when a conversation exceeds the model's context window.","updated_at":"2026-09-14T02:08:07Z","updated_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d"}
{"access":"public","created_at":"2026-09-14T02:08:07Z","created_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bea295b58cbfeeae6da9caa7019e08f10173df9624d2be16b4808ad101e94c60","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"juggler-ai/juggler@9446fd2936f0 snapshot c554519a9ceb4f47","timeframe":null},"slice_ids":["slc_9ae650dc357c676cacbe5e85b8984f5d2e3290543518ec3bf4a768596719cf92"],"source_ids":["src_e4bc001edfa45da0ad29d33db1702160"],"text":"Repository builds support local and LAN access only; WAN/internet reachability modes are included solely in official binaries from juggler.studio, per the licensing boundary.","updated_at":"2026-09-14T02:08:07Z","updated_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d"}
{"access":"public","created_at":"2026-09-14T02:08:07Z","created_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cb97ecc66031d2a203d8cd67b96f9576654bb4cbc1948ec7ca0b74cf2b287be8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"juggler-ai/juggler@9446fd2936f0 snapshot c554519a9ceb4f47","timeframe":null},"slice_ids":["slc_190d5296cead52ea44b9e5c1972d54b2217fcf7e33153a00960c305cfe0fe455","slc_552a56ef873b1102c66b59d3c32537511a611f7bba09abe9f6c46f52293c242c","slc_6f9bbb9e8ce454177c131f81237e7606d5e78fc11d617606f80372b7cb0f322e","slc_cfd0f3716fd42836cf6e19939acf735f046c9f0d344629eee210dd91373ab9f4"],"source_ids":["src_e4bc001edfa45da0ad29d33db1702160"],"text":"Repository development practice: builds require Go 1.26+ with vendored submodules; `make go-build` compiles, `make test` runs tests (race detector on by default), and `make test-full` with linting is expected before a PR.","updated_at":"2026-09-14T02:08:07Z","updated_by_operation":"op_f1656c6181c748f7a2e7ef4ac46a639d"}
