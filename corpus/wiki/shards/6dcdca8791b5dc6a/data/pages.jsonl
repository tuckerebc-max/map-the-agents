{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1272a5154c94de24c28edaa07fccd41d1dcdb0ec32db30a12ac5bb10f2c32726"],"opposing_claim_ids":[],"text":"The project is built in Rust, which the README cites for performance and portability."},{"claim_ids":["clm_65c502908ece83f62016ad90af3aaf8f19a08de6ed3a62e7d7802efebe77b8ab"],"opposing_claim_ids":[],"text":"The README states goose works with 15+ LLM providers (Anthropic, OpenAI, Google, Ollama, OpenRouter, Azure, Bedrock, and more) and connects to 70+ extensions via the Model Context Protocol."},{"claim_ids":["clm_8a4145ef059b19ee79bc1c92cba481d8b6bb6239009d12ab07e59ae746e2d13d"],"opposing_claim_ids":[],"text":"goose ships as a native desktop app for macOS, Linux, and Windows, a full CLI, and an API for embedding it elsewhere."},{"claim_ids":["clm_d42dd68b7e82dc402a9e019bf601d1d1dedd3afe2874cd8889545d6903ea5d2a"],"opposing_claim_ids":[],"text":"goose is a general-purpose AI agent that runs locally, intended not just for code but also research, writing, automation, and data analysis; it is part of the Agentic AI Foundation at the Linux Foundation and Apache-2.0 licensed."}],"claim_ids":["clm_1272a5154c94de24c28edaa07fccd41d1dcdb0ec32db30a12ac5bb10f2c32726","clm_65c502908ece83f62016ad90af3aaf8f19a08de6ed3a62e7d7802efebe77b8ab","clm_8a4145ef059b19ee79bc1c92cba481d8b6bb6239009d12ab07e59ae746e2d13d","clm_d42dd68b7e82dc402a9e019bf601d1d1dedd3afe2874cd8889545d6903ea5d2a"],"created_at":"2026-09-14T01:28:50Z","created_by_operation":"op_41c4a6db2f244f9282fb201c3440857c","id":"pg_6201cc8cc02459438d5aad40d16ef62b","maturity":"draft","page_type":"source","path":"pages/sources/aaif-goose-goose-readme-md-50666ae0b9a5-ad40d16ef62b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_262fba8f3da458d18ba0d74d0ab68bd5"],"title":"aaif-goose/goose/README.md @ 50666ae0b9a5","updated_at":"2026-09-14T01:28:50Z","updated_by_operation":"op_41c4a6db2f244f9282fb201c3440857c"}
