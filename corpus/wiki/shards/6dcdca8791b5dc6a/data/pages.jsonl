8","clm_4eaff013ceb7098aa8ce1901e121ba4af682b7fbedc9ef142f3ed788185ea054","clm_55667549ff19c7a0476eb1387484a9f91aa9273427d87e6ac1bf61fef7ade92b","clm_5b839e6628490757b93b6a2352615f2e97932532f3ce9dd0286566deeb78ebd1","clm_5f82b335d9ae867b65a424b52e048569e3e278dfd7a60edd0785cfd823ad4ed2","clm_65c502908ece83f62016ad90af3aaf8f19a08de6ed3a62e7d7802efebe77b8ab","clm_6aca70ea501e8838794eca00c3323edfba8a0c58e4ec1e89fd5137932db5eaa9","clm_8a4145ef059b19ee79bc1c92cba481d8b6bb6239009d12ab07e59ae746e2d13d","clm_8cae85cc8fc38cb9f8343095f8344e7624137f84ebe9177b48f35eed61162cb8","clm_90a58d313ca8dbf01d77aefe432f3a49763619610c7fa359392d60ef7295e5a3","clm_a1c47154b93baa5cc2a617ab589cd5938ceafbb4fd59216e03d5dcc312c749e4","clm_a89211a7d43fa48df74a4fe55671a463eca887a2b9bbe563c8949f09fbf518e3","clm_bc74ff3d8dfffbca044e8f01b6b2c3b9122f513aa9de23291ef74d2289830c7b","clm_d42dd68b7e82dc402a9e019bf601d1d1dedd3afe2874cd8889545d6903ea5d2a","clm_d92175391619bafe7f38c4633892ad507f2b7ff19e9319c54169ad9419cad65b","clm_dbddcc38b05e8a4bfafc9d6d60a0c60d47b6799e4246a7cc512151f50251663f","clm_eae365bc1e2cc59600e948b8b4b2b2e3c80ecde0f81b14017aa760033b516687"],"created_at":"2026-09-14T01:28:50Z","created_by_operation":"op_41c4a6db2f244f9282fb201c3440857c","id":"pg_7ea60b71cf3c551f9d8ca2eaf7471576","maturity":"draft","page_type":"entity","path":"pages/entities/aaif-goose-goose-a2eaf7471576.md","record_type":"page","review_state":"unverified","schema_version":"1.0","source_ids":[],"title":"aaif-goose/goose","updated_at":"2026-09-14T04:51:09Z","updated_by_operation":"op_98aac828ce044e049048a5d8b1ca8dcd"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_44a2fcf77239b74a2f11e3ded86372429bb38a3d8196604332da2f10bdba3608"],"opposing_claim_ids":[],"text":"Configuration precedence is documented as environment variables, then config.yaml, then defaults."},{"claim_ids":["clm_4eaff013ceb7098aa8ce1901e121ba4af682b7fbedc9ef142f3ed788185ea054"],"opposing_claim_ids":[],"text":"Custom clients can integrate over ACP using 'goose serve', an HTTP/WebSocket server started with a GOOSE_SERVER__SECRET_KEY environment variable."},{"claim_ids":["clm_55667549ff19c7a0476eb1387484a9f91aa9273427d87e6ac1bf61fef7ade92b"],"opposing_claim_ids":[],"text":"Telemetry via PostHog is optional and can be disabled by setting GOOSE_DISABLE_TELEMETRY=1, or redirected to a custom PostHog instance by modifying posthog.rs."},{"claim_ids":["clm_5b839e6628490757b93b6a2352615f2e97932532f3ce9dd0286566deeb78ebd1"],"opposing_claim_ids":[],"text":"Secrets are stored via a SecretStorage mechanism that uses the system keyring by default with a file-based fallback available, and configuration lives at ~/.config/goose/config.yaml."},{"claim_ids":["clm_90a58d313ca8dbf01d77aefe432f3a49763619610c7fa359392d60ef7295e5a3"],"opposing_claim_ids":[],"text":"Recipes are YAML-based task definitions that can bundle extensions and, with sub-recipes and subagents, express multi-step workflows; an example recipe declares extensions with stdio type, command, and args."},{"claim_ids":["clm_d92175391619bafe7f38c4633892ad507f2b7ff19e9319c54169ad9419cad65b"],"opposing_claim_ids":[],"text":"The architecture diagram shows user interfaces (CLI, Electron desktop, custom UIs) above a 'goose serve' ACP HTTP/WebSocket server, above a core goose crate containing providers, MCP extensions, and config/recipes."}],"claim_ids":["clm_44a2fcf77239b74a2f11e3ded86372429bb38a3d8196604332da2f10bdba3608","clm_4eaff013ceb7098aa8ce1901e121ba4af682b7fbedc9ef142f3ed788185ea054","clm_55667549ff19c7a0476eb1387484a9f91aa9273427d87e6ac1bf61fef7ade92b","clm_5b839e6628490757b93b6a2352615f2e97932532f3ce9dd0286566deeb78ebd1","clm_90a58d313ca8dbf01d77aefe432f3a49763619610c7fa359392d60ef7295e5a3","clm_d92175391619bafe7f38c4633892ad507f2b7ff19e9319c54169ad9419cad65b"],"created_at":"2026-09-14T01:28:50Z","created_by_operation":"op_41c4a6db2f244f9282fb201c3440857c","id":"pg_a4aec5cdea2a54c98d7134076856ac07","maturity":"draft","page_type":"source","path":"pages/sources/aaif-goose-goose-custom-distros-md-50666ae0b9a5-34076856ac07.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_beba001ea77254e881b5df000113c564"],"title":"aaif-goose/goose/CUSTOM_DISTROS.md @ 50666ae0b9a5","updated_at":"2026-09-14T01:28:50Z","updated_by_operation":"op_41c4a6db2f244f9282fb201c3440857c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5f82b335d9ae867b65a424b52e048569e3e278dfd7a60edd0785cfd823ad4ed2"],"opposing_claim_ids":[],"text":"Repository development practice: building the Linux desktop app requires Rust, Node.js 22.9.0+, pnpm 10+, and 'just'; the CLI is built with 'cargo build --release -p goose-cli --bin goose' and packaged via Electron Forge (ZIP recommended, plus DEB and Flatpak)."},{"claim_ids":["clm_a1c47154b93baa5cc2a617ab589cd5938ceafbb4fd59216e03d5dcc312c749e4"],"opposing_claim_ids":[],"text":"The musl/portable Linux build disables local-inference (V8) and system-keyring (D-Bus SecretService) because neither is available on Android, and Snap packaging is not currently supported."},{"claim_ids":["clm_dbddcc38b05e8a4bfafc9d6d60a0c60d47b6799e4246a7cc512151f50251663f"],"opposing_claim_ids":[],"text":"Repository development practice: BUILDING_LINUX.md asks contributors to Linux build changes to test on multiple distributions, update documentation, and consider CI/CD implications."},{"claim_ids":["clm_eae365bc1e2cc59600e948b8b4b2b2e3c80ecde0f81b14017aa760033b516687"],"opposing_claim_ids":[],"text":"BUILDING_LINUX.md gives separate package commands for Debian/Ubuntu, Fedora, openSUSE, and Arch/Manjaro. The Debian command includes protobuf-compiler and libxcb1-dev; Fedora includes libxcb-devel. Its Arch command uses shaderc, while Debian, Fedora, and openSUSE list glslc."}],"claim_ids":["clm_5f82b335d9ae867b65a424b52e048569e3e278dfd7a60edd0785cfd823ad4ed2","clm_a1c47154b93baa5cc2a617ab589cd5938ceafbb4fd59216e03d5dcc312c749e4","clm_dbddcc38b05e8a4bfafc9d6d60a0c60d47b6799e4246a7cc512151f50251663f","clm_eae365bc1e2cc59600e948b8b4b2b2e3c80ecde0f81b14017aa760033b516687"],"created_at":"2026-09-14T01:28:50Z","created_by_operation":"op_41c4a6db2f244f9282fb201c3440857c","id":"pg_c39238db851e5b36a3af8e7957a61cbc","maturity":"draft","page_type":"source","path":"pages/sources/aaif-goose-goose-building-linux-md-50666ae0b9a5-8e7957a61cbc.md"