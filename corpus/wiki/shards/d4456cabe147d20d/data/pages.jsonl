c4b2ccfcda41"],"created_at":"2026-09-14T01:52:24Z","created_by_operation":"op_8d9aa50edaf2438fa27b6d3a04d385d8","id":"pg_0927f183cbbf5eaca53f4d095e9ba556","maturity":"draft","page_type":"entity","path":"pages/entities/goldmar-openclaw-code-agent-4d095e9ba556.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"goldmar/openclaw-code-agent","updated_at":"2026-09-14T01:52:24Z","updated_by_operation":"op_8d9aa50edaf2438fa27b6d3a04d385d8"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1a572e56a112ad70cbab6e87a17eb229b4c9c7c44937361e63adc28f6c9d57af"],"opposing_claim_ids":[],"text":"src/session-manager.ts is the control plane: it enforces maxSessions, spawns and tracks sessions, resolves resume/fork requests, persists runtime metadata and output, and composes notification, interaction, and worktree-controller services."},{"claim_ids":["clm_ef1082d228791e2d303f5560357f30046ec54340b1de0b9314bbd27c9349f21d"],"opposing_claim_ids":[],"text":"Sessions support suspend, resume, fork, interrupt, and recovery across restarts with persisted metadata and output; persisted records stay resumable even after runtime sessions are garbage-collected at sessionGcAgeMinutes."},{"claim_ids":["clm_ff1926c3b87746d10ff10c1cf06282f20fe1d54516e43f1c33c4c4b2ccfcda41"],"opposing_claim_ids":[],"text":"The OpenCode harness is explicitly experimental: it runs a per-session local 'opencode serve' process, uses classic session lifecycle routes because v2 session wait is unavailable, and does not forward the reasoning-effort option."}],"claim_ids":["clm_1a572e56a112ad70cbab6e87a17eb229b4c9c7c44937361e63adc28f6c9d57af","clm_ef1082d228791e2d303f5560357f30046ec54340b1de0b9314bbd27c9349f21d","clm_ff1926c3b87746d10ff10c1cf06282f20fe1d54516e43f1c33c4c4b2ccfcda41"],"created_at":"2026-09-14T01:52:24Z","created_by_operation":"op_8d9aa50edaf2438fa27b6d3a04d385d8","id":"pg_347ce6fec518566f9d9c45f0fa9cd88b","maturity":"draft","page_type":"source","path":"pages/sources/goldmar-openclaw-code-agent-docs-architecture-md-fbb2e275ddd8-45f0fa9cd88b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1ed538f7580f55b49b89b929e8082046"],"title":"goldmar/openclaw-code-agent/docs/ARCHITECTURE.md @ fbb2e275ddd8","updated_at":"2026-09-14T01:52:24Z","updated_by_operation":"op_8d9aa50edaf2438fa27b6d3a04d385d8"}
