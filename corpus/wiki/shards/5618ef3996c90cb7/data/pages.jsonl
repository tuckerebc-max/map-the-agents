{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_09ada320ed13dd01fc2804f81599c947be57293b75ae911202cf134863e3cd45"],"opposing_claim_ids":[],"text":"Trajectory recording captures LLM interactions, agent steps, tool usage, and metadata into JSON files, saved continuously during execution with auto-generated or custom filenames."},{"claim_ids":["clm_f44b4c51de4deb55a9aac3e6e970147178370bc2f6cb47411d791cd4edff3fae"],"opposing_claim_ids":[],"text":"Trae Agent supports multiple LLM providers (OpenAI, Anthropic, Doubao, Azure, OpenRouter, Ollama, Google Gemini), and the trajectory docs reference a dedicated client module for each of these providers."}],"claim_ids":["clm_09ada320ed13dd01fc2804f81599c947be57293b75ae911202cf134863e3cd45","clm_f44b4c51de4deb55a9aac3e6e970147178370bc2f6cb47411d791cd4edff3fae"],"created_at":"2026-09-14T02:00:03Z","created_by_operation":"op_5d9497675bfd4c23b797b56d504b31b5","id":"pg_2f7e58da01b7552bbbc8e5713ec061f7","maturity":"draft","page_type":"source","path":"pages/sources/bytedance-trae-agent-docs-trajectory-recording-md-e839e559ac61-e5713ec061f7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f30859f3472a5740bf4cea98a0e38839"],"title":"bytedance/trae-agent/docs/TRAJECTORY_RECORDING.md @ e839e559ac61","updated_at":"2026-09-14T02:00:03Z","updated_by_operation":"op_5d9497675bfd4c23b797b56d504b31b5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1a589295bf7fb3a60afe98d632eedd5d7bdec54d280c3b7d08888a9d15ff4ca0"],"opposing_claim_ids":[],"text":"The str_replace_based_edit_tool requires absolute paths and exact unique string matches, and its create operation fails if the file already exists."},{"claim_ids":["clm_2df7bf3c3ed690c509643939fa767b95b0a0924c496b60bb0429e0a062edb71a"],"opposing_claim_ids":[],"text":"The bash tool runs commands in a persistent shared session with a 120-second per-command timeout, session restart, and background process support."}],"claim_ids":["clm_1a589295bf7fb3a60afe98d632eedd5d7bdec54d280c3b7d08888a9d15ff4ca0","clm_2df7bf3c3ed690c509643939fa767b95b0a0924c496b60bb0429e0a062edb71a"],"created_at":"2026-09-14T02:00:03Z","created_by_operation":"op_5d9497675bfd4c23b797b56d504b31b5","id":"pg_80d371809da657b89f27af8c59824b22","maturity":"draft","page_type":"source","path":"pages/sources/bytedance-trae-agent-docs-tools-md-e839e559ac61-af8c59824b22.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_946acaecb5a15922b5d8323b5ca4ec37"],"title":"bytedance/trae-agent/docs/tools.md @ e839e559ac61","updated_at":"2026-09-14T02:00:03Z","updated_by_operation":"op_5d9497675bfd4c23b797b56d504b31b5"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:00:03Z","created_by_operation":"op_5d9497675bfd4c23b797b56d504b31b5","id":"pg_d528a336ff1153c8b2735d619a397681","maturity":"draft","page_type":"source","path":"pages/sources/bytedance-trae-agent-contributing-md-e839e559ac61-5d619a397681.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_492ceb36726e55d68a1140d2770cb1d2"],"title":"bytedance/trae-agent/CONTRIBUTING.md @ e839e559ac61","updated_at":"2026-09-14T02:00:03Z","updated_by_operation":"op_5d9497675bfd4c23b797b56d504b31b5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_09ada320ed13dd01fc2804f81599c947be57293b75ae911202cf134863e3cd45"],"opposing_claim_ids":[],"text":"Trajectory recording captures LLM interactions, agent steps, tool usage, and metadata into JSON files, saved continuously during execution with auto-generated or custom filenames."},{"claim_ids":["clm_315cd9521dd2c6c9451354643db30468aeceae472210d97cc83e7f8aed617aaf"],"opposing_claim_ids":[],"text":"The example YAML config enables Lakeview step summarization, sets max_steps (e.g. 200), and selects tools such as bash, str_replace_based_edit_tool, sequentialthinking, and task_done."},{"claim_ids":["clm_4c1c0ed4bfeb22f77eba3e07d6269683a6455300477ad669d76b989484861497"],"opposing_claim_ids":[],"text":"The project positions itself as a research-friendly, modular agent platform aimed at studying agent architectures, ablation studies, and novel agent capabilities."},{"claim_ids":["clm_5f4ea45a578e90e98c1c9e8b44a9e9618eacb5e3f31fe248a94104c48be1b214"],"opposing_claim_ids":[],"text":"The project requires Python 3.12+ and UV, and setup uses 'uv sync --all-extras' with a virtualenv; an API key for the chosen provider is also needed."},{"claim_ids":["clm_7e215360a0f8501095e3442584814ada2d5210f20dbb44f5f834fc596642c8f0"],"opposing_claim_ids":[],"text":"Configuration is YAML-based (JSON is deprecated legacy), with priority order: command-line arguments > config file > environment variables > defaults; base_url overrides are supported."},{"claim_ids":["clm_86c140ba7873adb0ac6a36f922803eb3960d54f520556769c4adabc65631bf25"],"opposing_claim_ids":[],"text":"Tasks can execute inside Docker: via an image, an existing container ID, a Dockerfile path, or a local tar image file, with an option to keep or remove the container afterward; Docker must be configured in the environment."},{"claim_ids":["clm_8d9ff2c67a48ee2a2c3b4a821249a2bbb6eed4ff32372fa96ea5ca31a47cdf1a"],"opposing_claim_ids":[],"text":"CLI options include --provider/--model, --working-dir, --trajectory-file, --must-patch, and --max-steps for interactive mode."},{"claim_ids":["clm_d7eb1a524c542c93c47858311d242af219b64d3e5a806b9a2bdc230205ce3b66"],"opposing_claim_ids":[],"text":"Optional MCP services can be enabled via an mcp_servers config section, e.g. launching a Playwright MCP server through npx."},{"claim_ids":["clm_df4d90838ec52f5314868ac18a482200b4650e3375b05a8e16c542d70154cb11"],"opposing_claim_ids":[],"text":"Repository development practice: the repo runs pre-commit and unit-test GitHub Actions workflows, and contributors are directed to CONTRIBUTING.md and docs/roadmap.md."},{"claim_ids":["clm_eb247ec09709d329a23be035d2983ddc4b67b035123a2f218d23dde3d5ee2cea"],"opposing_claim_ids":[],"text":"Interactive mode supports typed task descriptions plus commands: status, help, clear, and exit/quit."},{"claim_ids":["clm_f39b61fedd65ad044dc0b7bf6aefdd90db70bb13d1c9a703fceb6ce178b59368"],"opposing_claim_ids":[],"text":"Trae Agent provides a CLI (trae-cli) that accepts natural-language task instructions and runs software engineering workflows, with 'run' and 'interactive' subcommands."},{"claim_ids":["clm_f44b4c51de4deb55a9aac3e6e970147178370bc2f6cb47411d791cd4edff3fae"],"opposing_claim_ids":[],"text":"Trae Agent supports multiple LLM providers (OpenAI, Anthropic, Doubao, Azure, OpenRouter, Ollama, Google Gemini), and the trajectory docs reference a dedicated client module for each of these providers."}],"claim_ids":["clm_09ada320ed13dd01fc2804f81599c947be57293b75ae911202cf134863e3cd45","clm_315cd9521dd2c6c9451354643db30468aeceae472210d97cc83e7f8aed617aaf","clm_4c1c0ed4bfeb22f77eba3e07d6269683a6455300477ad669d76b989484861497","clm_5f4ea45a578e90e98c1c9e8b44a9e9618eacb5e3f31fe248a94104c48be1b214","clm_7e215360a0f8501095e3442584814ada2d5210f20dbb44f5f834fc596642c8f0","clm_86c140ba7873adb0ac6a36f922803eb3960d54f520556769c4adabc65631bf25","clm_8d9ff2c67a48ee2a2c3b4a821249a2bbb6eed4ff32372fa96ea5ca31a47cdf1a","clm_d7eb1a524c542c93c47858311d242af219b64d3e5a806b9a2bdc230205ce3b66","clm_df4d90838ec52f5314868ac18a482200b4650e3375b05a8e16c542d70154cb11","clm_eb247ec09709d329a23be035d2983ddc4b67b035123a2f218d23dde3d5ee2cea","clm_f39b61fedd65ad044dc0b7bf6aefdd90db70bb13d1c9a703fceb6ce178b59368","clm_f44b4c51de4deb55a9aac3e6e970147178370bc2f6cb47411d791cd4edff3fae"],"created_at":"2026-09-14T02:00:03Z","created_by_operation":"op_5d9497675bfd4c23b797b56d504b31b5","id":"pg_d8531a16f164529cb2f9a10926914631","maturity":"draft","page_type":"source","path":"pages/sources/bytedance-trae-agent-readme-md-e839e559ac61-a10926914631.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2dd451d5cc685cebbc75003c27380295"],"title":"bytedance/trae-agent/README.md @ e839e559ac61","updated_at":"2026-09-14T02:00:03Z","updated_by_operation":"op_5d9497675bfd4c23b797b56d504b31b5"}
