{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3641f3cf82fd06c8c5cc98baf68301fa5d5120f81bcf8fe568ce2b33baf40493"],"opposing_claim_ids":[],"text":"Documented features include an interactive AI coding assistant, file and directory operations, file editing/appending, codebase context understanding, configurable settings, and colored terminal output."},{"claim_ids":["clm_74df6fa03e032902a0bb4c9de112f066438ad89eafb000f6bf8fa1a6c5e92fc9"],"opposing_claim_ids":[],"text":"The project is described as under active development and in its early stages, with the README noting that LLM Code is being used to build itself."},{"claim_ids":["clm_76a78a3251cdf79c41901dee4b4f6741bee78f916b0e44e62652264dc97d64d6"],"opposing_claim_ids":[],"text":"The product exposes slash commands including /help, /exit, /pwd, /ls, /tree, /cat, /write, /append, /cd, /mkdir, /config, and /context (or /#) for workspace context."},{"claim_ids":["clm_86d13e2c7e6a575eb8bcb3f153f2d6cb6bb832fd73188cb0410c82808c435df9"],"opposing_claim_ids":[],"text":"The tool defaults to the OpenAI API endpoint (https://api.openai.com/v1) as its base URL, with the model configurable by the user."},{"claim_ids":["clm_a8a2368e3b2adfd73e1b78b1afd840dbc4491b3651eb145f23a5272345c2d821"],"opposing_claim_ids":[],"text":"Recommended usage pattern: provide context first via /context, /#, or /tree before requesting code modifications, using /context <file> for specific files."},{"claim_ids":["clm_ad7d3dffc9f4263e49a5c3065f43be363f5df69e488fdc24525201377be9e6bf"],"opposing_claim_ids":[],"text":"The application is started by running 'python main.py', and the API key is set interactively via '/config set apiKey YOUR_API_KEY'."},{"claim_ids":["clm_e95cf9ad594156f7f6d26da90288504c504ef13c6b0961a8d645f55486f329dd"],"opposing_claim_ids":[],"text":"LLM Code is a terminal-based agentic coding tool that understands the codebase and accepts natural-language commands, inspired by Claude Code but open-source and customizable."},{"claim_ids":["clm_f9332f098c9d9c456f5c48e4a91d2a47cf2467ba866bd51adc7380af9bc0a71a"],"opposing_claim_ids":[],"text":"Configuration is persisted in a JSON file at ~/.llm_code_config.json with keys apiKey, baseUrl (default https://api.openai.com/v1), model, and debug."}],"claim_ids":["clm_3641f3cf82fd06c8c5cc98baf68301fa5d5120f81bcf8fe568ce2b33baf40493","clm_74df6fa03e032902a0bb4c9de112f066438ad89eafb000f6bf8fa1a6c5e92fc9","clm_76a78a3251cdf79c41901dee4b4f6741bee78f916b0e44e62652264dc97d64d6","clm_86d13e2c7e6a575eb8bcb3f153f2d6cb6bb832fd73188cb0410c82808c435df9","clm_a8a2368e3b2adfd73e1b78b1afd840dbc4491b3651eb145f23a5272345c2d821","clm_ad7d3dffc9f4263e49a5c3065f43be363f5df69e488fdc24525201377be9e6bf","clm_e95cf9ad594156f7f6d26da90288504c504ef13c6b0961a8d645f55486f329dd","clm_f9332f098c9d9c456f5c48e4a91d2a47cf2467ba866bd51adc7380af9bc0a71a"],"created_at":"2026-09-14T03:17:47Z","created_by_operation":"op_4d740ce0217346bd94bc75922cca787d","id":"pg_e4de9b640c2a53a788ee4462bab7f41e","maturity":"draft","page_type":"source","path":"pages/sources/syscalldev-llmcode-readme-md-81eda39f03db-4462bab7f41e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_056bc751b3bc5d788437b142fb9daf61"],"title":"syscalldev/LLMCode/README.md @ 81eda39f03db","updated_at":"2026-09-14T03:17:47Z","updated_by_operation":"op_4d740ce0217346bd94bc75922cca787d"}
