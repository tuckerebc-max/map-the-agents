{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9271ae6cd91a98ffb73c4b60cafeec033cdc6413914839cf1a1869f1210356dd"],"opposing_claim_ids":[],"text":"Repository development practice: contributors must run ./gradlew detekt test :cli:build for fast verification and ./gradlew build before final commits, and must never use raw println in the CLI layer—only serialized JSON via kotlinx.serialization."},{"claim_ids":["clm_99542f5b662d255ad217bcd9c6cf245fcd7179b5accf9d3b9aa7efd5258e1e98"],"opposing_claim_ids":[],"text":"Repository development practice: CLI JSON response models are guarded by golden schema tests in JsonSchemaGoldenTest; contributors update schemas with ./gradlew test -DupdateGoldenSchemas=true and must keep SKILL.md, README command reference, and CHANGELOG.md in sync with any command or output change."}],"claim_ids":["clm_9271ae6cd91a98ffb73c4b60cafeec033cdc6413914839cf1a1869f1210356dd","clm_99542f5b662d255ad217bcd9c6cf245fcd7179b5accf9d3b9aa7efd5258e1e98"],"created_at":"2026-09-14T04:15:05Z","created_by_operation":"op_45e1a35b2c434ef6bdf7aad6bc3cd4d0","id":"pg_1632586236285c24ae361196cd68887f","maturity":"draft","page_type":"source","path":"pages/sources/patilshreyas-debroid-contributing-md-90139a0c1ab5-1196cd68887f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6426cfc9c9f35f0b8c4c06672371ac9a"],"title":"PatilShreyas/debroid/CONTRIBUTING.md @ 90139a0c1ab5","updated_at":"2026-09-14T04:15:05Z","updated_by_operation":"op_45e1a35b2c434ef6bdf7aad6bc3cd4d0"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_156b4340fb2c227cf29b9282859dd38d5d47228a26ea6ffc925cbbac29893b9d"],"opposing_claim_ids":[],"text":"The daemon listens on localhost (127.0.0.1) without authentication for fast CLI communication, and the README warns it exposes live JVM manipulation and should only run on fully trusted machines."},{"claim_ids":["clm_19cdc0975ad04bf45b0f2a5d56a5680636788e4ea301aa036d6619b2a4d95d3d"],"opposing_claim_ids":[],"text":"Debroid is a headless CLI speaking the Java Debug Wire Protocol (JDWP) so AI agents can debug live Android apps via machine-parseable JSON without a GUI."},{"claim_ids":["clm_478ff84156000bcac64e29f8bb9cbd1e51dce4ea4fc4361bc70799b83dbcd7f9"],"opposing_claim_ids":[],"text":"CLI commands forward requests to a background daemon that auto-starts on first command, holds a long-lived JDWP socket via ADB port forwarding, and returns strict JSON on stdout."},{"claim_ids":["clm_750def0d7eee7e9b09a4a97abeef2f2436d351a9d363b8099045acfa4aa2ee49"],"opposing_claim_ids":[],"text":"Features include recursive deep object inspection with cycle-guards, live variable mutation via set-var, expression evaluation in the target VM, and extraction of shallow locals from Kotlin Continuation frames."},{"claim_ids":["clm_a9ccbf50058029674d93079001b417d066b2a66acff1c18e605c7f2244095e9c"],"opposing_claim_ids":[],"text":"The CLI auto-extracts AI skill instructions to ~/.debroid/skills/debroid-cli/SKILL.md on first run, and the README documents symlink setup for agents like Claude Code, Cursor, Codex, and OpenCode."},{"claim_ids":["clm_ae844949d4760acabc8446dea9a2ebbfe3ba00ad105fe17e54f523adfda2f927"],"opposing_claim_ids":[],"text":"Prerequisites are Java JDK 11+ with JAVA_HOME set, plus Android SDK and adb on the PATH."},{"claim_ids":["clm_fb8e9a8f8b13e6fb5f0122c22ca2b7d7f1cdc8d6665cd7d1b3c6eafff37237e1"],"opposing_claim_ids":[],"text":"Commands include daemon, stop, launch, attach, detach, break, remove-break, catch-exception, and others, with global options like --port/DEBROID_PORT, --version, --help, --pretty, and --schema."}],"claim_ids":["clm_156b4340fb2c227cf29b9282859dd38d5d47228a26ea6ffc925cbbac29893b9d","clm_19cdc0975ad04bf45b0f2a5d56a5680636788e4ea301aa036d6619b2a4d95d3d","clm_478ff84156000bcac64e29f8bb9cbd1e51dce4ea4fc4361bc70799b83dbcd7f9","clm_750def0d7eee7e9b09a4a97abeef2f2436d351a9d363b8099045acfa4aa2ee49","clm_a9ccbf50058029674d93079001b417d066b2a66acff1c18e605c7f2244095e9c","clm_ae844949d4760acabc8446dea9a2ebbfe3ba00ad105fe17e54f523adfda2f927","clm_fb8e9a8f8b13e6fb5f0122c22ca2b7d7f1cdc8d6665cd7d1b3c6eafff37237e1"],"created_at":"2026-09-14T04:15:05Z","created_by_operation":"op_45e1a35b2c434ef6bdf7aad6bc3cd4d0","id":"pg_2bbf0543cad15a1bbf30ae70be7ecd40","maturity":"draft","page_type":"source","path":"pages/sources/patilshreyas-debroid-readme-md-90139a0c1ab5-ae70be7ecd40.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_bac38073475d5caba93a0c36a4e699fb"],"title":"PatilShreyas/debroid/README.md @ 90139a0c1ab5","updated_at":"2026-09-14T04:15:05Z","updated_by_operation":"op_45e1a35b2c434ef6bdf7aad6bc3cd4d0"}
