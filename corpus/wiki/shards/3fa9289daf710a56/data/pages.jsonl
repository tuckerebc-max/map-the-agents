{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4bfee066c64a4b4e972506915a446bb831af56b8f2b1ff50d0676011568ec1e3"],"opposing_claim_ids":[],"text":"The in-memory event buffer was increased to 10,000 events, and poll output includes droppedEventsSinceLastPoll to signal unnotified event loss under high volume."},{"claim_ids":["clm_5d3c9cb689405016814fcce7f9d94382c350e36570d0ca03bbbcf872ae255fc6"],"opposing_claim_ids":[],"text":"JSON serialization omits null fields (explicitNulls = false) to shrink payloads and save context tokens for AI agents."}],"claim_ids":["clm_4bfee066c64a4b4e972506915a446bb831af56b8f2b1ff50d0676011568ec1e3","clm_5d3c9cb689405016814fcce7f9d94382c350e36570d0ca03bbbcf872ae255fc6"],"created_at":"2026-09-14T04:15:05Z","created_by_operation":"op_45e1a35b2c434ef6bdf7aad6bc3cd4d0","id":"pg_f2913be05866511295d33388d8cdb0ee","maturity":"draft","page_type":"source","path":"pages/sources/patilshreyas-debroid-changelog-md-90139a0c1ab5-3388d8cdb0ee.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_11fb91b4ebbd535689d9a5d9970ed66a"],"title":"PatilShreyas/debroid/CHANGELOG.md @ 90139a0c1ab5","updated_at":"2026-09-14T04:15:05Z","updated_by_operation":"op_45e1a35b2c434ef6bdf7aad6bc3cd4d0"}
