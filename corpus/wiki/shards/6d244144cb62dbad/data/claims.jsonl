{"access":"public","created_at":"2026-09-14T02:41:13Z","created_by_operation":"op_ffef4597677543c9998c39ed8a4f269a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_be389fa9c74b794bfb6e7ce9493e5d4d0d4179324b58927ff6dcad4edbff1aeb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"smythos/sre@5c382a1ec07a snapshot de590e843dd1e761","timeframe":null},"slice_ids":["slc_220cddde3ee6ced97217f86354b15afa3a0fd7f6e3b8a1cd3dab2506c1e8a399","slc_ae15393adaf6e7e45dedfe6cdd1252718456373c84a3f8186014a14d3547f567","slc_c71b1d7aaa9e9c135f4f89dffe377c08efff6f48f1c6301b48be62f789e3d4cf","slc_e77f2dee77b9b5d9801749e9b50cf31986d0e363779f0f3acd4f6afcd73fb8a3"],"source_ids":["src_1d1060d0f50055639eb096c6c30c5e28"],"text":"SRE is implicitly initialized with default connectors (RAM cache, local storage, console log) when the SDK is used, and can be explicitly re-initialized with built-in or custom connectors for production setups.","updated_at":"2026-09-14T02:41:13Z","updated_by_operation":"op_ffef4597677543c9998c39ed8a4f269a"}
