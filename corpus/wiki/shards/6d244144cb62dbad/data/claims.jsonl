{"access":"public","created_at":"2026-09-14T02:41:13Z","created_by_operation":"op_ffef4597677543c9998c39ed8a4f269a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_df7d65bc8dedda12804ed92477e82444a70f2be2ec779cef45ec8f7873b937d8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"smythos/sre@5c382a1ec07a snapshot de590e843dd1e761","timeframe":null},"slice_ids":["slc_5f00b6b04ac58f4ac06d08514d12c26ebc64dc1636355261c30ce8d9608d5892","slc_773deb28b1f4c73d6f0444df75a10a786fb78fb2f9a8ae19b687e3a455b48c21","slc_a218afe5bac98b2cf5cb34351c9ba79c5d22582d9caea19c99a586c2bd9bc73e"],"source_ids":["src_1d1060d0f50055639eb096c6c30c5e28"],"text":"SRE provides a unified abstraction layer so all providers of a given resource type (storage, VectorDB, cache, LLM) expose the same API, letting providers be swapped without changing business logic.","updated_at":"2026-09-14T02:41:13Z","updated_by_operation":"op_ffef4597677543c9998c39ed8a4f269a"}
