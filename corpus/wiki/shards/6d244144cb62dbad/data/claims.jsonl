{"access":"public","created_at":"2026-09-14T02:41:13Z","created_by_operation":"op_ffef4597677543c9998c39ed8a4f269a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_96ec5e1d914a0dba3b89a09aecc1647b96b21822254bc27e289fa8ad83de9ce6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"smythos/sre@5c382a1ec07a snapshot de590e843dd1e761","timeframe":null},"slice_ids":["slc_130527bf435fcd64334220c6c62da6f160797e386bcf7e47df8e1a306ad885fa","slc_3b7b2bd68a6944b1be22ceba571796bdb3e2b5070b2e484702ec7b138022eca2","slc_a49de72a29c62bb1a14f7006a2ea108ed7fd2e990605b70db50cabea87e2af1d","slc_b6ec891581e22801075f38074b64d5d4419b08d264b164e1b8f3c292405e4e42"],"source_ids":["src_1d1060d0f50055639eb096c6c30c5e28"],"text":"The repo is a monorepo with three packages: the SRE core runtime (packages/core), the SDK (packages/sdk), and a CLI (packages/cli) for scaffolding and project management.","updated_at":"2026-09-14T02:41:13Z","updated_by_operation":"op_ffef4597677543c9998c39ed8a4f269a"}
