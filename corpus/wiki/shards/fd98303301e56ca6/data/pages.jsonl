{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0e64851e42b7e152ae742a8caeeb9a96d20b26febc82801004a7795aa2f31c6e"],"opposing_claim_ids":[],"text":"Documented use cases target platform-engineering teams: k8s/Argo deployments and troubleshooting, FinOps cloud-cost reporting, SecOps vulnerability checks, SRE outage troubleshooting, and DevOps cluster upgrades."},{"claim_ids":["clm_1fefc086b206a3fd1cd7890e856a1eb1f5fd38dce413d7f5822a4585ca64bb21"],"opposing_claim_ids":[],"text":"GeniA is built on OpenAI's function-calling capability (OpenAI or Azure) and requires an OpenAI API key to run."},{"claim_ids":["clm_516ae2f346bbba598d3b77550c48365730fa40880d5e142ffa80166c16197f4c"],"opposing_claim_ids":[],"text":"Repository development practice: local setup requires copying .env.template to .env with OPENAI_API_KEY as the minimal secret, and the repo displays a CI workflow badge."},{"claim_ids":["clm_6d752c104e78ff18d1ee57e82d104bac0e7bc2e109f7fefef4cddb16d30b73ff"],"opposing_claim_ids":[],"text":"The roadmap lists capabilities not yet present: OKTA SSO integration, RBAC support, and extension with thousands of new tools are future plans."},{"claim_ids":["clm_a4b48ffe496d036d367a1448088dbc70aef76308b5b9e29099ee3e946f201ae9"],"opposing_claim_ids":[],"text":"The product can run in three modes: a local terminal mode, a Slack app bot mode, and a Streamlit web app mode, per the developer guide and README."},{"claim_ids":["clm_cf971297c59910ae04981a6640df33ecea79e77260013296795cd0e867fbdfdb"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork the repo and submit pull requests, run tests with 'poetry run pytest tests', and can build/run the project via Docker or Poetry commands documented in the developer guide."},{"claim_ids":["clm_ec6b6b950f91f55283257136855766529f9cd264873a0e6ac041a2059fb129c9"],"opposing_claim_ids":[],"text":"The project positions the agent as a production-grade team member operating inside a team's Slack channel and executing tasks in the production environment on users' behalf."}],"claim_ids":["clm_0e64851e42b7e152ae742a8caeeb9a96d20b26febc82801004a7795aa2f31c6e","clm_1fefc086b206a3fd1cd7890e856a1eb1f5fd38dce413d7f5822a4585ca64bb21","clm_516ae2f346bbba598d3b77550c48365730fa40880d5e142ffa80166c16197f4c","clm_6d752c104e78ff18d1ee57e82d104bac0e7bc2e109f7fefef4cddb16d30b73ff","clm_a4b48ffe496d036d367a1448088dbc70aef76308b5b9e29099ee3e946f201ae9","clm_cf971297c59910ae04981a6640df33ecea79e77260013296795cd0e867fbdfdb","clm_ec6b6b950f91f55283257136855766529f9cd264873a0e6ac041a2059fb129c9"],"created_at":"2026-09-14T02:01:11Z","created_by_operation":"op_517819a847174522a89ad92e47fed6a1","id":"pg_12444557887553b6b7b0b3fd9eb10810","maturity":"draft","page_type":"source","path":"pages/sources/genia-dev-genia-readme-md-39a206b85d84-b3fd9eb10810.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d6fa616f11f15a6bb98274712eb51371"],"title":"genia-dev/GeniA/README.md @ 39a206b85d84","updated_at":"2026-09-14T02:01:11Z","updated_by_operation":"op_517819a847174522a89ad92e47fed6a1"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_09ebb0b675199ec4db496ec19c24e02b213ddf038ccd52313c2df0c0953102f5"],"opposing_claim_ids":[],"text":"An experimental feature lets the agent learn new skills from natural language by storing accomplished task steps in long-term memory, categorizing them as a skill, and reloading them for future use."},{"claim_ids":["clm_11d97d31b18f60a9732beb06b05921fd121caf1fac55c40d384de6d0e90b59f5"],"opposing_claim_ids":[],"text":"Tool specs support Python code tools (naming a class and method), URL tools performing GET requests via templated URLs, and OpenAPI Swagger-based integrations, the latter noted as still under development."},{"claim_ids":["clm_460cb09ad9855a9dc0e1addaa7ad98f73d459ba693df51e9496cd738ea5e4c1f"],"opposing_claim_ids":[],"text":"New tools are added via YAML specs following OpenAI JSON function-configuration standards, with usage guidance kept in a separate tools.yaml file."}],"claim_ids":["clm_09ebb0b675199ec4db496ec19c24e02b213ddf038ccd52313c2df0c0953102f5","clm_11d97d31b18f60a9732beb06b05921fd121caf1fac55c40d384de6d0e90b59f5","clm_460cb09ad9855a9dc0e1addaa7ad98f73d459ba693df51e9496cd738ea5e4c1f"],"created_at":"2026-09-14T02:01:11Z","created_by_operation":"op_517819a847174522a89ad92e47fed6a1","id":"pg_21385ba6638b5e17a1379a5f9eb17782","maturity":"draft","page_type":"source","path":"pages/sources/genia-dev-genia-docs-add-new-tool-md-39a206b85d84-9a5f9eb17782.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c2d443c3dc33500387f5df6f8063d5e0"],"title":"genia-dev/GeniA/docs/add-new-tool.md @ 39a206b85d84","updated_at":"2026-09-14T02:01:11Z","updated_by_operation":"op_517819a847174522a89ad92e47fed6a1"}
