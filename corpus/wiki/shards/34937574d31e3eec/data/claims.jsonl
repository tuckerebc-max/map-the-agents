{"access":"public","created_at":"2026-09-14T02:31:09Z","created_by_operation":"op_a5c9b1a4fdd54c2a8ddc30641f47a109","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_38a6d9c7056885d8526445cbb1fb0b6aafbaa10f2cc8c884805403277a8bbfeb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"phodal/routa@e48861ab81e2 snapshot 53e7bdcd26858588","timeframe":null},"slice_ids":["slc_3bd5fc3389dbddd6eb093bcd7b1526cb4f757555a836a6f84293068e4df9db20","slc_aae640d1eecaaf4cb33abb023b31d78871ff2e4099df65e4595ef6dd3ad3accf"],"source_ids":["src_780a01174d315d5284553833bdc171eb"],"text":"The implementation is intentionally dual-backend: a Next.js web app in src/, a Tauri desktop shell backed by an Axum server in crates/routa-server, sharing semantics defined by api-contract.yaml.","updated_at":"2026-09-14T02:31:09Z","updated_by_operation":"op_a5c9b1a4fdd54c2a8ddc30641f47a109"}
