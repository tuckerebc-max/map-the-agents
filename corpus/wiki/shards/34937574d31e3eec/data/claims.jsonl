{"access":"public","created_at":"2026-09-14T02:31:09Z","created_by_operation":"op_a5c9b1a4fdd54c2a8ddc30641f47a109","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5ee473c51bfe5e67818cdde7ebbe30a87126f3433c6b2d4e37c533a57556b84c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"phodal/routa@e48861ab81e2 snapshot 53e7bdcd26858588","timeframe":null},"slice_ids":["slc_128199ab89a11b4a4b97269838b24dc62e042f84d5cf5a804f204886c0c17ae6","slc_c901173ba58d61e218fab5cca892f49626b7ca5805ddcc7f075e8181af233a80"],"source_ids":["src_780a01174d315d5284553833bdc171eb"],"text":"Routa is described as a workspace-first multi-agent coordination platform for software delivery, keeping goals, tasks, sessions, traces, evidence, and review state visible on a board rather than in one chat thread.","updated_at":"2026-09-14T02:31:09Z","updated_by_operation":"op_a5c9b1a4fdd54c2a8ddc30641f47a109"}
{"access":"public","created_at":"2026-09-14T02:31:09Z","created_by_operation":"op_a5c9b1a4fdd54c2a8ddc30641f47a109","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6490c16d69edc7484e597dc3cf3403030a9a20783b848c953a1669955b758e5d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"phodal/routa@e48861ab81e2 snapshot 53e7bdcd26858588","timeframe":null},"slice_ids":["slc_26ff72f483c73fda5e0696acc4aa7660133ccc58fadd842da6e0d4c63fb9b075","slc_c24bafb94cec72d761ee8f037aa7e5d8302675657bd9a432c82821731d83e66e","slc_c5a3a01115d6952163d94d773713978a782435515b33da927b346b062fe76b93"],"source_ids":["src_780a01174d315d5284553833bdc171eb"],"text":"Work flows through Kanban lanes Backlog, Todo, Dev, Review, Done, each backed by a specialist prompt (Backlog Refiner, Todo Orchestrator, Dev Crafter, Review Guard, Done Reporter), with a Blocked Resolver for blocked work.","updated_at":"2026-09-14T02:31:09Z","updated_by_operation":"op_a5c9b1a4fdd54c2a8ddc30641f47a109"}
