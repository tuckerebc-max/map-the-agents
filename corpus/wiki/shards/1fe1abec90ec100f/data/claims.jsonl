{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1acd9739e57a064b485bd19f156b5419178846af13464452495d41b9c85f9c08","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_baa193a1996442823e4c0a4be056ab9f7329bed5da36148a2a2e70c3a7713618"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"Repository development practice: contributors must run 'bun install && bun run build' before starting, because the repo runs failproofai's own hooks on itself and they resolve the import against the compiled dist/ bundle.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1c0982328557c797273d1738618266d07074dd42a3e37ed058b3b50e31e6d8fd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_42c35fe291c4b978c03655a9aee73f3fee65be6391848be6ca4949cbd1f27e17"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"Custom policies are JS files dropped into .failproofai/policies/ that load automatically without flags, and can be committed so the whole team receives them on pull.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3cb98631c03fcb2b1556c1b93a2bedd6f431f8d5d2155750a63a3c55fd15c637","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_ffc82a323ccda94a09e2bf4de79f3c484f0a4aa0cf3cfa45a3be70c276c854f4"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"Agents outside supported harnesses can report via a Python SDK providing tracing, sessions and audits; enforcement there requires a hook in the user's own runtime.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3fc58f555374c73ba3593a36b58c429093665a06e18105fa687d178ea654f010","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_4b9c5a3b1f53e3474158a5f5789d1f67c215556aa0a754264ebb0e1c21d2d328"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"A hosted observability product offers fleet-wide runs, execution graphs with parallel sub-agent lanes, latency percentiles, per-model cost tracking, SQL over traces, scheduled audits, and Slack/email/webhook alerts; self-hosting is Enterprise-only.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_56923caf6f1aab338303927ede002b6badf18d71960544c6652e03a2f6e6bd91","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_0c3a9c5560775c7157682fdda4dfdb2d9fb775a15635a7e1ba4831e02f6a4460"],"source_ids":["src_b9a21b8a47fe50e791e8dc4074486172"],"text":"A CLI 'fp' supports commands like 'fp list tools' and 'fp events --event-type tool_use,tool_result --env production --since 24h', with JSON output options for full session events.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7c06879da3b4891c713f59e5490bae36fe4aab8287854faf5f9d42bf25c35d9e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_b8bb8416329cad2fd71b2f0738fb3e5d777cde919f335fa56e757ceeb1d48f5d","slc_d572900a490b29de2be9aaa247d73a570969cec5cc161ef710424fbbf465a09e"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"The package is distributed via npm as failproofai and installed globally with npm install -g; the project is written in TypeScript per its Trendshift badge.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_82581b1582d7667b196012cb16fa81d864344db38de083cb8979b582a32eb87b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_4969eba81462601b04009136272519555fedf345e61bc86ff6ce8b040a7a40d8","slc_5e3aaf6ad6cad2855f727027b436b7c2cc8c6572bdfc0392c7e4ea2de35ae080"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"39 built-in policies ship with the tool and activate immediately on install; examples include blocking .env reads, sudo, rm -rf, force pushes, destructive SQL, and unreviewed terraform/kubectl changes.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9c2e691b4bd5850923f0c27528ee0e6aa4d0b68ee9419075ca225fba2a3dfcbf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_1ac15e5c4ca3e9acc7483cc6f51d920bc6464f24355b408753f5f084c617cbdd"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"The tool is licensed under MIT plus the Commons Clause: free for internal and personal use, but commercial resale of failproofai itself requires a separate agreement.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a3ba2c513f47868d14f2b6b4eff747d2036179598cf9abee9c673560a6068fa8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_5694e28a514928909c7ad94a0f61599e3fe985c4e2aca4587fea6bbff6d393b2","slc_d78e4123de1bf422073e33fd66277fcc63573055d44f84f939492da71ebefb88"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"The product hooks into 12 agent harnesses in two classes: ten coding CLIs (e.g. Claude Code, Codex) and two chat/assistant gateways (Hermes, OpenClaw), with the same events and policies across them.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a9cf62070de819442d116355e30a898ccbb653a3c9347fc4334913a7de2f37b0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_d537b12501ffffcb7b01e5a428855aa0a405caf0b8fa27fb0b006041dd1c6f16"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"Running failproofai with no arguments serves a local dashboard on localhost:8020 reading existing run history with no account or data leaving the machine; an audit command scans history for risky patterns and suggests policies.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b4e41cdc9b7c5ad3fc9cd74329ca984b9a373e5a4e8289930c5c3be5ef864de0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_05a6dcae50487e0d8ac0f9df485a3d449df1697dbb77e1342f99b9b1bf2190a9"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"Policies return one of three decisions: allow() permits the operation, deny(message) blocks it and returns the message to the agent, and instruct(message) lets it pass while adding context to the agent's next prompt.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
{"access":"public","created_at":"2026-09-14T03:50:03Z","created_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f9e3d7d8905aedd84a24c98a4568e3545b84f73a5ec20252c1965974e3aeb891","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"failproofai/failproofai@86f80fc59ee1 snapshot cca0cfe74a52d5e3","timeframe":null},"slice_ids":["slc_722ce834e26f2b89e6f25040d4e70e1371d70b5a3ac68bf9b39b0fe6cd39cd36","slc_f01b6c01851df78b308680ea61f5b4a2878520757c57fc49f7a089c6f4f7ef96"],"source_ids":["src_1a8628246ced568db74fc033ad223936"],"text":"Custom policies are registered via a customPolicies.add() API from the failproofai package, matching events such as PreToolUse and receiving a context with tool input.","updated_at":"2026-09-14T03:50:03Z","updated_by_operation":"op_50925e4ab72a4317bb5c08c0b9e136dc"}
