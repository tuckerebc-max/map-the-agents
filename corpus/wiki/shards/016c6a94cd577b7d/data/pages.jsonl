{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1a59f460494d0fbc6bfaf1a6aacee77224f48ab04929e15309aa46707496ce58"],"opposing_claim_ids":[],"text":"Individual usage currently requires a free Sourcegraph.com account, which the README says exists to prevent abuse of free Anthropic/OpenAI LLM usage."},{"claim_ids":["clm_2c49048bb653102bb7c490f9977842436e86043d5e402b5ca7da4e841e393b60"],"opposing_claim_ids":[],"text":"The editor extensions work with Sourcegraph Cloud and self-hosted Sourcegraph Enterprise Server instances on version 5.1 or later."},{"claim_ids":["clm_68a66527d33b1384059d12d8a675ada3f13364cac63f1077e4f671799410ac79"],"opposing_claim_ids":[],"text":"The product advertises swappable LLMs, naming Anthropic Claude Sonnet 4, OpenAI GPT-4o, Mixtral, and Gemini 1.5 among supported models."},{"claim_ids":["clm_9a23ccc1daf791046f47a113476e7b7814f1078b393ce2a53211b53284609b87"],"opposing_claim_ids":[],"text":"Cody retrieves context from local and remote codebases via advanced/semantic search, and supports @-mentioning files to target specific context."},{"claim_ids":["clm_b4754a85be718fff8371fae7171a76c67de77ad9ed76d3dd76f2f0b6e9ad595b"],"opposing_claim_ids":[],"text":"Cody is available as a VS Code extension, a JetBrains plugin, and a web chat client."},{"claim_ids":["clm_b7c2c2bb3d9a781b155c4b0b0391ed7025df41b829b747485faacf7190f19b98"],"opposing_claim_ids":[],"text":"Documented features include chat with codebase context, single- and multi-line autocomplete, inline edit/refactor, and customizable prompts such as Document, Explain, and Generate Unit Tests."}],"claim_ids":["clm_1a59f460494d0fbc6bfaf1a6aacee77224f48ab04929e15309aa46707496ce58","clm_2c49048bb653102bb7c490f9977842436e86043d5e402b5ca7da4e841e393b60","clm_68a66527d33b1384059d12d8a675ada3f13364cac63f1077e4f671799410ac79","clm_9a23ccc1daf791046f47a113476e7b7814f1078b393ce2a53211b53284609b87","clm_b4754a85be718fff8371fae7171a76c67de77ad9ed76d3dd76f2f0b6e9ad595b","clm_b7c2c2bb3d9a781b155c4b0b0391ed7025df41b829b747485faacf7190f19b98"],"created_at":"2026-09-14T02:42:09Z","created_by_operation":"op_4e973c5b7eca4f7cb78d8230aaf38668","id":"pg_24e9dde8bf08589bad4aa4f8e843fbb4","maturity":"draft","page_type":"source","path":"pages/sources/sourcegraph-cody-public-snapshot-readme-md-8e20ac6c1460-a4f8e843fbb4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_eddb76dd224e557d98d5eda7f19601df"],"title":"sourcegraph/cody-public-snapshot/README.md @ 8e20ac6c1460","updated_at":"2026-09-14T02:42:09Z","updated_by_operation":"op_4e973c5b7eca4f7cb78d8230aaf38668"}
