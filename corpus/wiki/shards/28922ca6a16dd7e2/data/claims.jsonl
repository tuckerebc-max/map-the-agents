{"access":"public","created_at":"2026-09-14T03:42:55Z","created_by_operation":"op_72a54b98d4a44e8db960e10077377a13","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_28cb513f6d52157a603006b66b91e06b62146aa13cdf1bcbec39b30d29363502","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"cortexkit/aft@c0c8e80220ac snapshot 6ee76353dadd17a8","timeframe":null},"slice_ids":["slc_d0b3193b7b414956670fc130dfc3f4fc639f6da6762799693dc4fe7fe9357e41"],"source_ids":["src_84c0c3e796265a29bd591ca9b8bbc0e1"],"text":"Sensory tools include aft_outline, aft_zoom, aft_search (hybrid semantic+lexical), aft_callgraph, aft_inspect, and trigram-indexed grep/glob backed by a file watcher.","updated_at":"2026-09-14T03:42:55Z","updated_by_operation":"op_72a54b98d4a44e8db960e10077377a13"}
