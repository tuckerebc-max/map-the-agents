{"access":"public","created_at":"2026-09-14T03:42:55Z","created_by_operation":"op_72a54b98d4a44e8db960e10077377a13","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_92e2335f67aa067d8c69d1b4bddf0cbec100549622391cc8b34df4ed467aca09","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"cortexkit/aft@c0c8e80220ac snapshot 6ee76353dadd17a8","timeframe":null},"slice_ids":["slc_887c28da76eaa56128224f649fb1b4c7502a9c8c7c4d23fc55e8f497a3228d1c","slc_fb7dd4e256c3ad1bf1e8991e8c4af5f760d7c281730692b16abe5ddcabe4ebb7"],"source_ids":["src_84c0c3e796265a29bd591ca9b8bbc0e1"],"text":"AFT ships as a Rust binary with thin TypeScript adapter packages for OpenCode, Pi, and OMP, distributed via crates.io and npm.","updated_at":"2026-09-14T03:42:55Z","updated_by_operation":"op_72a54b98d4a44e8db960e10077377a13"}
{"access":"public","created_at":"2026-09-14T03:42:55Z","created_by_operation":"op_72a54b98d4a44e8db960e10077377a13","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a1053f8fd5691740716296e86212648ba500b433e6a59381242ce6f3293afeef","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"cortexkit/aft@c0c8e80220ac snapshot 6ee76353dadd17a8","timeframe":null},"slice_ids":["slc_7635e0ef79535d924b224331e4f1a5b8b9b4520cccdce01674dbb6abcd192c3d","slc_887c28da76eaa56128224f649fb1b4c7502a9c8c7c4d23fc55e8f497a3228d1c"],"source_ids":["src_84c0c3e796265a29bd591ca9b8bbc0e1"],"text":"Adapters hoist the host's built-in read/write/edit/grep tool slots so existing tool names are backed by AFT, while also registering an aft_-prefixed tool family; hoist_builtin_tools toggles this behavior.","updated_at":"2026-09-14T03:42:55Z","updated_by_operation":"op_72a54b98d4a44e8db960e10077377a13"}
