{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_010468d48528f26d0d473a3cb159428c4b9bade2e7edceaebe3857d0010245cc"],"opposing_claim_ids":[],"text":"Per the documentation, code execution currently supports only Python as the language type."},{"claim_ids":["clm_08e95a887670efc556cc12a73d40ff84ac0692dacd8681af5991717858c6635a"],"opposing_claim_ids":[],"text":"Images generated during code execution are converted to Base64 and stored in PostgreSQL, with connection details configured in config.yaml and served via API endpoints."},{"claim_ids":["clm_4075cc6e37cf993d8a5a18ed866038bd7353fef5d2b36905999a35f11d3b5974"],"opposing_claim_ids":[],"text":"Repository development practice: a concurrency test script concurrent_test.py can be run with python3 to verify concurrent functionality."},{"claim_ids":["clm_44682189eeed7fb9278fe01a7901203ac6043d490c20df8b3cb94b88b1e824a9"],"opposing_claim_ids":[],"text":"The API exposes a /runcode endpoint accepting POST or GET requests with languageType, optional variables, and code fields, currently supporting only Python."},{"claim_ids":["clm_a1f13ff28c63de18617fff9ef454c79bfd4354bcc98e4df15f71b85b9898e9e0"],"opposing_claim_ids":[],"text":"Concurrency is handled with threads and a semaphore that controls the number of concurrent requests."},{"claim_ids":["clm_b2e2c3080375ea81fdae1413873c45bf3396c3d3b688b98373e1af8bf135a8b0"],"opposing_claim_ids":[],"text":"Each code execution request runs in its own Docker container for security and resource isolation, with configurable memory and CPU limits and port ranges."},{"claim_ids":["clm_d8855ec370146463c3ba50a580a034e4d9d8bcf575da4549a466bbdd2c89b96f"],"opposing_claim_ids":[],"text":"The backend is a Flask (Python) application using PostgreSQL with SQLAlchemy as ORM, started via python3 center.py on a configured scheduling-center port."},{"claim_ids":["clm_dfb38de7c2093c1198f09923925d19b94f4c896e3c696dfaa74b80b24d889581"],"opposing_claim_ids":[],"text":"A GET /image/<filename> endpoint retrieves image data stored in the database, and /runcode responses can include an images map of URLs plus captured output."},{"claim_ids":["clm_f21010e3529fb934ff848a5ea624eecf9db89c7c119b6c2bbaca8e84213c29fa"],"opposing_claim_ids":[],"text":"The API returns HTTP status codes for error scenarios: 400 for invalid JSON/parameters, 401 for missing or invalid token, 405 for invalid methods, and 504 for timeouts."},{"claim_ids":["clm_ff24b5ea159c1dee8b1234dda70eb134bc1d7723859c2b66c714091e07e5ee1a"],"opposing_claim_ids":[],"text":"Access can be secured with optional Bearer token authentication; missing or invalid tokens yield a 401 response."}],"claim_ids":["clm_010468d48528f26d0d473a3cb159428c4b9bade2e7edceaebe3857d0010245cc","clm_08e95a887670efc556cc12a73d40ff84ac0692dacd8681af5991717858c6635a","clm_4075cc6e37cf993d8a5a18ed866038bd7353fef5d2b36905999a35f11d3b5974","clm_44682189eeed7fb9278fe01a7901203ac6043d490c20df8b3cb94b88b1e824a9","clm_a1f13ff28c63de18617fff9ef454c79bfd4354bcc98e4df15f71b85b9898e9e0","clm_b2e2c3080375ea81fdae1413873c45bf3396c3d3b688b98373e1af8bf135a8b0","clm_d8855ec370146463c3ba50a580a034e4d9d8bcf575da4549a466bbdd2c89b96f","clm_dfb38de7c2093c1198f09923925d19b94f4c896e3c696dfaa74b80b24d889581","clm_f21010e3529fb934ff848a5ea624eecf9db89c7c119b6c2bbaca8e84213c29fa","clm_ff24b5ea159c1dee8b1234dda70eb134bc1d7723859c2b66c714091e07e5ee1a"],"created_at":"2026-09-14T04:05:44Z","created_by_operation":"op_b7f38aed4dab4fb2b6b39834d7dde6f7","id":"pg_30ba9f9755b8525f908b06c7b207a218","maturity":"draft","page_type":"source","path":"pages/sources/leezhuuuuu-code-interpreter-api-readme-md-541a0659e531-06c7b207a218.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c65e522e96dd5ef69f9ff92675bfc7a3"],"title":"leezhuuuuu/Code-Interpreter-Api/README.md @ 541a0659e531","updated_at":"2026-09-14T04:05:44Z","updated_by_operation":"op_b7f38aed4dab4fb2b6b39834d7dde6f7"}
