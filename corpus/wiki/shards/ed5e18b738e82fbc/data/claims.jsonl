{"access":"public","created_at":"2026-09-14T02:31:29Z","created_by_operation":"op_f3455910a9154937bb0f320095705ae6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fb975e63c4deff15c7cbd8230e1d99226cd9ed3b8423ea3a2c574c84df73bd52","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"podiom/podiom@78025f740077 snapshot a58c745d296cbf3b","timeframe":null},"slice_ids":["slc_0ac8d543388608f1dab67e7129f5e183c9406ad2475d949d67781fedd4b3eae0"],"source_ids":["src_bddcfe8e41e758169cb1ca925f75f8b9"],"text":"Podiom does not replace the provider runtime; it shells out to the native claude and codex CLIs and reuses their models, MCP servers, tools, skills, and authentication.","updated_at":"2026-09-14T02:31:29Z","updated_by_operation":"op_f3455910a9154937bb0f320095705ae6"}
