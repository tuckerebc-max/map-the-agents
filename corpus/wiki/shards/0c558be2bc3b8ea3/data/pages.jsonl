5","maturity":"draft","page_type":"entity","path":"pages/entities/earendil-works-pi-c7fb89f09515.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"earendil-works/pi","updated_at":"2026-09-14T01:47:27Z","updated_by_operation":"op_4a54be6f201d4231905413a689c1e487"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0b02da203fcd2e0a243c4e30deaa795e79d4d8b59f5dfcea7e8a999bc22b8eff"],"opposing_claim_ids":[],"text":"Constrained layout is exposed via a ViewportTUI capability interface with setLayoutRoot; TuiAltScreen implements it while TuiMainScreen does not, and a type guard checks the capability rather than using instanceof."},{"claim_ids":["clm_1c11ef75f4016822545696a3233d63e6a0b281534636937351726d5b84750c16"],"opposing_claim_ids":[],"text":"The TUI plan introduces a constrained alternate-screen layout so the coding-agent transcript scrolls while pending messages, status, editor, and footer stay fixed at the bottom; main-screen mode keeps terminal-owned scrolling."},{"claim_ids":["clm_7c84f0ded688464371f8545f706e76d5503c3655bd69ce36499ab24ddd991517"],"opposing_claim_ids":[],"text":"Wheel events are hit-tested against the committed frame and routed from the deepest box upward, with overscroll chaining or containment, falling back to the primary scroll view; keyboard scrolling actions remain always available."},{"claim_ids":["clm_9858867453dde331039c980dac0b872b0f3117f15797ef68e9e470c2b7aa5d34"],"opposing_claim_ids":[],"text":"The planned public layout primitives are VStack, HStack, and ScrollView, with stack entries configured via basis, grow, shrink, minSize, maxSize, and a viewport-dependent visible predicate."},{"claim_ids":["clm_9af5d3b81bedbed1dc88fb2cd0215eeb02332706642b51ed199c353349e289e9"],"opposing_claim_ids":[],"text":"The internal layout tree is rebuilt per requested render as a transient frame snapshot, while the public component tree stays long-lived and stateful; leaf render caches in Markdown, Text, Image, and Box are reused."}],"claim_ids":["clm_0b02da203fcd2e0a243c4e30deaa795e79d4d8b59f5dfcea7e8a999bc22b8eff","clm_1c11ef75f4016822545696a3233d63e6a0b281534636937351726d5b84750c16","clm_7c84f0ded688464371f8545f706e76d5503c3655bd69ce36499ab24ddd991517","clm_9858867453dde331039c980dac0b872b0f3117f15797ef68e9e470c2b7aa5d34","clm_9af5d3b81bedbed1dc88fb2cd0215eeb02332706642b51ed199c353349e289e9"],"created_at":"2026-09-14T01:47:27Z","created_by_operation":"op_4a54be6f201d4231905413a689c1e487","id":"pg_b6b7c5a87b925dd6a44410d6be2e9eea","maturity":"draft","page_type":"source","path":"pages/sources/earendil-works-pi-tui-plan-md-71dca871bc80-10d6be2e9eea.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_292ff47284ce520ca32a4df43a0fc231"],"title":"earendil-works/pi/tui-plan.md @ 71dca871bc80","updated_at":"2026-09-14T01:47:27Z","updated_by_operation":"op_4a54be6f201d4231905413a689c1e487"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1d57dcc7d3c0acc23dd46e1a7cbc70352c24b0eda74deec655337016955093c0"],"opposing_claim_ids":[],"text":"Repository development practice: development uses npm install --ignore-scripts, npm run build/check, ./test.sh (skipping LLM-dependent tests without API keys), and ./pi-test.sh to run pi from sources."},{"claim_ids":["clm_20e24f06a0c4e72163e81c6327f59e640e68a8aa53d801a78838ce84b8529497"],"opposing_claim_ids":[],"text":"Repository development practice: new contributors' issues and PRs are auto-closed by default and reviewed daily by maintainers, per CONTRIBUTING.md."},{"claim_ids":["clm_34bf24e120dc7f0549c6077e12267dd135a1d69b0fc7d66da1b2b35cd55d2d18"],"opposing_claim_ids":[],"text":"The repository is a monorepo whose packages include a coding-agent CLI, an agent runtime with tool calling and state management, a multi-provider LLM API, a TUI library, a telemetry package, and a chord application-composition runtime."},{"claim_ids":["clm_3a5f6427ae410dc49efd65eecbe5d3a2903c060e330fb19dbd728850d8a939de"],"opposing_claim_ids":[],"text":"Direct external dependencies are pinned to exact versions, .npmrc sets save-exact and min-release-age=2, and the published CLI package carries a shrinkwrap file pinning transitive dependencies."},{"claim_ids":["clm_5e55f3ee68c05787ef0368a9169f7df34aade2cdbd50369082d28d476404f066"],"opposing_claim_ids":[],"text":"Pi ships without a built-in permission system for filesystem, process, network, or credential access; by default it runs with the permissions of the launching user and process."},{"claim_ids":["clm_fc57dc33369d45c5a0700ddf421df8311cd3c2c25b630888c303049e9d973ec1"],"opposing_claim_ids":[],"text":"Repository development practice: npm dependency changes are treated as reviewed code changes, with CI installing via npm ci --ignore-scripts and a scheduled workflow running npm audit and signature checks."}],"claim_ids":["clm_1d57dcc7d3c0acc23dd46e1a7cbc70352c24b0eda74deec655337016955093c0","clm_20e24f06a0c4e72163e81c6327f59e640e68a8aa53d801a78838ce84b8529497","clm_34bf24e120dc7f0549c6077e12267dd135a1d69b0fc7d66da1b2b35cd55d2d18","clm_3a5f6427ae410dc49efd65eecbe5d3a2903c060e330fb19dbd728850d8a939de","clm_5e55f3ee68c05787ef0368a9169f7df34aade2cdbd50369082d28d476404f066","clm_fc57dc33369d45c5a0700ddf421df8311cd3c2c25b630888c303049e9d973ec1"],"created_at":"2026-09-14T01:47:27Z","created_by_operation":"op_4a54be6f201d4231905413a689c1e487","id":"pg_fa369b75021d5db8be520c2619d3cf89","maturity":"draft","page_type":"source","path":"pages/sources/earendil-works-pi-readme-md-71dca871bc80-0c2619d3cf89.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_82fe263f2e53561986010018f5d325a9"],"title":"earendil-works/pi/README.md @ 71dca871bc80","updated_at":"2026-09-14T01:47:27Z","updated_by_operation":"op_4a54be6f201d4231905413a689c1e487"}
