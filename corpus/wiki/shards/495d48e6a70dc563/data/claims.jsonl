{"access":"public","created_at":"2026-09-14T04:23:34Z","created_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4235412de0fcc3d0338775683b7c24c0d119277c825e75a27c2e67e8450a4188","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"structuredllm/syncode@4d6c110a028d snapshot 4cf25e2790b4916d","timeframe":null},"slice_ids":["slc_4fb428cd7380013044e171d265174c4173543ce4ea3a24f37861528e40a5f925"],"source_ids":["src_c860e3117a8357e194779758ef556637"],"text":"SynCode's core is an offline-constructed DFA mask store built from regular expressions of grammar terminals, used with an incremental parser's accept sequences and remainder to mask invalid tokens during decoding.","updated_at":"2026-09-14T04:23:34Z","updated_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a"}
{"access":"public","created_at":"2026-09-14T04:23:34Z","created_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_800bec99e0af6416a75c6ca5c5e8b146f55a1a28ecc6be5906e1e0b8bf07154c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"structuredllm/syncode@4d6c110a028d snapshot 4cf25e2790b4916d","timeframe":null},"slice_ids":["slc_694a639fab36ad15042b1599187817bd9f562a07e832b169dc8b8a92ead16b5b","slc_7b8def66916f5a023fc9c3ab290b9507d703255bf721f492a6e56ab5b90ab511","slc_ca79119173b4e6a59c10c26c8091a95cdde9fbae39632acf103b93d0571ba315"],"source_ids":["src_c860e3117a8357e194779758ef556637"],"text":"A SynCode class offers an infer() method taking prompt and task_id; if neither is given, it reads user input via stdin.","updated_at":"2026-09-14T04:23:34Z","updated_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a"}
