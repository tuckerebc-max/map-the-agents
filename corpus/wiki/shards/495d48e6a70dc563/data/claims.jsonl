{"access":"public","created_at":"2026-09-14T04:23:34Z","created_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_876f6ec8eb1b8825800b2a54c0c3558e4751b542610d2d576e2ae2911333053e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"structuredllm/syncode@4d6c110a028d snapshot 4cf25e2790b4916d","timeframe":null},"slice_ids":["slc_dde27691d334b7022f01630058496c96a50647d4a81b7ec8b83d944e554e82a3"],"source_ids":["src_c860e3117a8357e194779758ef556637"],"text":"SynCode is a framework for grammar-guided LLM generation, claimed to ensure output is syntactically valid with respect to a context-free grammar, with stated soundness and completeness guarantees.","updated_at":"2026-09-14T04:23:34Z","updated_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a"}
{"access":"public","created_at":"2026-09-14T04:23:34Z","created_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_95c1ba11db34834a25e728ef0c13c8778141076d503e0aeaf3b0e5067938acc9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"structuredllm/syncode@4d6c110a028d snapshot 4cf25e2790b4916d","timeframe":null},"slice_ids":["slc_7bd0a0ef8ab1916aa1153b43385cf226742a6496d13f14a4f3911c2f5fb3b9ea"],"source_ids":["src_c860e3117a8357e194779758ef556637"],"text":"Cache directories can be configured via HF_CACHE and SYNCODE_CACHE environment variables, with defaults used otherwise; HF_ACCESS_TOKEN enables gated HuggingFace models.","updated_at":"2026-09-14T04:23:34Z","updated_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a"}
{"access":"public","created_at":"2026-09-14T04:23:34Z","created_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bf8c6014d2368426b99eebc8f6abf98be82b00ec1d7415bbf57e28e01e88f9ed","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"structuredllm/syncode@4d6c110a028d snapshot 4cf25e2790b4916d","timeframe":null},"slice_ids":["slc_dde27691d334b7022f01630058496c96a50647d4a81b7ec8b83d944e554e82a3"],"source_ids":["src_c860e3117a8357e194779758ef556637"],"text":"The README reports SynCode achieving 99% JSON generation accuracy with Gemma-2b and being 10-20% faster than unconstrained generation, referencing an evaluation notebook.","updated_at":"2026-09-14T04:23:34Z","updated_by_operation":"op_02f44dab0ac94a29817f6dd616f8453a"}
