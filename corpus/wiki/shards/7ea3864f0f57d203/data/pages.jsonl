:00Z","updated_by_operation":"op_5d3549950a6d4ebea6716999c8de9622"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_06202264b8961595d0205d3cf706407071dc0650e461f41e211f02946c991654"],"opposing_claim_ids":[],"text":"The repository contains workflow definitions and associated material intended for use with z/OS Management Facility (z/OSMF)."},{"claim_ids":["clm_31ff5f8de6ae11e2c7f0a01c3c69ef6b4ebd451f38d919fe1463ebc0fe1d1403"],"opposing_claim_ids":[],"text":"A z/OSMF workflow is described as a guided set of steps for z/OS activities, able to configure subsystems, submit jobs and scripts, issue REST APIs, and invoke TSO/E functions."},{"claim_ids":["clm_7c7660e64bd51fb4808bd47068dee0d3ff8b79b34bd73c3c2b017de3508d1079"],"opposing_claim_ids":[],"text":"The project is in Emeritus status and is no longer maintained, per the README notice."},{"claim_ids":["clm_90fb16b8f05c3bc265cd7f0205c0cc009e080b8f2ce1821b2b226b8e84bd16a7"],"opposing_claim_ids":[],"text":"Repository development practice: users are directed to install workflows into z/OSMF following IBM's workflow-definition instructions, and to sample workflows for an introduction."},{"claim_ids":["clm_a4d44500933e0467134404f3625649bfb8e01a5df2080094519a52830ee8ef2c"],"opposing_claim_ids":[],"text":"Repository development practice: community discussion happens via mailing lists, the #zorow Slack channel, community forums, and a biweekly TSC meeting."},{"claim_ids":["clm_be1488d87d88223dbf3563b2d7dc371b222ba8bf9e15a242f0087a4bb881aaad"],"opposing_claim_ids":[],"text":"Repository development practice: sensitive or security-related issues must be emailed to zorow-private@lists.openmainframeproject.org rather than filed publicly."}],"claim_ids":["clm_06202264b8961595d0205d3cf706407071dc0650e461f41e211f02946c991654","clm_31ff5f8de6ae11e2c7f0a01c3c69ef6b4ebd451f38d919fe1463ebc0fe1d1403","clm_7c7660e64bd51fb4808bd47068dee0d3ff8b79b34bd73c3c2b017de3508d1079","clm_90fb16b8f05c3bc265cd7f0205c0cc009e080b8f2ce1821b2b226b8e84bd16a7","clm_a4d44500933e0467134404f3625649bfb8e01a5df2080094519a52830ee8ef2c","clm_be1488d87d88223dbf3563b2d7dc371b222ba8bf9e15a242f0087a4bb881aaad"],"created_at":"2026-09-14T04:14:00Z","created_by_operation":"op_5d3549950a6d4ebea6716999c8de9622","id":"pg_7da43d6ede0456c7b1665811b64bdc2f","maturity":"draft","page_type":"source","path":"pages/sources/openmainframeproject-zorow-readme-md-9f1fdf0185d8-5811b64bdc2f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0eb61ccd80795f50ba9c9c1e2f9f4320"],"title":"openmainframeproject/zorow/README.md @ 9f1fdf0185d8","updated_at":"2026-09-14T04:14:00Z","updated_by_operation":"op_5d3549950a6d4ebea6716999c8de9622"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2288cd707766ddd2ac11e1292f6e80efd5f4eb72681906d6697fa6c5b1a26538"],"opposing_claim_ids":[],"text":"Repository development practice: governance defines contributor and committer roles; committers are elected by majority approval and listed in COMMITTERS.md, and may be moved to emeritus status."},{"claim_ids":["clm_a80428d8d83cd927245fb2c7e586ca181f5cf18325eef55145b2c2e0a1729f96"],"opposing_claim_ids":[],"text":"Repository development practice: unresolved disputes are decided by committers, ultimately via simple-majority voting with one vote per committer."},{"claim_ids":["clm_ce32e4247222c8b62365b6fc5c74c48c49ea5d4ab50ba3e4382b7504492275c7"],"opposing_claim_ids":[],"text":"Repository development practice: the project is source code only and no project release will be made."}],"claim_ids":["clm_2288cd707766ddd2ac11e1292f6e80efd5f4eb72681906d6697fa6c5b1a26538","clm_a80428d8d83cd927245fb2c7e586ca181f5cf18325eef55145b2c2e0a1729f96","clm_ce32e4247222c8b62365b6fc5c74c48c49ea5d4ab50ba3e4382b7504492275c7"],"created_at":"2026-09-14T04:14:00Z","created_by_operation":"op_5d3549950a6d4ebea6716999c8de9622","id":"pg_b02737db920a5155900ed7447a506610","maturity":"draft","page_type":"source","path":"pages/sources/openmainframeproject-zorow-governance-md-9f1fdf0185d8-d7447a506610.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1039c1da51e45a089af32e62349242cc"],"title":"openmainframeproject/zorow/governance.md @ 9f1fdf0185d8","updated_at":"2026-09-14T04:14:00Z","updated_by_operation":"op_5d3549950a6d4ebea6716999c8de9622"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_46034f148067b231cce129ddc3198995fdb03bd9e98a4b66f585137c731b661d"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are made via pull request, require DCO signoff, must be Apache 2 (code) or CC BY 4.0 (docs) licensed, and are reviewed by a committer."},{"claim_ids":["clm_be1488d87d88223dbf3563b2d7dc371b222ba8bf9e15a242f0087a4bb881aaad"],"opposing_claim_ids":[],"text":"Repository development practice: sensitive or security-related issues must be emailed to zorow-private@lists.openmainframeproject.org rather than filed publicly."}],"claim_ids":["clm_46034f148067b231cce129ddc3198995fdb03bd9e98a4b66f585137c731b661d","clm_be1488d87d88223dbf3563b2d7dc371b222ba8bf9e15a242f0087a4bb881aaad"],"created_at":"2026-09-14T04:14:00Z","created_by_operation":"op_5d3549950a6d4ebea6716999c8de9622","id":"pg_f58297d1b23e5b41abd56de1a24117dd","maturity":"draft","page_type":"source","path":"pages/sources/openmainframeproject-zorow-contributing-md-9f1fdf0185d8-6de1a24117dd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9c582ee4c3bc55dcb854df8f8b4c3eb9"],"title":"openmainframeproject/zorow/CONTRIBUTING.md @ 9f1fdf0185d8","updated_at":"2026-09-14T04:14:00Z","updated_by_operation":"op_5d3549950a6d4ebea6716999c8de9622"}
