{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_05af5b814a1cbf5c2e845cc41e492577d47cae6367f9d8b4ff8c798e534f746a"],"opposing_claim_ids":[],"text":"The package installs from PyPI as plasma-fractal (or via the fractal pointer dist); pipx/uv tool installs additionally require installing plasma-wiki, which a plain pip install pulls automatically."},{"claim_ids":["clm_2731eef859ee02b9120860244c4b1c0c7465d362958a6a9d12dc6c8c50b6f958"],"opposing_claim_ids":[],"text":"'node stop' waits for the in-flight agent to complete rather than tearing the running seat, and cascades over the target's entire subtree children-first; 'node kill' remains the immediate path and can reap booting spawns."}],"claim_ids":["clm_05af5b814a1cbf5c2e845cc41e492577d47cae6367f9d8b4ff8c798e534f746a","clm_2731eef859ee02b9120860244c4b1c0c7465d362958a6a9d12dc6c8c50b6f958"],"created_at":"2026-09-14T02:31:11Z","created_by_operation":"op_f8909e523a7743ddb94dd5b5fdd7d3b9","id":"pg_93bfec8da8455b78bf2a040e76e59394","maturity":"draft","page_type":"source","path":"pages/sources/plasma-ai-fractal-changelog-md-18793200c0d7-040e76e59394.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8065af0adf255028bd9d481965a173ba"],"title":"plasma-ai/fractal/CHANGELOG.md @ 18793200c0d7","updated_at":"2026-09-14T02:31:11Z","updated_by_operation":"op_f8909e523a7743ddb94dd5b5fdd7d3b9"}
