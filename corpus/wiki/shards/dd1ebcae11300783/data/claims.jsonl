{"access":"public","created_at":"2026-09-14T02:24:32Z","created_by_operation":"op_dafbd3add5b5480c85ed3f601d941f18","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_42d1081ddaf28911ca0103ba773726bb3cb53c9f80b8a26b6d291d6b6fec21e9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"olasunkanmi-se/codebuddy@a9b8cd08ebaa snapshot 345f3ad884e40c16","timeframe":null},"slice_ids":["slc_419f11992e5ae1539d3a201a004fa861b1eb8296be66793a634cc0a8604c6af9","slc_72fab34c91d4d8fd6e63e5d1fa2a49b1d9830e13928e3b738aeede555e97042b"],"source_ids":["src_4cc851d8a25e591c9e76844fec6b6f8e"],"text":"A Developer Agent coordinates seven specialized subagents (analyzer, doc writer, debugger, file organizer, architect, reviewer, tester) built on the LangGraph DeepAgents framework, each with role-filtered tools.","updated_at":"2026-09-14T02:24:32Z","updated_by_operation":"op_dafbd3add5b5480c85ed3f601d941f18"}
{"access":"public","created_at":"2026-09-14T02:24:32Z","created_by_operation":"op_dafbd3add5b5480c85ed3f601d941f18","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5612c0bdea9947bef044d23c28c76bcf668e05fbf6ed814592f05647e55af131","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"olasunkanmi-se/codebuddy@a9b8cd08ebaa snapshot 345f3ad884e40c16","timeframe":null},"slice_ids":["slc_48d3a03c944823b61d4accbbf5c0077441badf6d522d7887976740ce6fcd06e8"],"source_ids":["src_4cc851d8a25e591c9e76844fec6b6f8e"],"text":"A singleton Orchestrator event bus mediates all subsystem communication via typed publish/subscribe events, decoupling agent, webview, and service layers.","updated_at":"2026-09-14T02:24:32Z","updated_by_operation":"op_dafbd3add5b5480c85ed3f601d941f18"}
{"access":"public","created_at":"2026-09-14T02:24:32Z","created_by_operation":"op_dafbd3add5b5480c85ed3f601d941f18","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6209d64466e58355ba3196c61a993ba71567490ba1bf5ac3201b03a720a83e39","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"olasunkanmi-se/codebuddy@a9b8cd08ebaa snapshot 345f3ad884e40c16","timeframe":null},"slice_ids":["slc_7341eeb4e007083252ef5ebf90948dd6d4578ae0645a3120d87e4a7c2df452da","slc_ffe9e567b8e9083cde0bc35104512584d3f2bb1d48f1c41f913112a1d3b3374e"],"source_ids":["src_4cc851d8a25e591c9e76844fec6b6f8e"],"text":"Persistent memory is file-backed at .codebuddy/memory.json with Knowledge/Rule/Experience categories, user and project scopes, and automatic injection into the agent's system prompt.","updated_at":"2026-09-14T02:24:32Z","updated_by_operation":"op_dafbd3add5b5480c85ed3f601d941f18"}
{"access":"public","created_at":"2026-09-14T02:24:32Z","created_by_operation":"op_dafbd3add5b5480c85ed3f601d941f18","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_634f05b733df1f74405901084fe4734d87bf6691d41d33be668a13289c6ac4c5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"olasunkanmi-se/codebuddy@a9b8cd08ebaa snapshot 345f3ad884e40c16","timeframe":null},"slice_ids":["slc_72fab34c91d4d8fd6e63e5d1fa2a49b1d9830e13928e3b738aeede555e97042b","slc_73a7d40ba12702909222f5295f1a7a278ee90abf5546ed78422df0b9c837828b","slc_ca3e2e108413b710151950c53fdbc21b587f02f7bcaa2d377f2812ba96c92f93"],"source_ids":["src_4cc851d8a25e591c9e76844fec6b6f8e"],"text":"The agent layer is built on LangGraph/LangChain-compatible chat models, with Tree-sitter WASM parsers for 7 languages and sql.js (WASM) SQLite with FTS4 for persistence.","updated_at":"2026-09-14T02:24:32Z","updated_by_operation":"op_dafbd3add5b5480c85ed3f601d941f18"}
