{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_15225373ab6b02a6af098e07a169e0a5aa2f6ba02c934a6530438c73814fdc7d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_645d888e22f0002a8475adf38218fc5f4bb39e2aefa1b7e2dc13d5e862cec9ea"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"The system comprises a User Proxy Agent, Planner Agent, LAMMPS Worker Agent, LAMMPS Evaluator Agent, and a GroupChatManager coordinating agent communication and workflow.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_29582caaf9aedfa78efd3a4230eac6e1066a8f2ee7f545876e6701f67e65a4af","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_7923993fb800a32944afbae208ae9e221c2377d219d73c4164d9069ca50124a3"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"MDAgent is a multi-agent collaborative system built on Microsoft's AutoGen framework for materials-science simulation and analysis tasks.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2e5120412b67d99a363c9b4edaa7bf8681742c6f76b597211d28532052539922","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_5218a8e830c114db8c74c306c639e6d35790928f47c1606bb0a1db93442ac44f"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"The README reports expert evaluations showing significant improvement in code quality and a 42.22% reduction in task time versus traditional approaches.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_32364b222df719e40fd2e48be29d5c9ca7c53d662de9924a8909da76ae209da2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_0a4903787d88c883ce8d87ab1a04403e24cea1ddb5c96e252942247c7ca06e1f","slc_2fe6c33127bf1e35e0aa212c62344be16a9849af28eb9f180f06ef57f6e68139","slc_8def13d21d823264e2c4ad2dd0c1359c15bc6f4b96f9de58b123d8cac0ce2dcf"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"The user interacts through a Panel web UI served via 'panel serve material_system_UI.py', accessible by default at http://localhost:5006/material_system_UI, using dialogue-based interaction.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4b10608e03fa060cc427caeffe794bb1cba4d8925a4f63f3512eeb8293bc3a72","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_1a1e897a3811b82a77e998b05e5eaeac250204115e1307eaa2c779f3252219c7","slc_86e19a0496815ee62fd87d07402b2b41e3162b337b760b35be293d1b713b7192"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"Generated code is executed via AutoGen's code executor in Docker containers, which extract code blocks, write them to files, run each in a container, and read console output.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4cb5528cc858b142a1e00a21ac72b53e9f968f7194bc9fa3ca3afe9365390f04","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_62c6922074b0557beba6731ca0915208b690abd181e8f444bab29576d4b81660","slc_c7d197b44ad5e1809da3de0e4ed69b5ee0c17e283cc515b180b7af9c135772ee","slc_d5e5a50d3f68a26729412cae8df7e18ba8e58444c977cd7b6a779f9243b47532"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"Fine-tuning uses the unsloth framework with QLoRA 4-bit quantization, 4096-token context, on Meta-Llama-3.1-8B-Instruct as the LammpsWorker LLM, with an alpaca-style prompt template.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5db375e6b40cc3363d2140b9963afcbb6b97a1faf6f0e37e5b11c157dd77f179","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_1cf52aa2ce608db53f30f6ffa0db640af7582826c0250794374984e0e4f2496f","slc_3be1ef7962945f0b684dcbcc415f097a1e702839d5088f0d232ce03c9c0cf458","slc_7ab772dfd85eb8be3accd721d81621423bfad000e0f4cdcf0b089fc0e0e81d08","slc_da6516e29f1b25419a35753e2fbc900ad91fa9713c87c7fcb41d554129e0779c"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"The underlying LLM is selectable: an online model such as GPT-4o-mini via OPENAI_API_KEY, or a local model deployed with Ollama (e.g., llama3.1:8b-instruct-q6_K with api_type 'ollama').","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_61f0ab74046a003e9bd27cf0dccf5598431c983ca2ded4a7cb8e660c3a7ded68","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_29d326061a35b1f6406c4ebed931a65683be9eb6f2a29e0ea49581fe9817b706","slc_32068ad3d8b2c6432f91e73ea14fc3645aa3e110f154e2abcda2190b1dfe88d1","slc_581c566607dfd59439ad8ed17cd8baa927e2dfb3b76d0a7920068f0c8a659c92","slc_ccd97294fde3d5701f3dea612d21cc9dc87bbb7d2a7045983638fbca93fe9604"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"To mitigate LLM hallucinations and factual errors, the design uses an Actor-Critic (Worker-Evaluator) loop plus human-in-the-loop review, with the Evaluator prompt augmented by expert-summarized error types.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7b239d677e81d5bad0bf75d57813e850864128d9aadddcb48431cd4cf282433b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_2573106e0d8a8f1e3ade41f263a9be7ab250da9bb01fff8801fcce1e264fb912","slc_6921e3040a12278bc9882c1f5022d2d1a9cceb1c1f35090d12d499ece323e517","slc_b17943c1ed080572379e85362944193ed0f7f4bb223ce7331b43daf88435d1b4","slc_b45e5cdb9d292365345a93d960bba63bd7a3d94f61d09e6ea2822f83e06e7c8b"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"The LEQS dataset is an expert-built benchmark with 0-10 expert scores, deductions, and rationale for evaluating LLM-generated LAMMPS scripts, structured for supervised fine-tuning.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_86a075e7da57ae83010dcf9de999afdef9831d5b0de9cd8aec2dd112cd4206d0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_4040a41b4c6595ccc2b3752563b45fed90a6d7620921e563206adafb4dac323d","slc_847662272e6555d2f8593b056984d7fccf90918e2d1153baede20be2c242ed1d","slc_eea10888305f84b1a365ac3dbc392e23738f74009fa707ba1affca9c1b6311fd"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"A RAGFlow-based RAG API is encapsulated as an AutoGen Tool and provided to the Worker agent, which may call it to acquire knowledge before answering.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
{"access":"public","created_at":"2026-09-14T01:49:11Z","created_by_operation":"op_0bf823143e224c43a4e84839917cdc50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_92d08e7f9a3d19c66058ecbcc597a4ed095523fe9bd7c25a79065c9a4f003228","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"fredericvan/pku_mdagent@83fc74947c72 snapshot ba6c3f9e62616f21","timeframe":null},"slice_ids":["slc_3fe0e8993c9a5dc016b38a7cc0333dd3bc32e7ecead285bf060a4d7118f92ba1","slc_9bf0f6b604a8a01d3e75338a130c08bc639c2c884e937f9feaa2222eca4a328d","slc_c0ddcdf9e964f0f11b3f569dcb1a27dee0d5592902534aafacde8c2501ad934e","slc_df8078652a20a53b992c771d9a2698a88a71318206cb72ae91e36ae66e688c49"],"source_ids":["src_8c23b6cca15054ec917d1dd3aa036b5c"],"text":"The LSCF dataset contains 167 LAMMPS scripts with instruction/input/output fields, organized into Initialization, Modeling, and Computation sections, sourced from manual work, official docs, and online repositories.","updated_at":"2026-09-14T01:49:11Z","updated_by_operation":"op_0bf823143e224c43a4e84839917cdc50"}
