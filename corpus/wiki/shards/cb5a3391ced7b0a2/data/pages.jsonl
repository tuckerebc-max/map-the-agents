{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_138b4163003d8f6b373a9a28adfb8451b8b0a6ed5a223a033a0f667dd8ba9661"],"opposing_claim_ids":[],"text":"Repository development practice: AGENTS.md instructs contributors to follow existing patterns, place reusable logic in code2prompt-core, keep Python bindings thin, include regression tests for bug fixes, and map changed paths to verification skills (verify-core, verify-cli, verify-python, verify-website)."},{"claim_ids":["clm_72a6c3746aaefe962cb95fbcf90706785c204331ccd0cf25f8d5c3116e5772f7"],"opposing_claim_ids":[],"text":"Repository development practice: root cargo test does not exercise the Python bindings, and contributors should not claim completion until the relevant verification skill passes."}],"claim_ids":["clm_138b4163003d8f6b373a9a28adfb8451b8b0a6ed5a223a033a0f667dd8ba9661","clm_72a6c3746aaefe962cb95fbcf90706785c204331ccd0cf25f8d5c3116e5772f7"],"created_at":"2026-09-14T04:10:23Z","created_by_operation":"op_7c6fc34d27694a61813073175c49cdee","id":"pg_758da2430cd05f5ca4420d26a276c8bd","maturity":"draft","page_type":"source","path":"pages/sources/mufeedvh-code2prompt-agents-md-66585136062c-0d26a276c8bd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6185adaa3b6856e6a7d804b4ecd9ea3c"],"title":"mufeedvh/code2prompt/AGENTS.md @ 66585136062c","updated_at":"2026-09-14T04:10:23Z","updated_by_operation":"op_7c6fc34d27694a61813073175c49cdee"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1bf8957122c5db5db52bd23a0d3416154f87ae22df82df1bd95d938759b3c41b"],"opposing_claim_ids":[],"text":"An installable agent skill (skills/code2prompt/SKILL.md) teaches coding agents to use code2prompt for repository navigation and scoped context gathering, installable via the Skills CLI (npx skills add mufeedvh/code2prompt)."},{"claim_ids":["clm_3b102fe8eeff36f54ad5676bb23d1a70c2d64747b8c9e6786e5bbd5a96fa8295"],"opposing_claim_ids":[],"text":"Prompt generation respects .gitignore rules, supports glob-based include/exclude filtering, and uses Handlebars templates that users can customize."},{"claim_ids":["clm_89f6e0da0c6cdbf76dd21284ed73c7529549a2c1467d25bdc56724c0812de97d"],"opposing_claim_ids":[],"text":"The token estimate is approximate by design: it relies on per-file counts and estimated template overhead rather than tokenizing the fully rendered prompt."},{"claim_ids":["clm_9021b31f6a2716e56028a92d3444c4426037dd3a5439242180b3ea43fd5aa884"],"opposing_claim_ids":[],"text":"The ecosystem comprises a Rust core library for file traversal, gitignore handling, and Git metadata; a CLI/TUI; a Python SDK with bindings to the Rust core published on PyPI; and an MCP server."},{"claim_ids":["clm_ac3eff7f44cd12487c2e51b7b902e8c857b0e7d4b2ffc51be50b7659668fdf32"],"opposing_claim_ids":[],"text":"The skill installer adds only the skill folder and its template, possibly cloning the repository temporarily; the rest of the repository is not installed."},{"claim_ids":["clm_f5a8dd5955c8625c98428866b0f3c363cd47a414d854ac7ab96d1a89ed61445d"],"opposing_claim_ids":[],"text":"The tool targets LLM context preparation: generating prompts from codebases for chat models, AI agents, RAG pipelines, and MCP-based agentic workflows."},{"claim_ids":["clm_f8d18be7088dd821d582f6aee9e3a54df42f184f13ce6f9d36272c5aa065f051"],"opposing_claim_ids":[],"text":"Token counts are estimated via parallel per-file counts plus estimated template overhead; the full rendered prompt is not re-tokenized and the JSON envelope is excluded from the estimate."}],"claim_ids":["clm_1bf8957122c5db5db52bd23a0d3416154f87ae22df82df1bd95d938759b3c41b","clm_3b102fe8eeff36f54ad5676bb23d1a70c2d64747b8c9e6786e5bbd5a96fa8295","clm_89f6e0da0c6cdbf76dd21284ed73c7529549a2c1467d25bdc56724c0812de97d","clm_9021b31f6a2716e56028a92d3444c4426037dd3a5439242180b3ea43fd5aa884","clm_ac3eff7f44cd12487c2e51b7b902e8c857b0e7d4b2ffc51be50b7659668fdf32","clm_f5a8dd5955c8625c98428866b0f3c363cd47a414d854ac7ab96d1a89ed61445d","clm_f8d18be7088dd821d582f6aee9e3a54df42f184f13ce6f9d36272c5aa065f051"],"created_at":"2026-09-14T04:10:23Z","created_by_operation":"op_7c6fc34d27694a61813073175c49cdee","id":"pg_8fc8b49368195d18a6ca5cd582a2f894","maturity":"draft","page_type":"source","path":"pages/sources/mufeedvh-code2prompt-readme-md-66585136062c-5cd582a2f894.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d08230c9a04658cabe5a4047f45c353b"],"title":"mufeedvh/code2prompt/README.md @ 66585136062c","updated_at":"2026-09-14T04:10:23Z","updated_by_operation":"op_7c6fc34d27694a61813073175c49cdee"}
