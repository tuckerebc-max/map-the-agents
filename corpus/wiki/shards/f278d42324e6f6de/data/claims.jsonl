{"access":"public","created_at":"2026-09-14T04:18:42Z","created_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_88f02a9c01a30d417685a4af40bc2b966f6dec2ca5fccdfcb5959fde35836da0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"roocodeinc/roo-code-docs@a676c4173ae6 snapshot 4f3c03b6e158e322","timeframe":null},"slice_ids":["slc_16071c240f1c01bd43dd14953afb2e6dd9bdb338edcce3a2394c60cc2e78f109"],"source_ids":["src_85baea03f02e58898f3c0faf8e775de3"],"text":"The product ships in two forms: a VS Code Extension working locally in the IDE, and Roo Code Cloud Agents described as an autonomous AI development team reachable via channels like Slack and GitHub.","updated_at":"2026-09-14T04:18:42Z","updated_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618"}
{"access":"public","created_at":"2026-09-14T04:18:42Z","created_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a6ac58067ab16fa74de44a386f8ca07adb977585736be1dd6babf1ff6c85bd14","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"roocodeinc/roo-code-docs@a676c4173ae6 snapshot 4f3c03b6e158e322","timeframe":null},"slice_ids":["slc_9301fa404e5b5deaf248a701c89004a39ec91907fd4d0aa6a9055fa947796540","slc_d43fe4d87ca7d8bcc5842596538016c3e665084c3fba559f5537cbd86e96c75b"],"source_ids":["src_a5aba4cf58595aec81d0279a9b193de6"],"text":"Roo Code is described as an AI-powered suite of coding products that uses large language models to understand user requests and translate them into actions.","updated_at":"2026-09-14T04:18:42Z","updated_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618"}
{"access":"public","created_at":"2026-09-14T04:18:42Z","created_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a9959b9dccbda454e98007046a26f06f21fc3c0547c01735b36acf2481ac410d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"roocodeinc/roo-code-docs@a676c4173ae6 snapshot 4f3c03b6e158e322","timeframe":null},"slice_ids":["slc_08589989ae4aee0f79ce36cb59daeef8da21a91c078b6d16690ec1ff557f70f2","slc_2f62001a64a1ac518c900231bbb40c376bbbb5bf3090126403a5ac46b534df91","slc_33015c056e48a49ac32f4543d35ae4e326e4ba1d78190ecfb450bc9774e9d8c5","slc_3a8d179aa3484dd6fd97b5807c745fd39df412a3d44fcc34ff931a72d405ff05","slc_9aa3302641d41c7cc0b99b3fc4214b77e3fce9bfb8594a5ec41bf52d5dca62ff","slc_e7cd88e37e8ec16966e933e3b29e5c75b4d59e3b23947b6a2e471a7619266d0f"],"source_ids":["src_a16a21d34cc45c8c87deb06b897fd624"],"text":"Skills live in .roo/skills/ or .agents/skills/ directories (global or project), support mode-specific variants like skills-code/, and follow an eight-level override priority where project beats global and .roo beats .agents.","updated_at":"2026-09-14T04:18:42Z","updated_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618"}
