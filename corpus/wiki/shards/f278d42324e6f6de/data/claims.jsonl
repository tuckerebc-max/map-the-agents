{"access":"public","created_at":"2026-09-14T04:18:42Z","created_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1d98e3d1b67a3ef5804a63eb48960974cff0d5ebfe18f7c9a8de7f2261b31f85","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"roocodeinc/roo-code-docs@a676c4173ae6 snapshot 4f3c03b6e158e322","timeframe":null},"slice_ids":["slc_04571d02ad7d924ed5e74d85bca21ee55d3bd275de9f3f30dd06b7b5708ebc3b","slc_dfdb2472f0d0086921e709fc8cd05d6c9233e67883489a972f79ad1f8eaa23b8"],"source_ids":["src_a5aba4cf58595aec81d0279a9b193de6"],"text":"Roo Code relies on external LLM inference providers such as Anthropic, OpenAI, OpenRouter, and Requesty, requiring users to obtain API keys; the Roo Code Router is offered as an alternative that needs no API key.","updated_at":"2026-09-14T04:18:42Z","updated_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618"}
{"access":"public","created_at":"2026-09-14T04:18:42Z","created_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_23f9032d6ebdc270b86603ebc8f35ef7352edf509ca9a8729da43edf4f2c0cea","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"roocodeinc/roo-code-docs@a676c4173ae6 snapshot 4f3c03b6e158e322","timeframe":null},"slice_ids":["slc_2884de23973b87c41af1bbb4bd098eac913a36876c7a90a58e5022eeecae401a","slc_855175d81cbce9af589517166cbb875a930b7254e88c5f97997d1ab8919d6e46","slc_8d8d5f455d3fadb97290b33b1be656cd62ce4c3ac456233075419a85b34c6d79"],"source_ids":["src_a5aba4cf58595aec81d0279a9b193de6"],"text":"Roo Code offers persona-based modes (Code, Architect, Ask, Debug) plus user-created Custom Modes, switchable via a dropdown or the '/' command.","updated_at":"2026-09-14T04:18:42Z","updated_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618"}
