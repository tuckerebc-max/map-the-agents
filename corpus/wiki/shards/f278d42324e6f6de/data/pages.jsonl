{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0524295c1dd07c641aa0e4d88b3a9d3b5304e7ecd293f6c855df15cfbe92fe3b"],"opposing_claim_ids":[],"text":"Skills are SKILL.md files with required name/description frontmatter that Roo loads on demand via progressive disclosure: metadata is indexed at startup, full instructions load only when a request matches, and bundled resources are discovered on demand."},{"claim_ids":["clm_a9959b9dccbda454e98007046a26f06f21fc3c0547c01735b36acf2481ac410d"],"opposing_claim_ids":[],"text":"Skills live in .roo/skills/ or .agents/skills/ directories (global or project), support mode-specific variants like skills-code/, and follow an eight-level override priority where project beats global and .roo beats .agents."}],"claim_ids":["clm_0524295c1dd07c641aa0e4d88b3a9d3b5304e7ecd293f6c855df15cfbe92fe3b","clm_a9959b9dccbda454e98007046a26f06f21fc3c0547c01735b36acf2481ac410d"],"created_at":"2026-09-14T04:18:42Z","created_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618","id":"pg_0ea65b29f93e57a58aede316b182d5e3","maturity":"draft","page_type":"source","path":"pages/sources/roocodeinc-roo-code-docs-docs-features-skills-mdx-a676c4173ae6-e316b182d5e3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a16a21d34cc45c8c87deb06b897fd624"],"title":"RooCodeInc/Roo-Code-Docs/docs/features/skills.mdx @ a676c4173ae6","updated_at":"2026-09-14T04:18:42Z","updated_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_88f02a9c01a30d417685a4af40bc2b966f6dec2ca5fccdfcb5959fde35836da0"],"opposing_claim_ids":[],"text":"The product ships in two forms: a VS Code Extension working locally in the IDE, and Roo Code Cloud Agents described as an autonomous AI development team reachable via channels like Slack and GitHub."},{"claim_ids":["clm_f84053df266c08c912ce3e7f0ba4d101fcd159e9c4c476ae4c54d7d01dc5dcea"],"opposing_claim_ids":[],"text":"The docs carry a prominent notice that all Roo Code products (Extension, Cloud, and Router) will be shut down on May 15, 2026, with refunds of unused balances and recommended alternatives."}],"claim_ids":["clm_88f02a9c01a30d417685a4af40bc2b966f6dec2ca5fccdfcb5959fde35836da0","clm_f84053df266c08c912ce3e7f0ba4d101fcd159e9c4c476ae4c54d7d01dc5dcea"],"created_at":"2026-09-14T04:18:42Z","created_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618","id":"pg_1d2d945c075558408d8856e247953698","maturity":"draft","page_type":"source","path":"pages/sources/roocodeinc-roo-code-docs-docs-index-mdx-a676c4173ae6-56e247953698.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_85baea03f02e58898f3c0faf8e775de3"],"title":"RooCodeInc/Roo-Code-Docs/docs/index.mdx @ a676c4173ae6","updated_at":"2026-09-14T04:18:42Z","updated_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:18:42Z","created_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618","id":"pg_58e4725acfad5edcbb1fe976d81c044b","maturity":"draft","page_type":"source","path":"pages/sources/roocodeinc-roo-code-docs-docs-sunset-md-a676c4173ae6-e976d81c044b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5fff13565d835ea980516726d822598a"],"title":"RooCodeInc/Roo-Code-Docs/docs/sunset.md @ a676c4173ae6","updated_at":"2026-09-14T04:18:42Z","updated_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_04b6e6bcbce6196afe2db6dc3c60e25934e6154c9f8ee9196c069db90c17b791"],"opposing_claim_ids":[],"text":"Roo Code can read/write project files, execute shell commands, browse the web if enabled, and use external tools via MCP; users are prompted to approve or reject each tool use, with optional auto-approval settings."},{"claim_ids":["clm_13349ec979372deeb9bdfd0a78f945550e3b6a4693b06120a5548c5a179d5569"],"opposing_claim_ids":[],"text":"Documented caveats include that Roo Code can make mistakes and changes should be reviewed, and that markdown write failures can occur when VS Code extensions or settings (e.g., format-on-save, markdown preview) interfere with file editing."},{"claim_ids":["clm_1ba5a56949fe34e5779ab36b91775b653cb9ce44b8bf69815ada8f2ae5013f83"],"opposing_claim_ids":[],"text":"Local model use is supported via Ollama and LM Studio, and the FAQ states offline use is possible when a local model is used."},{"claim_ids":["clm_1d98e3d1b67a3ef5804a63eb48960974cff0d5ebfe18f7c9a8de7f2261b31f85"],"opposing_claim_ids":[],"text":"Roo Code relies on external LLM inference providers such as Anthropic, OpenAI, OpenRouter, and Requesty, requiring users to obtain API keys; the Roo Code Router is offered as an alternative that needs no API key."},{"claim_ids":["clm_23f9032d6ebdc270b86603ebc8f35ef7352edf509ca9a8729da43edf4f2c0cea"],"opposing_claim_ids":[],"text":"Roo Code offers persona-based modes (Code, Architect, Ask, Debug) plus user-created Custom Modes, switchable via a dropdown or the '/' command."},{"claim_ids":["clm_a6ac58067ab16fa74de44a386f8ca07adb977585736be1dd6babf1ff6c85bd14"],"opposing_claim_ids":[],"text":"Roo Code is described as an AI-powered suite of coding products that uses large language models to understand user requests and translate them into actions."},{"claim_ids":["clm_ad76642e27e43a267cfe65564ead533f967bbc69e0ab7207c0e60dee7710baa0"],"opposing_claim_ids":[],"text":"Codebase Indexing builds a semantic search index of the project using AI embeddings, requiring an OpenAI API key for embeddings and a Qdrant vector database for storage; initial indexing is the most expensive step with cheaper incremental updates."},{"claim_ids":["clm_da81f65c1a1a6dc7e561d3af81a7b02a1e40ced407a8a35f5766a0f6b9cefaf7"],"opposing_claim_ids":[],"text":"The Extension exposes a chat panel (Kangaroo icon) where tasks are typed, supports '@' context mentions for files, folders, and problems, and offers error diagnostics export with basic and detailed options."}],"claim_ids":["clm_04b6e6bcbce6196afe2db6dc3c60e25934e6154c9f8ee9196c069db90c17b791","clm_13349ec979372deeb9bdfd0a78f945550e3b6a4693b06120a5548c5a179d5569","clm_1ba5a56949fe34e5779ab36b91775b653cb9ce44b8bf69815ada8f2ae5013f83","clm_1d98e3d1b67a3ef5804a63eb48960974cff0d5ebfe18f7c9a8de7f2261b31f85","clm_23f9032d6ebdc270b86603ebc8f35ef7352edf509ca9a8729da43edf4f2c0cea","clm_a6ac58067ab16fa74de44a386f8ca07adb977585736be1dd6babf1ff6c85bd14","clm_ad76642e27e43a267cfe65564ead533f967bbc69e0ab7207c0e60dee7710baa0","clm_da81f65c1a1a6dc7e561d3af81a7b02a1e40ced407a8a35f5766a0f6b9cefaf7"],"created_at":"2026-09-14T04:18:42Z","created_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618","id":"pg_67e72eb25999585e91e8e673e8199eef","maturity":"draft","page_type":"source","path":"pages/sources/roocodeinc-roo-code-docs-docs-faq-md-a676c4173ae6-e673e8199eef.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a5aba4cf58595aec81d0279a9b193de6"],"title":"RooCodeInc/Roo-Code-Docs/docs/faq.md @ a676c4173ae6","updated_at":"2026-09-14T04:18:42Z","updated_by_operation":"op_d9bd8697b22e41f181e4aca4856cc618"}
