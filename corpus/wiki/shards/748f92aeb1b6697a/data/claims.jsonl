{"access":"public","created_at":"2026-09-14T03:42:59Z","created_by_operation":"op_848f6724ed3746639a84ebea12a28c8a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e2f206886c7ab0b249b1bf934a69282191c031b65cf83a25a5b3ed78edf013ed","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"cpoile/claudemacs@1f2fe7bbc718 snapshot 21761bc18dec649d","timeframe":null},"slice_ids":["slc_10383525a74d03576fe14a40fd0737921ecba9407e3d9b8be78f65d7b294d61f","slc_8fc2316bf8bd95ca05e615dd096bee3e040d37872f1a79b99f57e6fb28f03f92"],"source_ids":["src_032a7bdd99d2580f8a51b80fe281bdd0"],"text":"Sessions can be resumed using tool-specific resume flags, and the resume submenu supports resuming a Codex session by UUID.","updated_at":"2026-09-14T03:42:59Z","updated_by_operation":"op_848f6724ed3746639a84ebea12a28c8a"}
