18fd","clm_70e6634cb4583ca020b9a5ffbe32929409d6431e540997ec6a1bc8bc483d079b","clm_7ae34aa3c592b144e7522469a29ee2ccd1ec4888ae939185cf8bff32600a937c","clm_863568697c6018c7031fe8170fda8ad8cc16ec2284e1235912a0cd1487fce507","clm_99ae4ebf9a0c929a178f2b2f2ec7bc5c3d90e96c7c94d0b7aedbee71df455c15","clm_a2b75a0e028c8e9f9f14e85445c1c8bf8269f291b6c5b0bc5a9af8127dd4a72d","clm_a87e4289fb44c49fd9feb8892a2c8f7a5123517cecd82802b2d23e074e6dfee9","clm_b016ef0a48afc385263a6b721486f701384c7e16606d662d3a5bb7e6acecc293","clm_b6c32da7e15bddec977fc3a7741224fbfd94c968c01b9526dd2145d39c19ee2f","clm_f224932fef0a847358ad28ff5b2ab417f26566b29c17c686ca2539a8541e2708","clm_f5b1127ab69be0b28108aab81240fb1b93d4b9994be2eab2961f9e7d421f4238"],"created_at":"2026-09-14T01:51:09Z","created_by_operation":"op_4cbdd047c3d84f04af7844b2bfb5955b","id":"pg_c8fbb9fc6fd956e8bb8d32abe86cd439","maturity":"draft","page_type":"entity","path":"pages/entities/gi-dellav-zerostack-32abe86cd439.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"gi-dellav/zerostack","updated_at":"2026-09-14T01:51:09Z","updated_by_operation":"op_4cbdd047c3d84f04af7844b2bfb5955b"}
