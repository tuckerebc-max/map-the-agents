e42cb2f02","clm_b76aa0aae8156d0a5b9ddf1a202b2192834f734a633e1001149ec94f2d921dfe","clm_d790359331b940c57cec521de6257da3d43a38b8feff8d4d171fe6f4e74db636","clm_ed4818d03f7661d2cfd36990f33326d945a6494211b133a47371424f74092505","clm_f0cffae3b4741825d2b7ae4b0ab69b235baf9102e1c5a22e4a31b1983a24692e"],"created_at":"2026-09-14T03:40:39Z","created_by_operation":"op_bd05abd910b94a1daac291222a892953","id":"pg_9280ef56849a5f38a0efb6ef92d7e273","maturity":"draft","page_type":"entity","path":"pages/entities/catatafishen-agentbridge-b6ef92d7e273.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"catatafishen/agentbridge","updated_at":"2026-09-14T03:40:39Z","updated_by_operation":"op_bd05abd910b94a1daac291222a892953"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_67a1bf0556e9e36bd2a6326ed8f753243c91478c542bafe7076ac745e34a7b72"],"opposing_claim_ids":[],"text":"The plugin supports nine agents (Copilot, Claude Code, Codex, Kiro, Junie, OpenCode, Hermes Agent, Mistral Vibe, Goose) switchable with one click, each with its own connection settings, tool permissions, and custom instructions."},{"claim_ids":["clm_b2c9f88286e0deded5400c6cd97b75690e3b0527d5808ef103269b8ee36a9be0"],"opposing_claim_ids":[],"text":"Repository development practice: the maintainer reviews agent-authored changes mostly alone and seeks collaborators, believing important agent-made changes should get at least two pairs of human eyes."},{"claim_ids":["clm_ed4818d03f7661d2cfd36990f33326d945a6494211b133a47371424f74092505"],"opposing_claim_ids":[],"text":"AgentBridge is a JetBrains IDE plugin that bridges AI coding agents to IntelliJ platform APIs through 120+ native MCP tools, letting agents use inspections, refactorings, test runner, build system, and Git."}],"claim_ids":["clm_67a1bf0556e9e36bd2a6326ed8f753243c91478c542bafe7076ac745e34a7b72","clm_b2c9f88286e0deded5400c6cd97b75690e3b0527d5808ef103269b8ee36a9be0","clm_ed4818d03f7661d2cfd36990f33326d945a6494211b133a47371424f74092505"],"created_at":"2026-09-14T03:40:39Z","created_by_operation":"op_bd05abd910b94a1daac291222a892953","id":"pg_f851379a40c25d80b647df5952b4d6f3","maturity":"draft","page_type":"source","path":"pages/sources/catatafishen-agentbridge-readme-md-124f7c082dc3-df5952b4d6f3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ecdb65c3133256878bccd2456c14aa13"],"title":"catatafishen/agentbridge/README.md @ 124f7c082dc3","updated_at":"2026-09-14T03:40:39Z","updated_by_operation":"op_bd05abd910b94a1daac291222a892953"}
