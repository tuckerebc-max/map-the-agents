{"access":"public","created_at":"2026-09-14T03:18:48Z","created_by_operation":"op_fe67ff362da241e4b538cff44e8b9e4d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6b20478958cbac6a64123f694941feb0ae6c6d60d7ad23f2f7cbdb56f493dd65","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"team-openpm/workgpt@f737a092dd4d snapshot 0760abb7ff749389","timeframe":null},"slice_ids":["slc_3b85f35bdcad8b37c1ac0bda2a2ca6d87cab7843b861f7cb38848d6b2e12e0cc","slc_73ba7f92e6571db9bc14c8fefa874506eb0816138d98a27ec70bdd948e096bf4","slc_dda503c320df729523a80c3a6e0a31af5071f68daef5739c8cac9f06bea108ff"],"source_ids":["src_b63af54be75d51b4be0029a3865e0e57"],"text":"Example directives include web research, website crawling, IP-to-city lookup with population, and ordering an Uber, indicating general tool-using agent use cases.","updated_at":"2026-09-14T03:18:48Z","updated_by_operation":"op_fe67ff362da241e4b538cff44e8b9e4d"}
{"access":"public","created_at":"2026-09-14T03:18:48Z","created_by_operation":"op_fe67ff362da241e4b538cff44e8b9e4d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_708593d061537a4c5799fdde6bfd2ee8e423e68d8b4d53780a7098919bbf494a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"team-openpm/workgpt@f737a092dd4d snapshot 0760abb7ff749389","timeframe":null},"slice_ids":["slc_6ced65643894e593d1a1c7c042b4ec91e0776c59ec28ace273b28b1d39a29856"],"source_ids":["src_b63af54be75d51b4be0029a3865e0e57"],"text":"API endpoints are exposed to the LLM as local functions ready to be invoked; users pass an authKey and the library handles authorization.","updated_at":"2026-09-14T03:18:48Z","updated_by_operation":"op_fe67ff362da241e4b538cff44e8b9e4d"}
{"access":"public","created_at":"2026-09-14T03:18:48Z","created_by_operation":"op_fe67ff362da241e4b538cff44e8b9e4d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bdc8e258a1e1b91209d895ad08682b0a274abc76653bebe02f9931a652ed21af","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"team-openpm/workgpt@f737a092dd4d snapshot 0760abb7ff749389","timeframe":null},"slice_ids":["slc_dc9eed40240b47e1e72f641a6d30e5315738fcc0738c3d1e356f2a3727d1a24b"],"source_ids":["src_b63af54be75d51b4be0029a3865e0e57"],"text":"WorkGPT is described as an agent framework, similar to AutoGPT or LangChain, that converses with the AI back and forth until a given directive is complete.","updated_at":"2026-09-14T03:18:48Z","updated_by_operation":"op_fe67ff362da241e4b538cff44e8b9e4d"}
