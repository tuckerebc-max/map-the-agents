735","maturity":"draft","page_type":"entity","path":"pages/entities/team-openpm-workgpt-8f106d75c735.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"team-openpm/workgpt","updated_at":"2026-09-14T03:18:48Z","updated_by_operation":"op_fe67ff362da241e4b538cff44e8b9e4d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2f8232385e103529ca9759e41ebcb84a2c732f90b7cf2e30f24cc17b0de31a4f"],"opposing_claim_ids":[],"text":"Distributed as the npm package 'workgpt', installable via npm install; the crawling example depends on Puppeteer for web access."},{"claim_ids":["clm_60b7484d262b453fb47a0c9c05559c73635b51c6de79b5f6b9a19529acd532d1"],"opposing_claim_ids":[],"text":"Programmatic usage centers on a WorkGptRunner constructed with an agent and an array of APIs, driven via runWithDirective(directive) which returns a result."},{"claim_ids":["clm_65d216110451a12be851558558316afc32a717b583198394d96941eb19bfdd4b"],"opposing_claim_ids":[],"text":"Any API representable as an OpenAPI file is supported; OpenPM, a package manager for OpenAPI files, can supply packages such as ipinfo by package id."},{"claim_ids":["clm_694d209397e715cbae3bf609dba8020759b200fc88aed292d2dfb1ec015b2a40"],"opposing_claim_ids":[],"text":"Custom APIs can act as finishing programs: invokable methods with a zod schema (e.g. onFinish) let the LLM return structured data and halt the program."},{"claim_ids":["clm_6b20478958cbac6a64123f694941feb0ae6c6d60d7ad23f2f7cbdb56f493dd65"],"opposing_claim_ids":[],"text":"Example directives include web research, website crawling, IP-to-city lookup with population, and ordering an Uber, indicating general tool-using agent use cases."},{"claim_ids":["clm_708593d061537a4c5799fdde6bfd2ee8e423e68d8b4d53780a7098919bbf494a"],"opposing_claim_ids":[],"text":"API endpoints are exposed to the LLM as local functions ready to be invoked; users pass an authKey and the library handles authorization."},{"claim_ids":["clm_bdc8e258a1e1b91209d895ad08682b0a274abc76653bebe02f9931a652ed21af"],"opposing_claim_ids":[],"text":"WorkGPT is described as an agent framework, similar to AutoGPT or LangChain, that converses with the AI back and forth until a given directive is complete."},{"claim_ids":["clm_c3485812617890c43d4f864649c5499c88020b2493537ae0cff70a282336642d"],"opposing_claim_ids":[],"text":"The framework appears to rely on OpenAI function-calling-style models, since examples use gpt-4-0613 and expose endpoints as invokable functions to the LLM."},{"claim_ids":["clm_c8626990e136e33afafb19e68a4ea10c841f09ec2e71da42d9b76e39a613ace2"],"opposing_claim_ids":[],"text":"The text-based browser returns only text rather than HTML; the README notes this is nonetheless sufficient for GPT-4 to extract data."},{"claim_ids":["clm_cae8afde4545eb0b2a377870e99af64bfbefb1ac21b030c0c6aa9f78e50a97d3"],"opposing_claim_ids":[],"text":"Ships with built-in API components including Calculator, FactApi, OpenpmApi, and a TextBrowser that uses Puppeteer as a text-based browser returning plain text instead of HTML."},{"claim_ids":["clm_cdd991253786272893af6bb69cf7c7427ac1847b7cfa5571ac249e2dbc712384"],"opposing_claim_ids":[],"text":"Includes an OpenAiAgent chat agent configurable with verbose, temperature, and model options, with gpt-4-0613 shown in examples."},{"claim_ids":["clm_e317f61e2b2a835e16933736553708c7018640a57ed368078bbe025cc438e7dc"],"opposing_claim_ids":[],"text":"Repository is MIT licensed."}],"claim_ids":["clm_2f8232385e103529ca9759e41ebcb84a2c732f90b7cf2e30f24cc17b0de31a4f","clm_60b7484d262b453fb47a0c9c05559c73635b51c6de79b5f6b9a19529acd532d1","clm_65d216110451a12be851558558316afc32a717b583198394d96941eb19bfdd4b","clm_694d209397e715cbae3bf609dba8020759b200fc88aed292d2dfb1ec015b2a40","clm_6b20478958cbac6a64123f694941feb0ae6c6d60d7ad23f2f7cbdb56f493dd65","clm_708593d061537a4c5799fdde6bfd2ee8e423e68d8b4d53780a7098919bbf494a","clm_bdc8e258a1e1b91209d895ad08682b0a274abc76653bebe02f9931a652ed21af","clm_c3485812617890c43d4f864649c5499c88020b2493537ae0cff70a282336642d","clm_c8626990e136e33afafb19e68a4ea10c841f09ec2e71da42d9b76e39a613ace2","clm_cae8afde4545eb0b2a377870e99af64bfbefb1ac21b030c0c6aa9f78e50a97d3","clm_cdd991253786272893af6bb69cf7c7427ac1847b7cfa5571ac249e2dbc712384","clm_e317f61e2b2a835e16933736553708c7018640a57ed3