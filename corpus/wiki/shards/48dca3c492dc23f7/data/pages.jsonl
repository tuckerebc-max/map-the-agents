{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_427c6c730d5ea8bb88b4a2300d9768e6d9d679c14d08bafdd006a85b8b7fa328"],"opposing_claim_ids":[],"text":"The changelog notes the auto-updater was removed because Alfred 5 handles future updates, and the old 'ca' configuration keyword was removed."},{"claim_ids":["clm_42f12d303d64f98d69d2e374aed1ce933ea6abf566e03c1b661f1cb729069391"],"opposing_claim_ids":[],"text":"Currency conversion is prioritized over cryptocurrency when codes collide (e.g. GBP), apparently because many cryptocurrencies share codes with fiat currencies; this is configurable."},{"claim_ids":["clm_a8119107a012c53f9622d00532fbb88a47e726e5ae671ee1b5a0cb6a5cd2a20a"],"opposing_claim_ids":[],"text":"The workflow caches currency and cryptocurrency rates; users can clear the cache by typing '_caclear' in Alfred, and a workflow variable can define the currencies cache duration."}],"claim_ids":["clm_427c6c730d5ea8bb88b4a2300d9768e6d9d679c14d08bafdd006a85b8b7fa328","clm_42f12d303d64f98d69d2e374aed1ce933ea6abf566e03c1b661f1cb729069391","clm_a8119107a012c53f9622d00532fbb88a47e726e5ae671ee1b5a0cb6a5cd2a20a"],"created_at":"2026-09-14T03:38:43Z","created_by_operation":"op_d1eb99be47224020aecb8274fbeb6bd3","id":"pg_4195a82d95f55bb9985aeb722f35730e","maturity":"draft","page_type":"source","path":"pages/sources/biati-digital-alfred-calculate-anything-changelog-md-fb98d4a78069-eb722f35730e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a51ffe49085b5b209e105a33c57d82d6"],"title":"biati-digital/alfred-calculate-anything/CHANGELOG.md @ fb98d4a78069","updated_at":"2026-09-14T03:38:43Z","updated_by_operation":"op_d1eb99be47224020aecb8274fbeb6bd3"}
