{"access":"public","created_at":"2026-09-14T02:40:11Z","created_by_operation":"op_300325db995647a2b983cdb81a020b6b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ecaa41cd141de451dc72c16f4ca94312bbdb29e0e16e2a60f65b482eddce663b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"shyamsaktawat/openalpha_evolve@0389aea0e0a7 snapshot d4155f4b317d4239","timeframe":null},"slice_ids":["slc_7a2a024a1bbb8e4bf288841a287e68cd828b854d316b8973ae3d1fea31d288ec"],"source_ids":["src_db862ace9ca35dd5b26d6662abfe9500"],"text":"A Gradio web interface is started with 'python app.py'; it displays a local URL (e.g., http://127.0.0.1:7860) and optionally a public share link, where users can define custom tasks and run evolution interactively.","updated_at":"2026-09-14T02:40:11Z","updated_by_operation":"op_300325db995647a2b983cdb81a020b6b"}
