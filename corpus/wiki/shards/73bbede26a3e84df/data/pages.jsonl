{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_503306901b35a8598a94df709e1e6288825301dbdaea52abc3fb6e6b58447d39"],"opposing_claim_ids":[],"text":"The project is licensed under Apache License 2.0, copyright 2023 Ant Group, with the standard AS-IS warranty disclaimer."}],"claim_ids":["clm_503306901b35a8598a94df709e1e6288825301dbdaea52abc3fb6e6b58447d39"],"created_at":"2026-09-14T01:42:50Z","created_by_operation":"op_1a03608ab47a41ab82941e12442bf33f","id":"pg_07fa09036d785b14a3eb307dab23d7cd","maturity":"draft","page_type":"source","path":"pages/sources/codefuse-ai-codefuse-muagent-license-md-ebc8c3fbc886-307dab23d7cd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d38c4544481e5ff9bf64af7f007af7a5"],"title":"codefuse-ai/CodeFuse-muAgent/LICENSE.md @ ebc8c3fbc886","updated_at":"2026-09-14T01:42:50Z","updated_by_operation":"op_1a03608ab47a41ab82941e12442bf33f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0957292716fbfa0ed79f9df4a5384a34861addb1603ce3c3d9353ac9adf2ff83"],"opposing_claim_ids":[],"text":"The KG schema includes Intention Nodes, Workflow Nodes, Tool Nodes, and Character Nodes; Tool Nodes aim to improve tool selection and parameter filling, and Character Nodes support human-involved processes."},{"claim_ids":["clm_0c88f05352da0628a8535e95eb6b0ff4a79e2a7ef7ecfb951825ef8b1d555a59"],"opposing_claim_ids":[],"text":"Users orchestrate agents through canvas-based drag-and-drop and simple text writing, with the LLM executing complex SOPs under human guidance."},{"claim_ids":["clm_14620e2545345a189f364c4f3533eccb205e8397bda40d9ed5588dd97d8ed7e7"],"opposing_claim_ids":[],"text":"Prebuilt muAgent-related Docker images (beta) are available at the codefuse-ai/packages GitHub org, downloadable via a provided docker_pull_images.sh script."},{"claim_ids":["clm_4ed11632c1dc349169eff0848063d0b639e469a4f5c2f7ba29f606cf53f58311"],"opposing_claim_ids":[],"text":"An SDK is published as the pip package codefuse-muagent; muAgent-sdk v0.1.0 shipped with muAgent v2.2 and supports ekg-sdk with parallel EKG execution."},{"claim_ids":["clm_5f4a08398c60c983cdfe1f5ef7ecb5d483caf7002c45cafebbd255fd38e7c70a"],"opposing_claim_ids":[],"text":"muAgent is described as an agent framework driven by LLM and an Eventic Knowledge Graph (EKG), combining MultiAgent, FunctionCall, and CodeInterpreter techniques."},{"claim_ids":["clm_86380261be28427864dcfead536753d3f9681a021ce37bfb6223d73418c92a26"],"opposing_claim_ids":[],"text":"Advertised feature areas include an EKG Builder with intelligent parsing and one-click import of documents, EKG Reasoning under human guidance, and a Diagnose mode with visual debugging and end-to-end monitoring."},{"claim_ids":["clm_8c8ab0c9e300d9e9bee06e9c3231f2fd7e26459c10d13e39c4807fab79279994"],"opposing_claim_ids":[],"text":"The framework advertises four core differentiating capabilities: Complex Reasoning, Online Collaboration, Human Interaction, and Knowledge On-demand."},{"claim_ids":["clm_e07466a51a794676dddf1105fcc23c890c309e9fff8b42b86495d68c9490eb3d"],"opposing_claim_ids":[],"text":"Repository development practice: the quickstart deploys EKG services by cloning the repo, creating a docker network named ekg-net, and running docker compose up -d, then opening localhost:8000."},{"claim_ids":["clm_e69eb5138cbcd5ed9570d3ef0e7d885a9f89f5273f2e780e65338f03bcba56db"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are invited to give feedback via GitHub Issues and can contribute through code implementation, test development, and documentation, per an external Contribution Guide."}],"claim_ids":["clm_0957292716fbfa0ed79f9df4a5384a34861addb1603ce3c3d9353ac9adf2ff83","clm_0c88f05352da0628a8535e95eb6b0ff4a79e2a7ef7ecfb951825ef8b1d555a59","clm_14620e2545345a189f364c4f3533eccb205e8397bda40d9ed5588dd97d8ed7e7","clm_4ed11632c1dc349169eff0848063d0b639e469a4f5c2f7ba29f606cf53f58311","clm_5f4a08398c60c983cdfe1f5ef7ecb5d483caf7002c45cafebbd255fd38e7c70a","clm_86380261be28427864dcfead536753d3f9681a021ce37bfb6223d73418c92a26","clm_8c8ab0c9e300d9e9bee06e9c3231f2fd7e26459c10d13e39c4807fab79279994","clm_e07466a51a794676dddf1105fcc23c890c309e9fff8b42b86495d68c9490eb3d","clm_e69eb5138cbcd5ed9570d3ef0e7d885a9f89f5273f2e780e65338f03bcba56db"],"created_at":"2026-09-14T01:42:50Z","created_by_operation":"op_1a03608ab47a41ab82941e12442bf33f","id":"pg_33211fdcecd750d4bc734c1236ad539a","maturity":"draft","page_type":"source","path":"pages/sources/codefuse-ai-codefuse-muagent-readme-md-ebc8c3fbc886-4c1236ad539a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_84b66dbfff9e5327894948a06a7688e3"],"title":"codefuse-ai/CodeFuse-muAgent/README.md @ ebc8c3fbc886","updated_at":"2026-09-14T01:42:50Z","updated_by_operation":"op_1a03608ab47a41ab82941e12442bf33f"}
