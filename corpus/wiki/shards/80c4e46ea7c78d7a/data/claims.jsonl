{"access":"public","created_at":"2026-09-14T03:45:14Z","created_by_operation":"op_50c8770a686640e79add623b94cd4b1d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_700e3a0317cf2eea3354b15d1e279f02d4def9f0809c1ce55f501d87a1b0beea","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"denchhq/denchclaw@f14eb4c23900 snapshot 3670cd3429a5893a","timeframe":null},"slice_ids":["slc_3f423db6c3a8a9999474f5a8bea60ddab3b1e90eb8675e7049d3a9615f4835f9","slc_7de42a49a067d5ff6bf012c32f703a5f36096ac338008f338474e35b2f80030d","slc_8b843d35a257705b8a26a48b2c05eab0397df27e575eb15941e58a68c1462a6e","slc_c5c4882d6fac432ca432323dde002ea8446a6758e47db087fcdbf0a9a6b088be"],"source_ids":["src_77054f8dd98358f0b345a3121ec80258"],"text":"Gateway connections use device pairing: a 'pairing required' error means the local device awaits approval, and pending operator requests can be listed and approved via 'openclaw --profile dench devices list/approve'.","updated_at":"2026-09-14T03:45:14Z","updated_by_operation":"op_50c8770a686640e79add623b94cd4b1d"}
