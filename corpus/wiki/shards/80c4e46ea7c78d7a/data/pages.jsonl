6","maturity":"draft","page_type":"entity","path":"pages/entities/denchhq-denchclaw-ea7a351ef566.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"denchhq/denchclaw","updated_at":"2026-09-14T03:45:14Z","updated_by_operation":"op_50c8770a686640e79add623b94cd4b1d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_896710952dbd1f408ea93c33d3dbeed041c1edc1d3fb2ab2b4048a7c1a8486c6"],"opposing_claim_ids":[],"text":"Repository development practice: releases are driven by package.json; pushing a version bump to main triggers .github/workflows/release.yml, which runs deploy.sh checks in validation mode before publishing to npm and creating a GitHub release, with reruns safe via existence checks."}],"claim_ids":["clm_896710952dbd1f408ea93c33d3dbeed041c1edc1d3fb2ab2b4048a7c1a8486c6"],"created_at":"2026-09-14T03:45:14Z","created_by_operation":"op_50c8770a686640e79add623b94cd4b1d","id":"pg_4b40db6b21af51768bfa742441fb775f","maturity":"draft","page_type":"source","path":"pages/sources/denchhq-denchclaw-releasing-md-f14eb4c23900-742441fb775f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_af66fbb4b9c55d1e9f16f9dd1edea689"],"title":"DenchHQ/DenchClaw/RELEASING.md @ f14eb4c23900","updated_at":"2026-09-14T03:45:14Z","updated_by_operation":"op_50c8770a686640e79add623b94cd4b1d"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:45:14Z","created_by_operation":"op_50c8770a686640e79add623b94cd4b1d","id":"pg_4fdadfae50a45afba03d5bb23dd8b2f3","maturity":"draft","page_type":"source","path":"pages/sources/denchhq-denchclaw-todo-md-f14eb4c23900-5bb23dd8b2f3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a10af89eee555bffafff609daa9f817b"],"title":"DenchHQ/DenchClaw/todo.md @ f14eb4c23900","updated_at":"2026-09-14T03:45:14Z","updated_by_operation":"op_50c8770a686640e79add623b94cd4b1d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0a61ac4fd5959db8953d87a72b62191a05797638e9580d37f011349b807edcf7"],"opposing_claim_ids":[],"text":"DenchClaw provides an npm CLI with subcommands bootstrap, update, restart, start, and stop for onboarding and managing the web server."},{"claim_ids":["clm_643d7ce14e79a30fc5872f000ae54ca7a5934973096b5084f885848b1949bb1a"],"opposing_claim_ids":[],"text":"Setting DENCHCLAW_DAEMONLESS=1 skips all gateway daemon management and launchd installation across commands, for Docker or environments without systemd/launchd; the gateway must then be run as a foreground process."},{"claim_ids":["clm_6cffd5f5b16d9fca6b952b7dc1d8f69f46eec0cca6f17a4610f0e06dd89d15ad"],"opposing_claim_ids":[],"text":"After onboarding, the web UI is served at localhost:3100 by default."},{"claim_ids":["clm_700e3a0317cf2eea3354b15d1e279f02d4def9f0809c1ce55f501d87a1b0beea"],"opposing_claim_ids":[],"text":"Gateway connections use device pairing: a 'pairing required' error means the local device awaits approval, and pending operator requests can be listed and approved via 'openclaw --profile dench devices list/approve'."},{"claim_ids":["clm_ab05579102803d9f7115c940f0be3d366375581dff984005ea1497272ac54582"],"opposing_claim_ids":[],"text":"OpenClaw commands for DenchClaw must be prefixed with 'openclaw --profile dench', e.g. gateway restart or config set gateway.port 19001."},{"claim_ids":["clm_b87f23ed0415829893b9b14b2c15b8921f6d1d9f40dd229c89b2490fc25b906a"],"opposing_claim_ids":[],"text":"Bootstrap creates a dedicated OpenClaw gateway under ~/.openclaw-dench on port 19001, separate from a usual ~/.openclaw gateway, with config in ~/.openclaw-dench/openclaw.json."},{"claim_ids":["clm_bde32b3a9aaa60757e366a3e61713dc84d13ef0bcb178e999f0ecf84c70bcac0"],"opposing_claim_ids":[],"text":"Repository development practice: local development uses pnpm (pnpm install, pnpm build, pnpm dev, and pnpm web:dev for Web UI development)."},{"claim_ids":["clm_f464192fdd2dd52c7873dbec40e325cf7e615e6181e1c3390fccc37cb86b6555"],"opposing_claim_ids":[],"text":"Manual install requires Node 22+ and is run via 'npx denchclaw@latest bootstrap'; the product is built on OpenClaw and must be kept up to date with it."}],"claim_ids":["clm_0a61ac4fd5959db8953d87a72b62191a05797638e9580d37f011349b807edcf7","clm_643d7ce14e79a30fc5872f000ae54ca7a5934973096b5084f885848b1949bb1a","clm_6cffd5f5b16d9fca6b952b7dc1d8f69f46eec0cca6f17a4610f0e06dd89d15ad","clm_700e3a0317cf2eea3354b15d1e279f02d4def9f0809c1ce55f501d87a1b0beea","clm_ab05579102803d9f7115c940f0be3d366375581dff984005ea1497272ac54582","clm_b87f23ed0415829893b9b14b2c15b8921f6d1d9f40dd229c89b2490fc25b906a","clm_bde32b3a9aaa60757e366a3e61713dc84d13ef0bcb178e999f0ecf84c70bcac0","clm_f464192fdd2dd52c7873dbec40e325cf7e615e6181e1c3390fccc37cb86b6555"],"created_at":"2026-09-14T03:45:14Z","created_by_operation":"op_50c8770a686640e79add623b94cd4b1d","id":"pg_b3251bdbcd695fc99841c4c469334e80","maturity":"draft","page_type":"source","path":"pages/sources/denchhq-denchclaw-readme-md-f14eb4c23900-c4c469334e80.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_77054f8dd98358f0b345a3121ec80258"],"title":"DenchHQ/DenchClaw/README.md @ f14eb4c23900","updated_at":"2026-09-14T03:45:14Z","updated_by_operation":"op_50c8770a686640e79add623b94cd4b1d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_04b81301411a384071e95bf4e09b85c2e19f15bbe1fcacba99ca0cc60ab7c5bc"],"opposing_claim_ids":[],"text":"Telemetry is anonymous and optional, split into product telemetry (CLI/web usage events) and AI observability via a PostHog LLM analytics plugin; both share opt-out controls and privacy mode, which is on by default and redacts message content and tool parameters."},{"claim_ids":["clm_20d4974bb838a9ec25213f07d71eadb0e0c77a82771be3245b92f7ae9b9b0220"],"opposing_claim_ids":[],"text":"The posthog-analytics OpenClaw plugin runs in-process with the gateway, hooks agent lifecycle events (e.g. before_model_resolve, before_tool_call, agent_end), and emits PostHog AI events; it is installed automatically during bootstrap when a PostHog project key is available."},{"claim_ids":["clm_f957eaee971edd9c099b2cf40e25160ef50c16e6e4ebf5a28b954df2960ee995"],"opposing_claim_ids":[],"text":"PostHog Evaluations can score captured $ai_generation events using LLM-as-a-judge or deterministic Hog-based checks, storing pass/fail results with reasoning, configured entirely in the PostHog dashboard."}],"claim_ids":["clm_04b81301411a384071e95bf4e09b85c2e19f15bbe1fcacba99ca0cc60ab7c5bc","clm_20d4974bb838a9ec25213f07d71eadb0e0c77a82771be3245b92f7ae9b9b0220","clm_f957eaee971edd9c099b2cf40e25160ef50c16e6e4ebf5a28b954df2960ee995"],"created_at":"2026-09-14T03:45:14Z","created_by_operation":"op_50c8770a686640e79add623b94cd4b1d","id":"pg_d5e4baab738d594aa270ef0a5d396fe3","maturity":"draft","page_type":"source","path":"pages/sources/denchhq-denchclaw-telemetry-md-f14eb4c23900-ef0a5d396fe3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_abc60c6bc26154ee94e014267e92efd8"],"title":"DenchHQ/DenchClaw/TELEMETRY.md @ f14eb4c23900","updated_at":"2026-09-14T03:45:14Z","updated_by_operation":"op_50c8770a686640e79add623b94cd4b1d"}
