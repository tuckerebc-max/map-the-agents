6376569049","clm_49283325dde0ef9b2855f4e8d28c1ee9f2e4f8de53273c89474436b3984c4dca","clm_4e4d1d0f957eabf056848f842ee69da2d9a1060de36538c50b9379a62b37c164","clm_53d48f2581e309b150970a6e2ae6a2b9a4c64cfddc8c3acaf2d93c273d0cc84a","clm_58069c3585076b2b2d16173260158378e67d1a445e64939f04dac93538e92d0d","clm_5c6b83246d050c5a920f328a5e560024391d0bf578276efe022c78151e4d191e","clm_8f7c14c99f4f427934720a2d66c6a69b3d3b1dc9f6878121068a9ad5b7f3b6d0","clm_9bba2c9d7fbacad909f4c7adea10fc9cb6e0c9dc690ad9484c53a06d4ab0b505","clm_bcaa4dd7944a227363f2f5b75e98e84d92c9f50f8b84ff41ee7bdb5f209112e4","clm_bcffd2f1369425f3d43da287d372c0c299c641b3f439ce02cf5f2a0415e23d13","clm_c1250660aa7f98281ad294ecb84885b03eece47645ec19e5fdff809bb4499d82","clm_cc6f81e534358cc1add6c2cfaba0c304997b1d8654e23a187fac6f7e41eb3612","clm_d6e51bd0e157050c65bac269326ace240333014f81612bda305d3a63d2e4461d","clm_dbf5003be61d4eb18234969493881dc5e366c687a57e421a870f21f14719789a","clm_dc297a72bf081d7431be1cf606dbf20e3aa81f9aca554cea28643cd311290f09","clm_dd1571767c47fb08c21ec0b4c007f6a644525053b30c9e4e428bc7c5a24118c4","clm_dd26149171401eb9d477820d0a500ae91440461cb0627f210095ffea76fef8f2","clm_df94f3c9cc1b97bc1ae558e66262dfab16bb3bf7cb5251c037875bdd52f5f621","clm_fe481f51f9018c41875141329e76601e840885d80e441d8f5022c3529712ce9c"],"created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","id":"pg_1a353e874ac355daa943e73393ee20fa","maturity":"draft","page_type":"entity","path":"pages/entities/editor-code-assistant-eca-e73393ee20fa.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"editor-code-assistant/eca","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0eab46df40bddd7555e009676fe811f0cf24613ad4038b8be85e26296b909ab8"],"opposing_claim_ids":[],"text":"MCP servers are configured via an `mcpServers` key supporting stdio commands and HTTP (streamable or SSE) URLs, with OAuth discovery, static Authorization headers, and a `disabled` flag."},{"claim_ids":["clm_53d48f2581e309b150970a6e2ae6a2b9a4c64cfddc8c3acaf2d93c273d0cc84a"],"opposing_claim_ids":[],"text":"Custom tools are defined in config with a description, a command string containing {{argument_name}} placeholders replaced by LLM-supplied values, and a schema of parameters."},{"claim_ids":["clm_d6e51bd0e157050c65bac269326ace240333014f81612bda305d3a63d2e4461d"],"opposing_claim_ids":[],"text":"ECA supports three tool types: native tools (edit_file, write_file, read, etc.), configured MCP servers, and user-defined custom CLI tools."}],"claim_ids":["clm_0eab46df40bddd7555e009676fe811f0cf24613ad4038b8be85e26296b909ab8","clm_53d48f2581e309b150970a6e2ae6a2b9a4c64cfddc8c3acaf2d93c273d0cc84a","clm_d6e51bd0e157050c65bac269326ace240333014f81612bda305d3a63d2e4461d"],"created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","id":"pg_57226f27c6e152e0a9bed1eb72bb13c6","maturity":"draft","page_type":"source","path":"pages/sources/editor-code-assistant-eca-docs-config-tools-md-e30026331ad6-d1eb72bb13c6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b107abf72ecc5e23a4054c09d6ccef48"],"title":"editor-code-assistant/eca/docs/config/tools.md @ e30026331ad6","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_410b6a3eb93f3428668a9f23bf20cd1f32dd150b1e63ab94d2bb4fd93c567ecd"],"opposing_claim_ids":[],"text":"Per its privacy policy, ECA runs entirely locally with no hosted service, no accounts, no analytics or tracking, and ships with no MCP servers enabled by default."},{"claim_ids":["clm_49283325dde0ef9b2855f4e8d28c1ee9f2e4f8de53273c89474436b3984c4dca"],"opposing_claim_ids":[],"text":"Documented providers include Anthropic, OpenAI, GitHub Copilot, Google Gemini, Azure OpenAI, DeepSeek, OpenRouter, xAI, and locally running Ollama, plus custom providers."},{"claim_ids":["clm_bcffd2f1369425f3d43da287d372c0c299c641b3f439ce02cf5f2a0415e23d13"],"opposing_claim_ids":[],"text":"Locally, ECA stores config in ~/.config/eca/config.json, auth tokens in ~/.cache/eca/db.transit.json, and per-workspace conversation history plus truncated tool outputs auto-deleted after 7 days, respecting XDG paths."}],"claim_ids":["clm_410b6a3eb93f3428668a9f23bf20cd1f32dd150b1e63ab94d2bb4fd93c567ecd","clm_49283325dde0ef9b2855f4e8d28c1ee9f2e4f8de53273c89474436b3984c4dca","clm_bcffd2f1369425f3d43da287d372c0c299c641b3f439ce02cf5f2a0415e23d13"],"created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","id":"pg_6787b940d35a551cae9f6cdce8552b68","maturity":"draft","page_type":"source","path":"pages/sources/editor-code-assistant-eca-privacy-md-e30026331ad6-6cdce8552b68.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_584caea6a24d5407bb692358b5e4745f"],"title":"editor-code-assistant/eca/PRIVACY.md @ e30026331ad6","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_019a6d1b9241994c986dbbcc918fea4e0ec992c4ef898a4938edf78e9aafa185"],"opposing_claim_ids":[],"text":"Skills are SKILL.md folders following the agentskills standard, searched in ~/.config/eca/skills, .eca/skills, and .agents/skills; only name and description are sent to the LLM, which loads a skill via the `eca__skill` tool."},{"claim_ids":["clm_4e4d1d0f957eabf056848f842ee69da2d9a1060de36538c50b9379a62b37c164"],"opposing_claim_ids":[],"text":"Skills can be parameterized as slash commands using $ARGS, $ARGUMENTS, and positional variables; when arguments are given, ECA substitutes them into the skill body instead of using the eca__skill tool."},{"claim_ids":["clm_dd1571767c47fb08c21ec0b4c007f6a644525053b30c9e4e428bc7c5a24118c4"],"opposing_claim_ids":[],"text":"Tool-call approval is configurable globally or per agent with allow/deny rules and argsMatchers, e.g. denying `eca__skill` globally while allowing a specific skill name for one agent."}],"claim_ids":["clm_019a6d1b9241994c986dbbcc918fea4e0ec992c4ef898a4938edf78e9aafa185","clm_4e4d1d0f957eabf056848f842ee69da2d9a1060de36538c50b9379a62b37c164","clm_dd1571767c47fb08c21ec0b4c007f6a644525053b30c9e4e428bc7c5a24118c4"],"created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","id":"pg_68c0e4c5b305563db750d0b506b6dab3","maturity":"draft","page_type":"source","path":"pages/sources/editor-code-assistant-eca-docs-config-skills-md-e30026331ad6-d0b506b6dab3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d3c3442a2cb35f4b92143775a9f91ccb"],"title":"editor-code-assistant/eca/docs/config/skills.md @ e30026331ad6","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4241fbeac06d3e97c164183b8465546028cd82147fed26bbac5c926376569049"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are welcomed via issue discussion or pull request with developer details in the development docs, and new-editor integrations follow a UX-consistency checklist."},{"claim_ids":["clm_58069c3585076b2b2d16173260158378e67d1a445e64939f04dac93538e92d0d"],"opposing_claim_ids":[],"text":"The documented request flow is: client/editor → stdin JSON-RPC → handlers → features → llm_api → llm_provider, with results streamed back via messenger."},{"claim_ids":["clm_8f7c14c99f4f427934720a2d66c6a69b3d3b1dc9f6878121068a9ad5b7f3b6d0"],"opposing_claim_ids":[],"text":"No evidence in this snapshot describes benchmarks or success-rate evaluation of the agent; the only test-related material is the repository's own unit and integration test suites."},{"claim_ids":["clm_9bba2c9d7fbacad909f4c7adea10fc9cb6e0c9dc690ad9484c53a06d4ab0b505"],"opposing_claim_ids":[],"text":"Repository development practice: a local debug binary is built with `bb debug-cli` (requires babashka), and contributors can attach to the nREPL port printed on stderr to modify the running ECA process."},{"claim_ids":["clm_c1250660aa7f98281ad294ecb84885b03eece47645ec19e5fdff809bb4499d82"],"opposing_claim_ids":[],"text":"The project builds with Babashka tasks (bb.edn) and Clojure deps.edn including a native GraalVM image target; the server wires together via jsonrpc4clj."},{"claim_ids":["clm_cc6f81e534358cc1add6c2cfaba0c304997b1d8654e23a187fac6f7e41eb3612"],"opposing_claim_ids":[],"text":"The server is written in Clojure with a layered layout: handlers.clj receives all JSON-RPC requests, db.clj holds in-memory state, llm_api.clj is the LLM facade, and llm_providers/ holds vendor adapters."},{"claim_ids":["clm_dc297a72bf081d7431be1cf606dbf20e3aa81f9aca554cea28643cd311290f09"],"opposing_claim_ids":[],"text":"Configuration is centralized and resolved from multiple sources: global config, local config, environment variables, and initializationOptions."},{"claim_ids":["clm_dd26149171401eb9d477820d0a500ae91440461cb0627f210095ffea76fef8f2"],"opposing_claim_ids":[],"text":"The new-editor checklist documents protocol methods including initialize/initialized, exit/shutdown, chat/prompt, chat/contentReceived, chat/queryContext, chat/toolCallApprove/Reject, and chat/queryCommands."},{"claim_ids":["clm_df94f3c9cc1b97bc1ae558e66262dfab16bb3bf7cb5251c037875bdd52f5f621"],"opposing_claim_ids":[],"text":"All runtime state — sessions, chats, and tool servers — lives in an in-memory atom (`db*`) in db.clj."},{"claim_ids":["clm_fe481f51f9018c41875141329e76601e840885d80e441d8f5022c3529712ce9c"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run unit tests with `bb test` (CI runs the same task), single namespaces via kaocha focus, and integration tests with `bb integration-test`, which spawns the server over JSON-RPC with mocked LLM and MCP servers."}],"claim_ids":["clm_4241fbeac06d3e97c164183b8465546028cd82147fed26bbac5c926376569049","clm_58069c3585076b2b2d16173260158378e67d1a445e64939f04dac93538e92d0d","clm_8f7c14c99f4f427934720a2d66c6a69b3d3b1dc9f6878121068a9ad5b7f3b6d0","clm_9bba2c9d7fbacad909f4c7adea10fc9cb6e0c9dc690ad9484c53a06d4ab0b505","clm_c1250660aa7f98281ad294ecb84885b03eece47645ec19e5fdff809bb4499d82","clm_cc6f81e534358cc1add6c2cfaba0c304997b1d8654e23a187fac6f7e41eb3612","clm_dc297a72bf081d7431be1cf606dbf20e3aa81f9aca554cea28643cd311290f09","clm_dd26149171401eb9d477820d0a500ae91440461cb0627f210095ffea76fef8f2","clm_df94f3c9cc1b97bc1ae558e66262dfab16bb3bf7cb5251c037875bdd52f5f621","clm_fe481f51f9018c41875141329e76601e840885d80e441d8f5022c3529712ce9c"],"created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","id":"pg_810d9b7ea65f5ce9a01e267fe421fe86","maturity":"draft","page_type":"source","path":"pages/sources/editor-code-assistant-eca-docs-development-md-e30026331ad6-267fe421fe86.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e7a8321878f35a30854832ccae1a5175"],"title":"editor-code-assistant/eca/docs/development.md @ e30026331ad6","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
