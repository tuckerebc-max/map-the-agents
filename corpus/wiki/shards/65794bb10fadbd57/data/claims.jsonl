{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fe481f51f9018c41875141329e76601e840885d80e441d8f5022c3529712ce9c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_621ccd44e5351278313db91631f204c0ac3d0d9f1bbb336eff89b33660aca0e6","slc_6fb58a69cd780e1ecaea4cd9435340141ba42a0358cf3a4fe8b11030e4b5efc3","slc_9ffd09b52cd61f0ecef7b5b52105446ff2f41d002d5094357c79bffaf16bc404","slc_d89b4cf0cab6dedcc0c9cbb0221095f2f701bb6e2c7995a78d8e1e7b8cdec6a6"],"source_ids":["src_e7a8321878f35a30854832ccae1a5175"],"text":"Repository development practice: contributors run unit tests with `bb test` (CI runs the same task), single namespaces via kaocha focus, and integration tests with `bb integration-test`, which spawns the server over JSON-RPC with mocked LLM and MCP servers.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
