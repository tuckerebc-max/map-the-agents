{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_53d48f2581e309b150970a6e2ae6a2b9a4c64cfddc8c3acaf2d93c273d0cc84a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_1c01f72c80140e8b4b00ba754ada80b8582bed4eb7960d848d3dced8da9d140d","slc_66195aa742dc048f44c5e36a0f6613229a87b2fc46598cbc9d386a0ae2a34593","slc_7149e36362e430cc9ad732ed64fc0bb5ffa80c9d36d804c52de712e46a2ad90b","slc_cc44882ef72291edfb7991deb484f97f06ebe2a4baf4639ebb57dc6f94d46a2c"],"source_ids":["src_b107abf72ecc5e23a4054c09d6ccef48"],"text":"Custom tools are defined in config with a description, a command string containing {{argument_name}} placeholders replaced by LLM-supplied values, and a schema of parameters.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_58069c3585076b2b2d16173260158378e67d1a445e64939f04dac93538e92d0d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_d8775f9eba4657afca665824b4fc9f82d94233577d711b3e4b1c3f7b64a1f8c9"],"source_ids":["src_e7a8321878f35a30854832ccae1a5175"],"text":"The documented request flow is: client/editor → stdin JSON-RPC → handlers → features → llm_api → llm_provider, with results streamed back via messenger.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5c6b83246d050c5a920f328a5e560024391d0bf578276efe022c78151e4d191e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_a7c17e00168f032a0605156111b7ead1bfddc552bd400b84d0a45664b289c0df"],"source_ids":["src_458988914bc75d8787fca99800aeaaa1"],"text":"ECA supports configuring multiple agents/subagents, each with different models, tools, and behaviors.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.5,"id":"clm_8f7c14c99f4f427934720a2d66c6a69b3d3b1dc9f6878121068a9ad5b7f3b6d0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=inference; facet=evaluation","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_6fb58a69cd780e1ecaea4cd9435340141ba42a0358cf3a4fe8b11030e4b5efc3","slc_9ffd09b52cd61f0ecef7b5b52105446ff2f41d002d5094357c79bffaf16bc404"],"source_ids":["src_e7a8321878f35a30854832ccae1a5175"],"text":"No evidence in this snapshot describes benchmarks or success-rate evaluation of the agent; the only test-related material is the repository's own unit and integration test suites.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9bba2c9d7fbacad909f4c7adea10fc9cb6e0c9dc690ad9484c53a06d4ab0b505","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_162c32a932a1cdddb0bb0a42820186735930989318e31ccf56cba27eb8911652","slc_abf3ba1339cd52a947a12c122ac0bab41fe9de1c46e5a19e2314a546549ef92a"],"source_ids":["src_e7a8321878f35a30854832ccae1a5175"],"text":"Repository development practice: a local debug binary is built with `bb debug-cli` (requires babashka), and contributors can attach to the nREPL port printed on stderr to modify the running ECA process.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bcaa4dd7944a227363f2f5b75e98e84d92c9f50f8b84ff41ee7bdb5f209112e4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_ce95d79e60afa4f59219506f070ef5e401929bf5102ede93bef3f299249c9e54","slc_d6f1d8dd36f488e08b0c2cb33f934b34df0844b6dbbddebd74359d69f326df8c"],"source_ids":["src_458988914bc75d8787fca99800aeaaa1"],"text":"Editors spawn the server via `eca server` and communicate over stdin/stdout using a JSON-RPC protocol inspired by LSP, so any editor can integrate.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bcffd2f1369425f3d43da287d372c0c299c641b3f439ce02cf5f2a0415e23d13","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_4b205b5b3ed7834210090da7837601149cd274098ba406e0ff6381ddc36d6689","slc_d4542703c9a0b30eedfa9b14b7d2c0f37fdbdcda76ad3e53457f0068ed52bbc3"],"source_ids":["src_584caea6a24d5407bb692358b5e4745f"],"text":"Locally, ECA stores config in ~/.config/eca/config.json, auth tokens in ~/.cache/eca/db.transit.json, and per-workspace conversation history plus truncated tool outputs auto-deleted after 7 days, respecting XDG paths.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c1250660aa7f98281ad294ecb84885b03eece47645ec19e5fdff809bb4499d82","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_f9b64a00adb78f610ab798bea10149463e805bd3f8e029bd6a6a6cd5b9a84ab3"],"source_ids":["src_e7a8321878f35a30854832ccae1a5175"],"text":"The project builds with Babashka tasks (bb.edn) and Clojure deps.edn including a native GraalVM image target; the server wires together via jsonrpc4clj.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cc6f81e534358cc1add6c2cfaba0c304997b1d8654e23a187fac6f7e41eb3612","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_ce95d79e60afa4f59219506f070ef5e401929bf5102ede93bef3f299249c9e54","slc_f9b64a00adb78f610ab798bea10149463e805bd3f8e029bd6a6a6cd5b9a84ab3"],"source_ids":["src_458988914bc75d8787fca99800aeaaa1","src_e7a8321878f35a30854832ccae1a5175"],"text":"The server is written in Clojure with a layered layout: handlers.clj receives all JSON-RPC requests, db.clj holds in-memory state, llm_api.clj is the LLM facade, and llm_providers/ holds vendor adapters.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d6e51bd0e157050c65bac269326ace240333014f81612bda305d3a63d2e4461d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_0b2036b7716cdc296d5854b0ae373e31c8e2cad1936ff8013d870ac7151c46a4","slc_6f32e61ce331ad19f78196a1f90ed5ccb20ec456b57abd85f3c2c72d4e231c49"],"source_ids":["src_b107abf72ecc5e23a4054c09d6ccef48"],"text":"ECA supports three tool types: native tools (edit_file, write_file, read, etc.), configured MCP servers, and user-defined custom CLI tools.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
{"access":"public","created_at":"2026-09-14T01:47:30Z","created_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_dbf5003be61d4eb18234969493881dc5e366c687a57e421a870f21f14719789a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"editor-code-assistant/eca@e30026331ad6 snapshot 6543b15215023cac","timeframe":null},"slice_ids":["slc_a3e2d8c91239457ec92812a8956b6714801d8c07b177480fcc908101bd3f1380"],"source_ids":["src_458988914bc75d8787fca99800aeaaa1"],"text":"ECA places a server between editors and LLMs to centralize tool-call management, multi-LLM interaction, telemetry, and a single configuration shared across editors.","updated_at":"2026-09-14T01:47:30Z","updated_by_operation":"op_83736ac7b167414d88aa4f1f2c3981f7"}
