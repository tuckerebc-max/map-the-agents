{"access":"public","created_at":"2026-09-14T01:49:12Z","created_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_aa8798664e9e195f27cea640766fa7e619a757dad7fe42235c95e03d0625f5f7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"friuns2/codex-mobile@fac2291b0e60 snapshot 5767fa3cbc572be0","timeframe":null},"slice_ids":["slc_71dc60c1fdf98043485b28c18fa4dcd20ebf065a5e5753b66027e96d3e44bfe1"],"source_ids":["src_38e0cf7f05635b2bb0b2d4f393eab2db"],"text":"Repository development practice: changes should be tested before completion, manual test docs under tests/<domain>/ updated with setup/actions/expected results, and a CJS smoke test is required for package/runtime/module-loading changes.","updated_at":"2026-09-14T01:49:12Z","updated_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f"}
{"access":"public","created_at":"2026-09-14T01:49:12Z","created_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b556f44783ffe99aff84681d9ddca704c95bbf31d196f439f919cbfb842ad5a6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"friuns2/codex-mobile@fac2291b0e60 snapshot 5767fa3cbc572be0","timeframe":null},"slice_ids":["slc_e0c3538bf6da9ab28d53a1f904c5e3dfc38b7eda38186ccf034c305d2d577057"],"source_ids":["src_06aedf4fc60e5c8387bf02c22a84e954"],"text":"The bridge exposes HTTP endpoints including POST /codex-api/rpc (JSON-RPC proxy), server-request respond/pending endpoints, meta discovery endpoints, an SSE events stream, and a WebSocket upgrade at /codex-api/ws.","updated_at":"2026-09-14T01:49:12Z","updated_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f"}
{"access":"public","created_at":"2026-09-14T01:49:12Z","created_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b90a2a4aaa97fdba245a3e057ecc7ff8175f55f0987288c3b90ac15b6759a438","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"friuns2/codex-mobile@fac2291b0e60 snapshot 5767fa3cbc572be0","timeframe":null},"slice_ids":["slc_4933e6007ab8782c1ad7c06449cc49b12dda0dbc5136dbf45be390a8e63507d3"],"source_ids":["src_61d26aebd01657dfbebda6623900512a"],"text":"Projects can be exported as ZIP archives (including Codex chat JSONL history under .codex-project/chats/) and re-imported via the browser; imported chats are rewritten for the destination CODEX_HOME, project path, and selected provider/model so they can resume there.","updated_at":"2026-09-14T01:49:12Z","updated_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f"}
{"access":"public","created_at":"2026-09-14T01:49:12Z","created_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bb5d861deea3ac77d5a3179f276246de61e7edab7e5b9d2847dfe839c05df337","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"friuns2/codex-mobile@fac2291b0e60 snapshot 5767fa3cbc572be0","timeframe":null},"slice_ids":["slc_401a424e52dc067e138e79ba91c6e646a2a9674aa908b2d5685a725286f636ad","slc_ecee2298174e6344085f995150c1eadbb712fc3f6196fdbcd40390de22ba9f32","slc_ee1d01e8fb6cac7c50483b64163c370fa69e5ec1615afa34c97b270d2e006865"],"source_ids":["src_06aedf4fc60e5c8387bf02c22a84e954","src_61d26aebd01657dfbebda6623900512a"],"text":"The stack requires Node.js 18+ and a Codex app-server environment; documented technologies include Vue 3, Vue Router 4, Tailwind CSS 4, Vite 6, Express 5, Commander 13, TypeScript 5, and tsup 8.","updated_at":"2026-09-14T01:49:12Z","updated_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f"}
{"access":"public","created_at":"2026-09-14T01:49:12Z","created_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d64f17b06380857569dd0a31fe7e29f29e780a75ed2975a799d0475fc58754b6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"friuns2/codex-mobile@fac2291b0e60 snapshot 5767fa3cbc572be0","timeframe":null},"slice_ids":["slc_53316fc5bdc11fd864fe8cabc7b106136f4cac22c969dfdb0579e42a6253c470","slc_84ce83e57e633396c9304a2f20c2ac96fa53237753e11e09c4b5cc427e82743a"],"source_ids":["src_38e0cf7f05635b2bb0b2d4f393eab2db"],"text":"Repository development practice: AGENTS.md requires checking live git state before merges/rebases, committing after each discrete task, preferring PR-based merges, and inspecting conflicts intentionally rather than using automatic conflict-bias flags.","updated_at":"2026-09-14T01:49:12Z","updated_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f"}
{"access":"public","created_at":"2026-09-14T01:49:12Z","created_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f861b6ba3624b949629c004a328c0b15080adaf8ba8a917256d93cd462b62637","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"friuns2/codex-mobile@fac2291b0e60 snapshot 5767fa3cbc572be0","timeframe":null},"slice_ids":["slc_21714895716d5f70744a1da95e4e2918a12f0ff0478c4ef6c29a4dfb72da7522","slc_40b12c01080c10c3827a190e48802e65affbc385b06adf9aac99c8652f69243a"],"source_ids":["src_06aedf4fc60e5c8387bf02c22a84e954"],"text":"The design avoids Pinia/Vuex: all frontend state lives in one composable (`useDesktopState`), and realtime transport prefers WebSocket on /codex-api/ws with SSE fallback while client-to-server RPC uses HTTP POST.","updated_at":"2026-09-14T01:49:12Z","updated_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f"}
{"access":"public","created_at":"2026-09-14T01:49:12Z","created_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fd9a30cb8d49af8726f749c5ad0b748bc056a8a8446f8c930c3a9092434d37aa","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"friuns2/codex-mobile@fac2291b0e60 snapshot 5767fa3cbc572be0","timeframe":null},"slice_ids":["slc_34b430d3177b8caa3ada15e25c1b79b27f4cfeb5c5715379a8cc7cbb7284ab56","slc_991bc0c5ea794ffab560d3a94d57f47cf4a2ecf076f209c99431e8acbc946bd0","slc_bf874f3315cf5d5765cd9007abf63d82e588f1252d8219d4102d46a1535fbc66","slc_f8eb09d3c4dc1a94885a6136e4b802c366093728a95074aff45b62ed022d5925"],"source_ids":["src_61d26aebd01657dfbebda6623900512a"],"text":"An optional Telegram bot bridge forwards messages into a mapped Codex thread and returns assistant replies; it requires TELEGRAM_BOT_TOKEN and TELEGRAM_ALLOWED_USER_IDS, rejecting messages from non-allowlisted users, and supports commands like /threads, /newthread, and /history.","updated_at":"2026-09-14T01:49:12Z","updated_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f"}
