{"access":"public","created_at":"2026-09-14T01:49:12Z","created_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_69a2fb48fcc6f28ed1e72460612cb93359538ead274f469aaae9f85b3d74c247","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"friuns2/codex-mobile@fac2291b0e60 snapshot 5767fa3cbc572be0","timeframe":null},"slice_ids":["slc_4b6b02eb5520d794044d31531efe26722f477c2a430e9c865b1be140b90c4c64","slc_6050872a8b43efe43ed47955a63360ee4538c5781da6410b16455803af2259f8","slc_8ac19c4fd51e5057d2d9ebf5989bb225f58e930b855a1482fbe62d1fb8f42f1c"],"source_ids":["src_06aedf4fc60e5c8387bf02c22a84e954"],"text":"The UI surfaces server-initiated approval requests (command approvals, file changes, tool calls) that the user can approve or reject; production password auth uses an HttpOnly cookie and constant-time comparison, with auto-generated passwords written to $CODEX_HOME/codexui-password with 0600 permissions.","updated_at":"2026-09-14T01:49:12Z","updated_by_operation":"op_c6b6ee1eb9a2474fbb5dc0b0c41d172f"}
