{"access":"public","created_at":"2026-09-14T01:50:01Z","created_by_operation":"op_cea1146ea0464f5495cc703b4782e46c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6bfc78956d372a0a800ac32527e41f7d3c2d0c4959eefd9d44668c8a858bad8d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"gabrielchasukjin/cloi@1da62db7aa3a snapshot 797f9eefb3e6fe1a","timeframe":null},"slice_ids":["slc_43806505264e59d5b2875b0434cfd9e23fb11b2f02023f76a98b429fd4e0e08d","slc_5f7578660b4fee1f7622198a4a14683bc98a0e0dc90b563a1cd3893f8f328a0d","slc_b953a0fe1a13eb250cae42cf2a21ca68572d3b9934ca6a982adc186017f8d4d9"],"source_ids":["src_056886ad297f5cf4be4b95a47ccc59c6","src_7e813ab72cfd51d8a47f70c867fc354e"],"text":"Escalation to a stronger model is triggered by six observed-failure signals (e.g. repeated identical calls, consecutive tool failures, disproved claims), and the escalated model inherits the full conversation plus a handoff note.","updated_at":"2026-09-14T01:50:01Z","updated_by_operation":"op_cea1146ea0464f5495cc703b4782e46c"}
