{"access":"public","created_at":"2026-09-14T01:50:01Z","created_by_operation":"op_cea1146ea0464f5495cc703b4782e46c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a0cf10ba086c1db606807cc798a634e10beb11ddb0627ffcf84a46caf75fb363","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"gabrielchasukjin/cloi@1da62db7aa3a snapshot 797f9eefb3e6fe1a","timeframe":null},"slice_ids":["slc_55bee710c704b43d160ef052d0f9ccdf9fdf9555d5ca80c48410df36e8e2eb87","slc_56bae188d10b7717306606b8a674127c69c4d6e0c091e7fc2db1b36c8bafed12"],"source_ids":["src_7e813ab72cfd51d8a47f70c867fc354e"],"text":"Conversation state is persisted in SQLite and rebuilt from the database on every loop iteration, so interrupted turns leave a coherent, resumable session.","updated_at":"2026-09-14T01:50:01Z","updated_by_operation":"op_cea1146ea0464f5495cc703b4782e46c"}
