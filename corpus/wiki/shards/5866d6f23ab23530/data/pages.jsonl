{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0fdc1b68f55a864bc234d9514c42abdadae751e5091a309060342564a36f4d6a"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are instructed to follow prompt guidelines, provide both .md and .meta.md files, test prompts across AI models and project types, and maintain language and framework agnosticism."},{"claim_ids":["clm_2ce3f634547b7afeedfd6de36f5e58e65e4e56201244d648345401fa16db5042"],"opposing_claim_ids":[],"text":"Workflows are described as connected chains of prompts with defined input/output dependencies between phases, verification points for chain integrity, and progress tracking."},{"claim_ids":["clm_2d1196673ede719abac486746d7e8517c9f2b0e8b7c7494beeb241a4c40c6eb3"],"opposing_claim_ids":[],"text":"The library is marked as a work in progress; the post-scaffolding sprint workflow prompts are described as the most rigorously tested, while many individual prompts are not yet part of a defined workflow or fully tested."},{"claim_ids":["clm_90b8ec99fd3146e6318343fd5a1ead1dd0e427fdd7370ac699f88b89739f0686"],"opposing_claim_ids":[],"text":"Each prompt consists of two files: a .md file containing AI instructions and a .meta.md file containing usage documentation."},{"claim_ids":["clm_e5fc2b3d0cd62cb37994037ff21be274a0a1808830cd40d2ce48a419c3f32327"],"opposing_claim_ids":[],"text":"The library targets AI-assisted software development across phases from project inception to maintenance, aiming for language- and framework-agnostic, modular, single-purpose prompts that chain together for complex tasks."}],"claim_ids":["clm_0fdc1b68f55a864bc234d9514c42abdadae751e5091a309060342564a36f4d6a","clm_2ce3f634547b7afeedfd6de36f5e58e65e4e56201244d648345401fa16db5042","clm_2d1196673ede719abac486746d7e8517c9f2b0e8b7c7494beeb241a4c40c6eb3","clm_90b8ec99fd3146e6318343fd5a1ead1dd0e427fdd7370ac699f88b89739f0686","clm_e5fc2b3d0cd62cb37994037ff21be274a0a1808830cd40d2ce48a419c3f32327"],"created_at":"2026-09-14T03:42:05Z","created_by_operation":"op_e6ee9c702acc48819d4281b95e6a9bec","id":"pg_2fbd4b1c80b256ef9e133e4575f8af38","maturity":"draft","page_type":"source","path":"pages/sources/codingthefuturewithai-software-dev-prompt-library-readme-md-2caeefbce8-3e4575f8af38.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d0649e3eb9165844986f6d1905e905f6"],"title":"codingthefuturewithai/software-dev-prompt-library/README.md @ 2caeefbce8d0","updated_at":"2026-09-14T03:42:05Z","updated_by_operation":"op_e6ee9c702acc48819d4281b95e6a9bec"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_90b8ec99fd3146e6318343fd5a1ead1dd0e427fdd7370ac699f88b89739f0686"],"opposing_claim_ids":[],"text":"Each prompt consists of two files: a .md file containing AI instructions and a .meta.md file containing usage documentation."},{"claim_ids":["clm_ad89621ad80e4a256407ac6ef478ab6edba6d112a0ae61ad9ce4a4af6d46045d"],"opposing_claim_ids":[],"text":"Repository development practice: prompt guidelines instruct authors to test prompts individually across AI models and project types, and to test chains for input/output flow, integrity, and progress tracking; this is author guidance rather than an automated eval harness."},{"claim_ids":["clm_dc068f6b6aa294e286d3f3259ec8d966d5ec73b71e12871dc85ed97e80368dfa"],"opposing_claim_ids":[],"text":"Prompt guidelines call for one primary task per prompt with clear scope boundaries, defined output formats, validation rules, and prompts designed to fit into chains."}],"claim_ids":["clm_90b8ec99fd3146e6318343fd5a1ead1dd0e427fdd7370ac699f88b89739f0686","clm_ad89621ad80e4a256407ac6ef478ab6edba6d112a0ae61ad9ce4a4af6d46045d","clm_dc068f6b6aa294e286d3f3259ec8d966d5ec73b71e12871dc85ed97e80368dfa"],"created_at":"2026-09-14T03:42:05Z","created_by_operation":"op_e6ee9c702acc48819d4281b95e6a9bec","id":"pg_5ee921cb774e5d19b9b480165c14544e","maturity":"draft","page_type":"source","path":"pages/sources/codingthefuturewithai-software-dev-prompt-library-docs-guides-prompt-g-80165c14544e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d94e8068b7845d8fb8d8ab858026e83c"],"title":"codingthefuturewithai/software-dev-prompt-library/docs/guides/prompt-guidelines.md @ 2caeefbce8d0","updated_at":"2026-09-14T03:42:05Z","updated_by_operation":"op_e6ee9c702acc48819d4281b95e6a9bec"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2ce3f634547b7afeedfd6de36f5e58e65e4e56201244d648345401fa16db5042"],"opposing_claim_ids":[],"text":"Workflows are described as connected chains of prompts with defined input/output dependencies between phases, verification points for chain integrity, and progress tracking."},{"claim_ids":["clm_84c12ff5dab5dfabd876bc436e359448bf6912d602a26dd1b8e10752aaaeaf18"],"opposing_claim_ids":[],"text":"Metadata files provide AI assistant compatibility, SDLC phase information, complexity ratings, and usage guidelines for each prompt."},{"claim_ids":["clm_be723d5177ac8187b19f9a729f849be0fc488d8134a8593f88a89dbc0b5b6a66"],"opposing_claim_ids":[],"text":"Workflows are organized into general sprint and maintenance workflows plus assistant-specific ones for aider, github-copilot, and claude, each with sprint and maintenance subfolders."},{"claim_ids":["clm_bface0404703c3040f37a1462d334d9eda0e7099c769d1869fc95e7035df1a90"],"opposing_claim_ids":[],"text":"The prompts directory is organized into nine categories (architecture, code-analysis, coding, documentation, learning, maintenance, planning, requirements, testing), each split into general and assistant-specific subdirectories."}],"claim_ids":["clm_2ce3f634547b7afeedfd6de36f5e58e65e4e56201244d648345401fa16db5042","clm_84c12ff5dab5dfabd876bc436e359448bf6912d602a26dd1b8e10752aaaeaf18","clm_be723d5177ac8187b19f9a729f849be0fc488d8134a8593f88a89dbc0b5b6a66","clm_bface0404703c3040f37a1462d334d9eda0e7099c769d1869fc95e7035df1a90"],"created_at":"2026-09-14T03:42:05Z","created_by_operation":"op_e6ee9c702acc48819d4281b95e6a9bec","id":"pg_6b6e2ce6036e53329243ef599c152252","maturity":"draft","page_type":"source","path":"pages/sources/codingthefuturewithai-software-dev-prompt-library-project-organization-ef599c152252.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e5cd31a4dd1b55398abac015f350cfa6"],"title":"codingthefuturewithai/software-dev-prompt-library/PROJECT_ORGANIZATION.md @ 2caeefbce8d0","updated_at":"2026-09-14T03:42:05Z","updated_by_operation":"op_e6ee9c702acc48819d4281b95e6a9bec"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_959c70e5684c6151e0d89d653d2c55c832081f07a052dd97288206602db10b53"],"opposing_claim_ids":[],"text":"The workflows and prompts are described as beta and tested only with the aider AI coding assistant; support for other assistants such as Cursor and Codeium's Windsurf is planned for future updates."},{"claim_ids":["clm_cb8bd3a23e9fabca0b2193744e4541a86b50ee23993afb3f33f485814b701b1d"],"opposing_claim_ids":[],"text":"The getting-started guide describes two main workflows: a project-scaffolding sprint chain for new projects and a post-scaffolding sprint chain for adding features, both located under workflows/assistant-specific/aider/sprint and designed for the aider assistant."},{"claim_ids":["clm_e5fc2b3d0cd62cb37994037ff21be274a0a1808830cd40d2ce48a419c3f32327"],"opposing_claim_ids":[],"text":"The library targets AI-assisted software development across phases from project inception to maintenance, aiming for language- and framework-agnostic, modular, single-purpose prompts that chain together for complex tasks."}],"claim_ids":["clm_959c70e5684c6151e0d89d653d2c55c832081f07a052dd97288206602db10b53","clm_cb8bd3a23e9fabca0b2193744e4541a86b50ee23993afb3f33f485814b701b1d","clm_e5fc2b3d0cd62cb37994037ff21be274a0a1808830cd40d2ce48a419c3f32327"],"created_at":"2026-09-14T03:42:05Z","created_by_operation":"op_e6ee9c702acc48819d4281b95e6a9bec","id":"pg_aa4aef333f3253b89e6ec3e711d90256","maturity":"draft","page_type":"source","path":"pages/sources/codingthefuturewithai-software-dev-prompt-library-docs-guides-getting--c3e711d90256.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2896b4581e285b818eba31039149cb75"],"title":"codingthefuturewithai/software-dev-prompt-library/docs/guides/getting-started.md @ 2caeefbce8d0","updated_at":"2026-09-14T03:42:05Z","updated_by_operation":"op_e6ee9c702acc48819d4281b95e6a9bec"}
