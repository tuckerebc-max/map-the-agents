{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_048909d45a336701a530f38fa46767f25751406f1b5767a38d96d86691b74991"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are accepted via opening an issue to discuss changes and submitting pull requests with enhancements."},{"claim_ids":["clm_09a8ac38d927995236894b2d8f06df3266306d8e57b89aaef95bd58b3f935f2c"],"opposing_claim_ids":[],"text":"The intended interface is file-tagging in an AI IDE/CLI: users reference the markdown files and generated PRDs with @-mentions such as @create-prd.md and @MyFeature-PRD.md."},{"claim_ids":["clm_25f4552f1804c7d2644932169ef5508f9097e361158facc21dc4f565b64912e0"],"opposing_claim_ids":[],"text":"The repo ships markdown prompt files meant to be referenced inside AI coding assistants (e.g., via @create-prd.md) to steer their behavior, rather than executable code."},{"claim_ids":["clm_fbac4dd83753b082bb38e98f59cc8d408edecc9a813f6b1ca7f0e108dde41e14"],"opposing_claim_ids":[],"text":"The documented workflow is: create a PRD, generate a task list from it, then have the AI work through tasks one sub-task at a time with user review between steps."}],"claim_ids":["clm_048909d45a336701a530f38fa46767f25751406f1b5767a38d96d86691b74991","clm_09a8ac38d927995236894b2d8f06df3266306d8e57b89aaef95bd58b3f935f2c","clm_25f4552f1804c7d2644932169ef5508f9097e361158facc21dc4f565b64912e0","clm_fbac4dd83753b082bb38e98f59cc8d408edecc9a813f6b1ca7f0e108dde41e14"],"created_at":"2026-09-14T04:21:57Z","created_by_operation":"op_41bb1718f3a1415fb53dac0f1c072322","id":"pg_835050c994df53e9ae83736f9a9bb7ea","maturity":"draft","page_type":"source","path":"pages/sources/snarktank-ai-dev-tasks-readme-md-efbffaac10e6-736f9a9bb7ea.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_851f9dae41bf5c849be26ce440875ab8"],"title":"snarktank/ai-dev-tasks/README.md @ efbffaac10e6","updated_at":"2026-09-14T04:21:57Z","updated_by_operation":"op_41bb1718f3a1415fb53dac0f1c072322"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0259ac4a8b17321494274b872e31b2065bbb1ff3ebaa421d756cdd4e38bcf0fe"],"opposing_claim_ids":[],"text":"The generated task list must include a 'Relevant Files' section listing files to create or modify, with corresponding test files where applicable."},{"claim_ids":["clm_17690a95fffef2e79e76785fe8b7a1b3341ee555ab5d7c1aaf19e5a37d083569"],"opposing_claim_ids":[],"text":"Repository development practice: the task-list template tells the implementing agent to run tests with 'npx jest [optional/path/to/test/file]' and to place unit tests alongside the code they test."},{"claim_ids":["clm_a13a359c65cb376c6f4464dccdb58d9930fdd392f9fd750a2ee6449684e1c3a7"],"opposing_claim_ids":[],"text":"generate-tasks.md requires task 0.0 'Create feature branch' as the first task unless the user opts out, and pauses for user confirmation ('Go') before generating sub-tasks."},{"claim_ids":["clm_f0eca526e442a736ecf168125128b199ced8378c3060110191eb3334e24a9607"],"opposing_claim_ids":[],"text":"generate-tasks.md instructs the AI to check off each sub-task in the markdown file by changing '- [ ]' to '- [x]' after completion, updating after each sub-task."},{"claim_ids":["clm_fec857fa2fe3686db02e816b9b2188d35ef0759dd6560087c3c11bd461b03c72"],"opposing_claim_ids":[],"text":"Both prompt files state the PRD and task list are written for a junior developer, requiring explicit, unambiguous, jargon-light requirements."}],"claim_ids":["clm_0259ac4a8b17321494274b872e31b2065bbb1ff3ebaa421d756cdd4e38bcf0fe","clm_17690a95fffef2e79e76785fe8b7a1b3341ee555ab5d7c1aaf19e5a37d083569","clm_a13a359c65cb376c6f4464dccdb58d9930fdd392f9fd750a2ee6449684e1c3a7","clm_f0eca526e442a736ecf168125128b199ced8378c3060110191eb3334e24a9607","clm_fec857fa2fe3686db02e816b9b2188d35ef0759dd6560087c3c11bd461b03c72"],"created_at":"2026-09-14T04:21:57Z","created_by_operation":"op_41bb1718f3a1415fb53dac0f1c072322","id":"pg_95d1aafdda955e3c8e8f18632ae7d45e","maturity":"draft","page_type":"source","path":"pages/sources/snarktank-ai-dev-tasks-generate-tasks-md-efbffaac10e6-18632ae7d45e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2daff52f46df51d199cc9e2f8e7750c4"],"title":"snarktank/ai-dev-tasks/generate-tasks.md @ efbffaac10e6","updated_at":"2026-09-14T04:21:57Z","updated_by_operation":"op_41bb1718f3a1415fb53dac0f1c072322"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_03315831ce8d85b66a7ce91860f51ca65238f483897eddc1132d3fbbe8f3826c"],"opposing_claim_ids":[],"text":"create-prd.md instructs the AI to ask 3-5 essential clarifying questions, formatted as numbered questions with lettered options so the user can reply with selections like '1A, 2C'."},{"claim_ids":["clm_463809ad835485bf19437cede305b2f7531299ad51c5f82d417cfae5882435f6"],"opposing_claim_ids":[],"text":"create-prd.md directs the AI to save the PRD as prd-[feature-name].md in a /tasks directory and explicitly forbids starting implementation of the PRD."},{"claim_ids":["clm_6144c4e96a13391bb2a1500cba81e8d302051de8a83c5fdae9165384108ca0b3"],"opposing_claim_ids":[],"text":"create-prd.md specifies a nine-section PRD structure including goals, user stories, numbered functional requirements, non-goals, success metrics, and open questions."},{"claim_ids":["clm_fec857fa2fe3686db02e816b9b2188d35ef0759dd6560087c3c11bd461b03c72"],"opposing_claim_ids":[],"text":"Both prompt files state the PRD and task list are written for a junior developer, requiring explicit, unambiguous, jargon-light requirements."}],"claim_ids":["clm_03315831ce8d85b66a7ce91860f51ca65238f483897eddc1132d3fbbe8f3826c","clm_463809ad835485bf19437cede305b2f7531299ad51c5f82d417cfae5882435f6","clm_6144c4e96a13391bb2a1500cba81e8d302051de8a83c5fdae9165384108ca0b3","clm_fec857fa2fe3686db02e816b9b2188d35ef0759dd6560087c3c11bd461b03c72"],"created_at":"2026-09-14T04:21:57Z","created_by_operation":"op_41bb1718f3a1415fb53dac0f1c072322","id":"pg_a268a92d8d1f506d8c6072d669bf0aa6","maturity":"draft","page_type":"source","path":"pages/sources/snarktank-ai-dev-tasks-create-prd-md-efbffaac10e6-72d669bf0aa6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_61aa89a4516756579b41d54abbd89dce"],"title":"snarktank/ai-dev-tasks/create-prd.md @ efbffaac10e6","updated_at":"2026-09-14T04:21:57Z","updated_by_operation":"op_41bb1