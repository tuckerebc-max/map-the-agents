{"access":"public","created_at":"2026-09-14T03:31:51Z","created_by_operation":"op_4b231051553a43d7af9d24124b7dcfe2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3241ab0cad504d7a6ac2e27ecb190f424a3f55a0e765c67aa38e868dd320eb19","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"ai-genie/chatgpt-vscode@e6203fb099f3 snapshot 8480da848e15b2dd","timeframe":null},"slice_ids":["slc_d1e67e4e33e07f2c8eab6f3f157d28f16a2b06983d2c13aae0dd73fdaa637ecc","slc_fe1c28efe0b5f3a0bddfcea3f3d2fd0662fb99317d78c6c8392ed372ae5e8a09"],"source_ids":["src_749e95854f075248802873e9e1307563"],"text":"The editor view historically used text-davinci-003 by design because it was said to be the only model guaranteeing a code response without conversational context, though a later release states the editor view now uses the user's selected model.","updated_at":"2026-09-14T03:31:51Z","updated_by_operation":"op_4b231051553a43d7af9d24124b7dcfe2"}
