{"access":"public","created_at":"2026-09-14T02:37:21Z","created_by_operation":"op_39ca9be173b947d08def668aa9941c13","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_89939e9b1770978a696a137c5f715e67e705c3d996d393bd21f9df4eed58244c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"sahil87/run-kit@65653f4d91c5 snapshot fc34e1f500229b22","timeframe":null},"slice_ids":["slc_6146e469cbc5b27d1a2186f3c23ddc5c45c50d3d88e1330ddd648431c9a0d113","slc_d68d27952c15fc0a4e0e480fe06a3511093218143464912b7efb8933a48a13a0"],"source_ids":["src_9da569e1c935590ab1b7770237660edd"],"text":"HexoKit is described as a remote, phone-first console for tmux: every tmux session and pane appears as a live browser terminal, with state read directly from tmux rather than a database.","updated_at":"2026-09-14T02:37:21Z","updated_by_operation":"op_39ca9be173b947d08def668aa9941c13"}
