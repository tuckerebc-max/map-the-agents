{"access":"public","created_at":"2026-09-14T02:37:21Z","created_by_operation":"op_39ca9be173b947d08def668aa9941c13","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a906c6c97146cc28eed680c67837bbea1cbcb9e16dd354804baf5f09fed2addd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"sahil87/run-kit@65653f4d91c5 snapshot fc34e1f500229b22","timeframe":null},"slice_ids":["slc_08c1426400ec66934b3a1f669263d7b726adf4a9f90316aff162f2370af3ff0a","slc_543d70258c33711de221c4b695e3a8ac4804ebf70986f167794ee6d76d8089fa","slc_93beb092019817915ff1f419840e3a995ddf2f7c2cbba6d48e5cfaf13160d36d","slc_ad3c4e1add873b5b9ad2c10957391f4a49216c0f93f8ac1073c35df5b5902af3"],"source_ids":["src_9da569e1c935590ab1b7770237660edd"],"text":"The dashboard offers named cross-server boards pinning multiple tmux panes side-by-side (pin state stored in tmux), a GUI tile running the host desktop via a private X display with selectable window managers, and a macOS Electron desktop app installable via `rk desktop install`.","updated_at":"2026-09-14T02:37:21Z","updated_by_operation":"op_39ca9be173b947d08def668aa9941c13"}
