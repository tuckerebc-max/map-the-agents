{"access":"public","created_at":"2026-09-14T01:58:48Z","created_by_operation":"op_6ee55452f1224fe8a873a7397394f5ff","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_908a6d1bc938d7c975a4c56895954e886984af121547d45510ff0956c67e58b8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"2389-research/hex@199a60df68f6 snapshot 661da7e02f8d3220","timeframe":null},"slice_ids":["slc_5b55dd03fb59d4b6b59884d7617dde1373dac04b3b7cf81a3c4667d4b277b7a1","slc_7bf3f99dc840bbe5bd149d9f6fed3e9fb9dae2ca8ca8a9e9d1802b0176520ce4","slc_8b90760341d3276268617f81bf72a972f4328da45d9bc83983f163e4c3006b2f","slc_97828f50587c8ba494bcc3e47f63b1fdd6dd34ca2e4fa95ded58bfba7a52fd62","slc_a3188b9863d445fe2de82063c15280a42e7cbadc291792916d5d141332988d13","slc_b977d839fd1cd902d36b252d098a879405ddb9cfebaf1b04b9b4516174449e8d","slc_d2e5e527830470bdeed3029c64c6c0732c137c6db925fb0782d0b0ed71563079"],"source_ids":["src_97522521a9aa5f019bd5a09763ae8a2b","src_9ac10410c80a53a49ace2b06c6fb05fa"],"text":"Conversations persist in SQLite at ~/.hex/hex.db using a hybrid schema (normalized conversations/messages tables plus JSON columns for tool_calls and metadata), with WAL mode, foreign keys, embedded migrations, and resume support.","updated_at":"2026-09-14T01:58:48Z","updated_by_operation":"op_6ee55452f1224fe8a873a7397394f5ff"}
{"access":"public","created_at":"2026-09-14T01:58:48Z","created_by_operation":"op_6ee55452f1224fe8a873a7397394f5ff","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a74bef5b7f779018d63c022a590307ab8bc2be926572815406f10b5e27fa60d1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"2389-research/hex@199a60df68f6 snapshot 661da7e02f8d3220","timeframe":null},"slice_ids":["slc_02759bb3995450a849dad381135b6c289a15934a715f37bcc689b8b726661d62","slc_8e35dbe736d64a3bdc4ab9822e462cd53f8914ec1dbeded75d8ac4c2b9fa2062","slc_ebf10803370c2df88ff98c8b2a7c7b6bab7f391007b5e9572b1e760348274523"],"source_ids":["src_9ac10410c80a53a49ace2b06c6fb05fa"],"text":"The tool system uses a registry plus executor pattern; tools implement a Go interface with Name, Description, Execute, and RequiresApproval methods, and the executor handles approval callbacks and parameter validation.","updated_at":"2026-09-14T01:58:48Z","updated_by_operation":"op_6ee55452f1224fe8a873a7397394f5ff"}
{"access":"public","created_at":"2026-09-14T01:58:48Z","created_by_operation":"op_6ee55452f1224fe8a873a7397394f5ff","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_aa6b790c440b46acfe86d5df09412224712a4471268b824a430ec0ae2966f6c9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"2389-research/hex@199a60df68f6 snapshot 661da7e02f8d3220","timeframe":null},"slice_ids":["slc_149eed09fc97dd7e86eecb7cceb5972ea95a53449a3316ec81ab643dc0c5ba4a","slc_ebef5b4b73b5ff1ebef8c3e32b4c4350f3cf83bcfa0318f0b92c729228668a32"],"source_ids":["src_97522521a9aa5f019bd5a09763ae8a2b"],"text":"The Task tool launches sub-agents for complex tasks, and the README describes multi-agent capabilities including event-sourced audit trails, per-agent cost tracking, tree/timeline visualization with HTML export, and graceful cascading shutdown.","updated_at":"2026-09-14T01:58:48Z","updated_by_operation":"op_6ee55452f1224fe8a873a7397394f5ff"}
