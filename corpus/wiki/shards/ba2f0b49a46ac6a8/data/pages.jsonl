"maturity":"draft","page_type":"entity","path":"pages/entities/bahdotsh-indxr-e154addab5e0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"bahdotsh/indxr","updated_at":"2026-09-14T04:42:11Z","updated_by_operation":"op_16bf1e3e6c5b430986eccdcc1bef5cc8"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3023e70f7f07e0cfd78df2e957b6459d6ea2a6b88e1736ed42593fb095bc2b75"],"opposing_claim_ids":[],"text":"Filtering options include --filter-path (prefix match on relative paths), -l for case-insensitive language selection, --kind for declaration kind, --symbol for case-insensitive substring search, and --public-only."}],"claim_ids":["clm_3023e70f7f07e0cfd78df2e957b6459d6ea2a6b88e1736ed42593fb095bc2b75"],"created_at":"2026-09-14T04:42:11Z","created_by_operation":"op_16bf1e3e6c5b430986eccdcc1bef5cc8","id":"pg_70d127d5fa6657d2bd8e88dfd6fdb4a6","maturity":"draft","page_type":"source","path":"pages/sources/bahdotsh-indxr-docs-filtering-md-fbcbe9451605-88dfd6fdb4a6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c20cc5666d6a502c8e26c2e38fed08a3"],"title":"bahdotsh/indxr/docs/filtering.md @ fbcbe9451605","updated_at":"2026-09-14T04:42:11Z","updated_by_operation":"op_16bf1e3e6c5b430986eccdcc1bef5cc8"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0945cc6eeb9b42d020570081bdda5f29473d269ed19a6019a09fa8403a23166a"],"opposing_claim_ids":[],"text":"The cache file carries a version marker; on a version mismatch after an upgrade the cache is discarded and rebuilt from scratch."},{"claim_ids":["clm_297f237a7776543742cc3e0a64151bb81573a75b51674ffec99bd6fd851c53df"],"opposing_claim_ids":[],"text":"Documented cache performance numbers show warm runs roughly 3.3x-7.3x faster than cold runs across three codebase sizes, with speedup growing with codebase size."},{"claim_ids":["clm_2df115fd8555e7e06e2a2952be9bc865d465a030b49c161650f29564e752abca"],"opposing_claim_ids":[],"text":"The cache is serialized with bincode, and each entry stores relative file path, mtime, size, an xxh3_64 content hash, and the parsed FileIndex."},{"claim_ids":["clm_88fba53b26ee6c87ae903460f0a6d8330d2367ef590cb063ef64808b92d9f1bd"],"opposing_claim_ids":[],"text":"indxr maintains an incremental binary cache at .indxr-cache/cache.bin that avoids re-parsing unchanged files, making subsequent runs faster."},{"claim_ids":["clm_a9e45fed2dc67da8d4191779770165095fb70c14b172609f7da6436b8f335ca7"],"opposing_claim_ids":[],"text":"The CLI exposes cache options: --cache-dir for a custom location and --no-cache, which creates a no-op cache that never hits, useful for benchmarking or guaranteed fresh parses."},{"claim_ids":["clm_df73c6644b6cb9df8ea5125c282f00c57a6c8ce52cc08e921a746a2a7738067b"],"opposing_claim_ids":[],"text":"Cache validation is two-tier: a quick mtime+size check, with an xxh3 content-hash fallback for cases like touch where metadata changed but content did not."},{"claim_ids":["clm_f1514c1576f4a8644b5c8db9956b2a73d1a011d14cc1906b0ac4c36297c33b9a"],"opposing_claim_ids":[],"text":"The MCP server (indxr serve) indexes the project once at startup and serves from an in-memory index, with the on-disk cache accelerating that startup parse."}],"claim_ids":["clm_0945cc6eeb9b42d020570081bdda5f29473d269ed19a6019a09fa8403a23166a","clm_297f237a7776543742cc3e0a64151bb81573a75b51674ffec99bd6fd851c53df","clm_2df115fd8555e7e06e2a2952be9bc865d465a030b49c161650f29564e752abca","clm_88fba53b26ee6c87ae903460f0a6d8330d2367ef590cb063ef64808b92d9f1bd","clm_a9e45fed2dc67da8d4191779770165095fb70c14b172609f7da6436b8f335ca7","clm_df73c6644b6cb9df8ea5125c282f00c57a6c8ce52cc08e921a746a2a7738067b","clm_f1514c1576f4a8644b5c8db9956b2a73d1a011d14cc1906b0ac4c36297c33b9a"],"created_at":"2026-09-14T04:42:11Z","created_by_operation":"op_16bf1e3e6c5b430986eccdcc1bef5cc8","id":"pg_84f18ca851fe533bb083469f9c8e6e01","maturity":"draft","page_type":"source","path":"pages/sources/bahdotsh-indxr-docs-caching-md-fbcbe9451605-469f9c8e6e01.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5b15d93ea61a50cdabc964a46f919ed5"],"title":"bahdotsh/indxr/docs/caching.md @ fbcbe9451605","updated_at":"2026-09-14T04:42:11Z","updated_by_operation":"op_16bf1e3e6c5b430986eccdcc1bef5cc8"}
