{"access":"public","created_at":"2026-09-14T01:25:59Z","created_by_operation":"op_4d199256e60043cdbcf2e45c85a306ed","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_24110e2b6ad40a5cd2af708ac128f94a4a5bae1af4fa4efac8baad657674fe23","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"2389-research/breakaway-agent@a426c399d50f snapshot fa31829804eca3a3","timeframe":null},"slice_ids":["slc_3500f8bd8f3234613dbe6d34d7a046d85a21986b0eea54c842aa63652ac7ae60","slc_78eebc59e8abf75a139a47fa39ed7bd8b38ee48469aebfa46fbafb73674e35ce","slc_7d302edfb23c6a4a369ae157fa5f975c28fed86c3985eebe5b14377caaf694d8"],"source_ids":["src_792f0e2b9dc8533d90a9adb9f0b97f95"],"text":"The agent supports self-modification: editing tools.ts, policy.ts, or system.txt then SIGHUP or /reload hot-reloads via cache-busted dynamic import, while SIGUSR2 or /restart exits with code 42 so a wrapper relaunches it (up to 20 times).","updated_at":"2026-09-14T01:25:59Z","updated_by_operation":"op_4d199256e60043cdbcf2e45c85a306ed"}
{"access":"public","created_at":"2026-09-14T01:25:59Z","created_by_operation":"op_4d199256e60043cdbcf2e45c85a306ed","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_25dd500618bdf9c53eed6ddee81deb65f1144c1e92316b5ec196b0d98078cb12","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"2389-research/breakaway-agent@a426c399d50f snapshot fa31829804eca3a3","timeframe":null},"slice_ids":["slc_64ed7fe79f3022c32ba0102098e13e28aa217f4e67142796abc88251e83fc909","slc_b5fdad39685e0f76b96f534d9287bfbe01b3e08aa8524419bcb18a0fc76d3f52"],"source_ids":["src_792f0e2b9dc8533d90a9adb9f0b97f95"],"text":"spawn_agent launches child agents whose stdout/stderr go to spawn-<ts> files; nesting depth is tracked via BREAK_AWAY_DEPTH and capped by BREAK_AWAY_MAX_DEPTH (default 3), returning an error at the cap.","updated_at":"2026-09-14T01:25:59Z","updated_by_operation":"op_4d199256e60043cdbcf2e45c85a306ed"}
