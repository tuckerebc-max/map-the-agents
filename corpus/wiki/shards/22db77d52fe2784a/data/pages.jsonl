{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_de688e39c3fa54d88ea86f6d1c5ae6bd85737757609c7b56a8d5993f20c027f9"],"opposing_claim_ids":[],"text":"An approved design doc records bundling skills into the image rather than downloading at startup, citing faster startup, no network dependency, and predictability as reasons."}],"claim_ids":["clm_de688e39c3fa54d88ea86f6d1c5ae6bd85737757609c7b56a8d5993f20c027f9"],"created_at":"2026-09-14T03:45:34Z","created_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184","id":"pg_45e3f4c609cb5a31b6df8ad7bf026af2","maturity":"draft","page_type":"source","path":"pages/sources/datasciencemonkey-coding-agents-databricks-apps-docs-plans-2025-02-03--8ad7bf026af2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_024fd784a7ea56a781d5d3bf7e6ad027"],"title":"datasciencemonkey/coding-agents-databricks-apps/docs/plans/2025-02-03-bundled-skills-design.md @ e4a4b216e439","updated_at":"2026-09-14T03:45:34Z","updated_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184"}
