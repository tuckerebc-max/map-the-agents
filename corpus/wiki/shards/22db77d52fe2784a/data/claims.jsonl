{"access":"public","created_at":"2026-09-14T03:45:34Z","created_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8798fd54f57140e4ff9975ea5b6a227b07619d08e02fd8ff006f884b31e45a26","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"datasciencemonkey/coding-agents-databricks-apps@e4a4b216e439 snapshot d20a4ad5ff34cf66","timeframe":null},"slice_ids":["slc_dbdcd328e39dedfb7005dbb0dd6acba12f81f326d43aa21d9a3938a121907da1"],"source_ids":["src_17b3244555c258959dfb5cd099419e4c"],"text":"The app is single-user: the owner is resolved via the app's service principal and Apps API, and authorization checks X-Forwarded-Email against app.creator.","updated_at":"2026-09-14T03:45:34Z","updated_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184"}
{"access":"public","created_at":"2026-09-14T03:45:34Z","created_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_99c1b2a512335f8e4253e281ce48ef508dc4af23e5435f9f692774d9013a8505","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"datasciencemonkey/coding-agents-databricks-apps@e4a4b216e439 snapshot d20a4ad5ff34cf66","timeframe":null},"slice_ids":["slc_6f0194df60531a038464c0013563eea159b74aaabbda9ae9266c3f14352f8e16"],"source_ids":["src_17b3244555c258959dfb5cd099419e4c"],"text":"At startup, Gunicorn calls initialize_app(), then a background thread runs 5 sequential setup steps followed by 6 agent setups in parallel via ThreadPoolExecutor, with progress reported through /api/setup-status.","updated_at":"2026-09-14T03:45:34Z","updated_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184"}
{"access":"public","created_at":"2026-09-14T03:45:34Z","created_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a98a487c13681b0c3e70d6eaf29cf4d95fbcf919770ef302b9956aa51abed2ca","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"datasciencemonkey/coding-agents-databricks-apps@e4a4b216e439 snapshot d20a4ad5ff34cf66","timeframe":null},"slice_ids":["slc_e7a0b44af70a12f5e2f97e3129801edef4522129bd35b45c64afdd6a65f62532"],"source_ids":["src_9d7249feb0c75ea989bb4cedf4d68e9f"],"text":"An earlier design doc lists limitations including no persistence across redeploys, a 12-hour Databricks session limit, and initially no terminal resize signaling.","updated_at":"2026-09-14T03:45:34Z","updated_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184"}
