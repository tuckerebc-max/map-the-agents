{"access":"public","created_at":"2026-09-14T03:45:34Z","created_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2ddf9a5c5b57d24e74f549a9b9acc9ede7be6eef78cf78525644c0db435dedfd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"datasciencemonkey/coding-agents-databricks-apps@e4a4b216e439 snapshot d20a4ad5ff34cf66","timeframe":null},"slice_ids":["slc_6648070b7ceb59a91687deed566ac2bd493f9154d5035d5c331adc1b34ee0a6b"],"source_ids":["src_17b3244555c258959dfb5cd099419e4c"],"text":"Socket.IO events include join_session, terminal_input, terminal_resize, heartbeat (client-to-server) and terminal_output, session_exited, session_closed, shutting_down (server-to-client).","updated_at":"2026-09-14T03:45:34Z","updated_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184"}
{"access":"public","created_at":"2026-09-14T03:45:34Z","created_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3075dd5a053442eb47d1c4b96c0b8558d351ce88fca42cd703b66bbe0190f936","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"datasciencemonkey/coding-agents-databricks-apps@e4a4b216e439 snapshot d20a4ad5ff34cf66","timeframe":null},"slice_ids":["slc_5334d21b06eecded78bce0fb31ce6b3f33831b3862453fe06538f04e402925d0"],"source_ids":["src_17b3244555c258959dfb5cd099419e4c"],"text":"The app exposes HTTP endpoints including /health, /api/session, /api/input, /api/output, /api/output-batch, /api/heartbeat, /api/resize, /api/upload, and /api/session/close.","updated_at":"2026-09-14T03:45:34Z","updated_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184"}
{"access":"public","created_at":"2026-09-14T03:45:34Z","created_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_42fdf7f9be53988b7c5315ad179c2dc8497052143ecc3345383f8dccf2400da3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"datasciencemonkey/coding-agents-databricks-apps@e4a4b216e439 snapshot d20a4ad5ff34cf66","timeframe":null},"slice_ids":["slc_ab793ec2babbcee42075cace9cd610272becbd85f6b9eebb1dce28668d78c400"],"source_ids":["src_17b3244555c258959dfb5cd099419e4c"],"text":"Production Gunicorn is configured with workers=1 because PTY state is process-local, threads=16, gthread worker class, and a 60-second timeout for long-lived WebSocket connections.","updated_at":"2026-09-14T03:45:34Z","updated_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184"}
{"access":"public","created_at":"2026-09-14T03:45:34Z","created_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_44e94e09a3442196ae3fb4553bef6129319b1792183a705301111c80f374916f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"datasciencemonkey/coding-agents-databricks-apps@e4a4b216e439 snapshot d20a4ad5ff34cf66","timeframe":null},"slice_ids":["slc_5d908671114a674e8ccd51ecd028e2878388e2048b334cbc63cd6438f3f1b930","slc_a74275349ffef09c58d0f49ed6620372d265b341600ee11ca333cfb7e8387807","slc_dac181e34d5d2deb231f9d8d8c3a4269b5281890cf0043cae3dd72aab1e447aa"],"source_ids":["src_17b3244555c258959dfb5cd099419e4c"],"text":"The app bundles 39 skills: 25 Databricks skills from ai-dev-kit (agent-bricks, genie, mlflow-eval, unity-catalog, etc.) and 14 superpowers skills (TDD, debugging, review, git-worktrees, etc.).","updated_at":"2026-09-14T03:45:34Z","updated_by_operation":"op_6786f9a0338d4a1c83f83b888ab1c184"}
