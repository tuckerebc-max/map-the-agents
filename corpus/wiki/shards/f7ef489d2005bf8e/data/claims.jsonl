{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0b36816531b234873ae6b87619536c3d41015b7014f52bae6ea833c7181fe4a4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_2192257a947429d55554eca0ed09452ffd52e33c93965a5852782fecb66e32d1","slc_784f743bf40947d3741b07f6430267b79f8e93b26bb131a80edb334ae0653caf","slc_9e7983b80a28dadebc0a800e72ec0553d29f1b6defae8d615a516eb34df6ce56","slc_cd761cc1ca32a75276ccbb0100499d4ce5f851fa293b313e928cef3528fa7aeb","slc_e3d31bb09e4e007abec2f26f7570dbf45e263c1438ca998ae89804360a479b92"],"source_ids":["src_52f9aac99ed75406b7827ef4d501d57b","src_9e6d59903dd75171b4088f2fa3c55749"],"text":"Three execution targets share the same graph and runtime plan: local mode in the current Git worktree reusing Codex or Claude Code logins, a self-hosted Docker target image bundling the engine plus pinned Codex and Claude harness CLIs, and a managed Zeroshot Cloud target.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0bf189be40418d5352fa500818c5d34366893c975a0305374c19194d3d815d4e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_24740c1bf0e0a0b48e1cc07a16e7a16ea0dd948c2f0598b4e5b4c54e815580b0","slc_d812e6554c65948df6371afe4e7eafd283bdd9558b506108dd6d5cfc1cf5cbda"],"source_ids":["src_9e6d59903dd75171b4088f2fa3c55749"],"text":"A run consists of three authored values: a graph defining control flow and typed state, a runtime plan binding each executable node to a harness, provider, model, and named connections, and caller-owned initial input validated against the graph before execution.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0c374aeaa18fbc6ff6b01e3a2e06bef25ff39748067004a4a869353ca43ae0ea","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_18ac4f06b2e87b9729be2e314b5d4f9793c4209201a999aca4fc37524f0ec793","slc_63e9071dbfb06dd0bd12a5c90bea699cdbebe360a7675248f2e336a38ef7a52f","slc_86f2f74d8d9e810d305e9ab77d3b0a9c6b00b9909c6d89732176eedc32085075","slc_c263daefbfb8dcbdad39f7890c844aa669590b46e175b01b38b613f5a3b842bd"],"source_ids":["src_52f9aac99ed75406b7827ef4d501d57b"],"text":"The product is a native `zeroshot` executable (v8 hard cutover, former Node.js runtime retired), installed via npm and providing commands like `zeroshot run`, `zeroshot version`, and `zeroshot template list/show`.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1e78f5ad236b981937399a0a2c600ce61826b2de844ff2aa0c9369a95b00ea6e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_0c6436f3a0567965b1eed57e4b205cf3a4aeb48bf53ecb18bc3be1dc33cae1d8","slc_0d9d7b0af6fad38a3672f16bb157f0341c3bc7c04ca57df82525fba5ec141a1f","slc_e6da58dac3544f36793b10b0bb88d177dea64369bd12ab6c6eed0824a56a0e7d"],"source_ids":["src_7f9af73b820450c1915da1e829aee56b"],"text":"Repository development practice: releases publish one canonical version across GitHub tag, native archives, checksum manifest, npm package, target image, Python wheels, and versioned docs via a release workflow using GitHub OIDC trusted publishing, with no long-lived npm or PyPI tokens.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_246f7f6c5217275aa6f4507f546b7ae82c5504c858d4240f3bc115fd1fce90a0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_98851e04199b55cca5dec804c15bf49fb36445ada501318542f6a9add906f21c"],"source_ids":["src_9e6d59903dd75171b4088f2fa3c55749"],"text":"Besides the software-change template, a single-worker template exists for work that does not need the review loop, and custom graphs follow the same protocol contracts.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3d7f16957cc3edf5b02e5eb85c29ab46993c957f3da6345feb27984c9b136078","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_a5842a1fdbef6ceab712cfc4c8c284e3b1e339240aec987f9d73a9abcc598dfc","slc_f63b8311165fe29d651af8e02678d605bd48838a2788e44c541fe719813fd01d"],"source_ids":["src_52f9aac99ed75406b7827ef4d501d57b"],"text":"Repository development practice: contributors run `npm ci`, `npm run check`, and `cargo test --workspace`; Node.js is repository tooling and the npm delivery mechanism only.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_40fc69a90fc002613f7a30a1c6064415511c6b0478f2b0a5eab373826fffe3c5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_aaf18992084ecdf2cc87ca6fc6e194d59ba362b00def52bf2a35804f8acdbe8e","slc_b22cbb1edef665bfd896716ada44d5c9fa617771498821b24700d9aa839e1c59"],"source_ids":["src_52f9aac99ed75406b7827ef4d501d57b","src_db796d69c1fc52398e74d1a6b44b913e"],"text":"A Python SDK is provided with public objects including LocalTarget, DirectTarget, HostedTarget, Target, Preset, GraphSpec, UniformRuntime, RuntimePlan, RunRequest, and MergePlanRequest.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_44cf8958e4c800f453c1a19c8554b615d2ed9a324fbda16a9e7d5ebf8ec742ec","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_11f8c4516b5331b8558d3508290d43be530243e4f335e0751ae20846f15a88de"],"source_ids":["src_52f9aac99ed75406b7827ef4d501d57b"],"text":"The built-in software-change graph gives the goal to a worker, runs acceptance and code review in parallel, routes rejections to a repair worker with repeated reviews, and delivers accepted changes through Git, CI, and merge, routing delivery conflicts back through repair.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5e8d6d2cd50de0453cfb951f727b93071589e7c5f0dbcc7b3e2ab91ab8bd7145","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_0c6436f3a0567965b1eed57e4b205cf3a4aeb48bf53ecb18bc3be1dc33cae1d8","slc_c84ded3ab6adb4fa9b310c76fbb3931407cfb855ea8f5b19ff6cf1ef7ab12d3a"],"source_ids":["src_52f9aac99ed75406b7827ef4d501d57b","src_7f9af73b820450c1915da1e829aee56b"],"text":"The npm package installs a verified native binary for Linux x64/arm64, macOS x64/arm64, and Windows x64; native archives and SHA256 checksums are attached to each canonical vX.Y.Z GitHub Release.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_818463f4c2fa684eb98b22c72ada80d4bbad26936c4723c22692fa2849cc23b6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_c095d041f49829f786b80e2e92279508f008d2a04c201f6c9efb56eb76804bea","slc_d40136d5d413f67cc2a5c0f3fa94e023f4e4ae0dc2751494f469753cbb651d0c"],"source_ids":["src_52f9aac99ed75406b7827ef4d501d57b","src_9e6d59903dd75171b4088f2fa3c55749"],"text":"Every graph transition event is written to a durable SQLite ledger; after validating graph, runtime plan, and input, Zeroshot opens a durable ledger recording each node result.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_83ac5da94762939e603a1f3c8de18751326c883212be1f91ba75b9281a196049","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_9e7825c0cd0459849e6ce733c0579172b140da8e246bc3156751c09d4bed589f","slc_c095d041f49829f786b80e2e92279508f008d2a04c201f6c9efb56eb76804bea"],"source_ids":["src_52f9aac99ed75406b7827ef4d501d57b"],"text":"Control flow is authored data rather than hidden in prompts: sequence, parallel review, retry paths, delivery, and exit conditions are explicit before a run starts, and no runtime agent chooses the next step.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a1a4692a07a47c5a390306622ba5d6831a7c2387dc56bb1ad9af16920a256934","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_21a70b24cdbf798f292dbd7043254486678105c00505f45ff46185e9dd54588f","slc_ce3b3883f3c55a2c3be853b035586336e3e0b05d7b3f7fd715738c5d31490a6b"],"source_ids":["src_90b0c78528935a3e8e11aa0e72f252c5"],"text":"Subscription methods use generic framing: watch, logs, and agent/attach (and run/* equivalents) establish subscriptions via one JSON-RPC result, then use generic event, subscription/cancel, subscription/closed, and $/cancelRequest notifications; no method-specific event/cancel/closed methods exist on the wire.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a4795b7829a32e794d7ffaa6710fc796bae5316f23f6a7b22d0b3d60fba598e9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_136b7e601e2c7192185f802b5f1ff9a75c6c52b63e335440bb38bb3d000d8768"],"source_ids":["src_52f9aac99ed75406b7827ef4d501d57b"],"text":"Zeroshot turns a software goal into an explicit multi-agent graph: one agent implements, independent agents review, failures route into bounded repair, and delivery happens only after the graph's checks pass.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
{"access":"public","created_at":"2026-09-14T03:18:50Z","created_by_operation":"op_2be23d4685b745c394c83e37e7cf3309","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_de70252ddfbb707f3760df8955f60a739f681e71e19939772634fdbc98dafdb1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"the-open-engine/zeroshot@b550c15279c9 snapshot 2ab85c8a6208f2d8","timeframe":null},"slice_ids":["slc_85f7c0e5cccd9f4750c88c1b7fc896a9cc07bd67de3e98a09b7259bb3c980f9d"],"source_ids":["src_7f9af73b820450c1915da1e829aee56b"],"text":"Repository development practice: release jobs verify already-published immutable artifacts before completing missing steps, and recovery must use the same version, tag, and source commit without overwriting different artifacts.","updated_at":"2026-09-14T03:18:50Z","updated_by_operation":"op_2be23d4685b745c394c83e37e7cf3309"}
