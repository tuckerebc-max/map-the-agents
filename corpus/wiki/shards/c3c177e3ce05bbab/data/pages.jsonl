maturity":"draft","page_type":"entity","path":"pages/entities/axflow-axflow-c21dab2bffce.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"axflow/axflow","updated_at":"2026-09-14T03:37:09Z","updated_by_operation":"op_9d614e885cc54550b6861d4e95602708"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0c8b1d11d0dda7f91b093e1a17fb76ea47307498b572a4f5978c28d5a3f0cc09"],"opposing_claim_ids":[],"text":"The framework takes a code-first approach emphasizing developer flexibility and control, aiming to break LLM workflows into manageable, intuitive components."},{"claim_ids":["clm_1f283c213d58c1c4264ab1067d69a80940167b8713e59866908e6fe22f211f52"],"opposing_claim_ids":[],"text":"Axflow ships as a set of modules: @axflow/models (an SDK with React hooks and streaming utilities), axgen (connecting data to LLMs), and axeval (evaluating LLM output quality)."},{"claim_ids":["clm_83d130d5e84cca0be292bab5c3d0f9e266ff1eafd411c67336732d50d5f523cc"],"opposing_claim_ids":[],"text":"The project targets TypeScript developers building natural-language/LLM applications, with tutorials such as building a streaming React/Next.js chat app using @axflow/models with OpenAI token streaming."},{"claim_ids":["clm_988b67cf7efa11b03be8b9c76c850aa9d429f263a32dd08fca8bb11d25da9e03"],"opposing_claim_ids":[],"text":"Additional modules are planned but in progress: extract (document loading/transform/chunking for vector search), serve (LLM serving with throttling, analytics, logging middleware), and finetune."},{"claim_ids":["clm_c4143edb1b4e6c3f0d19bb876ce43c8501b1635e5a2ecd0d3a1557c3c9794265"],"opposing_claim_ids":[],"text":"Repository development practice: the repository displays a GitHub CI workflow badge, indicating a CI pipeline for the repo."},{"claim_ids":["clm_e24304db9ceb9a808d0c3d113785e84433afb70608f2297b841cb9fc541e20dd"],"opposing_claim_ids":[],"text":"Modules are designed for incremental, independent adoption, which also minimizes bundle size; together they form an end-to-end AI application framework."},{"claim_ids":["clm_f4d8ff03d004e6159f9fa1e7b10647596bf72c862df2425e8e192b8996fca55a"],"opposing_claim_ids":[],"text":"The @axflow/models SDK is documented as zero-dependency and modular."}],"claim_ids":["clm_0c8b1d11d0dda7f91b093e1a17fb76ea47307498b572a4f5978c28d5a3f0cc09","clm_1f283c213d58c1c4264ab1067d69a80940167b8713e59866908e6fe22f211f52","clm_83d130d5e84cca0be292bab5c3d0f9e266ff1eafd411c67336732d50d5f523cc","clm_988b67cf7efa11b03be8b9c76c850aa9d429f263a32dd08fca8bb11d25da9e03","clm_c4143edb1b4e6c3f0d19bb876ce43c8501b1635e5a2ecd0d3a1557c3c9794265","clm_e24304db9ceb9a808d0c3d113785e84433afb70608f2297b841cb9fc541e20dd","clm_f4d8ff03d004e6159f9fa1e7b10647596bf72c862df2425e8e192b8996fca55a"],"created_at":"2026-09-14T03:37:09Z","created_by_operation":"op_9d614e885cc54550b6861d4e95602708","id":"pg_562483f30deb5fe1847b234df7955e41","maturity":"draft","page_type":"source","path":"pages/sources/axflow-axflow-readme-md-46ed2a000a44-234df7955e41.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9e0809dc27c65324b3d4dfdff1b11a89"],"title":"axflow/axflow/README.md @ 46ed2a000a44","updated_at":"2026-09-14T03:37:09Z","updated_by_operation":"op_9d614e885cc54550b6861d4e95602708"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_05cc58f2eda14f098414c627032783f3f317cccd92de46297fb8ecaf7130d824"],"opposing_claim_ids":[],"text":"Modules are installed independently via npm (npm i axeval; npm install @axflow/models, axgen, axeval)."},{"claim_ids":["clm_1cef0102433248f9b952289a6deb3bb9621ebcad25da374b84dc7cc2c454d4aa"],"opposing_claim_ids":[],"text":"Axeval's API centers on EvalCases (prompt plus one or more evaluators), evaluators that score a prompt/response pair from 0 to 1, EvalResults with metadata like score and latency, Reports, and a Runner that executes suites against models."},{"claim_ids":["clm_6db913c302b502e925f1e8e876d8e95ebcbf3ca835cb451a098a59e4de9979fa"],"opposing_claim_ids":[],"text":"Axeval is a framework for test-driven LLM engineering: it supports unit-testing prompts, data-driven prompt iteration, and comparing models on latency, cost, and accuracy."},{"claim_ids":["clm_c1c7d0002a9a44688b55054083c625bd2bfba24388d47cf3ecbe7832715dd7bf"],"opposing_claim_ids":[],"text":"Built-in evaluators include match, includes, isValidJSON, and llmRubric, and users can write custom evaluators."},{"claim_ids":["clm_fa69ee4b9c919429de4b8b5e20c4efd472a0d31159c3250e03fbe5d7ef2a8f92"],"opposing_claim_ids":[],"text":"The Runner API lets users register named test suites bound to specific models (e.g., AnthropicCompletion 'claude-2', OpenAICompletion 'text-davinci-003') and run them, producing a report that can be output to formats such as stdout."}],"claim_ids":["clm_05cc58f2eda14f098414c627032783f3f317cccd92de46297fb8ecaf7130d824","clm_1cef0102433248f9b952289a6deb3bb9621ebcad25da374b84dc7cc2c454d4aa","clm_6db913c302b502e925f1e8e876d8e95ebcbf3ca835cb451a098a59e4de9979fa","clm_c1c7d0002a9a44688b55054083c625bd2bfba24388d47cf3ecbe7832715dd7bf","clm_fa69ee4b9c919429de4b8b5e20c4efd472a0d31159c3250e03fbe5d7ef2a8f92"],"created_at":"2026-09-14T03:37:09Z","created_by_operation":"op_9d614e885cc54550b6861d4e95602708","id":"pg_9d47175f646a57629c3