{"access":"public","created_at":"2026-09-14T03:37:09Z","created_by_operation":"op_9d614e885cc54550b6861d4e95602708","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6db913c302b502e925f1e8e876d8e95ebcbf3ca835cb451a098a59e4de9979fa","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"axflow/axflow@46ed2a000a44 snapshot c40d8b59470d8c68","timeframe":null},"slice_ids":["slc_466f822b16b10c180a09e3bd7e2f0dcae53c813149fd24bc4611930b39be6a9e","slc_b6f9dd7f8e65d8c9947056c6abbf88686436ee906fd16495317335fbc9cc65ef"],"source_ids":["src_eaf00bc5556d5b289b8649966db93ce8"],"text":"Axeval is a framework for test-driven LLM engineering: it supports unit-testing prompts, data-driven prompt iteration, and comparing models on latency, cost, and accuracy.","updated_at":"2026-09-14T03:37:09Z","updated_by_operation":"op_9d614e885cc54550b6861d4e95602708"}
