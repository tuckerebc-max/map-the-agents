{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9fea65200e655fec4a48fc9ec744f63253b3794aad7c70d19cf5b428759944d7"],"opposing_claim_ids":[],"text":"Repository development practice: code style rules include TypeScript strict with no any, named exports, Tailwind utility classes without inline styles, 2-space indentation, and mobile-first responsive design."},{"claim_ids":["clm_f3d87e2b9002e1a8ddce800c4c44f532b2ee04a293bcdde7dc49b558e401f9a7"],"opposing_claim_ids":[],"text":"Repository development practice: AGENTS.md instructs agents that this Next.js version has breaking changes and to read bundled docs in node_modules/next/dist/docs/ before writing code; the block is re-added by next dev."},{"claim_ids":["clm_ff33e314ee2f04f198b39a38cd20eedeaef7e109616e9f488193793f2905eaa2"],"opposing_claim_ids":[],"text":"The scaffolded stack is Next.js 16 (App Router, React 19, TypeScript strict), shadcn/ui with Radix primitives, Tailwind CSS v4 with oklch tokens, and Lucide React icons; Node.js 24+ is a prerequisite."}],"claim_ids":["clm_9fea65200e655fec4a48fc9ec744f63253b3794aad7c70d19cf5b428759944d7","clm_f3d87e2b9002e1a8ddce800c4c44f532b2ee04a293bcdde7dc49b558e401f9a7","clm_ff33e314ee2f04f198b39a38cd20eedeaef7e109616e9f488193793f2905eaa2"],"created_at":"2026-09-14T04:00:21Z","created_by_operation":"op_97a8bb0a8ac44811b2143f78ac9057d9","id":"pg_df72694194715237873d134eab012c2a","maturity":"draft","page_type":"source","path":"pages/sources/jcodesmore-ai-website-cloner-template-agents-md-92872bc40ced-134eab012c2a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7abeaba2fecd5942b36780f32ec2a630"],"title":"JCodesMore/ai-website-cloner-template/AGENTS.md @ 92872bc40ced","updated_at":"2026-09-14T04:00:21Z","updated_by_operation":"op_97a8bb0a8ac44811b2143f78ac9057d9"}
