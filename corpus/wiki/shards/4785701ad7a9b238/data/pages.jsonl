{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_189dd8cec21823ce72610430b1c7dfe1feb8452a17e418779e65208200a2b23b"],"opposing_claim_ids":[],"text":"The samples section contains an 'official' folder with stable releases (such as the current Vision module) and a 'research' folder with experimental or in-development samples."},{"claim_ids":["clm_5eb84a9a3318dadf907f8b72bc54b10561e1c8408a781de19f5985a6fb1d2e9d"],"opposing_claim_ids":[],"text":"The Vision AI DevKit hardware is manufactured through a partnership between Altek and eInfochips and uses the Qualcomm QCS603 chipset from the Qualcomm Vision Intelligence Platform."},{"claim_ids":["clm_622c6ea93a55540746e5f284a321e008810f8e5996039768031b706ee7ada06e"],"opposing_claim_ids":[],"text":"Repository development practice: the project adopts the Microsoft Open Source Code of Conduct, with questions directed to opencode@microsoft.com."},{"claim_ids":["clm_6309402ef9c95429c94d8b980a62b59591371b4124678cf49ecb9b7892fcac4a"],"opposing_claim_ids":[],"text":"The telemetry notice states that features may enable collection of data from application users, and that anyone using those features must comply with applicable law and provide notices plus Microsoft's privacy statement."},{"claim_ids":["clm_9c5a84fceda98519e1eb2070d5aba9712de230e28520019c6b76877e67f62d2b"],"opposing_claim_ids":[],"text":"The repository provides components for developing neural network models intended for deployment to Vision AI DevKit hardware."},{"claim_ids":["clm_aa33df1f3e5328dc13a41d293a7e7f8c975290e55f7b41b619058ec5411c0490"],"opposing_claim_ids":[],"text":"The software uses the Azure IoT Client SDK, which may collect usage information and send it to Microsoft."},{"claim_ids":["clm_b775e3dff52db144b7e7605a7b5b162a3bd276c7faf63b39f4ec43c3fbfee2ab"],"opposing_claim_ids":[],"text":"The DevKit can be purchased from Arrow Electronics, and full documentation is hosted at the aka.ms/VAIDKGetStarted link."},{"claim_ids":["clm_bc8cc2932153a637ae5173cdf24dd774b96f4853d9cdd856f729e791dd648cdc"],"opposing_claim_ids":[],"text":"Repository development practice: most contributions require agreeing to a Microsoft Contributor License Agreement, and a CLA-bot automatically labels or comments on pull requests to determine whether a CLA is needed."},{"claim_ids":["clm_be54422a31a1705eb72d24a35ecc28f93dcb79bc4add153c3aa30a6fb6dd77dc"],"opposing_claim_ids":[],"text":"Repository development practice: issue reporters are asked to visit a Get Help page and, if unresolved, file a GitHub issue labeled Bug, Feature Request, or Support Needed."}],"claim_ids":["clm_189dd8cec21823ce72610430b1c7dfe1feb8452a17e418779e65208200a2b23b","clm_5eb84a9a3318dadf907f8b72bc54b10561e1c8408a781de19f5985a6fb1d2e9d","clm_622c6ea93a55540746e5f284a321e008810f8e5996039768031b706ee7ada06e","clm_6309402ef9c95429c94d8b980a62b59591371b4124678cf49ecb9b7892fcac4a","clm_9c5a84fceda98519e1eb2070d5aba9712de230e28520019c6b76877e67f62d2b","clm_aa33df1f3e5328dc13a41d293a7e7f8c975290e55f7b41b619058ec5411c0490","clm_b775e3dff52db144b7e7605a7b5b162a3bd276c7faf63b39f4ec43c3fbfee2ab","clm_bc8cc2932153a637ae5173cdf24dd774b96f4853d9cdd856f729e791dd648cdc","clm_be54422a31a1705eb72d24a35ecc28f93dcb79bc4add153c3aa30a6fb6dd77dc"],"created_at":"2026-09-14T04:09:17Z","created_by_operation":"op_b58c1b7e79e2464dacb5d8eafa2c1866","id":"pg_d35d3155e0b85cedbe5a44b791bf3fe6","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-vision-ai-developer-kit-readme-md-5701d3a6425c-44b791bf3fe6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7d9d04209f085c3d85d7148c33c1bdd6"],"title":"microsoft/vision-ai-developer-kit/README.md @ 5701d3a6425c","updated_at":"2026-09-14T04:09:17Z","updated_by_operation":"op_b58c1b7e79e2464dacb5d8eafa2c1866"}
