{"access":"public","created_at":"2026-09-14T01:29:51Z","created_by_operation":"op_5f86993659064bb6a7f4b56e07e51e44","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_691a1f4d399a669cfd4fdcde4402f2b469d32be029b3ea301d9bc41312e76650","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"adrida/hud-mode@98571ccf7101 snapshot 278eae6eb4afb581","timeframe":null},"slice_ids":["slc_e77d4bbf271ff83e1d4a0b47097b34367b1bd91e785a0e914b8ce669f6ec9062"],"source_ids":["src_6f9f4ad4d35352fdbddc65280f637215"],"text":"Instruments and the activity line update in place rather than scrolling; the prompt bar stays writable so messages typed mid-turn queue and fire when the answer lands.","updated_at":"2026-09-14T01:29:51Z","updated_by_operation":"op_5f86993659064bb6a7f4b56e07e51e44"}
