{"access":"public","created_at":"2026-09-14T02:08:09Z","created_by_operation":"op_cba94c77f48e44868cf06d251f4e0583","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_343c0d65b2c8bcc244f58e17ffb1369dbb9470a8d0e9b69c46ec807d1bd20289","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"juliusbrussee/caveman-code@3a21be115c32 snapshot 5d4b7561aa9d2419","timeframe":null},"slice_ids":["slc_312a96afe6322b82a0b3589cd630d421de31ed358ea651fab696198cf6d07c3d","slc_37b9be999adb2e3267785e8bb591469dc9e00a27eeea821370906960c837c79e","slc_5ab7a415fa308a59c2804eead2040cd48f7cf8f9a3ec7450d763d874b603b6a6","slc_bd40190119c9161ca1aaf0f91664c3ff1d85db0b69078cdcc770e8bc927e76c8","slc_f6c109063a37743fa2d80ad18207190c5766c6c970ffe386d05c2db8cd26d7f8"],"source_ids":["src_14d6a8cae1675fe4a0ca27d2a7fb3587","src_40b843c1c27a55bfa661dab740534527"],"text":"Persistent memory is delegated to cavemem (hybrid BM25 + local vectors on SQLite/FTS5); the agent exposes memory_search and memory_save tools, auto-injects relevant recall each turn capped at 2k tokens by default, and can fall back to plain markdown files via memory.provider: files.","updated_at":"2026-09-14T02:08:09Z","updated_by_operation":"op_cba94c77f48e44868cf06d251f4e0583"}
