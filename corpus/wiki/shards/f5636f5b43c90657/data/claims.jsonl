{"access":"public","created_at":"2026-09-14T02:08:09Z","created_by_operation":"op_cba94c77f48e44868cf06d251f4e0583","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e45d6fc99ae27f816d6b6bc4816b49ffb345e2c98b59007ae33c9fde016aa548","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"juliusbrussee/caveman-code@3a21be115c32 snapshot 5d4b7561aa9d2419","timeframe":null},"slice_ids":["slc_cb5e4ed39085b65b86f726e8b9b1daed975a8c7796b38edb217b153d2716f3a4"],"source_ids":["src_40b843c1c27a55bfa661dab740534527"],"text":"The project is marked frozen as of August 2026: it still installs and works but receives no new features or fixes, and its lesson moved into the separate 'caveman' project.","updated_at":"2026-09-14T02:08:09Z","updated_by_operation":"op_cba94c77f48e44868cf06d251f4e0583"}
