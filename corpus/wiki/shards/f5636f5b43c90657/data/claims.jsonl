{"access":"public","created_at":"2026-09-14T02:08:09Z","created_by_operation":"op_cba94c77f48e44868cf06d251f4e0583","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b1005c391272f4010296e5c50b86dab123f6880cc8507a2a3974c831c0503e3a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"juliusbrussee/caveman-code@3a21be115c32 snapshot 5d4b7561aa9d2419","timeframe":null},"slice_ids":["slc_5f51f6f9a4e39c3a89cac74037cf06b3891efbf15c6535d4dccd16c81ab0a603","slc_709afce3ebd90bad57954d57dd42e158438e96f995b112704aa9257c44ddad25","slc_8085c7dd3de308f611384b47e483f3c2826985d939ad9977bd8e0bdfc6475d99","slc_bf9e573e331c5d1e7df124d89c08943b2956f1f85751adfc5ef0951150c2d6c9"],"source_ids":["src_40b843c1c27a55bfa661dab740534527","src_591d832f4fd05fcaa988d71a13635a94"],"text":"The repository is described as a TypeScript monorepo of 9 packages, with the coding-agent package exporting full TypeScript types and hosting the daemon's OpenAPI 3.1 spec.","updated_at":"2026-09-14T02:08:09Z","updated_by_operation":"op_cba94c77f48e44868cf06d251f4e0583"}
{"access":"public","created_at":"2026-09-14T02:08:09Z","created_by_operation":"op_cba94c77f48e44868cf06d251f4e0583","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b35f0fbc5e4b02bb5463955a71b601abe606348617352571d4db845d0270eb52","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"juliusbrussee/caveman-code@3a21be115c32 snapshot 5d4b7561aa9d2419","timeframe":null},"slice_ids":["slc_a35c8aa05c139c11180457612da63cac09d3723283825544e7c8916b00acee67"],"source_ids":["src_40b843c1c27a55bfa661dab740534527"],"text":"A daemon mode ('caveman serve --port 39245') stores sessions in SQLite that survive SSH drops, supports TUI attach, and can dispatch prompts to remote 'caveman worker' processes by prefixing a prompt with '&'.","updated_at":"2026-09-14T02:08:09Z","updated_by_operation":"op_cba94c77f48e44868cf06d251f4e0583"}
{"access":"public","created_at":"2026-09-14T02:08:09Z","created_by_operation":"op_cba94c77f48e44868cf06d251f4e0583","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bea2baea5a088d570b286a5853cc0e0cbac3b62a6231622e7c187824fe442272","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"juliusbrussee/caveman-code@3a21be115c32 snapshot 5d4b7561aa9d2419","timeframe":null},"slice_ids":["slc_cb5e4ed39085b65b86f726e8b9b1daed975a8c7796b38edb217b153d2716f3a4"],"source_ids":["src_40b843c1c27a55bfa661dab740534527"],"text":"The package installs a 'caveman' binary that shadows the CLI from the newer caveman repo, so one must be uninstalled before installing the other.","updated_at":"2026-09-14T02:08:09Z","updated_by_operation":"op_cba94c77f48e44868cf06d251f4e0583"}
