{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_27c93638f02426190d0ea7446a3a2a91b5f46deffb771b27e3cb567da6ad602f"],"opposing_claim_ids":[],"text":"The project states a philosophy of not sacrificing simplicity for power, aiming for a strong out-of-the-box experience plus advanced features."},{"claim_ids":["clm_308f16d5155443471f950fd6c4aeebee3d5e581fcbf6951d3f9623d4e73dc518"],"opposing_claim_ids":[],"text":"Repository development practice: installing from the main branch is not recommended, as it is pre-release code that may be broken and can corrupt the cache for future released versions."},{"claim_ids":["clm_31b40d585f1939d05d6d9c5ce73b4edffca7dca3fac3d25344a93ea3d2c6d800"],"opposing_claim_ids":[],"text":"Zellij advertises deep customizability, layout-based personal automation, multiplayer collaboration, floating and stacked panes, and a plugin system for any language compiling to WebAssembly."},{"claim_ids":["clm_47fd3457a1cf007496c591329b579ec1618d2cb5318b62399d1869b33cecd1ba"],"opposing_claim_ids":[],"text":"Zellij includes a built-in web client, making a terminal optional for using it."},{"claim_ids":["clm_51e0fd0eb467bf1f3f4704f54a292fdf46d7291ecbb04c59ccaf433981e40c44"],"opposing_claim_ids":[],"text":"Zellij is a workspace aimed at developers, ops-oriented people, and terminal enthusiasts; similar programs are known as terminal multiplexers."},{"claim_ids":["clm_c01ef3753165a9bd7b39f9dcae88b9c0e8db5d41dc6b8b53cd5fd28e4595b0df"],"opposing_claim_ids":[],"text":"Repository development practice: after cloning, debug builds run via `cargo xtask run` and all tests via `cargo xtask test`, with more build commands documented in CONTRIBUTING.md."}],"claim_ids":["clm_27c93638f02426190d0ea7446a3a2a91b5f46deffb771b27e3cb567da6ad602f","clm_308f16d5155443471f950fd6c4aeebee3d5e581fcbf6951d3f9623d4e73dc518","clm_31b40d585f1939d05d6d9c5ce73b4edffca7dca3fac3d25344a93ea3d2c6d800","clm_47fd3457a1cf007496c591329b579ec1618d2cb5318b62399d1869b33cecd1ba","clm_51e0fd0eb467bf1f3f4704f54a292fdf46d7291ecbb04c59ccaf433981e40c44","clm_c01ef3753165a9bd7b39f9dcae88b9c0e8db5d41dc6b8b53cd5fd28e4595b0df"],"created_at":"2026-09-14T04:33:58Z","created_by_operation":"op_7ecbe6767d5f458499cfb965255bfdbb","id":"pg_1a4894a70c695f628303f73016f58bed","maturity":"draft","page_type":"source","path":"pages/sources/zellij-org-zellij-readme-md-a162323384df-f73016f58bed.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_45e1c28e5aa45b2aa8c2ab77a32756d4"],"title":"zellij-org/zellij/README.md @ a162323384df","updated_at":"2026-09-14T04:33:58Z","updated_by_operation":"op_7ecbe6767d5f458499cfb965255bfdbb"}
