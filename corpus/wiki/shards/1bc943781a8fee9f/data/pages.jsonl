{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_22bb32d5e4add30366d429a108cefd1a23f0956e9ef7541bb190e67a61e1ec18"],"opposing_claim_ids":[],"text":"The README lists features including code explanation, an implementation in Rust, built-in logging and telemetry, and a command-line interface."},{"claim_ids":["clm_35d3a07131ee7589139a22872daed931d6d5c0b6e51d51b7bccb169aadad7285"],"opposing_claim_ids":[],"text":"The `explain` command provides explanations for code snippets or files and is invoked as `Groundhog explain`."},{"claim_ids":["clm_491260cab9932bceaad81625ad2103ff0c1d111cb1c4522f2a08554fd638b030"],"opposing_claim_ids":[],"text":"Repository development practice: building from source involves cloning the repository and running `cargo build`, and tests are run with `cargo test`; a Rust toolchain is listed as a prerequisite."},{"claim_ids":["clm_4ca7204c8ce262381edb4bb1c0d9c78b90d5d71ced2e34e1deee8e4801a69b89"],"opposing_claim_ids":[],"text":"Specifications are organized in a specs/ directory covering architecture, CLI interface, logging and telemetry, and individual commands."},{"claim_ids":["clm_79499fe270d95e324bfa788eb8039624ff04c7247ac0f6da8df2316e4a5eed5f"],"opposing_claim_ids":[],"text":"The maintainer asks that GitHub issues not be raised about things not working, since the community/support model has not yet been decided."},{"claim_ids":["clm_a3e852e2b6e0795803a3ad42a512b352937cacbcaba2720eb600dbeffbe74e7f"],"opposing_claim_ids":[],"text":"The product exposes a CLI with the command structure `Groundhog <command> [options]`."},{"claim_ids":["clm_af918c81a89c9b434f5be93dfe3bc716b30b11592fccf363088cf0b4d8348e14"],"opposing_claim_ids":[],"text":"Groundhog's stated primary purpose is educational: teaching people how coding agents like Cursor work under the hood, built incrementally as part of a public series."},{"claim_ids":["clm_afe600e671cc452b3fa310c144d19714b96e4ce5267e183251976cadbfd7b441"],"opposing_claim_ids":[],"text":"The project describes itself as a teaching tool first and points users wanting a full-featured product to alternatives such as Goose, Roo/Cline, Aider, or AllHands."},{"claim_ids":["clm_bb5ee36d8fd3dbd4460b0e1ede2e81db88a308215b0e95874598d90e030c04fa"],"opposing_claim_ids":[],"text":"The README notes more commands will be added in future releases, and installation instructions, contribution guidelines, and license information are placeholders yet to be added."}],"claim_ids":["clm_22bb32d5e4add30366d429a108cefd1a23f0956e9ef7541bb190e67a61e1ec18","clm_35d3a07131ee7589139a22872daed931d6d5c0b6e51d51b7bccb169aadad7285","clm_491260cab9932bceaad81625ad2103ff0c1d111cb1c4522f2a08554fd638b030","clm_4ca7204c8ce262381edb4bb1c0d9c78b90d5d71ced2e34e1deee8e4801a69b89","clm_79499fe270d95e324bfa788eb8039624ff04c7247ac0f6da8df2316e4a5eed5f","clm_a3e852e2b6e0795803a3ad42a512b352937cacbcaba2720eb600dbeffbe74e7f","clm_af918c81a89c9b434f5be93dfe3bc716b30b11592fccf363088cf0b4d8348e14","clm_afe600e671cc452b3fa310c144d19714b96e4ce5267e183251976cadbfd7b441","clm_bb5ee36d8fd3dbd4460b0e1ede2e81db88a308215b0e95874598d90e030c04fa"],"created_at":"2026-09-14T03:53:42Z","created_by_operation":"op_18b0b82409664a2b9d00749495897cca","id":"pg_c70d32051d75535bafcfb2da401c36bd","maturity":"draft","page_type":"source","path":"pages/sources/ghuntley-groundhog-readme-md-3844519a70ed-b2da401c36bd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f709818d2080562b87c9f08d256b7697"],"title":"ghuntley/groundhog/README.md @ 3844519a70ed","updated_at":"2026-09-14T03:53:42Z","updated_by_operation":"op_18b0b82409664a2b9d00749495897cca"}
