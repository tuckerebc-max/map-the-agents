{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_135d50fe0c8fa4e894bcef14b801493a5e5e7c714018a3e5c23a11e7181f13b4"],"opposing_claim_ids":[],"text":"Repository development practice: contributors branch from main and open PRs; the local gate is pnpm typecheck && pnpm lint plus the test files covering touched code, with CI's green check as the gate of record and releases handled by CI-only tag-and-release workflows."},{"claim_ids":["clm_610757db68efc13a5c146f0270bdc8ffdc2a2ae12ae9d34c44191ddaf9e9cc13"],"opposing_claim_ids":[],"text":"Repository development practice: the repo is a turbo monorepo requiring Node 22+ and pnpm 11; PRs are merged publicly then imported into a private monorepo by a maintainer-run upstream-import workflow."}],"claim_ids":["clm_135d50fe0c8fa4e894bcef14b801493a5e5e7c714018a3e5c23a11e7181f13b4","clm_610757db68efc13a5c146f0270bdc8ffdc2a2ae12ae9d34c44191ddaf9e9cc13"],"created_at":"2026-09-14T02:37:55Z","created_by_operation":"op_a924ceffdbd0485398ac56ff7c2264b8","id":"pg_289e5ed8827850a8ab028906a3ebc387","maturity":"draft","page_type":"source","path":"pages/sources/runvendo-vendo-contributing-md-4d149938d7d3-8906a3ebc387.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_86e6532447a9562b89c5c2e3b02005c7"],"title":"runvendo/vendo/CONTRIBUTING.md @ 4d149938d7d3","updated_at":"2026-09-14T02:37:55Z","updated_by_operation":"op_a924ceffdbd0485398ac56ff7c2264b8"}
