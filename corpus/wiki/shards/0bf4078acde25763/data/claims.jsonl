{"access":"public","created_at":"2026-09-14T02:37:55Z","created_by_operation":"op_a924ceffdbd0485398ac56ff7c2264b8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c5639129a9e23d32896f707cc01f258322d3f8d36af5094e9587a83ae588dd84","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"runvendo/vendo@4d149938d7d3 snapshot d1f8bb85b9842298","timeframe":null},"slice_ids":["slc_4854be5316dc128c993cb96d349ff06ce3aaf9cc7632851157b347f4a2339d0b","slc_b3c6596486daf1c43b3194b322c8df857f62760b66ab497432ecf3e5380f5abf"],"source_ids":["src_153217620dfd5e5490a9968c1aaa3b86"],"text":"Vendo runs a streaming agent that works with any AI SDK LanguageModel, and extracts the host API into tools the agent executes as the signed-in user.","updated_at":"2026-09-14T02:37:55Z","updated_by_operation":"op_a924ceffdbd0485398ac56ff7c2264b8"}
