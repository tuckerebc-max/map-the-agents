{"access":"public","created_at":"2026-09-14T02:37:55Z","created_by_operation":"op_a924ceffdbd0485398ac56ff7c2264b8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0439fe278b5f000b295c49b89f010875e5d73395fb216a5a60d5ecc760885200","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"runvendo/vendo@4d149938d7d3 snapshot d1f8bb85b9842298","timeframe":null},"slice_ids":["slc_61d6a194640dd4634a657ce4c233f73bb67f9d917f4c57c6b43fe5ee09dfcdc2"],"source_ids":["src_153217620dfd5e5490a9968c1aaa3b86"],"text":"Vendo is an embedded agent for B2B SaaS that acts through the host product's own API as the signed-in user and renders generated UI in a sandboxed, brand-native surface without touching host source code.","updated_at":"2026-09-14T02:37:55Z","updated_by_operation":"op_a924ceffdbd0485398ac56ff7c2264b8"}
