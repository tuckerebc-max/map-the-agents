{"access":"public","created_at":"2026-09-14T02:37:55Z","created_by_operation":"op_a924ceffdbd0485398ac56ff7c2264b8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8471d28b3fc8babfa88846d5467c8eb94d234ff4466defc381217d5f026619a3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"runvendo/vendo@4d149938d7d3 snapshot d1f8bb85b9842298","timeframe":null},"slice_ids":["slc_5069a384b15f4d2c08980e11be100e67cccb0a74ddb7785baad633b46529bfb6"],"source_ids":["src_153217620dfd5e5490a9968c1aaa3b86"],"text":"Generated components run in an iframe jail with connect-src 'none', escalating to a sandboxed server only when needed.","updated_at":"2026-09-14T02:37:55Z","updated_by_operation":"op_a924ceffdbd0485398ac56ff7c2264b8"}
