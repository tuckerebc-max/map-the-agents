{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3480f2b93dc74583b8dcaf3484e4e42abbc5b88f2cd4eaf38322ee79746522ea"],"opposing_claim_ids":[],"text":"Configuration comes from config.yaml overlaid by env vars only where ${VAR:default} placeholders exist; memory settings default to 0 for auto-derivation from host RAM."}],"claim_ids":["clm_3480f2b93dc74583b8dcaf3484e4e42abbc5b88f2cd4eaf38322ee79746522ea"],"created_at":"2026-09-14T04:17:42Z","created_by_operation":"op_544a87d6ad4d499ebbdc8bc99cd6dff0","id":"pg_7a33f3988405529dbce2e57eee890235","maturity":"draft","page_type":"source","path":"pages/sources/qcri-codebadger-docs-configuration-md-857adcabe386-e57eee890235.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_33397955b3c35b0ab0631ca71d8573e4"],"title":"qcri/codebadger/docs/configuration.md @ 857adcabe386","updated_at":"2026-09-14T04:17:42Z","updated_by_operation":"op_544a87d6ad4d499ebbdc8bc99cd6dff0"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:17:42Z","created_by_operation":"op_544a87d6ad4d499ebbdc8bc99cd6dff0","id":"pg_aca6440f19d8568db4d171f4c83b5421","maturity":"draft","page_type":"source","path":"pages/sources/qcri-codebadger-trophies-md-857adcabe386-71f4c83b5421.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b2ae9b6e41b6563ea35584d4e3410f89"],"title":"qcri/codebadger/TROPHIES.md @ 857adcabe386","updated_at":"2026-09-14T04:17:42Z","updated_by_operation":"op_544a87d6ad4d499ebbdc8bc99cd6dff0"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_525758f066a3868907d88ac5d23d4fc4ce4477bbc18dbd70acfdf856a9c23095"],"opposing_claim_ids":[],"text":"Joern runs out-of-process in Docker; a Python FastMCP server orchestrates CPG generation, a memory-aware query-server pool, caching, and a durable job queue."},{"claim_ids":["clm_b70b2702076dc089762bdc197e643d4e093417d6d2ed28ad5e42295b64c90b97"],"opposing_claim_ids":[],"text":"Postgres stores catalog, tool cache, findings, and the durable job queue; Redis holds cross-process query locks and the pool ledger, and the server refuses to boot if either is unreachable."},{"claim_ids":["clm_c4d3ec1a1eff10baba78763332f400021c9f4b3d26516b39a80d40ffed4cf37f"],"opposing_claim_ids":[],"text":"CPGs are disk-cached by content hash; sleeping servers cost no RAM and wake by re-importing the cached .bin on the next query."},{"claim_ids":["clm_cad58bb0f79f261bb375a9cf2b3748f801aa7ed68c4451b0a78201a56c2e41a1"],"opposing_claim_ids":[],"text":"A GET /health endpoint probes joern, postgres, redis, docker, and cpg_queue concurrently, returning up/partial/down with HTTP 200/503 for orchestrators."},{"claim_ids":["clm_d5b7cab0ede4e71c693091319690d6b5c4a003541a2e1dd4a0d40724360426a9"],"opposing_claim_ids":[],"text":"Admission is governed by a memory budget rather than a fixed server count: heap tiers derive from CPG size, with LRU eviction, an RSS backstop, and an idle-TTL reaper (default 600s)."},{"claim_ids":["clm_eddbab0b459a32ee1bbd15d57e34d03969dc32e68f2862158c49eb5082a139de"],"opposing_claim_ids":[],"text":"Repository development practice: docs/contributing.md covers dev setup, tests, and guidelines, and tests/ contains unit and integration suites per the repository layout."}],"claim_ids":["clm_525758f066a3868907d88ac5d23d4fc4ce4477bbc18dbd70acfdf856a9c23095","clm_b70b2702076dc089762bdc197e643d4e093417d6d2ed28ad5e42295b64c90b97","clm_c4d3ec1a1eff10baba78763332f400021c9f4b3d26516b39a80d40ffed4cf37f","clm_cad58bb0f79f261bb375a9cf2b3748f801aa7ed68c4451b0a78201a56c2e41a1","clm_d5b7cab0ede4e71c693091319690d6b5c4a003541a2e1dd4a0d40724360426a9","clm_eddbab0b459a32ee1bbd15d57e34d03969dc32e68f2862158c49eb5082a139de"],"created_at":"2026-09-14T04:17:42Z","created_by_operation":"op_544a87d6ad4d499ebbdc8bc99cd6dff0","id":"pg_b5e63390d775590ba8dad88c58db1ab8","maturity":"draft","page_type":"source","path":"pages/sources/qcri-codebadger-docs-architecture-md-857adcabe386-d88c58db1ab8.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0ef6494d1cdb550fb70fc65f0a6782ba"],"title":"qcri/codebadger/docs/architecture.md @ 857adcabe386","updated_at":"2026-09-14T04:17:42Z","updated_by_operation":"op_544a87d6ad4d499ebbdc8bc99cd6dff0"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_a3414dc7335b049bfb74f9de522a114993622259c9159041b5874cb060cfa8d1"],"opposing_claim_ids":[],"text":"codebadger is a containerized MCP server giving AI agents queryable access to codebase structure and data flow via Joern Code Property Graphs."},{"claim_ids":["clm_afb163250a804e714901a4165b99e9bac622ef5881646d1fa92407fc0cfe2389"],"opposing_claim_ids":[],"text":"It accepts a Git repository, local path, or pasted snippet, builds a CPG, and exposes it over MCP for CPGQL queries, taint tracing, slicing, and vulnerability hunting."},{"claim_ids":["clm_eddbab0b459a32ee1bbd15d57e34d03969dc32e68f2862158c49eb5082a139de"],"opposing_claim_ids":[],"text":"Repository development practice: docs/contributing.md covers dev setup, tests, and guidelines, and tests/ contains unit and integration suites per the repository layout."}],"claim_ids":["clm_a3414dc7335b049bfb74f9de522a114993622259c9159041b5874cb060cfa8d1","clm_afb163250a804e714901a4165b99e9bac622ef5881646d1fa92407fc0cfe2389","clm_eddbab0b459a32ee1bbd15d57e34d03969dc32e68f2862158c49eb5082a139de"],"created_at":"2026-09-14T04:17:42Z","created_by_operation":"op_544a87d6ad4d499ebbdc8bc99cd6dff0","id":"pg_cd9fce2118eb588489c859ff9e0118ef","maturity":"draft","page_type":"source","path":"pages/sources/qcri-codebadger-readme-md-857adcabe386-59ff9e0118ef.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ef788ac249965ceb908dded43a823db8"],"title":"qcri/codebadger/README.md @ 857adcabe386","updated_at":"2026-09-14T04:17:42Z","updated_by_operation":"op_544a87d6ad4d499ebbdc8bc99cd6dff0"}
