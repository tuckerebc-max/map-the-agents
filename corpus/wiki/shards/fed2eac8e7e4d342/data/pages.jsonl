{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_8d53a7077166165c222faeffffa1630d57fb4c192fa056703e754080a92e1e81"],"opposing_claim_ids":[],"text":"Memory classes such as UnconstrainedMemory store BaseMessage objects with add/addMany, expose messages, isEmpty, asReadOnly, and reset, and can be passed to LLM generate calls."}],"claim_ids":["clm_8d53a7077166165c222faeffffa1630d57fb4c192fa056703e754080a92e1e81"],"created_at":"2026-09-14T02:00:10Z","created_by_operation":"op_b8071f0fb3da45d89865505b463104e4","id":"pg_7c910017b05e552d968cd95cb3258af1","maturity":"draft","page_type":"source","path":"pages/sources/clarisseio-python-agents-docs-memory-md-84c3bdc93ecd-d95cb3258af1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7fc872b5c47555819a045bc995aa3af0"],"title":"clarisseIO/python-agents/docs/memory.md @ 84c3bdc93ecd","updated_at":"2026-09-14T02:00:10Z","updated_by_operation":"op_b8071f0fb3da45d89865505b463104e4"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:00:10Z","created_by_operation":"op_b8071f0fb3da45d89865505b463104e4","id":"pg_8c73248ad7c256b9b9b4b044b20c5178","maturity":"draft","page_type":"source","path":"pages/sources/clarisseio-python-agents-docs-tools-md-84c3bdc93ecd-b044b20c5178.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9747a14a02a45a86acd5b424d5d2768e"],"title":"clarisseIO/python-agents/docs/tools.md @ 84c3bdc93ecd","updated_at":"2026-09-14T02:00:10Z","updated_by_operation":"op_b8071f0fb3da45d89865505b463104e4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1e1d0808139d05dba3864b86d25529872625311a4effe2d41a99e60192c16b84"],"opposing_claim_ids":[],"text":"The framework ships modules for agents, LLMs, prompt templating (Mustache-based), memory, tools, cache, errors, adapters, and logger, with agents and LLMs described as base classes defining common interfaces."},{"claim_ids":["clm_9c4e6d06d460d4142badf7aa52e19bce7e1bccf67582aff4296e4ed4dc407e4e"],"opposing_claim_ids":[],"text":"The run method supports an observe callback exposing an emitter where listeners can subscribe to events such as 'update' during execution; observe is also supported on tools and LLMs."},{"claim_ids":["clm_a8de7343144be5b87745fe02e08557bee254684a2e777138baec5ccf4c9f557a"],"opposing_claim_ids":[],"text":"The framework is designed to perform robustly with IBM Granite and Llama 3.x models, with optimization for other popular LLMs stated as ongoing work."},{"claim_ids":["clm_dde7c03a70959a2e0be462959b04513032da6fa5df74c4f487b3c7f017da1258"],"opposing_claim_ids":[],"text":"Agents are constructed with an LLM, memory, and tools, and run via an awaited run({prompt}) call whose result exposes response.result.text."},{"claim_ids":["clm_e0f554009905401c66358f2863bc660907310f45ee2d059481676b150e47bcbf"],"opposing_claim_ids":[],"text":"The legal notice states the code is an IBM open-source project, not an IBM product, with no obligation to provide enhancements, updates, support, or ongoing maintenance."},{"claim_ids":["clm_e323144efd2cd4e2b3eed95db1b65ff5f592b13cb7d11b6738292f13d1cc45e7"],"opposing_claim_ids":[],"text":"The package installs via npm or yarn as 'Clarisse-agent-framework', and examples use an Ollama chat LLM adapter defaulting to llama3.1 (8B) with the 70B model recommended."},{"claim_ids":["clm_f04908d4897156bb7710f69f1b00a1f1d173ef83a828ad73d94ebf0ca2c01ec2"],"opposing_claim_ids":[],"text":"Repository development practice: local setup involves cloning, yarn install --immutable && yarn prepare, creating .env from .env.template, and running examples via yarn start with a file path; contributions follow CONTRIBUTING.md."}],"claim_ids":["clm_1e1d0808139d05dba3864b86d25529872625311a4effe2d41a99e60192c16b84","clm_9c4e6d06d460d4142badf7aa52e19bce7e1bccf67582aff4296e4ed4dc407e4e","clm_a8de7343144be5b87745fe02e08557bee254684a2e777138baec5ccf4c9f557a","clm_dde7c03a70959a2e0be462959b04513032da6fa5df74c4f487b3c7f017da1258","clm_e0f554009905401c66358f2863bc660907310f45ee2d059481676b150e47bcbf","clm_e323144efd2cd4e2b3eed95db1b65ff5f592b13cb7d11b6738292f13d1cc45e7","clm_f04908d4897156bb7710f69f1b00a1f1d173ef83a828ad73d94ebf0ca2c01ec2"],"created_at":"2026-09-14T02:00:10Z","created_by_operation":"op_b8071f0fb3da45d89865505b463104e4","id":"pg_9d571ec5fe0758a080eac3180d2692ba","maturity":"draft","page_type":"source","path":"pages/sources/clarisseio-python-agents-readme-md-84c3bdc93ecd-c3180d2692ba.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f18ca62e82445030871acb4bf623017b"],"title":"clarisseIO/python-agents/README.md @ 84c3bdc93ecd","updated_at":"2026-09-14T02:00:10Z","updated_by_operation":"op_b8071f0fb3da45d89865505b463104e4"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:00:10Z","created_by_operation":"op_b8071f0fb3da45d89865505b463104e4","id":"pg_b163130c540e523a9e8144f5092df031","maturity":"draft","page_type":"source","path":"pages/sources/clarisseio-python-agents-docs-sidebar-md-84c3bdc93ecd-44f5092df031.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ddca83a0c2875b5f9235c06c26207e13"],"title":"clarisseIO/python-agents/docs/_sidebar.md @ 84c3bdc93ecd","updated_at":"2026-09-14T02:00:10Z","updated_by_operation":"op_b8071f0fb3da45d89865505b463104e4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9c4e6d06d460d4142badf7aa52e19bce7e1bccf67582aff4296e4ed4dc407e4e"],"opposing_claim_ids":[],"text":"The run method supports an observe callback exposing an emitter where listeners can subscribe to events such as 'update' during execution; observe is also supported on tools and LLMs."},{"claim_ids":["clm_e7e602b45d064b2a5569a86a027686ed51a26a0ad69d97c89f1d5fa88aa6a55e"],"opposing_claim_ids":[],"text":"An Emitter observability component lets code emit and match events by name, wildcard patterns, filter functions (e.g. creator instanceof BaseLLM), or regex, and supports piping events between emitters."}],"claim_ids":["clm_9c4e6d06d460d4142badf7aa52e19bce7e1bccf67582aff4296e4ed4dc407e4e","clm_e7e602b45d064b2a5569a86a027686ed51a26a0ad69d97c89f1d5fa88aa6a55e"],"created_at":"2026-09-14T02:00:10Z","created_by_operation":"op_b8071f0fb3da45d89865505b463104e4","id":"pg_c40448f5c3cc5a73a4d813f4a95998a0","maturity":"draft","page_type":"source","path":"pages/sources/clarisseio-python-agents-docs-emitter-md-84c3bdc93ecd-13f4a95998a0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_764ad1d0e96b5ceb8dffb452451711af"],"title":"clarisseIO/python-agents/docs/emitter.md @ 84c3bdc93ecd","updated_at":"2026-09-14T02:00:10Z","updated_by_operation":"op_b8071f0fb3da45d89865505b463104e4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_66b7a4cfb127b60833caf7c04e8539168c4f11e21546b810314e7ddcf9469ead"],"opposing_claim_ids":[],"text":"Caches expose async set/get/has/delete/clear/size operations, and custom caches are created by extending BaseCache, whose example also includes createSnapshot and loadSnapshot methods."},{"claim_ids":["clm_913dc7f704cc758ef9f4483e202bf62f82d35cb37c2e3ad7dfc780f94e846dd7"],"opposing_claim_ids":[],"text":"Cache keys are produced by serializing function parameters with key order irrelevant; the default decorator key function is ObjectHashKeyFn, and SingletonCacheKeyFn yields a single shared key regardless of arguments."}],"claim_ids":["clm_66b7a4cfb127b60833caf7c04e8539168c4f11e21546b810314e7ddcf9469ead","clm_913dc7f704cc758ef9f4483e202bf62f82d35cb37c2e3ad7dfc780f94e846dd7"],"created_at":"2026-09-14T02:00:10Z","created_by_operation":"op_b8071f0fb3da45d89865505b463104e4","id":"pg_f0288b7921045339a8d8436cbc2e0ee0","maturity":"draft","page_type":"source","path":"pages/sources/clarisseio-python-agents-docs-cache-md-84c3bdc93ecd-436cbc2e0ee0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4e01e6e7cf245ddf92cb578eb0846fc4"],"title":"clarisseIO/python-agents/docs/cache.md @ 84c3bdc93ecd","updated_at":"2026-09-14T02:00:10Z","updated_by_operation":"op_b8071f0fb3da45d89865505b463104e4"}
