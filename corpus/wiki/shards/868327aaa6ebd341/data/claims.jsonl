{"access":"public","created_at":"2026-09-14T01:40:40Z","created_by_operation":"op_3adaa882826f46c89732a36bdb17a80f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_15dc8b6f02a8bbe45f775c10c8190e9d4c465620574234c554158001b89cf75b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"charmbracelet/crush@3502b15a7cf1 snapshot 7bb77b7deb239b31","timeframe":null},"slice_ids":["slc_1129f3d42c5c640e433f3eb83a96d969af02e5ced6ac583953ae7bb468b304f6","slc_b596d45a0920c4af7eb7dc2c0d4acb17615f4af44fb50fa6c2675fc0267b9694","slc_cb0675626e430706f7dd27238fb0dcf7e279c193447030909538c1831c09291f","slc_d906a390dbbbca40e837f7787b2626777b5b751af2435c8de0307cd475488179"],"source_ids":["src_39b6560a38195270be8345b55a445f20","src_c560be4bfe435f9a93f02aaaf0508742"],"text":"Config is discovered from project-level .crushrc/crushrc and XDG config paths with project settings overriding global ones; crushrc overrides JSON in the same directory, and hook command paths resolve relative to the current working directory.","updated_at":"2026-09-14T01:40:40Z","updated_by_operation":"op_3adaa882826f46c89732a36bdb17a80f"}
{"access":"public","created_at":"2026-09-14T01:40:40Z","created_by_operation":"op_3adaa882826f46c89732a36bdb17a80f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_35e870cc7966d1c4dc1e7bdf9b9f51c7bb128754bfe3f51402bfeca01ace5e78","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"charmbracelet/crush@3502b15a7cf1 snapshot 7bb77b7deb239b31","timeframe":null},"slice_ids":["slc_d6431f2cc7b20ec08166915c0150135c826af42806cc151f07cf680849665158"],"source_ids":["src_c560be4bfe435f9a93f02aaaf0508742"],"text":"Hooks execute through Crush's embedded POSIX shell (mvdan.cc/sh), the same interpreter as the bash tool; shebang'd scripts dispatch to the named interpreter via os/exec, identically across macOS, Linux, and Windows.","updated_at":"2026-09-14T01:40:40Z","updated_by_operation":"op_3adaa882826f46c89732a36bdb17a80f"}
{"access":"public","created_at":"2026-09-14T01:40:40Z","created_by_operation":"op_3adaa882826f46c89732a36bdb17a80f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4363308b74241602323288899bff03ab2fd1417f254a412ef1220da3b1a3fa65","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"charmbracelet/crush@3502b15a7cf1 snapshot 7bb77b7deb239b31","timeframe":null},"slice_ids":["slc_84eee5c27c46287657644c4a44055e14ebf105771c447d6234c2471cb7d33b41","slc_ca723da228951f5d924eaaae7abadfa2636a159a1b09b6226fa15cf283f9a8d9","slc_ccbffc15f15c044d32c40bc8630d82873a3ee5afa0ea5293f68dce1799cf2304"],"source_ids":["src_c560be4bfe435f9a93f02aaaf0508742"],"text":"Crush hooks are designed to be broadly compatible with Claude Code hooks, with one intentional divergence: updated_input is treated as a shallow-merge patch rather than a full replacement.","updated_at":"2026-09-14T01:40:40Z","updated_by_operation":"op_3adaa882826f46c89732a36bdb17a80f"}
{"access":"public","created_at":"2026-09-14T01:40:40Z","created_by_operation":"op_3adaa882826f46c89732a36bdb17a80f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_43924c6c2bb4bbcd38dde325493e5624d12242555f81090cd0556e68e0f51c8b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"charmbracelet/crush@3502b15a7cf1 snapshot 7bb77b7deb239b31","timeframe":null},"slice_ids":["slc_35bee3eda45517547383156388073bfe41d7e6b02cea734b8975090d9bccd0b6","slc_af288bc4d22ade71826f3cf5f2054ff1929fa62a946cd89aa6f87894b8b377e9","slc_b736202e5cb04ee6fd6b1d9c292420ce43a3bc690a6f27f9ce206b165f4c81d7","slc_d0b236ff6516efee280833900dbe2b29c8a2ca347ebaf36c30dc36691ac04d44"],"source_ids":["src_c560be4bfe435f9a93f02aaaf0508742"],"text":"Hook results apply before permission checks: an aggregated 'deny' blocks the call without a prompt, 'allow' pre-approves and skips the prompt, and no decision falls through to the normal permission flow.","updated_at":"2026-09-14T01:40:40Z","updated_by_operation":"op_3adaa882826f46c89732a36bdb17a80f"}
{"access":"public","created_at":"2026-09-14T01:40:40Z","created_by_operation":"op_3adaa882826f46c89732a36bdb17a80f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_445ecab51d2efcdc492926e8559a07e0d850ff7096daf102bd67a06b8ef3e8f3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"charmbracelet/crush@3502b15a7cf1 snapshot 7bb77b7deb239b31","timeframe":null},"slice_ids":["slc_0b58e37be283649bc18425e6c511ed32eaa6bb1f5f60803a0598f01d64ee1ea5","slc_2f6c66b0b0541593af833e419da5ca3934d0f004e07e0f3cead288a1f33949d3","slc_512099f38a9f81ed2c9a3b3029643298f5ae14e16474da9c225f298e893ac969","slc_853df26104575eaf21fa8b1d4708295dbf1f6a5b104b65c60196e8c4f13257c1"],"source_ids":["src_39b6560a38195270be8345b55a445f20"],"text":"Configuration is Bash-based via builtin commands (provider, model, mcp, lsp, hook, permissions, option) in a crushrc file that runs at startup; legacy JSON config is still supported but deprecated and receives no new features.","updated_at":"2026-09-14T01:40:40Z","updated_by_operation":"op_3adaa882826f46c89732a36bdb17a80f"}
{"access":"public","created_at":"2026-09-14T01:40:40Z","created_by_operation":"op_3adaa882826f46c89732a36bdb17a80f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_742b06fe5ebde34053b73e363269d7dbcdc9d8a78d03a8ff8c2c8f90941976d3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"charmbracelet/crush@3502b15a7cf1 snapshot 7bb77b7deb239b31","timeframe":null},"slice_ids":["slc_01901834c7ceebd2908fb0ab88e1bade67d18aef34ec924b04f6f1a623e54df6","slc_6f91e76b34056db62c576f81f7a3c389cb2728e039f2fa6bf324801563f403e5","slc_84eee5c27c46287657644c4a44055e14ebf105771c447d6234c2471cb7d33b41","slc_a3dc69969dc8f0de998a45f81e777ef292cc5fbd62593b6882fcd2816f1632e3","slc_af288bc4d22ade71826f3cf5f2054ff1929fa62a946cd89aa6f87894b8b377e9","slc_d0b236ff6516efee280833900dbe2b29c8a2ca347ebaf36c30dc36691ac04d44"],"source_ids":["src_c560be4bfe435f9a93f02aaaf0508742"],"text":"Hooks run in parallel but their results compose deterministically in config order; deny beats allow, updated_input patches shallow-merge sequentially, and identical commands are deduplicated.","updated_at":"2026-09-14T01:40:40Z","updated_by_operation":"op_3adaa882826f46c89732a36bdb17a80f"}
{"access":"public","created_at":"2026-09-14T01:40:40Z","created_by_operation":"op_3adaa882826f46c89732a36bdb17a80f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_78f3fc68fbac48418b326199dc2359fe9a1908967d6e605dba8ab64b20ab3d9a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"charmbracelet/crush@3502b15a7cf1 snapshot 7bb77b7deb239b31","timeframe":null},"slice_ids":["slc_04b45561c546af96756906e438afa8629f0e66369c068beb60d461a1328e7b1f","slc_57548ac8b413bec2641dff784f81821f76c38965ae1fff02a5ce4b14ed3a8ca9","slc_b64c3f8867ea1d32544174552532a40e99e51388cd6f58e5262681abaceb7311","slc_c4201b7183b3b8c013a79c1d799fbb8d03bb20cde39a96eea666945fa63302f4"],"source_ids":["src_c560be4bfe435f9a93f02aaaf0508742"],"text":"Exit code 2 blocks the tool call with stderr as the deny reason, exit 49 halts the whole turn, exit 0 parses stdout as a JSON envelope with decision, halt, reason, context, and updated_input fields.","updated_at":"2026-09-14T01:40:40Z","updated_by_operation":"op_3adaa882826f46c89732a36bdb17a80f"}
