a1acd93732d1c81","maturity":"draft","page_type":"entity","path":"pages/entities/funador-claude-code-merge-queue-cd93732d1c81.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"funador/claude-code-merge-queue","updated_at":"2026-09-14T03:51:30Z","updated_by_operation":"op_3c7c03ab69fb46bfa223785e77333412"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_28477543ca06e8381941057e161dc27365868ec2e470d09ddbd2cbc6c7dca687"],"opposing_claim_ids":[],"text":"Malformed configuration fails loudly at command load time, listing every problem (empty branch names, negative port, identical integration and production branches) rather than failing later."},{"claim_ids":["clm_2c5447b7d4a3e98ce7f3a6aa9204b70692432ad4db6f735acf6e9f83daa08132"],"opposing_claim_ids":[],"text":"A pre-push hook rejects direct git pushes to the integration branch and runs checkCommand before allowing a landing; with no checkCommand configured, every push fails by default."},{"claim_ids":["clm_3570e6f71bd9beea564a6a38c32ea12780b5d02d3657cd2e4ad253528b637b26"],"opposing_claim_ids":[],"text":"Locks are crash-safe via PID liveness rather than timeouts, and a slow checkCommand caps throughput since the FIFO lock is held for its entire duration."},{"claim_ids":["clm_42f2d40aa060954133b2e3a998c95b76bbdce66389ca7c174fe7a3fd5c269496"],"opposing_claim_ids":[],"text":"Configuration lives in a single .mjs file with fields for branchPrefix, worktreeSuffix, portBase, integration/production branches, protectedBranches, regenerableFiles, symlinks, buildOutputDirs, checkCommand, and checksRequired."},{"claim_ids":["clm_62b445cae0724ccc6faf14d5ae3d3c2e55c19b7814a2d0128a95f2eb25523b2a"],"opposing_claim_ids":[],"text":"README badges indicate TypeScript 5.x, Node >=18, MIT license, and zero runtime dependencies; the package is published on npm as claude-code-merge-queue."},{"claim_ids":["clm_6f657d7ee898b7731a68c0198890d613ca0c504c9b7f9dd5dea2be7c5ee40f24"],"opposing_claim_ids":[],"text":"The queue is single-machine: the FIFO lock lives in local temp storage, so concurrent landings from two machines only get git's ordinary non-fast-forward rejection."},{"claim_ids":["clm_8299b266e0a3b8e291f6c1407e0593361a9d20231bb3a408f730ac0c3d2818fa"],"opposing_claim_ids":[],"text":"An init command writes a config file, CLAUDE.md instructions, a .claude/settings.json hook wiring, Husky pre-push hook if present, and package.json scripts like land, sync, promote, preview."},{"claim_ids":["clm_8d67d2cf16386f40107a22d686416c754a008965e48b8fda88689273b9406e20"],"opposing_claim_ids":[],"text":"The CLI exposes commands including hook worktree-create, build-lock, land, sync, promote, preview, port, and prune, each documented with its purpose."},{"claim_ids":["clm_a0e10b4bc82e4c5175ff39eb3517c93b07f8522741993a31ef5d8eaf0c99e35b"],"opposing_claim_ids":[],"text":"A WorktreeCreate hook plugs the tool's numbered lanes into Claude Code's native worktree creation, and build-lock serializes builds machine-wide across lanes."},{"claim_ids":["clm_edd6b3f90e66cb6c5fa9c17134462523f5cb276206ecf7c83712140f24a87903"],"opposing_claim_ids":[],"text":"Blocked pushes can be bypassed via a single environment variable (CLAUDE_CODE_MERGE_QUEUE_EMERGENCY_PUSH=1), which the README notes is a convention, not a guarantee against an adversarial agent."},{"claim_ids":["clm_eede019b57cccd75d2bc8473b64439d724ba912b6367947fdb9dd131c21374bf"],"opposing_claim_ids":[],"text":"No human review occurs before landing; checkCommand passing is the only gate, and the tool cannot distinguish a real test suite from a trivially passing command."},{"claim_ids":["clm_f2cf10b8af9e939498d56fef386700b3262b8296964bbd4623851d0cfc138052"],"opposing_claim_ids":[],"text":"The land command rebases and pushes a lane onto the integration branch through a FIFO queue so two lanes are never mid-push simultaneously; agents can run it themselves."}],"claim_ids":["clm_28477543ca06e8381941057e161dc27365868ec2e470d09ddbd2cbc6c7dca687","clm_2c5447b7d4a3e98ce7f3a6aa9204b70692432ad4db6f735acf6e9f83daa08132","clm_3570e6f71bd9beea564a6a38c32ea12780b5d02d3657cd2e4ad253528b637b26","clm_42f2d40aa060954133b2e3a998c95b76bbdce66389ca7c174fe7a3fd5c269496","clm_62b445cae0724ccc6faf14d5ae3d3c2e55c19b7814a2d0128a95f2eb25523b2a","clm_6f657d7ee898b7731a68c0198890d613ca0c504c9b7f9dd5dea2be7c5ee40f24","clm_8299b266e0a3b8e291f6c1407e0593361a9d20231bb3a408f730ac0c3d2818fa","clm_8d67d2cf16386f40107a22d686416c754a008965e48b8fda88689273b9406e20","clm_a0e10b4bc82e4c5175ff39eb3517c93b07f8522741993a31ef5d8eaf0c99e35b","clm_edd6b3f90e66cb6c5fa9c17134462523f5cb276206ecf7c83712140f24a87903","clm_eede019b57cccd75d2bc8473b64439d724ba912b6367947fdb9dd131c21374bf","clm_f2cf10b8af9e939498d56fef386700b3262b8296964bbd4623851d0cfc138052"],"created_at":"2026-09-14T03:51:30Z","created_by_operation":"op_3c7c03ab69fb46bfa223785e77333412","id":"pg_f2e0f81270ad57339edff1a1c76d8c06","maturity":"draft","page_type":"source","path":"pages/sources/funador-claude-code-merge-queue-readme-md-f77757479cab-f1a1c76d8c06.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4da4077fefe657f8a56b600441983fef"],"title":"funador/claude-code-merge-queue/README.md @ f77757479cab","updated_at":"2026-09-14T03:51:30Z","updated_by_operation":"op_3c7c03ab69fb46bfa223785e77333412"}
