{"access":"public","created_at":"2026-09-14T03:32:50Z","created_by_operation":"op_1814e823755e4b37adff6f70172cc6c5","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9d19c2efb806ef58a31c6ce0e2a157db43520f9019122e58fa45f275c3e45d98","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"alexdevassy/ai-powered-vulnerability-impact-analyzer@b6c4d45cad9c snapshot 0f3e15a8a40f812f","timeframe":null},"slice_ids":["slc_0aa20bad72041b76a096316359097f00866f88a95914769eb7ad322839b80716"],"source_ids":["src_cad974d497b551298defcddb64dfcd00"],"text":"A multi-agent system includes GithubAdvisoryTool (fetches/parses CVE info), SecurityAnalystAgent (Mistral-based component identification), ComponentSearcherTool (codebase scan), and CodeReviewerAgent (impact analysis).","updated_at":"2026-09-14T03:32:50Z","updated_by_operation":"op_1814e823755e4b37adff6f70172cc6c5"}
{"access":"public","created_at":"2026-09-14T03:32:50Z","created_by_operation":"op_1814e823755e4b37adff6f70172cc6c5","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a055c4cc76268e03cf0c7c3d07d1c469dca32a318ac1ae23d96fa695d43855f1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"alexdevassy/ai-powered-vulnerability-impact-analyzer@b6c4d45cad9c snapshot 0f3e15a8a40f812f","timeframe":null},"slice_ids":["slc_201cb32bc9ccd4d39d14ac5a5d65941c72b56c3b13b4fdd353d1bb6f2004225f"],"source_ids":["src_cad974d497b551298defcddb64dfcd00"],"text":"The CLI is invoked as python3 cve_analyzer.py with a GHSA advisory ID and a path to the codebase as arguments.","updated_at":"2026-09-14T03:32:50Z","updated_by_operation":"op_1814e823755e4b37adff6f70172cc6c5"}
{"access":"public","created_at":"2026-09-14T03:32:50Z","created_by_operation":"op_1814e823755e4b37adff6f70172cc6c5","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a78d14add337d717229932318a51532d463af3ec27f7588edffe0ea87e8dea83","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"alexdevassy/ai-powered-vulnerability-impact-analyzer@b6c4d45cad9c snapshot 0f3e15a8a40f812f","timeframe":null},"slice_ids":["slc_7e0f5aeb885c2a5543348e9b9eab377f410e0ae49bb4346141b3a424094950bd"],"source_ids":["src_cad974d497b551298defcddb64dfcd00"],"text":"The AI solution is designed to run fully on-premises so that no data leaves the user's premises.","updated_at":"2026-09-14T03:32:50Z","updated_by_operation":"op_1814e823755e4b37adff6f70172cc6c5"}
{"access":"public","created_at":"2026-09-14T03:32:50Z","created_by_operation":"op_1814e823755e4b37adff6f70172cc6c5","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_aa2d8e40c4a0cf9bd8e776afaa2ba1c154375bcde55dac1d0841dfa3f55f5fe3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"alexdevassy/ai-powered-vulnerability-impact-analyzer@b6c4d45cad9c snapshot 0f3e15a8a40f812f","timeframe":null},"slice_ids":["slc_00bd15df7280808da13f887c2d7dacca54403325721f3bfcebc829b67c8688ed"],"source_ids":["src_cad974d497b551298defcddb64dfcd00"],"text":"The tool targets teams triaging SBOM/Dependabot vulnerability alerts; the demo analyzes GHSA advisories against a sample CTF challenge repository.","updated_at":"2026-09-14T03:32:50Z","updated_by_operation":"op_1814e823755e4b37adff6f70172cc6c5"}
{"access":"public","created_at":"2026-09-14T03:32:50Z","created_by_operation":"op_1814e823755e4b37adff6f70172cc6c5","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e74aac804ec9ca80621c04e5699e40366a7f70d1a8191b154ffd934e646cb873","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"alexdevassy/ai-powered-vulnerability-impact-analyzer@b6c4d45cad9c snapshot 0f3e15a8a40f812f","timeframe":null},"slice_ids":["slc_716fab55e8ea8e9d86b42fd1719e4ad2c95bfd1d8ebd2816826d29253e0bf2e3"],"source_ids":["src_cad974d497b551298defcddb64dfcd00"],"text":"The tool performs intelligent impact analysis on reported vulnerabilities to reduce the false positives that traditional SCA tools generate from relying only on SBOM data.","updated_at":"2026-09-14T03:32:50Z","updated_by_operation":"op_1814e823755e4b37adff6f70172cc6c5"}
