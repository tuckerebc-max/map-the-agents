{"access":"public","created_at":"2026-09-14T02:06:51Z","created_by_operation":"op_2711137bccdc4533b1c1e7370bbf2e0e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0ab916c3efe008be414fa2ccfd5278d9020c8eb71e177e005c353323f46a595c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"jawerty/autostartup@60ec3affede5 snapshot b2515a478e1e3939","timeframe":null},"slice_ids":["slc_74c39a4d22dfeb5ababa9445e9f6db171fc3a0b8b376aae561d3a7f14c3ce609","slc_7515d7b764de5f8dd0fc8144fae75dbf52ad0ffb5bddd02a8692de2e62313fb2","slc_b6c53674371e19f6c60f281e22a183c2b84306255b8e1f041c22d4520b92e9b2","slc_df9e9f87896ec6f7fe6f97aefb4e2ad9799b0a9afca237cce0c0060bd5b2dfa6"],"source_ids":["src_aa8758de49ac5a1c8536c34db7f58f23"],"text":"Repository development practice: to run from source, install dependencies with pip3 install -r requirements.txt (after Llama 2 access and huggingface-cli login) and run the main loop with python3 main.py; a Google Colab notebook is offered for quick testing.","updated_at":"2026-09-14T02:06:51Z","updated_by_operation":"op_2711137bccdc4533b1c1e7370bbf2e0e"}
{"access":"public","created_at":"2026-09-14T02:06:51Z","created_by_operation":"op_2711137bccdc4533b1c1e7370bbf2e0e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1f99275eda3b8e236020dc3c1e82cd1b5226701781b1edbe829d5f0a48b057b7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"jawerty/autostartup@60ec3affede5 snapshot b2515a478e1e3939","timeframe":null},"slice_ids":["slc_2319e2eabcc9afe411e37cee973ff9a7d9411fe17370299283577cae467ecf4e"],"source_ids":["src_aa8758de49ac5a1c8536c34db7f58f23"],"text":"The project is described as a Llama 2 autonomous agent that devises a startup idea, business plans, and React codebases from a simple user 'intuition'.","updated_at":"2026-09-14T02:06:51Z","updated_by_operation":"op_2711137bccdc4533b1c1e7370bbf2e0e"}
{"access":"public","created_at":"2026-09-14T02:06:51Z","created_by_operation":"op_2711137bccdc4533b1c1e7370bbf2e0e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_38b485dc506ba15a8ba029d71bfdf5df6e1e021a484369752ec567cc79a63503","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"jawerty/autostartup@60ec3affede5 snapshot b2515a478e1e3939","timeframe":null},"slice_ids":["slc_881e6010088556456f372eaef44ede50d6f726a47c52edbdea575ecbbde59fcc","slc_c768001420d74ccef8610855a97b7d9b55dfc72f8fe060759afd8824eb3f05ee"],"source_ids":["src_aa8758de49ac5a1c8536c34db7f58f23"],"text":"The agent runs an idea loop: it develops a business idea and plan, iterates via a criticism loop that regenerates the plan, and asks an 'investor' prompt for approval, restarting on disapproval.","updated_at":"2026-09-14T02:06:51Z","updated_by_operation":"op_2711137bccdc4533b1c1e7370bbf2e0e"}
{"access":"public","created_at":"2026-09-14T02:06:51Z","created_by_operation":"op_2711137bccdc4533b1c1e7370bbf2e0e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_54e77c15b00d3c43644506d1fb6c9a1dc4fccf81154e07fe5415cfebc2a399a4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"jawerty/autostartup@60ec3affede5 snapshot b2515a478e1e3939","timeframe":null},"slice_ids":["slc_df8395990cb6bf48a5703be9f742f66a1add01a3b7b04792b92a619916895568"],"source_ids":["src_aa8758de49ac5a1c8536c34db7f58f23"],"text":"The project advertises 100% Llama 2 inference with no OpenAI keys necessary, and applies lean startup concepts such as pivots and a tight MVP build loop.","updated_at":"2026-09-14T02:06:51Z","updated_by_operation":"op_2711137bccdc4533b1c1e7370bbf2e0e"}
