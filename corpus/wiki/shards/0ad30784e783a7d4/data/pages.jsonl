{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3e31c5f0a4bbea1e40c124148c226af688e9c08542ed25fee4498cb922070261"],"opposing_claim_ids":[],"text":"The draft proposes each execution role be bounded by a default-deny Capability Envelope/Sandbox Boundary limiting tools, paths, network, and credentials, plus a negative list of contextual business rules; as draft target language, this is not confirmed shipped behavior."},{"claim_ids":["clm_4a97376aef4eefa62aeee9c2e99b5df6e46f3f6422599db7dfd9713e10998356"],"opposing_claim_ids":[],"text":"The V0.3.1 draft architecture proposes a five-layer design (FCoP fact layer, TMPA Reader, Runtime, definition/deployment, instance) coordinated by asynchronous fact loops rather than a synchronous all-agents-online pipeline; it is explicitly a draft, not a stable specification."}],"claim_ids":["clm_3e31c5f0a4bbea1e40c124148c226af688e9c08542ed25fee4498cb922070261","clm_4a97376aef4eefa62aeee9c2e99b5df6e46f3f6422599db7dfd9713e10998356"],"created_at":"2026-09-14T04:01:16Z","created_by_operation":"op_18b71226099e42d08c25425e20711357","id":"pg_aa268feff8fa5b4d9194b1b12ed3b348","maturity":"draft","page_type":"source","path":"pages/sources/joinwell52-ai-joinwell52-docs-zh-digital-employee-architecture-md-6961-b1b12ed3b348.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d161b6a674b455f6afb2c1d9df22a5f2"],"title":"joinwell52-AI/joinwell52/docs/zh/digital-employee/architecture.md @ 6961492e9a46","updated_at":"2026-09-14T04:01:16Z","updated_by_operation":"op_18b71226099e42d08c25425e20711357"}
