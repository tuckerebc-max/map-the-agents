01d0d37d","maturity":"draft","page_type":"entity","path":"pages/entities/joinwell52-ai-joinwell52-31e201d0d37d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"joinwell52-ai/joinwell52","updated_at":"2026-09-14T04:01:16Z","updated_by_operation":"op_18b71226099e42d08c25425e20711357"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:01:16Z","created_by_operation":"op_18b71226099e42d08c25425e20711357","id":"pg_3918f3910fc55ffb9e07a71f2e1e0513","maturity":"draft","page_type":"source","path":"pages/sources/joinwell52-ai-joinwell52-docs-digital-employee-architecture-md-6961492-a71f2e1e0513.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_34173eecc8d05903b16277c59cf2d74a"],"title":"joinwell52-AI/joinwell52/docs/digital-employee/architecture.md @ 6961492e9a46","updated_at":"2026-09-14T04:01:16Z","updated_by_operation":"op_18b71226099e42d08c25425e20711357"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1e355114c7f4dddfb5ff7e443dc39b4cab3f8258f3d728e1b89f32bc479575ac"],"opposing_claim_ids":[],"text":"The Reference Reader is run via npm commands: `npm run demo` for a demo delivery and `npm run tmpa:s1.0:conformance` for the conformance runner, after `npm ci`."},{"claim_ids":["clm_4de9770974b0254a0a0ed211da8c8565f72ba084a182930944c608dd51275970"],"opposing_claim_ids":[],"text":"CodeFlowMu is described as a local PM/DEV/QA/OPS AI development team with a PC control center and a mobile PWA, distributed as a proprietary free Windows x64 preview from a separate distribution repository."},{"claim_ids":["clm_70f0d211a2a28b9d6d691a6f3a75fc2899ff1d96afde2b3540e15befcf9f94d7"],"opposing_claim_ids":[],"text":"TMPA moves durable work facts out of volatile model memory so lifecycle, authority, conflict, and audit state can be reconstructed from inspectable evidence across asynchronous execution."},{"claim_ids":["clm_791a18214cb198bbbfee43aa9b7ee246f17004f7f906430224b8694d8328d89f"],"opposing_claim_ids":[],"text":"The recorded conformance result is 14 PASS / 0 PARTIAL / 0 NOT RUN / 0 FAIL for the S1.0 criteria, alongside reported suite results such as 71/71 mandatory assertions and a 1,522-pass CodeFlowMu runtime suite."},{"claim_ids":["clm_80fdef812d27637c00c822c5d8d81bdcff9109dbf0abffafa2ea65236e7c0205"],"opposing_claim_ids":[],"text":"The README states the conformance evidence is author-run for one exact implementation revision and input bundle, and is not independent certification, universal conformance, or proof hallucinations are eliminated."},{"claim_ids":["clm_834005403dfe71f50664c41301ad6459f6d65624cda38da3dfe8091b58e833a4"],"opposing_claim_ids":[],"text":"The repository targets builders of agents that must survive restarts, handoffs, disputes, review, and organizational accountability."},{"claim_ids":["clm_84b61e56e5a2e09f7ee4db6a1f64e84f3cf2580df2558ecf091a600505aa1dff"],"opposing_claim_ids":[],"text":"TMPA Core is described as storage-neutral: files, database rows, object-store items, or events may carry the same governance semantics, with durable state kept outside model sessions and a Reader reconstructing governance state."},{"claim_ids":["clm_866b4b4f7b75c5f7860b091025bb21d4c2ba22ed03a016e840f5a8120308022c"],"opposing_claim_ids":[],"text":"TMPA Core Specification S1.0 is presented as the normative layer defining objects, authority, lifecycle, Reader behavior, and conformance requirements, with criteria labeled C01–C14."},{"claim_ids":["clm_90d66051f1fe75e943e84d033e3295bacfcc16bab6bea98ff76ea82d9ba1a46f"],"opposing_claim_ids":[],"text":"The repository ships TMPA Core S1.0 machine schemas, fixtures, profiles, an author-produced Reference Reader, and a C01–C14 conformance runner."},{"claim_ids":["clm_c42f452919fb08f1d0601108f6d3de836f2ac79504eb178e7ccfcadefb25ddce"],"opposing_claim_ids":[],"text":"Running the Reference Reader requires Node.js 20 or later, per the README requirements line."}],"claim_ids":["clm_1e355114c7f4dddfb5ff7e443dc39b4cab3f8258f3d728e1b89f32bc479575ac","clm_4de9770974b0254a0a0ed211da8c8565f72ba084a182930944c608dd51275970","clm_70f0d211a2a28b9d6d691a6f3a75fc2899ff1d96afde2b3540e15befcf9f94d7","clm_791a18214cb198bbbfee43aa9b7ee246f17004f7f906430224b8694d8328d89f","clm_80fdef812d27637c00c822c5d8d81bdcff9109dbf0abffafa2ea65236e7c0205","clm_834005403dfe71f50664c41301ad6459f6d65624cda38da3dfe8091b58e833a4","clm_84b61e56e5a2e09f7ee4db6a1f64e84f3cf2580df2558ecf091a600505aa1dff","clm_866b4b4f7b75c5f7860b091025bb21d4c2ba22ed03a016e840f5a8120308022c","clm_90d66051f1fe75e943e84d033e3295bacfcc16bab6bea98ff76ea82d9ba1a46f","clm_c42f452919fb08f1d0601108f6d3de836f2ac79504eb178e7ccfcadefb25ddce"],"created_at":"2026-09-14T04:01:16Z","created_by_operation":"op_18b71226099e42d08c25425e20711357","id":"pg_862fb333905b5b7a90c237acf33e34c0","maturity":"draft","page_type":"source","path":"pages/sources/joinwell52-ai-joinwell52-readme-md-6961492e9a46-37acf33e34c0.md",