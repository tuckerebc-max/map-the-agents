{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_abb732c45493367b0f6915840bdd8cca6f6627623c11943bb9e173bbb96afbb1"],"opposing_claim_ids":[],"text":"Both vixd and vix expose a pprof HTTP server via --pprof-port (default ports 6060 and 6061, overridable by VIX_PPROF_PORT), serving goroutine, heap, allocs, and CPU profiles."}],"claim_ids":["clm_abb732c45493367b0f6915840bdd8cca6f6627623c11943bb9e173bbb96afbb1"],"created_at":"2026-09-14T01:51:04Z","created_by_operation":"op_a352d9dd03f14970b71d8b60d63f00d1","id":"pg_baa75a916c1a5f4f902257f15b1970fe","maturity":"draft","page_type":"source","path":"pages/sources/get-vix-vix-debug-md-8e4262d6d1a8-57f15b1970fe.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7c431ca199085353904ede9229ad82d8"],"title":"get-vix/vix/DEBUG.md @ 8e4262d6d1a8","updated_at":"2026-09-14T01:51:04Z","updated_by_operation":"op_a352d9dd03f14970b71d8b60d63f00d1"}
