{"access":"public","created_at":"2026-09-14T02:30:01Z","created_by_operation":"op_e3b92c8c029e44a09a36df10bea06c69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0af4a68a9a2a063a502e99296e8c0e14797c3ba1ee5e7258f7515438a40f8f8d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"patriceckhart/zot@f60e492e5518 snapshot 17a5430f57315354","timeframe":null},"slice_ids":["slc_06f9c90ac616f0d6295447a3c821c2ba9c5ef08e9c31d9e42867cebc346656f7","slc_21955da5215c25bad917a67c144e7e411041559fbc76c8fd2da0308e67969795","slc_9b8b35713adc500328b63dde6899ec1b82dc55290f5bdeaf207896de7f9f1c7b"],"source_ids":["src_a0a81e8bfa695153bbd3b68547ec1533"],"text":"Sessions are JSONL transcripts resumable via --continue, --resume, --session, or /sessions; empty sessions are deleted on close, and `zot sessions prune` can remove sessions for vanished directories or by age.","updated_at":"2026-09-14T02:30:01Z","updated_by_operation":"op_e3b92c8c029e44a09a36df10bea06c69"}
