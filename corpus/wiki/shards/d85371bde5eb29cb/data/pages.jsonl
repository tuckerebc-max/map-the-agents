863de9c5","clm_b5a3c515f240c1b00522d67550c23f6c786bfb8c675f46126fd461653aaa01ad","clm_d348bdaaf8e1252b4a40fc5a72530dedfd8a4bb573100306a6f25ba387f9e63d","clm_d55d4e929c27f7aeb1c5d0a5a2dc62f8f4d5c1940e6cb80616cd2084af09eb16","clm_e4ef3b41caa47b7d58c732c03f9b6383daf3ea49d75972dce7d45f25184e27b7","clm_e5dc8582abf328cc8f7666f6585d4704f093d9c7cc0cb6611d31726d874e4172","clm_e91dc5eae3390e0b09056f77d137ac6333d38a0517c8ef6cbbaab84095a5d865","clm_fa946be99f49e15972e8f99e58c2d792cb0da95917c4b25019266369dd2f55b8","clm_fe7a4ac89485c78a31919f0da9600f40d78c2026c0dd63664e0a09de80a16014"],"created_at":"2026-09-14T02:05:31Z","created_by_operation":"op_fa984a64620448b9b9202de0fc593dad","id":"pg_4e36645f951b5db7a26268e53b0f2cf3","maturity":"draft","page_type":"entity","path":"pages/entities/itayinbarr-little-coder-68e53b0f2cf3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"itayinbarr/little-coder","updated_at":"2026-09-14T02:05:31Z","updated_by_operation":"op_fa984a64620448b9b9202de0fc593dad"}
