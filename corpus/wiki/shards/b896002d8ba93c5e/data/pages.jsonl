{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_08666755d6c43419d9110298d7751a3a3ade8764567708c9374c6ba965be64f0"],"opposing_claim_ids":[],"text":"The Code Clinic series has authors solve the same set of problems in different programming languages."},{"claim_ids":["clm_0af069723b481a8ebcdc24dcb799ef0bbb0a96df46fed2c8ccb743f5b615feaa"],"opposing_claim_ids":[],"text":"Code Clinic sessions exist for C++, C#, Java, PHP, Python, Ruby, and now R."},{"claim_ids":["clm_a19639dc9bc3156fa1236f4dd571d0dcc657818d8e039a4d61266543c6a9dd2c"],"opposing_claim_ids":[],"text":"Repository development practice: the README states the author curated lynda.com's developer segment and taught themselves R to complete the Code Clinic: R course as a project."},{"claim_ids":["clm_d31b144e1a580fc9475e4b2872b8630d5a7ae3239d3868bb702393325453e640"],"opposing_claim_ids":[],"text":"CodeClinicR is described as an R-language version of lynda.com's Code Clinic course series."},{"claim_ids":["clm_d7c63cda350408f1709005c59d484fc7a26bfa90b286b05572f6a2da8d928ca9"],"opposing_claim_ids":[],"text":"The README links to a lynda.com shared playlist listing all the Code Clinic language courses."},{"claim_ids":["clm_e16f3d35d9103aac2f96b6ea18d8f755aaf6bb28412f3d47a955f3c8fc3d13c1"],"opposing_claim_ids":[],"text":"The course problems include exploring Lake Pend Oreille, image analysis, Eight Queens, building a theremin, recursion and directories, and dynamic web pages."}],"claim_ids":["clm_08666755d6c43419d9110298d7751a3a3ade8764567708c9374c6ba965be64f0","clm_0af069723b481a8ebcdc24dcb799ef0bbb0a96df46fed2c8ccb743f5b615feaa","clm_a19639dc9bc3156fa1236f4dd571d0dcc657818d8e039a4d61266543c6a9dd2c","clm_d31b144e1a580fc9475e4b2872b8630d5a7ae3239d3868bb702393325453e640","clm_d7c63cda350408f1709005c59d484fc7a26bfa90b286b05572f6a2da8d928ca9","clm_e16f3d35d9103aac2f96b6ea18d8f755aaf6bb28412f3d47a955f3c8fc3d13c1"],"created_at":"2026-09-14T04:10:19Z","created_by_operation":"op_9269c82bd25748a6b732e484ac9bbf5f