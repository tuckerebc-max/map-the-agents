{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0e0dbf51817a0f26d2aa32d95c5641699e2b65f863582edc265251c3f30b541b"],"opposing_claim_ids":[],"text":"Telemetry is sent through PostHog; a changelog entry notes axios was replaced with native fetch, and an earlier entry mentions bumping posthog to fix an axios security issue."},{"claim_ids":["clm_1dc02c761fb27b1f9cf25cf98583245da083a264f75094a5098d366ad0639370"],"opposing_claim_ids":[],"text":"Repository development practice: CI uses GitHub Actions workflows for package build and coverage plus Codacy for code-quality analysis; contributors are expected to add unit tests covering their code, and precommit hooks plus an automated PR label/title check were added."},{"claim_ids":["clm_b548ea9ffb1f3a0a22527af8b25f6c9b3632f9b732a3b8d63efa46d34a5bf699"],"opposing_claim_ids":[],"text":"The changelog records commands to fetch guidelines, retrieve diagnostics, run code analysis via the Quack API, and authenticate, plus a multi-turn chat view and revamped guideline view."}],"claim_ids":["clm_0e0dbf51817a0f26d2aa32d95c5641699e2b65f863582edc265251c3f30b541b","clm_1dc02c761fb27b1f9cf25cf98583245da083a264f75094a5098d366ad0639370","clm_b548ea9ffb1f3a0a22527af8b25f6c9b3632f9b732a3b8d63efa46d34a5bf699"],"created_at":"2026-09-14T04:17:32Z","created_by_operation":"op_3cdb9433abd348edaba9e2846e8952a6","id":"pg_67ad6a31215058af8482322b64a2dd2c","maturity":"draft","page_type":"source","path":"pages/sources/quack-ai-companion-vscode-changelog-md-3b4d567ae047-322b64a2dd2c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b29b065a85e65d8588c00c5a3ee2309f"],"title":"quack-ai/companion-vscode/CHANGELOG.md @ 3b4d567ae047","updated_at":"2026-09-14T04:17:32Z","updated_by_operation":"op_3cdb9433abd348edaba9e2846e8952a6"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1dc02c761fb27b1f9cf25cf98583245da083a264f75094a5098d366ad0639370"],"opposing_claim_ids":[],"text":"Repository development practice: CI uses GitHub Actions workflows for package build and coverage plus Codacy for code-quality analysis; contributors are expected to add unit tests covering their code, and precommit hooks plus an automated PR label/title check were added."},{"claim_ids":["clm_7d3d616153d516b94b296965b77a93cbffe59221e9335da9ea9a87b7b44cba53"],"opposing_claim_ids":[],"text":"Repository development practice: local configuration is optional via a root .env file with POSTHOG_KEY and POSTHOG_HOST keys; bug reports and feature requests go through GitHub issues and questions through GitHub discussions."},{"claim_ids":["clm_a241a7349355eab240fed9c52f2afba35b3691f8234d21b90a63385b8c21266f"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork the repo, work on a non-main branch, follow the Angular commit format, and open a pull request from their fork's branch using the PR template."},{"claim_ids":["clm_ddfe9fe340fa8a4f32c36dca959c401e7a4d2c2dbee9f6302cf6ba582533f56e"],"opposing_claim_ids":[],"text":"Repository development practice: quality checks run via 'make quality' (non-mutating) and auto-fixes via 'make style'; changes are tested locally with 'make run' and F5 to load the extension in a new window."}],"claim_ids":["clm_1dc02c761fb27b1f9cf25cf98583245da083a264f75094a5098d366ad0639370","clm_7d3d616153d516b94b296965b77a93cbffe59221e9335da9ea9a87b7b44cba53","clm_a241a7349355eab240fed9c52f2afba35b3691f8234d21b90a63385b8c21266f","clm_ddfe9fe340fa8a4f32c36dca959c401e7a4d2c2dbee9f6302cf6ba582533f56e"],"created_at":"2026-09-14T04:17:32Z","created_by_operation":"op_3cdb9433abd348edaba9e2846e8952a6","id":"pg_d60e42fbe6b95af285bc7d031af80783","maturity":"draft","page_type":"source","path":"pages/sources/quack-ai-companion-vscode-contributing-md-3b4d567ae047-7d031af80783.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_12a388105eba50fbb183a1ef3b39ec2d"],"title":"quack-ai/companion-vscode/CONTRIBUTING.md @ 3b4d567ae047","updated_at":"2026-09-14T04:17:32Z","updated_by_operation":"op_3cdb9433abd348edaba9e2846e8952a6"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0e0dbf51817a0f26d2aa32d95c5641699e2b65f863582edc265251c3f30b541b"],"opposing_claim_ids":[],"text":"Telemetry is sent through PostHog; a changelog entry notes axios was replaced with native fetch, and an earlier entry mentions bumping posthog to fix an axios security issue."},{"claim_ids":["clm_3e0c3e604ea0df8e2add9454b337521fd20a9281656144abfd258c843e2eedb5"],"opposing_claim_ids":[],"text":"README badges indicate the extension targets Node 20 and is published on both the VS Marketplace and the Open VSX Registry."},{"claim_ids":["clm_3eba535fff6578617bade12de7aecfd313695e96a38673932d39dcacf2dbd867"],"opposing_claim_ids":[],"text":"Per the README, smart linting is temporarily disabled and code completion is listed as coming soon."},{"claim_ids":["clm_47bb316469de632c0be5fe6a11f5e4547e5c0b941154d7f799abf74fa8899ea0"],"opposing_claim_ids":[],"text":"The stated roadmap is to turn contribution guidelines into a live pair-coding experience, help developers find starter contribution opportunities, and align contributions with project priorities."},{"claim_ids":["clm_52b0f7fc5a5785c6b1592bcc5f9749e13e70bc6c299ba749ed481141554fe1e5"],"opposing_claim_ids":[],"text":"The extension collects event identifiers (event type and possibly repository scope) and user identification defaulting to the GitHub username, with an anonymized-UUID option and the ability to disable telemetry entirely."},{"claim_ids":["clm_6b02b93803eb2194a7809bd1ab274130286c5208cddc7cc32df99400049c9766"],"opposing_claim_ids":[],"text":"After installation, opening a project gives a new extension tab with guideline curation and code chat; smart linting is temporarily disabled and code completion is coming soon."},{"claim_ids":["clm_6e036370a302fa3a2351ee3bd15d8c272c04c2389007531d1eb27a61db010668"],"opposing_claim_ids":[],"text":"The project is Quack Companion, an IDE extension for VSCode described as providing smart linting and code chat powered by team insights."}],"claim_ids":["clm_0e0dbf51817a0f26d2aa32d95c5641699e2b65f863582edc265251c3f30b541b","clm_3e0c3e604ea0df8e2add9454b337521fd20a9281656144abfd258c843e2eedb5","clm_3eba535fff6578617bade12de7aecfd313695e96a38673932d39dcacf2dbd867","clm_47bb316469de632c0be5fe6a11f5e4547e5c0b941154d7f799abf74fa8899ea0","clm_52b0f7fc5a5785c6b1592bcc5f9749e13e70bc6c299ba749ed481141554fe1e5","clm_6b02b93803eb2194a7809bd1ab274130286c5208cddc7cc32df99400049c9766","clm_6e036370a302fa3a2351ee3bd15d8c272c04c2389007531d1eb27a61db010668"],"created_at":"2026-09-14T04:17:32Z","created_by_operation":"op_3cdb9433abd348edaba9e2846e8952a6","id":"pg_ff6d9b6da58d57309f4f93fa1aa4bd2c","maturity":"draft","page_type":"source","path":"pages/sources/quack-ai-companion-vscode-readme-md-3b4d567ae047-93fa1aa4bd2c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7ebf51afe6925e3195a9bd2b8da55f57"],"title":"quack-ai/companion-vscode/README.md @ 3b4d567ae047","updated_at":"2026-09-14T04:17:32Z","updated_by_operation":"op_3cdb9433abd348edaba9e2846e8952a6"}
