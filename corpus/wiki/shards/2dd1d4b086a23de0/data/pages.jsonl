{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1315df89df82000c625cb3d2e66ffc1898fcd0d6d10b6931ce6b9698b988233c"],"opposing_claim_ids":[],"text":"A usecases folder contains complete sample use cases with documentation, infrastructure as code, and dependent resources, including an image processing pipeline, CodeArtifact Python dependency setup, and stopping/starting an MWAA environment."},{"claim_ids":["clm_2d9c0f2e9710647416e3482b48333648a8ac944452663eb290b55f034330d6b7"],"opposing_claim_ids":[],"text":"The repository provides example DAGs, requirements.txt files, plugins, and CloudFormation templates focused on Amazon MWAA, and notes many contributions also apply to self-managed Apache Airflow."},{"claim_ids":["clm_47f6e97ad5957559af391d24c14892c9fb07288f307132003c7803bed7ff86fb"],"opposing_claim_ids":[],"text":"The repository offers requirements.txt examples to help find the right Python library combinations, including Amazon and GCP backport providers."},{"claim_ids":["clm_602640ce2f8f1c779b0d18d64e0609903abab40919224bf51dbc4d1f1232ad49"],"opposing_claim_ids":[],"text":"Example DAG workflows include moving Airflow Connections and Variables to AWS Secrets Manager, EMR jobs, Bash Operator interactive commands, duplicating an RBAC role, and returning the DAG ID during task execution."},{"claim_ids":["clm_6c1a8449d7cd4dbf2d5fa15a8f1d33f934ef26a3e6cef0454ad887d074bac2c5"],"opposing_claim_ids":[],"text":"The project is licensed under the MIT-0 License, and contributors will be asked to confirm licensing of their contributions."},{"claim_ids":["clm_81085ad6524008d5a892eb78e264cd6970690474918c4775a59b0f35d5361e86"],"opposing_claim_ids":[],"text":"The examples assume a working Amazon MWAA environment as a prerequisite."},{"claim_ids":["clm_faf36636d66ed888746ba65eb6e25110f67436d01494b23a52804e9bd1067e24"],"opposing_claim_ids":[],"text":"The examples are educational samples, not supported products; users are told to test, secure, and optimize any integrated application before production use."},{"claim_ids":["clm_ffe68a71dfb6df0148324894367c17c37af104d0c16387a5101774adbdfce0de"],"opposing_claim_ids":[],"text":"The repository includes example CloudFormation templates for Amazon MWAA and example AWS IAM policy definitions, with links to relevant AWS documentation."}],"claim_ids":["clm_1315df89df82000c625cb3d2e66ffc1898fcd0d6d10b6931ce6b9698b988233c","clm_2d9c0f2e9710647416e3482b48333648a8ac944452663eb290b55f034330d6b7","clm_47f6e97ad5957559af391d24c14892c9fb07288f307132003c7803bed7ff86fb","clm_602640ce2f8f1c779b0d18d64e0609903abab40919224bf51dbc4d1f1232ad49","clm_6c1a8449d7cd4dbf2d5fa15a8f1d33f934ef26a3e6cef0454ad887d074bac2c5","clm_81085ad6524008d5a892eb78e264cd6970690474918c4775a59b0f35d5361e86","clm_faf36636d66ed888746ba65eb6e25110f67436d01494b23a52804e9bd1067e24","clm_ffe68a71dfb6df0148324894367c17c37af104d0c16387a5101774adbdfce0de"],"created_at":"2026-09-14T03:36:04Z","created_by_operation":"op_97c15de784944ecdb9629eb733c28b55","id":"pg_ac60d623895157a6adca28350a9f38b7","maturity":"draft","page_type":"source","path":"pages/sources/aws-samples-amazon-mwaa-examples-readme-md-d81ee28ec4ea-28350a9f38b7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1728e1ceec8b57ddb30451dd6018aee9"],"title":"aws-samples/amazon-mwaa-examples/README.md @ d81ee28ec4ea","updated_at":"2026-09-14T03:36:04Z","updated_by_operation":"op_97c15de784944ecdb9629eb733c28b55"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5357fc972619d888cff6862fc348954cd6e48f58a1baca4a47e5e6d48fa67b77"],"opposing_claim_ids":[],"text":"Repository development practice: pull requests should target the latest main branch, check for duplicate work, and open an issue to discuss significant work beforehand."},{"claim_ids":["clm_6c1a8449d7cd4dbf2d5fa15a8f1d33f934ef26a3e6cef0454ad887d074bac2c5"],"opposing_claim_ids":[],"text":"The project is licensed under the MIT-0 License, and contributors will be asked to confirm licensing of their contributions."},{"claim_ids":["clm_bd0a8d51b40d02d6545bf1ad88860cbb23e085f31b576b9dc21531726bbff62c"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are asked to fork the repo, make focused changes, ensure local tests pass, commit with clear messages, submit a pull request, and monitor automated CI failures."},{"claim_ids":["clm_bf844e3fbf6c50af75ffcce3aca5fb3162100a476f8cb4300b1d91a411709dfb"],"opposing_claim_ids":[],"text":"Repository development practice: security issues must be reported to AWS/Amazon Security via the vulnerability reporting page rather than as public GitHub issues."},{"claim_ids":["clm_d1f55727feb9c14ae9695332488343c17e748734be04c50d6d1d4b489dde96b5"],"opposing_claim_ids":[],"text":"Repository development practice: bug reports should use the GitHub issue tracker and include a reproducible test case, code version, relevant modifications, and unusual environment details."}],"claim_ids":["clm_5357fc972619d888cff6862fc348954cd6e48f58a1baca4a47e5e6d48fa67b77","clm_6c1a8449d7cd4dbf2d5fa15a8f1d33f934ef26a3e6cef0454ad887d074bac2c5","clm_bd0a8d51b40d02d6545bf1ad88860cbb23e085f31b576b9dc21531726bbff62c","clm_bf844e3fbf6c50af75ffcce3aca5fb3162100a476f8cb4300b1d91a411709dfb","clm_d1f55727feb9c14ae9695332488343c17e748734be04c50d6d1d4b489dde96b5"],"created_at":"2026-09-14T03:36:04Z","created_by_operation":"op_97c15de784944ecdb9629eb733c28b55","id":"pg_d2b2af1ef9e058c3924e7b77