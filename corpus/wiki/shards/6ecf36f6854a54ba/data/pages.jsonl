fa9273b","clm_b00207897340c2e07835c964b9903801cb62727d88e67234867ff03b7c4abfa9","clm_bf135ab44661ce02e9ae835846df128830396284bf74cd08c16cea3085d647dd","clm_c4cd945265732b7bb583c43f88fd873886f55696f36a2fd3be84af724c406f56","clm_ccbe11c3fcb65bc48edc088b700798cf7c05da855c8c14a1f98e4125da75fadd","clm_d69ba7a1fdb830462d2306c75adc875e445ffdf868adc47da1a8ef361a24c6ed","clm_da2552b636d8ce46930655b064a0ebe0d27af4dc6b37c9759ac5210b5f4f26b9","clm_dd0684002259ee7d4232fa0c7cd1fab19785a1316bad917df98c0b36a374700f","clm_efe666d19a18be7b48c5b911e171840a73774f754f6de7d2d3e4b63a099841df"],"created_at":"2026-09-14T02:13:33Z","created_by_operation":"op_3a12e625a6614eb38a44c43b260697e5","id":"pg_041a67eefc32560e975778267ebb5e3a","maturity":"draft","page_type":"entity","path":"pages/entities/looptroop-ai-looptroop-78267ebb5e3a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"looptroop-ai/looptroop","updated_at":"2026-09-14T02:13:33Z","updated_by_operation":"op_3a12e625a6614eb38a44c43b260697e5"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:13:33Z","created_by_operation":"op_3a12e625a6614eb38a44c43b260697e5","id":"pg_57143979001e52c39a1cfa6b4bea8394","maturity":"draft","page_type":"source","path":"pages/sources/looptroop-ai-looptroop-code-of-conduct-md-b96f5448251c-fa6b4bea8394.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_246713a1c0d35c9d866c6a6f7099ffc6"],"title":"looptroop-ai/LoopTroop/CODE_OF_CONDUCT.md @ b96f5448251c","updated_at":"2026-09-14T02:13:33Z","updated_by_operation":"op_3a12e625a6614eb38a44c43b260697e5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_033d8e8301d3f6e3cb58b3f2a2fb44a08ba5a7b6a8d31fbaf9bc012720704d9c"],"opposing_claim_ids":[],"text":"The ticket pipeline flows from codebase discovery through council planning, an approval gate, isolated bead execution, final tests, optional manual QA, and integration/PR review, with QA failures spawning fix beads."},{"claim_ids":["clm_2abe9024f33cbd37a0d4709f08deab2d872cdc0379d9b3a20488cef244401e56"],"opposing_claim_ids":[],"text":"The product converts a ticket into a PRD with Epics and User Stories plus decomposed implementation steps, stored as a durable artifact for later bead execution."},{"claim_ids":["clm_470e331903969e540e10930219b7073fb196f926befaa3de9e163cf79ff031f0"],"opposing_claim_ids":[],"text":"In alpha, LLM Councils support 2–10 distinct models including the main implementer, and each project allows only one active ticket in the execution band at a time."},{"claim_ids":["clm_69e7b28e17c7c9cd3cb62f6703a31855cef9ef7c7de36dfb200688a37ec3842f"],"opposing_claim_ids":[],"text":"A CLI is provided: `looptroop open` starts the app in the background if not running, and `looptroop start` runs the service without a browser."},{"claim_ids":["clm_79e8d01bb7cca8c65d5e547819fb6446a45c092360becd077008e0137c17d57b"],"opposing_claim_ids":[],"text":"Execution runs each bead via OpenCode in isolated Git worktrees; on failure a Ralph-style loop logs the trace, resets the worktree, discards the session, and retries fresh until tests pass or limits are hit."},{"claim_ids":["clm_7d72436a35c6911703a34bc27f83f0608d467a48771687b442901d14fabc07a4"],"opposing_claim_ids":[],"text":"A local GUI dashboard lets users manage attached repositories, configure implementer and council models, answer interview questions, and track ticket, bead, and execution-log state."},{"claim_ids":["clm_9ab483c3e8ba2c80a49d5d377d7be79d1c03b30e24c1c0bccbecbcc55fa9273b"],"opposing_claim_ids":[],"text":"The product requires git and authenticated `gh` for the PR step, plus OpenCode with at least one configured model provider; it can start OpenCode if installed but will not install it."},{"claim_ids":["clm_b00207897340c2e07835c964b9903801cb62727d88e67234867ff03b7c4abfa9"],"opposing_claim_ids":[],"text":"The tool is unsuited to urgent quick fixes or trivial tasks due to orchestration overhead and high API token usage from multi-model councils and long retry loops."},{"claim_ids":["clm_c4cd945265732b7bb583c43f88fd873886f55696f36a2fd3be84af724c406f56"],"opposing_claim_ids":[],"text":"The orchestrator runs OpenCode in dangerously-skip-permissions (YOLO) mode, giving the agent full local execution rights without confirmation prompts; worktrees isolate code but not command execution."},{"claim_ids":["clm_ccbe11c3fcb65bc48edc088b700798cf7c05da855c8c14a1f98e4125da75fadd"],"opposing_claim_ids":[],"text":"npm/bun/pnpm/Yarn installs need Node 24.18.1+ and git and gh; Homebrew and Scoop ship locked bundles pulling in node@24, git, and gh; Docker images include Node, git, and gh but need an external OpenCode server and a mounted project."},{"claim_ids":["clm_d69ba7a1fdb830462d2306c75adc875e445ffdf868adc47da1a8ef361a24c6ed"],"opposing_claim_ids":[],"text":"Context engineering feeds the agent only minimal per-status context (active bead, target file, test file) instead of full transcripts, to avoid context rot."},{"claim_ids":["clm_da2552b636d8ce46930655b064a0ebe0d27af4dc6b37c9759ac5210b5f4f26b9"],"opposing_claim_ids":[],"text":"Work is decomposed into 'beads' — small independently implementable units with purpose, acceptance criteria, dependencies, target files, and validation steps."},{"claim_ids":["clm_efe666d19a18be7b48c5b911e171840a73774f754f6de7d2d3e4b63a099841df"],"opposing_claim_ids":[],"text":"Planning uses an LLM Council where multiple model instances draft plans, score each other with a weighted rubric, vote, and the winner refines and verifies coverage."}],"claim_ids":["clm_033d8e8301d3f6e3cb58b3f2a2fb44a08ba5a7b6a8d31fbaf9bc012720704d9c","clm_2abe9024f33cbd37a0d4709f08deab2d872cdc0379d9b3a20488cef244401e56","clm_470e331903969e540e10930219b7073fb196f926befaa3de9e163cf79ff031f0","clm_69e7b28e17c7c9cd3cb62f6703a31855cef9ef7c7de36dfb200688a37ec3842f","clm_79e8d01bb7cca8c65d5e547819fb6446a45c092360becd077008e0137c17d57b","clm_7d72436a35c6911703a34bc27f83f0608d467a48771687b442901d14fabc07a4","clm_9ab483c3e8ba2c80a49d5d377d7be79d1c03b30e24c1c0bccbecbcc55fa9273b","clm_b00207897340c2e07835c964b9903801cb62727d88e67234867ff03b7c4abfa9","clm_c4cd945265732b7bb583c43f88fd873886f55696f36a2fd3be84af724c406f56","clm_ccbe11c3fcb65bc48edc088b700798cf7c05da855c8c14a1f98e4125da75fadd","clm_d69ba7a1fdb830462d2306c75adc875e445ffdf868adc47da1a8ef361a24c6ed","clm_da2552b636d8ce46930655b064a0ebe0d27af4dc6b37c9759ac5210b5f4f26b9","clm_efe666d19a18be7b48c5b911e171840a73774f754f6de7d2d3e4b63a099841df"],"created_at":"2026-09-14T02:13:33Z","created_by_operation":"op_3a12e625a6614eb38a44c43b260697e5","id":"pg_acd96c5325195545a6b3c084215b90a9","maturity":"draft","page_type":"source","path":"pages/sources/looptroop-ai-looptroop-readme-md-b96f5448251c-c084215b90a9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_bf994b4b089651d099914dc939c3245b"],"title":"looptroop-ai/LoopTroop/README.md @ b96f5448251c","updated_at":"2026-09-14T02:13:33Z","updated_by_operation":"op_3a12e625a6614eb38a44c43b260697e5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_081ffea18127ed9d6a49e25f656a93446a08e32c82d4d82217c684c1ed6f941e"],"opposing_claim_ids":[],"text":"Repository development practice: bug reports should include reproduction steps, expected behavior, environment details (OS, Node, browser, OpenCode/provider), and logs with secrets removed."},{"claim_ids":["clm_2a1f086ab6ba4d9de067b49fae50613bcfbc7672b9cc59d6a48b8892dd95b901"],"opposing_claim_ids":[],"text":"Repository development practice: pull requests should stay focused, include a summary, rationale, affected workflow areas, tests run, and doc/changelog updates, avoiding unrelated refactors mixed with behavior changes."},{"claim_ids":["clm_bf135ab44661ce02e9ae835846df128830396284bf74cd08c16cea3085d647dd"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run `npm install` and `npm run dev` (dev server at localhost:5173), with lint, typecheck, and test scripts available, and a preview mode serving a built bundle."},{"claim_ids":["clm_dd0684002259ee7d4232fa0c7cd1fab19785a1316bad917df98c0b36a374700f"],"opposing_claim_ids":[],"text":"Repository development practice: user-visible changes need a CHANGELOG.md entry under `## Unreleased`, and releases changing install paths, commands, flags, or channels must ship website doc updates in the same batch."}],"claim_ids":["clm_081ffea18127ed9d6a49e25f656a93446a08e32c82d4d82217c684c1ed6f941e","clm_2a1f086ab6ba4d9de067b49fae50613bcfbc7672b9cc59d6a48b8892dd95b901","clm_bf135ab44661ce02e9ae835846df128830396284bf74cd08c16cea3085d647dd","clm_dd0684002259ee7d4232fa0c7cd1fab19785a1316bad917df98c0b36a374700f"],"created_at":"2026-09-14T02:13:33Z","created_by_operation":"op_3a12e625a6614eb38a44c43b260697e5","id":"pg_ca12c3cc2393559f992202de8950e558","maturity":"draft","page_type":"source","path":"pages/sources/looptroop-ai-looptroop-contributing-md-b96f5448251c-02de8950e558.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_72139a2ae8ef55e7ae706ff88aab3779"],"title":"looptroop-ai/LoopTroop/CONTRIBUTING.md @ b96f5448251c","updated_at":"2026-09-14T02:13:33Z","updated_by_operation":"op_3a12e625a6614eb38a44c43b260697e5"}
