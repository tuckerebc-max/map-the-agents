{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_20f595ad8df8899839f8d2da22e3629317b37cfd294fa3a4db9bf856c3e8fc32"],"opposing_claim_ids":[],"text":"Repository development practice: releases are deployed by creating a semver tag (without 'v') targeting main via the GitHub Release feature."},{"claim_ids":["clm_5b289535eb1d0e1431886570e6488df463c22eb5f8fdb4377d3a650226a140e4"],"opposing_claim_ids":[],"text":"Repository development practice: contributors target Python 3.8, format with black and isort, run CI via GitHub Actions, and use pre-commit hooks (flake8, mypy, bandit, etc.) for linting; tests use Pyunit."},{"claim_ids":["clm_6d00e8456e6b45c4866c383289e08be539c8cccc30bd69cad22523ab10c4798a"],"opposing_claim_ids":[],"text":"The codebase is layered: base depends on nothing; data on base; plugin on base and data; client on base, data, plugin; and app on all four."},{"claim_ids":["clm_a584d98cea3b80ed3e33d1e59389b401df7328610cf2fc378f293467babd64ae"],"opposing_claim_ids":[],"text":"Repository development practice: integration tests run against a live Steamship server using a 'test' profile in ~/.steamship.json, and a client fixture cleans up space-scoped resources, though apps, app versions, plugins, and plugin versions must be destroyed manually."}],"claim_ids":["clm_20f595ad8df8899839f8d2da22e3629317b37cfd294fa3a4db9bf856c3e8fc32","clm_5b289535eb1d0e1431886570e6488df463c22eb5f8fdb4377d3a650226a140e4","clm_6d00e8456e6b45c4866c383289e08be539c8cccc30bd69cad22523ab10c4798a","clm_a584d98cea3b80ed3e33d1e59389b401df7328610cf2fc378f293467babd64ae"],"created_at":"2026-09-14T02:43:24Z","created_by_operation":"op_01dbec3dc60441d4bf73a8f708f121cb","id":"pg_28c0901570585ef78e686ba7b18eed21","maturity":"draft","page_type":"source","path":"pages/sources/steamship-core-python-client-developing-md-62b3f9659fd4-6ba7b18eed21.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ab7ea1830b0e5ed3a293bcc7c158e886"],"title":"steamship-core/python-client/DEVELOPING.md @ 62b3f9659fd4","updated_at":"2026-09-14T02:43:24Z","updated_by_operation":"op_01dbec3dc60441d4bf73a8f708f121cb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_21d437d194f5624aae880abc9ff6d8100bf46e08ce2c53e436615dd23000b314"],"opposing_claim_ids":[],"text":"The package is installable via pip as 'steamship'."},{"claim_ids":["clm_acb36fdd14ccde9079d51375169d81bf26e3cc706ecc4de93165597f907a194c"],"opposing_claim_ids":[],"text":"The README points agent builders to a multimodal agent starter project, an agent guidebook, and a separate Steamship-Langchain compatibility library for hosting LangChain agents."},{"claim_ids":["clm_dcb60a61f6d6066125c3716b67710ea1441c26471b9cbebb4010a2ebe3a5cede"],"opposing_claim_ids":[],"text":"The library supports building and deploying Agents, Packages, and Plugins on Steamship, and making client calls to a Steamship Package from Python."}],"claim_ids":["clm_21d437d194f5624aae880abc9ff6d8100bf46e08ce2c53e436615dd23000b314","clm_acb36fdd14ccde9079d51375169d81bf26e3cc706ecc4de93165597f907a194c","clm_dcb60a61f6d6066125c3716b67710ea1441c26471b9cbebb4010a2ebe3a5cede"],"created_at":"2026-09-14T02:43:24Z","created_by_operation":"op_01dbec3dc60441d4bf73a8f708f121cb","id":"pg_4ae0c5ed0f7351f08431a010cbcba1f8","maturity":"draft","page_type":"source","path":"pages/sources/steamship-core-python-client-readme-md-62b3f9659fd4-a010cbcba1f8.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f23f6d1ed36e5c5cb77f8776867625b7"],"title":"steamship-core/python-client/README.md @ 62b3f9659fd4","updated_at":"2026-09-14T02:43:24Z","updated_by_operation":"op_01dbec3dc60441d4bf73a8f708f121cb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_6102697f93661c6927175ba582af73ed1f6e77450acadcdc40df59cbc1f5fc80"],"opposing_claim_ids":[],"text":"Configuration parameters without defaults are mandatory: instance creation fails if the user omits them or supplies a wrong type, so packages receive structurally matching config; there are no optional parameters."},{"claim_ids":["clm_918d29d190d877c5d04f0ef359ac5f7c0d931809ba166d9854f8186125c01137"],"opposing_claim_ids":[],"text":"Packages and plugins define configuration by subclassing Config with typed fields (boolean, string, or number), a description, and an optional default, returned via a config_cls class method."},{"claim_ids":["clm_e88ca0424a4007d1da77308888dbc86d1eb06a25c035bfc265b5ad8a6e6dfb71"],"opposing_claim_ids":[],"text":"Config values are exposed to package/plugin code via self.config and are automatically populated by Steamship at invocation time."}],"claim_ids":["clm_6102697f93661c6927175ba582af73ed1f6e77450acadcdc40df59cbc1f5fc80","clm_918d29d190d877c5d04f0ef359ac5f7c0d931809ba166d9854f8186125c01137","clm_e88ca0424a4007d1da77308888dbc86d1eb06a25c035bfc265b5ad8a6e6dfb71"],"created_at":"2026-09-14T02:43:24Z","created_by_operation":"op_01dbec3dc60441d4bf73a8f708f121cb","id":"pg_4dfba4ff676558d6b8e2c6abdb75acbd","maturity":"draft","page_type":"source","path":"pages/sources/steamship-core-python-client-docs-nextra-developing-configuration-rst--c6abdb75acbd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4166b4860b005808898e487c5e0ec4ca"],"title":"steamship-core/python-client/docs/nextra/developing/configuration.rst @ 62b3f9659fd4","updated_at":"2026-09-14T02:43:24Z","updated_by_operation":"op_01dbec3dc60441d4bf73a8f708f121cb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1cfd03bf28362670b6ffadcc26c93fb838998c2dfddf9d8e4357239bc074534d"],"opposing_claim_ids":[],"text":"Runtime dependencies include requests, pydantic, aiohttp, inflection, fluent-logger, toml, click, semver, and tiktoken."}],"claim_ids":["clm_1cfd03bf28362670b6ffadcc26c93fb838998c2dfddf9d8e4357239bc074534d"],"created_at":"2026-09-14T02:43:24Z","created_by_operation":"op_01dbec3dc60441d4bf73a8f708f121cb","id":"pg_6e50aaf4bd205b8a9308443c39aea15c","maturity":"draft","page_type":"source","path":"pages/sources/steamship-core-python-client-requirements-txt-62b3f9659fd4-443c39aea15c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_aad2f2ef38ba57499dfbb87bec9a06be"],"title":"steamship-core/python-client/requirements.txt @ 62b3f9659fd4","updated_at":"2026-09-14T02:43:24Z","updated_by_operation":"op_01dbec3dc60441d4bf73a8f708f121cb"}
