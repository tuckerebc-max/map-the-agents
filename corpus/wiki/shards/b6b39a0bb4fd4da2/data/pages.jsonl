{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_21406c6940b753b151aedd64c26e55ab65a3c4606406158bddd7ea98c9a95ed8"],"opposing_claim_ids":[],"text":"Repository development practice: a pre-commit hook automatically runs Prettier, ESLint, and a project build on each pushed commit; Prettier, ESLint, and JS/TS Nightly extensions are recommended."},{"claim_ids":["clm_4e241d6a5b663061563f683ae52ee899a2984ccc8400a61fddba7b8894970795"],"opposing_claim_ids":[],"text":"Repository development practice: contributions follow a fork-clone-branch workflow, creating a new branch and installing dependencies before making changes."},{"claim_ids":["clm_580300d4da0d6e66e977f328c4a70f6663d33fb6b505befcd78093d05030c4f3"],"opposing_claim_ids":[],"text":"Repository development practice: the project is run locally with 'yarn dev' and viewed at http://localhost:3000."},{"claim_ids":["clm_82708ac8f181bd633a7e3e49a883aa29db55740f31b1b2ca712fa2b18b4750b1"],"opposing_claim_ids":[],"text":"The repository is the landing page website for PearAI, described as an open-source AI-powered code editor, published at trypear.ai."},{"claim_ids":["clm_a6b8c23d8af6152b189159f7eccb747aa283f95f2d1488ed022b2cfd4729502f"],"opposing_claim_ids":[],"text":"Repository development practice: configuration requires environment variables in a .env.local file, including NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY for the Supabase backend."},{"claim_ids":["clm_c2e050d6a9ae8e6c981ae2ce372afe30b6891017d66693fb66b70e70e70e7408"],"opposing_claim_ids":[],"text":"Repository development practice: local setup requires Yarn, cloning the repo, and running 'yarn install' to install NPM packages."},{"claim_ids":["clm_e96d5f8503d57af74d56df20cd4a96ceb9f56b6d69e322df38862dd717a7a71f"],"opposing_claim_ids":[],"text":"The README lists Next.js, Vercel, Tailwind CSS, and TypeScript as the technologies the project is built with."}],"claim_ids":["clm_21406c6940b753b151aedd64c26e55ab65a3c4606406158bddd7ea98c9a95ed8","clm_4e241d6a5b663061563f683ae52ee899a2984ccc8400a61fddba7b8894970795","clm_580300d4da0d6e66e977f328c4a70f6663d33fb6b505befcd78093d05030c4f3","clm_82708ac8f181bd633a7e3e49a883aa29db55740f31b1b2ca712fa2b18b4750b1","clm_a6b8c23d8af6152b189159f7eccb747aa283f95f2d1488ed022b2cfd4729502f","clm_c2e050d6a9ae8e6c981ae2ce372afe30b6891017d66693fb66b70e70e70e7408","clm_e96d5f8503d57af74d56df20cd4a96ceb9f56b6d69e322df38862dd717a7a71f"],"created_at":"2026-09-14T04:28:04Z","created_by_operation":"op_7263047df4c54bf8bb5f50d62208292a","id":"pg_2cf15823724c54fcb40e9283ad35811a","maturity":"draft","page_type":"source","path":"pages/sources/trypear-pear-landing-page-readme-md-7e52467a58c4-9283ad35811a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3dc11cf599705b929d021f79ece8a606"],"title":"trypear/pear-landing-page/README.md @ 7e52467a58c4","updated_at":"2026-09-14T04:28:04Z","updated_by_operation":"op_7263047df4c54bf8bb5f50d62208292a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_47b955bb6f1cb418a4a0b7f8caa962be7527041f0f6be95d8c3eac0ef04bbc92"],"opposing_claim_ids":[],"text":"The i18n plan calls for Next.js i18n configuration in next.config.js, a translation file structure with type safety, a language selector with persisted preference, and testing with native Japanese speakers."},{"claim_ids":["clm_5a1456017a9e4f6fe5d3d683a0e0b8d3cbb074926347cecd5e412aa5bf051ac3"],"opposing_claim_ids":[],"text":"The i18n plan is a proposal awaiting approval; Japanese support appears to be planned rather than already implemented in this snapshot."},{"claim_ids":["clm_c22f100d2faeefe964969e583c0f6698e3d71604739e0c1ce184eea177b1cbc8"],"opposing_claim_ids":[],"text":"A planning document proposes adding i18n support for Japanese rather than separate translated pages, citing maintainability, easier addition of languages, DRY code, and better SEO handling."}],"claim_ids":["clm_47b955bb6f1cb418a4a0b7f8caa962be7527041f0f6be95d8c3eac0ef04bbc92","clm_5a1456017a9e4f6fe5d3d683a0e0b8d3cbb074926347cecd5e412aa5bf051ac3","clm_c22f100d2faeefe964969e583c0f6698e3d71604739e0c1ce184eea177b1cbc8"],"created_at":"2026-09-14T04:28:04Z","created_by_operation":"op_7263047df4c54bf8bb5f50d62208292a","id":"pg_2fbe23fa812e5af0945f8c821873ff68","maturity":"draft","page_type":"source","path":"pages/sources/trypear-pear-landing-page-japanese-implementation-plan-md-7e52467a58c4-8c821873ff68.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_cbf550e6783b5fa3b5d00c6eefcdd15d"],"title":"trypear/pear-landing-page/japanese-implementation-plan.md @ 7e52467a58c4","updated_at":"2026-09-14T04:28:04Z","updated_by_operation":"op_7263047df4c54bf8bb5f50d62208292a"}
