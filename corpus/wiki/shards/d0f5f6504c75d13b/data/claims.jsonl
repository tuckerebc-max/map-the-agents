{"access":"public","created_at":"2026-09-14T03:11:52Z","created_by_operation":"op_626760b532864ef8bf32f30dddb3ff40","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3c0fada2bfb9670067c86594af6a32fa6abb56b0359b721ff8c523a627a18603","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"plandex-ai/plandex@e2d772072efa snapshot 99984345a25cc48d","timeframe":null},"slice_ids":["slc_4d2397f306a5908e851f924e2461f847f4b5b0badc4ed8ed1874fc487b42788a"],"source_ids":["src_119ec9a457025664a2b07868a7c46610"],"text":"AI-generated changes are kept in a cumulative diff review sandbox separate from project files until applied, with controlled command execution so changes can be rolled back and debugged.","updated_at":"2026-09-14T03:11:52Z","updated_by_operation":"op_626760b532864ef8bf32f30dddb3ff40"}
{"access":"public","created_at":"2026-09-14T03:11:52Z","created_by_operation":"op_626760b532864ef8bf32f30dddb3ff40","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4a67f0a93f8e4e3036478f701100eced0d136a9376641035ea7313f002827c66","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"plandex-ai/plandex@e2d772072efa snapshot 99984345a25cc48d","timeframe":null},"slice_ids":["slc_de0adcd5b24294bbf56e67ecf31e15fbbe5fe78e91f16ef5bf650d0b8cf5e5e4","slc_fcd2ff40a1fb4565af63c1faf97edf81102f5119d00e1970c1f3ccd2d070d47a"],"source_ids":["src_119ec9a457025664a2b07868a7c46610"],"text":"The tool handles up to 2M tokens of context directly (~100k per file) and can index directories of 20M+ tokens using tree-sitter project maps, loading only what each step needs.","updated_at":"2026-09-14T03:11:52Z","updated_by_operation":"op_626760b532864ef8bf32f30dddb3ff40"}
