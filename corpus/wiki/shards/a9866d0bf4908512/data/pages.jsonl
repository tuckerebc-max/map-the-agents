{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_00c49aec09735a19a74393089a38aeb1dc1648637d24ca554c2fbab54ba8e741"],"opposing_claim_ids":[],"text":"Chat history is auto-saved and restored, and Chat Summarization compresses long conversations into a new chat file (original preserved) targeting roughly 30-40% of the original length, filtering out tool results, edits, and thinking blocks."},{"claim_ids":["clm_2717565ae2c198ba3020e1583a5011bf4ce11715365d9a0bb88e0554ecbcaac9"],"opposing_claim_ids":[],"text":"For ACP agents, a Hand over button summarizes the transcript with the Chat Assistant configuration and starts a fresh agent session seeded with that summary; auto-compression never triggers for agent sessions."}],"claim_ids":["clm_00c49aec09735a19a74393089a38aeb1dc1648637d24ca554c2fbab54ba8e741","clm_2717565ae2c198ba3020e1583a5011bf4ce11715365d9a0bb88e0554ecbcaac9"],"created_at":"2026-09-14T02:28:23Z","created_by_operation":"op_981783584856418dbf624a974e5a32e2","id":"pg_699fa8bb1e43576dbd7076ddb5cdb880","maturity":"draft","page_type":"source","path":"pages/sources/palm1r-qodeassist-docs-chat-summarization-md-558208df21ce-76ddb5cdb880.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8cfa61eae0f15c498b38735dc9443905"],"title":"Palm1r/QodeAssist/docs/chat-summarization.md @ 558208df21ce","updated_at":"2026-09-14T02:28:23Z","updated_by_operation":"op_981783584856418dbf624a974e5a32e2"}
