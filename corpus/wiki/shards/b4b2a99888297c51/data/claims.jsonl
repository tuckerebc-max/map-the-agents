{"access":"public","created_at":"2026-09-14T04:08:09Z","created_by_operation":"op_80e42ad16a4c4c04af395761c5c4e436","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f028fee0862c6241e0774fb6322525cf66588b783160ab9a50d1d4f26a871622","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"mason131928/hashagent@aaf72bd507e7 snapshot c140ae9412f930bb","timeframe":null},"slice_ids":["slc_929fcd9245e8e3d8bf2cbb6cabd2580a1e2b1ffe6f7be7ba8562654ef6a37b38"],"source_ids":["src_38c5c5530d0e536b9988e3568395ea95"],"text":"Web search parses public HTML/RSS rather than a supported search API, so upstream markup or anti-automation changes can temporarily break it; migration to an official API is the medium-term plan.","updated_at":"2026-09-14T04:08:09Z","updated_by_operation":"op_80e42ad16a4c4c04af395761c5c4e436"}
