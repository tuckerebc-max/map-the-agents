{"access":"public","created_at":"2026-09-14T04:08:09Z","created_by_operation":"op_80e42ad16a4c4c04af395761c5c4e436","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9b601423c1f292644093aa5913d2e0bf6c0586260702699835b42bac5ba87293","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"mason131928/hashagent@aaf72bd507e7 snapshot c140ae9412f930bb","timeframe":null},"slice_ids":["slc_b39927535c6fa292f1434f41659cea4aa21cbee0aa52c9ced0c577f20e8e35cf"],"source_ids":["src_38c5c5530d0e536b9988e3568395ea95"],"text":"Each turn runs a temperature-zero planning pass restricted to 'answer', 'clarify', or one schema-validated allowlisted tool call; tool names and arguments are validated before execution and the calculator never evaluates JavaScript.","updated_at":"2026-09-14T04:08:09Z","updated_by_operation":"op_80e42ad16a4c4c04af395761c5c4e436"}
