{"access":"public","created_at":"2026-09-14T03:56:06Z","created_by_operation":"op_85422e7caab040e4b58bfd0de5ac14ec","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5441a2e6c3f6353140a6343b08ec26f6e7481d1eae09875704ed271f54863bb8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"haseeb-heaven/open-agent@575401684ec1 snapshot 37fd1230e5bca33c","timeframe":null},"slice_ids":["slc_5610471f127821deb25ff0383b2af6d930e545ee1eae4783a6876ddf5c4e61d3","slc_5d0211ed0fa42a61aa10b5747124a7ad6778d29c557e88426106832ef34d5f55","slc_64b81fb54d9baff058f9a2ccb23b07a2047d64b549ab51111056781e900928f5","slc_baa4a050f0313a940f7c7869a79b047db75bd2203961fc8b53a50bed091de8dd","slc_db0de704c0dab7d5950e87b84960b57e902087505c659f24c8a75cfa1bfefdda"],"source_ids":["src_595b8e1ad29a59b598c78be8e0f00240"],"text":"Repository development practice: tests run from repo root with npm test using Vitest, which auto-loads root .env (missing keys skip; live quota soft-skips); unit and live provider test commands are documented, with live tests gated by RUN_LIVE_PROVIDER_TESTS / RUN_LOCAL_PROVIDER_TESTS env vars.","updated_at":"2026-09-14T03:56:06Z","updated_by_operation":"op_85422e7caab040e4b58bfd0de5ac14ec"}
