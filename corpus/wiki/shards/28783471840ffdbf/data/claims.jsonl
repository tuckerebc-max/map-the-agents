{"access":"public","created_at":"2026-09-14T03:56:06Z","created_by_operation":"op_85422e7caab040e4b58bfd0de5ac14ec","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2a90ca5fcfb6bc246d49970c362b7f29a134f6fb8053b4a0b3adde4c1c7dd425","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"haseeb-heaven/open-agent@575401684ec1 snapshot 37fd1230e5bca33c","timeframe":null},"slice_ids":["slc_86016246f673853d53db23faf27985170e253c254e6dffd09c18a1c3b2689285","slc_a266b76824611a953023829e399acf4d649560ac32da1fd4ce85f0966086e9f9"],"source_ids":["src_595b8e1ad29a59b598c78be8e0f00240"],"text":"The project is a fork of Google's Gemini CLI (Apache-2.0) with modifications by Haseeb Mir, and is itself licensed Apache-2.0.","updated_at":"2026-09-14T03:56:06Z","updated_by_operation":"op_85422e7caab040e4b58bfd0de5ac14ec"}
