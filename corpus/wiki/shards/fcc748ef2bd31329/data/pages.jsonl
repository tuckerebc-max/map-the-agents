{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7d67964c0dbc357dbd68f4fab9d79e177f68afe63467c580f4f2601f2950ab25"],"opposing_claim_ids":[],"text":"A removals file lists agents such as bmad-agent-sm, bmad-agent-qa, and bmad-agent-quick-flow-solo-dev, and skills such as bmad-create-product-brief, bmad-quick-spec, and bmad-init, as removed."},{"claim_ids":["clm_80b793230b2baf129bc02a564918a7adf5ae8fa40914a4047671ca5b0730cd98"],"opposing_claim_ids":[],"text":"The removals file also lists many bmm-prefixed agents and workflows (e.g. bmad-agent-bmm-architect, bmad-bmm-create-prd, bmad-bmm-dev-story) as removed, and notes bmad-index-docs and bmad-shard-doc were retired outright."}],"claim_ids":["clm_7d67964c0dbc357dbd68f4fab9d79e177f68afe63467c580f4f2601f2950ab25","clm_80b793230b2baf129bc02a564918a7adf5ae8fa40914a4047671ca5b0730cd98"],"created_at":"2026-09-14T03:38:45Z","created_by_operation":"op_0c0c00d73c4c4f91996aff6f667d8d0b","id":"pg_84bc41b872945cb49792dd0ebba51e16","maturity":"draft","page_type":"source","path":"pages/sources/bmad-code-org-bmad-method-removals-txt-94b6727b00c8-dd0ebba51e16.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4688737d995952a5ac0d490837365506"],"title":"bmad-code-org/BMAD-METHOD/removals.txt @ 94b6727b00c8","updated_at":"2026-09-14T03:38:45Z","updated_by_operation":"op_0c0c00d73c4c4f91996aff6f667d8d0b"}
