{"access":"public","created_at":"2026-09-14T02:17:32Z","created_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2cbd53cdbeb29c7344d0475b65510bf224de84d40ecbd488857fe59d45f83b37","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"mereyabdenbekuly-ctrl/clodex-ide@dc023d1f6fea snapshot 0b38f45985df361f","timeframe":null},"slice_ids":["slc_ab4ca465de70be443bf424052a036d61b451ef12ae99c60fd5f8f5017f9afded"],"source_ids":["src_daeebe89215b5df3bd0dc2edab1a66e2"],"text":"Utility-process crashes reject in-flight work, apply bounded restart policies, and do not replay side effects, with the main process owning supervision.","updated_at":"2026-09-14T02:17:32Z","updated_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a"}
