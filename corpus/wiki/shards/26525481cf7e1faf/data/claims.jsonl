{"access":"public","created_at":"2026-09-14T02:17:32Z","created_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5ac382a6e2aa2ff252643d7e68c1533b38961fc9d909b67d46913bd2923d696b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"mereyabdenbekuly-ctrl/clodex-ide@dc023d1f6fea snapshot 0b38f45985df361f","timeframe":null},"slice_ids":["slc_089b276a360b60c2907c633dcd8eb2a2e427db79b4c38e38f2bd8e491b375104","slc_d200fdb80be87c98bc144ac687336593bacee0aa5d5890992632e579bd311ce4"],"source_ids":["src_daeebe89215b5df3bd0dc2edab1a66e2"],"text":"The main process composes backend service groups such as task, file-tree, terminal, Git, diff, credentials, model providers, MCP, skills, plugins, network policy, and telemetry services.","updated_at":"2026-09-14T02:17:32Z","updated_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a"}
{"access":"public","created_at":"2026-09-14T02:17:32Z","created_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5bae3851a4151b76a2451f2fce10a7ecedd2eee4e4a1e88a9397000d4cb32729","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"mereyabdenbekuly-ctrl/clodex-ide@dc023d1f6fea snapshot 0b38f45985df361f","timeframe":null},"slice_ids":["slc_9f119bfd310c816815c1fcb1b76ad69319b7f9d9cd816d210dfafb3f5cdfcf9b"],"source_ids":["src_daeebe89215b5df3bd0dc2edab1a66e2"],"text":"Communication contracts include Karton for typed browser state and procedures, an Agent Host protocol, an MCP runtime normalizing stdio/HTTP/OAuth, runner contracts, and an Artifact Bridge with principal-scoped sessions and two-phase privileged writes.","updated_at":"2026-09-14T02:17:32Z","updated_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a"}
