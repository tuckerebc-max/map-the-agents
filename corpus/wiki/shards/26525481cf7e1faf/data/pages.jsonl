7a35fc7af50aac55b","clm_876e99da5d5d2bf4d32c96adbaabfd78b0a33d987d6cf49d239801ccca143b63","clm_87aed4c8803b90ee8a6ac432a2467a45d5f486b7340f891867a783f53e909054","clm_87c09092df9f604100710dbd86db38a21217a182997f98e206cc284b578ea48b","clm_87fa17da62037bef5f17293e6f21b3713d68c88b4a3464da6a18ab1f99394347","clm_91bdf3e14711c46a408005acb36dc4e4b9f6b695ad628d385fa74b12c5798d40","clm_c8027d7cc54be23e63d3851f161a1a5e1516ceea039ca9ed22d0ff27e7578ac0","clm_da57e40349fef1459d3346dc5f01fa6800175665a24cdad0f9e952324a7f6cde","clm_e5c32bb22106681f850eeaf27cd60a2bac5714c6fdecefd4385eb2ff4451a6df"],"created_at":"2026-09-14T02:17:32Z","created_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a","id":"pg_10ac79002e775d14b3f171eb5d353065","maturity":"draft","page_type":"entity","path":"pages/entities/mereyabdenbekuly-ctrl-clodex-ide-71eb5d353065.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"mereyabdenbekuly-ctrl/clodex-ide","updated_at":"2026-09-14T02:17:32Z","updated_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_226cec2acb27c79a2c00c6b04d314b3071e58a90b501809865ccfa5cdb3d418a"],"opposing_claim_ids":[],"text":"The application is an Electron app split into isolated runtime lanes including main, renderer, agent host, MCP host, sandbox worker, and a headless CLI host, each with documented source paths."},{"claim_ids":["clm_2cbd53cdbeb29c7344d0475b65510bf224de84d40ecbd488857fe59d45f83b37"],"opposing_claim_ids":[],"text":"Utility-process crashes reject in-flight work, apply bounded restart policies, and do not replay side effects, with the main process owning supervision."},{"claim_ids":["clm_5ac382a6e2aa2ff252643d7e68c1533b38961fc9d909b67d46913bd2923d696b"],"opposing_claim_ids":[],"text":"The main process composes backend service groups such as task, file-tree, terminal, Git, diff, credentials, model providers, MCP, skills, plugins, network policy, and telemetry services."},{"claim_ids":["clm_5bae3851a4151b76a2451f2fce10a7ecedd2eee4e4a1e88a9397000d4cb32729"],"opposing_claim_ids":[],"text":"Communication contracts include Karton for typed browser state and procedures, an Agent Host protocol, an MCP runtime normalizing stdio/HTTP/OAuth, runner contracts, and an Artifact Bridge with principal-scoped sessions and two-phase privileged writes."},{"claim_ids":["clm_6a0282749fda3cf2336879deab8f2c22bec9957ef06cf320c47649291cc71636"],"opposing_claim_ids":[],"text":"Agent turns run in an isolated Agent Host outside the main process: the Agent Core resolves goal, workspace, memory, and prompt, selects a model, and streams events back through the main process to the UI."},{"claim_ids":["clm_87fa17da62037bef5f17293e6f21b3713d68c88b4a3464da6a18ab1f99394347"],"opposing_claim_ids":[],"text":"Requested side effects are assessed by a policy component that either grants capability-bound approval for tool execution or denies/escalates; extension runtimes receive explicit capabilities rather than arbitrary host access."},{"claim_ids":["clm_e5c32bb22106681f850eeaf27cd60a2bac5714c6fdecefd4385eb2ff4451a6df"],"opposing_claim_ids":[],"text":"The product offers searchable task history, workspace-aware context, restart recovery, and continued work across sessions, with session continuity and workspace snapshot services listed in the architecture."}],"claim_ids":["clm_226cec2acb27c79a2c00c6b04d314b3071e58a90b501809865ccfa5cdb3d418a","clm_2cbd53cdbeb29c7344d0475b65510bf224de84d40ecbd488857fe59d45f83b37","clm_5ac382a6e2aa2ff252643d7e68c1533b38961fc9d909b67d46913bd2923d696b","clm_5bae3851a4151b76a2451f2fce10a7ecedd2eee4e4a1e88a9397000d4cb32729","clm_6a0282749fda3cf2336879deab8f2c22bec9957ef06cf320c47649291cc71636","clm_87fa17da62037bef5f17293e6f21b3713d68c88b4a3464da6a18ab1f99394347","clm_e5c32bb22106681f850eeaf27cd60a2bac5714c6fdecefd4385eb2ff4451a6df"],"created_at":"2026-09-14T02:17:32Z","created_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a","id":"pg_2c6759bc918e59a29ea9d948d0aa43db","maturity":"draft","page_type":"source","path":"pages/sources/mereyabdenbekuly-ctrl-clodex-ide-docs-developer-architecture-md-dc023d-d948d0aa43db.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_daeebe89215b5df3bd0dc2edab1a66e2"],"title":"mereyabdenbekuly-ctrl/clodex-ide/docs/developer/architecture.md @ dc023d1f6fea","updated_at":"2026-09-14T02:17:32Z","updated_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:17:32Z","created_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a","id":"pg_6ce1cc6eb2a75679b0365b3791d540b2","maturity":"draft","page_type":"source","path":"pages/sources/mereyabdenbekuly-ctrl-clodex-ide-release-notes-md-dc023d1f6fea-5b3791d540b2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e21c907bef1453b586d3e43cf532010d"],"title":"mereyabdenbekuly-ctrl/clodex-ide/.release-notes.md @ dc023d1f6fea","updated_at":"2026-09-14T02:17:32Z","updated_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_346d9420e567e8df9696228e6c03cd42180b33b0f7400e81d7b8ffb2d79888b5"],"opposing_claim_ids":[],"text":"Repository development practice: local setup involves cloning, enabling corepack pnpm 10.30.3, copying .env.example to .env and .env.dev, then building packages and starting apps/browser, never committing .env files or credentials."},{"claim_ids":["clm_3e581500b5fb5d192bc065b594c5679b8a601c00b0de667063969c450efbccfd"],"opposing_claim_ids":[],"text":"The Community Observed 21 preview packages are unsigned or ad-hoc signed, not notarized, lack Authenticode on Windows and vendor signatures on Linux, so users are told to verify SHA-256 and keep OS protections enabled."},{"claim_ids":["clm_6bc19c26e746317f4a238a0bbdb481969d549899f3d381e9ce6f513852ce9453"],"opposing_claim_ids":[],"text":"The project is licensed under GNU Affero General Public License v3.0, with third-party components keeping their original licenses and notices."},{"claim_ids":["clm_8311affde9b017729b618aabc6c510f0567c0cb2aefd5cd7a35fc7af50aac55b"],"opposing_claim_ids":[],"text":"Building from source requires Node.js 22.23.1, pnpm 10.30.3, and Git, with pnpm activated via corepack and a frozen-lockfile install."},{"claim_ids":["clm_876e99da5d5d2bf4d32c96adbaabfd78b0a33d987d6cf49d239801ccca143b63"],"opposing_claim_ids":[],"text":"CLODEx is an open-source, local-first agentic IDE for long-running engineering work that keeps code, Git, terminal, browser, models, and MCP tools in one durable desktop workspace."},{"claim_ids":["clm_87aed4c8803b90ee8a6ac432a2467a45d5f486b7340f891867a783f53e909054"],"opposing_claim_ids":[],"text":"CLODEx.xyz sign-in uses the system browser with an RFC 8252 loopback callback, state, and PKCE S256, and bearer tokens are not returned in the callback URL."},{"claim_ids":["clm_87c09092df9f604100710dbd86db38a21217a182997f98e206cc284b578ea48b"],"opposing_claim_ids":[],"text":"The stated product principle is that model output is input, not authority; sensitive operations can require explicit approval and remain reviewable."},{"claim_ids":["clm_91bdf3e14711c46a408005acb36dc4e4b9f6b695ad628d385fa74b12c5798d40"],"opposing_claim_ids":[],"text":"CLODEx began as a modified version of the Stagewise codebase, diverging at upstream commit ef9d249f, and documents lineage, attribution obligations, and a reproducible diff against the upstream base."},{"claim_ids":["clm_c8027d7cc54be23e63d3851f161a1a5e1516ceea039ca9ed22d0ff27e7578ac0"],"opposing_claim_ids":[],"text":"Repository development practice: before opening a pull request, contributors run pnpm check, typecheck, test, and security:secrets, and commits must be DCO-signed with focused tests for changed behavior."},{"claim_ids":["clm_da57e40349fef1459d3346dc5f01fa6800175665a24cdad0f9e952324a7f6cde"],"opposing_claim_ids":[],"text":"No evidence in the provided slices describes an agent or task performance evaluation harness or benchmark results; the release evidence described covers packaging, checksums, and byte audits rather than agent behavior scoring."},{"claim_ids":["clm_e5c32bb22106681f850eeaf27cd60a2bac5714c6fdecefd4385eb2ff4451a6df"],"opposing_claim_ids":[],"text":"The product offers searchable task history, workspace-aware context, restart recovery, and continued work across sessions, with session continuity and workspace snapshot services listed in the architecture."}],"claim_ids":["clm_346d9420e567e8df9696228e6c03cd42180b33b0f7400e81d7b8ffb2d79888b5","clm_3e581500b5fb5d192bc065b594c5679b8a601c00b0de667063969c450efbccfd","clm_6bc19c26e746317f4a238a0bbdb481969d549899f3d381e9ce6f513852ce9453","clm_8311affde9b017729b618aabc6c510f0567c0cb2aefd5cd7a35fc7af50aac55b","clm_876e99da5d5d2bf4d32c96adbaabfd78b0a33d987d6cf49d239801ccca143b63","clm_87aed4c8803b90ee8a6ac432a2467a45d5f486b7340f891867a783f53e909054","clm_87c09092df9f604100710dbd86db38a21217a182997f98e206cc284b578ea48b","clm_91bdf3e14711c46a408005acb36dc4e4b9f6b695ad628d385fa74b12c5798d40","clm_c8027d7cc54be23e63d3851f161a1a5e1516ceea039ca9ed22d0ff27e7578ac0","clm_da57e40349fef1459d3346dc5f01fa6800175665a24cdad0f9e952324a7f6cde","clm_e5c32bb22106681f850eeaf27cd60a2bac5714c6fdecefd4385eb2ff4451a6df"],"created_at":"2026-09-14T02:17:32Z","created_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a","id":"pg_78698d91cb2158409773d5699f96d65f","maturity":"draft","page_type":"source","path":"pages/sources/mereyabdenbekuly-ctrl-clodex-ide-readme-md-dc023d1f6fea-d5699f96d65f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d6e63ab21bcc5228be814dc529003ccd"],"title":"mereyabdenbekuly-ctrl/clodex-ide/README.md @ dc023d1f6fea","updated_at":"2026-09-14T02:17:32Z","updated_by_operation":"op_ae7a18c2574a418cb39f2b51701f410a"}
