{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_08aa382082e6e1e2ad9a8492dcac1f3cac7227cf36008247c2da51ce1a884e6b"],"opposing_claim_ids":[],"text":"ADR-001 documents a since-retired host-side shell controller that ran a filesystem job queue, per-repo flock exclusion, mention watching with ack_key dedup, and orphan recovery for stale .processing files."}],"claim_ids":["clm_08aa382082e6e1e2ad9a8492dcac1f3cac7227cf36008247c2da51ce1a884e6b"],"created_at":"2026-09-14T02:03:40Z","created_by_operation":"op_a057159e2b404f53a0efee43aa86767f","id":"pg_5379ec46443d5ba3bffba49262b3eefb","maturity":"draft","page_type":"source","path":"pages/sources/hivemoot-hivemoot-docs-adr-001-controller-runtime-migration-md-a49baa7-a49262b3eefb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_271bbe027567501cbbfc115c299b420e"],"title":"hivemoot/hivemoot/docs/adr/001-controller-runtime-migration.md @ a49baa71cf00","updated_at":"2026-09-14T02:03:40Z","updated_by_operation":"op_a057159e2b404f53a0efee43aa86767f"}
