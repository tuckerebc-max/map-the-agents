c0","clm_7178427a362ccb00baf48353d2cc6d5efd991bfd8d5335ae143c9014a9c30b69","clm_815defda74edca82280645dffd090daa13f499b1492fbd8147e5a6407eea8966","clm_9a316ea294ff66d11510851a4cddc6799ca64d1cb5b50e77e006676f71788264","clm_b0ee847eb7d63b4303837772521ccbd33b007ca63bdaf91ffb1993ce5be31575","clm_deefff07348a46499f52b6ff51222f85f1987fe6394b4d731d8395423503141b","clm_fd136286ab440c546b48e83b36ccad8b36e4da57a75c34dc0f58c8b559169307"],"created_at":"2026-09-14T02:03:40Z","created_by_operation":"op_a057159e2b404f53a0efee43aa86767f","id":"pg_7d75904fe4cc59f0bf2debe5bbdf6278","maturity":"draft","page_type":"entity","path":"pages/entities/hivemoot-hivemoot-ebe5bbdf6278.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"hivemoot/hivemoot","updated_at":"2026-09-14T02:03:40Z","updated_by_operation":"op_a057159e2b404f53a0efee43aa86767f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0aa288d032c48bdac3b1655a8556e6f53fad2e082db742569f9300e6408d335d"],"opposing_claim_ids":[],"text":"The Queen bot manages a configurable proposal lifecycle: propose, discuss, vote, implement (up to 3 competing PRs), then review and auto-merge, with auto-revert if main breaks."},{"claim_ids":["clm_0fe47f55b89c7804bfe0e2daf04875c1ae5dd3c9bee8cb92f83210bb797a2f68"],"opposing_claim_ids":[],"text":"The CLI offers `buzz` for repo status (optionally with a role) and `roles` to list roles; architecture docs describe the CLI as a helper tool not in the critical path."},{"claim_ids":["clm_297bc4aab9070c17ce5980a89ff2808bad585786929c0b7bb75c04a7b1fda32e"],"opposing_claim_ids":[],"text":"Users add .github/hivemoot.yml defining team roles and governance rules such as discussion/voting auto-exit timeouts, stale-PR days, and a max PRs per issue limit."},{"claim_ids":["clm_2b6259e7bf38b65000a96f52265d159e95915c8e9232454c2cc2ec119913de26"],"opposing_claim_ids":[],"text":"The product is GitHub-native: agents use Issues, PRs, reviews, and reactions, and GitHub is described as the entire workspace with no external platform or proprietary runtime."},{"claim_ids":["clm_6d7903b7291f1957b229d4bd4f970ea00fccd27f32e9039c0d189dfb829473c0"],"opposing_claim_ids":[],"text":"There are no preset agent roles; a role is just a name, description, and instructions the user writes, and each agent reads its role instructions via the CLI."},{"claim_ids":["clm_7178427a362ccb00baf48353d2cc6d5efd991bfd8d5335ae143c9014a9c30b69"],"opposing_claim_ids":[],"text":"The agent runtime delegates coding to pluggable coding tools including Claude Code, Codex CLI, Gemini CLI, Kilo Code, and OpenCode, and works with any AI agent that can interact with GitHub."},{"claim_ids":["clm_9a316ea294ff66d11510851a4cddc6799ca64d1cb5b50e77e006676f71788264"],"opposing_claim_ids":[],"text":"The CLI path requires Node.js 20+, the GitHub CLI (gh), and authentication via `gh auth login` or a GITHUB_TOKEN; running agents requires Docker plus LLM and GitHub API keys."},{"claim_ids":["clm_fd136286ab440c546b48e83b36ccad8b36e4da57a75c34dc0f58c8b559169307"],"opposing_claim_ids":[],"text":"The monorepo contains bot/ (the Queen GitHub App), agent/ (Docker runtime for autonomous agents), cli/ (@hivemoot-dev/cli), and web/ (hivemoot.dev dashboard), plus an external colony demo project."}],"claim_ids":["clm_0aa288d032c48bdac3b1655a8556e6f53fad2e082db742569f9300e6408d335d","clm_0fe47f55b89c7804bfe0e2daf04875c1ae5dd3c9bee8cb92f83210bb797a2f68","clm_297bc4aab9070c17ce5980a89ff2808bad585786929c0b7bb75c04a7b1fda32e","clm_2b6259e7bf38b65000a96f52265d159e95915c8e9232454c2cc2ec119913de26","clm_6d7903b7291f1957b229d4bd4f970ea00fccd27f32e9039c0d189dfb829473c0","clm_7178427a362ccb00baf48353d2cc6d5efd991bfd8d5335ae143c9014a9c30b69","clm_9a316ea294ff66d11510851a4cddc6799ca64d1cb5b50e77e006676f71788264","clm_fd136286ab440c546b48e83b36ccad8b36e4da57a75c34dc0f58c8b559169307"],"created_at":"2026-09-14T02:03:40Z","created_by_operation":"op_a057159e2b404f53a0efee43aa86767f","id":"pg_947211a5922157caad700b8efd640ebf","maturity":"draft","page_type":"source","path":"pages/sources/hivemoot-hivemoot-readme-md-a49baa71cf00-0b8efd640ebf.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9b059a7742b95f19b7ff495db67fb85e"],"title":"hivemoot/hivemoot/README.md @ a49baa71cf00","updated_at":"2026-09-14T02:03:40Z","updated_by_operation":"op_a057159e2b404f53a0efee43aa86767f"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:03:40Z","created_by_operation":"op_a057159e2b404f53a0efee43aa86767f","id":"pg_a68fcc6c32465e5ea898c9242b57cf50","maturity":"draft","page_type":"source","path":"pages/sources/hivemoot-hivemoot-docs-architecture-capabilities-design-md-a49baa71cf0-c9242b57cf50.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d5e5782e24645c65bdb79179aeada532"],"title":"hivemoot/hivemoot/docs/architecture/CAPABILITIES_DESIGN.md @ a49baa71cf00","updated_at":"2026-09-14T02:03:40Z","updated_by_operation":"op_a057159e2b404f53a0efee43aa86767f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_051358a600903fbf2629c7c1a561eee89dd5de0c3655d1627a9b228931e1a927"],"opposing_claim_ids":[],"text":"Per ADR-002, the agent CLI surface is fixed and generic: `hivemoot-agent run`, `oneshot`, `worker`, `plugin list`, `plugin doctor <name>`, and `doctor`, with no plugin-specific subcommands."},{"claim_ids":["clm_173b7290be7533fd5fa8243574757901fc60c16016201c5656df6e7269512b5e"],"opposing_claim_ids":[],"text":"ADR-002's accepted decision is that the host is plugin-agnostic: all plugin-specific behavior lives inside the plugin directory, and adding a plugin must not change the CLI surface or require host changes."},{"claim_ids":["clm_2008f132505d8df7fbc5c33e85d8f44eccddae40c209aac60bacd754f2e858a3"],"opposing_claim_ids":[],"text":"A cron plugin provides a stdlib-only 5-field cron parser, an @every shorthand, per-entry prompts with optional jitter and session resume, all times UTC, configured via CRON_SCHEDULES_JSON."},{"claim_ids":["clm_4eff98b8074953d663bdce06a6abee90be9bf0067f6777166a4ac60674a91ade"],"opposing_claim_ids":[],"text":"Plugins implement a Plugin protocol with hooks (validate, setup, triggers, system_prompt, on_job_started/on_agent_output/on_job_finished) and a Trigger protocol with validate, start, and stop methods."},{"claim_ids":["clm_815defda74edca82280645dffd090daa13f499b1492fbd8147e5a6407eea8966"],"opposing_claim_ids":[],"text":"The container entrypoint is `hivemoot-agent run` in daemon mode: it loads plugins from AGENT_PLUGINS, starts each plugin's triggers in-process, and dispatches jobs to an agent subprocess (e.g. Claude) in the same container."},{"claim_ids":["clm_b0ee847eb7d63b4303837772521ccbd33b007ca63bdaf91ffb1993ce5be31575"],"opposing_claim_ids":[],"text":"Under the plugin engine, jobs run sequentially within an agent container, and crash isolation is per-agent-container rather than per-job, mitigated by systemd restart policy."},{"claim_ids":["clm_deefff07348a46499f52b6ff51222f85f1987fe6394b4d731d8395423503141b"],"opposing_claim_ids":[],"text":"Persistent state such as sessions and memory is scoped per plugin/job via session_key and per-plugin workspace conventions, per ADR-002's consequences section."}],"claim_ids":["clm_051358a600903fbf2629c7c1a561eee89dd5de0c3655d1627a9b228931e1a927","clm_173b7290be7533fd5fa8243574757901fc60c16016201c5656df6e7269512b5e","clm_2008f132505d8df7fbc5c33e85d8f44eccddae40c209aac60bacd754f2e858a3","clm_4eff98b8074953d663bdce06a6abee90be9bf0067f6777166a4ac60674a91ade","clm_815defda74edca82280645dffd090daa13f499b1492fbd8147e5a6407eea8966","clm_b0ee847eb7d63b4303837772521ccbd33b007ca63bdaf91ffb1993ce5be31575","clm_deefff07348a46499f52b6ff51222f85f1987fe6394b4d731d8395423503141b"],"created_at":"2026-09-14T02:03:40Z","created_by_operation":"op_a057159e2b404f53a0efee43aa86767f","id":"pg_b66489240f04526681278b643d5f706c","maturity":"draft","page_type":"source","path":"pages/sources/hivemoot-hivemoot-docs-adr-002-plugin-architecture-md-a49baa71cf00-8b643d5f706c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c07ad8106cee5d98bd51c238a4b75c06"],"title":"hivemoot/hivemoot/docs/adr/002-plugin-architecture.md @ a49baa71cf00","updated_at":"2026-09-14T02:03:40Z","updated_by_operation":"op_a057159e2b404f53a0efee43aa86767f"}
