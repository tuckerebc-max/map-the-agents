{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2c40dd9364f2f178b782bfddf5f21143e4f8831ab90ee4dd648f0348c912b830","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_dae22db9c16ffa57d40464b31a2093ba6a420002916a4cb4dd4b1d76b9141e87"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"Authentication is handled by passing an authenticated Snowpark session, created with standard Snowflake connection parameters, to the gateway and its tools.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_37de4c1411acb67cefa0a66299b55fee0b2383dfbba4da1721f77c274c6d91d7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_2e0d063c3034c143145c64abab9dc73d71f12843e71ef8e6701b7299715e7698"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"Rather than forcing users to choose between Cortex Search RAG and Cortex Analyst Text2SQL, the gateway routes each request to the appropriate tool.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_512ae7d1a9db19ca531a9bc83a7874c76b591647898c50904ad277d1aac525f5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_c57ec7029b3c81c0cb62861dd3498393dda299ff64a9da59c49c3145790d9158"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"The framework supports four tool types: Cortex Search for unstructured data, Cortex Analyst for structured data, Python for custom operations such as third-party API calls, and SQL for custom user-built SQL pipelines.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_58ebf11e4fbd1a97d37e384f31f0be3aa5e0dc16a128f4a8b789624d14b9f5f4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_49232ac0efbbf50ade3cf50758f44e7cb0e4181be7125c1646504a568789abda","slc_8b0719f7e2dbcbc3d27c74b73de782eca06b7d660f242e04801c87d27e726478","slc_fffaaa8826d75015b1a38e270555bfafff990abd2ee9c59314020598cac42135"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"An Agent is constructed with a snowflake_connection and a tools list, and is invoked by calling it directly with a natural-language question string.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_60d1aeeb1bf95a4db105f8bd31861c53907cef1fd5987d7b3a1a7b3d4986b201","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_0cf92e306e31e2d403c288fe7fdf5316c6990f70da29137ea226facadd36020c","slc_246dd6b91cce48732f90f2c3960ba49fd393fdc011b76844a3d769a7b417a88f","slc_4be3591f67b2592cf9fae73796b899da228580435d690e01211eee713a6c2336","slc_78618fb52a88319c3b15a9ea5fb2d98409c1b448f3745143bc4456489b20d835","slc_8a618c203f35d241b2903fd171cdd4a31c101f25a18db759503f6b6f721bf1b6"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"Tools are instantiated from classes including CortexSearchTool, CortexAnalystTool, PythonTool, and SQLTool, configured with metadata such as service_name, semantic_model, tool_description, and a Snowpark session.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_643c1d58cf32bba0fc82d260c095d1521773cb567b17bb9f2024a3817092f9e2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_8fc04037265320d0410b99d0b30d572eb7a72dcb053b5c9168af1dcb9498f903","slc_ced49d1f3e5d5673b62792b159e1a4f7c2f57d2dcef4facb44d99acff51f5e82"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"The package installs via pip as orchestration-framework and is documented for Python 3.10 or 3.11 in a new virtual environment.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6ac89ab9f6d3e38383bcec97331e611a132ecd376c975548764d78d8d12a99cb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_10300aafc6f2327c0a7fc1753460136069f32bb6296ef0d38dfa2076e95651fe"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"A dedicated planner LLM decomposes the user's request into an execution plan, forming a task graph that invokes tool calls asynchronously and in parallel where possible, with Snowflake compute used for plan generation and tool execution.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_790fca3cb7d2ecfb533067a1c55f13198e3bf65ebcb9eb8f33d90321c00caa36","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_41325b7900756d9e5a53439f5d194ef83d376fac69db8977240186db6d1192ff","slc_46d5d17f7455ca5d915a540ed5325c4cf8730cffae0b4ebf8037cde9a6dfb204"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"The gateway logs at INFO level by default to show which tools answer a question, with LOGGING_LEVEL=DEBUG for more detail, and an optional Trulens integration (orchestration-framework[trulens]) provides execution traces via a TruAgent class.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7988f614b6d56876947c527af7c537e7dabcf8d1ffdbbc927b01ed9a237e4feb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_c6fbeab0d0b61bee901c82cc18864369e435ad1bc65e62f0107a334b4958ac46"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"The Agent Gateway is described as an agentic orchestration framework offering native support for Snowflake tools.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_85f4fda2e5440eb415122e6395464e63805a998efcf0a3a00775e68f89da8014","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_002f9dbcce8513cb589dffa518398cee1da37df2cc07155f87c223e0b301797a"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"Agents require the underlying Cortex Search, Cortex Analyst, SQL, or Python tools to be configured by the user before use.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d46995aa72fa0ac1ad62f0e83cfbdc13c5d80c684e3b247f642edeb8a787bbde","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_10300aafc6f2327c0a7fc1753460136069f32bb6296ef0d38dfa2076e95651fe"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"The architecture is stated to leverage the LLM Compiler design from Berkeley AI Research Lab, citing a 2024 paper on parallel function calling.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.5,"id":"clm_e59012651ea124b7b6a04f836ff0f8d29b7d0be7d6852c9f29b38b46519c56c8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=inference; facet=interfaces","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_5488186287c506f2ef4e1c0e9ca368a1a61c24ee16343fa7f73a476a4bd3b18a","slc_f62f941cda1831e59032b8155de8a3c3957a7765a2dce0feb641b949930f524b"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"Multiple tools of the same type, and tools in different Snowflake accounts or schemas via separate Snowpark sessions, appear attachable to a single agent.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
{"access":"public","created_at":"2026-09-14T04:22:13Z","created_by_operation":"op_ff7694cc95814166b02442e638e117e3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f87c1c3355267fa0e355173bfbb9d9de2fa403ac540cd7f55e22bc87fc555e8b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"snowflake-labs/orchestration-framework@9addb6d4b303 snapshot e02abe008bd13886","timeframe":null},"slice_ids":["slc_c4ddce4e5cc5293e6679c1e02ec97b4ecb759046738a3bef49c699b1259ad921"],"source_ids":["src_c0b2117589155b4da269322fcfcfbcdf"],"text":"The library is optimized for client-side orchestration; for orchestration managed inside Snowflake, the README recommends the Snowflake Cortex Agent API instead.","updated_at":"2026-09-14T04:22:13Z","updated_by_operation":"op_ff7694cc95814166b02442e638e117e3"}
