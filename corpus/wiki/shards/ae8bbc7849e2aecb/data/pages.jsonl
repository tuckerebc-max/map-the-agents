{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_443a7019da2bc313b421ebb210b9d5a9bc971491012c9cd5519842374c8b0653"],"opposing_claim_ids":[],"text":"Configuration is stored in the project's `pyproject.toml` under a `[tool.codeflash]` section, with settings such as module-root, tests-root, formatter-cmds, git-remote, ignore-paths, override-fixtures, and benchmarks-root."},{"claim_ids":["clm_e1cd4481dfccd6da77691397a5e48a57c608e2a95dbab46da31867bac4f8d692"],"opposing_claim_ids":[],"text":"A VS Code extension provides a sidebar configuration page for editing the project's pyproject.toml settings, validates configuration, and shows error messages for missing files, syntax errors, or conflicting settings."}],"claim_ids":["clm_443a7019da2bc313b421ebb210b9d5a9bc971491012c9cd5519842374c8b0653","clm_e1cd4481dfccd6da77691397a5e48a57c608e2a95dbab46da31867bac4f8d692"],"created_at":"2026-09-14T01:41:44Z","created_by_operation":"op_75bcd916bde248c0a225297f3b7f3bf4","id":"pg_8945302cbd4c52a89c0ad072fbfb9b2d","maturity":"draft","page_type":"source","path":"pages/sources/codeflash-ai-codeflash-docs-editor-plugins-vscode-configuration-mdx-a3-d072fbfb9b2d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_563647eb4e0e56d5b1a910fc463a6d67"],"title":"codeflash-ai/codeflash/docs/editor-plugins/vscode/configuration.mdx @ a3a38efc9ec3","updated_at":"2026-09-14T01:41:44Z","updated_by_operation":"op_75bcd916bde248c0a225297f3b7f3bf4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_443a7019da2bc313b421ebb210b9d5a9bc971491012c9cd5519842374c8b0653"],"opposing_claim_ids":[],"text":"Configuration is stored in the project's `pyproject.toml` under a `[tool.codeflash]` section, with settings such as module-root, tests-root, formatter-cmds, git-remote, ignore-paths, override-fixtures, and benchmarks-root."},{"claim_ids":["clm_7d851ecef6911863daab06c55a31ba9fc467ce58a588135d3f7d21ef4eeda081"],"opposing_claim_ids":[],"text":"The CLI supports optimizing a whole codebase with `codeflash --all`, a single script with `codeflash optimize myscript.py`, and per docs a single function via `codeflash --file path --function name`."},{"claim_ids":["clm_8885e8b091a26cc1def242f0b638286df8674b6d7f4e008c3a55ada4269f68da"],"opposing_claim_ids":[],"text":"The Python tool is installed via pip (or as a dev dependency with uv/poetry) and requires Python 3.9 or above; setup includes generating a Codeflash API key and installing a GitHub app."},{"claim_ids":["clm_949d5e5f97b915ae92efd84e17da8aefe4c561a33d93b3e1991be4db652b3fb6"],"opposing_claim_ids":[],"text":"Codeflash is described as a general-purpose Python optimizer that uses LLMs to generate optimization candidates, tests them for correctness, benchmarks them, and opens merge-ready pull requests with the best optimization."},{"claim_ids":["clm_c4da67cf2db1de57602f9f12efb6f10d84078dbe9d67c80f563c968c5c977e02"],"opposing_claim_ids":[],"text":"The tool is licensed under the BSL-1.1 license, with the LICENSE file located in the codeflash directory of the repository."}],"claim_ids":["clm_443a7019da2bc313b421ebb210b9d5a9bc971491012c9cd5519842374c8b0653","clm_7d851ecef6911863daab06c55a31ba9fc467ce58a588135d3f7d21ef4eeda081","clm_8885e8b091a26cc1def242f0b638286df8674b6d7f4e008c3a55ada4269f68da","clm_949d5e5f97b915ae92efd84e17da8aefe4c561a33d93b3e1991be4db652b3fb6","clm_c4da67cf2db1de57602f9f12efb6f10d84078dbe9d67c80f563c968c5c977e02"],"created_at":"2026-09-14T01:41:44Z","created_by_operation":"op_75bcd916bde248c0a225297f3b7f3bf4","id":"pg_b2b0af341a3d58998e91fd068a1f8e66","maturity":"draft","page_type":"source","path":"pages/sources/codeflash-ai-codeflash-readme-md-a3a38efc9ec3-fd068a1f8e66.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c610bb39b97f5455b12eada4e7a77247"],"title":"codeflash-ai/codeflash/README.md @ a3a38efc9ec3","updated_at":"2026-09-14T01:41:44Z","updated_by_operation":"op_75bcd916bde248c0a225297f3b7f3bf4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_47d965e16f03b9c347c381c072580f51987897b1c70306b225b37ebc44b9dc32"],"opposing_claim_ids":[],"text":"Because the tool uses generative AI, the docs caution that optimized code may behave differently from the original under certain conditions, and recommend reviewing all PRs it opens."}],"claim_ids":["clm_47d965e16f03b9c347c381c072580f51987897b1c70306b225b37ebc44b9dc32"],"created_at":"2026-09-14T01:41:44Z","created_by_operation":"op_75bcd916bde248c0a225297f3b7f3bf4","id":"pg_b8318fdb97f75a0bbe44fad78d4dbef6","maturity":"draft","page_type":"source","path":"pages/sources/codeflash-ai-codeflash-docs-getting-the-best-out-of-codeflash-mdx-a3a3-fad78d4dbef6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7e7b2b05d7fa535abf2def71379ace91"],"title":"codeflash-ai/codeflash/docs/getting-the-best-out-of-codeflash.mdx @ a3a38efc9ec3","updated_at":"2026-09-14T01:41:44Z","updated_by_operation":"op_75bcd916bde248c0a225297f3b7f3bf4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_72df9db2574fecf503da4c8eeecbeab13b4e8233897038f6e2ea0329da49cb43"],"opposing_claim_ids":[],"text":"The optimizer aims to find better algorithms, remove wasteful compute, and use caching or more efficient library methods, but does not modify the system architecture of the code it optimizes."},{"claim_ids":["clm_7d851ecef6911863daab06c55a31ba9fc467ce58a588135d3f7d21ef4eeda081"],"opposing_claim_ids":[],"text":"The CLI supports optimizing a whole codebase with `codeflash --all`, a single script with `codeflash optimize myscript.py`, and per docs a single function via `codeflash --file path --function name`."},{"claim_ids":["clm_c81a7a0a69b6b8ddbde60ad0b128bd2e0590a879c01e815ef77971ad99e0e72a"],"opposing_claim_ids":[],"text":"Per docs, Codeflash also supports JavaScript/TypeScript (installed via npm/yarn/pnpm/bun, configured in package.json or codeflash.config.js) and Java (via uv, with Maven/Gradle and JUnit/TestNG support)."},{"claim_ids":["clm_f84177d489d5765cb0a35b244fdd9d23c13b735374a3618f73318232da4bbabc"],"opposing_claim_ids":[],"text":"The product verifies optimization correctness by generating and running new regression tests alongside existing tests, and reports percentage speed increases and proofs of correctness in PR explanations."}],"claim_ids":["clm_72df9db2574fecf503da4c8eeecbeab13b4e8233897038f6e2ea0329da49cb43","clm_7d851ecef6911863daab06c55a31ba9fc467ce58a588135d3f7d21ef4eeda081","clm_c81a7a0a69b6b8ddbde60ad0b128bd2e0590a879c01e815ef77971ad99e0e72a","clm_f84177d489d5765cb0a35b244fdd9d23c13b735374a3618f73318232da4bbabc"],"created_at":"2026-09-14T01:41:44Z","created_by_operation":"op_75bcd916bde248c0a225297f3b7f3bf4","id":"pg_d15c68da8cef58819550d0c515c39d5f","maturity":"draft","page_type":"source","path":"pages/sources/codeflash-ai-codeflash-docs-index-mdx-a3a38efc9ec3-d0c515c39d5f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4f1d