{"access":"public","created_at":"2026-09-14T03:52:35Z","created_by_operation":"op_bb941566565546969d278ba2daf94899","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0c44421c9e3214370ff6ae51fa9e18ea24e9810789938d65cee3b1a07512b48d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"gabrielmaialva33/winx-code-agent@a48e7a9f7e86 snapshot 3dc3feafd9c47b9c","timeframe":null},"slice_ids":["slc_5a59c729842f1ce8ac604bad63c2feec981799fcccb67e17267235f20fe64895"],"source_ids":["src_6ce5b3301cc853339f515f7626188d8c"],"text":"Durable sessions survive HTTP disconnects: guardians are capped at 32 by default with tiered idle retention (30 minutes never-used, 24 hours used), and active commands are never evicted.","updated_at":"2026-09-14T03:52:35Z","updated_by_operation":"op_bb941566565546969d278ba2daf94899"}
{"access":"public","created_at":"2026-09-14T03:52:35Z","created_by_operation":"op_bb941566565546969d278ba2daf94899","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_11ff99f9eb38a7e680c02a6444ea1f3dae14710abfec58990717c078d122ee6b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"gabrielmaialva33/winx-code-agent@a48e7a9f7e86 snapshot 3dc3feafd9c47b9c","timeframe":null},"slice_ids":["slc_3367d413bbf8bf725d933ab6db268038703e71c516ad4221de80b60aa1d63409"],"source_ids":["src_6ce5b3301cc853339f515f7626188d8c"],"text":"The SEARCH/REPLACE matcher tolerates model mistakes: indentation adjustment, smart-quote normalization, line-number stripping, neighbor-block disambiguation, and one retry on over-escaped quotes, while refusing heavily fuzzy matches.","updated_at":"2026-09-14T03:52:35Z","updated_by_operation":"op_bb941566565546969d278ba2daf94899"}
{"access":"public","created_at":"2026-09-14T03:52:35Z","created_by_operation":"op_bb941566565546969d278ba2daf94899","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_13bd3a346b30c7b50bf5512510615d7a0bb26734cea32f4b292e980193f8b699","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"gabrielmaialva33/winx-code-agent@a48e7a9f7e86 snapshot 3dc3feafd9c47b9c","timeframe":null},"slice_ids":["slc_760980da607591c94cde9fde24642aea8c209edc90abc6fb27570a908c30dfe5","slc_fb659b1e4396f4c62b3c1207bc7c88436993d68786b425d3b430f92f41166f6b"],"source_ids":["src_6ce5b3301cc853339f515f7626188d8c"],"text":"HTTP security defaults include loopback-only binding, 32-byte minimum bearer tokens, chmod-600 token files, DNS-rebinding host checks, 64 MiB body cap, 120 req/min per-IP rate limiting, and delayed invalid-auth responses.","updated_at":"2026-09-14T03:52:35Z","updated_by_operation":"op_bb941566565546969d278ba2daf94899"}
