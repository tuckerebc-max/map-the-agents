{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:09:13Z","created_by_operation":"op_fd6603a8e1d647659cf3cddf44d3483e","id":"pg_b2446795a5315ff1833289d5757d911b","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-taskweaver-support-md-d44ddef23f90-89d5757d911b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_17679f83bce55d54a6c14a97e902c800"],"title":"microsoft/TaskWeaver/SUPPORT.md @ d44ddef23f90","updated_at":"2026-09-14T04:09:13Z","updated_by_operation":"op_fd6603a8e1d647659cf3cddf44d3483e"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:09:13Z","created_by_operation":"op_fd6603a8e1d647659cf3cddf44d3483e","id":"pg_b6c056603c2853ca89b8f62b6e7a1228","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-taskweaver-requirements-txt-d44ddef23f90-f62b6e7a1228.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b527f6b980d756529dde6ce12e279165"],"title":"microsoft/TaskWeaver/requirements.txt @ d44ddef23f90","updated_at":"2026-09-14T04:09:13Z","updated_by_operation":"op_fd6603a8e1d647659cf3cddf44d3483e"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0e4c68c55bc086e9e46ff6810ae365a3b7b08fb71cc454ad4734515ae4b16b4e"],"opposing_claim_ids":[],"text":"The execution mode is configured via the execution_service.kernel_mode parameter in taskweaver_config.json, with 'container' as the default value."},{"claim_ids":["clm_314e8e526daeb73cac57a3faa2e35a795b9a57ae5ccf9b4ba7444e69ade76c96"],"opposing_claim_ids":[],"text":"Container mode has documented limitations: slower startup, limited host access with only the session workspace directory mounted (files must be uploaded via /upload or the web upload button), and packages must be added to the Dockerfile and image rebuilt."},{"claim_ids":["clm_8752994f192f36c00576c975dd0610ff2150b9bc7aa07a4e448be047b11596a7"],"opposing_claim_ids":[],"text":"Code execution supports 'local' and 'container' modes; container mode (the default) runs code in a Docker container for a more secure environment, while local mode runs code as a subprocess and could let malicious users or LLM-generated code harm the host."},{"claim_ids":["clm_96cf7bbea9574367a22df3f9f87ee918392a2122c8322c91ab82c8c990096f1f"],"opposing_claim_ids":[],"text":"The default executor Docker image contains only dependencies from requirements.txt; users needing extra packages must modify the Dockerfile at TaskWeaver/docker/ces_container/Dockerfile and rebuild."},{"claim_ids":["clm_b9791d56140c2af904f104fcfccc03828779718c0bfc688a94a359169c36da58"],"opposing_claim_ids":[],"text":"Generated code is executed via a Jupyter Kernel, chosen as a well-established interactive computing tool supporting many languages."}],"claim_ids":["clm_0e4c68c55bc086e9e46ff6810ae365a3b7b08fb71cc454ad4734515ae4b16b4e","clm_314e8e526daeb73cac57a3faa2e35a795b9a57ae5ccf9b4ba7444e69ade76c96","clm_8752994f192f36c00576c975dd0610ff2150b9bc7aa07a4e448be047b11596a7","clm_96cf7bbea9574367a22df3f9f87ee918392a2122c8322c91ab82c8c990096f1f","clm_b9791d56140c2af904f104fcfccc03828779718c0bfc688a94a359169c36da58"],"created_at":"2026-09-14T04:09:13Z","created_by_operation":"op_fd6603a8e1d647659cf3cddf44d3483e","id":"pg_ce2dcfb3628353bab1a829db943e7ef9","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-taskweaver-website-docs-code-execution-md-d44ddef23f90-29db943e7ef9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a1d4cc1b8c3b514fb295c028808325ee"],"title":"microsoft/TaskWeaver/website/docs/code_execution.md @ d44ddef23f90","updated_at":"2026-09-14T04:09:13Z","updated_by_operation":"op_fd6603a8e1d647659cf3cddf44d3483e"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_40d8986fa5da28efbff70827ee87237f9817d18e424d619b5df06072ce1f0d6f"],"opposing_claim_ids":[],"text":"Shared information is stored as attachments inside posts rather than a separate structure so that, if a round fails, its shared entries can be filtered out by round status, analogous to transaction logging."},{"claim_ids":["clm_57168a4273beb7921e705cb4291ec282b5d9e6f2c90ad6b8aed04951555fa87f"],"opposing_claim_ids":[],"text":"The fixed star-topology orchestration is acknowledged by the docs as a limitation, though it preserves role independence."},{"claim_ids":["clm_6060f9975e9a49c013a25c77253d1df82e520bbffe6a51cee50227af4cb264b1"],"opposing_claim_ids":[],"text":"Roles are orchestrated in a star topology with the Planner at the center: the User interacts only with the Planner, which plans and instructs peripheral roles, each of which knows only the Planner."},{"claim_ids":["clm_65617be7cc443092f16b715769d1c8ba4c472c67e2cc8a14e50d89c7ac331e0d"],"opposing_claim_ids":[],"text":"The memory module stores conversation history between the user and roles plus a shared memory of information purposefully shared between roles; implementation is in taskweaver/memory/memory.py."},{"claim_ids":["clm_d85f192d45fff6877b53c81a35024e91c2e8c587342b861ab086c11abcf961ba"],"opposing_claim_ids":[],"text":"Shared memory entries are attachments on posts with fields type, content, scope ('round' or 'conversation'), and id; round-scoped entries expire with the round, and later entries with the same type from a role overwrite earlier ones."}],"claim_ids":["clm_40d8986fa5da28efbff70827ee87237f9817d18e424d619b5df06072ce1f0d6f","clm_57168a4273beb7921e705cb4291ec282b5d9e6f2c90ad6b8aed04951555fa87f","clm_6060f9975e9a49c013a25c77253d1df82e520bbffe6a51cee50227af4cb264b1","clm_65617be7cc443092f16b715769d1c8ba4c472c67e2cc8a14e50d89c7ac331e0d","clm_d85f192d45fff6877b53c81a35024e91c2e8c587342b861ab086c11abcf961ba"],"created_at":"2026-09-14T04:09:13Z","created_by_operation":"op_fd6603a8e1d647659cf3cddf44d3483e","id":"pg_d60a4aa1db98535e9a37c788d1a6b382","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-taskweaver-website-docs-memory-md-d44ddef23f90-c788d1a6b382.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a2d788c97d10553dac4a814bfe21c334"],"title":"microsoft/TaskWeaver/website/docs/memory.md @ d44ddef23f90","updated_at":"2026-09-14T04:09:13Z","updated_by_operation":"op_fd6603a8e1d647659cf3cddf44d3483e"}
