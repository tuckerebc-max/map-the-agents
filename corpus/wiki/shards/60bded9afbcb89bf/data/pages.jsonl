{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0c0b453a31272f313e11b5501d6d1ad4b7f8cb9444e63a047788c0d3c6a2c9e7"],"opposing_claim_ids":[],"text":"Browser automation is built in via /browser or --browser flags, with tools for tabs, tab groups, network and console inspection, extension bridge calls, and JavaScript execution."},{"claim_ids":["clm_119e4a8c669c368a0fb352bc72b9e464c2db2cc71c4cfcbbbf6f23e4a29ba6ad"],"opposing_claim_ids":[],"text":"Version 0.9.0 makes the Ink TUI the default interactive experience and adds a TextBuffer composer with word navigation, multiline input, Shift+Enter, and $skill autocomplete."},{"claim_ids":["clm_8d3b97bc088f8bc8dad41fe45c88178a80412c6a417098be9c6be33a3969a323"],"opposing_claim_ids":[],"text":"The agent supports multiple LLM providers including OpenRouter, OpenAI, AWS Bedrock, DeepSeek, Azure, Z.ai, Vertex AI, Ollama, llama.cpp, MLX, and local models."}],"claim_ids":["clm_0c0b453a31272f313e11b5501d6d1ad4b7f8cb9444e63a047788c0d3c6a2c9e7","clm_119e4a8c669c368a0fb352bc72b9e464c2db2cc71c4cfcbbbf6f23e4a29ba6ad","clm_8d3b97bc088f8bc8dad41fe45c88178a80412c6a417098be9c6be33a3969a323"],"created_at":"2026-09-14T01:35:30Z","created_by_operation":"op_e6666ce6e88b49c0a602625705d991f9","id":"pg_0667283206f25c2892c09b8d4246bb72","maturity":"draft","page_type":"source","path":"pages/sources/autohandai-code-cli-docs-announcing-0-9-md-f4775fdebd93-9b8d4246bb72.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0d916718666b539bb2147a0fe8d97982"],"title":"autohandai/code-cli/docs/announcing-0.9.md @ f4775fdebd93","updated_at":"2026-09-14T01:35:30Z","updated_by_operation":"op_e6666ce6e88b49c0a602625705d991f9"}
