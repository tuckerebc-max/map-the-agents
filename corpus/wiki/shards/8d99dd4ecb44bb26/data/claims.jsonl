{"access":"public","created_at":"2026-09-14T01:46:06Z","created_by_operation":"op_f5ff388fef4b4c318b173041afdcab98","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7146c544074f47c9fccb64d2dfa73bc5fe5bce693d2a990383d49f05959b4d1e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"dicklesworthstone/ntm@3c35f474879f snapshot 5c8f6d031fcbbfb6","timeframe":null},"slice_ids":["slc_23f54b0e919998d4295a25f021e03530666df865cbdc204f44519c8efa65b55e","slc_eddfef9f9a726070ac1619b45a8da9b1b23ed1189bcee02d5b748da1ad548118","slc_f6baacb00d2c5d1cef3ad2fd2b9309120545ae35588c1bb71c2cfd58c2a50797"],"source_ids":["src_6bf4e45019b550ebb846b84fdd88baf7"],"text":"NTM spawns named tmux sessions with labeled agent panes and a user pane, supports labels for multiple swarms per project, and --worktrees creates per-agent ntm/<session>/<agent> branches and worktrees for isolation.","updated_at":"2026-09-14T01:46:06Z","updated_by_operation":"op_f5ff388fef4b4c318b173041afdcab98"}
