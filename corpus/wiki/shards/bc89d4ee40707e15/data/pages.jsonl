{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_30f6187e5394d2fb01df7c4a3d76a1f82d22548e1a79ff13cb8212c285372d5f"],"opposing_claim_ids":[],"text":"Skills use a standard directory layout with a required SKILL.md plus optional scripts, references, and assets directories."},{"claim_ids":["clm_407fcea2b7b03e37d4f28bb2ffea510ee204cddd4842f4447469bee4954236dc"],"opposing_claim_ids":[],"text":"Skills can be installed from a marketplace, imported from GitHub (single or batch, with automatic directory-type detection), created, edited, and exported for use in other tools."},{"claim_ids":["clm_62d6e6c10118a8cc439316a8267ac53cdab9a7be61dbaa8a24f11e34f3d34534"],"opposing_claim_ids":[],"text":"Skills are pre-configured packages containing system prompt snippets, workflow rules, reference docs, and executable scripts, following the Agent Skills Specification standard."},{"claim_ids":["clm_cd976b5fb2443d0eea7337408c445f8481272b77314590ec153ff2ac784e18ed"],"opposing_claim_ids":[],"text":"Unlike agents (one at a time, full system prompt), multiple skills can be activated simultaneously to add domain knowledge to a conversation."}],"claim_ids":["clm_30f6187e5394d2fb01df7c4a3d76a1f82d22548e1a79ff13cb8212c285372d5f","clm_407fcea2b7b03e37d4f28bb2ffea510ee204cddd4842f4447469bee4954236dc","clm_62d6e6c10118a8cc439316a8267ac53cdab9a7be61dbaa8a24f11e34f3d34534","clm_cd976b5fb2443d0eea7337408c445f8481272b77314590ec153ff2ac784e18ed"],"created_at":"2026-09-14T03:17:52Z","created_by_operation":"op_61862834f43640459037a3380afaf083","id":"pg_028ce20be5bc5db08bbefbedfea055df","maturity":"draft","page_type":"source","path":"pages/sources/talkcody-talkcody-docs-content-docs-en-features-skills-mdx-5543bf92643-fbedfea055df.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_facfa6c3e30751b781d87f7964f2c9e3"],"title":"talkcody/talkcody/docs/content/docs/en/features/skills.mdx @ 5543bf926436","updated_at":"2026-09-14T03:17:52Z","updated_by_operation":"op_61862834f43640459037a3380afaf083"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:17:52Z","created_by_operation":"op_61862834f43640459037a3380afaf083","id":"pg_1d7931594fe75ebeb79f6fb1d720344a","maturity":"draft","page_type":"source","path":"pages/sources/talkcody-talkcody-docs-content-docs-zh-features-skills-mdx-5543bf92643-6fb1d720344a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_045339cf60705d24ad6821936ee3bfff"],"title":"talkcody/talkcody/docs/content/docs/zh/features/skills.mdx @ 5543bf926436","updated_at":"2026-09-14T03:17:52Z","updated_by_operation":"op_61862834f43640459037a3380afaf083"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_022e01b588d3ddcf2aef247a3afbd34bed294d295aa8237a5a07715c79947d36"],"opposing_claim_ids":[],"text":"Installers are offered for macOS (Apple Silicon/Intel), Windows x64, and Linux x86_64 AppImage."},{"claim_ids":["clm_456f413ca04a82c286606f0a4a47eceb2f130ae154f7da8f35e9a36f9e4b22a2"],"opposing_claim_ids":[],"text":"All data, conversations, and code are stored locally on the user's machine, with local SQLite storage shown in the architecture diagram."},{"claim_ids":["clm_55d716d6f6b0203c6ad5e217257fe91eea8c6a828f4d6769d4946ed6602830fa"],"opposing_claim_ids":[],"text":"The app supports multimodal input (text, voice, images, files), MCP server support, a built-in terminal, and an agents & skills marketplace."},{"claim_ids":["clm_6d9bad68aa14a3ee593d5ea6c001c53c1788c044187adcaf8966b40655a8e804"],"opposing_claim_ids":[],"text":"The product supports multiple AI providers including OpenAI, Anthropic, Google, and local models via Ollama or LM Studio, and can leverage ChatGPT Plus or GitHub Copilot subscriptions."},{"claim_ids":["clm_901c136f5acb1139632087c32c7ba4a777c75a35be2261a418451bd385310642"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are directed to a Development Setup Guide and CONTRIBUTING.md for building from source and contribution details."},{"claim_ids":["clm_d8b09a045891925e66f5bc3e186fc2ee26c379d0ce61174d48c829f77fe13005"],"opposing_claim_ids":[],"text":"The project acknowledges dependencies on Tauri, Bun, Monaco Editor, libSQL, Shadcn UI, and Fumadocs, among others."},{"claim_ids":["clm_f6b260120d0436848f1391d12ae14479baba2505bb47822879f2ee0512719db4"],"opposing_claim_ids":[],"text":"The product uses a two-tier architecture: a React 19 + TypeScript frontend and a Tauri 2 + Rust backend communicating over IPC."},{"claim_ids":["clm_fdcce1ded6504887e309cd161cb2910261f55d6131549abb7400b0bb129ec0c3"],"opposing_claim_ids":[],"text":"TalkCody is described as a free, op