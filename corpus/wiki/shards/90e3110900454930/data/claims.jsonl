{"access":"public","created_at":"2026-09-14T04:24:40Z","created_by_operation":"op_a62ba7d8262846e090b9fb069276df7a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f68e3fc9817198e49428809fe178d0caca78ea8295accdf2c2b0749680d9df01","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"swapperfinance/swapper-toolkit@deb74c56d9db snapshot fbc5afd676962fd5","timeframe":null},"slice_ids":["slc_e13ff618e5d725858d332b568ded57d2013474f368735d04cc4a6e2736b2d3f5"],"source_ids":["src_2d56c04eca73554e98f71095f3f89c10"],"text":"The /swapper-deposit skill triggers when a user asks to deposit, fund, top-up or bridge assets, when an agent detects insufficient wallet funds mid-task, or when fiat-to-crypto funding is wanted before a strategy.","updated_at":"2026-09-14T04:24:40Z","updated_by_operation":"op_a62ba7d8262846e090b9fb069276df7a"}
