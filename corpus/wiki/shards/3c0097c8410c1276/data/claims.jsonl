{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e981837b2faee44f44077fa93abe9351b9b65066b03a127ca824682c976ab758","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_522a472d682cb302744ba332fe9cf0295d40e2c75dd3c742636ea2b96c4dcd4e","slc_58bb546d8a84450930422d009507aca79696450076e7c28c8118465dc6d1e0d3","slc_5a051007c3a80087d24be42427ea31a4a55d403d6f17f37b31a6cfa9ccaa211d","slc_e339a86ad2e100e9fe02f101b23d7c83afda12eb8aef29310cb953403505ea15"],"source_ids":["src_7fd982292abb53c8b52683c857ddee14"],"text":"Agents open artifacts in preview tabs beside the terminal via 'clideck show', supporting Markdown, text, logs, JSON, HTML, PDFs, images, video, Mermaid diagrams, diffs, charts, and test results; users can also drop files onto the tab strip.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
