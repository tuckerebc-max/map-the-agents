{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_297fd424c4293b697b0488edd0dca0424eaa5bffa13bd248c7c67019f34c194b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_afe5edbe5aa9495e82e222fd9984cc7b51b5eedeaf5ac572ad293b90d8df03cc","slc_b1dbd23267956a758838f05d43ce2315f8a613abda9c89fbb611eb27129fa9ef"],"source_ids":["src_7fd982292abb53c8b52683c857ddee14"],"text":"Built-in plugins include Git Changes, Supertonic Voice, Emoji, and Smart Dictation, and additional plugins can be built with a plugin SDK.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_36589420c8d98b2331dbf51cf682394cd90d0f0a83d1e05b11be2e931d6fb8e2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_cbd5e9990af2e7842475e0fee7c228362c412e165d673c4f214bf067b96571f8","slc_e89e3ae5bd4976338b654fbc05c282c4053b9b165a23a2a7b3109cafa6e9e4d1"],"source_ids":["src_7b1fed18c3cf5df6be8a92179dd68721"],"text":"Repository development practice: keep changes simple and focused, open an issue before large changes, and include the problem, resulting behavior, and relevant checks in pull requests.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_51d6a420e0e1b20f861d93815e1c47247f735f39c311017e98d2b33a372e21ea","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_8c0593cb6599ae4eb1bf70346bf06ef638054801954b846bfbc242c193b7eb4d","slc_e0999b7617516b511c022083a8884520cc166a41ef59a49d97ddb601e7eb68a5"],"source_ids":["src_7fd982292abb53c8b52683c857ddee14"],"text":"The CLI supports --port, --data-dir, and --help flags; CLIDECK_PORT or PORT also sets the port, and data is stored in ~/.clideck-next by default.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5661d5f17fa58f91fc1ad22afa96997623fcc17d670d37744522f4b6fd6bd167","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_602e2f9f9bbdd3619aca12ed199bae39ec2535edbf6986b6dfe649e25ea5cc17"],"source_ids":["src_e98b3f88acf95c0f8330670e93a222cd"],"text":"Plugin backends run as arbitrary local code with the user's filesystem and network authority; worker isolation protects against accidental crashes but is explicitly not a malicious-code sandbox.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_81ab657395e3d17ea77cc70b626d3f31cb3f7cc0dd0f3d3cf794bd25c5757a21","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_be789a7420a5b20d21fc359838b1f2110d60f7a802c0cfaa76ffd542778031bf"],"source_ids":["src_7fd982292abb53c8b52683c857ddee14"],"text":"CliDeck runs Claude Code, Codex, Gemini CLI, OpenCode, Pi, and shell sessions in one browser window, grouped into projects, where each session is the agent's actual terminal with its own tools, configuration, and account.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_88f3d1edd2f0866f9424168848e72441ec09cc8163dd78f3a524dc2b4f5c8a7f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_6177a6a362a8995aa6bb7b658b88ecf0f2c98efc9fb3f5abb769a18c796ab9eb"],"source_ids":["src_7fd982292abb53c8b52683c857ddee14"],"text":"Sessions can be reopened and earlier conversations read, stopped sessions show last-used times, and session backups can be exported for recovery.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_93a28ba807e1aabb2aa26e55178985642cc9640fc985947a4225d8b50f6e2372","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_2a1ad71e32e10a26d8c2be8e1ab42d2b84b0de8cb17ac4493a2bd598f86f1309","slc_e89e3ae5bd4976338b654fbc05c282c4053b9b165a23a2a7b3109cafa6e9e4d1"],"source_ids":["src_7b1fed18c3cf5df6be8a92179dd68721"],"text":"Repository development practice: contributors use Node.js 22.12+, run npm ci and npm test, start the app with npm start using a separate dev data-dir, run UI checks with node --test, and test interface changes in both light and dark themes.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a2e502f09d390980e5d99721c1a5422a20b9cfce317980ab5257ae70908d0861","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_e0999b7617516b511c022083a8884520cc166a41ef59a49d97ddb601e7eb68a5"],"source_ids":["src_7fd982292abb53c8b52683c857ddee14"],"text":"CliDeck binds to localhost, and agent CLIs use their own network connections rather than going through CliDeck.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b21dc011cfc98509d5aa89a666bfb09f6923767b89f9e024f76cfb0bf53114bc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_c308585f3e8b348671b6c9066f87712e3cb57f91fb607edcfe65e7d9268c965c"],"source_ids":["src_7fd982292abb53c8b52683c857ddee14"],"text":"After starting, the web UI is opened at http://127.0.0.1:4000; the tool can also be run via npx.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b41f7b6e4b076487810bfa75625b880c113570ad8c9eaffc1d760c576b5bd236","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_09fdf63a32452685c42312fd08e43f46c8c8bb1f39ccdcbb746e22a68775e02d"],"source_ids":["src_e98b3f88acf95c0f8330670e93a222cd"],"text":"Plugin client code runs in a dedicated Worker, never in the CliDeck window, and cannot query or mutate host DOM; secret setting values are never sent to the browser, only a configured flag.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d6120aa7f01b74f2cb442a2b65f943e8d1c635691cf1f7aad770998e07db945b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"rustykuntz/clideck@2c381835565b snapshot eb88fdf2ee936171","timeframe":null},"slice_ids":["slc_65fa203586fb0d457373987d7daf4cc502c245ddd0484f97e83d177c234391bc","slc_98d77f7ad562ee29aa76be30f1952a17160ffb908b682a2f02cf896c629bb632"],"source_ids":["src_7fd982292abb53c8b52683c857ddee14"],"text":"CliDeck Ask lets agents send requests to other sessions and receive replies, including across providers; users type '@@' to find sessions, and agents discover teammates with 'clideck agents' and contact them with 'clideck ask'.","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
