236","clm_d6120aa7f01b74f2cb442a2b65f943e8d1c635691cf1f7aad770998e07db945b","clm_db69156ca29eb549d34b91ea8aa2de0194f8bef28be4113c8d61f52485c8721f","clm_e6400827251b143bdcd8a7b94e99971203d7c7e0bb3aba6272671c416147014d","clm_e981837b2faee44f44077fa93abe9351b9b65066b03a127ca824682c976ab758"],"created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","id":"pg_08045682f5aa5b3890d98f5d2d217368","maturity":"draft","page_type":"entity","path":"pages/entities/rustykuntz-clideck-8f5d2d217368.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"rustykuntz/clideck","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0888bae78aa741eea48ad5ad94ea31dee9c41bd65c144ae803c415ba77e3c4bc"],"opposing_claim_ids":[],"text":"Autopilot was removed because agents already have sub-agents, and mobile control was removed because harnesses provide their own remote access."},{"claim_ids":["clm_297fd424c4293b697b0488edd0dca0424eaa5bffa13bd248c7c67019f34c194b"],"opposing_claim_ids":[],"text":"Built-in plugins include Git Changes, Supertonic Voice, Emoji, and Smart Dictation, and additional plugins can be built with a plugin SDK."},{"claim_ids":["clm_51d6a420e0e1b20f861d93815e1c47247f735f39c311017e98d2b33a372e21ea"],"opposing_claim_ids":[],"text":"The CLI supports --port, --data-dir, and --help flags; CLIDECK_PORT or PORT also sets the port, and data is stored in ~/.clideck-next by default."},{"claim_ids":["clm_81ab657395e3d17ea77cc70b626d3f31cb3f7cc0dd0f3d3cf794bd25c5757a21"],"opposing_claim_ids":[],"text":"CliDeck runs Claude Code, Codex, Gemini CLI, OpenCode, Pi, and shell sessions in one browser window, grouped into projects, where each session is the agent's actual terminal with its own tools, configuration, and account."},{"claim_ids":["clm_88f3d1edd2f0866f9424168848e72441ec09cc8163dd78f3a524dc2b4f5c8a7f"],"opposing_claim_ids":[],"text":"Sessions can be reopened and earlier conversations read, stopped sessions show last-used times, and session backups can be exported for recovery."},{"claim_ids":["clm_a2e502f09d390980e5d99721c1a5422a20b9cfce317980ab5257ae70908d0861"],"opposing_claim_ids":[],"text":"CliDeck binds to localhost, and agent CLIs use their own network connections rather than going through CliDeck."},{"claim_ids":["clm_b21dc011cfc98509d5aa89a666bfb09f6923767b89f9e024f76cfb0bf53114bc"],"opposing_claim_ids":[],"text":"After starting, the web UI is opened at http://127.0.0.1:4000; the tool can also be run via npx."},{"claim_ids":["clm_d6120aa7f01b74f2cb442a2b65f943e8d1c635691cf1f7aad770998e07db945b"],"opposing_claim_ids":[],"text":"CliDeck Ask lets agents send requests to other sessions and receive replies, including across providers; users type '@@' to find sessions, and agents discover teammates with 'clideck agents' and contact them with 'clideck ask'."},{"claim_ids":["clm_db69156ca29eb549d34b91ea8aa2de0194f8bef28be4113c8d61f52485c8721f"],"opposing_claim_ids":[],"text":"The product requires Node.js 22.12 or newer and an installed agent CLI, and is installed globally via npm as clideck@2."},{"claim_ids":["clm_e981837b2faee44f44077fa93abe9351b9b65066b03a127ca824682c976ab758"],"opposing_claim_ids":[],"text":"Agents open artifacts in preview tabs beside the terminal via 'clideck show', supporting Markdown, text, logs, JSON, HTML, PDFs, images, video, Mermaid diagrams, diffs, charts, and test results; users can also drop files onto the tab strip."}],"claim_ids":["clm_0888bae78aa741eea48ad5ad94ea31dee9c41bd65c144ae803c415ba77e3c4bc","clm_297fd424c4293b697b0488edd0dca0424eaa5bffa13bd248c7c67019f34c194b","clm_51d6a420e0e1b20f861d93815e1c47247f735f39c311017e98d2b33a372e21ea","clm_81ab657395e3d17ea77cc70b626d3f31cb3f7cc0dd0f3d3cf794bd25c5757a21","clm_88f3d1edd2f0866f9424168848e72441ec09cc8163dd78f3a524dc2b4f5c8a7f","clm_a2e502f09d390980e5d99721c1a5422a20b9cfce317980ab5257ae70908d0861","clm_b21dc011cfc98509d5aa89a666bfb09f6923767b89f9e024f76cfb0bf53114bc","clm_d6120aa7f01b74f2cb442a2b65f943e8d1c635691cf1f7aad770998e07db945b","clm_db69156ca29eb549d34b91ea8aa2de0194f8bef28be4113c8d61f52485c8721f","clm_e981837b2faee44f44077fa93abe9351b9b65066b03a127ca824682c976ab758"],"created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","id":"pg_38ba26881c805838b8be6f3298110b05","maturity":"draft","page_type":"source","path":"pages/sources/rustykuntz-clideck-readme-md-2c381835565b-6f3298110b05.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7fd982292abb53c8b52683c857ddee14"],"title":"rustykuntz/clideck/README.md @ 2c381835565b","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_36589420c8d98b2331dbf51cf682394cd90d0f0a83d1e05b11be2e931d6fb8e2"],"opposing_claim_ids":[],"text":"Repository development practice: keep changes simple and focused, open an issue before large changes, and include the problem, resulting behavior, and relevant checks in pull requests."},{"claim_ids":["clm_93a28ba807e1aabb2aa26e55178985642cc9640fc985947a4225d8b50f6e2372"],"opposing_claim_ids":[],"text":"Repository development practice: contributors use Node.js 22.12+, run npm ci and npm test, start the app with npm start using a separate dev data-dir, run UI checks with node --test, and test interface changes in both light and dark themes."}],"claim_ids":["clm_36589420c8d98b2331dbf51cf682394cd90d0f0a83d1e05b11be2e931d6fb8e2","clm_93a28ba807e1aabb2aa26e55178985642cc9640fc985947a4225d8b50f6e2372"],"created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","id":"pg_6c52586723905c2ca8cbc3ff8ea45295","maturity":"draft","page_type":"source","path":"pages/sources/rustykuntz-clideck-contributing-md-2c381835565b-c3ff8ea45295.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7b1fed18c3cf5df6be8a92179dd68721"],"title":"rustykuntz/clideck/CONTRIBUTING.md @ 2c381835565b","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5661d5f17fa58f91fc1ad22afa96997623fcc17d670d37744522f4b6fd6bd167"],"opposing_claim_ids":[],"text":"Plugin backends run as arbitrary local code with the user's filesystem and network authority; worker isolation protects against accidental crashes but is explicitly not a malicious-code sandbox."},{"claim_ids":["clm_b41f7b6e4b076487810bfa75625b880c113570ad8c9eaffc1d760c576b5bd236"],"opposing_claim_ids":[],"text":"Plugin client code runs in a dedicated Worker, never in the CliDeck window, and cannot query or mutate host DOM; secret setting values are never sent to the browser, only a configured flag."},{"claim_ids":["clm_e6400827251b143bdcd8a7b94e99971203d7c7e0bb3aba6272671c416147014d"],"opposing_claim_ids":[],"text":"Plugins are self-contained folders with a clideck-plugin.json manifest plus optional server.js, client.js, and public/ assets; installation validates and atomically copies the folder into the plugin directory and never runs npm."}],"claim_ids":["clm_5661d5f17fa58f91fc1ad22afa96997623fcc17d670d37744522f4b6fd6bd167","clm_b41f7b6e4b076487810bfa75625b880c113570ad8c9eaffc1d760c576b5bd236","clm_e6400827251b143bdcd8a7b94e99971203d7c7e0bb3aba6272671c416147014d"],"created_at":"2026-09-14T02:37:44Z","created_by_operation":"op_d97a9b84d3f64589aee486488900698e","id":"pg_e70a42b1afa350f69c26b0c1ab176c54","maturity":"draft","page_type":"source","path":"pages/sources/rustykuntz-clideck-plugin-sdk-md-2c381835565b-b0c1ab176c54.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e98b3f88acf95c0f8330670e93a222cd"],"title":"rustykuntz/clideck/PLUGIN-SDK.md @ 2c381835565b","updated_at":"2026-09-14T02:37:44Z","updated_by_operation":"op_d97a9b84d3f64589aee486488900698e"}
