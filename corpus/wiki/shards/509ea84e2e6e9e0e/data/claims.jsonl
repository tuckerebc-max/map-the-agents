{"access":"public","created_at":"2026-09-14T01:44:25Z","created_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f63fcea83df9c64a7e2afc1fa98e24a7486380e044b5384b17ce2b4d8513fd81","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"d-kimuson/claude-code-viewer@9367cf006be9 snapshot d2e4b2b80b9562f7","timeframe":null},"slice_ids":["slc_ac795c8a707edd7e5efac2f2f893d71440a4b307b5fdd61913bb636eb6fbe5d5"],"source_ids":["src_b38396e590ec5341831a0c43366658e9"],"text":"The viewer makes no backups of session files, so when Claude Code's default 30-day cleanup deletes .jsonl transcripts those sessions disappear; users can raise cleanupPeriodDays in ~/.claude/settings.json.","updated_at":"2026-09-14T01:44:25Z","updated_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb"}
