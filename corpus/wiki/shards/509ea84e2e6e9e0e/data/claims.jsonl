{"access":"public","created_at":"2026-09-14T01:44:25Z","created_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e50e74f6baaf851763a416dd06162a72582f819ff925771c02d6363680b256ac","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"d-kimuson/claude-code-viewer@9367cf006be9 snapshot d2e4b2b80b9562f7","timeframe":null},"slice_ids":["slc_0421aa07a15ef37ee3236f5c15ccbf65e7255a3ca5cf2f52066d6a4fb43985b3","slc_05c0575ce9b028737c2a6e6345c5fab6c85d2db958d6038c9c0a94084fc1ae58"],"source_ids":["src_b38396e590ec5341831a0c43366658e9"],"text":"In subscription mode the chat input becomes a copy mode that produces an equivalent claude CLI command, which can be pasted into the built-in terminal to start or resume a session.","updated_at":"2026-09-14T01:44:25Z","updated_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb"}
