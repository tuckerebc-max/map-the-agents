1dac0d9891b37","clm_e4fe6e5ab1edc977fee4541dcee497d40d94170acd03d167f94bab1a4daec14d","clm_e50e74f6baaf851763a416dd06162a72582f819ff925771c02d6363680b256ac","clm_f359b953a53a103814198fb9b11001caef39b6bb7fd9e521e21bce05deb399c0","clm_f63fcea83df9c64a7e2afc1fa98e24a7486380e044b5384b17ce2b4d8513fd81"],"created_at":"2026-09-14T01:44:25Z","created_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb","id":"pg_39c276980bd05b44a50f5e16acdabe68","maturity":"draft","page_type":"entity","path":"pages/entities/d-kimuson-claude-code-viewer-5e16acdabe68.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"d-kimuson/claude-code-viewer","updated_at":"2026-09-14T01:44:25Z","updated_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T01:44:25Z","created_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb","id":"pg_77d8bc4cc41d5cd4a56967e5a8ede4ac","maturity":"draft","page_type":"source","path":"pages/sources/d-kimuson-claude-code-viewer-claude-md-9367cf006be9-67e5a8ede4ac.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ee07c25e70c35cf68e061b9c12dd6a62"],"title":"d-kimuson/claude-code-viewer/CLAUDE.md @ 9367cf006be9","updated_at":"2026-09-14T01:44:25Z","updated_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_143129fed5c74c2b08085027c7d259866a219fb5de706fc546ac687d61cb57e5"],"opposing_claim_ids":[],"text":"Windows is not supported as an operating system."},{"claim_ids":["clm_2a75a4d27cc4d14393c3120aac57a6589b182dd3a492d09bb3b03271f1a52ff2"],"opposing_claim_ids":[],"text":"The CLI accepts options including --port (default 3000), --hostname, --verbose, --password, --executable, --claude-dir, --api-only, and --base-path."},{"claim_ids":["clm_34eded67735cdb475367893e9b5d1a3c68ff89c5a4f8849f7e5749a23ccb74f1"],"opposing_claim_ids":[],"text":"Configuration can come from command-line options or environment variables such as CCV_PASSWORD and CCV_CC_EXECUTABLE_PATH, with CLI options taking precedence over environment variables."},{"claim_ids":["clm_5723cc779483262d08a585035b807ad0de57d3d9783ee789b735cf4a7cc5e573"],"opposing_claim_ids":[],"text":"The app reads Claude Code conversation logs from ~/.claude/projects/<project>/<session-id>.jsonl JSONL files and automatically discovers new projects and sessions."},{"claim_ids":["clm_5a1107dda98ff15127b004cd1344fbbad907ac83e0de2cced33132769a78917c"],"opposing_claim_ids":[],"text":"The product includes an integrated terminal emulator in a bottom panel, letting users launch Claude Code from the browser without leaving it."},{"claim_ids":["clm_746ef0fe0c9accc687c12d9e413503b3793e5ba8d1732072afdcad8f150a61a5"],"opposing_claim_ids":[],"text":"Conversation data is preserved through strict Zod schema validation, with a progressive-disclosure UI that reveals details on demand."},{"claim_ids":["clm_8265f2721d7e550113969bba288222b30882bdf6e1c101229720a3e9744bed4a"],"opposing_claim_ids":[],"text":"Authentication is a simple single-password mechanism without multi-user support, role-based access control, or OAuth; more sophisticated access control is left to infrastructure like reverse proxies or VPNs."},{"claim_ids":["clm_8ccf7a6c54579992915405c6872f10fe6159e863d602ff78a992e9fd81ad6d70"],"opposing_claim_ids":[],"text":"It is a PWA supporting Add to Home Screen on mobile with an optimized UI and push notifications when sessions complete."},{"claim_ids":["clm_c19be55894d6b155d12bce17b5c562df6ddd5866e7c7fa9a8bf1bb147037ea66"],"opposing_claim_ids":[],"text":"When a password is configured, /api routes require authentication via a ccv-session cookie from /api/auth/login or an Authorization: Bearer header; without a password, API auth is disabled."},{"claim_ids":["clm_e07fa3d4ceb04642151a02c248f057b4661abbcc030e20ac4b81dac0d9891b37"],"opposing_claim_ids":[],"text":"Due to Anthropic ToS ambiguity for subscription accounts, chat sending, session resuming, permission approval, and AskUserQuestion are opt-in; read-oriented features work independently of the Agent SDK."},{"claim_ids":["clm_e4fe6e5ab1edc977fee4541dcee497d40d94170acd03d167f94bab1a4daec14d"],"opposing_claim_ids":[],"text":"Requires Node.js 22.13.0 or later and Claude Code v1.0.125 or later; supported operating systems are macOS and Linux only."},{"claim_ids":["clm_e50e74f6baaf851763a416dd06162a72582f819ff925771c02d6363680b256ac"],"opposing_claim_ids":[],"text":"In subscription mode the chat input becomes a copy mode that produces an equivalent claude CLI command, which can be pasted into the built-in terminal to start or resume a session."},{"claim_ids":["clm_f63fcea83df9c64a7e2afc1fa98e24a7486380e044b5384b17ce2b4d8513fd81"],"opposing_claim_ids":[],"text":"The viewer makes no backups of session files, so when Claude Code's default 30-day cleanup deletes .jsonl transcripts those sessions disappear; users can raise cleanupPeriodDays in ~/.claude/settings.json."}],"claim_ids":["clm_143129fed5c74c2b08085027c7d259866a219fb5de706fc546ac687d61cb57e5","clm_2a75a4d27cc4d14393c3120aac57a6589b182dd3a492d09bb3b03271f1a52ff2","clm_34eded67735cdb475367893e9b5d1a3c68ff89c5a4f8849f7e5749a23ccb74f1","clm_5723cc779483262d08a585035b807ad0de57d3d9783ee789b735cf4a7cc5e573","clm_5a1107dda98ff15127b004cd1344fbbad907ac83e0de2cced33132769a78917c","clm_746ef0fe0c9accc687c12d9e413503b3793e5ba8d1732072afdcad8f150a61a5","clm_8265f2721d7e550113969bba288222b30882bdf6e1c101229720a3e9744bed4a","clm_8ccf7a6c54579992915405c6872f10fe6159e863d602ff78a992e9fd81ad6d70","clm_c19be55894d6b155d12bce17b5c562df6ddd5866e7c7fa9a8bf1bb147037ea66","clm_e07fa3d4ceb04642151a02c248f057b4661abbcc030e20ac4b81dac0d9891b37","clm_e4fe6e5ab1edc977fee4541dcee497d40d94170acd03d167f94bab1a4daec14d","clm_e50e74f6baaf851763a416dd06162a72582f819ff925771c02d6363680b256ac","clm_f63fcea83df9c64a7e2afc1fa98e24a7486380e044b5384b17ce2b4d8513fd81"],"created_at":"2026-09-14T01:44:25Z","created_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb","id":"pg_92923ff93f335624b6050a437f437315","maturity":"draft","page_type":"source","path":"pages/sources/d-kimuson-claude-code-viewer-readme-md-9367cf006be9-0a437f437315.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b38396e590ec5341831a0c43366658e9"],"title":"d-kimuson/claude-code-viewer/README.md @ 9367cf006be9","updated_at":"2026-09-14T01:44:25Z","updated_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_186cb8add44bf060085b77e93c463d5e5ed1332b870f225165f71605fcf3e7d3"],"opposing_claim_ids":[],"text":"Repository development practice: contributors must avoid 'as' casting, raw fetch, dev servers, and node built-ins; use Effect-TS and Hono RPC + TanStack Query, follow TDD, and run pnpm gatecheck check and lingui-check before committing."},{"claim_ids":["clm_f359b953a53a103814198fb9b11001caef39b6bb7fd9e521e21bce05deb399c0"],"opposing_claim_ids":[],"text":"Repository development practice: commit messages follow Conventional Commits, appear in release notes, and 'fix' is reserved for user-facing bugs while internal fixes use 'chore'."}],"claim_ids":["clm_186cb8add44bf060085b77e93c463d5e5ed1332b870f225165f71605fcf3e7d3","clm_f359b953a53a103814198fb9b11001caef39b6bb7fd9e521e21bce05deb399c0"],"created_at":"2026-09-14T01:44:25Z","created_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb","id":"pg_f776a85df1e35ea287dbe8600a8401f9","maturity":"draft","page_type":"source","path":"pages/sources/d-kimuson-claude-code-viewer-agents-md-9367cf006be9-e8600a8401f9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9ec3f70f133a593b995a9936418f370b"],"title":"d-kimuson/claude-code-viewer/AGENTS.md @ 9367cf006be9","updated_at":"2026-09-14T01:44:25Z","updated_by_operation":"op_26ffd482152b4679b5a9c5ba9f00f9fb"}
