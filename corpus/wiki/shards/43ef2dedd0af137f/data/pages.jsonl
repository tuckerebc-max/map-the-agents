{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_02f77ecb9c52d53c09ae1eff8c1019cf677d7ce9b70abfd6fe2ff5762bac12c5"],"opposing_claim_ids":[],"text":"Repository development practice: AGENTS.md instructs defining success criteria before coding, planning verification with the self-test skill, committing in small focused checkpoints, and running simplify before closing non-trivial work."},{"claim_ids":["clm_5c4cc40242278bcef3764eedbe513954a656a1b914a99a5120a08df94e31649a"],"opposing_claim_ids":[],"text":"Repository development practice: desktop changes are expected to be verified on the real Electron surface, not only by unit tests, and contributors must not delete session history or artifacts without approval."}],"claim_ids":["clm_02f77ecb9c52d53c09ae1eff8c1019cf677d7ce9b70abfd6fe2ff5762bac12c5","clm_5c4cc40242278bcef3764eedbe513954a656a1b914a99a5120a08df94e31649a"],"created_at":"2026-09-14T02:18:50Z","created_by_operation":"op_31e860d9bba443b997e814d34906e713","id":"pg_337dc66cd1cf5acab64203709bd6a90e","maturity":"draft","page_type":"source","path":"pages/sources/minghinmatthewlam-pi-gui-agents-md-eb9a7380705d-03709bd6a90e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2d54517eea9654f79ed28cf4660461b4"],"title":"minghinmatthewlam/pi-gui/AGENTS.md @ eb9a7380705d","updated_at":"2026-09-14T02:18:50Z","updated_by_operation":"op_31e860d9bba443b997e814d34906e713"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_06e0dbd46664ed1d9c79c3e8fc24b8ddf772541e7de6da62154429f95110b5fc"],"opposing_claim_ids":[],"text":"The app depends on @earendil-works/pi-coding-agent as its upstream runtime and uses node-pty for the integrated terminal."},{"claim_ids":["clm_3a6ffe09b53ab3335f02eb53ea0fca967a1b611290503c2cfa3f9e796656c7ce"],"opposing_claim_ids":[],"text":"Features include a threaded timeline with collapsible tool calls, an integrated node-pty terminal, an inline diff viewer toggled with Cmd/Ctrl+D, @-file mentions, image attachments, themes, and OS notifications when runs finish."},{"claim_ids":["clm_3fc46f19495864502d04abb40d85a862cf3726ee243aff195f62973f5954d721"],"opposing_claim_ids":[],"text":"Native computer use is not built into pi-gui; desktop/browser control is offered separately via the author's standalone computer-use-mcp server."},{"claim_ids":["clm_44331079c376013a27d99f61294eb18f19d9e5fe267ae56a734c9953a481a540"],"opposing_claim_ids":[],"text":"An orchestrator thread can spin up and supervise child worker threads, and each thread can run locally or in an isolated git worktree so parallel work does not collide."},{"claim_ids":["clm_4f71d3eaf14a8b67b90842ea2abbd1536f6dd003919b1adeb9ba65afd87b733e"],"opposing_claim_ids":[],"text":"The renderer communicates with the main process only through a typed IPC surface exposed by the preload bridge, with no broad Node access granted to the renderer."},{"claim_ids":["clm_5c4cc40242278bcef3764eedbe513954a656a1b914a99a5120a08df94e31649a"],"opposing_claim_ids":[],"text":"Repository development practice: desktop changes are expected to be verified on the real Electron surface, not only by unit tests, and contributors must not delete session history or artifacts without approval."},{"claim_ids":["clm_6032897e5cc7d98bab7e9b8e9a6b4363cb29ea9c47b00757f704d0d1f4f58389"],"opposing_claim_ids":[],"text":"pi persists each session as a JSONL transcript on disk, and pi-gui reads those files as the authoritative record for closed sessions instead of keeping a divergent copy."},{"claim_ids":["clm_718f2d0f03822247d92fce2429792f8fda244d9219df1824c11684a8e8719e00"],"opposing_claim_ids":[],"text":"pi-gui reuses pi's auth and session state, so provider credentials configured with the pi CLI carry over; providers connect via OAuth or API key in Settings."},{"claim_ids":["clm_74c52ebfcfd9961d38e015505f601039c0bfb086441c160503a39b0025e2a896"],"opposing_claim_ids":[],"text":"pi-gui is a Codex-style desktop app for the pi coding agent, in public beta for macOS (Apple Silicon) and Linux (AppImage)."},{"claim_ids":["clm_7e006a36f54d73716fb27c29ffb551414f644b139bc7568daa3f4cd500536dc4"],"opposing_claim_ids":[],"text":"The app is a UI shell around @earendil-works/pi-coding-agent rather than a separate agent runtime; session management, auth setup, and agent execution run through upstream pi."},{"claim_ids":["clm_832d90395d1481406e81d3762fe90137ef7f65d0b498c11b5daae173fc003fad"],"opposing_claim_ids":[],"text":"Repository development practice: contributors use Node 20+ with pnpm via corepack, and run pnpm dev/build/typecheck/lint/test from the repo root; desktop E2E tests use a Playwright+Electron harness split into lanes, with the core lane run by default."},{"claim_ids":["clm_e6e3569065d57049a44c6ea05da0a4d19a33844dc507a599ba5687207a2c6d0b"],"opposing_claim_ids":[],"text":"Supporting packages include pi-sdk-driver (a thin adapter to the pi coding agent), session-driver (shared session driver types), and catalogs (workspace/session catalog state)."},{"claim_ids":["clm_f55da37270386608e70c36267407f18c52354ebe18533e886ad85a2ec067a2cd"],"opposing_claim_ids":[],"text":"The Electron app is split into a React renderer, a narrow preload IPC bridge, and a Node main process handling windowing, session supervision, worktrees, PTYs, notifications, and persistence."}],"claim_ids":["clm_06e0dbd46664ed1d9c79c3e8fc24b8ddf772541e7de6da62154429f95110b5fc","clm_3a6ffe09b53ab3335f02eb53ea0fca967a1b611290503c2cfa3f9e796656c7ce","clm_3fc46f19495864502d04abb40d85a862cf3726ee243aff195f62973f5954d721","clm_44331079c376013a27d99f61294eb18f19d9e5fe267ae56a734c9953a481a540","clm_4f71d3eaf14a8b67b90842ea2abbd1536f6dd003919b1adeb9ba65afd87b733e","clm_5c4cc40242278bcef3764eedbe513954a656a1b914a99a5120a08df94e31649a","clm_6032897e5cc7d98bab7e9b8e9a6b4363cb29ea9c47b00757f704d0d1f4f58389","clm_718f2d0f03822247d92fce2429792f8fda244d9219df1824c11684a8e8719e00","clm_74c52ebfcfd9961d38e015505f601039c0bfb086441c160503a39b0025e2a896","clm_7e006a36f54d73716fb27c29ffb551414f644b139bc7568daa3f4cd500536dc4","clm_832d90395d1481406e81d3762fe90137ef7f65d0b498c11b5daae173fc003fad","clm_e6e3569065d57049a44c6ea05da0a4d19a33844dc507a599ba5687207a2c6d0b","clm_f55da37270386608e70c36267407f18c52354ebe18533e886ad85a2ec067a2cd"],"created_at":"2026-09-14T02:18:50Z","created_by_operation":"op_31e860d9bba443b997e814d34906e713","id":"pg_4a5da9c50232511d8f2c97943649321a","maturity":"draft","page_type":"source","path":"pages/sources/minghinmatthewlam-pi-gui-readme-md-eb9a7380705d-97943649321a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8d371595d4755a8ba2f8172c7dfb834b"],"title":"minghinmatthewlam/pi-gui/README.md @ eb9a7380705d","updated_at":"2026-09-14T02:18:50Z","updated_by_operation":"op_31e860d9bba443b997e814d34906e713"}
