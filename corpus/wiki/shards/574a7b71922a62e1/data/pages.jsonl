23641ac","clm_d624435eb0f1d70e5354ad13d8fe8e4ce0eae579dca448c886587106cbb67096","clm_f9c3de81a775341853e5f1ad9f418729260f7b379e065e4381fd1064b60fb732"],"created_at":"2026-09-14T01:48:12Z","created_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58","id":"pg_16c4fdcde4b054d89c44a76a6c24dd55","maturity":"draft","page_type":"entity","path":"pages/entities/entropy-research-devon-a76a6c24dd55.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"entropy-research/devon","updated_at":"2026-09-14T01:48:12Z","updated_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58"}
