{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3a35abc0ab3886c491577e5428afa1e059f7c475970138a961f111750923fb56"],"opposing_claim_ids":[],"text":"Running Devon requires node.js/npm, pipx, and at least one API key from Anthropic or OpenAI."},{"claim_ids":["clm_410eeadab9a9b048927a2028c47e957cdbbbbf3257edf51cf73ab659ddc5e955"],"opposing_claim_ids":[],"text":"The agent is documented to only access files and folders in the directory it was started from, and users can correct it mid-action."},{"claim_ids":["clm_4d0d33b3d19d15a490dc413142a8253f34c807ea17b37ff3c25c282a85b44c74"],"opposing_claim_ids":[],"text":"Documented limitations: minimal functionality for non-Python languages, sometimes needing to specify the target file, and immature local mode with significantly degraded performance."},{"claim_ids":["clm_4d0f083011863f5728f4354129479fe11e18c08aaa4aca9fbd4c93a4cf0924bf"],"opposing_claim_ids":[],"text":"The TUI offers a --debug mode and a --help flag listing available commands."},{"claim_ids":["clm_520f54ca532d02a216d8f5b8e6315fafea568ace62a747186ed375a6af5b7e94"],"opposing_claim_ids":[],"text":"The product collects basic event-type and failure telemetry, which users can disable by setting DEVON_TELEMETRY_DISABLED=true."},{"claim_ids":["clm_5280e2df4fdd745487c5c948e11ef64520db7c71d29424aa8094cc6601c5065a"],"opposing_claim_ids":[],"text":"The product ships as a backend installed via pipx (devon_agent) with a main UI run through npx devon-ui."},{"claim_ids":["clm_52b2a6d0924693977e4520fce30b98f172bebb599ceb0d5bd0ed15039db38f41"],"opposing_claim_ids":[],"text":"The project appears to track agent performance via SWE-bench Lite, citing a past milestone of beating AutoCodeRover and a goal to set SOTA there."},{"claim_ids":["clm_58c0f27c4120df079fda8b4c48ce40d10dbdcad9802cd44e542f7ce3a55a0d79"],"opposing_claim_ids":[],"text":"A terminal interface exists, installed globally via npm as devon-tui and launched with the devon-tui command."},{"claim_ids":["clm_a29750042a02082d9c8efc55eaa24d128ea90fa21bb813c68f30cc30023641ac"],"opposing_claim_ids":[],"text":"Windows support is not yet available; the README says the team is currently working on it."},{"claim_ids":["clm_d624435eb0f1d70e5354ad13d8fe8e4ce0eae579dca448c886587106cbb67096"],"opposing_claim_ids":[],"text":"Supported models include Claude 3.5 Sonnet, GPT4-o, Groq llama3-70b, and Ollama deepseek-coder:6.7b, with Gemini 1.5 Pro planned but unchecked."}],"claim_ids":["clm_3a35abc0ab3886c491577e5428afa1e059f7c475970138a961f111750923fb56","clm_410eeadab9a9b048927a2028c47e957cdbbbbf3257edf51cf73ab659ddc5e955","clm_4d0d33b3d19d15a490dc413142a8253f34c807ea17b37ff3c25c282a85b44c74","clm_4d0f083011863f5728f4354129479fe11e18c08aaa4aca9fbd4c93a4cf0924bf","clm_520f54ca532d02a216d8f5b8e6315fafea568ace62a747186ed375a6af5b7e94","clm_5280e2df4fdd745487c5c948e11ef64520db7c71d29424aa8094cc6601c5065a","clm_52b2a6d0924693977e4520fce30b98f172bebb599ceb0d5bd0ed15039db38f41","clm_58c0f27c4120df079fda8b4c48ce40d10dbdcad9802cd44e542f7ce3a55a0d79","clm_a29750042a02082d9c8efc55eaa24d128ea90fa21bb813c68f30cc30023641ac","clm_d624435eb0f1d70e5354ad13d8fe8e4ce0eae579dca448c886587106cbb67096"],"created_at":"2026-09-14T01:48:12Z","created_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58","id":"pg_305c96871d3b509091d4dd7b516b925a","maturity":"draft","page_type":"source","path":"pages/sources/entropy-research-devon-readme-md-8f68f1d74671-dd7b516b925a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c04f058aecdf5c55811d7a446755f67f"],"title":"entropy-research/Devon/README.md @ 8f68f1d74671","updated_at":"2026-09-14T01:48:12Z","updated_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0350cf7218bee21d88c2524379173949ac9df7d9b1094114483ee4d8033e0c62"],"opposing_claim_ids":[],"text":"Communication between agents, tools, and environments happens via an event handler/emitter system whose handlers are declared in the Session; registering tools and environments requires no handler changes."},{"claim_ids":["clm_348cda2931101d5673d42b601d317ea466ed39fb8446eecf32b69cd47543f265"],"opposing_claim_ids":[],"text":"Architecture comprises Environments (LocalShell, User), Tools, Agents (TaskAgent, ConversationalAgent), a Session orchestrator, and a config object, each with base classes in devon_agent modules."}],"claim_ids":["clm_0350cf7218bee21d88c2524379173949ac9df7d9b1094114483ee4d8033e0c62","clm_348cda2931101d5673d42b601d317ea466ed39fb8446eecf32b69cd47543f265"],"created_at":"2026-09-14T01:48:12Z","created_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58","id":"pg_adf744c46ae952f8a51d0c7520f07137","maturity":"draft","page_type":"source","path":"pages/sources/entropy-research-devon-contributor-md-8f68f1d74671-0c7520f07137.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_24feb810559a52cd9576b7942b32f17f"],"title":"entropy-research/Devon/contributor.md @ 8f68f1d74671","updated_at":"2026-09-14T01:48:12Z","updated_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_a1f55bc5e366107fde5d04645190cca2e4a4ed6bfee71d3d310fdce72324f995"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork, branch, commit descriptively, and open pull requests; PRs should include a descriptive title, rationale, test steps, and screenshots, and a maintainer reviews before merging."},{"claim_ids":["clm_f9c3de81a775341853e5f1ad9f418729260f7b379e065e4381fd1064b60fb732"],"opposing_claim_ids":[],"text":"Repository development practice: coding conventions require 4-space indentation, PEP 8 style, docstrings for public code, and descriptive names; local setup runs build.sh with DEVON_TELEMETRY_DISABLED=true."}],"claim_ids":["clm_a1f55bc5e366107fde5d04645190cca2e4a4ed6bfee71d3d310fdce72324f995","clm_f9c3de81a775341853e5f1ad9f418729260f7b379e065e4381fd1064b60fb732"],"created_at":"2026-09-14T01:48:12Z","created_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58","id":"pg_f6b92ae82d0e50d4ac37ea591a9db94c","maturity":"draft","page_type":"source","path":"pages/sources/entropy-research-devon-contributing-md-8f68f1d74671-ea591a9db94c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_de51c09f45b059dba66b35eceabcc54b"],"title":"entropy-research/Devon/CONTRIBUTING.md @ 8f68f1d74671","updated_at":"2026-09-14T01:48:12Z","updated_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58"}
