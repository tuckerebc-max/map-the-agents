{"access":"public","created_at":"2026-09-14T01:48:12Z","created_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0350cf7218bee21d88c2524379173949ac9df7d9b1094114483ee4d8033e0c62","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"entropy-research/devon@8f68f1d74671 snapshot 48b598ca7c27ac23","timeframe":null},"slice_ids":["slc_e290ea62c225ac1161ef4d1282d7a7f4052a310aec283ab889246217ad6fdcba"],"source_ids":["src_24feb810559a52cd9576b7942b32f17f"],"text":"Communication between agents, tools, and environments happens via an event handler/emitter system whose handlers are declared in the Session; registering tools and environments requires no handler changes.","updated_at":"2026-09-14T01:48:12Z","updated_by_operation":"op_c7270f68cb73413f86fc3bf759ebff58"}
