{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0915ad336fa9788d2e17c1ea059939e630eb486229479e1b16f6e441e0086209"],"opposing_claim_ids":[],"text":"A preview release channel exists: passing --preview to the macOS/Linux install script installs the latest preview release."},{"claim_ids":["clm_25a1f9e1f3e7d64a0e20f339a89ac24fc80526829811130b40473dcec2f92ba8"],"opposing_claim_ids":[],"text":"Enterprise policy controls are documented as including a managed mode plus an extension allowlist."},{"claim_ids":["clm_2f101b71b47025b77e249e6f50e30a1d8f8e91b0dd2cb858e42eedd00c011ace"],"opposing_claim_ids":[],"text":"Prebuilt packages are distributed for macOS, Windows, and Linux, with Linux releases including .deb, .rpm, and portable .tar.gz bundles."},{"claim_ids":["clm_5fc42169e4a5e30d20dbf4412fb6fe91b0ce1ca6f131348dbaa6dc003f2b5585"],"opposing_claim_ids":[],"text":"Install scripts for macOS/Linux and Windows are provided, and the scripts detect OS and architecture, download the latest stable release, and verify a SHA256 checksum when available."},{"claim_ids":["clm_665f5047232138456d7ceb224abf98bbcd910940b390c8203ac811b2d1d1ec35"],"opposing_claim_ids":[],"text":"The project is licensed under AGPL-3.0."},{"claim_ids":["clm_c65313307628752102b90e2ba101a04551b47966dc77b2492f28c32b7cc73a52"],"opposing_claim_ids":[],"text":"Repository development practice: building from source requires Node.js 24, Bun 1.3.14, and Rust, then running git clone, bun setup, and bun dev; bun setup installs dependencies and checks native platform requirements."},{"claim_ids":["clm_d5f18da6bf371f32e26682844338a491a0e17902157eb4f4a800410910623f0a"],"opposing_claim_ids":[],"text":"Documented features include AI agents, Git integration, syntax highlighting, LSP support, vim keybindings, an integrated terminal, database viewers, collaboration, and enterprise policy controls."},{"claim_ids":["clm_ec381a2666fe8ae6c41dcfd1978a2d209ceb2ed5c04799cffb1c40b9a5559d33"],"opposing_claim_ids":[],"text":"The editor can be installed via Homebrew (cask athas), WinGet (athasdev.Athas), and Scoop from a dedicated bucket."},{"claim_ids":["clm_f6a6bb6d0a0846b23212350a09a7c521a5e4e2c8c7cb80b3a45d23b0fb487e85"],"opposing_claim_ids":[],"text":"Athas is described as a lightweight, cross-platform code editor built with Tauri (Rust and React), featuring Git support, AI agents, and vim keybindings."}],"claim_ids":["clm_0915ad336fa9788d2e17c1ea059939e630eb486229479e1b16f6e441e0086209","clm_25a1f9e1f3e7d64a0e20f339a89ac24fc80526829811130b40473dcec2f92ba8","clm_2f101b71b47025b77e249e6f50e30a1d8f8e91b0dd2cb858e42eedd00c011ace","clm_5fc42169e4a5e30d20dbf4412fb6fe91b0ce1ca6f131348dbaa6dc003f2b5585","clm_665f5047232138456d7ceb224abf98bbcd910940b390c8203ac811b2d1d1ec35","clm_c65313307628752102b90e2ba101a04551b47966dc77b2492f28c32b7cc73a52","clm_d5f18da6bf371f32e26682844338a491a0e17902157eb4f4a800410910623f0a","clm_ec381a2666fe8ae6c41dcfd1978a2d209ceb2ed5c04799cffb1c40b9a5559d33","clm_f6a6bb6d0a0846b23212350a09a7c521a5e4e2c8c7cb80b3a45d23b0fb487e85"],"created_at":"2026-09-14T01:35:49Z","created_by_operation":"op_82da3b06a9694c988a90bb9cac27370e","id":"pg_0b6e3f98612a504b9eb7b126111f09d9","maturity":"draft","page_type":"source","path":"pages/sources/athasdev-athas-readme-md-42ef5d128147-b126111f09d9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_589435b1888051d5b5cdd6bf006c1822"],"title":"athasdev/athas/README.md @ 42ef5d128147","updated_at":"2026-09-14T01:35:49Z","updated_by_operation":"op_82da3b06a9694c988a90bb9cac27370e"}
