{"access":"public","created_at":"2026-09-14T02:36:10Z","created_by_operation":"op_b55e5501153e458eaa483db18fc0ed20","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_15175ee4db2049a588eb0d4805f15d96e35df34aa512a6026abbc6f404c93dc8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"rivet-dev/sandbox-agent@bbc195cc3fb5 snapshot 56989d83a6914f57","timeframe":null},"slice_ids":["slc_0304a55c504b14e8ccee2fe726742b32811c40e2bf2b18b42eece4203317b1f0","slc_384f05bee27f5705070a45edf5ce4ab61057c9eb7fa667538f4eb38ab5a99d12"],"source_ids":["src_d2070ba8873159f2bba6a794213032c0"],"text":"The product exposes a single HTTP API with SSE streaming that normalizes different coding agents' proprietary APIs, so integrations can swap agents via configuration rather than code changes.","updated_at":"2026-09-14T02:36:10Z","updated_by_operation":"op_b55e5501153e458eaa483db18fc0ed20"}
