{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_8d8f3ad8b839d85fcf56aae9baf20cd797cbbbc8cdb454fe554a0df6fc7f1318"],"opposing_claim_ids":[],"text":"Code generation uses the OpenAI API; a changelog entry states all other platform support was removed, leaving OpenAI as the sole provider."},{"claim_ids":["clm_bc10933c106f7960c562102b0eb0335cfcf449db7e1e65944e636791370bcf3a"],"opposing_claim_ids":[],"text":"The `init` and `start` commands support a `--path` option so Overide can be initialized and started in any target directory."}],"claim_ids":["clm_8d8f3ad8b839d85fcf56aae9baf20cd797cbbbc8cdb454fe554a0df6fc7f1318","clm_bc10933c106f7960c562102b0eb0335cfcf449db7e1e65944e636791370bcf3a"],"created_at":"2026-09-14T02:25:00Z","created_by_operation":"op_2a2ffa2dc68b4a0f806516a027199f92","id":"pg_4efd50d2b45b51b3b266a3a1f8082b6d","maturity":"draft","page_type":"source","path":"pages/sources/oi-overide-oi-changelog-md-dc4904403f50-a3a1f8082b6d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4ebd2915698a5fd388cd12ae51b152d6"],"title":"oi-overide/oi/CHANGELOG.md @ dc4904403f50","updated_at":"2026-09-14T02:25:00Z","updated_by_operation":"op_2a2ffa2dc68b4a0f806516a027199f92"}
