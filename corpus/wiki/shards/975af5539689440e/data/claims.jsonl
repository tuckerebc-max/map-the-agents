{"access":"public","created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0f7881a93d0fc238ab33b2f78842149641b32db3f969e72c357b08826dbc8afa","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"vishal2612200/agentpack@42291598e793 snapshot fa61ecf8e3ff9329","timeframe":null},"slice_ids":["slc_4e86be386f74b8276a15d64b7dacd3dcd317360bd9449f51995bac763e6d193e","slc_8e43707fbdf64bd875623ee2f5803f0c33d392439a5d4fe2c17a40bb4f8ca4ab"],"source_ids":["src_ca158ac32066586290f25ae7b5027533"],"text":"Core scan, route, pack, stats, explain, and benchmark operations run without hosted indexing, embeddings, or model API calls; network use is limited to explicit GitHub operations, optional enrichment, and external-agent workflows.","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_31a43498fcc175add0626d3b0ef99e249e6a755dd4dd2caeb270755320d7adc5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"vishal2612200/agentpack@42291598e793 snapshot fa61ecf8e3ff9329","timeframe":null},"slice_ids":["slc_3aca3b7cb8da31dafedc478aed2d2d5415cd5c4c7b0e9e88fae15bf45b53a149"],"source_ids":["src_726435eba8ae58038bb664f838d3c28f"],"text":"Sessions are thread-scoped by default: when host session/thread environment variables are present, commands and MCP tools use isolated state under .agentpack/threads/<id>/, with --thread global as a legacy opt-out.","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4a0658aa6790e099b39e55a1973d2d0082225b27bf4bdaffb309fb0fe08ee30e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"vishal2612200/agentpack@42291598e793 snapshot fa61ecf8e3ff9329","timeframe":null},"slice_ids":["slc_1e2725fffb3450d69b222c792ad97b67c52ddd1dbd44df05a1b2419f37934ecf","slc_402b300cb2e215cdf7dd9b46e67b094172444732439de4202025c6b3e0105ba8"],"source_ids":["src_726435eba8ae58038bb664f838d3c28f"],"text":"Adapters render agent-specific context files (Claude, Cursor, Windsurf, Codex, Antigravity, generic), while separate installers configure each tool's repo files such as CLAUDE.md, .cursorrules, and AGENTS.md.","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_538d094a33ced44031b6f7bc86ad50456583165c8f72c2c43019ceafa6fc1561","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"vishal2612200/agentpack@42291598e793 snapshot fa61ecf8e3ff9329","timeframe":null},"slice_ids":["slc_49b5881f9b0b2bc564264f3f8e66047c246a90890989aacbc9b9b66f23e4f0d8","slc_d54ff93f3fbb3e8435166f7ed8b9bb23b168414d3e9eef0e6dfc9926c7823646","slc_fd83eeaade3568067a80b0836ba6ca2f51ed3c5ca4aefb9abe6108bc3cea1cc3"],"source_ids":["src_ca158ac32066586290f25ae7b5027533"],"text":"The public benchmark measures file selection against files changed in historical public commits: 107 cases with 67.2% average recall and 50.6% average token precision, per the published results artifact.","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5c1e44a62b1b69e6ddb4799ccd52eeefaca51b6108527df4250a2a87e547f5b2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"vishal2612200/agentpack@42291598e793 snapshot fa61ecf8e3ff9329","timeframe":null},"slice_ids":["slc_17d1f693d56bc1ace71c08d5fd5fe62fbd360c98c0f74328d8ddfd631aa1458b","slc_199cec5d2a753b8f1d8d520da8b38b2d12c11c9a43240322ad56c6d6359dd002","slc_eee8eed87cefa95284e8b2c5ded57c198e021347a419827e69ff92cad14aac3a"],"source_ids":["src_ca158ac32066586290f25ae7b5027533"],"text":"The CLI requires Python 3.10+ and is installable via pipx (recommended) or pip; the npm wrapper @vishal2612200/agentpack installs the Python CLI and requires Node.js 18+.","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_86ffd3cc21d7e346af668407533985f08d124640693d211af44f8ce51a352949","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"vishal2612200/agentpack@42291598e793 snapshot fa61ecf8e3ff9329","timeframe":null},"slice_ids":["slc_4e86be386f74b8276a15d64b7dacd3dcd317360bd9449f51995bac763e6d193e","slc_bd0feee2acedc98e2f77513a0d3e98708a51682c030052f1fdac573c980be0e5"],"source_ids":["src_726435eba8ae58038bb664f838d3c28f","src_ca158ac32066586290f25ae7b5027533"],"text":"Generated context, receipts, task state, snapshots, and memory are stored locally under .agentpack/, and summary caches are keyed by file hash so only changed files are re-summarized.","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_aff41bb1d6529d50d5190d8d90b9b0584821ec7ed771c914a8c4b9a8a87b9acc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"vishal2612200/agentpack@42291598e793 snapshot fa61ecf8e3ff9329","timeframe":null},"slice_ids":["slc_a324f37ccfbb64dffeeebbdc8676a47587253eccf52753e189d05dc5d7bdf205","slc_ab40ed69e7dd013db33c0341e0a06e03df5cbe23a72535dda420ef5bacfadbf7"],"source_ids":["src_ca158ac32066586290f25ae7b5027533"],"text":"The product exposes a CLI four-command loop: agentpack work, learn --json, finish, and doctor, where work prepares task context, finish records validation and task memory, and doctor checks installation and integration.","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c386e4c0b6f7208262b31272dd45150c13701af213e8c4566bc1a532bc5c7cb8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"vishal2612200/agentpack@42291598e793 snapshot fa61ecf8e3ff9329","timeframe":null},"slice_ids":["slc_042669b867e3e6e0c88076cfcf528307c7d01b8ae601a8aeb84bd81fa8ea28f0","slc_70d639c4bee4838a1f3972554be1f49bd09f0135174e6d79744fe2f9fcb21e84","slc_d5ff41629f2b4b6a18234b7f793c83121748f924653f97e805520ddb4902f405"],"source_ids":["src_ca158ac32066586290f25ae7b5027533"],"text":"The project is at alpha version 0.4.4, licensed AGPL v3, with APIs that may change before 1.0 and platform targets of macOS, Linux, and Windows PowerShell with Git for Windows.","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d116c0cf96861979462133c2f4327d28977f0d3c53fd629c4727657b85bb339d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"vishal2612200/agentpack@42291598e793 snapshot fa61ecf8e3ff9329","timeframe":null},"slice_ids":["slc_3797adcb5e82c00779c7d99bdb9708d08c4316bbd0f54e7213e4b8186321d70e","slc_c56caab6894a0c76e6b4814ce3d50093e8810f6e00ac99a338a1066bcb2a65da"],"source_ids":["src_726435eba8ae58038bb664f838d3c28f"],"text":"The architecture is a local pipeline: scan with .agentignore, build offline summaries and a Tree-sitter semantic graph, score files for the task, select by value per token, redact secrets at materialization, and cache a pack registry with block IDs.","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
