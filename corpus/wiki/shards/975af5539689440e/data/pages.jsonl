{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","id":"pg_1b082187c0ad54d7b0c8fcaa2ab13d12","maturity":"draft","page_type":"source","path":"pages/sources/vishal2612200-agentpack-docs-design-md-42291598e793-fcaa2ab13d12.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b08c5f575cf4567682bc27d52f4400c9"],"title":"vishal2612200/agentpack/docs/design.md @ 42291598e793","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_31a43498fcc175add0626d3b0ef99e249e6a755dd4dd2caeb270755320d7adc5"],"opposing_claim_ids":[],"text":"Sessions are thread-scoped by default: when host session/thread environment variables are present, commands and MCP tools use isolated state under .agentpack/threads/<id>/, with --thread global as a legacy opt-out."},{"claim_ids":["clm_4a0658aa6790e099b39e55a1973d2d0082225b27bf4bdaffb309fb0fe08ee30e"],"opposing_claim_ids":[],"text":"Adapters render agent-specific context files (Claude, Cursor, Windsurf, Codex, Antigravity, generic), while separate installers configure each tool's repo files such as CLAUDE.md, .cursorrules, and AGENTS.md."},{"claim_ids":["clm_86ffd3cc21d7e346af668407533985f08d124640693d211af44f8ce51a352949"],"opposing_claim_ids":[],"text":"Generated context, receipts, task state, snapshots, and memory are stored locally under .agentpack/, and summary caches are keyed by file hash so only changed files are re-summarized."},{"claim_ids":["clm_d116c0cf96861979462133c2f4327d28977f0d3c53fd629c4727657b85bb339d"],"opposing_claim_ids":[],"text":"The architecture is a local pipeline: scan with .agentignore, build offline summaries and a Tree-sitter semantic graph, score files for the task, select by value per token, redact secrets at materialization, and cache a pack registry with block IDs."},{"claim_ids":["clm_fbe419f399197dcb2bf30310a246f3c4f107f3b0e4b7b47405025bae25d03ec4"],"opposing_claim_ids":[],"text":"The MCP server exposes tools including start_task, pack_context, get_context, explain, related, stats, and delta, per the package layout documentation."}],"claim_ids":["clm_31a43498fcc175add0626d3b0ef99e249e6a755dd4dd2caeb270755320d7adc5","clm_4a0658aa6790e099b39e55a1973d2d0082225b27bf4bdaffb309fb0fe08ee30e","clm_86ffd3cc21d7e346af668407533985f08d124640693d211af44f8ce51a352949","clm_d116c0cf96861979462133c2f4327d28977f0d3c53fd629c4727657b85bb339d","clm_fbe419f399197dcb2bf30310a246f3c4f107f3b0e4b7b47405025bae25d03ec4"],"created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","id":"pg_2baff3e932b15aff80831aee41fee70a","maturity":"draft","page_type":"source","path":"pages/sources/vishal2612200-agentpack-docs-architecture-md-42291598e793-1aee41fee70a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_726435eba8ae58038bb664f838d3c28f"],"title":"vishal2612200/agentpack/docs/architecture.md @ 42291598e793","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","id":"pg_436a42e42857524dac823ed137179663","maturity":"draft","page_type":"source","path":"pages/sources/vishal2612200-agentpack-llms-full-txt-42291598e793-3ed137179663.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_183b609cc3c35b83a7c06f8ee9dce8ab"],"title":"vishal2612200/agentpack/llms-full.txt @ 42291598e793","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0bdf4f3040b7671bd019b1c10e5795b1a2163a87e14e7ac912a9840f661661df"],"opposing_claim_ids":[],"text":"AgentPack is advisory: it does not edit source code, assign people, enforce policy, approve changes, or provide hard multi-agent locks, and it is not a coding agent, hosted index, or correctness oracle."},{"claim_ids":["clm_0f7881a93d0fc238ab33b2f78842149641b32db3f969e72c357b08826dbc8afa"],"opposing_claim_ids":[],"text":"Core scan, route, pack, stats, explain, and benchmark operations run without hosted indexing, embeddings, or model API calls; network use is limited to explicit GitHub operations, optional enrichment, and external-agent workflows."},{"claim_ids":["clm_538d094a33ced44031b6f7bc86ad50456583165c8f72c2c43019ceafa6fc1561"],"opposing_claim_ids":[],"text":"The public benchmark measures file selection against files changed in historical public commits: 107 cases with 67.2% average recall and 50.6% average token precision, per the published results artifact."},{"claim_ids":["clm_5c1e44a62b1b69e6ddb4799ccd52eeefaca51b6108527df4250a2a87e547f5b2"],"opposing_claim_ids":[],"text":"The CLI requires Python 3.10+ and is installable via pipx (recommended) or pip; the npm wrapper @vishal2612200/agentpack installs the Python CLI and requires Node.js 18+."},{"claim_ids":["clm_86ffd3cc21d7e346af668407533985f08d124640693d211af44f8ce51a352949"],"opposing_claim_ids":[],"text":"Generated context, receipts, task state, snapshots, and memory are stored locally under .agentpack/, and summary caches are keyed by file hash so only changed files are re-summarized."},{"claim_ids":["clm_aff41bb1d6529d50d5190d8d90b9b0584821ec7ed771c914a8c4b9a8a87b9acc"],"opposing_claim_ids":[],"text":"The product exposes a CLI four-command loop: agentpack work, learn --json, finish, and doctor, where work prepares task context, finish records validation and task memory, and doctor checks installation and integration."},{"claim_ids":["clm_c386e4c0b6f7208262b31272dd45150c13701af213e8c4566bc1a532bc5c7cb8"],"opposing_claim_ids":[],"text":"The project is at alpha version 0.4.4, licensed AGPL v3, with APIs that may change before 1.0 and platform targets of macOS, Linux, and Windows PowerShell with Git for Windows."},{"claim_ids":["clm_da3f65b49be34024cb8985e4ff3cc8f592bf39b4f8ce20e8217a648dac44bcc2"],"opposing_claim_ids":[],"text":"The benchmark authors state it only supports claims about ranked file-selection quality, not reduced tool calls, cost, completion time, or task success; no public end-to-end A/B outcome report is published yet."}],"claim_ids":["clm_0bdf4f3040b7671bd019b1c10e5795b1a2163a87e14e7ac912a9840f661661df","clm_0f7881a93d0fc238ab33b2f78842149641b32db3f969e72c357b08826dbc8afa","clm_538d094a33ced44031b6f7bc86ad50456583165c8f72c2c43019ceafa6fc1561","clm_5c1e44a62b1b69e6ddb4799ccd52eeefaca51b6108527df4250a2a87e547f5b2","clm_86ffd3cc21d7e346af668407533985f08d124640693d211af44f8ce51a352949","clm_aff41bb1d6529d50d5190d8d90b9b0584821ec7ed771c914a8c4b9a8a87b9acc","clm_c386e4c0b6f7208262b31272dd45150c13701af213e8c4566bc1a532bc5c7cb8","clm_da3f65b49be34024cb8985e4ff3cc8f592bf39b4f8ce20e8217a648dac44bcc2"],"created_at":"2026-09-14T04:30:29Z","created_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397","id":"pg_6dd772f0bf8b5ce1870b3be9e0e4328b","maturity":"draft","page_type":"source","path":"pages/sources/vishal2612200-agentpack-readme-md-42291598e793-3be9e0e4328b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ca158ac32066586290f25ae7b5027533"],"title":"vishal2612200/agentpack/README.md @ 42291598e793","updated_at":"2026-09-14T04:30:29Z","updated_by_operation":"op_000cc4f43765454eb5a9b3e6a1392397"}
