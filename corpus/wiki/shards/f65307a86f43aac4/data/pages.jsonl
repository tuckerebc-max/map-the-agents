3","clm_7a1469e736d4fdc086db61bc56c995f0dc7098fca71cd26f2f01ed7de53d87d2","clm_91adb5957045edfa9c0a803ea604a92b2781e5daa6253043c28bbd8308a069cf","clm_920076d4e89e564531bc3cfe896a7b44cf09377fb033d9899e5bcc4dcc344bf5","clm_96109b758a141f26aaabdd47613e71b08317d0bb2d76fadb992ca001fd08fac4","clm_a87230fb4d1009b547ec76ef585e5acb09d910051b2b5a90fee47e6e7f9d6f72","clm_bd3c0752e888d4545abd9e1f10a309f4a42e6d1c7dc342e03a333dd794c42295","clm_c8aa640e7a9efbfb3411da5408b9edb0faa941f4509ca4fdf478dd832d513108","clm_d08bdecd2526bf4bc9cbb1979230fbfe17fe4acc12d084749e0ab4a720805cbe","clm_d679f9077dabee53a0e0096e9707788d6e687db7aa70a8bb02f4b2e8da2c3cd0","clm_e422927d1dc3b0eb7251ba77b81cc26b32cdebfd6278787d6f86393cd8dd6bc5","clm_f3e99aceead92ea62c85b9b92b107f1687276f0df0cfc613194cf8d828d758dc","clm_f7fa31157bbb834300751eae16d569f871be4a41a8c9efdaab2544df9d084e21"],"created_at":"2026-09-14T03:38:52Z","created_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9","id":"pg_db41f61a06725f95af0a8105b4e34215","maturity":"draft","page_type":"entity","path":"pages/entities/blaine-fantastty-8105b4e34215.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"blaine/fantastty","updated_at":"2026-09-14T03:38:52Z","updated_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_77577541eb5f0a9cf8f26cd1045adc0f58820ca1e859602ff4fd80aa62e3e850"],"opposing_claim_ids":[],"text":"The attach design uses inert do-nothing PTYs per pane (discarding input) so real I/O flows through the tmux control connection, with input intercepted at SurfaceView level."},{"claim_ids":["clm_91adb5957045edfa9c0a803ea604a92b2781e5daa6253043c28bbd8308a069cf"],"opposing_claim_ids":[],"text":"A dated design document proposes tmux control-mode (-CC) attach so tmux windows render as native tabs and panes as Ghostty splits; it appears to be a plan, not necessarily shipped behavior."},{"claim_ids":["clm_d08bdecd2526bf4bc9cbb1979230fbfe17fe4acc12d084749e0ab4a720805cbe"],"opposing_claim_ids":[],"text":"The attach design specifies a TmuxControlClient Swift actor per attached session, with all I/O and event handling actor-isolated, plus pure parser structs for protocol and layout."},{"claim_ids":["clm_f3e99aceead92ea62c85b9b92b107f1687276f0df0cfc613194cf8d828d758dc"],"opposing_claim_ids":[],"text":"The attach design requires tmux control mode from tmux 1.8+ and tmux 3.3+ for shell-integration passthrough, with a version check and warning on connect."},{"claim_ids":["clm_f7fa31157bbb834300751eae16d569f871be4a41a8c9efdaab2544df9d084e21"],"opposing_claim_ids":[],"text":"The attach design lists non-goals: no tmux status-bar or border rendering, no Mosh support (standard SSH only), and no auto-reconnect on SSH drop (manual reconnect)."}],"claim_ids":["clm_77577541eb5f0a9cf8f26cd1045adc0f58820ca1e859602ff4fd80aa62e3e850","clm_91adb5957045edfa9c0a803ea604a92b2781e5daa6253043c28bbd8308a069cf","clm_d08bdecd2526bf4bc9cbb1979230fbfe17fe4acc12d084749e0ab4a720805cbe","clm_f3e99aceead92ea62c85b9b92b107f1687276f0df0cfc613194cf8d828d758dc","clm_f7fa31157bbb834300751eae16d569f871be4a41a8c9efdaab2544df9d084e21"],"created_at":"2026-09-14T03:38:52Z","created_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9","id":"pg_eea934ccf6375f6aa0a61869fd4d0bc9","maturity":"draft","page_type":"source","path":"pages/sources/blaine-fantastty-docs-plans-2026-03-07-tmux-attach-design-md-60d248d0d-1869fd4d0bc9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f8b182f778f856e686c542292a54d9bb"],"title":"blaine/fantastty/docs/plans/2026-03-07-tmux-attach-design.md @ 60d248d0d20a","updated_at":"2026-09-14T03:38:52Z","updated_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4537119e0fd3e20e7089e426cd008b37dc50dea3a7497de2f7ccefb35ee102cb"],"opposing_claim_ids":[],"text":"Documented features include workspaces with tabs, splits, notes with revision history, workspace URLs, archiving, SSH sessions, attention indicators, and shell integration."},{"claim_ids":["clm_707cb6b3be427b82c4fb214631591fede09603e87e12a60744bfb2da1d1d9cb1"],"opposing_claim_ids":[],"text":"The project is MIT licensed and vendors Ghostty as a submodule whose build.zig.zon pins the required Zig version."},{"claim_ids":["clm_7a002533d71817b89a80ae03753f66b603986734afbbfe6eb3ca0bad3dbfa333"],"opposing_claim_ids":[],"text":"Installed builds check a GitHub-hosted appcast.xml via the Check for Updates menu item, indicating Sparkle-based auto-update."},{"claim_ids":["clm_920076d4e89e564531bc3cfe896a7b44cf09377fb033d9899e5bcc4dcc344bf5"],"opposing_claim_ids":[],"text":"Zsh integration for pwd tracking and escape-sequence passthrough is set up automatically when persistent sessions are enabled."},{"claim_ids":["clm_96109b758a141f26aaabdd47613e71b08317d0bb2d76fadb992ca001fd08fac4"],"opposing_claim_ids":[],"text":"Repository development practice: building requires Xcode 16+, the Metal toolchain, a pinned Zig version, cloning with submodules, and 'make xcframework' before an xcodebuild build."},{"claim_ids":["clm_a87230fb4d1009b547ec76ef585e5acb09d910051b2b5a90fee47e6e7f9d6f72"],"opposing_claim_ids":[],"text":"A shell integration script sourced from ~/.fantastty provides the fantastty-note command (alias fn) for adding notes from the terminal."},{"claim_ids":["clm_bd3c0752e888d4545abd9e1f10a309f4a42e6d1c7dc342e03a333dd794c42295"],"opposing_claim_ids":[],"text":"Fantastty is a macOS terminal app built on Ghostty's libghostty, offering workspace-based session management and persistent tmux-backed sessions."},{"claim_ids":["clm_c8aa640e7a9efbfb3411da5408b9edb0faa941f4509ca4fdf478dd832d513108"],"opposing_claim_ids":[],"text":"The app ships as a signed, notarized DMG from GitHub Releases and requires macOS 15.0 (Sequoia) or later on Apple Silicon."},{"claim_ids":["clm_d679f9077dabee53a0e0096e9707788d6e687db7aa70a8bb02f4b2e8da2c3cd0"],"opposing_claim_ids":[],"text":"Workspace metadata (names, notes, URLs, tags) persists in ~/.fantastty/workspaces.json; layout state saves to ~/.fantastty/layout.json on quit and restores on launch."},{"claim_ids":["clm_e422927d1dc3b0eb7251ba77b81cc26b32cdebfd6278787d6f86393cd8dd6bc5"],"opposing_claim_ids":[],"text":"The architecture is a SwiftUI app using libghostty as a static library for terminal rendering, with SessionManager, Session, TerminalTab, and TmuxManager components."}],"claim_ids":["clm_4537119e0fd3e20e7089e426cd008b37dc50dea3a7497de2f7ccefb35ee102cb","clm_707cb6b3be427b82c4fb214631591fede09603e87e12a60744bfb2da1d1d9cb1","clm_7a002533d71817b89a80ae03753f66b603986734afbbfe6eb3ca0bad3dbfa333","clm_920076d4e89e564531bc3cfe896a7b44cf09377fb033d9899e5bcc4dcc344bf5","clm_96109b758a141f26aaabdd47613e71b08317d0bb2d76fadb992ca001fd08fac4","clm_a87230fb4d1009b547ec76ef585e5acb09d910051b2b5a90fee47e6e7f9d6f72","clm_bd3c0752e888d4545abd9e1f10a309f4a42e6d1c7dc342e03a333dd794c42295","clm_c8aa640e7a9efbfb3411da5408b9edb0faa941f4509ca4fdf478dd832d513108","clm_d679f9077dabee53a0e0096e9707788d6e687db7aa70a8bb02f4b2e8da2c3cd0","clm_e422927d1dc3b0eb7251ba77b81cc26b32cdebfd6278787d6f86393cd8dd6bc5"],"created_at":"2026-09-14T03:38:52Z","created_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9","id":"pg_f0bdf54158645b4dbe65d08cfbb30ed0","maturity":"draft","page_type":"source","path":"pages/sources/blaine-fantastty-readme-md-60d248d0d20a-d08cfbb30ed0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a228f79fca215118a5063d3649bb3303"],"title":"blaine/fantastty/README.md @ 60d248d0d20a","updated_at":"2026-09-14T03:38:52Z","updated_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9"}
