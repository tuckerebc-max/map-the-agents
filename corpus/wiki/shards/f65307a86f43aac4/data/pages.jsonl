{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0bbb77d9d7e0ffb4fe9b82c8b6ca2db0c7917474edaf49515512fc9f30136d0e"],"opposing_claim_ids":[],"text":"Repository development practice: the Build and Release workflow creates a GitHub Release only for pushed v* tags, builds, signs, notarizes, and publishes the DMG and Sparkle appcast, and tags must never be force-pushed."},{"claim_ids":["clm_5cadf8a669d9d042218472e985822f843be6decf505fc803ca33df70faa51cd4"],"opposing_claim_ids":[],"text":"Repository development practice: the release gate before merging to main runs xcodebuild tests, go test ./..., a Python unittest module, and git diff --check, with fast-forward merges preferred."}],"claim_ids":["clm_0bbb77d9d7e0ffb4fe9b82c8b6ca2db0c7917474edaf49515512fc9f30136d0e","clm_5cadf8a669d9d042218472e985822f843be6decf505fc803ca33df70faa51cd4"],"created_at":"2026-09-14T03:38:52Z","created_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9","id":"pg_1635d9389e445276963a34c8bc1d288d","maturity":"draft","page_type":"source","path":"pages/sources/blaine-fantastty-docs-release-engineering-md-60d248d0d20a-34c8bc1d288d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_167770e863c95f56ad85a684e5f7aded"],"title":"blaine/fantastty/docs/release-engineering.md @ 60d248d0d20a","updated_at":"2026-09-14T03:38:52Z","updated_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0bbb77d9d7e0ffb4fe9b82c8b6ca2db0c7917474edaf49515512fc9f30136d0e"],"opposing_claim_ids":[],"text":"Repository development practice: the Build and Release workflow creates a GitHub Release only for pushed v* tags, builds, signs, notarizes, and publishes the DMG and Sparkle appcast, and tags must never be force-pushed."},{"claim_ids":["clm_6e3a2f73c2820e75141dfc39fda3392c9751034145bfdc213f750c8029c80070"],"opposing_claim_ids":[],"text":"Repository development practice: CI requires seven GitHub secrets, including a Sparkle EdDSA private key whose matching public key is committed in Info.plist as SUPublicEDKey."}],"claim_ids":["clm_0bbb77d9d7e0ffb4fe9b82c8b6ca2db0c7917474edaf49515512fc9f30136d0e","clm_6e3a2f73c2820e75141dfc39fda3392c9751034145bfdc213f750c8029c80070"],"created_at":"2026-09-14T03:38:52Z","created_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9","id":"pg_acebead3cd0250029d4fe22298926aca","maturity":"draft","page_type":"source","path":"pages/sources/blaine-fantastty-doc-github-actions-setup-md-60d248d0d20a-e22298926aca.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6c7ec9d78aa35426add8b3acf69bfe32"],"title":"blaine/fantastty/doc/GITHUB_ACTIONS_SETUP.md @ 60d248d0d20a","updated_at":"2026-09-14T03:38:52Z","updated_by_operation":"op_542f4991ae4d41d9a1f62f597736b2a9"}
