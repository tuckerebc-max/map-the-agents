{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_120f33a32db1906d70eb6c1aca5d13617c1a12398a21dae3bedbbfb481bfd98b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_a234bc30795abc2499756e4fd5539f5e284f388f816dd96a7c2878736c28e972"],"source_ids":["src_fd2505662b675f9397e819aa770d9968"],"text":"The standalone server reaps sessions idle beyond SESSION_IDLE_TIMEOUT_MS (default 24h), while the desktop keeps sessions until quit.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_205f718d29f83017b4dd1053175d525326c958d35a7637161c44bdc52bd82bda","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_b501842089383a1fa628ad2e8db3cd7ad7d96c1c12db0c100f664e9064294c17","slc_d2c07827ab043d5306993b5d1ba6129bc2a81e09c141fc69372d958927f9bfc6"],"source_ids":["src_3f637e20494258919062b55db48b640e"],"text":"VibeTree runs each AI coding agent in its own git worktree in parallel, giving every task an isolated checkout with its own branch and terminal.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_570f150a49075883bf351b0166be5dd84cc2af6c1288cccc544c302a1751003d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_e5b10626eee20df22ca00ee11f485d1c39c624cf0ea0258c49c9a69bd7ca3b30"],"source_ids":["src_3f637e20494258919062b55db48b640e"],"text":"macOS builds are not yet notarized; users must approve the app once under System Settings, Privacy and Security, or install via the provided Homebrew cask.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6bbfe589dc93ac98ce2be6097884687e70eaa6e5474380c79c60a604e33c1847","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_2cd4af06a92dc203ed3634346bafe55fa0e3a76c5614d4c75e1d434461c7848c","slc_8e7e643a2b0488d75a6cadf9922abf7f5520dd1f6e7fddd18fd27540d59cea7f"],"source_ids":["src_3f637e20494258919062b55db48b640e","src_fd2505662b675f9397e819aa770d9968"],"text":"The desktop app embeds its server on 127.0.0.1 with a per-launch token so nothing is exposed to the network; the standalone server can require login via AUTH_REQUIRED, VIBETREE_USERNAME, and VIBETREE_PASSWORD.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_74a17aba42834e1f0e713c9438b121100c15d01e0ba6464f2cc54d8e68a9ae54","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_bb3044a377aadda632e7ae5061880a02d2fe6777aa37cf07180b4d66fbfd68d1"],"source_ids":["src_fd2505662b675f9397e819aa770d9968"],"text":"Build tooling documented includes esbuild bundles for core/ui/auth, tsc for server-core and apps/server, Vite for desktop renderer and web, electron-builder packaging, and vite-plugin-pwa.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_78a0f40fdd92ef82d64cf8bb0182e42bd399a308354d37e7387ed4cfd7536611","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_a57cf25b5d98127b96a1ff1984cedb6d931f770845c73df39f9e896a30dfc316","slc_ff261076b3dd7061ec3c43f88360b7f574ef591080ff396336189593bc2f2ee6"],"source_ids":["src_3f637e20494258919062b55db48b640e"],"text":"The product works with terminal-based agent CLIs including Claude Code, OpenAI Codex CLI, Gemini CLI, Aider, and opencode, since agents run in a real terminal.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8fb9f574f371febe578a617ec7c39e2a18a695554bbaf486f6238a6a4c045ada","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_a234bc30795abc2499756e4fd5539f5e284f388f816dd96a7c2878736c28e972"],"source_ids":["src_fd2505662b675f9397e819aa770d9968"],"text":"Terminal sessions survive disconnects: session IDs are deterministic per worktree path and terminal ID, output is buffered from PTY start, and reattach returns the scrollback.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a44f0c79ca66c5d069a7fed306baef60599721a5dd1dee1868cc18e6aa689789","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_55c52228417ac32aca526e74e1122f209d395d90dec424c3326192ddd7868ccd","slc_68bac393a248d845449a3f76660077053b4518ed167f8dfa9352b31c721e5c4e"],"source_ids":["src_fd2505662b675f9397e819aa770d9968"],"text":"The repo is a pnpm + Turborepo monorepo with apps (desktop, web, server) and packages (core, server-core, ui, auth), where desktop and web share one backend.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_aaa5312f9f39baa65d5b282b8f736630451866492506c76c26ee1375ac01d675","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_639769aee3729daf86ed9e24ac4e3e7c0459cce2e0cbd893c3053c1e342b9f43"],"source_ids":["src_fd2505662b675f9397e819aa770d9968"],"text":"Electron IPC is reserved for native OS concerns (dialogs, notifications, theme, IDE launching, settings, menus), while app logic goes through the embedded server over WebSocket.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b865c942a485e261dccbb5de74fbaebe92e34c7b134ffbcac9a65e3497e748e4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_41d062970070acee99211432ed161fb93025e857e89de36a50450c4490445884","slc_a234bc30795abc2499756e4fd5539f5e284f388f816dd96a7c2878736c28e972","slc_eb607657fac7a0fbf517377606b21a71543bd83e0b08e3eca44b763b34cb2810"],"source_ids":["src_fd2505662b675f9397e819aa770d9968"],"text":"ShellSessionManager in packages/core owns all PTYs, one per worktree+terminal, buffering bounded (~100KB) output for replay on reconnect.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ce7a94b59158215c517165eb840a3daefebfdd24819507bcbff0e75e30d942f5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_639769aee3729daf86ed9e24ac4e3e7c0459cce2e0cbd893c3053c1e342b9f43"],"source_ids":["src_fd2505662b675f9397e819aa770d9968"],"text":"All shell and git traffic uses a single WebSocket protocol (shell:* and git:* messages) via a shared WebSocketAdapter used by both desktop renderer and web app.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d97f765257bbed3b802b64d586ca3a8f2a6139b8d4888e3b87cc5e68fd6466db","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_09980ae372eb8680e09f057a5bc66d83d6ac9c05f1a1408ea14a20c86dd161c7","slc_2cd4af06a92dc203ed3634346bafe55fa0e3a76c5614d4c75e1d434461c7848c"],"source_ids":["src_fd2505662b675f9397e819aa770d9968"],"text":"Authentication is off by default; the standalone server runs unauthenticated in its default mode and only warns when bound to 0.0.0.0 without auth.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
{"access":"public","created_at":"2026-09-14T02:38:42Z","created_by_operation":"op_253051b837434b2f9689ff8d1f52a923","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_db6fedb16fd6d15dffc4b1d1aa9c491ac9f2c450f8e6a2406264bd173e66ceb5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"sahithvibudhi/vibe-tree@f88907703af1 snapshot b3c79a6d3c9ac605","timeframe":null},"slice_ids":["slc_3260819344e0fa2b62652503f6360cc132a3682ed5e3d1f1019331c89e256641","slc_9c4f7c89ce43595640de1ad5cbc2e38cb343801b5152df74002ae75e8d3ebc41"],"source_ids":["src_3f637e20494258919062b55db48b640e","src_fd2505662b675f9397e819aa770d9968"],"text":"Worktree lifecycle hooks (.vibetree/hooks/post-create and pre-remove) run around git worktree add/remove; failures warn but never block, and pre-remove cannot block deletion.","updated_at":"2026-09-14T02:38:42Z","updated_by_operation":"op_253051b837434b2f9689ff8d1f52a923"}
