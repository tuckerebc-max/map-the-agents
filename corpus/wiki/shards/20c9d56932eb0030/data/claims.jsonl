{"access":"public","created_at":"2026-09-14T02:00:32Z","created_by_operation":"op_073bcd2adace4737a68a8e0dc571771f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_576f109aebffc514187e71f1f4576d4574a5e6f2ae2b81774fed3f1981f54ee3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"deep-copilot/deepcopilot@9ecbb66a50f2 snapshot a7bd145c95c3ea30","timeframe":null},"slice_ids":["slc_ea375734b04ca88c3caeb7e482f8b5d62b9dd5df5f7b2a6e62bb9d3e0565fb39"],"source_ids":["src_2d3ac89f7cf45fd48910b31d035aa52e"],"text":"Documented keybindings include Ctrl/Cmd+Shift+D to open the sidebar, Enter to send, Esc to stop generation, and arrow keys to recall prompt history.","updated_at":"2026-09-14T02:00:32Z","updated_by_operation":"op_073bcd2adace4737a68a8e0dc571771f"}
{"access":"public","created_at":"2026-09-14T02:00:32Z","created_by_operation":"op_073bcd2adace4737a68a8e0dc571771f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5e43133a9ad3fcd29c3fc38999fc15db2db757186313cdf63d6d2f296679ef36","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"deep-copilot/deepcopilot@9ecbb66a50f2 snapshot a7bd145c95c3ea30","timeframe":null},"slice_ids":["slc_5d23ac1ef839163b93379d8a762ef3cbc5c268e8ce2b46460e16cd350b8b4528"],"source_ids":["src_2d3ac89f7cf45fd48910b31d035aa52e"],"text":"Repository development practice: the project uses plain JavaScript (no TypeScript), no runtime dependencies, and the webview communicates only via postMessage without importing vscode.","updated_at":"2026-09-14T02:00:32Z","updated_by_operation":"op_073bcd2adace4737a68a8e0dc571771f"}
{"access":"public","created_at":"2026-09-14T02:00:32Z","created_by_operation":"op_073bcd2adace4737a68a8e0dc571771f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7320e30a4594015d5b870f05f38ddb5f33151f76c3b49a4397cefad506f7dc26","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"deep-copilot/deepcopilot@9ecbb66a50f2 snapshot a7bd145c95c3ea30","timeframe":null},"slice_ids":["slc_f7b14ad75808a86dd4a6c718251c19606306461dd529b0915c14523917a6a733"],"source_ids":["src_2d3ac89f7cf45fd48910b31d035aa52e"],"text":"Approval is enforced in the extension itself, not just the UI: a model-issued write_file will not execute unless policy or the user allows it.","updated_at":"2026-09-14T02:00:32Z","updated_by_operation":"op_073bcd2adace4737a68a8e0dc571771f"}
{"access":"public","created_at":"2026-09-14T02:00:32Z","created_by_operation":"op_073bcd2adace4737a68a8e0dc571771f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7a697b29e33d57d738028fb6c809bf1eb56f864553dc016c8a6cddf6df93f6d9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"deep-copilot/deepcopilot@9ecbb66a50f2 snapshot a7bd145c95c3ea30","timeframe":null},"slice_ids":["slc_04fbfa0183cb3fd23309b73acf3a4683ff7e107f04131bb651803d33c48bcf4c","slc_af68dbce5625c545ab387d55c1c61c80a37517302601c04e30784be190d08198","slc_d6695b2e7dbb2fdb869bf116e47fd14138305e02fc0d1ea70fe3b87de2150d9e","slc_f393c8ba82946db61d1eb0a09b6f41865531198089c4b3548442f1967e525725"],"source_ids":["src_2d3ac89f7cf45fd48910b31d035aa52e"],"text":"External MCP stdio tool servers can be configured via deepseekAgent.mcp.servers, with their tools exposed as mcp__<server>__<toolName> alongside built-ins.","updated_at":"2026-09-14T02:00:32Z","updated_by_operation":"op_073bcd2adace4737a68a8e0dc571771f"}
