{"access":"public","created_at":"2026-09-14T03:37:10Z","created_by_operation":"op_ed9d80b20815458a900d68880e0e916e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b2a4f0e492707592457823473ed7628fbed12a06ab03e136f69840a111f4701b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"azure/gpt-rag-orchestrator@9b64a5b96206 snapshot 6d6e1636c9e5b9d8","timeframe":null},"slice_ids":["slc_73797bb9a5de37595b6c7a56a1af51121b98331e84c1b7c6c6f92a477cd69bc1"],"source_ids":["src_8d19410fbabb5087922c4dda16a4d488"],"text":"A non-null previous_response_id is rejected with HTTP 422 so callers must send complete ordered history as input; store is unconditionally overridden to False because the hosted container lacks managed-Conversations data-plane RBAC.","updated_at":"2026-09-14T03:37:10Z","updated_by_operation":"op_ed9d80b20815458a900d68880e0e916e"}
