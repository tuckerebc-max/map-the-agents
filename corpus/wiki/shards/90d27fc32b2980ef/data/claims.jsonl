{"access":"public","created_at":"2026-09-14T03:37:10Z","created_by_operation":"op_ed9d80b20815458a900d68880e0e916e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ed3873f9a5ffeed773b685826a5e5d3968db0d7fc3c0d6fb22dcdf202ffef098","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"azure/gpt-rag-orchestrator@9b64a5b96206 snapshot 6d6e1636c9e5b9d8","timeframe":null},"slice_ids":["slc_72fc7316b7a11a71280564bfae9d2d520cf854e61dc294a38164f0f294169ee9"],"source_ids":["src_8d19410fbabb5087922c4dda16a4d488"],"text":"The orchestrator is an agentic orchestration layer built on Azure AI Foundry Agent Service and the Microsoft Agent Framework, coordinating multiple specialized agents for agent-based RAG workflows.","updated_at":"2026-09-14T03:37:10Z","updated_by_operation":"op_ed9d80b20815458a900d68880e0e916e"}
{"access":"public","created_at":"2026-09-14T03:37:10Z","created_by_operation":"op_ed9d80b20815458a900d68880e0e916e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f563beb5627f7e337cb490181da0f0a04a31eac660edbccd3f444d696b5ffe8a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"azure/gpt-rag-orchestrator@9b64a5b96206 snapshot 6d6e1636c9e5b9d8","timeframe":null},"slice_ids":["slc_57d4aa90d14e69aa14e739d201f0793e9dc11ac430211e32f369d66cd6e60441"],"source_ids":["src_8d19410fbabb5087922c4dda16a4d488"],"text":"The hosted Responses server disables generative-AI prompt and completion capture in OpenTelemetry by default; OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true should be set only when data policy permits.","updated_at":"2026-09-14T03:37:10Z","updated_by_operation":"op_ed9d80b20815458a900d68880e0e916e"}
{"access":"public","created_at":"2026-09-14T03:37:10Z","created_by_operation":"op_ed9d80b20815458a900d68880e0e916e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f68b92502c990245a0c898d6a849ee62dcb94c19a027dbd41508e4b1aeff88b1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"azure/gpt-rag-orchestrator@9b64a5b96206 snapshot 6d6e1636c9e5b9d8","timeframe":null},"slice_ids":["slc_45959224d50b8319a385d8482e951114a3e8b5e112358cb530a5b5201e8aac00"],"source_ids":["src_8d19410fbabb5087922c4dda16a4d488"],"text":"The container never reads or forwards the Authorization header (stripped by the platform gateway), never trusts caller- or model-supplied identity fields for retrieval security, and never logs call ids or authorization material.","updated_at":"2026-09-14T03:37:10Z","updated_by_operation":"op_ed9d80b20815458a900d68880e0e916e"}
{"access":"public","created_at":"2026-09-14T03:37:10Z","created_by_operation":"op_ed9d80b20815458a900d68880e0e916e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f934d32b92f56adc7e8ff70148f3d80e3269d740a3cfceb09b2348bb3229d4b1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"azure/gpt-rag-orchestrator@9b64a5b96206 snapshot 6d6e1636c9e5b9d8","timeframe":null},"slice_ids":["slc_1379c9fb1403ae93c7e0b7c57288563223d177f2605148e891a82c46ef99d434"],"source_ids":["src_8d19410fbabb5087922c4dda16a4d488"],"text":"Foundry IQ exposes MCP activity only after completion with no pre-invocation callback, so started-event timestamps for foundry_iq.mcp_tool are reconstructed and approximate, not proof of actual execution start.","updated_at":"2026-09-14T03:37:10Z","updated_by_operation":"op_ed9d80b20815458a900d68880e0e916e"}
