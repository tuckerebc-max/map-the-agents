{"access":"public","created_at":"2026-09-14T03:37:10Z","created_by_operation":"op_ed9d80b20815458a900d68880e0e916e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c0b240267b6786937c6e46b7c1846ac2b49860929e5038053ad74011ca4a5b5a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"azure/gpt-rag-orchestrator@9b64a5b96206 snapshot 6d6e1636c9e5b9d8","timeframe":null},"slice_ids":["slc_14a1643a8e6dd91624989f219932e71bb18ed41f7d0edbb85303283505c28d42","slc_1e7b4fb7e0df786e2942831d5b12bbe26915e2c756e1f0cc1847cf216b651941","slc_64fff221e2d3134310d1a97129b41186e158526dafad516cf4de2f3d284992d3"],"source_ids":["src_641e0890516e52a5b7f2503a9d43640f","src_64f1e38297f254228af5923e45d42236","src_b268ba3c0ea15499b135d9af9cf19721"],"text":"The repository snapshot carries image tag v2.8.11-c840851, while PR and release notes describe a v2.8.12 set of five operator-dashboard fixes.","updated_at":"2026-09-14T03:37:10Z","updated_by_operation":"op_ed9d80b20815458a900d68880e0e916e"}
