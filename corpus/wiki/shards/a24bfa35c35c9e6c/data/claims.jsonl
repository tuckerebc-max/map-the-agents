{"access":"public","created_at":"2026-09-14T04:27:54Z","created_by_operation":"op_de028427457b4d28aea19d142a1bb409","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0a07b35a56a0f57322a1746e31a04a4f7e830143b96e43f6fd478f995cae9dc2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"trypromptly/llmstack@701348426fad snapshot 99e229211c89b3bc","timeframe":null},"slice_ids":["slc_04da9bceecaa7add63a3b3a7ca7d1a9244cc74b84124c4b7e07a0a68a421396e"],"source_ids":["src_44e60023ac6c5bbf96a13df01bbfb9d7"],"text":"Users can add provider API keys (e.g., OpenAI, Cohere, Stability) from the Settings page, and instance-wide default keys can be placed in ~/.llmstack/config.","updated_at":"2026-09-14T04:27:54Z","updated_by_operation":"op_de028427457b4d28aea19d142a1bb409"}
