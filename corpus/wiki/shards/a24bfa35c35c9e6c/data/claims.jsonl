{"access":"public","created_at":"2026-09-14T04:27:54Z","created_by_operation":"op_de028427457b4d28aea19d142a1bb409","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2dbc34207ae0368104e2bfaa4082f44e4af937ff016853c7d24822901db97bb7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"trypromptly/llmstack@701348426fad snapshot 99e229211c89b3bc","timeframe":null},"slice_ids":["slc_e862bd0f1acf870220c3c3deb2c6d38ca694aa8d99a9c510f7cedfdf0fc23975"],"source_ids":["src_44e60023ac6c5bbf96a13df01bbfb9d7"],"text":"On first run, LLMStack creates a .llmstack directory in the user's home containing the database and config files, and opens a browser to localhost:3000.","updated_at":"2026-09-14T04:27:54Z","updated_by_operation":"op_de028427457b4d28aea19d142a1bb409"}
