{"access":"public","created_at":"2026-09-14T03:21:43Z","created_by_operation":"op_38e07718eeb24c15a9cabdf4583308cd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_68b14ea6f3db612a08093ac44838119765a610bed18d46589bfc0d11dbb439ca","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"varie-ai/workstation@96d500b5cbb0 snapshot 225530cf02383a58","timeframe":null},"slice_ids":["slc_7cba3c2d12fbd1e9f9e823714a5944ddd967495ff1f705745a7c2d9c83d77aab","slc_895f0621439423c9740daef36a4e106bc487b8b4225198fa5a0f074c87347ed2"],"source_ids":["src_bb6c2565ca3958a4b133742e3dc5780f"],"text":"Sessions are identified by repo/project name, and commands like 'run tests in my-app' are routed to the matching session automatically without needing session IDs.","updated_at":"2026-09-14T03:21:43Z","updated_by_operation":"op_38e07718eeb24c15a9cabdf4583308cd"}
