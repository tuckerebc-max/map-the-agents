{"access":"public","created_at":"2026-09-14T02:42:31Z","created_by_operation":"op_394fc436b953422bbad8c6e969140d08","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_40d45552c2f6e55adc339acc419f33fe3542416fbe60cc3b28401bf5ca1c187b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"stacklok/brood-box@5f27eeb76988 snapshot 7d277f4201e40de9","timeframe":null},"slice_ids":["slc_36374884eb6ab6d154ebeef38d9b9a96e793f76cdeb2a16feeb1243e9c0a1f18","slc_c3bce846f9ef64566e503d15164bf8030d8fa1295ad23e57fd91acda6b61193a","slc_cd53d56c5dcdbb4b56c0fda8e076904d93dfa11dbd7046ec2c4c8f7d468d3851","slc_f9e61e7a6f8e0851ffd910e39af08528491f63cc79e2c984977be65517d4b364"],"source_ids":["src_241dcdb897f356c4ba42b667d45abd2a"],"text":"A DNS-aware egress firewall offers three profiles: permissive (all outbound), standard (LLM provider plus common dev infrastructure), and locked (LLM provider only), with additional hosts allowed via --allow-host using DNS hostnames only.","updated_at":"2026-09-14T02:42:31Z","updated_by_operation":"op_394fc436b953422bbad8c6e969140d08"}
{"access":"public","created_at":"2026-09-14T02:42:31Z","created_by_operation":"op_394fc436b953422bbad8c6e969140d08","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_60cac2514d40779efa690ed3303a1b062c073b159d3ce90fa05c9dac8c721d35","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"stacklok/brood-box@5f27eeb76988 snapshot 7d277f4201e40de9","timeframe":null},"slice_ids":["slc_3dd2f3540a6433066fa6ad81c19dfccb74734597d8d712226fb38922f8267a9b","slc_4b840ed97597a6acc5824947438a90e8918450bd1532752dad0ab68ea33e23c9","slc_88696ece540ce2355cead149f6b49725f0e09980085528de2e15557908fe2a0f"],"source_ids":["src_241dcdb897f356c4ba42b667d45abd2a","src_85394d2d36eb50b9b042b63bb368925e"],"text":"Brood Box depends on stacklok/go-microvm as a tagged module (e.g. v0.0.16); task build downloads pre-built go-microvm runtime artifacts and embeds them into a self-contained pure-Go bbox binary, while libkrunfw firmware is downloaded at runtime and cached.","updated_at":"2026-09-14T02:42:31Z","updated_by_operation":"op_394fc436b953422bbad8c6e969140d08"}
{"access":"public","created_at":"2026-09-14T02:42:31Z","created_by_operation":"op_394fc436b953422bbad8c6e969140d08","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_764c6adc1e1811a38f971b42ea9c353fa7a0aa7ab06ced7a69a0d64d81f0c167","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"stacklok/brood-box@5f27eeb76988 snapshot 7d277f4201e40de9","timeframe":null},"slice_ids":["slc_58078216c520e3810389b50f4adc659adc69c8a5961fcf3a222f3e71b441cc4c","slc_9481981a35122a8bd5363675b02e11be41ff7cd9eac1b7b734252b34dbd79e90","slc_a646d8ac20e72a454274e47a7edd6170d5eeb2b0bafd90e3ce5519976456e60b","slc_c657973e5bfcacfcd9c51bd1eb6bc78890f6f91dc6e5dc765eac690ed5ad18ad"],"source_ids":["src_241dcdb897f356c4ba42b667d45abd2a"],"text":"Per-workspace config cannot widen egress or disable review; workspace.mode: direct cannot be enabled by .broodbox.yaml, and security-sensitive exclude patterns like .env* and *.pem are always excluded and cannot be negated.","updated_at":"2026-09-14T02:42:31Z","updated_by_operation":"op_394fc436b953422bbad8c6e969140d08"}
