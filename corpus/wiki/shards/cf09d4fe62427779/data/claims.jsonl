{"access":"public","created_at":"2026-09-14T02:42:31Z","created_by_operation":"op_394fc436b953422bbad8c6e969140d08","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1a357f8736b6cc0a08657b1756e8df4ef2f442266db5a604078341f7ba94e5cb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"stacklok/brood-box@5f27eeb76988 snapshot 7d277f4201e40de9","timeframe":null},"slice_ids":["slc_7edba24269dc9829663799cdced90788a98bb89f4f80119d94dbeb6cea9d2e1f","slc_84b12ae954c4ebe44a929e6f6b2cdd77d39c414ae21e676988ea75d1b9e7b702","slc_a471542153bc74948b758fc2666d5037837cfe3fc6c2f25128c2854654c2c79a","slc_cdab95533ee75bd85eab73a10351e450148e5084629e71791f3f875bb440ba45","slc_cfa09ce29ffdeda15409465023cb31e5f93298e5a5887a328ffcc478aecdb3b6","slc_ebd47deae990b63e3967c00bb70005c96cb71c547e4b33ea5af4f0e43dfc284c"],"source_ids":["src_85394d2d36eb50b9b042b63bb368925e"],"text":"The project follows a strict DDD layering: pure domain packages under pkg/domain, an application SandboxRunner in pkg/sandbox, infrastructure implementations in internal/infra, and a Cobra CLI composition root in cmd/bbox.","updated_at":"2026-09-14T02:42:31Z","updated_by_operation":"op_394fc436b953422bbad8c6e969140d08"}
