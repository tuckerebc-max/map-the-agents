{"access":"public","created_at":"2026-09-14T02:42:31Z","created_by_operation":"op_394fc436b953422bbad8c6e969140d08","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b8de62be6f9bf9952a4806e1599889fd995a1335b1f94f45901501b498b0eaaa","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"stacklok/brood-box@5f27eeb76988 snapshot 7d277f4201e40de9","timeframe":null},"slice_ids":["slc_4aea818adc6350e7e8ee50d0f0552e64fdc400df67ce4559ab3acbdcfa10116c","slc_9a28a596015ed1c544312b54fe3c0655fdc7df767286ead56aba9ed0b486b04c","slc_a5a7deec447217f4cbebedecf8beba22d19b7d14ad2001f8c8c7941a9d440556"],"source_ids":["src_241dcdb897f356c4ba42b667d45abd2a","src_4d6b6a18d36250c28c9a2dc17d99e90c"],"text":"Built-in agents (claude-code, codex, opencode, hermes, gemini) each ship as a per-agent client package pairing an Agent value with a Plugin for MCP config injection and credential seeding, and custom agents can be defined in config.","updated_at":"2026-09-14T02:42:31Z","updated_by_operation":"op_394fc436b953422bbad8c6e969140d08"}
