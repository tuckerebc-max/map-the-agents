{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0e57e8738a6be0a0ed4f5d6a8bd6615bff103ba3dd1a8945f545be9c989a1bf8"],"opposing_claim_ids":[],"text":"Supported coding agents listed as fully supported are Claude Code, Codex, Cursor, and OpenCode, plus Traycer's own native inference subscription."},{"claim_ids":["clm_1b33568fe926ea67cf93306ba8ce7c2d87deb94900dae16b10eadc450134ccec"],"opposing_claim_ids":[],"text":"Traycer is described as an AI orchestration app that runs multiple agents in parallel while sharing memory across all models and providers."},{"claim_ids":["clm_2c14b4e5828cd3462e071b73b16a80b387c562512346a94243b9836f038d1ffb"],"opposing_claim_ids":[],"text":"Desktop builds are distributed for macOS (arm64 and x64 .dmg), Linux (AppImage, .deb, .rpm), and Windows x64 .exe via GitHub Releases."},{"claim_ids":["clm_3adeef74486337eb88fe0290f71b09fdf88a4f496269034887ea72917a8185ce"],"opposing_claim_ids":[],"text":"Agent-to-agent abilities such as reading a transcript or delivering a message are narrower and depend on the user, Host, and runtime, per a capability matrix."},{"claim_ids":["clm_5d566ebf3b2cc9cf44854006c0c434451d89ec3915437b48b3aff2d5e1b94e0c"],"opposing_claim_ids":[],"text":"The context window is shared across providers, so users can switch models within the same agent without losing context."},{"claim_ids":["clm_7816c5179581b6c9c6eda32da210956dd8caec7136de7ebcca79c4d86ad0a5a1"],"opposing_claim_ids":[],"text":"The product supports agent-to-agent communication, letting users create automated loops where agents debate architecture or peer-review each other's code."},{"claim_ids":["clm_c7ed14339efd97dff1b26a7a3c3633906c97c0bfcca9bce95f8739e2a233e976"],"opposing_claim_ids":[],"text":"Privacy documentation states code is processed in-memory and never stored or used for training, with a Privacy Mode defaulting on for Team plans."},{"claim_ids":["clm_e7f4cdbcf9c202ddcaf3dde6c2e668e664a85710fcde72f22220bf9a60e1eb2c"],"opposing_claim_ids":[],"text":"An agent is a durable session inside a Task that the user interacts with through a Chat or Terminal interface, powered by an underlying coding-agent provider."},{"claim_ids":["clm_ff6b7269561edf32772d284441145e3b286b6b4385983594aece2ab4b4bbb6af"],"opposing_claim_ids":[],"text":"The project is MIT-licensed open source with community channels on Discord, X, and YouTube, and accepts contributions under a DCO."}],"claim_ids":["clm_0e57e8738a6be0a0ed4f5d6a8bd6615bff103ba3dd1a8945f545be9c989a1bf8","clm_1b33568fe926ea67cf93306ba8ce7c2d87deb94900dae16b10eadc450134ccec","clm_2c14b4e5828cd3462e071b73b16a80b387c562512346a94243b9836f038d1ffb","clm_3adeef74486337eb88fe0290f71b09fdf88a4f496269034887ea72917a8185ce","clm_5d566ebf3b2cc9cf44854006c0c434451d89ec3915437b48b3aff2d5e1b94e0c","clm_7816c5179581b6c9c6eda32da210956dd8caec7136de7ebcca79c4d86ad0a5a1","clm_c7ed14339efd97dff1b26a7a3c3633906c97c0bfcca9bce95f8739e2a233e976","clm_e7f4cdbcf9c202ddcaf3dde6c2e668e664a85710fcde72f22220bf9a60e1eb2c","clm_ff6b7269561edf32772d284441145e3b286b6b4385983594aece2ab4b4bbb6af"],"created_at":"2026-09-14T03:19:55Z","created_by_operation":"op_572c0227dd3e4e168f944cf062f2fc76","id":"pg_f7266bc78df253eeac9b9597c35562d8","maturity":"draft","page_type":"source","path":"pages/sources/traycerai-traycer-readme-md-b12949767727-9597c35562d8.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b4d174736d825f1fbe0e035035766015"],"title":"traycerai/traycer/README.md @ b12949767727","updated_at":"2026-09-14T03:19:55Z","updated_by_operation":"op_572c0227dd3e4e168f944cf062f2fc76"}
