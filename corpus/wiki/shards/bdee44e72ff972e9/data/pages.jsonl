{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_581ecdcd0b2c7ac153f3ae241061af97bdea7abc8087d25c751dcab0c3b5c1a2"],"opposing_claim_ids":[],"text":"The terminal provides documented keyboard shortcuts including Cmd+T (new tab), Cmd+D / Cmd+Shift+D (pane splits), Cmd+, (settings), Cmd+Shift+A / Cmd+L (AI panel and chat), and Cmd+Click to open URLs or file paths."},{"claim_ids":["clm_623eb519f5c17b60dde57d4387cab802bf14f1e25d6e936c98f257d536c563c8"],"opposing_claim_ids":[],"text":"The `kaku` CLI includes subcommands such as `kaku init` for optional tool setup, `kaku --version`, `kaku ai` for AI service configuration, `kaku chat`, `kaku config`, and `kaku doctor`."},{"claim_ids":["clm_6b8439813100ce27786af060f4c1938677a0ad6888c23dff683d9b760b81586b"],"opposing_claim_ids":[],"text":"Kaku is an AI-friendly Mac terminal with sensible defaults, built on WezTerm with fonts, themes, shell integration, and Mac shortcuts preconfigured."},{"claim_ids":["clm_6fddb6db165884bd87f93d40c74a08e88c2c601afd7eefed68aff5f24454efcb"],"opposing_claim_ids":[],"text":"Kaku bundles JetBrains Mono, built-in zsh completion, syntax highlighting, and directory jumping, and offers shortcuts for optional Lazygit and Yazi installations; it is derived from WezTerm."},{"claim_ids":["clm_75e815d4850d769f47eb42bd35195d9ea02beab9605651e381cdd5d6e7b69614"],"opposing_claim_ids":[],"text":"The AI assistant supports failed-command fix suggestions (applied with Cmd+Shift+E), natural-language `# <description>` to command generation, chat over terminal output and project files, and settings for tools like Claude Code, Codex, Gemini CLI, Copilot CLI, and Kimi Code."},{"claim_ids":["clm_c03120c5222ce1198d97f2679ce8b7fba5dbfa0e04b455d57a4cf15dcac5b872"],"opposing_claim_ids":[],"text":"Kaku is macOS-only; the FAQ states there is currently no Windows or Linux version."},{"claim_ids":["clm_e71f0622b4cfc55dbaf475e243ff2e2fc35d5609e3f6ac99b8889a650b07ec43"],"opposing_claim_ids":[],"text":"Kaku does not provide or relay the AI service itself; users must configure their own AI service via `kaku ai` to use the built-in assistant."},{"claim_ids":["clm_f1dcfbe583ad4c9ca783e7ceed18125eee96eca1592ca89597e6a5a0d659bfdc"],"opposing_claim_ids":[],"text":"The product exposes WezTerm's Lua configuration system so users can customize fonts, themes, shortcuts, and terminal behavior; e.g. window transparency via `config.window_background_opacity` in `~/.config/kaku/kaku.lua`."}],"claim_ids":["clm_581ecdcd0b2c7ac153f3ae241061af97bdea7abc8087d25c751dcab0c3b5c1a2","clm_623eb519f5c17b60dde57d4387cab802bf14f1e25d6e936c98f257d536c563c8","clm_6b8439813100ce27786af060f4c1938677a0ad6888c23dff683d9b760b81586b","clm_6fddb6db165884bd87f93d40c74a08e88c2c601afd7eefed68aff5f24454efcb","clm_75e815d4850d769f47eb42bd35195d9ea02beab9605651e381cdd5d6e7b69614","clm_c03120c5222ce1198d97f2679ce8b7fba5dbfa0e04b455d57a4cf15dcac5b872","clm_e71f0622b4cfc55dbaf475e243ff2e2fc35d5609e3f6ac99b8889a650b07ec43","clm_f1dcfbe583ad4c9ca783e7ceed18125eee96eca1592ca89597e6a5a0d659bfdc"],"created_at":"2026-09-14T03:20:40Z","created_by_operation":"op_d83c2101087a474c923b7e7598c1b67e","id":"pg_9072d24285ea56deb10d71d1833a0912","maturity":"draft","page_type":"source","path":"pages/sources/tw93-kaku-readme-md-2b1b4c5906d0-71d1833a0912.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_384b174edd135bbfbb023def4505bb4a"],"title":"tw93/Kaku/README.md @ 2b1b4c5906d0","updated_at":"2026-09-14T03:20:40Z","updated_by_operation":"op_d83c2101087a474c923b7e7598c1b67e"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3e6847cf3d6c9bbf4c649d944a9dc4192fd9af4415bf11f167bc31460c1fa388"],"opposing_claim_ids":[],"text":"Repository development practice: releases use `V0.x.x` tags with `scripts/release.sh` as source of truth, release notes titled from `.github/RELEASE_NOTES.md`, and a manual pre-release smoke checklist in `.agents/skills/release/SKILL.md` run on the built app before tagging."},{"claim_ids":["clm_56f97fe51cd609896e25dea16bf5190c5fff51ebec4bce81ed86c6783a039cce"],"opposing_claim_ids":[],"text":"Repository development practice: CI runs fmt, check, tests, and log/prompt guards on pushes to main and pull requests, with paths-ignore for markdown and assets so docs-only changes skip CI; clippy and a relay-check job gate separately."},{"claim_ids":["clm_e284be4e4a9c2796e8367470f9186e6c5cd36da6e34408798415e378a16771f7"],"opposing_claim_ids":[],"text":"Repository development practice: contributors verify changes with make targets (fmt, fmt-check, check, test, app) and release scripts; `make fmt` requires the nightly toolchain, and `make check` does not run clippy, which CI checks separately."}],"claim_ids":["clm_3e6847cf3d6c9bbf4c649d944a9dc4192fd9af4415bf11f167bc31460c1fa388","clm_56f97fe51cd609896e25dea16bf5190c5fff51ebec4bce81ed86c6783a039cce","clm_e284be4e4a9c2796e8367470f9186e6c5cd36da6e34408798415e378a16771f7"],"created_at":"2026-09-14T03:20:40Z","created_by_operation":"op_d83c2101087a474c923b7e7598c1b67e","id":"pg_9af8c311641a57a6875e1f839d65275d","maturity":"draft","page_type":"source","path":"pages/sources/tw93-kaku-agents-md-2b1b4c5906d0-1f839d65275d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_eecb4a967e245b3aac3ff84e45e2a73f"],"title":"tw93/Kaku/AGENTS.md @ 2b1b4c5906d0","updated_at":"2026-09-14T03:20:40Z","updated_by_operation":"op_d83c2101087a474c923b7e7598c1b67e"}
