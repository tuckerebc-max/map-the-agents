","clm_afd88c5743746e471c7c033fe1cc90bd8d6a72e8335cf1ea96a63c0c5709ca20","clm_c497889471984295119a9ff21cd91ab811eb9e4e79efa60673fca5f7dcf48c86","clm_d316a8049b80ea00fca82483af7aaf9d81614463c6a19d0dcfe77e4545892437","clm_faed0a1823692c0b7e3e15ffe0eac06e75ae640ba2e2c733bed35dea274f712c"],"created_at":"2026-09-14T01:51:03Z","created_by_operation":"op_65ddbfd84727416cae5a2f8dd7c17f4c","id":"pg_6f486dbbfd3d55e290d88075186983e3","maturity":"draft","page_type":"entity","path":"pages/entities/get-convex-chef-8075186983e3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"get-convex/chef","updated_at":"2026-09-14T01:51:03Z","updated_by_operation":"op_65ddbfd84727416cae5a2f8dd7c17f4c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2ae77ed19a087d15b0f27ba79b2128f263e5bd4714a46ef1f767126626fdf65a"],"opposing_claim_ids":[],"text":"Repository development practice: contributors should format JavaScript with eslint and markdown with prettier, and large or fundamental changes are generally unlikely to be accepted as community contributions."}],"claim_ids":["clm_2ae77ed19a087d15b0f27ba79b2128f263e5bd4714a46ef1f767126626fdf65a"],"created_at":"2026-09-14T01:51:03Z","created_by_operation":"op_65ddbfd84727416cae5a2f8dd7c17f4c","id":"pg_a0dde9fab9f9592aaf78212ccb47a21e","maturity":"draft","page_type":"source","path":"pages/sources/get-convex-chef-contributing-md-d8a6cb6a6f22-212ccb47a21e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_206aef45ad915f3db5d5506055007444"],"title":"get-convex/chef/CONTRIBUTING.md @ d8a6cb6a6f22","updated_at":"2026-09-14T01:51:03Z","updated_by_operation":"op_65ddbfd84727416cae5a2f8dd7c17f4c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0670296ae09a0c895e1b825d8681cc2d2f1d1b6e96a0370f2255ba6a82db4fb7"],"opposing_claim_ids":[],"text":"Chef is described as an AI app builder that creates full-stack web apps with a built-in database, zero-config auth, file uploads, real-time UIs, and background workflows."},{"claim_ids":["clm_0df19dfd222069de6306dff2c54b94d7a675bd28cb82315aa46523c64c61e6ba"],"opposing_claim_ids":[],"text":"The repository includes a template directory used as the starting point for all Chef projects, and a convex directory storing chats and user metadata."},{"claim_ids":["clm_1b45ab38e4fca47cba084a492a14345bdc6735dfca5e6111b9209516a60460ba"],"opposing_claim_ids":[],"text":"The project is a fork of the stable branch of bolt.diy."},{"claim_ids":["clm_404d2b59580c2a2890972343f16a66b3648f4810b8eb8721d1c8b730f94c7a6b"],"opposing_claim_ids":[],"text":"Repository development practice: local setup uses nvm, pnpm, a VITE_CONVEX_URL placeholder, and 'npx convex dev --once' to provision a Convex project, then 'pnpm run dev' plus 'npx convex dev'."},{"claim_ids":["clm_6e1f21bd72601b31658df6431dc11ead267b76a0b7d4c7c27a455aee47ff2ff3"],"opposing_claim_ids":[],"text":"A chefshot directory defines a CLI interface for interacting with the Chef webapp."},{"claim_ids":["clm_7f2c53642a70c9c21ed2a2562831f851b3a40b5b3e916304a0ed9369c66a54b4"],"opposing_claim_ids":[],"text":"Local code generation is enabled by supplying API keys for providers including Anthropic, Google, OpenAI, and xAI, either via env file or the Chef settings page."},{"claim_ids":["clm_90ef85dd5ae41a7e79fcaec7358ecf21ffb0a14c4e86dba84e9645fc2e491d5d"],"opposing_claim_ids":[],"text":"The chef-agent directory handles the agentic loop by injecting system prompts, defining tools, and calling model providers."},{"claim_ids":["clm_afd88c5743746e471c7c033fe1cc90bd8d6a72e8335cf1ea96a63c0c5709ca20"],"opposing_claim_ids":[],"text":"Chef is offered as a hosted webapp at chef.convex.dev with a free tier, and can also be run locally following README instructions."},{"claim_ids":["clm_c497889471984295119a9ff21cd91ab811eb9e4e79efa60673fca5f7dcf48c86"],"opposing_claim_ids":[],"text":"Chef ships with an authentication configuration tied to Convex's internal control plane for user accounts; forks for production must replace it with their own auth."},{"claim_ids":["clm_d316a8049b80ea00fca82483af7aaf9d81614463c6a19d0dcfe77e4545892437"],"opposing_claim_ids":[],"text":"Chef's capabilities come from being built on Convex, whose APIs the README describes as an ideal fit for code generation."}],"claim_ids":["clm_0670296ae09a0c895e1b825d8681cc2d2f1d1b6e96a0370f2255ba6a82db4fb7","clm_0df19dfd222069de6306dff2c54b94d7a675bd28cb82315aa46523c64c61e6ba","clm_1b45ab38e4fca47cba084a492a14345bdc6735dfca5e6111b9209516a60460ba","clm_404d2b59580c2a2890972343f16a66b3648f4810b8eb8721d1c8b730f94c7a6b","clm_6e1f21bd72601b31658df6431dc11ead267b76a0b7d4c7c27a455aee47ff2ff3","clm_7f2c53642a70c9c21ed2a2562831f851b3a40b5b3e916304a0ed9369c66a54b4","clm_90ef85dd5ae41a7e79fcaec7358ecf21ffb0a14c4e86dba84e9645fc2e491d5d","clm_afd88c5743746e471c7c033fe1cc90bd8d6a72e8335cf1ea96a63c0c5709ca20","clm_c497889471984295119a9ff21cd91ab811eb9e4e79efa60673fca5f7dcf48c86","clm_d316a8049b80ea00fca82483af7aaf9d81614463c6a19d0dcfe77e4545892437"],"created_at":"2026-09-14T01:51:03Z","created_by_operation":"op_65ddbfd84727416cae5a2f8dd7c17f4c","id":"pg_a742b6c841745220b95e47804b1dcec0","maturity":"draft","page_type":"source","path":"pages/sources/get-convex-chef-readme-md-d8a6cb6a6f22-47804b1dcec0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dc4a92ba974555b4bed66c1116743109"],"title":"get-convex/chef/README.md @ d8a6cb6a6f22","updated_at":"2026-09-14T01:51:03Z","updated_by_operation":"op_65ddbfd84727416cae5a2f8dd7c17f4c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_49f6c636c0003b5ddb6337a5f288229250be2ac13c919890a7d2954e712bb804"],"opposing_claim_ids":[],"text":"Chef appears to use a WebContainer-style environment: a documented debug global exposes 'chefWebContainer' as the unix-ish container where tooling and generated code run."},{"claim_ids":["clm_517774d1a3f69bda0cb73709cda6d527e69ce9cd80229dec3204f77936572398"],"opposing_claim_ids":[],"text":"Repository development practice: PRs target main; a commit queue blocks on tests, formatting, lints, and typechecking via pnpm scripts, and the repo has very few tests and no e2e tests."},{"claim_ids":["clm_6fb78f14f6e4d6374f81ccfe2a8d85f01ce26dd486904ae7ee12b95533315487"],"opposing_claim_ids":[],"text":"Repository development practice: DEVELOPMENT.md is aimed at Convex employees and is not a supported workflow for external users."},{"claim_ids":["clm_faed0a1823692c0b7e3e15ffe0eac06e75ae640ba2e2c733bed35dea274f712c"],"opposing_claim_ids":[],"text":"Repository development practice: releases push main to staging, then merge staging into release after agent evals run (~10 min) with a 100% isSuccess rate expected."}],"claim_ids":["clm_49f6c636c0003b5ddb6337a5f288229250be2ac13c919890a7d2954e712bb804","clm_517774d1a3f69bda0cb73709cda6d527e69ce9cd80229dec3204f77936572398","clm_6fb78f14f6e4d6374f81ccfe2a8d85f01ce26dd486904ae7ee12b95533315487","clm_faed0a1823692c0b7e3e15ffe0eac06e75ae640ba2e2c733bed35dea274f712c"],"created_at":"2026-09-14T01:51:03Z","created_by_operation":"op_65ddbfd84727416cae5a2f8dd7c17f4c","id":"pg_db1e5e48c449577082a8d4de9d63a0cf","maturity":"draft","page_type":"source","path":"pages/sources/get-convex-chef-development-md-d8a6cb6a6f22-d4de9d63a0cf.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_80afda3bd8a75137bc20f08253a6e4e4"],"title":"get-convex/chef/DEVELOPMENT.md @ d8a6cb6a6f22","updated_at":"2026-09-14T01:51:03Z","updated_by_operation":"op_65ddbfd84727416cae5a2f8dd7c17f4c"}
