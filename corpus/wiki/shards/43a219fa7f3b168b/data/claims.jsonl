{"access":"public","created_at":"2026-09-14T04:33:37Z","created_by_operation":"op_345b3e2327f34a5db0591e4818fc1087","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_96f0de77cb416c42b2ebbd18d671be1973e10b6cedc0b326584c0b41c84be424","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"zai-org/glm-5@008de4dbcc22 snapshot 2d38f9b696eeac7f","timeframe":null},"slice_ids":["slc_d566eea14a51a1257357909d31bae0e7ea8ea736bb911a051fc85eb3b551024a"],"source_ids":["src_f04119a0333a56eba145d8a1fd343519"],"text":"GLM-5.2 introduces IndexShare, reusing one indexer across every four sparse attention layers to cut per-token FLOPs 2.9x at 1M context, plus an improved MTP layer for speculative decoding.","updated_at":"2026-09-14T04:33:37Z","updated_by_operation":"op_345b3e2327f34a5db0591e4818fc1087"}
