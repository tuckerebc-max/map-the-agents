{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_001604271bdae2a9af449ffe9b1217b0ec65c65f9ebbbc3dc9c934533268fff1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_61ae2014a1ab37140e9a0eea789ca8d76ec6a5feca3c95ba44463c72e0282fbc","slc_84da33a0094f33e24733644a18ecfe035f98c77ff90868d8acf68d8ed7bae9f0"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"The project targets organizations integrating frontier AI or local LLMs into engineering workflows that must avoid leaking proprietary code or secrets to model endpoints.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_064297d1f673aee996b989a02163d9e296554c50057dc4d65890217de91c79d3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_d7972712b5b6b7a7452a954ebce6a120f356355fa4f08eda05fa52a6f70334e6"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"The tool is described as editor-agnostic, integrating with any tool that can run a CLI command before and after an edit or any IDE extension supporting LSP-like hook callbacks.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_277a71ec135d91e705431fac4a18cd068217db1fd5990249f7852b76325ac122","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_2c635d09f29c19843771f9abf4378999dc98c3e5f34c370dab507d5cb85e6c33"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"The framework is positioned as a decoupled configuration layer requiring no daemon, kernel patching, or heavyweight control plane, overlaying an existing Git workflow.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_34b9b311a6ef775190fb0be996c219f21bf56cc61a471842843eda038f403b0d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_61ae2014a1ab37140e9a0eea789ca8d76ec6a5feca3c95ba44463c72e0282fbc"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"CodeBoundary is described as a zero-trust compartment model in which each third-party model runs in an ephemeral container with strictly bounded data exposure, rather than sharing context across a common environment.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3d7a05b84c717a4173ee472f4097b1d885163265179f1c4dad51c5e080c4342b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_d1c1da30ea1d58e23ad4477e24783009598340470864c7bcb04d529ba55ad38c","slc_e6f3d0acad2082ca3fe9f7f740e81ecfbbbc195cbbc56f0326d2c7414bf73231"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"The core mechanism is a data-boundary contract: a YAML/JSON configuration stored with the source that defines scope, redaction rules, visibility level, and output filters for model sessions.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7ddbe2efa17f631cbc88fe30dcda9258170a684ac38587de544c4886cef2840d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_2cf0fc2015a612f8980d9799d50f413b6367243af6b6aaf7470748c0944859c8","slc_ae06f28528e0e5d449ae94db4c6c1e2d6a82725a7652b920487d43158915b641"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"The README explicitly disclaims that the software is a security enhancement, not a guarantee: it cannot prevent all leakage such as side-channel attacks or undocumented model behaviors, and authors disclaim liability for data exfiltration.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9cd113858aebf4b2f6ac0392362c0c8383ae29dba1ad398344a60334768cacde","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_1548fc53308c4d2b196263e75930d779dbad1c69f8a2c371277ec632d8d90331","slc_c5dfce6177ebaf3c36a76bbfe457ee94330fd6ef7f3c13922ad1b7dcf69256d1"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"The primary entry point is a .codeboundary.yml file at the repository root, defining a default contract, an allowed-models list with names and fingerprints, and an audit log destination such as a local .cb-audit/ directory.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ac1b5cda3007c5e6fee52cd8c10e1b8db36c243f8bbdd1acc3a774b012105c76","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_96e6509d394ca31598f95c4cd97a1c703d99feef0cb6a4436a1a9c49163ae9cf","slc_f58c7bcc91d9640363489c1611928f8dc2231f2fe7b2d312724e4b2c99fce29a"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"Hybrid sessions route low-sensitivity tasks to a fast local model and high-complexity tasks to a frontier API under one contract, with context stripped and rehydrated between models.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cdf9165a326ce97d1c3437735199293e95d8b49efe3a9c77eaa75d1a79d9acd4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_4d7eeaca6f49b8a50d55e6aff0f0e45aa4288c1c966e672eea3150a967762c2c","slc_94a731e051c87c65e4e3bd5d1166b33f89b40accbf7055a1465cb957a6328698","slc_cc4850278d079414138f6dfeb7c99d57c062f78d4439642a1a7fbe695eb6d1cb"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"The architecture uses a 'diplomat's pouch' metaphor: the engineer declares contract contents, the model receives only declared data, and output stays sealed until the engineer unseals it; extra context requests are logged as boundary violation attempts.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d41f32b73134ab69bde4227b6b64838d1a633ac7b5b7be78c9ced7693ae07189","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_18436f75069175657b89b5f576f884f7b1c1b44ee6a6ae2d050406a60c350d14","slc_8cb8b94bcea3d6ee8dfc459b8247e9eea70a71e81f1ec451d072898465e75d83","slc_91a800dde5b1006500c6f4902a5cc2bdd5b174272479122f862d9ee14208dbe2"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"Each model invocation runs in an isolated context bubble that starts clean, and model output goes to a staging area rather than the working tree until an engineer explicitly approves it.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
{"access":"public","created_at":"2026-09-14T03:36:02Z","created_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_dc203cdfaec97747e1029fdc095126ff4ece85270009e76edba74d593ad69251","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"atrayee-dev/secure-ai-agent-boundary@4c23100eddad snapshot b16dae5a835c4628","timeframe":null},"slice_ids":["slc_80b010e0833e849becb8d1ec9b6a6393c43de21d52ae3d347bcee4e964b8ecca"],"source_ids":["src_f7df6f4e7f27556a9bb945bea9de1d99"],"text":"The boundary engine is language-aware, claiming syntax-tree understanding for 12+ languages including Python, TypeScript, Rust, Go, Java, C#, C++, Ruby, PHP, Swift, Kotlin, and Shell.","updated_at":"2026-09-14T03:36:02Z","updated_by_operation":"op_0db4ef49fab34fe0ac31a28d38d2e213"}
