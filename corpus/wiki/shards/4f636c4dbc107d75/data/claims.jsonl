{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0fa9f1430e09c6fc6c71d0aa5379f8e28fe43f2f228f0b590968314e21b46ad4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_478f6a6ca7d5141fd8a20b205433c617d15475f60c5cef183d45965181c38b5b","slc_4df6ae3a0f097ce9788b01fd868104f7d17cc0bbc9ce0aaa6678e80ad0e5680e","slc_97565ec9491259299f7df2dd597980f5af7cf7a98adb24a84bc8a866c50dedbb","slc_d17caee47e32401450e17ec606f29ac0020331cacf32e5df01d6e4c71dbbfcb9"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"The kernel enforces hard budgets on reasoning iterations, tool calls, wall-clock time, context and result size; rejected calls still receive protocol-valid errors, and batches run concurrently only when entirely read-only.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1e09edac28b58b0df9287b60556f77c8d46883f3a126f372c6c25594d5d91787","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_18b50dc3de7188d6d051219d1ab2363b19ee28cafd253d7a2b01f87759c72e4e","slc_8c9bcda433121b2274dca19f39e48e77cd41c412278266507fa9aa7a2a6ed9db","slc_ade985e5c7b420d32a842de93970af53bec07140a0db0dd625463fa4d8497a75"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"An optional Streamable HTTP MCP client adds external tools, resources, and prompts with discovery, per-call timeouts, and namespacing; remote MCP annotations are kept as metadata but never automatically downgrade local safety policy.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_27d9c2c451a972d50b987a52f1e0da2e170156d3fd45c1d690f64a9db70c3968","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_74a8906cb5de16100b9c02a6cb7743a84b7376f34b8e7d23f2be1ce074f55c4f","slc_cfe69467636d28f3a439edeceae70b95441433a1b316f4ad2bfdac6a68897555"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"Three reasoning profiles (Rapid, Balanced, Deep) vary thinking, iteration, tool-call, and time ceilings while keeping identical schema validation, allowlists, approval requirements, and checkpointed replay.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_34f4137819cbb8a2c79ad38dd70609b68b04f9936f57b6813505270292874663","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_10204d9886d985225d836205b7f0ff55ca0a727ddcae523cafe0634ca8dfbab6","slc_13d75deab521e266ced46c5934121ac570420fe8a66d3d2778c88e57f0029b8b"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"A React dashboard provides Home, Ask & Run, Action center, Automation, Advanced insights, Dashboard Studio, and Quick Ask surfaces; generated dashboard HTML runs in an opaque sandbox under a restrictive CSP with no same-origin API access.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_65c20e33ae4e9101b734854317d0465319f5101e5e244fd491513841b91074e3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_7f73d7de9337fcff30d125bdc9e05c5c3b3c95e0a30d60de6904ccf6c63a3fea","slc_e2bf5447360450da3ded03ccee88e4ef1abb73b86b93ce0c8e33f634832fea92"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"Version 0.13 records whether Home Assistant accepted a service call but does not re-observe affected entities to verify physical outcomes; post-action verification is named as the next milestone, and Assist/voice integration is not yet included.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6a7e09926eb22ee4b2f4afcb3808cc944e09cfe16a445b2029e6524ab1f66c2e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_ac37be785f0a2f4fcd00c2a14ee1666085b4c73a24fe4902cb799051c264f2c8"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"Plan execution uses an atomic claim so only one executor runs a plan, checkpoints after each step, stops on failure marking remaining steps skipped, and returns idempotent responses for already-completed plans.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_717fa1a3c10724d2ffd01ff15e34fb091620d3b72593a0d46542991a76ebd191","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_e2bf5447360450da3ded03ccee88e4ef1abb73b86b93ce0c8e33f634832fea92"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"Active model conversations do not resume across process restarts (persisted plans are durable), and an interrupted executing plan is intentionally never auto-replayed because a command may already have reached a device.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_821177d2c56d976216e3361eeca529c3e1448d2fa33e5e531434c41a3170c35f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_336a76321df079421ab6f652ff4d2490ba3b1904d2471d64d35509bb3552c1f0"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"The project is versioned v0.13.6 and is distributed as a Home Assistant add-on, with a badge claiming 286 backend tests passing.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_87d5076d3fe22b44736628b26adffc86a6799593962c6cc01d105c173b16b89c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_5250119a28d8628df13df81e531bfe3f8622241740d52e64bd5908644bdc55cb","slc_7b0fefb6030666f953216d419b92fc114e259f4d2e28fd0be896a49f40b5bcd1","slc_7feb0ca1e25fc09551c5f6d3a11aa7dba91fa2e2c0b91899554c8f55be3fdca7","slc_eb5af2050592e6e11d6f9dd09b005d4c91811b2b0cdbb12c5a91b21abf9d9691"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"The design principle is that the model proposes while application code validates: the runtime, not the model, decides which tools exist, which domains/services are allowed, what needs approval, and what is audited.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8dc33c7f846956ad271682f75c9b7ad4f98c04448d339832a90de75e8d54517c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_32422b61be98c7f629bd11ea18eafaaeb5cd444d7bd677091ed53803bae2c500","slc_ab61ab75c98cdcd652cf09488836a2329424975101d617da067871e00fc29bb0"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"Tool requests are validated against JSON Schema and local policy covering entity domains, service allowlists, blocked domains, and temperature bounds; dangerous domains like shell_command, hassio, script, automation, and rest_command are blocked by default.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_93d4790eced057dd32f7cf316a67a3c2cc204e655c258bf66e9c51f7509ba469","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_23f589eddf6e611eb1d267d0017d9eff88d57101241585a3cd7c9c7e44d4c501","slc_7458e4cf26609a3ddf62e6d8a21da120726d3bdd8a0369ae6df1074926a1b998","slc_fe1416ac3cbaf59b67652760909611f10722db0baded901b0726b115e8a022c6"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"The product ships dry-run by default with direct execution disabled; first-run config sets dry_run_mode true, reasoning_allow_direct_execute false, and legacy autonomous loops disabled.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_aef6b72ae13d6f0fd00a4d38430644a4aee5ebf2afcefcf22ffbddcf9bb99818","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_446f5a68d0affa772c9d328af0e9000a3165e94b03f29fa12ad96d5c41d296d2","slc_53a850c46dbd6e42ef16952707d35b49e3f336207060a6086175c342c2a24755","slc_7a499c28e61931ff22295754695d965b423861dbcea24773ce4a291d3e1cca7c"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"The kernel is provider-neutral, supporting local Ollama (default gemma4:e4b) plus OpenAI, Anthropic, GitHub Models, and Microsoft Foundry; requirements include Home Assistant OS/Supervised and an Ollama server or cloud credentials.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bf31b0a769bb898e96612356e0d9b3b121b5bee046063be2a4419b1a20f24786","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_1e405eb81a172a02cda4d66c741b7c87cf411e781b308ed4f818606ffeb6b0bb","slc_6f78995de120a69700ef0d576cb73541294ad33ab031ea047c6fed8bc8ae2843","slc_b1719b0237e096d28a0503c8457f4dfe3630447de9c20b97a58fd4d8cb503aa4","slc_d55e24f3c8c7ae527a13b4b12230b41f676a94e3564f99a52db13c134c485d91","slc_e320b2c2fd5ab7b65389dfc8a6d715546d93c1e7bfb0438d3e1b04c634482b35","slc_ebb4002b42f187e71f7a9dd7d098a1e644a8f99c10d83896518b9fc713a03001"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"Repository development practice: contributors run backend tests via pytest in a Python 3.11/3.12 venv, build the dashboard with npm ci/audit/build on Node 22, and can use a Dockerfile.test image for a lockfile-only reproducible test run.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bf746c72db4edddc90be666da354c5c470a0e82c46c42262ca4bf9b351f66d49","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_32422b61be98c7f629bd11ea18eafaaeb5cd444d7bd677091ed53803bae2c500","slc_4e14348ea0e543e0a9aa48c3c9a869dcd1ced3f41039c21ab7e5d2b0a1fc404a"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"The generic ha_call_service path is not exposed to the reasoning model; mutations go through a guarded local call_ha_service route so direct WebSocket access cannot bypass policy, and approval status is application context that model arguments cannot forge.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d5fbdda19865bdcaec9a7bda0c6f573cf8ae3a5d3e5bf1f096e9f77dd0c9eb80","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_36bfbf819b17688cc4e626650878f451f0f7265d55ddbf4575f64cd21e295697","slc_a360e5a3556305df97ab1ed6b4cf4e1c044270d9a6c5cc962376fc56ee57fe11"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"In plan and auto modes, state-changing calls are intercepted and simulated results are returned to the model; the exact tool name and arguments are recorded as a reviewable plan, later replayed in order without new model decisions.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d648f28e357e637424816064ce4bcf132eb99a43bd2a8194db1eceb4aee0121e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_2ed419c67fa3a70414fbd87f280904e11189d36552b6fdd0f92827b61592c244","slc_ab71fd92f0be5debef5f7dd03904232443e0dbd873a52ee02ecd8f623ceb61ff","slc_cfbd0ff85610054430db7d3efd80b506f5364fb2f65e10ed06ac13118faf6dae"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"Optional RAG and episodic memory use ChromaDB with local Ollama embeddings to store entity capabilities, manuals, past goals and outcomes, and user feedback; recalled episodes are reweighted by feedback without changing execution policy.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
{"access":"public","created_at":"2026-09-14T03:59:20Z","created_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fb717924f68045f46fd8bfd046c8989f6edab43bd04a26d38338fdbf3923ab6d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"itspecialist111/hass-ai-orchestrator@cebfdff5d5a9 snapshot 9cd40944db7532c2","timeframe":null},"slice_ids":["slc_0b95c29c94b41a50331045b600da58e174004bc1d1e71fb19e0e9108f6647029","slc_febf1eebc3b413aa13a96fd2793fe3b1ec101b3de39b62dcc11623c6c74d4382"],"source_ids":["src_bef6479ee6b75cc9a868d26dc302639f"],"text":"An eval scenario file defines representative home-agent goals (security approval, blocked domains, climate conflict, duplicates, ambiguity, etc.) scored by deterministic assertions on mutations, approvals, budgets, and forbidden tools rather than an LLM judge.","updated_at":"2026-09-14T03:59:20Z","updated_by_operation":"op_7650d6c950174fdd9a1d9cc620f52d53"}
