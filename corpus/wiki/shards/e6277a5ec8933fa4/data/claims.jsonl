{"access":"public","created_at":"2026-09-14T02:27:26Z","created_by_operation":"op_e9374c8ebd874686b5edc82805c878cb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_117813620b870bc6441ccc1278877749b78300ab93e19feb74cb46c736d9a13f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"openhands/openhands@28464621d879 snapshot f5c20f1428089f35","timeframe":null},"slice_ids":["slc_ca938ba5a4593d0591732ae543ee3b5f8447d973ce9641d8a2d501909b65400f","slc_eb83b80c8d286eba73c3fca478c9aef776bd1bd6330f50f0757595991b84581e"],"source_ids":["src_1a51db768e475ba89850aa4383e53641"],"text":"Non-sandboxed installs require Node.js 22.12.x or later and uv; the Docker option requires Docker Desktop or Engine and a PROJECTS_PATH host directory.","updated_at":"2026-09-14T02:27:26Z","updated_by_operation":"op_e9374c8ebd874686b5edc82805c878cb"}
{"access":"public","created_at":"2026-09-14T02:27:26Z","created_by_operation":"op_e9374c8ebd874686b5edc82805c878cb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3eb5905676aaa9b01f870acc7cba1c41ecaa6ebe95979991b3cdde6d7184b29b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"openhands/openhands@28464621d879 snapshot f5c20f1428089f35","timeframe":null},"slice_ids":["slc_567f412d816008629a55204889545561fc32594b4c126693761bbe873d74d8bd","slc_9d8965c8750e02731b495d2d94a9dba0c4b6fd8581ae4a8e408eaced2f86be01"],"source_ids":["src_1a51db768e475ba89850aa4383e53641"],"text":"Agent Canvas is described as a self-hosted developer control center for coding agents and automations, currently in beta status.","updated_at":"2026-09-14T02:27:26Z","updated_by_operation":"op_e9374c8ebd874686b5edc82805c878cb"}
{"access":"public","created_at":"2026-09-14T02:27:26Z","created_by_operation":"op_e9374c8ebd874686b5edc82805c878cb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_49c25e9e4c714aa8c5ff0386c2b77d3f42de2833fc38028ce18331f7420d7917","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"openhands/openhands@28464621d879 snapshot f5c20f1428089f35","timeframe":null},"slice_ids":["slc_5f5c0a6bca2483f2d47bc6072d2efac2fe0b8bd0bba79b34c9b91a7aaaaac57d"],"source_ids":["src_1a51db768e475ba89850aa4383e53641"],"text":"The UI is served at localhost:8000 for npm/source launches and at /canvas for the Docker image, with backends addable from the UI.","updated_at":"2026-09-14T02:27:26Z","updated_by_operation":"op_e9374c8ebd874686b5edc82805c878cb"}
{"access":"public","created_at":"2026-09-14T02:27:26Z","created_by_operation":"op_e9374c8ebd874686b5edc82805c878cb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9612de43cf60e1e4ca02f455466c104378c7b336246d5bc60f3b93508005784b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"openhands/openhands@28464621d879 snapshot f5c20f1428089f35","timeframe":null},"slice_ids":["slc_8c251f108de50858baa481a9605aad90b2fc530cbdcc216b9dd9d98d0bfd11ed","slc_fcf87b56568faf67d27400e9de22d8defe231bd0219fddbd89fffb8522739fa2"],"source_ids":["src_830bc1a1c88e55469ed52ecd316e7a66"],"text":"Repository development practice: the changelog follows Keep a Changelog format and the project adheres to Semantic Versioning; npm publishing is automated via a GitHub Actions workflow with OIDC trusted publishing.","updated_at":"2026-09-14T02:27:26Z","updated_by_operation":"op_e9374c8ebd874686b5edc82805c878cb"}
{"access":"public","created_at":"2026-09-14T02:27:26Z","created_by_operation":"op_e9374c8ebd874686b5edc82805c878cb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ab89b3e6f087705482b6c66f6b7487d2acc55f07efc9bd120e7e31a254b1fd25","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"openhands/openhands@28464621d879 snapshot f5c20f1428089f35","timeframe":null},"slice_ids":["slc_78ba414ed92694713d9e209cd6bdd879b75d7724a837ede13e4f46f8b538ae2c"],"source_ids":["src_1a51db768e475ba89850aa4383e53641"],"text":"Agent Canvas is powered by the OpenHands Agent Server, a REST API for running multiple agents on one machine; the frontend can connect to and switch between multiple Agent Servers.","updated_at":"2026-09-14T02:27:26Z","updated_by_operation":"op_e9374c8ebd874686b5edc82805c878cb"}
{"access":"public","created_at":"2026-09-14T02:27:26Z","created_by_operation":"op_e9374c8ebd874686b5edc82805c878cb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b102b6fbf0dd73b87495b80b328e6fd09ac258d037bc803aa0c14527fd5e220d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"openhands/openhands@28464621d879 snapshot f5c20f1428089f35","timeframe":null},"slice_ids":["slc_233eeee507c95dfa21855be4f1a2bb08af99e1a8947b05063791c61dafbc3b6b","slc_2de2a9883c03b85d131ea9ef71c0fab99fc0a736eabbbe68682b44c4d90b91e6"],"source_ids":["src_1a51db768e475ba89850aa4383e53641"],"text":"The project is split across repositories: this repo owns the frontend, backend selection, and local-stack orchestration, while the SDK owns the Agent Server API and the automation repo owns scheduling and dispatching.","updated_at":"2026-09-14T02:27:26Z","updated_by_operation":"op_e9374c8ebd874686b5edc82805c878cb"}
{"access":"public","created_at":"2026-09-14T02:27:26Z","created_by_operation":"op_e9374c8ebd874686b5edc82805c878cb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b5778ec096c8aedf70bda1d8e9768c89805135737f4f2341627da89487741738","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"openhands/openhands@28464621d879 snapshot f5c20f1428089f35","timeframe":null},"slice_ids":["slc_30a9244728813e633bdc1ecbc07027a112b3faa2ad817566a474ce8d8b2b1da9","slc_6392abb3d5a479a541d77796dc29f3a890600a74024af9e3383a4cc487351ee7"],"source_ids":["src_1a51db768e475ba89850aa4383e53641"],"text":"The agent-canvas CLI starts the full local stack by default and supports --frontend-only and --backend-only flags to run pieces separately.","updated_at":"2026-09-14T02:27:26Z","updated_by_operation":"op_e9374c8ebd874686b5edc82805c878cb"}
