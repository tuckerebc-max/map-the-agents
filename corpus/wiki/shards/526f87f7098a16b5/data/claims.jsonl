{"access":"public","created_at":"2026-09-14T02:30:07Z","created_by_operation":"op_6e59abe42c344ec69e5b9f2e53e22ec5","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b7b1984a225d7099c9afc38c6091bf9446b7c0863dc8f33d897d3bf9773502e8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pawanosman/opencursor@e94886325f76 snapshot 4d702a4dae4114d6","timeframe":null},"slice_ids":["slc_63d449973ac23dcbfd2261b3598f416fb11251222efcd7180b55b0e18d57ff1f","slc_7872fb14f9599e3aa3380710b9ebfa72b1ca9980a86755a3e02eec81766d78a9"],"source_ids":["src_a00f40e6ce875bf5abb76b6f64af9231"],"text":"OpenCursor is a VS Code extension installable from the Marketplace or as a .vsix, providing a multi-tab sidebar chat with @-mentions of files, folders, docs, commits, diffs, terminals, and rules.","updated_at":"2026-09-14T02:30:07Z","updated_by_operation":"op_6e59abe42c344ec69e5b9f2e53e22ec5"}
