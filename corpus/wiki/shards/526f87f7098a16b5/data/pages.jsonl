7bab57","clm_ce47e5c2fedfcb09ff4c69ca7391b07f168ee9d1a2b43cef400c6978e78aa6d6","clm_ef6bc5e03dbaf197aa74ba4e3ec924b5254b884add5de1b693bd6e815e26b825"],"created_at":"2026-09-14T02:30:07Z","created_by_operation":"op_6e59abe42c344ec69e5b9f2e53e22ec5","id":"pg_1b0cc3b24d7152f3ad8e6a067cc63dd7","maturity":"draft","page_type":"entity","path":"pages/entities/pawanosman-opencursor-6a067cc63dd7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"pawanosman/opencursor","updated_at":"2026-09-14T02:30:07Z","updated_by_operation":"op_6e59abe42c344ec69e5b9f2e53e22ec5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_26a0b7a181ead46788ab7c62b8b61b64d2c4609d2a3134aebce2fef5e884f38c"],"opposing_claim_ids":[],"text":"A per-action approval policy supports allow/ask/review/deny with risk heuristics (e.g. rm -rf, sudo, .env, secrets) and wildcard allow/deny lists."},{"claim_ids":["clm_54fc169ee2e371772e284ade7e9ac5bd5f9ef57b1be69a80d7eb267128291f1a"],"opposing_claim_ids":[],"text":"Local AI support includes built-in llama.cpp management (spawning llama-server with control over context size, GPU layers, flash attention, etc.) and zero-config Ollama integration."},{"claim_ids":["clm_5c535319a5999f7395dc6d4a6f638c05ce614dd5e58cc80d85e2ffca75a5137a"],"opposing_claim_ids":[],"text":"The agent ships a suite of 25 tools including read/write/edit, shell, grep/glob, semantic search, web search/fetch, notebooks, todos, subagents, and MCP."},{"claim_ids":["clm_6e95d34490d42431b652fc70f354c78150ae10e5b832468d95fdfefeb1bd9aeb"],"opposing_claim_ids":[],"text":"Heavy native runtime dependencies such as ONNX runtime and image processing are downloaded on first activation with integrity checks rather than shipped in the VSIX."},{"claim_ids":["clm_b3c684dd546ea77944b3b851c385593f71a7094889d3be76f89f62c2d86242ef"],"opposing_claim_ids":[],"text":"Edits get per-hunk Keep/Undo CodeLenses for inline review, and the README states this works without requiring git."},{"claim_ids":["clm_b7b1984a225d7099c9afc38c6091bf9446b7c0863dc8f33d897d3bf9773502e8"],"opposing_claim_ids":[],"text":"OpenCursor is a VS Code extension installable from the Marketplace or as a .vsix, providing a multi-tab sidebar chat with @-mentions of files, folders, docs, commits, diffs, terminals, and rules."},{"claim_ids":["clm_be5f88ffd89336c03248baad6878131b5f40a2c4c9afe80d58776b0cff435d16"],"opposing_claim_ids":[],"text":"Repository development practice: build from source with pnpm install and pnpm run compile (or watch), press F5 for the Extension Development Host, and package with pnpm run vsix; issues and PRs are welcome."},{"claim_ids":["clm_c04769895b45c6190bd889342816bb12694e1a568c632f87f98d2b38296393f3"],"opposing_claim_ids":[],"text":"Providers include OAuth sign-in for Claude Code, OpenAI Codex, and Google Antigravity accounts, API-key presets (OpenAI, Anthropic, Gemini, OpenRouter), and custom OpenAI-compatible or Anthropic-style endpoints usable simultaneously."},{"claim_ids":["clm_c925998b6f15efe5ad7b675f697a318f7f62a86746b5d1c771a0b5b06e7bab57"],"opposing_claim_ids":[],"text":"Semantic codebase search uses an on-device ONNX MiniLM embedding model, with an option to point at any OpenAI-compatible /embeddings endpoint instead."}],"claim_ids":["clm_26a0b7a181ead46788ab7c62b8b61b64d2c4609d2a3134aebce2fef5e884f38c","clm_54fc169ee2e371772e284ade7e9ac5bd5f9ef57b1be69a80d7eb267128291f1a","clm_5c535319a5999f7395dc6d4a6f638c05ce614dd5e58cc80d85e2ffca75a5137a","clm_6e95d34490d42431b652fc70f354c78150ae10e5b832468d95fdfefeb1bd9aeb","clm_b3c684dd546ea77944b3b851c385593f71a7094889d3be76f89f62c2d86242ef","clm_b7b1984a225d7099c9afc38c6091bf9446b7c0863dc8f33d897d3bf9773502e8","clm_be5f88ffd89336c03248baad6878131b5f40a2c4c9afe80d58776b0cff435d16","clm_c04769895b45c6190bd889342816bb12694e1a568c632f87f98d2b38296393f3","clm_c925998b6f15efe5ad7b675f697a318f7f62a86746b5d1c771a0b5b06e7bab57"],"created_at":"2026-09-14T02:30:07Z","created_by_operation":"op_6e59abe42c344ec69e5b9f2e53e22ec5","id":"pg_2ad13a4dd9bc52e59666603df2217349","maturity":"draft","page_type":"source","path":"pages/sources/pawanosman-opencursor-readme-md-e94886325f76-603df2217349.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a00f40e6ce875bf5abb76b6f64af9231"],"title":"PawanOsman/OpenCursor/README.md @ e94886325f76","updated_at":"2026-09-14T02:30:07Z","updated_by_operation":"op_6e59abe42c344ec69e5b9f2e53e22ec5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_18a92481fcd303acc77449a11fedf537f35e4e4dd2b223dc62ea76b7814d3f74"],"opposing_claim_ids":[],"text":"The changelog documents per-tool hard timeouts, abort-signal support so Stop cancels mid-work, and configurable per-tool timeout seconds in Settings."},{"claim_ids":["clm_8a09a8bd0ed738df9e74ee1516d0cfc4a8cd5626da635d01bc633af9d8a76def"],"opposing_claim_ids":[],"text":"Context management includes auto-compaction with a verbatim tail, lossless persisted chat history for export, and latest-wins deduplication of older tool results for the same target."},{"claim_ids":["clm_bfc36574fabb6a845417e597142d0f07c6be8a6cf3ba6020812f19bfd4ec19b0"],"opposing_claim_ids":[],"text":"Project mode lets the agent act as a project lead delegating to a team of subagents (TeamDef presets), with subagents running on isolated history so the parent only receives the final Task result."},{"claim_ids":["clm_ce47e5c2fedfcb09ff4c69ca7391b07f168ee9d1a2b43cef400c6978e78aa6d6"],"opposing_claim_ids":[],"text":"Shell commands run in their own child shell and kill child processes on termination, and denied commands are checked per sub-command to prevent chaining-based bypasses."},{"claim_ids":["clm_ef6bc5e03dbaf197aa74ba4e3ec924b5254b884add5de1b693bd6e815e26b825"],"opposing_claim_ids":[],"text":"The semantic index persists across VS Code restarts, re-indexes incrementally on changed files, and auto-indexes new/modified files via a workspace file watcher; indexing can be fully disabled in settings."}],"claim_ids":["clm_18a92481fcd303acc77449a11fedf537f35e4e4dd2b223dc62ea76b7814d3f74","clm_8a09a8bd0ed738df9e74ee1516d0cfc4a8cd5626da635d01bc633af9d8a76def","clm_bfc36574fabb6a845417e597142d0f07c6be8a6cf3ba6020812f19bfd4ec19b0","clm_ce47e5c2fedfcb09ff4c69ca7391b07f168ee9d1a2b43cef400c6978e78aa6d6","clm_ef6bc5e03dbaf197aa74ba4e3ec924b5254b884add5de1b693bd6e815e26b825"],"created_at":"2026-09-14T02:30:07Z","created_by_operation":"op_6e59abe42c344ec69e5b9f2e53e22ec5","id":"pg_2e8b57deea05519699d66e653f116b57","maturity":"draft","page_type":"source","path":"pages/sources/pawanosman-opencursor-changelog-md-e94886325f76-6e653f116b57.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_220eded85b3158888bad771f96666f6a"],"title":"PawanOsman/OpenCursor/CHANGELOG.md @ e94886325f76","updated_at":"2026-09-14T02:30:07Z","updated_by_operation":"op_6e59abe42c344ec69e5b9f2e53e22ec5"}
