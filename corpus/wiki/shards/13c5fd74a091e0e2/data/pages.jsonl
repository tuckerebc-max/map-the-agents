{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_24bdb411dddfa9489de24ea6b7a5d48de47deb39c609502cfb341ad185bbe47e"],"opposing_claim_ids":[],"text":"Repository development practice: 'pnpm dev' starts Docker containers, the Next.js frontend, docs site, broadcast realtime service, daemon builds, an MCP server, an ngrok tunnel, cron jobs, and the CLI in dev mode."},{"claim_ids":["clm_6474bcc7f0094b6a068b4bc3c88cda8143a315a2d021da68a8c07f2cce6a5a3e"],"opposing_claim_ids":[],"text":"Repository development practice: tests run per workspace (apps/www, packages/shared, packages/daemon, packages/sandbox) via 'pnpm -C <dir> test', with type checking via 'pnpm tsc-check'."},{"claim_ids":["clm_b0418dbf22eebb19e47a0f85e24d9349d18e9432ef3a13cae1fd02785352eb18"],"opposing_claim_ids":[],"text":"Repository development practice: after adding a release-notes entry, contributors must increment RELEASE_NOTES_VERSION in apps/www constants, which triggers the release-notes badge for users."},{"claim_ids":["clm_cab5afd740fc4a66a7deb26c5baa56c673dd1c363aae41a391f54bff86aaef15"],"opposing_claim_ids":[],"text":"Repository development practice: new feature flags are defined in feature-flags-definitions.ts, consumed via a useFeatureFlag hook, and configured on an admin page with global defaults and per-user overrides."}],"claim_ids":["clm_24bdb411dddfa9489de24ea6b7a5d48de47deb39c609502cfb341ad185bbe47e","clm_6474bcc7f0094b6a068b4bc3c88cda8143a315a2d021da68a8c07f2cce6a5a3e","clm_b0418dbf22eebb19e47a0f85e24d9349d18e9432ef3a13cae1fd02785352eb18","clm_cab5afd740fc4a66a7deb26c5baa56c673dd1c363aae41a391f54bff86aaef15"],"created_at":"2026-09-14T03:18:49Z","created_by_operation":"op_38b2d1d5186b4b858829498e3acb4a5e","id":"pg_39a684b6ae935511bacdfb80cccb8877","maturity":"draft","page_type":"source","path":"pages/sources/terragon-labs-terragon-oss-agents-md-83142a17f397-fb80cccb8877.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dd5