ally_checked","schema_version":"1.0","source_ids":[],"title":"stable-lab/mage","updated_at":"2026-09-14T02:42:28Z","updated_by_operation":"op_acb6f3102b0944d5a39e170fe5c6e872"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2e583ea3226e8a9c38b0147e885baffd22ff1425c8cc17f9717bc1acad8afb03"],"opposing_claim_ids":[],"text":"The run harness executes the agent against verilog-eval benchmark instances selectable by regex filter, with repeated runs (n) and sampling parameters such as temperature 0.85 and top_p 0.95."},{"claim_ids":["clm_466d6d1d257d1549b46401599bbc667df42810dd0b30877d7011c4c9052e7f85"],"opposing_claim_ids":[],"text":"Users are told to verify the installed iverilog version is v12 by running 'iverilog -v' and checking the first output line."},{"claim_ids":["clm_583b18d3bff414449d72a328cb17d418fe833a940355daadc43be953b80621f8"],"opposing_claim_ids":[],"text":"The README instructs installing Icarus Verilog 12.0, with an Ubuntu source build of the v12 branch and a macOS Homebrew option."},{"claim_ids":["clm_6a2ca8b9242316e2235fe54dcd8a65247e203adbc122028ea6279d06f846fd76"],"opposing_claim_ids":[],"text":"Pyverilog is installed from a cloned PyHDI repository, with jinja2 and ply installed beforehand and a user-directory setup.py install."},{"claim_ids":["clm_7b3373d9b6efbb2094d5530c5d1eb8e01468b09d26a9f9af68b166944a317a9b"],"opposing_claim_ids":[],"text":"The README gives Verilator installation instructions via apt or by compiling from the verilator GitHub repository."},{"claim_ids":["clm_a152458e5c30a6c40ab871cad788fcc32fc906662e9f6ea14d9b5d6c8f4529aa"],"opposing_claim_ids":[],"text":"Benchmarks come from the NVlabs verilog-eval repository, fetched via a recursive git submodule update."},{"claim_ids":["clm_bf8d3df88448c0192f2623e2a7a5918e5e1050e3fc52f68481328e2c4723ec9b"],"opposing_claim_ids":[],"text":"The run configuration supports verilog_eval_v1 and verilog_eval_v2 benchmark types, and gpt-4o and Claude models are documented as verified."},{"claim_ids":["clm_d28aa5a095152ae0017756a5c42ba441a714a5818f34101a893c853707fc0ff9"],"opposing_claim_ids":[],"text":"MAGE is described as an open-source multi-agent LLM RTL code generator, with an associated arXiv paper (2412.07822)."},{"claim_ids":["clm_d59281c4b0269d88834a92f679a070b2b6b6c03516c2bf8bda839266f1c89160"],"opposing_claim_ids":[],"text":"Runs are launched with 'python tests/test_top_agent.py' and configured via an args_dict with provider, model, filter_instance regex, benchmark type/path, run_identifier, n, temperature, top_p, max_token, and key_cfg_path."},{"claim_ids":["clm_ea662ea45d4b929a4db1ea1b756db1f7a3394c6ee1ad66626dc682472b844ebf"],"opposing_claim_ids":[],"text":"Installation uses a conda environment with Python 3.11 followed by 'pip install .', and cloning may use --recursive to fetch submodules."},{"claim_ids":["clm_ff84c999d2f78db99f83de88505fc7ad74b8f201c0c252c8fbe1ea94a283220e"],"opposing_claim_ids":[],"text":"API keys for OpenAI, Anthropic, or Vertex can be supplied via environment variables or a key.cfg file with a documented format."}],"claim_ids":["clm_2e583ea3226e8a9c38b0147e885baffd22ff1425c8cc17f9717bc1acad8afb03","clm_466d6d1d257d1549b46401599bbc667df42810dd0b30877d7011c4c9052e7f85","clm_583b18d3bff414449d72a328cb17d418fe833a940355daadc43be953b80621f8","clm_6a2ca8b9242316e2235fe54dcd8a65247e203adbc122028ea6279d06f846fd76","clm_7b3373d9b6efbb2094d5530c5d1eb8e01468b09d26a9f9af68b166944a317a9b","clm_a152458e5c30a6c40ab871cad788fcc32fc906662e9f6ea14d9b5d6c8f4529aa","clm_bf8d3df88448c0192f2623e2a7a5918e5e1050e3fc52f68481328e2c4723ec9b","clm_d28aa5a095152ae0017756a5c42ba441a714a5818f34101a893c853707fc0ff9","clm_d59281c4b0269d88834a92f679a070b2b6b6c03516c2bf8bda839266f1c89160","clm_ea662ea45d4b929a4db1ea1b756db1f7a3394c6ee1ad66626dc682472b844ebf","clm_ff84c999d2f78db99f83de88505fc7ad74b8f201c0c252c8fbe1ea94a283220e"],"created_at":"2026-09-14T02:42:28Z","created_by_operation":"op_acb6f3102b0944d5a39e170fe5c6e872","id":"pg_fbd2fed843e751ab933a9a01be3bd5cb","maturity":"draft","page_type":"source","path":"pages/sources/stable-lab-mage-readme-md-90c96366c518-9a01be3bd5cb.md","record_type":"page","review_state":"m