{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5a51678584c3267c7fde2b387461fed4610e33c57e609f0027c750b717f2af25"],"opposing_claim_ids":[],"text":"Repository development practice: CLAUDE.md instructs coding agents to never work in master, use worktrees/branches named with beads issue IDs, never push or merge without explicit user consent, and rebuild minified client JS and the agent tarball after changes."},{"claim_ids":["clm_996a8df9dba4eca51a84d4acdb4a028df67ac4192cd7f8159215debc9adeeceb"],"opposing_claim_ids":[],"text":"Repository development practice: CLAUDE.md imposes context-mode MCP routing rules for contributor agents — curl/wget, WebFetch, and inline HTTP in Bash are blocked in favor of ctx_* tools, with Bash limited to short-output commands."}],"claim_ids":["clm_5a51678584c3267c7fde2b387461fed4610e33c57e609f0027c750b717f2af25","clm_996a8df9dba4eca51a84d4acdb4a028df67ac4192cd7f8159215debc9adeeceb"],"created_at":"2026-09-14T03:34:09Z","created_by_operation":"op_5732d233545b471ba6480ab004877e7a","id":"pg_29bd12f563095ba781daba8a1ceaca03","maturity":"draft","page_type":"source","path":"pages/sources/alpbahadur-49-ide-claude-md-c8bfb5c0a355-ba8a1ceaca03.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_67fad21db9f956db85d29c359ac2c0cc"],"title":"alpbahadur/49-IDE/CLAUDE.md @ c8bfb5c0a355","updated_at":"2026-09-14T03:34:09Z","updated_by_operation":"op_5732d233545b471ba6480ab004877e7a"}
