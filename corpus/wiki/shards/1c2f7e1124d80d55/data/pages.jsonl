{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_35540d822326bd186a94e2b9e4ec20befee2784835956ac7459266ecfc223d0c"],"opposing_claim_ids":[],"text":"A dated case-study document analyzes an LZSS compressor binary, identifying a window-position wrap bug in decompression and a 9-byte instruction-reorder patch verified by MD5 comparison of outputs."},{"claim_ids":["clm_a01152ebcf3907c3e1a9e6f235ada2680a26a6543cced0664d4ae74e29663735"],"opposing_claim_ids":[],"text":"The case study records lessons for the skill: compare known inputs/outputs first, trace circular-buffer wrap-around carefully, and watch for divergent code paths implementing the same operation."}],"claim_ids":["clm_35540d822326bd186a94e2b9e4ec20befee2784835956ac7459266ecfc223d0c","clm_a01152ebcf3907c3e1a9e6f235ada2680a26a6543cced0664d4ae74e29663735"],"created_at":"2026-09-14T03:28:43Z","created_by_operation":"op_e53f2004bc444b618f87e9a14e2680e0","id":"pg_b2fad7bc7b6e515ea46f14c9e8e23a69","maturity":"draft","page_type":"source","path":"pages/sources/2389-research-binary-re-docs-bad-compression-analysis-2026-01-06-md-42-14c9e8e23a69.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d15b9e0507945094a090690f74c00dc6"],"title":"2389-research/binary-re/docs/bad-compression-analysis-2026-01-06.md @ 42aee9063f3f","updated_at":"2026-09-14T03:28:43Z","updated_by_operation":"op_e53f2004bc444b618f87e9a14e2680e0"}
