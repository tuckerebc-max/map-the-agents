,"clm_e73f74de04b51ff8b4812e523848ddc96891b8e2525c65e5ffdf9571fab9e3a3","clm_f813c95272131e65c53f23b495196cc0d6309405c333b362afa41acc979f6f1c"],"created_at":"2026-09-14T02:25:52Z","created_by_operation":"op_6de1ec673f6f4229a627ca0706f85c0e","id":"pg_cf33239edded5de7a1b370990602e1ab","maturity":"draft","page_type":"entity","path":"pages/entities/oooscoos-benzi-70990602e1ab.md","record_type":"page","review_state":"unverified","schema_version":"1.0","source_ids":[],"title":"oooscoos/benzi","updated_at":"2026-09-14T04:57:32Z","updated_by_operation":"op_a85795f84911439cb20fe60032b2b59c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_09d62ac76346861c5250c09f4c03e51ac290af54e49b8f3e48e5fef49a12104a"],"opposing_claim_ids":[],"text":"Analysis depth varies by language: Python is deepest and the only language with runtime traces; execution is local-only and the agent does not browse the web."},{"claim_ids":["clm_1a23c614b449d4d7ea594f5b9c4901b3dae306223e81acfbd5f9654287f1a9bf"],"opposing_claim_ids":[],"text":"Every write passes syntax and semantic gates against the real language parser, and a broken parse auto-reverts the edit."},{"claim_ids":["clm_2645dabe9069d9a47af04ff9a4b5d947712ccec8ab0c7b55981dfa536c477978"],"opposing_claim_ids":[],"text":"The README reports that a SWE-bench Verified run on DeepSeek v4-flash resolved 391/500 (78.2%) at $37.33 total, graded by the official harness in per-instance Docker containers with GitHub/PyPI network access blocked."},{"claim_ids":["clm_4fa935151a36c536fc076b198fa44878e8f837a6733ab14f15f83aee37edac5a"],"opposing_claim_ids":[],"text":"Benzi parses every project file with a tree-sitter-based compiler into a queryable map of symbols, call edges, references, and inheritance before answering questions."},{"claim_ids":["clm_8a40ccbd8d795b49dc352b92bef37fe6849453221580e18684295a9648af8f1a"],"opposing_claim_ids":[],"text":"A runtime tracer hooks every call during execution and overlays observed behavior back onto the static map; a separate markup engine indexes HTML/CSS/DOM-JS including frontend embedded in Python strings."},{"claim_ids":["clm_923c828a6f724954742b410a10c08e973eec6d16e782642e7996cae13bffbb74"],"opposing_claim_ids":[],"text":"The index distinguishes proven edges (with evidence), ambiguous calls (full candidate lists kept), and runtime traces; unresolved calls are classified rather than silently dropped."},{"claim_ids":["clm_b369d52b3d01f40d769868025080a644495ca673efca8cbd0c057038ab74b1d9"],"opposing_claim_ids":[],"text":"A 24-bug cross-harness comparison reports Benzi reading the fewest source lines (9,125 with Sonnet vs 20,704 for Claude Code) and roughly a cent per bug on DeepSeek, while Claude Code is said to reach $0.18 per step on harder bugs."},{"claim_ids":["clm_b645e3c0662ca2a5a9fdf5ddcf4c9b7e0430bd63ddc001e63e480e2054670003"],"opposing_claim_ids":[],"text":"Tree-sitter is described as the only real dependency, with each of ten supported languages implemented as a grammar plugin."},{"claim_ids":["clm_ccd64849fbb044bff936a20f20010f801c1510cad2591c1ca8533b0ffd5be5e2"],"opposing_claim_ids":[],"text":"The agent exposes 35+ tools; a sample of 16 includes get_callers, call_tree, trace_path, backflow, profile, skim_source, rollback_edit, and upgrade_to_pro."},{"claim_ids":["clm_d2036f108d0d212b3105b4a9f1c16632b19a6e364662b1b96e03f6ef2ada86c2"],"opposing_claim_ids":[],"text":"Durable per-repo facts persist across restarts, so learned conventions are not re-derived each session."},{"claim_ids":["clm_e73f74de04b51ff8b4812e523848ddc96891b8e2525c65e5ffdf9571fab9e3a3"],"opposing_claim_ids":[],"text":"Benzi is available as a browser demo (read-only, any public GitHub repo) and as a VS Code extension with edit access; there is no headless or CLI mode yet."},{"claim_ids":["clm_f813c95272131e65c53f23b495196cc0d6309405c333b362afa41acc979f6f1c"],"opposing_claim_ids":[],"text":"The project appears to be actively developed and free to use, with a live demo site, benchmark report, and VS Code Marketplace listing referenced from the README."}],"claim_ids":["clm_09d62ac76346861c5250c09f4c03e51ac290af54e49b8f3e48e5fef49a12104a","clm_1a23c614b449d4d7ea594f5b9c4901b3dae306223e81acfbd5f9654287f1a9bf","clm_2645dabe9069d9a47af04ff9a4b5d947712ccec8ab0c7b55981dfa536c477978","clm_4fa935151a36c536fc076b198fa44878e8f837a6733ab14f15f83aee37edac5a","clm_8a40ccbd8d795b49dc352b92bef37fe6849453221580e18684295a9648af8f1a","clm_923c828a6f724954742b410a10c08e973eec6d16e782642e7996cae13bffbb74","clm_b369d52b3d01f40d769868025080a644495ca673efca8cbd0c057038ab74b1d9","clm_b645e3c0662ca