{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_02ed3a587d54deb76323996be0048336771ceffddf99746b3ba0a1542308a736"],"opposing_claim_ids":[],"text":"A default workflow called the Ali Workflow Builder is included for creating workflows interactively."},{"claim_ids":["clm_249eeeac9eba1d03a62369358977607d6b66adc9d67b3b092d046224a49559f4"],"opposing_claim_ids":[],"text":"Workflows can range from fully interactive to fully autonomous, with documentation on orchestration patterns available."},{"claim_ids":["clm_3b26b58b9f3b782600432c029439547e23c707564aa8938fc07907f140c99dd5"],"opposing_claim_ids":[],"text":"It spawns AI coding engines via CLI using their headless scripting mode, passing appropriate arguments and flags to control agents."},{"claim_ids":["clm_555140827587fff4cf2f2fbd1f97e8097be6721ac071d87a66c5ce75a27fd81f"],"opposing_claim_ids":[],"text":"The tool integrates multiple AI engines, including Claude Code, Codex, Cursor, CCR (Claude Code Router), OpenCode CLI, Auggie CLI, and Mistral Vibe, per contributor notes."},{"claim_ids":["clm_a1ff254684f08d396d4166cc00df2d7580bb4573e42888f99faed78e113632e7"],"opposing_claim_ids":[],"text":"The tool is distributed as an npm package installable globally via 'npm i -g codemachine'."},{"claim_ids":["clm_a43a6ec694dac0a968e6b1d5048359f0210f49d8e232b1587396637aa69123ce"],"opposing_claim_ids":[],"text":"Multiple agents can run in parallel on different parts of a workflow, and workflows can run for hours or days with persistence handled by the tool."},{"claim_ids":["clm_c02fb2a5b3c6ef147e2942a46f3df2a10a0682f70f762da2d3a8c531368808d7"],"opposing_claim_ids":[],"text":"The product supports multi-agent orchestration where different agents are assigned to different tasks, can communicate with each other, and collaborate on decisions."},{"claim_ids":["clm_d04e624bfc9c167cf84eb4aaa4795766ead5a29202f006be6e751c1f5b618704"],"opposing_claim_ids":[],"text":"CodeMachine is an orchestration layer that runs AI coding CLIs through structured workflows, handling execution, context passing, and agent coordination."},{"claim_ids":["clm_d363d1e3747867cce2de1339127965e59e4386db5360da41b31df456fb67b7a2"],"opposing_claim_ids":[],"text":"The tool centralizes prompts and manages dynamic context, controlling what each agent sees at each workflow step."}],"claim_ids":["clm_02ed3a587d54deb76323996be0048336771ceffddf99746b3ba0a1542308a736","clm_249eeeac9eba1d03a62369358977607d6b66adc9d67b3b092d046224a49559f4","clm_3b26b58b9f3b782600432c029439547e23c707564aa8938fc07907f140c99dd5","clm_555140827587fff4cf2f2fbd1f97e8097be6721ac071d87a66c5ce75a27fd81f","clm_a1ff254684f08d396d4166cc00df2d7580bb4573e42888f99faed78e113632e7","clm_a43a6ec694dac0a968e6b1d5048359f0210f49d8e232b1587396637aa69123ce","clm_c02fb2a5b3c6ef147e2942a46f3df2a10a0682f70f762da2d3a8c531368808d7","clm_d04e624bfc9c167cf84eb4aaa4795766ead5a29202f006be6e751c1f5b618704","clm_d363d1e3747867cce2de1339127965e59e4386db5360da41b31df456fb67b7a2"],"created_at":"2026-09-14T02:20:29Z","created_by_operation":"op_775dc613c62b41ce9c25019f09585194","id":"pg_2cbbce0738a557898146cdd8cd977920","maturity":"draft","page_type":"source","path":"pages/sources/moazbuilds-codemachine-cli-readme-md-572def63eb80-cdd8cd977920.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5a958b38334a54ceb48cadd907d61d85"],"title":"moazbuilds/CodeMachine-CLI/README.md @ 572def63eb80","updated_at":"2026-09-14T02:20:29Z","updated_by_operation":"op_775dc613c62b41ce9c25019f09585194"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_ad702bf091eecd71724945e3d755d1f97e767b02ac117e5b25ec2f14b75675d5"],"opposing_claim_ids":[],"text":"Repository development practice: the codebase is organized into src/infra, src/cli/tui, src/workflows, src/agents, src/shared, plus config, prompts, and templates directories."},{"claim_ids":["clm_e6614bf551062484e817a6be782feafb94bbd4578253763937a66b90da4f4464"],"opposing_claim_ids":[],"text":"Repository development practice: contributors need Bun 1.3+, install with 'bun install', start with 'bun dev', and run 'bun run lint' and 'bun run typecheck' before submitting PRs."},{"claim_ids":["clm_f830f30b89df1d9b085acf318be0ef8df60bda435f63d197ed64bb58ac36394a"],"opposing_claim_ids":[],"text":"Repository development practice: UI and feature PRs require prior team review or will likely be refused; PRs should be focused on one feature or fix."}],"claim_ids":["clm_ad702bf091eecd71724945e3d755d1f97e767b02ac117e5b25ec2f14b75675d5","clm_e6614bf551062484e817a6be782feafb94bbd4578253763937a66b90da4f4464","clm_f830f30b89df1d9b085acf318be0ef8df60bda435f63d197ed64bb58ac36394a"],"created_at":"2026-09-14T02:20:29Z","created_by_operation":"op_775dc613c62b41ce9c25019f09585194","id":"pg_7a77e202e7aa55a7adfaf1d89cb1ee8d","maturity":"draft","page_type":"source","path":"pages/sources/moazbuilds-codemachine-cli-contributing-md-572def63eb80-f1d89cb1ee8d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ef742df4a3a35fcf934ac323d3e88593"],"title":"moazbuilds/CodeMachine-CLI/CONTRIBUTING.md @ 572def63eb80","updated_at":"2026-09-14T02:20:29Z","updated_by_operation":"op_775dc613c62b41ce9c25019f09585194"}
