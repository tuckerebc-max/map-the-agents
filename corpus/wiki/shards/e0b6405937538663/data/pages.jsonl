06a86dcef5e"],"created_at":"2026-09-14T04:23:42Z","created_by_operation":"op_65bb8c259863400b9f3c134241317dd8","id":"pg_166ec1aefe9f53b9a5e1d51ff71b5ec1","maturity":"draft","page_type":"entity","path":"pages/entities/strands-agents-harness-sdk-d51ff71b5ec1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"strands-agents/harness-sdk","updated_at":"2026-09-14T04:23:42Z","updated_by_operation":"op_65bb8c259863400b9f3c134241317dd8"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:23:42Z","created_by_operation":"op_65bb8c259863400b9f3c134241317dd8","id":"pg_2eaba35a5c845543bbc9e3df2e83036e","maturity":"draft","page_type":"source","path":"pages/sources/strands-agents-harness-sdk-site-src-content-docs-user-guide-shell-conf-e3df2e83036e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_22ae50c91a70506696a99924b2d6299c"],"title":"strands-agents/harness-sdk/site/src/content/docs/user-guide/shell/configuration.mdx @ 08ed4cfd3eb4","updated_at":"2026-09-14T04:23:42Z","updated_by_operation":"op_65bb8c259863400b9f3c134241317dd8"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3a98356aa9a0390d66d4c63dd8d9fa696be1cfbbeef5b30500eb0b712d42d176"],"opposing_claim_ids":[],"text":"The Python SDK requires Python 3.10+ and is installed via pip as strands-agents (with strands-agents-tools); the TypeScript SDK requires Node.js 22+ and installs as @strands-agents/sdk via npm."},{"claim_ids":["clm_46a8396e4030180a315d9c65774de6117a253a280d6d23af1fbd8521578fbedc"],"opposing_claim_ids":[],"text":"Repository development practice: Python SDK tests and formatting run via hatch test and hatch fmt in strands-py; the TypeScript SDK uses npm ci, npm run build, and npm test; the docs site runs with npm install and npm run dev in site/; git operations are done from the repo root."},{"claim_ids":["clm_4bd8d53a4df2a3ec99c5caa037f41288f05c956b7434d534e7e8e4669fe27945"],"opposing_claim_ids":[],"text":"Both SDKs default to the Amazon Bedrock model provider, requiring AWS credentials and model access for Claude Sonnet; other providers such as Anthropic, OpenAI, Gemini, and Ollama are covered in the quickstart."},{"claim_ids":["clm_7e4f4ea495565e041471b73b7d868344c1a26582855938dd2fa51fd992be0330"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are guided by CONTRIBUTING.md covering bug reports, development setup, pull requests, code of conduct, and security issue reporting; doc PRs are welcome alongside code changes."},{"claim_ids":["clm_ae57a5994f8bd2176772555ecdf0981db5d22912e45b959a8abfa1862f9a4947"],"opposing_claim_ids":[],"text":"The SDK advertises built-in lifecycle controls (turn limits, token budgets, cancellation, stop reasons), tools, structured output, MCP, multi-agent patterns, memory, sessions, model portability, streaming, guardrails, tracing, and evals."},{"claim_ids":["clm_b075c076ac554db140a78adcf2bd371507ad8240b1d94d004525cb90d964d5d7"],"opposing_claim_ids":[],"text":"The Python API exposes an Agent class constructed with a tools list and invoked by calling it with a prompt string; the TypeScript API exposes an Agent with an awaitable invoke(prompt) method."},{"claim_ids":["clm_e0599e473447529d8f7f81d8e0075ac5edc80ef89a63fe309fef74685d4b5d1f"],"opposing_claim_ids":[],"text":"Strands Agents is an open-source SDK for building and running AI agents in Python and TypeScript, positioned as a replacement for a hand-rolled agent loop that runs in the user's process with no hosted control plane."},{"claim_ids":["clm_fa43c72c94be5d058e1fd1403c454b534cd48de3fdb1317a5602006a86dcef5e"],"opposing_claim_ids":[],"text":"The monorepo contains strands-py (Python SDK), strands-ts (TypeScript SDK), site (Astro/Starlight documentation site), and team (governance and cross-SDK process docs including designs/ proposals)."}],"claim_ids":["clm_3a98356aa9a0390d66d4c63dd8d9fa696be1cfbbeef5b30500eb0b712d42d176","clm_46a8396e4030180a315d9c65774de6117a253a280d6d23af1fbd8521578fbedc","clm_4bd8d53a4df2a3ec99c5caa037f41288f05c956b7434d534e7e8e4669fe27945","clm_7e4f4ea495565e041471b73b7d868344c1a26582855938dd2fa51fd992be0330","clm_ae57a5994f8bd2176772555ecdf0981db5d22912e45b959a8abfa1862f9a4947","clm_b075c076ac554db140a78adcf2bd371507ad8240b1d94d004525cb90d964d5d7","clm_e0599e473447529d8f7f81d8e0075ac5edc80ef89a63fe309fef74685d4b5d1f","clm_fa43c72c94be5d058e1fd1403c454b534cd48de3fdb1317a5602006a86dcef5e"],"created_at":"2026-09-14T04:23:42Z","created_by_operation":"op_65bb8c259863400b9f3c134241317dd8","id":"pg_578b1698b38b552388e8a337d29f90c2","maturity":"draft","page_type":"source","path":"pages/sources/strands-agents-harness-sdk-readme-md-08ed4cfd3eb4-a337d29f90c2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7e796086bcac5249b6de15675759c2b8"],"title":"strands-agents/harness-sdk/README.md @ 08ed4cfd3eb4","updated_at":"2026-09-14T04:23:42Z","updated_by_operation":"op_65bb8c259863400b9f3c134241317dd8"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:23:42Z","created_by_operation":"op_65bb8c259863400b9f3c134241317dd8","id":"pg_5a309927c70a531ba0773f5750a6756c","maturity":"draft","page_type":"source","path":"pages/sources/strands-agents-harness-sdk-strands-py-src-strands-agent-state-py-08ed4-3f5750a6756c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b94cc77f13f156309041ac421c084adb"],"title":"strands-agents/harness-sdk/strands-py/src/strands/agent/state.py @ 08ed4cfd3eb4","updated_at":"2026-09-14T04:23:42Z","updated_by_operation":"op_65bb8c259863400b9f3c134241317dd8"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_646bd25c7f63e549dce0ac55906b43a46502b798d23189b28a3844207e9c9fd2"],"opposing_claim_ids":[],"text":"The agent loop invokes the model, executes requested tools, feeds results back, and repeats until a final response; tool failures are returned to the model as error results rather than terminating the loop, and conversation history accumulates across iterations with a conversation manager keeping it within the context window."}],"claim_ids":["clm_646bd25c7f63e549dce0ac55906b43a46502b798d23189b28a3844207e9c9fd2"],"created_at":"2026-09-14T04:23:42Z","created_by_operation":"op_65bb8c259863400b9f3c134241317dd8","id":"pg_7204fd41180659bd96a56467c1e1b430","maturity":"draft","page_type":"source","path":"pages/sources/strands-agents-harness-sdk-site-src-content-docs-user-guide-concepts-a-6467c1e1b430.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1967c375194651cfb5f12e5b6f29c0c0"],"title":"strands-agents/harness-sdk/site/src/content/docs/user-guide/concepts/agents/agent-loop.mdx @ 08ed4cfd3eb4","updated_at":"2026-09-14T04:23:42Z","updated_by_operation":"op_65bb8c259863400b9f3c134241317dd8"}
