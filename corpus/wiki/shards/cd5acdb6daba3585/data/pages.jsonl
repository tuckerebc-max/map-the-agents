4a2","clm_c0566dab291991e25532c6b552c071fd876eb1e22ab3a9b3fa70101d7287e1c1","clm_d3915434ca37350a01dd12891fc7cf3cc2da35a40846decc6a922a366962f851","clm_f2ee48ade199175ce7a65363c17f2a84e0440065382924263e8e339f0e193de8","clm_fc2e3d1ae7a9eb33814956c7638799d84107c262fe66a3718b7be1b250a62f2f"],"created_at":"2026-09-14T02:00:47Z","created_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe","id":"pg_39071face62150aebccd1095d277b572","maturity":"draft","page_type":"entity","path":"pages/entities/echovic-blade-code-1095d277b572.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"echovic/blade-code","updated_at":"2026-09-14T02:00:47Z","updated_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1e9b4a1f8073d7f2ea1b51736a8a23674daacae454333973dc5e4ea907efed5d"],"opposing_claim_ids":[],"text":"The runtime offers four permission modes (default, autoEdit, plan, yolo); Shift+Tab cycles the first three in the TUI, while yolo requires an explicit command, launch argument, or setting."},{"claim_ids":["clm_688557c894870f0a0af1d0b7298c49ddf2b214c57287e5eacd675ecb1a47a8b6"],"opposing_claim_ids":[],"text":"A maxTurns setting caps model rounds (0 disables, -1 unlimited, N>0 limits); recovery paths such as output-length correction, Stop hooks, and mid-turn input cannot bypass it, and non-interactive callers without a continuation callback receive max_turns_exceeded."},{"claim_ids":["clm_b6afab1e67a0dbdef4bb09a92a7b3dad69c815b14b93c8d8e84b2fe246e4f4a2"],"opposing_claim_ids":[],"text":"Permission rules use Tool(param:value) syntax with picomatch * and ** wildcards, evaluated in order deny > allow > ask > default (ask), covering file paths, Bash commands, and WebFetch/WebSearch URL patterns."},{"claim_ids":["clm_d3915434ca37350a01dd12891fc7cf3cc2da35a40846decc6a922a366962f851"],"opposing_claim_ids":[],"text":"When a rule resolves to ask, a confirmation dialog offers Once/Session/Project/Deny; Session authorizations live only in runtime memory and expire with the session, while Project writes the rule to .blade/settings.local.json."}],"claim_ids":["clm_1e9b4a1f8073d7f2ea1b51736a8a23674daacae454333973dc5e4ea907efed5d","clm_688557c894870f0a0af1d0b7298c49ddf2b214c57287e5eacd675ecb1a47a8b6","clm_b6afab1e67a0dbdef4bb09a92a7b3dad69c815b14b93c8d8e84b2fe246e4f4a2","clm_d3915434ca37350a01dd12891fc7cf3cc2da35a40846decc6a922a366962f851"],"created_at":"2026-09-14T02:00:47Z","created_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe","id":"pg_4724b15bded252b79c7256f3146ea6d8","maturity":"draft","page_type":"source","path":"pages/sources/echovic-blade-code-docs-en-configuration-permissions-md-8917e4e0ef61-56f3146ea6d8.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_df0dc25607b7544aa3ee6644fc12c916"],"title":"echoVic/blade-code/docs/en/configuration/permissions.md @ 8917e4e0ef61","updated_at":"2026-09-14T02:00:47Z","updated_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_097d52dc731c2067688fce6326641425aee963780a6113d91f017f50460fc29b"],"opposing_claim_ids":[],"text":"Auto Memory persists project knowledge across sessions: the first 200 lines of MEMORY.md are injected into the system prompt at session start, knowledge is saved via MemoryWrite, and read on demand via MemoryRead."},{"claim_ids":["clm_54af29809cd6886c86c2654963fe36ffaa75e34b4d862fbcb7bdf9d231fc959c"],"opposing_claim_ids":[],"text":"Full compaction extracts explicitly marked entries (remember:, convention:, lesson:, fixed:) into topic files, capped at 20 entries, 500 code points each, 8,000 total, with deduplication, in-process and file locks, atomic replacement, and 0600 permissions."},{"claim_ids":["clm_94b1a84daf77ef3fbb376bb8c700084eb42cd3f20287f81060ee0ad603def074"],"opposing_claim_ids":[],"text":"Memory safety mechanisms include rejecting credential-like content (password, token, sk-*, AWS key IDs, PEM headers), forbidding '..' or '/' in topic names, and content-free projections so TUI/Web/ACP/Headless receive only outcome, entry count, and topic names."},{"claim_ids":["clm_976351d3841cf1ad125995382e27520cf79dcf3f83d8ece9dde30b8470177012"],"opposing_claim_ids":[],"text":"Memory files live under ~/.blade/projects/{escaped-path}/memory/ with per-project isolation, containing a MEMORY.md index plus topic files such as patterns.md, debugging.md, and architecture.md."},{"claim_ids":["clm_c0566dab291991e25532c6b552c071fd876eb1e22ab3a9b3fa70101d7287e1c1"],"opposing_claim_ids":[],"text":"Auto Memory can be disabled with BLADE_AUTO_MEMORY=0; the documented default is enabled (BLADE_AUTO_MEMORY=1)."}],"claim_ids":["clm_097d52dc731c2067688fce6326641425aee963780a6113d91f017f50460fc29b","clm_54af29809cd6886c86c2654963fe36ffaa75e34b4d862fbcb7bdf9d231fc959c","clm_94b1a84daf77ef3fbb376bb8c700084eb42cd3f20287f81060ee0ad603def074","clm_976351d3841cf1ad125995382e27520cf79dcf3f83d8ece9dde30b8470177012","clm_c0566dab291991e25532c6b552c071fd876eb1e22ab3a9b3fa70101d7287e1c1"],"created_at":"2026-09-14T02:00:47Z","created_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe","id":"pg_ad42589d2dd657f4929b35882f6bbb9f","maturity":"draft","page_type":"source","path":"pages/sources/echovic-blade-code-docs-en-guides-memory-md-8917e4e0ef61-35882f6bbb9f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_367e908a67f15cbf9b8c3462e4d9ac24"],"title":"echoVic/blade-code/docs/en/guides/memory.md @ 8917e4e0ef61","updated_at":"2026-09-14T02:00:47Z","updated_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_fc2e3d1ae7a9eb33814956c7638799d84107c262fe66a3718b7be1b250a62f2f"],"opposing_claim_ids":[],"text":"Skills are described as a dynamic prompt extension mechanism that lets the AI automatically invoke specialized capabilities based on user requests."}],"claim_ids":["clm_fc2e3d1ae7a9eb33814956c7638799d84107c262fe66a3718b7be1b250a62f2f"],"created_at":"2026-09-14T02:00:47Z","created_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe","id":"pg_b70edaf7b5435fbaaef310145ca43607","maturity":"draft","page_type":"source","path":"pages/sources/echovic-blade-code-docs-guides-skills-md-8917e4e0ef61-10145ca43607.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dbf6e0af71025fb5bbbbcf8d6c712565"],"title":"echoVic/blade-code/docs/guides/skills.md @ 8917e4e0ef61","updated_at":"2026-09-14T02:00:47Z","updated_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_31614ee8d45f114e1f5cfd704bfde4cf8aff960ddd190bad2d3339953db9b9e9"],"opposing_claim_ids":[],"text":"The product ships as an interactive CLI ('blade'), a Web UI ('blade web'), a headless HTTP server ('blade serve'), non-interactive modes '--headless' with JSONL output, and a single-turn '--print' mode."},{"claim_ids":["clm_56362f1b1d86421c033df958698df75f390bad0c74f09e68a7484887539641ba"],"opposing_claim_ids":[],"text":"In-session slash commands include /model add and /model switch, /cost, /compact, /btw for side questions, /memory list, /tasks, and /goal to start Goal mode."},{"claim_ids":["clm_8d60816fe7a3c7c586d50d095029cd8d434adea918445aa4b9662b93ee352a5d"],"opposing_claim_ids":[],"text":"The repository layout places the agent core and execution loop in packages/cli/src/agent, the pi-ai adapter in services/pi, a TypeBox-based tool system, a Hono web server, and a React+Vite web UI."},{"claim_ids":["clm_9dc05de35934eee74b658c016c9fba0b0203167a8f5ae3bc948454c1814ce0c9"],"opposing_claim_ids":[],"text":"The runtime uses the pi-ai library to unify 38+ model providers (OpenAI, Anthropic, DeepSeek, Google, Bedrock) with model metadata fetched dynamically from the pi-ai catalog."},{"claim_ids":["clm_f2ee48ade199175ce7a65363c17f2a84e0440065382924263e8e339f0e193de8"],"opposing_claim_ids":[],"text":"Repository development practice: contributors clone the repo and run 'bun install && bun run dev' to develop locally, and a CONTRIBUTING.md guide is referenced."}],"claim_ids":["clm_31614ee8d45f114e1f5cfd704bfde4cf8aff960ddd190bad2d3339953db9b9e9","clm_56362f1b1d86421c033df958698df75f390bad0c74f09e68a7484887539641ba","clm_8d60816fe7a3c7c586d50d095029cd8d434adea918445aa4b9662b93ee352a5d","clm_9dc05de35934eee74b658c016c9fba0b0203167a8f5ae3bc948454c1814ce0c9","clm_f2ee48ade199175ce7a65363c17f2a84e0440065382924263e8e339f0e193de8"],"created_at":"2026-09-14T02:00:47Z","created_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe","id":"pg_d01c02b10d895f4690afe0b6b1de7bc6","maturity":"draft","page_type":"source","path":"pages/sources/echovic-blade-code-readme-md-8917e4e0ef61-e0b6b1de7bc6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2b5525f8934e5d8b945a1f1bfec523ef"],"title":"echoVic/blade-code/README.md @ 8917e4e0ef61","updated_at":"2026-09-14T02:00:47Z","updated_by_operation":"op_d1d1df53de7d4ab4906945f62e3560fe"}
