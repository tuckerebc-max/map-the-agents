{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1c18b11fd6338e5e504d71a7f14cec90a4b68d0a5c08288fc9707c21da1246a4"],"opposing_claim_ids":[],"text":"Users access Codel through a web UI at localhost:3000 after running the Docker image with port 3000 mapped to 8080."},{"claim_ids":["clm_25361fec5631fe529025b1f554ecee245f266b11a53756eac5aff8fdbf3d0c63"],"opposing_claim_ids":[],"text":"The backend appears to be written in Go, since the OpenAI model list is referenced via the go-openai Go package and development requires golang."},{"claim_ids":["clm_368f4041d0045a98d84702e22fd9ee75cbdcf46c440caf3fb24becc4fc05495f"],"opposing_claim_ids":[],"text":"All history commands and their outputs are saved in a PostgreSQL database."},{"claim_ids":["clm_839efc5eac60d8e32466e2360eed23358893308048a5ee7661847ef8ea23290a"],"opposing_claim_ids":[],"text":"The product claims to run everything inside a sandboxed Docker environment for security."},{"claim_ids":["clm_a6bd7b6e1e50eb0a4ff979a89c06d27b95cded1688a0142a0781434e17ba684a"],"opposing_claim_ids":[],"text":"The product supports OpenAI models (default gpt-4-0125-preview) and locally hosted Ollama models, selected via environment variables including optional custom server URLs."},{"claim_ids":["clm_b79c2d540c5df10d202b04e44e934e10c46e5d8397852159a4a223bb51ac25ec"],"opposing_claim_ids":[],"text":"Codel is described as a fully autonomous AI agent that performs complicated tasks and projects using a terminal, browser, and editor."},{"claim_ids":["clm_d0dbc240606b08bd7ee8eade7ffd024adac789086fdffa94b85d170e7653d200"],"opposing_claim_ids":[],"text":"The product includes a built-in browser for fetching up-to-date web information and a built-in text editor to view modified files in the browser."},{"claim_ids":["clm_dafc022f8b570e01bf79715b9e400d1a8bdf6d63790ca0c6fb9c85fff14f366b"],"opposing_claim_ids":[],"text":"The recommended deployment is a pre-built Docker image from GitHub Container Registry, run with the Docker socket mounted into the container."},{"claim_ids":["clm_dead2bf3dca191353b82e6c06b75df1d69f89af89a9f18485c33422fb5f2df84"],"opposing_claim_ids":[],"text":"The agent automatically detects the next step of a task and executes it, and can pick a Docker image automatically based on the user's task."},{"claim_ids":["clm_e7e06a8534fe79bb57799ed2d04ff6284c46ebbb7b4f2c5542025e650b6c0afc"],"opposing_claim_ids":[],"text":"The project credits two arXiv papers, the Devin announcement, the go-rod browser-automation library, and JsonGenius as inspirations or dependencies."}],"claim_ids":["clm_1c18b11fd6338e5e504d71a7f14cec90a4b68d0a5c08288fc9707c21da1246a4","clm_25361fec5631fe529025b1f554ecee245f266b11a53756eac5aff8fdbf3d0c63","clm_368f4041d0045a98d84702e22fd9ee75cbdcf46c440caf3fb24becc4fc05495f","clm_839efc5eac60d8e32466e2360eed23358893308048a5ee7661847ef8ea23290a","clm_a6bd7b6e1e50eb0a4ff979a89c06d27b95cded1688a0142a0781434e17ba684a","clm_b79c2d540c5df10d202b04e44e934e10c46e5d8397852159a4a223bb51ac25ec","clm_d0dbc240606b08bd7ee8eade7ffd024adac789086fdffa94b85d170e7653d200","clm_dafc022f8b570e01bf79715b9e400d1a8bdf6d63790ca0c6fb9c85fff14f366b","clm_dead2bf3dca191353b82e6c06b75df1d69f89af89a9f18485c33422fb5f2df84","clm_e7e06a8534fe79bb57799ed2d04ff6284c46ebbb7b4f2c5542025e650b6c0afc"],"created_at":"2026-09-14T02:38:52Z","created_by_operation":"op_294a241a502346fcbbb4f0280d65eae9","id":"pg_0dbec26ad9f153debaf5b901cad3d36f","maturity":"draft","page_type":"source","path":"pages/sources/semanser-codel-readme-md-fe1e846c9e04-b901cad3d36f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b7e3ab8d15805a7596da169edf499cb4"],"title":"semanser/codel/README.md @ fe1e846c9e04","updated_at":"2026-09-14T02:38:52Z","updated_by_operation":"op_294a241a502346fcbbb4f0280d65eae9"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_195c79988df5c73ee518bbb2fa0dc62a136a817846d08eb70933c659cb3f609d"],"opposing_claim_ids":[],"text":"Repository development practice: contributors need golang, nodejs, docker, and postgresql; they copy .env.example files for backend and frontend, run 'go run .' in backend, and use 'yarn' then 'yarn dev' in frontend."},{"claim_ids":["clm_25361fec5631fe529025b1f554ecee245f266b11a53756eac5aff8fdbf3d0c63"],"opposing_claim_ids":[],"text":"The backend appears to be written in Go, since the OpenAI model list is referenced via the go-openai Go package and development requires golang."},{"claim_ids":["clm_432c46a1516460a0a88f397f8d18bfe7da13b338d494b2ddfece6f03403fe7a3"],"opposing_claim_ids":[],"text":"Repository development practice: the frontend expects VITE_API_URL without a URL scheme (e.g. localhost:8080, not http://localhost:8080), and backend optionally takes PORT (default 8080) and DATABASE_URL."},{"claim_ids":["clm_c23581621ffc9beba7d5a02ab9bb11a29725159cadee817a948735d204eb9ed4"],"opposing_claim_ids":[],"text":"The backend exposes a GraphQL playground, indicated by the successful-start message pointing to http://localhost:<port>/playground."}],"claim_ids":["clm_195c79988df5c73ee518bbb2fa0dc62a136a817846d08eb70933c659cb3f609d","clm_25361fec5631fe529025b1f554ecee245f266b11a53756eac5aff8fdbf3d0c63","clm_432c46a1516460a0a88f397f8d18bfe7da13b338d494b2ddfece6f03403fe7a3","clm_c23581621ffc9beba7d5a02ab9bb11a29725159cadee817a948735d204eb9ed4"],"created_at":"2026-09-14T02:38:52Z","created_by_operation":"op_294a241a502346fcbbb4f0280d65eae9","id":"pg_5d5dd0a11b965180bdd8ac7df5535c71","maturity":"draft","page_type":"source","path":"pages/sources/semanser-codel-development-md-fe1e846c9e04-ac7df5535c71.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_600d8a8dc7a1555d95256bd17bf81dab"],"title":"semanser/codel/DEVELOPMENT.md @ fe1e846c9e04","updated_at":"2026-09-14T02:38:52Z","updated_by_operation":"op_294a241a502346fcbbb4f0280d65eae9"}
