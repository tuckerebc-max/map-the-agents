{"access":"public","created_at":"2026-09-14T03:39:38Z","created_by_operation":"op_162cafdec75f4d0ba4c9e50992162cff","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8d557d7446b3445b1ad5bb33ee5eb7c151a6c45743052d9ed9b3abbb94b72335","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"butttons/dora@f4edb8fd349e snapshot f6d9ac8d861f83d6","timeframe":null},"slice_ids":["slc_0c7228e4d018823b256c4a62c0fec11317129604a714abf2c2ed8f3867fa30ba","slc_2425093b5ff1754788a152895f6ce60e3678a2ddb5077f0cb917b33d3236d37a","slc_7b5b17d04ff410344488f6a9821ec24c51670e778eed6b383b5f56830cfbc705","slc_7f3d8ac4dee7a6d552ebd8a18dc3eef8d3e937be2eb431163a659499837ad2b8","slc_fe473397f7336ed220410fb21d6447630fd9ef70f15de08ac9b143632f1da00c"],"source_ids":["src_10833c0aa20554bd99c20c03e8eb03ea"],"text":"Besides prebuilt binaries for macOS ARM, macOS Intel, and Linux x64, dora can be installed via npm using Bun ('bun install -g @butttons/dora').","updated_at":"2026-09-14T03:39:38Z","updated_by_operation":"op_162cafdec75f4d0ba4c9e50992162cff"}
{"access":"public","created_at":"2026-09-14T03:39:38Z","created_by_operation":"op_162cafdec75f4d0ba4c9e50992162cff","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8e919bf4b9d9b9ea868e5d50e32d0d09af50c686a99106ea5dde81f9ab303a42","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"butttons/dora@f4edb8fd349e snapshot f6d9ac8d861f83d6","timeframe":null},"slice_ids":["slc_aaa2ee48c0078cb42df1a45e00ddf5731196e6aee20971cfff93c1efcf5f141b"],"source_ids":["src_10833c0aa20554bd99c20c03e8eb03ea"],"text":"dora is a CLI that turns a SCIP index into a queryable SQLite database, giving AI agents structured answers about a codebase instead of grepping files and reading imports.","updated_at":"2026-09-14T03:39:38Z","updated_by_operation":"op_162cafdec75f4d0ba4c9e50992162cff"}
{"access":"public","created_at":"2026-09-14T03:39:38Z","created_by_operation":"op_162cafdec75f4d0ba4c9e50992162cff","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9d28b22943393267a15dc812adabd93cf55e44a24e944f47405e9a0b0ffca1b9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"butttons/dora@f4edb8fd349e snapshot f6d9ac8d861f83d6","timeframe":null},"slice_ids":["slc_3480f8446ec5ddd0f8dfbc865250a3071e6d7beae390a67981348fae24f03d93","slc_e3a86ad5299998928ca6546e1d77e7a50e7f699dd4d2c004f63e8c96f8508419"],"source_ids":["src_10833c0aa20554bd99c20c03e8eb03ea"],"text":"The tool has two layers: a SCIP layer that runs a configured indexer, parses the resulting protobuf, and loads symbols, references, and file dependencies into SQLite; and a tree-sitter layer that parses source on demand via WebAssembly grammars for things SCIP doesn't cover.","updated_at":"2026-09-14T03:39:38Z","updated_by_operation":"op_162cafdec75f4d0ba4c9e50992162cff"}
