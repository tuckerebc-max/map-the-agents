{"access":"public","created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_367ea2af261c8f52680fdfb981124361c6ced9fbf1ce390fc00f91e4c1cddcd6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pingdotgg/t3code@66e39ca2aabd snapshot 9b65991334d57d26","timeframe":null},"slice_ids":["slc_072cd86cb16dcd466101f7634d5a636e5606f9002ba5794c1e1d0f5ffdca087c","slc_d315ebb8c5f67875670ecb8012246ab68470821c9533d23598a9179af07b0540","slc_e8b465a9c903096fd5e5b02062f9aba85006e634109066102b2b2e3ff6e320bc"],"source_ids":["src_13b626322380593d98ae2b47f7da50de"],"text":"Running `npx t3@latest` launches the T3 Code backend on the local machine plus a local web app for controlling agents; a `--help` flag exposes the full CLI reference.","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
{"access":"public","created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_434357f4a42766d3350f3bc159773965380f148534972aebbff6fd38da314547","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"pingdotgg/t3code@66e39ca2aabd snapshot 9b65991334d57d26","timeframe":null},"slice_ids":["slc_eb16954ad3d9afb25c16e5dd22f630afe48edaffdabc4732aa7e2cca6f6f2247"],"source_ids":["src_4635faf0c15555d78eb91106fedfb397"],"text":"Repository development practice: verification uses targeted `vp test run` on touched files plus scoped lint/typecheck; repo-wide checks like `vp check` are reserved for CI, and tests must wait on typed receipts rather than sleeps or timeouts.","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
{"access":"public","created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_56216ed74264ad1203570acd775ac246facc74a89f9ffb826afb5979b8062800","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pingdotgg/t3code@66e39ca2aabd snapshot 9b65991334d57d26","timeframe":null},"slice_ids":["slc_1b32d949306b29f9d4c08deaec1dbf6160009b6a3a23ae7ac3435c9520d356b0"],"source_ids":["src_13b626322380593d98ae2b47f7da50de"],"text":"T3 Code lets users control coding agents remotely through an iOS app, Android app, web app, and an Electron-based desktop app.","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
{"access":"public","created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5d183be87510a17766de246b4015947eeb2d86f103231fe7efb8103634ce1d88","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pingdotgg/t3code@66e39ca2aabd snapshot 9b65991334d57d26","timeframe":null},"slice_ids":["slc_2d1fa15ac71700fb18a353decab2e855d47e90b6922ad45f37d4d00cacc10086","slc_832e9c91960440a84e77e15ca12e506e96ec54a2fd51c267b0a77daa154115e0","slc_a1976aaabf687c162701775021a8b18b5c80d0fd944de93c0cd4cc790d36c400","slc_b94878760059daae5942ce0333e2f6e588f8dd00deb6fdd268a8371f0f1cb01b","slc_ddf76fa4aa864e7adaabed4b16f53d5e83e828c2a529d437e73d9f36ea8aa046"],"source_ids":["src_13b626322380593d98ae2b47f7da50de"],"text":"The desktop app is distributed via GitHub Releases and package registries including winget (T3Tools.T3Code), Homebrew cask t3-code, and AUR packages for both stable and nightly builds.","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
{"access":"public","created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a0a60fa0bcb1f555103d525de3cced06616a10cfdc658a1661e0bd2332c81a1f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"pingdotgg/t3code@66e39ca2aabd snapshot 9b65991334d57d26","timeframe":null},"slice_ids":["slc_19cee0b732be0f8373a351f800925d30023d0f6078dd3db3eff4f3bef429b729","slc_516d19a170eafe31135f2ea242976de73daf6c266d236a99517ec91ae64f6dd5"],"source_ids":["src_828a7891bbe9556ca42c3b3e096631a1"],"text":"Repository development practice: PRs are auto-labeled with a vouch:* trust status and size:* diff size, and external contributors should expect vouch:unvouched until added to .github/VOUCHED.td.","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
{"access":"public","created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a90ec8c4f5a55439ecb62a29a8960a915bda536db9df6524c074f5abfb3c5a11","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"pingdotgg/t3code@66e39ca2aabd snapshot 9b65991334d57d26","timeframe":null},"slice_ids":["slc_26f8fead6e0b483ce441c35d03abe9d12df93885f6107a6f44ab94d110f41d07"],"source_ids":["src_13b626322380593d98ae2b47f7da50de"],"text":"The product works with existing subscriptions to Claude Code, Codex, Cursor, Grok Build, OpenCode, and Google Antigravity, controlling those agents when set up on the user's computer.","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
{"access":"public","created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c506279bb5c893287914e4cd0173e9cb6bf7032827dc32809f4e5d070cb634ad","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"pingdotgg/t3code@66e39ca2aabd snapshot 9b65991334d57d26","timeframe":null},"slice_ids":["slc_41bfd111043c715263b2adb9d9fe94d618fc7bedd9f88c7197eace1c3ff40ff6"],"source_ids":["src_13b626322380593d98ae2b47f7da50de"],"text":"At least one provider must be installed and authenticated before use; each provider names a CLI and login command, while Antigravity is enabled in Settings with Google sign-in and needs no CLI.","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
{"access":"public","created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d5b2b4134a6b5dd9ec3222f3cc9fe8550bc87ad39ddf5c511a70c21578b55ab7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"pingdotgg/t3code@66e39ca2aabd snapshot 9b65991334d57d26","timeframe":null},"slice_ids":["slc_c441e57cf4f11c597632b7321ada8e70688b48762636480258060c97a303a925"],"source_ids":["src_4635faf0c15555d78eb91106fedfb397"],"text":"Repository development practice: agents must never open a PR unless the developer explicitly asks; PRs use conventional-commit titles, one concern per PR, before/after images for UI changes, and evidence uploaded to GitHub rather than committed.","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
