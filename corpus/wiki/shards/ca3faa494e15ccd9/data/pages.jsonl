{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","id":"pg_98d55db691345398ad5e8bf45ae5cf17","maturity":"draft","page_type":"source","path":"pages/sources/pingdotgg-t3code-claude-md-66e39ca2aabd-8bf45ae5cf17.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7c59b00710685942b46e9e1399609911"],"title":"pingdotgg/t3code/CLAUDE.md @ 66e39ca2aabd","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_367ea2af261c8f52680fdfb981124361c6ced9fbf1ce390fc00f91e4c1cddcd6"],"opposing_claim_ids":[],"text":"Running `npx t3@latest` launches the T3 Code backend on the local machine plus a local web app for controlling agents; a `--help` flag exposes the full CLI reference."},{"claim_ids":["clm_56216ed74264ad1203570acd775ac246facc74a89f9ffb826afb5979b8062800"],"opposing_claim_ids":[],"text":"T3 Code lets users control coding agents remotely through an iOS app, Android app, web app, and an Electron-based desktop app."},{"claim_ids":["clm_5d183be87510a17766de246b4015947eeb2d86f103231fe7efb8103634ce1d88"],"opposing_claim_ids":[],"text":"The desktop app is distributed via GitHub Releases and package registries including winget (T3Tools.T3Code), Homebrew cask t3-code, and AUR packages for both stable and nightly builds."},{"claim_ids":["clm_a90ec8c4f5a55439ecb62a29a8960a915bda536db9df6524c074f5abfb3c5a11"],"opposing_claim_ids":[],"text":"The product works with existing subscriptions to Claude Code, Codex, Cursor, Grok Build, OpenCode, and Google Antigravity, controlling those agents when set up on the user's computer."},{"claim_ids":["clm_c506279bb5c893287914e4cd0173e9cb6bf7032827dc32809f4e5d070cb634ad"],"opposing_claim_ids":[],"text":"At least one provider must be installed and authenticated before use; each provider names a CLI and login command, while Antigravity is enabled in Settings with Google sign-in and needs no CLI."},{"claim_ids":["clm_e8c4185acbf2aaa06a34f53a4d82017e1b0ef100debb00a923b0907c3b550169"],"opposing_claim_ids":[],"text":"The install-free server mode requires Node.js 22.16+, 23.11+, or 24.10+."},{"claim_ids":["clm_f654f61bea6cd3c806d7085c4563465f094f8acecc114e9b31f4151746ebf036"],"opposing_claim_ids":[],"text":"The project charges nothing for the product and states it aims to be performant, remote-ready, and open enough that users can fork and build their own editor."}],"claim_ids":["clm_367ea2af261c8f52680fdfb981124361c6ced9fbf1ce390fc00f91e4c1cddcd6","clm_56216ed74264ad1203570acd775ac246facc74a89f9ffb826afb5979b8062800","clm_5d183be87510a17766de246b4015947eeb2d86f103231fe7efb8103634ce1d88","clm_a90ec8c4f5a55439ecb62a29a8960a915bda536db9df6524c074f5abfb3c5a11","clm_c506279bb5c893287914e4cd0173e9cb6bf7032827dc32809f4e5d070cb634ad","clm_e8c4185acbf2aaa06a34f53a4d82017e1b0ef100debb00a923b0907c3b550169","clm_f654f61bea6cd3c806d7085c4563465f094f8acecc114e9b31f4151746ebf036"],"created_at":"2026-09-14T03:12:02Z","created_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c","id":"pg_b51353e33a0f528fa6c90afffaa63851","maturity":"draft","page_type":"source","path":"pages/sources/pingdotgg-t3code-readme-md-66e39ca2aabd-0afffaa63851.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_13b626322380593d98ae2b47f7da50de"],"title":"pingdotgg/t3code/README.md @ 66e39ca2aabd","updated_at":"2026-09-14T03:12:02Z","updated_by_operation":"op_4e4ae1f0e0df4dad9e3ef5bc1000d28c"}
