173a77b7e8ec36553d5581f721ae32a9b"],"created_at":"2026-09-14T04:16:31Z","created_by_operation":"op_4fa9bbd9608c40b2a0df9c3d08c54771","id":"pg_c31f892fbd2f5ddf8049f6768fa31802","maturity":"draft","page_type":"entity","path":"pages/entities/polymathwizard-bhil-ai-first-development-toolkit-f6768fa31802.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"polymathwizard/bhil-ai-first-development-toolkit","updated_at":"2026-09-14T04:16:31Z","updated_by_operation":"op_4fa9bbd9608c40b2a0df9c3d08c54771"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_12b749dc1f0360ef014f0c64bbc9a34af1029f8baef28c4f52cab1799af67eff"],"opposing_claim_ids":[],"text":"The methodology mandates a test-first gate for AI-generated code: write tests, confirm they fail and commit that state, then implement without modifying test files."},{"claim_ids":["clm_c5698cc0922bb2b43e84506d7ff25c6d2666d1f57189c5abd5f82b9172ca83c7"],"opposing_claim_ids":[],"text":"For AI-native features, the methodology prescribes running a promptfoo eval suite before merging, with the pass threshold defined in the feature's SPEC acceptance criteria; unmet thresholds mean the task is not done."},{"claim_ids":["clm_dfe5c310551a8491fba786290eca9de173a77b7e8ec36553d5581f721ae32a9b"],"opposing_claim_ids":[],"text":"A sprint is defined as a two-week cycle with four phases: specification (days 1-2), planning (days 3-5), implementation (week 2 days 1-3), and integration/evaluation/deploy/retro (days 4-5)."}],"claim_ids":["clm_12b749dc1f0360ef014f0c64bbc9a34af1029f8baef28c4f52cab1799af67eff","clm_c5698cc0922bb2b43e84506d7ff25c6d2666d1f57189c5abd5f82b9172ca83c7","clm_dfe5c310551a8491fba786290eca9de173a77b7e8ec36553d5581f721ae32a9b"],"created_at":"2026-09-14T04:16:31Z","created_by_operation":"op_4fa9bbd9608c40b2a0df9c3d08c54771","id":"pg_dae87a5dcfe35281a984ec72036b6e75","maturity":"draft","page_type":"source","path":"pages/sources/polymathwizard-bhil-ai-first-development-toolkit-03-sprint-workflow-md-ec72036b6e75.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a8c4bbb666585a6a85316b670ce64910"],"title":"PolymathWizard/BHIL-AI-First-Development-Toolkit/03-sprint-workflow.md @ 161f8e5311bd","updated_at":"2026-09-14T04:16:31Z","updated_by_operation":"op_4fa9bbd9608c40b2a0df9c3d08c54771"}
