{"access":"public","created_at":"2026-09-14T03:45:10Z","created_by_operation":"op_c42a73d8196c4788928d1481412acb7c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7cd7c2f181a37a966455bd10c0961f684d328bc20b0195ee607d5296b4f4b835","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"databricks-solutions/ai-dev-kit@b059fd017a2c snapshot 8f133f51eafee394","timeframe":null},"slice_ids":["slc_62473588be402e3f7282e8cf2e5c0cf4052c234ced16b2dbc01c929c199058ff","slc_830e4ce673dc7f2486b1e7c8d70a49de20ab226ce92fd217b50cf13a030df058","slc_d912f8d05e91c2d4b82885bf6ef9edcf55a2369b9bffbeefab1a9b4488806f88"],"source_ids":["src_1afef3093e5f51ad95d749b3e1e1a8a1"],"text":"Cursor and Copilot require manual settings updates after install, and `databricks aitools install` does not yet cover Genie Code skill uploads.","updated_at":"2026-09-14T03:45:10Z","updated_by_operation":"op_c42a73d8196c4788928d1481412acb7c"}
