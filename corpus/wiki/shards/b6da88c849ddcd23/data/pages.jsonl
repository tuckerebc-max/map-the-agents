ba"],"created_at":"2026-09-14T02:42:06Z","created_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07","id":"pg_1af4725f61fd53f7ac916fad4bae0f71","maturity":"draft","page_type":"entity","path":"pages/entities/sonnhfit-sonagent-6fad4bae0f71.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"sonnhfit/sonagent","updated_at":"2026-09-14T02:42:06Z","updated_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_06405e215164ce2eee204a8d34f104f9b82000b7701f5826b40c433434640fe2"],"opposing_claim_ids":[],"text":"A multi-agent architecture includes a central AgentRegistry for registration, status tracking, and inter-agent message passing, plus a MainAgent coordinator that creates, assigns, and monitors tasks for sub-agents."},{"claim_ids":["clm_06600a8f74483dae422fb5578d4dc1450ebbdf8a05eadbb5f6e71f8721df90af"],"opposing_claim_ids":[],"text":"Standard starter skills (TextPrinter, WeatherAPISkill, HanoiWeatherChecker, SkillBuilder) are copied into user_data/skills/ on first run, and agent-specific starter skills are copied from sonagent/standard_skills/{agent_id}/ at startup."},{"claim_ids":["clm_4d874d5587c55ca25a693d0243d4edcef81a613a208b86b6e9e0b6316c58389e"],"opposing_claim_ids":[],"text":"MainAgent exposes a command-based process interface supporting commands such as create_task, list_tasks, get_task_status, and kill_task, with task priority determining execution order."},{"claim_ids":["clm_a8c01500d523ac607337e643fad125b019d32962c5bcaa878c04d8433394b6d0"],"opposing_claim_ids":[],"text":"Skills come in two types: Python classes inheriting from pydantic BaseModel, and markdown LLM instruction files; skills live in shared or per-agent directories under user_data/skills/."}],"claim_ids":["clm_06405e215164ce2eee204a8d34f104f9b82000b7701f5826b40c433434640fe2","clm_06600a8f74483dae422fb5578d4dc1450ebbdf8a05eadbb5f6e71f8721df90af","clm_4d874d5587c55ca25a693d0243d4edcef81a613a208b86b6e9e0b6316c58389e","clm_a8c01500d523ac607337e643fad125b019d32962c5bcaa878c04d8433394b6d0"],"created_at":"2026-09-14T02:42:06Z","created_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07","id":"pg_2f34849cac0b5a13ac691a5304eb4b39","maturity":"draft","page_type":"source","path":"pages/sources/sonnhfit-sonagent-docs-agent-system-md-0bccfcbfee88-1a5304eb4b39.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_08c70c6c1b715325bb5eba7f37f1f832"],"title":"sonnhfit/SonAgent/docs/AGENT_SYSTEM.md @ 0bccfcbfee88","updated_at":"2026-09-14T02:42:06Z","updated_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0c811e8e3a9f7bb9e12337e7a7d8170fb74eec7cd22e16a42d79fa12c08403f0"],"opposing_claim_ids":[],"text":"The SkillBuilder documentation acknowledges current limitations: generation is template-based, complex logic needs manual coding, LLM-based implementation generation is not yet present, and some Python features are restricted in the sandbox."},{"claim_ids":["clm_9a74e32cec2c7a921ab996214ee4cc864f02058e25aa98992986e45d293bc5a5"],"opposing_claim_ids":[],"text":"SkillBuilder consists of a SandboxExecutor that runs code with restricted imports/builtins and no file or network access, a SkillGenerator using templates, and a user-facing SkillBuilder skill with create_simple_skill, generate_skill, and test_skill_code methods."},{"claim_ids":["clm_c2f1da6be12dde276bab612886b68b82abbec9d8aa97527801943a4dc4b49a53"],"opposing_claim_ids":[],"text":"The sandbox execution environment enforces whitelisted imports, a limited builtin set, no file-system modification, and restricted network access for unsaved skills, with syntax validation before execution."}],"claim_ids":["clm_0c811e8e3a9f7bb9e12337e7a7d8170fb74eec7cd22e16a42d79fa12c08403f0","clm_9a74e32cec2c7a921ab996214ee4cc864f02058e25aa98992986e45d293bc5a5","clm_c2f1da6be12dde276bab612886b68b82abbec9d8aa97527801943a4dc4b49a53"],"created_at":"2026-09-14T02:42:06Z","created_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07","id":"pg_5975c073281a50e8a63414620b900936","maturity":"draft","page_type":"source","path":"pages/sources/sonnhfit-sonagent-docs-skill-builder-md-0bccfcbfee88-14620b900936.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_41babfa38e0f542d897e7e3a06b28238"],"title":"sonnhfit/SonAgent/docs/SKILL_BUILDER.md @ 0bccfcbfee88","updated_at":"2026-09-14T02:42:06Z","updated_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_d68420b789dcb729d754beb23c7b8e45b49b4bcf05aa95c089a67d805ded3f49"],"opposing_claim_ids":[],"text":"Repository development practice: dev tooling is pinned in requirements-dev.txt (pytest, ruff, mypy, pre-commit, coverage plugins), docs use Sphinx, and Docker images are built by CI to GitHub Container Registry with latest/dev/version/SHA tags."}],"claim_ids":["clm_d68420b789dcb729d754beb23c7b8e45b49b4bcf05aa95c089a67d805ded3f49"],"created_at":"2026-09-14T02:42:06Z","created_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07","id":"pg_62246d9ec3bd5f8bbcd1ea6e135350f2","maturity":"draft","page_type":"source","path":"pages/sources/sonnhfit-sonagent-requirements-dev-txt-0bccfcbfee88-ea6e135350f2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9cc9b2b39a7c5881bc8c43d7a13a0af1"],"title":"sonnhfit/SonAgent/requirements-dev.txt @ 0bccfcbfee88","updated_at":"2026-09-14T02:42:06Z","updated_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7aaa4aace79cfd665caaa03c718120214a438d3cdc58450be4908fe808b1130a"],"opposing_claim_ids":[],"text":"Runtime dependencies include chromadb, SQLAlchemy, python-telegram-bot, FastAPI/uvicorn for an API server, and AI libraries agno, groq, and openai, plus research tools such as arxiv, wikipedia, yfinance, and ddgs."}],"claim_ids":["clm_7aaa4aace79cfd665caaa03c718120214a438d3cdc58450be4908fe808b1130a"],"created_at":"2026-09-14T02:42:06Z","created_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07","id":"pg_9f543eaa65415bac84c9bf8546637514","maturity":"draft","page_type":"source","path":"pages/sources/sonnhfit-sonagent-requirements-txt-0bccfcbfee88-bf8546637514.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_75d695dceb3958169b1935ecd77b47b8"],"title":"sonnhfit/SonAgent/requirements.txt @ 0bccfcbfee88","updated_at":"2026-09-14T02:42:06Z","updated_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_06600a8f74483dae422fb5578d4dc1450ebbdf8a05eadbb5f6e71f8721df90af"],"opposing_claim_ids":[],"text":"Standard starter skills (TextPrinter, WeatherAPISkill, HanoiWeatherChecker, SkillBuilder) are copied into user_data/skills/ on first run, and agent-specific starter skills are copied from sonagent/standard_skills/{agent_id}/ at startup."},{"claim_ids":["clm_3a98cc0826a69cb4b3afb3af77d1fdb3d766487393c6e111f4979764415da4f2"],"opposing_claim_ids":[],"text":"The project describes itself as an autonomous 'Digital Consciousness Backup Agent' that uses LLMs to safeguard a user's digital presence, with self-editing source code capability."},{"claim_ids":["clm_5ad149584e62ab0e18c56936144f65417ac08e36a804911d599caefebfbde68d"],"opposing_claim_ids":[],"text":"The agent's stated design includes belief-based reasoning with LLMs, automatic belief acquisition over time, and learning from human feedback."},{"claim_ids":["clm_ba73c85060de8b39d8df65972d6e2c609b1903c5b1952d927a4613cb92f0b0b3"],"opposing_claim_ids":[],"text":"The CLI is installed via pip and run with 'sonagent run' taking --config, --agentdb (SQLite), --memory-url, --user-data-dir, and --log-level options; 'sonagent init' creates the user_data folder."},{"claim_ids":["clm_d68420b789dcb729d754beb23c7b8e45b49b4bcf05aa95c089a67d805ded3f49"],"opposing_claim_ids":[],"text":"Repository development practice: dev tooling is pinned in requirements-dev.txt (pytest, ruff, mypy, pre-commit, coverage plugins), docs use Sphinx, and Docker images are built by CI to GitHub Container Registry with latest/dev/version/SHA tags."},{"claim_ids":["clm_de35cdd140713252a9bcadbff29f35112c4d980fad4deab5dc719422f9ca98ba"],"opposing_claim_ids":[],"text":"Timezone is configurable via config.json or the SONAGENT_TIMEZONE environment variable, with priority env var > config file > default UTC, and any pytz-supported timezone string."}],"claim_ids":["clm_06600a8f74483dae422fb5578d4dc1450ebbdf8a05eadbb5f6e71f8721df90af","clm_3a98cc0826a69cb4b3afb3af77d1fdb3d766487393c6e111f4979764415da4f2","clm_5ad149584e62ab0e18c56936144f65417ac08e36a804911d599caefebfbde68d","clm_ba73c85060de8b39d8df65972d6e2c609b1903c5b1952d927a4613cb92f0b0b3","clm_d68420b789dcb729d754beb23c7b8e45b49b4bcf05aa95c089a67d805ded3f49","clm_de35cdd140713252a9bcadbff29f35112c4d980fad4deab5dc719422f9ca98ba"],"created_at":"2026-09-14T02:42:06Z","created_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07","id":"pg_cf0e03bfa26355169f22c8b0e30f6416","maturity":"draft","page_type":"source","path":"pages/sources/sonnhfit-sonagent-readme-md-0bccfcbfee88-c8b0e30f6416.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_309e8dd55d845735830d71163aa1da1c"],"title":"sonnhfit/SonAgent/README.MD @ 0bccfcbfee88","updated_at":"2026-09-14T02:42:06Z","updated_by_operation":"op_ce5a0ae1ab2f40329a4347bb38c3ba07"}
