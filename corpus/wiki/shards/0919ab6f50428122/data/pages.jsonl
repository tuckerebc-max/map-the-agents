{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_00c534d9a19f30c0aeb36b258579b173bd2750877bf9deeee2b3023b615875ed"],"opposing_claim_ids":[],"text":"The package exposes a Python API: a repo profile registry can fetch a RepoProfile from a task instance and obtain a Docker container with the task initialized."},{"claim_ids":["clm_2b5b9d02bf71631cf3e0ece14eaf3a1bc356c5e0512ea8f5f66ed92bc82b2674"],"opposing_claim_ids":[],"text":"Creating execution environments requires Docker; the project was developed and tested on Ubuntu 22.04.4 LTS, and Windows or MacOS support is not planned."},{"claim_ids":["clm_4671d0338deb3388a32eccf75e4677a78c6184b9900e8efe1237c2ac61d9d3c0"],"opposing_claim_ids":[],"text":"The fine-tuned SWE-agent-LM-32B reportedly achieves 40.2% pass@1 on SWE-bench Verified, and the README claims a 32% jump from fine-tuning Qwen 2.5 Coder with SWE-agent."},{"claim_ids":["clm_60304b7fe55ae495e4887467f3bae786d43986fb0c3ac526a774a489d8af1a71"],"opposing_claim_ids":[],"text":"The documented pipeline for building a dataset is: create an environment, synthesize task instances, keep tasks that break one or more unit tests, then generate issue text for the tasks."},{"claim_ids":["clm_91847c08b29c3888c967faee8796c4e7421eaaf3eb5ea232b31cf6af747718a7"],"opposing_claim_ids":[],"text":"SWE-smith is described as a toolkit for training SWE-agents that can turn any GitHub repository into a SWE-gym and create tasks such as file localization and program repair."},{"claim_ids":["clm_a5860cc1cd80681c39ff1ab13cc4e9adcbc85ed48aeb96025dbe482d9d33d489"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are asked to additionally run 'pre-commit install' after setup, and a Contributing Guide is referenced for further details."},{"claim_ids":["clm_cf059549e5d7d1524f164073af267f0d6342b4cde38de156abe48924f8fd9cee"],"opposing_claim_ids":[],"text":"The README badge indicates Python 3.10+ is required, and the project is MIT licensed."}],"claim_ids":["clm_00c534d9a19f30c0aeb36b258579b173bd2750877bf9deeee2b3023b615875ed","clm_2b5b9d02bf71631cf3e0ece14eaf3a1bc356c5e0512ea8f5f66ed92bc82b2674","clm_4671d0338deb3388a32eccf75e4677a78c6184b9900e8efe1237c2ac61d9d3c0","clm_60304b7fe55ae495e4887467f3bae786d43986fb0c3ac526a774a489d8af1a71","clm_91847c08b29c3888c967faee8796c4e7421eaaf3eb5ea232b31cf6af747718a7","clm_a5860cc1cd80681c39ff1ab13cc4e9adcbc85ed48aeb96025dbe482d9d33d489","clm_cf059549e5d7d1524f164073af267f0d6342b4cde38de156abe48924f8fd9cee"],"created_at":"2026-09-14T04:24:25Z","created_by_operation":"op_5d228fe32c5b4177bcf96187cecc2764","id":"pg_0803c10ccdd95668a670a3da76e86936","maturity":"draft","page_type":"source","path":"pages/sources/swe-bench-swe-smith-readme-md-9b74ac08118a-a3da76e86936.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2af848924fdb599ba9393c4e4579d053"],"title":"SWE-bench/SWE-smith/README.md @ 9b74ac08118a","updated_at":"2026-09-14T04:24:25Z","updated_by_operation":"op_5d228fe32c5b4177bcf96187cecc2764"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_53229cee4b3c76a6753e28dea31f0e88f296efa7ccf108dc7012aad1b9571a01"],"opposing_claim_ids":[],"text":"A quickstart shows concrete commands: an LM-based bug-generation module (e.g. swesmith.bug_gen.llm.modify with a config file, model, n_bugs, and worker count), patch collection, validation via swesmith.harness.valid, gathering valid instances, and issue generation."}],"claim_ids":["clm_53229cee4b3c76a6753e28dea31f0e88f296efa7ccf108dc7012aad1b9571a01"],"created_at":"2026-09-14T04:24:25Z","created_by_operation":"op_5d228fe32c5b4177bcf96187cecc2764","id":"pg_53c729637c5e565b894a9137e838fa8e","maturity":"draft","page_type":"source","path":"pages/sources/swe-bench-swe-smith-docs-getting-started-quickstart-md-9b74ac08118a-9137e838fa8e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d54fc61a26f05315aab83e6f17d9646b"],"title":"SWE-bench/SWE-smith/docs/getting_started/quickstart.md @ 9b74ac08118a","updated_at":"2026-09-14T04:24:25Z","updated_by_operation":"op_5d228fe32c5b4177bcf96187cecc2764"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2f242f840e3c074f4dbd671664a685160c6a7130a757c2b6b304dea3e33721ca"],"opposing_claim_ids":[],"text":"Released assets include a HuggingFace dataset of 50k+ task instances, 5k expert trajectories, and fine-tuned 32B and 7B models based on Qwen 2.5 Coder Instruct."},{"claim_ids":["clm_4671d0338deb3388a32eccf75e4677a78c6184b9900e8efe1237c2ac61d9d3c0"],"opposing_claim_ids":[],"text":"The fine-tuned SWE-agent-LM-32B reportedly achieves 40.2% pass@1 on SWE-bench Verified, and the README claims a 32% jump from fine-tuning Qwen 2.5 Coder with SWE-agent."},{"claim_ids":["clm_5b4c1b5c169308a82ba1673739587bb98790068c88c4e60316d9445214e1c473"],"opposing_claim_ids":[],"text":"Released assets include environments for 128 GitHub repositories as Docker images, downloadable via a bundled download_images.py script."},{"claim_ids":["clm_e27e56b12ae476c820e293de5738224250e9f4630b15133ce432e114c9ea1b02"],"opposing_claim_ids":[],"text":"SWE-Rater-32B, a Qwen 2.5 Coder Instruct 32B model fine-tuned on human-annotated ratings of SWE-bench task difficulty, is released as a HuggingFace model."}],"claim_ids":["clm_2f242f840e3c074f4dbd671664a685160c6a7130a757c2b6b304dea3e33721ca","clm_4671d0338deb3388a32eccf75e4677a78c6184b9900e8efe1237c2ac61d9d3c0","clm_5b4c1b5c169308a82ba1673739587bb98790068c88c4e60316d9445214e1c473","clm_e27e56b12ae476c820e293de5738224250e9f4630b15133ce432e114c9ea1b02"],"created_at":"2026-09-14T04:24:25Z","created_by_operation":"op_5d228fe32c5b4177bcf96187cecc2764","id":"pg_7aa7feadfe28589aa71c163fea04520b","maturity":"draft","page_type":"source","path":"pages/sources/swe-bench-swe-smith-docs-getting-started-assets-md-9b74ac08118a-163fea04520b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_94bb2b0686175144b290e6839dd60dd3"],"title":"SWE-bench/SWE-smith/docs/getting_started/assets.md @ 9b74ac08118a","updated_at":"2026-09-14T04:24:25Z","updated_by_operation":"op_5d228fe32c5b4177bcf96187cecc2764"}
