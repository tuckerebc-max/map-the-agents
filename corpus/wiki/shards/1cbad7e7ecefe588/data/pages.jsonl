96310","clm_eccbb2da05c806bd512b022bd56aee5c462c09a16f96340f2784fbad8f0b6fb8","clm_f57bf841cc946245e85ff9f5be09f5d91a13908bdcdd933b86a1210ac93051f3"],"created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","id":"pg_15b2029220bd51eea079a2a4f9197df5","maturity":"draft","page_type":"entity","path":"pages/entities/hardik180704-neocode-a2a4f9197df5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"hardik180704/neocode","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7d5405b5257200d29167261f08ad98f8930ff5aa85970a6233fade5954887c97"],"opposing_claim_ids":[],"text":"Repository development practice: contributors install Bun 1.3.13, run bun install --frozen-lockfile, start services with bun run dev:server/dev:cli/dev:web, and run bun test and bun run check before opening a pull request."}],"claim_ids":["clm_7d5405b5257200d29167261f08ad98f8930ff5aa85970a6233fade5954887c97"],"created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","id":"pg_812ecd273d2351e4b647a4d232c62d0e","maturity":"draft","page_type":"source","path":"pages/sources/hardik180704-neocode-contributing-md-0c016cadc012-a4d232c62d0e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_eca1815f0a5856ce8cf72a4d7cc2db0b"],"title":"Hardik180704/NeoCode/CONTRIBUTING.md @ 0c016cadc012","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_13e5e051893240533e51ebb2502f38f355a54339443bbdd25a09fb4ce9587c85"],"opposing_claim_ids":[],"text":"Sessions are persistent and can be reopened via the /sessions command to browse previous conversations."},{"claim_ids":["clm_162162155edf7705a8cc310d66c2f184e72f6ad2854ba7f58b4963cdd45b6b80"],"opposing_claim_ids":[],"text":"NeoLens is a local codebase explorer with three views: Graph (TypeScript dependency relationships), Workspace (read-only file previews and capped search), and Timeline (tool-activity replay with token, duration, and estimated cost summaries)."},{"claim_ids":["clm_1eee16f9975100caa6166d463e3d38a33157f4c1bb4864bb0374014a7b549e94"],"opposing_claim_ids":[],"text":"MCP tools are denied by default and require an explicit policy: read tools are available in PLAN and BUILD, write tools only in BUILD, and disabled tools are never exposed to the model; a wildcard policy can classify unlisted tools."},{"claim_ids":["clm_323ade47fc038e67c2c4dfbd0a4782dd2eff5148c3ba4a04324f167b0cf43045"],"opposing_claim_ids":[],"text":"NeoLens is project-scoped and keeps source local: it respects .gitignore rules, never follows symbolic links, hides credential files, rejects paths outside the project, and caps indexing/search/preview work; the Railway API receives session activity but not file contents."},{"claim_ids":["clm_5d151589b03f9b636c914ca1968e237905f0c6e19ada82f07defa49b5e1cce45"],"opposing_claim_ids":[],"text":"Current release binaries are unsigned: macOS may require manual Privacy & Security approval and Windows may show a SmartScreen warning; SHA-256 checksums and GitHub attestations are published for verification."},{"claim_ids":["clm_73ea5333b41aa527c05395b2ed0b78103294390827b790fc15e6a02b1eb0766d"],"opposing_claim_ids":[],"text":"The repository is a Bun monorepo with a terminal client (packages/cli), API server (packages/server), shared package, Prisma database package, and a Vite-powered landing page (packages/web)."},{"claim_ids":["clm_7fb1996554173ae15b989368b1be6b67ac6c85895709462db25ac44c0c5f574d"],"opposing_claim_ids":[],"text":"MCP integration is optional and discovered from a project-local .neocode/mcp.json; without it, built-in local tools still work. Supported transports are stdio for local servers and Streamable HTTP for remote servers."},{"claim_ids":["clm_8d70bb43485fc8beab61b3f9d11c0beb0e7a34e4e40d18a3bbcad40bf6c2a2e6"],"opposing_claim_ids":[],"text":"NeoCode is described as an open-source, terminal-native coding agent with streaming AI responses, persistent sessions, PLAN and BUILD modes, local repository tools, NeoLens codebase intelligence, themes, and optional MCP integrations."},{"claim_ids":["clm_bafc70538b01004da3a39bdb6fef4a2ee4bec2c2c710c21f9cfa63c2bcd23f00"],"opposing_claim_ids":[],"text":"NeoCode has two agent modes: PLAN for read-only investigation and BUILD for implementation; the /agents command switches between the corresponding agents."},{"claim_ids":["clm_d2542301208de71fffcc9f922d0b326a5ff6b351ec0ae3da5e865d79b1196310"],"opposing_claim_ids":[],"text":"The CLI exposes slash commands including /new, /agents, /models, /sessions, /lens, /mcp, /theme, and /login, and API_URL can point the CLI at a different NeoCode API."},{"claim_ids":["clm_eccbb2da05c806bd512b022bd56aee5c462c09a16f96340f2784fbad8f0b6fb8"],"opposing_claim_ids":[],"text":"MCP secrets use environment references such as ${env:GITHUB_TOKEN}; resolved values stay in the server process and are not returned by the MCP inspection API, and local stdio servers inherit only a small safe set of variables plus their declared env block."},{"claim_ids":["clm_f57bf841cc946245e85ff9f5be09f5d91a13908bdcdd933b86a1210ac93051f3"],"opposing_claim_ids":[],"text":"Standalone binaries for macOS, Linux, and Windows are published via GitHub Releases and include the Bun runtime, so users need not install Bun or Node.js; Homebrew installation is also supported."}],"claim_ids":["clm_13e5e051893240533e51ebb2502f38f355a54339443bbdd25a09fb4ce9587c85","clm_162162155edf7705a8cc310d66c2f184e72f6ad2854ba7f58b4963cdd45b6b80","clm_1eee16f9975100caa6166d463e3d38a33157f4c1bb4864bb0374014a7b549e94","clm_323ade47fc038e67c2c4dfbd0a4782dd2eff5148c3ba4a04324f167b0cf43045","clm_5d151589b03f9b636c914ca1968e237905f0c6e19ada82f07defa49b5e1cce45","clm_73ea5333b41aa527c05395b2ed0b78103294390827b790fc15e6a02b1eb0766d","clm_7fb1996554173ae15b989368b1be6b67ac6c85895709462db25ac44c0c5f574d","clm_8d70bb43485fc8beab61b3f9d11c0beb0e7a34e4e40d18a3bbcad40bf6c2a2e6","clm_bafc70538b01004da3a39bdb6fef4a2ee4bec2c2c710c21f9cfa63c2bcd23f00","clm_d2542301208de71fffcc9f922d0b326a5ff6b351ec0ae3da5e865d79b1196310","clm_eccbb2da05c806bd512b022bd56aee5c462c09a16f96340f2784fbad8f0b6fb8","clm_f57bf841cc946245e85ff9f5be09f5d91a13908bdcdd933b86a1210ac93051f3"],"created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","id":"pg_8dbd171347df59a69abc764c671b09c8","maturity":"draft","page_type":"source","path":"pages/sources/hardik180704-neocode-readme-md-0c016cadc012-764c671b09c8.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d4fb8f17ec345e5ca792bd7c211f3737"],"title":"Hardik180704/NeoCode/README.md @ 0c016cadc012","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
