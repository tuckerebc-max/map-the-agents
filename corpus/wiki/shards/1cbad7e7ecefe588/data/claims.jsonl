{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bafc70538b01004da3a39bdb6fef4a2ee4bec2c2c710c21f9cfa63c2bcd23f00","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_ad5febe41ec8cfc80c4584bd6bfc74f390bfe507c2a961b0ba1cc81d42911859","slc_cfd1b0c06fe771f07215ba55a5666d9cfdc465421e43c48f4091fe844d6d5d5a"],"source_ids":["src_d4fb8f17ec345e5ca792bd7c211f3737"],"text":"NeoCode has two agent modes: PLAN for read-only investigation and BUILD for implementation; the /agents command switches between the corresponding agents.","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
