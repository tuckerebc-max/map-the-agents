{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_eccbb2da05c806bd512b022bd56aee5c462c09a16f96340f2784fbad8f0b6fb8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_1766ba722d81cc35811d6084650be6ca080775137dd84e0ef071cddba5fabdbe"],"source_ids":["src_d4fb8f17ec345e5ca792bd7c211f3737"],"text":"MCP secrets use environment references such as ${env:GITHUB_TOKEN}; resolved values stay in the server process and are not returned by the MCP inspection API, and local stdio servers inherit only a small safe set of variables plus their declared env block.","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f57bf841cc946245e85ff9f5be09f5d91a13908bdcdd933b86a1210ac93051f3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_2e25c2ea3224f29771478edf5dd96d8c6f0d53a5f5ba92db5c48bb8cbd687310","slc_a9df7b98bbe470b6b5058f5c550e429e3f37c88f77707d09997cb9f005fd2f0d","slc_cfd1b0c06fe771f07215ba55a5666d9cfdc465421e43c48f4091fe844d6d5d5a"],"source_ids":["src_d4fb8f17ec345e5ca792bd7c211f3737"],"text":"Standalone binaries for macOS, Linux, and Windows are published via GitHub Releases and include the Bun runtime, so users need not install Bun or Node.js; Homebrew installation is also supported.","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
