{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_162162155edf7705a8cc310d66c2f184e72f6ad2854ba7f58b4963cdd45b6b80","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_09329a78c11c5ab622dbc40a505c2452f6045f7404b851df8dcfdca0be0ab8c7","slc_188647f0a0c1108ab951736c6d0739813f7525e42ab909687bd318d3d7a832dd"],"source_ids":["src_d4fb8f17ec345e5ca792bd7c211f3737"],"text":"NeoLens is a local codebase explorer with three views: Graph (TypeScript dependency relationships), Workspace (read-only file previews and capped search), and Timeline (tool-activity replay with token, duration, and estimated cost summaries).","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1eee16f9975100caa6166d463e3d38a33157f4c1bb4864bb0374014a7b549e94","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_01333728ec3f73c976ed388f34497131fbbbfab7455603aea61d7ab148236713","slc_137202d5aafe6219125628403b2a89c7870ae3cd6ce2f1f8f97d8b51d2876e57","slc_e8bc030e906490b5dcd7d48646798a72da9229264337f6fe0c0c10704eb6e2f8"],"source_ids":["src_d4fb8f17ec345e5ca792bd7c211f3737"],"text":"MCP tools are denied by default and require an explicit policy: read tools are available in PLAN and BUILD, write tools only in BUILD, and disabled tools are never exposed to the model; a wildcard policy can classify unlisted tools.","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_323ade47fc038e67c2c4dfbd0a4782dd2eff5148c3ba4a04324f167b0cf43045","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_d8e51ef4d980053736148e2757a2911dc9ba57c8c3ec2110f5974df18758c17b"],"source_ids":["src_d4fb8f17ec345e5ca792bd7c211f3737"],"text":"NeoLens is project-scoped and keeps source local: it respects .gitignore rules, never follows symbolic links, hides credential files, rejects paths outside the project, and caps indexing/search/preview work; the Railway API receives session activity but not file contents.","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_332f193b0c60efb991549341250f20e35988fae4862b82d24623c8ca2e2b2fa5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_ba6df15d541cfffb59dc871bd671a19e098e45f9a53f3abfef1d705589b35e7e"],"source_ids":["src_d78578c6ffd65765a42fd6fcd338f92b"],"text":"Repository development practice: the release workflow builds eight platform targets with archives, checksums, and GitHub provenance attestations, and opens an automated Homebrew formula update PR in the tap repository.","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5d151589b03f9b636c914ca1968e237905f0c6e19ada82f07defa49b5e1cce45","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_98c840122431ae142f2a81b4c498eaa386a12525c150d9cdc403e12c0fff8462","slc_b8d09916351656a3b9ae8b343ff2eec28b9ec350cb28224315808f1623c845a2"],"source_ids":["src_d4fb8f17ec345e5ca792bd7c211f3737","src_d78578c6ffd65765a42fd6fcd338f92b"],"text":"Current release binaries are unsigned: macOS may require manual Privacy & Security approval and Windows may show a SmartScreen warning; SHA-256 checksums and GitHub attestations are published for verification.","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_73ea5333b41aa527c05395b2ed0b78103294390827b790fc15e6a02b1eb0766d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_5f6fb910b905d1f890724a0a55d52213737d8390505eff996e8c4ebba7a2259c","slc_b1d1540546a882ddf48380529b58dc32a25fb9acee1bf1244cf92187fba139d1"],"source_ids":["src_d4fb8f17ec345e5ca792bd7c211f3737"],"text":"The repository is a Bun monorepo with a terminal client (packages/cli), API server (packages/server), shared package, Prisma database package, and a Vite-powered landing page (packages/web).","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
{"access":"public","created_at":"2026-09-14T02:01:33Z","created_by_operation":"op_debecf088eb145dfb765b2fa3f74b070","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7d5405b5257200d29167261f08ad98f8930ff5aa85970a6233fade5954887c97","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"hardik180704/neocode@0c016cadc012 snapshot 0d07d5515adf4028","timeframe":null},"slice_ids":["slc_02fd982487d98d358c1af1cddb159756fb4b3d6a445ad25facc4da5363f8025e","slc_0e6707c2a88c48937d43e8fbe0cc49fa9f9dec8e1db112a1280511e235b8e208","slc_8ba87987a9989ca2f19f29fd9482ea9815f57f98ea5811da09af45388bfe3f4b","slc_a751044e469d275d09602c529f6727e1f15d351853efb7993a21b183517e5f5c","slc_f6072e0c3ea8bd27cd7df459fd512381758c255aa1acf7819bbfa30c054c085a"],"source_ids":["src_cf7b093f29df55e58456004e4e6e78a2","src_eca1815f0a5856ce8cf72a4d7cc2db0b"],"text":"Repository development practice: contributors install Bun 1.3.13, run bun install --frozen-lockfile, start services with bun run dev:server/dev:cli/dev:web, and run bun test and bun run check before opening a pull request.","updated_at":"2026-09-14T02:01:33Z","updated_by_operation":"op_debecf088eb145dfb765b2fa3f74b070"}
