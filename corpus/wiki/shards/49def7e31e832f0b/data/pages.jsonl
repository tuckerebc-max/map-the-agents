{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:40:41Z","created_by_operation":"op_d0bc437f9dd642d289abb50767f2316c","id":"pg_ae1f84fa48a95768aae2a57749904908","maturity":"draft","page_type":"source","path":"pages/sources/cherryhq-cherry-studio-design-md-61cac30ece4d-a57749904908.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5af6079417305b7c8065e669ce085fdf"],"title":"CherryHQ/cherry-studio/DESIGN.md @ 61cac30ece4d","updated_at":"2026-09-14T03:40:41Z","updated_by_operation":"op_d0bc437f9dd642d289abb50767f2316c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_056f1035c4085b8b2c5fed7580284a7a29ce8227cc5167fd1e082b9582f395a3"],"opposing_claim_ids":[],"text":"A LAN transfer protocol specification covers desktop-mobile sync using mDNS discovery, a TCP handshake, and file transfer."},{"claim_ids":["clm_519228072d71e11a6d1af2e564551e841244e2986511f984572a8c8652ec2e71"],"opposing_claim_ids":[],"text":"The architecture follows an Electron process model with main, renderer, shared, and utility-process layers, each with documented dependency rules."},{"claim_ids":["clm_58b46ca21d7990952f55e3c85d9baabb0e4d7262b7a02677bc237b946be196f0"],"opposing_claim_ids":[],"text":"Repository development practice: a maintainer runbook covers preparing, validating, hotfixing, publishing, and synchronizing release branches, and a Test Plan process governs beta and rc testing."},{"claim_ids":["clm_6e387bbe072c4af6297c39fab0daac4405f3cc4f5e7b00ccd952bf10873be285"],"opposing_claim_ids":[],"text":"Repository development practice: contributions follow a documented branching strategy with pull request guidelines and version tag management targeting main."},{"claim_ids":["clm_73320509ca7623179a7b28be0571f88f4b96f0d93af40805c8264e99d82e17be"],"opposing_claim_ids":[],"text":"Linux packaging uses pinned better-sqlite3 prebuilds, with documented build commands and prebuild update steps."},{"claim_ids":["clm_a439c3d6a3d2dc95045bbdddbeccb2b69dbf71c1f5aacb4f30cabc052bceae93"],"opposing_claim_ids":[],"text":"A local HTTP API gateway exposes OpenAI, Anthropic, Gemini, Cherry REST, and MCP-compatible client endpoints."}],"claim_ids":["clm_056f1035c4085b8b2c5fed7580284a7a29ce8227cc5167fd1e082b9582f395a3","clm_519228072d71e11a6d1af2e564551e841244e2986511f984572a8c8652ec2e71","clm_58b46ca21d7990952f55e3c85d9baabb0e4d7262b7a02677bc237b946be196f0","clm_6e387bbe072c4af6297c39fab0daac4405f3cc4f5e7b00ccd952bf10873be285","clm_73320509ca7623179a7b28be0571f88f4b96f0d93af40805c8264e99d82e17be","clm_a439c3d6a3d2dc95045bbdddbeccb2b69dbf71c1f5aacb4f30cabc052bceae93"],"created_at":"2026-09-14T03:40:41Z","created_by_operation":"op_d0bc437f9dd642d289abb50767f2316c","id":"pg_c9b985af61f95b448eabfa46f8617b42","maturity":"draft","page_type":"source","path":"pages/sources/cherryhq-cherry-studio-docs-readme-md-61cac30ece4d-fa46f8617b42.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4266d36cb8645c93bfd2270cd7857b67"],"title":"CherryHQ/cherry-studio/docs/README.md @ 61cac30ece4d","updated_at":"2026-09-14T03:40:41Z","updated_by_operation":"op_d0bc437f9dd642d289abb50767f2316c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1addc01ed1de188c9a5486ee8da1a86b9c1b34e1f10a591b0ea1ea958df19d2e"],"opposing_claim_ids":[],"text":"Cherry Studio is a desktop client supporting multiple LLM providers, available on Windows, Mac, and Linux."},{"claim_ids":["clm_1bb4920b8dac1198067ec84e63c2143a6c66bff14ce3987ffa4ea1e0a6286422"],"opposing_claim_ids":[],"text":"Advertised features include 300+ pre-configured AI assistants, custom assistant creation, and multi-model simultaneous conversations."},{"claim_ids":["clm_6e387bbe072c4af6297c39fab0daac4405f3cc4f5e7b00ccd952bf10873be285"],"opposing_claim_ids":[],"text":"Repository development practice: contributions follow a documented branching strategy with pull request guidelines and version tag management targeting main."},{"claim_ids":["clm_7afe7c010a72c7cc99d1374a603dc4da2d04463c8717e3364ad2d578e4c695da"],"opposing_claim_ids":[],"text":"Repository development practice: getting started steps are fork, create a branch, commit and push, then open a pull request describing the changes."},{"claim_ids":["clm_8bf9aee384633abf38130fc6a03076914b6cc302e4e63a1f5152eb57ced52731"],"opposing_claim_ids":[],"text":"The Community Edition is licensed under AGPL-3.0, with commercial licenses available by contact; an Enterprise Edition offers private deployment."},{"claim_ids":["clm_f93331f9ae0729dd80f02f9f61d371234b324d8f16bcf09c41354a19c70e6a07"],"opposing_claim_ids":[],"text":"The app supports cloud LLM services such as OpenAI, Gemini, and Anthropic, plus local models via Ollama and LM Studio."}],"claim_ids":["clm_1addc01ed1de188c9a5486ee8da1a86b9c1b34e1f10a591b0ea1ea958df19d2e","clm_1bb4920b8dac1198067ec84e63c2143a6c66bff14ce3987ffa4ea1e0a6286422","clm_6e387bbe072c4af6297c39fab0daac4405f3cc4f5e7b00ccd952bf10873be285","clm_7afe7c010a72c7cc99d1374a603dc4da2d04463c8717e3364ad2d578e4c695da","clm_8bf9aee384633abf38130fc6a03076914b6cc302e4e63a1f5152eb57ced52731","clm_f93331f9ae0729dd80f02f9f61d371234b324d8f16bcf09c41354a19c70e6a07"],"created_at":"2026-09-14T03:40:41Z","created_by_operation":"op_d0bc437f9dd642d289abb50767f2316c","id":"pg_eaef879f11085b1baab3fbc7ea8ef6d7","maturity":"draft","page_type":"source","path":"pages/sources/cherryhq-cherry-studio-readme-md-61cac30ece4d-fbc7ea8ef6d7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b39918bcfdce5e46bcc0dfa44c716c33"],"title":"CherryHQ/cherry-studio/README.md @ 61cac30ece4d","updated_at":"2026-09-14T03:40:41Z","updated_by_operation":"op_d0bc437f9dd642d289abb50767f2316c"}
