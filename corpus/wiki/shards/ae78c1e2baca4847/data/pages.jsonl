{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_37e62c7199d1b8c48ef04f6cbb9b0cbccac62f05d46308aaf730add957fb6590"],"opposing_claim_ids":[],"text":"Users can add context to chat by highlighting code and pressing Cmd+M, or by clicking a plus button in chat to pick project files."},{"claim_ids":["clm_49fad306055d12199c014a7eb90b8d1b43c3ee41263b47c93ca0de53c260ca06"],"opposing_claim_ids":[],"text":"The extension also offers codebase chat for questions and feature generation, plus smart refactoring of components or pages."},{"claim_ids":["clm_6844047cf4f6f84d6eda788c14958884ba9f38d969cb18331a1ceb26efe67a56"],"opposing_claim_ids":[],"text":"The extension can also be installed in Cursor via its extensions panel and used through the same sidebar or Cmd+; shortcut."},{"claim_ids":["clm_98f58234783fdf14af24ec81d7c441ca7ec5e932ccd147d05774b9fd17004653"],"opposing_claim_ids":[],"text":"The README lists chat features including a themed chat UI, conversation history, message editing with regeneration, stop-generation, streaming responses, file search, and hints/shortcuts."},{"claim_ids":["clm_a453bf089d39168f247698df16c5b1fe00808e433d1164a9eec33b95ed2ebb3a"],"opposing_claim_ids":[],"text":"The product provides Figma-to-code, image-to-code, and sketch-to-code generation that aims to follow the user's design system and coding standards."},{"claim_ids":["clm_a9169f596706684cc82bac39a741f7799564d7196f1a35e463fd48ab5e530a2c"],"opposing_claim_ids":[],"text":"Superflex is distributed as a VSCode extension installable from the Visual Studio Code Marketplace, opened from the sidebar or with the Cmd+; shortcut."}],"claim_ids":["clm_37e62c7199d1b8c48ef04f6cbb9b0cbccac62f05d46308aaf730add957fb6590","clm_49fad306055d12199c014a7eb90b8d1b43c3ee41263b47c93ca0de53c260ca06","clm_6844047cf4f6f84d6eda788c14958884ba9f38d969cb18331a1ceb26efe67a56","clm_98f58234783fdf14af24ec81d7c441ca7ec5e932ccd147d05774b9fd17004653","clm_a453bf089d39168f247698df16c5b1fe00808e433d1164a9eec33b95ed2ebb3