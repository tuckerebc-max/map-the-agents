{"access":"public","created_at":"2026-09-14T02:23:41Z","created_by_operation":"op_697dce27368a4a3299f1a3a4c5e3fa58","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fb4701a399e7d8cd1af279124588feefdbf202127eb9d51b4e6f8a65f6ea989e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"norvialabs/forge@8a1c5e85ec5c snapshot d8ce37fcadf8e938","timeframe":null},"slice_ids":["slc_0249edb547069a2a2343804d3f1be3a0793202dfefa189d731dbb1030829393a","slc_1228763fd976c6450c1b0b87e0addec937234e7d9b92534bb5748bd5ae56d234","slc_5e9e62494a1cf02271d71372c1777f222d99f08c3727120422497c6fddfbdcf4","slc_7d2a3cc2c3f8ae8cd003de0c0024eaa350b710fa7d698810585921e0e54c64c5","slc_f0099459c634d885760774ed9ae5c3b94313f0c4be0060eef35fc2d4c5068c33"],"source_ids":["src_baf994dcafae5fa59ab3a0c74139341e"],"text":"Agent shell commands run under an OS sandbox (Seatbelt on macOS, bubblewrap on Linux, WSL2's Linux sandbox on Windows) confined to the workspace, with network egress denied by default and opened only through explicit host rules via a filtering proxy.","updated_at":"2026-09-14T02:23:41Z","updated_by_operation":"op_697dce27368a4a3299f1a3a4c5e3fa58"}
