{"access":"public","created_at":"2026-09-14T03:16:41Z","created_by_operation":"op_d3e8e1b351064a13aaad3dea45c5038d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6ca490113567e120064980146f89d49054a87981caa05a987ed0fc0db32d3dcc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"superset-sh/superset@ed42524ed1d4 snapshot 3abdd6e4e089dfca","timeframe":null},"slice_ids":["slc_0188946ddfdde0b201fffeac21103c9d96ea73b21a29aa0112459d6051108992","slc_8529a83c22307000aff75dc58387f6e9f3e7da463b49c09d5ec64c3f6595e8ac"],"source_ids":["src_2e00f5e8a11e5b39908f5cc1a72c2fc0","src_3ef3c660141857748042e27e883ba4a6"],"text":"The tech stack is described as Electron, React, Tailwind, Bun, Turborepo, Vite, Biome, Drizzle ORM, Neon, and tRPC.","updated_at":"2026-09-14T03:16:41Z","updated_by_operation":"op_d3e8e1b351064a13aaad3dea45c5038d"}
{"access":"public","created_at":"2026-09-14T03:16:41Z","created_by_operation":"op_d3e8e1b351064a13aaad3dea45c5038d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_95ea37020f92407860938d24ec99da935c1134eb7fee751a3d5d241a4c41579a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"superset-sh/superset@ed42524ed1d4 snapshot 3abdd6e4e089dfca","timeframe":null},"slice_ids":["slc_5a67a9fe1fd246f5f157d55e6d0cf8aabe66a15c8c5ae36f67ffe0b856f4d750"],"source_ids":["src_3ef3c660141857748042e27e883ba4a6"],"text":"Repository development practice: plugin releases are git tags `<name>@<version>`; publishing rewrites `.agent-marketplace.json` and generated manifests, and `bun run check:plugins` runs in CI to catch skipped publish steps.","updated_at":"2026-09-14T03:16:41Z","updated_by_operation":"op_d3e8e1b351064a13aaad3dea45c5038d"}
{"access":"public","created_at":"2026-09-14T03:16:41Z","created_by_operation":"op_d3e8e1b351064a13aaad3dea45c5038d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9e4d34f44a781e92dc045a706f7eca8409b2b1c61bdb3d22625e550b8b3916a4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"superset-sh/superset@ed42524ed1d4 snapshot 3abdd6e4e089dfca","timeframe":null},"slice_ids":["slc_25db491a78acb39de89e9bed7fadc5eb63e82ab86b7b6e4ed7c3a28f7d5a334f","slc_71b56fd4509c3b3536d6dcb283bf7b8d138d7b9741068b03c078475d8a2690b4","slc_dba73dfae5dc9c41b44f5b4e4a64fa59cbd839e9911a044a8fe6e5d3326c590d","slc_f872652954ba3b71a9af861f6ebc42ea434f721a0ef2142d4d9151b394ff8e59"],"source_ids":["src_2e00f5e8a11e5b39908f5cc1a72c2fc0"],"text":"Repository development practice: contributors run `./.superset/setup.local.sh` then `bun run dev`; the setup script brings up local Postgres plus Electric via Docker and seeds a dev account, requiring Bun 1.3.14+, docker, jq, and caddy.","updated_at":"2026-09-14T03:16:41Z","updated_by_operation":"op_d3e8e1b351064a13aaad3dea45c5038d"}
{"access":"public","created_at":"2026-09-14T03:16:41Z","created_by_operation":"op_d3e8e1b351064a13aaad3dea45c5038d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ae6e5ee6b9906fa9329629d30e11d3b9ae9c9dd14665bc76aba7745ed47d102b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"superset-sh/superset@ed42524ed1d4 snapshot 3abdd6e4e089dfca","timeframe":null},"slice_ids":["slc_de7a7babdbd7f3e75716829a046ef138814ca6b1df80ff241ba959ba92a340b0"],"source_ids":["src_2e00f5e8a11e5b39908f5cc1a72c2fc0"],"text":"Agents come pre-loaded with `superset:*` skills (orchestrating parallel agents, scheduling automations, filing feedback, diagnosing issues) provisioned automatically at launch.","updated_at":"2026-09-14T03:16:41Z","updated_by_operation":"op_d3e8e1b351064a13aaad3dea45c5038d"}
