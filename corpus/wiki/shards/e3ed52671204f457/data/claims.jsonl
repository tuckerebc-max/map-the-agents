{"access":"public","created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_635fbf9564f50329643ec3cd0a2e82da528441ed8ad4ab924b9d327b263a0a5e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"sourcebot-dev/sourcebot@c0d0df91a6b9 snapshot cedbf25d27012bb1","timeframe":null},"slice_ids":["slc_8aea7bdd1bc9d3bd7d3dbf278d36e87989f422dd15391e5bb40fc9a42740cd24"],"source_ids":["src_ee14423fd26d57ccb6f5ccebaf40064b"],"text":"The backend worker incrementally syncs with code hosts such as GitHub and GitLab and asynchronously indexes configured repositories; Zoekt is the trigram indexing search engine powering Sourcebot.","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
{"access":"public","created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_682f0cb823cf1f791bfffd2e73a5318e9ef3867784ea8b14556697d1fbe7659f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"sourcebot-dev/sourcebot@c0d0df91a6b9 snapshot cedbf25d27012bb1","timeframe":null},"slice_ids":["slc_73d88c77901836794bea836143c47021216dfcc8d07cc92f37bf782b18e13d99","slc_93f03a650df549c03c6f799d09978d231d749bd0865bf8e92515d1e4730b8a49"],"source_ids":["src_b3850885a4b95cddb707a03b2877a176"],"text":"Synced skills are shown only to users who can access the source repository, and sharing one warns before publishing when repository permission syncing is enabled.","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
{"access":"public","created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_68698d2f00d264be4b7298b62bd4d4005fba6438a841674a17cb9afa965c8fc3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"sourcebot-dev/sourcebot@c0d0df91a6b9 snapshot cedbf25d27012bb1","timeframe":null},"slice_ids":["slc_5f58dd0398f0fd9f7975eb6cb47d35432d1ee4396547e2a6ea6d293f3d56cd74"],"source_ids":["src_b1ba5a60f15356159224f7475798e335"],"text":"Sourcebot is configured through a JSON config file (with a schema and comment support) that defines connections, which repositories to index, language model providers, and auth providers.","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
