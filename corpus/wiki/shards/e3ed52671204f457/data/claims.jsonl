{"access":"public","created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a2d889e660e5a8c3d6d03fb2de84ebeeb6de7b6bc654467b3225f0b7d0536ae2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"sourcebot-dev/sourcebot@c0d0df91a6b9 snapshot cedbf25d27012bb1","timeframe":null},"slice_ids":["slc_1f770057f7ab6bdcac38283cb77a55274563d93ed8819af75a37d92d215dad57"],"source_ids":["src_b1ba5a60f15356159224f7475798e335"],"text":"Sourcebot collects anonymous usage data by default; this can be disabled by setting the SOURCEBOT_TELEMETRY_DISABLED environment variable to true.","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
{"access":"public","created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b56f1a275c7b156c416a124e6cf338aceec4ede0b834559e0da6f60c94f22511","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"sourcebot-dev/sourcebot@c0d0df91a6b9 snapshot cedbf25d27012bb1","timeframe":null},"slice_ids":["slc_408f13f928b207026268789030bbc4a0549300d3e236d5ac2efb6d7ff14d328e","slc_5ae76ce757cad3688be387153f1a95cfad835c19bf6f24f9df0023bfad300f5d","slc_77d4c3e3287ee767acb3c69bc5fb7f2dc4f0570d342a9df15b4cc2ab103f6d3a","slc_a33eb0a0223e021b100d157a306f47490e979a58eaa9b937a504b999653bc888"],"source_ids":["src_7d62500df7065eb3841d09c1fa67133e"],"text":"Paid subscriptions activate by default via an Activation Code requiring periodic service pings; deployments failing to ping for 7 days downgrade to the free plan, and offline License Key activation is available on request via SOURCEBOT_EE_LICENSE_KEY.","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
