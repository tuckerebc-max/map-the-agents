{"access":"public","created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e1e152ff8b87012459d303f8a81c321258a9c8460fcba834bf2c892fe78477d9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"sourcebot-dev/sourcebot@c0d0df91a6b9 snapshot cedbf25d27012bb1","timeframe":null},"slice_ids":["slc_8aea7bdd1bc9d3bd7d3dbf278d36e87989f422dd15391e5bb40fc9a42740cd24","slc_e7ccd58dad1866fb6f5c439c9aba868e41220a73aca6f0fbd007a3ad6574e1be"],"source_ids":["src_ee14423fd26d57ccb6f5ccebaf40064b"],"text":"A `.sourcebot/` file-system cache stores persistent data, and managed Redis/Postgres can run outside the container via the REDIS_URL and DATABASE_URL environment variables.","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
