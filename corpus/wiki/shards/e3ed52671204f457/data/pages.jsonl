ce36412","maturity":"draft","page_type":"entity","path":"pages/entities/sourcebot-dev-sourcebot-5d9f9ce36412.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"sourcebot-dev/sourcebot","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_b56f1a275c7b156c416a124e6cf338aceec4ede0b834559e0da6f60c94f22511"],"opposing_claim_ids":[],"text":"Paid subscriptions activate by default via an Activation Code requiring periodic service pings; deployments failing to ping for 7 days downgrade to the free plan, and offline License Key activation is available on request via SOURCEBOT_EE_LICENSE_KEY."}],"claim_ids":["clm_b56f1a275c7b156c416a124e6cf338aceec4ede0b834559e0da6f60c94f22511"],"created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","id":"pg_35baa546aae55d70a104f62402539cfd","maturity":"draft","page_type":"source","path":"pages/sources/sourcebot-dev-sourcebot-docs-docs-activating-a-subscription-mdx-c0d0df-f62402539cfd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7d62500df7065eb3841d09c1fa67133e"],"title":"sourcebot-dev/sourcebot/docs/docs/activating-a-subscription.mdx @ c0d0df91a6b9","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_48f97af79ce101c738b634bb6bf4cf59c00ffe056ed237866765fd8cca45eb82"],"opposing_claim_ids":[],"text":"The product depends on Zoekt (Sourcegraph's open-source trigram search engine), Postgres, Redis with BullMQ, and supervisord within its container."},{"claim_ids":["clm_635fbf9564f50329643ec3cd0a2e82da528441ed8ad4ab924b9d327b263a0a5e"],"opposing_claim_ids":[],"text":"The backend worker incrementally syncs with code hosts such as GitHub and GitLab and asynchronously indexes configured repositories; Zoekt is the trigram indexing search engine powering Sourcebot."},{"claim_ids":["clm_ba17d2a74b1da070ec8360db1bc4fd0f4148d9f60c613f9e82a33e72cafbf119"],"opposing_claim_ids":[],"text":"Sourcebot ships as a single Docker container running multiple services under supervisord, including a Next.js web server, a Node.js backend worker, Zoekt, Postgres, and a Redis job queue used with BullMQ."},{"claim_ids":["clm_e1e152ff8b87012459d303f8a81c321258a9c8460fcba834bf2c892fe78477d9"],"opposing_claim_ids":[],"text":"A `.sourcebot/` file-system cache stores persistent data, and managed Redis/Postgres can run outside the container via the REDIS_URL and DATABASE_URL environment variables."}],"claim_ids":["clm_48f97af79ce101c738b634bb6bf4cf59c00ffe056ed237866765fd8cca45eb82","clm_635fbf9564f50329643ec3cd0a2e82da528441ed8ad4ab924b9d327b263a0a5e","clm_ba17d2a74b1da070ec8360db1bc4fd0f4148d9f60c613f9e82a33e72cafbf119","clm_e1e152ff8b87012459d303f8a81c321258a9c8460fcba834bf2c892fe78477d9"],"created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","id":"pg_a845e739fce25ebf8244f1a5f8124276","maturity":"draft","page_type":"source","path":"pages/sources/sourcebot-dev-sourcebot-docs-docs-misc-architecture-mdx-c0d0df91a6b9-f1a5f8124276.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ee14423fd26d57ccb6f5ccebaf40064b"],"title":"sourcebot-dev/sourcebot/docs/docs/misc/architecture.mdx @ c0d0df91a6b9","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_68698d2f00d264be4b7298b62bd4d4005fba6438a841674a17cb9afa965c8fc3"],"opposing_claim_ids":[],"text":"Sourcebot is configured through a JSON config file (with a schema and comment support) that defines connections, which repositories to index, language model providers, and auth providers."},{"claim_ids":["clm_93320c74f21cb81d44c89b1cb83313b63b7278409e5c59b429ee5bd76705c92b"],"opposing_claim_ids":[],"text":"After deployment via docker compose, the product is accessed at http://localhost:3000."},{"claim_ids":["clm_a2d889e660e5a8c3d6d03fb2de84ebeeb6de7b6bc654467b3225f0b7d0536ae2"],"opposing_claim_ids":[],"text":"Sourcebot collects anonymous usage data by default; this can be disabled by setting the SOURCEBOT_TELEMETRY_DISABLED environment variable to true."},{"claim_ids":["clm_c251b59b2e9868eefd9ac0888864c2634c58d6c866e2c7d0773b5472255c10d3"],"opposing_claim_ids":[],"text":"Repository development practice: docs previewing uses the Mintlify CLI (npm i -g mintlify, then mintlify dev in the folder containing docs.json), and building Sourcebot from source for contribution is described in CONTRIBUTING.md."}],"claim_ids":["clm_68698d2f00d264be4b7298b62bd4d4005fba6438a841674a17cb9afa965c8fc3","clm_93320c74f21cb81d44c89b1cb83313b63b7278409e5c59b429ee5bd76705c92b","clm_a2d889e660e5a8c3d6d03fb2de84ebeeb6de7b6bc654467b3225f0b7d0536ae2","clm_c251b59b2e9868eefd9ac0888864c2634c58d6c866e2c7d0773b5472255c10d3"],"created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","id":"pg_b55d8fc626d95601844239edc5fe0ec3","maturity":"draft","page_type":"source","path":"pages/sources/sourcebot-dev-sourcebot-readme-md-c0d0df91a6b9-39edc5fe0ec3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b1ba5a60f15356159224f7475798e335"],"title":"sourcebot-dev/sourcebot/README.md @ c0d0df91a6b9","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_682f0cb823cf1f791bfffd2e73a5318e9ef3867784ea8b14556697d1fbe7659f"],"opposing_claim_ids":[],"text":"Synced skills are shown only to users who can access the source repository, and sharing one warns before publishing when repository permission syncing is enabled."},{"claim_ids":["clm_cd3e569a8fef081afb7aa44f7e2d2ac9e95656dd5b9ebc95947aed1cc397c2c5"],"opposing_claim_ids":[],"text":"Skills are reusable context for Ask Sourcebot with four fields (name, command, description, instructions), invoked via slash commands like /deep-research, and can be personal or shared within a workspace."},{"claim_ids":["clm_ec2ee541c08154080dd6a44af122f3f84eaac9525ef27e16ad7e8b8607aa83c6"],"opposing_claim_ids":[],"text":"Skills can be created directly, imported from local .md/.markdown files (front matter prefills name, command, description), or imported from an indexed repository and kept synced to that file."}],"claim_ids":["clm_682f0cb823cf1f791bfffd2e73a5318e9ef3867784ea8b14556697d1fbe7659f","clm_cd3e569a8fef081afb7aa44f7e2d2ac9e95656dd5b9ebc95947aed1cc397c2c5","clm_ec2ee541c08154080dd6a44af122f3f84eaac9525ef27e16ad7e8b8607aa83c6"],"created_at":"2026-09-14T04:23:33Z","created_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24","id":"pg_c0231643db3155e999432cf05fc7072e","maturity":"draft","page_type":"source","path":"pages/sources/sourcebot-dev-sourcebot-docs-docs-features-ask-skills-mdx-c0d0df91a6b9-2cf05fc7072e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b3850885a4b95cddb707a03b2877a176"],"title":"sourcebot-dev/sourcebot/docs/docs/features/ask/skills.mdx @ c0d0df91a6b9","updated_at":"2026-09-14T04:23:33Z","updated_by_operation":"op_f30e69f6ea4a4f288e91d1c09762bf24"}
