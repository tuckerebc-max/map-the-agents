a7","clm_b63b4de204995b0ed3faaadccda99af5155dcf4e1b5980d0213ccc94c9a90b96","clm_bb3d0a08c6a284c4f9a748e158fa74040034b7dde946ed3e72e17f6ed5ef9fd9","clm_bd4505dee201110d7c9836be244985bad7c075cbafaa9466bfa51ccb6317d424","clm_efbf992a5888069ec2fbe2e14fa1d69bf14a4dbf97fdc6926b448bc3d8f31519"],"created_at":"2026-09-14T02:18:45Z","created_by_operation":"op_0bb14efe695d4eddae2390bc8b118542","id":"pg_46ccd80c9d815cc2b34b587b5c7ad5bc","maturity":"draft","page_type":"entity","path":"pages/entities/microsoft-autogen-587b5c7ad5bc.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"microsoft/autogen","updated_at":"2026-09-14T02:18:45Z","updated_by_operation":"op_0bb14efe695d4eddae2390bc8b118542"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3ca4af0aa5f57ad4fcd451626872f05a37578096bb03d80ea0fec9f83d2f66bb"],"opposing_claim_ids":[],"text":"Documented limitations include inherited LLM weaknesses (bias, limited contextual understanding, hallucination) and multi-agent risks around privacy, accountability, and code execution safety."},{"claim_ids":["clm_addeb9b4bcdf65773dcc06914a548a91a8386420c500ae08c94b05e55dcaa6a7"],"opposing_claim_ids":[],"text":"Per the transparency FAQs, AutoGen was evaluated on six applications using success-based metrics, tested for prompt-injection harms, and achieved SOTA on the GAIA benchmark as of March 1, 2024."}],"claim_ids":["clm_3ca4af0aa5f57ad4fcd451626872f05a37578096bb03d80ea0fec9f83d2f66bb","clm_addeb9b4bcdf65773dcc06914a548a91a8386420c500ae08c94b05e55dcaa6a7"],"created_at":"2026-09-14T02:18:45Z","created_by_operation":"op_0bb14efe695d4eddae2390bc8b118542","id":"pg_692204235c87566284e85bf5c9b911ea","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-autogen-transparency-faqs-md-027ecf0a379b-5bf5c9b911ea.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d74f68834ba552e3bd9c63f1f997e0ae"],"title":"microsoft/autogen/TRANSPARENCY_FAQS.md @ 027ecf0a379b","updated_at":"2026-09-14T02:18:45Z","updated_by_operation":"op_0bb14efe695d4eddae2390bc8b118542"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2d55bf39fbae7b9453b0e80a99c41da8aa3016114ca53170050ed206aa1ba9bc"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are limited to bug fixes, security patches, and documentation improvements due to maintenance mode; feature work is directed to Microsoft Agent Framework."},{"claim_ids":["clm_330836a4a50bbb767c6e49ba6e95a1b1b97b00314b4f17d49583b1fc38df6ba9"],"opposing_claim_ids":[],"text":"The project uses the MIT license for code and CC-BY-4.0 for documentation; releases to the pyautogen PyPI package were blocked by a package-ownership change, moving to multiple packages."},{"claim_ids":["clm_35c00beb1130a998359aa5e584296e03aaac4d5f1c02c554cbed8cf3d82e6cc6"],"opposing_claim_ids":[],"text":"AssistantAgent accepts a model client, optional workbench or tools, streaming flag, and max_tool_iterations; agents run via async run/run_stream with Console output."},{"claim_ids":["clm_47a6e7c39c21669081cecbc3d27337519f68ac4fc69fedbbfecd056c957147bc"],"opposing_claim_ids":[],"text":"The framework is layered: Core API (message passing, event-driven agents, local/distributed runtime), AgentChat API (higher-level prototyping), and Extensions API (LLM clients, code execution)."},{"claim_ids":["clm_546ca5cf8918e1fb8d375053658ed3d7f71b450d1dbfc0877fcea093d30d330d"],"opposing_claim_ids":[],"text":"Agents can use MCP servers via McpWorkbench with StdioServerParams; the docs warn to connect only to trusted MCP servers since they may execute commands locally or expose sensitive data."},{"claim_ids":["clm_9d40236228cc60a339508b86c97c2817f585d7b6889615fc496a7c53b1b06654"],"opposing_claim_ids":[],"text":"AutoGen is a framework for building multi-agent AI applications that can act autonomously or work alongside humans."},{"claim_ids":["clm_a54b1a255c8ff6bff0a44e46b6f8a297017157bca813c06a2f907d7f83157c77"],"opposing_claim_ids":[],"text":"The project is in maintenance mode: no new features or enhancements, community-managed, with Microsoft Agent Framework recommended for new users."},{"claim_ids":["clm_b63b4de204995b0ed3faaadccda99af5155dcf4e1b5980d0213ccc94c9a90b96"],"opposing_claim_ids":[],"text":"AgentTool wraps an agent as a tool so a coordinator agent can invoke expert agents, enabling basic multi-agent orchestration with up to max_tool_iterations tool calls."},{"claim_ids":["clm_bb3d0a08c6a284c4f9a748e158fa74040034b7dde946ed3e72e17f6ed5ef9fd9"],"opposing_claim_ids":[],"text":"AutoGen Studio provides a no-code GUI for prototyping multi-agent workflows, launched with 'autogenstudio ui --port 8080 --appdir ./my-app'; it is explicitly not production-ready."},{"claim_ids":["clm_efbf992a5888069ec2fbe2e14fa1d69bf14a4dbf97fdc6926b448bc3d8f31519"],"opposing_claim_ids":[],"text":"AutoGen requires Python 3.10 or later; AgentChat and the OpenAI extension are installed via pip packages autogen-agentchat and autogen-ext[openai]."}],"claim_ids":["clm_2d55bf39fbae7b9453b0e80a99c41da8aa3016114ca53170050ed206aa1ba9bc","clm_330836a4a50bbb767c6e49ba6e95a1b1b97b00314b4f17d49583b1fc38df6ba9","clm_35c00beb1130a998359aa5e584296e03aaac4d5f1c02c554cbed8cf3d82e6cc6","clm_47a6e7c39c21669081cecbc3d27337519f68ac4fc69fedbbfecd056c957147bc","clm_546ca5cf8918e1fb8d375053658ed3d7f71b450d1dbfc0877fcea093d30d330d","clm_9d40236228cc60a339508b86c97c2817f585d7b6889615fc496a7c53b1b06654","clm_a54b1a255c8ff6bff0a44e46b6f8a297017157bca813c06a2f907d7f83157c77","clm_b63b4de204995b0ed3faaadccda99af5155dcf4e1b5980d0213ccc94c9a90b96","clm_bb3d0a08c6a284c4f9a748e158fa74040034b7dde946ed3e72e17f6ed5ef9fd9","clm_efbf992a5888069ec2fbe2e14fa1d69bf14a4dbf97fdc6926b448bc3d8f31519"],"created_at":"2026-09-14T02:18:45Z","created_by_operation":"op_0bb14efe695d4eddae2390bc8b118542","id":"pg_a36f78820bdf5cc696434c2c1b58b39c","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-autogen-readme-md-027ecf0a379b-4c2c1b58b39c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1ae8718794c45b7b83c6c1a7cfef43d9"],"title":"microsoft/autogen/README.md @ 027ecf0a379b","updated_at":"2026-09-14T02:18:45Z","updated_by_operation":"op_0bb14efe695d4eddae2390bc8b118542"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_330836a4a50bbb767c6e49ba6e95a1b1b97b00314b4f17d49583b1fc38df6ba9"],"opposing_claim_ids":[],"text":"The project uses the MIT license for code and CC-BY-4.0 for documentation; releases to the pyautogen PyPI package were blocked by a package-ownership change, moving to multiple packages."},{"claim_ids":["clm_6bdca59a416cee2be145e17241c009046405d30d7fa89f30835f0eefc98949ca"],"opposing_claim_ids":[],"text":"AutoGen 0.4 is a ground-up rewrite featuring asynchronous messaging, scalable distributed agents, modular design, cross-language (.NET/Python) support, and full typing."}],"claim_ids":["clm_330836a4a50bbb767c6e49ba6e95a1b1b97b00314b4f17d49583b1fc38df6ba9","clm_6bdca59a416cee2be145e17241c009046405d30d7fa89f30835f0eefc98949ca"],"created_at":"2026-09-14T02:18:45Z","created_by_operation":"op_0bb14efe695d4eddae2390bc8b118542","id":"pg_c75a0ec06bee5cc7aa9c2c52bd1c1fbd","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-autogen-faq-md-027ecf0a379b-2c52bd1c1fbd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_cbda6aac45145b26a35d4d4d83dcb50d"],"title":"microsoft/autogen/FAQ.md @ 027ecf0a379b","updated_at":"2026-09-14T02:18:45Z","updated_by_operation":"op_0bb14efe695d4eddae2390bc8b118542"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_bd4505dee201110d7c9836be244985bad7c075cbafaa9466bfa51ccb6317d424"],"opposing_claim_ids":[],"text":"Topics route published messages to agents; a TopicId has type and source, subscriptions use side-effect-free matcher and mapper functions, and the runtime instantiates agents on demand."}],"claim_ids":["clm_bd4505dee201110d7c9836be244985bad7c075cbafaa9466bfa51ccb6317d424"],"created_at":"2026-09-14T02:18:45Z","created_by_operation":"op_0bb14efe695d4eddae2390bc8b118542","id":"pg_daaadf6fc4dc5eeca6f19d735f4b8455","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-autogen-docs-design-02-topics-md-027ecf0a379b-9d735f4b8455.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3c70f2645d955e0aade40e1a59b318de"],"title":"microsoft/autogen/docs/design/02 - Topics.md @ 027ecf0a379b","updated_at":"2026-09-14T02:18:45Z","updated_by_operation":"op_0bb14efe695d4eddae2390bc8b118542"}
