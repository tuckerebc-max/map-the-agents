{"access":"public","created_at":"2026-09-14T02:18:47Z","created_by_operation":"op_b10939b97790482c8557ec3f863024e1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0a2afd9e25f4df890442fbb2a935d4b6590b78bc05d643cb5615b9be7813f1b1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"microsoft/webwright@bc26750af3ad snapshot 884112d832b1b36a","timeframe":null},"slice_ids":["slc_8b71d8adfbd5ea7c720612448bf0fbc09a25ee8513e5463b93ce72cad0bb8d6f","slc_9b10c1dfeb0f2c074d1485de30e24c6e951c60dd01d0ec364e70e0c2393f6cb6","slc_b5c0daf67392b4031d81a759692b76bfe65c4096dd293d993a992f41761e37f9","slc_fafc274535e57c8ca76a887011b98365581d886a4242ed53aa02ab1563fcc338"],"source_ids":["src_21b70ef63cd25f278edb3c8aaa7227d4"],"text":"Webwright ships plugin manifests for Claude Code and OpenAI Codex plus a shared skills/webwright/ folder usable by OpenClaw and Hermes; Claude Code offers /webwright:run (one-shot script) and /webwright:craft (parameterized argparse CLI tool) slash commands.","updated_at":"2026-09-14T02:18:47Z","updated_by_operation":"op_b10939b97790482c8557ec3f863024e1"}
