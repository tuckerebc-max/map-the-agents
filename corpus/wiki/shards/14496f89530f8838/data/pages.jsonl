{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_c32702d4528c66a9f9b2253d2cd2eea72d28794184acf3da111b5b969295f6f1"],"opposing_claim_ids":[],"text":"The tool is powered by Gemini 2.5 Pro by default with support for other models such as Gemini 1.5 Pro, and requires a Google API key configured via `gemini setup`."},{"claim_ids":["clm_d70b0a6afec5f6bbeba4ac80a78c758df931667f6f8ebd1e94c47cbd4583cc1f"],"opposing_claim_ids":[],"text":"Logs are documented as not persistent between sessions."},{"claim_ids":["clm_db359971d16c28036788ca5ecee633676d2ea3b48e25c21d84672bb5208bfc18"],"opposing_claim_ids":[],"text":"Interactive sessions support in-chat commands including `/exit` to leave the session and `/help` to display help information."},{"claim_ids":["clm_f029ec0e629e5ad43e70585bc34f37ee6c2414434a59941a54bdcddb2aa1ec55"],"opposing_claim_ids":[],"text":"Configuration and API keys are stored in `~/.config/gemini-code/config.yaml`, and the README notes basic history management that prevents excessive conversation length."}],"claim_ids":["clm_c32702d4528c66a9f9b2253d2cd2eea72d28794184acf3da111b5b969295f6f1","clm_d70b0a6afec5f6bbeba4ac80a78c758df931667f6f8ebd1e94c47cbd4583cc1f","clm_db359971d16c28036788ca5ecee633676d2ea3b48e25c21d84672bb5208bfc18","clm_f029ec0e629e5ad43e70585bc34f37ee6c2414434a59941a54bdcddb2aa1ec55"],"created_at":"2026-09-14T02:34:11Z","created_by_operation":"op_6fc90d7a244242228d0b761596920e7f","id":"pg_444f056aba325b6695689b4f57dc8b00","maturity":"draft","page_type":"source","path":"pages/sources/raizamartin-gemini-code-install-md-6da9a30cb311-9b4f57dc8b00.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3a707ab6bd075767a4b87d23ad5b09f9"],"title":"raizamartin/gemini-code/INSTALL.md @ 6da9a30cb311","updated_at":"2026-09-14T02:34:11Z","updated_by_operation":"op_6fc90d7a244242228d0b761596920e7f"}
