{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4ffb3e9ca4010e6a905e2af3b7379c50fa9545ce38b76f1836ee799dcf2d398d"],"opposing_claim_ids":[],"text":"Setup requires creating a userData directory for the database and applying Drizzle migrations via npm run db:generate and db:push; Drizzle Studio can inspect the database."},{"claim_ids":["clm_5297982905ed3de5de6e4276ff9dea54727f562eb26e775371e98ed0e6074eb9"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are told to set up pre-commit hooks (recommended), run unit tests with npm test, run E2E tests after npm run pre:e2e, and submit PRs from feature branches."},{"claim_ids":["clm_9ea742a2514684521e227cc6151ccfc2b0759477f4959c7e83c2ba1c1aaf3b0e"],"opposing_claim_ids":[],"text":"Prerequisites are Node.js >=20 with npm or pnpm (pnpm recommended); the app runs in development mode via npm start as an Electron app."},{"claim_ids":["clm_b9b930f752094d0d97aedbd9ade491c93274c3ddfbc5879e0c45d40553825703"],"opposing_claim_ids":[],"text":"The roadmap marks React, Next.js, Vue 3, Django, FastAPI, Flask, Node.js, and multiple LLM providers (OpenAI, Gemini, Claude, Bedrock, etc.) as supported, with Angular, Rails, Mistral and others planned."}],"claim_ids":["clm_4ffb3e9ca4010e6a905e2af3b7379c50fa9545ce38b76f1836ee799dcf2d398d","clm_5297982905ed3de5de6e4276ff9dea54727f562eb26e775371e98ed0e6074eb9","clm_9ea742a2514684521e227cc6151ccfc2b0759477f4959c7e83c2ba1c1aaf3b0e","clm_b9b930f752094d0d97aedbd9ade491c93274c3ddfbc5879e0c45d40553825703"],"created_at":"2026-09-14T03:12:51Z","created_by_operation":"op_d7b5815e376a45519c6494097963f07e","id":"pg_4ee11c827dcb5aaaa7b96e73e102f686","maturity":"draft","page_type":"source","path":"pages/sources/sfarpak-alifullstack-readme-md-c34f5cfea36d-6e73e102f686.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_cae1b7f5eeb15379a8ad950b011f61e6"],"title":"SFARPak/AliFullStack/README.md @ c34f5cfea36d","updated_at":"2026-09-14T03:12:51Z","updated_by_operation":"op_d7b5815e376a45519c6494097963f07e"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4fd33eb8dd77e4f614721f403745f83d1a9074b319b69f27651606b391ca72aa"],"opposing_claim_ids":[],"text":"The product appears to integrate with external services including Supabase, GitHub, Vercel, and Neon, based on the integration test cases described in the test plan."},{"claim_ids":["clm_709458d070e718dcacc711daced80098b9d75218aa290c5b6cd94c34dd348aa4"],"opposing_claim_ids":[],"text":"Repository development practice: a functional Selenium test plan (Java/TestNG, WireMock, H2) is outlined covering app creation, chat, integrations, data persistence, errors, and performance suites."}],"claim_ids":["clm_4fd33eb8dd77e4f614721f403745f83d1a9074b319b69f27651606b391ca72aa","clm_709458d070e718dcacc711daced80098b9d75218aa290c5b6cd94c34dd348aa4"],"created_at":"2026-09-14T03:12:51Z","created_by_operation":"op_d7b5815e376a45519c6494097963f07e","id":"pg_5142f070a32f506c8459fc2ee008788e","maturity":"draft","page_type":"source","path":"pages/sources/sfarpak-alifullstack-functional-selenium-test-plan-md-c34f5cfea36d-fc2ee008788e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_139d44195bbd5b28873d918cf33c9ad4"],"title":"SFARPak/AliFullStack/functional_selenium_test_plan.md @ c34f5cfea36d","updated_at":"2026-09-14T03:12:51Z","updated_by_operation":"op_d7b5815e376a45519c6494097963f07e"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:12:51Z","created_by_operation":"op_d7b5815e376a45519c6494097963f07e","id":"pg_a0fc8fdda7dc5ca9a3dda84812fd178a","maturity":"draft","page_type":"source","path":"pages/sources/sfarpak-alifullstack-git-push-issues-md-c34f5cfea36d-a84812fd178a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_03298d042d325b1fbcccbd93f88c6608"],"title":"SFARPak/AliFullStack/GIT_PUSH_ISSUES.md @ c34f5cfea36d","updated_at":"2026-09-14T03:12:51Z","updated_by_operation":"op_d7b5815e376a45519c6494097963f07e"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:12:51Z","created_by_operation":"op_d7b5815e376a45519c6494097963f07e","id":"pg_a98948634fd353ceb476ccde63d0f2ec","maturity":"draft","page_type":"source","path":"pages/sources/sfarpak-alifullstack-ai-rules-3d-md-c34f5cfea36d-ccde63d0f2ec.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6077ffdff213514d802f9c2d7c557c98"],"title":"SFARPak/AliFullStack/AI_RULES_3D.md @ c34f5cfea36d","updated_at":"2026-09-14T03:12:51Z","updated_by_operation":"op_d7b5815e376a45519c6494097963f07e"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_49a0589fea1c5337f79148f7c5f3bac3fc0f43cbcfd76179ea3c05b4f73437c8"],"opposing_claim_ids":[],"text":"By default each LLM request includes the entire codebase as context; a Smart Context feature uses smaller models to filter important files, and agentic codebase search is avoided for cost reasons."},{"claim_ids":["clm_abd49e09e6341098acb9293f5aa4af67e54811ca7eb79a95dc4e2e80e7614579"],"opposing_claim_ids":[],"text":"The system prompt instructs the LLM to respond using XML-like tags such as <alifullstack-write>, which a specialized Markdown parser renders in the UI and a response processor executes."},{"claim_ids":["clm_c20989b80e2b6f41b85e74cd7411d5620889402f272d8349028797a08938afbc"],"opposing_claim_ids":[],"text":"The architecture doc acknowledges AliFullStack is less agentic than tools like Cursor, which plan, search codebases, run linters/tests, and auto-fix code."},{"claim_ids":["clm_ca9f5f9f2c87b2eb058e09776795403a329eec0ba07805a5d6d3d36977116a0f"],"opposing_claim_ids":[],"text":"The project deliberately simulates tool calling with XML-like tags instead of native function calling, citing support for many simultaneous calls and evidence that JSON-embedded code degrades quality."},{"claim_ids":["clm_dbc9c924f27f4bea7ee61cfecf0978cba724dc9d2b9fe2f474a8200c0be24ef1"],"opposing_claim_ids":[],"text":"AliFullStack is an Electron desktop app with a sandboxed renderer process for the React UI and a privileged Node.js main process, communicating via IPC."},{"claim_ids":["clm_eea60684e3ef061c2f2b2f4e4dc2ee6cf431226acdc5b21ab9d5cc3e29a67920"],"opposing_claim_ids":[],"text":"The agentic loop is intentionally simple: typically a single LLM request per user prompt, with optional TypeScript auto-fix, avoiding complex multi-step agent workflows to control cost."}],"claim_ids":["clm_49a0589fea1c5337f79148f7c5f3bac3fc0f43cbcfd76179ea3c05b4f73437c8","clm_abd49e09e6341098acb9293f5aa4af67e54811ca7eb79a95dc4e2e80e7614579",