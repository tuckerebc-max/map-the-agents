{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_620c8ca987a08b92188ef8ac08e403edde0b3af25f50a365292b8282f0657b16"],"opposing_claim_ids":[],"text":"The example memory-citations mod is intentionally conservative: it observes memory paths passed to tools at tool_start (before execution), not successful reads, and marks shell-command matches as medium confidence."},{"claim_ids":["clm_ba1bf2a9771b6650f3912fdcc2dbfb5ac4a52bf4f56f82ec7c51dea906a1bfb4"],"opposing_claim_ids":[],"text":"A mod-learning harness (scripts/mod-learning/learn-mod.ts) runs a headless agent to generate a candidate mod, then a second headless eval with LETTA_MODS_DIR pointed at it, saving prompts, output, and a pass/fail report under .letta/mod-learning-runs/."},{"claim_ids":["clm_d338eb607bc396e4231717c3d02b0f41570d497fda647f9a6755aa95951af61e"],"opposing_claim_ids":[],"text":"The /mods learn TUI command never auto-installs learned mods; users must review the generated candidate before copying it into their mod directory and running /reload."}],"claim_ids":["clm_620c8ca987a08b92188ef8ac08e403edde0b3af25f50a365292b8282f0657b16","clm_ba1bf2a9771b6650f3912fdcc2dbfb5ac4a52bf4f56f82ec7c51dea906a1bfb4","clm_d338eb607bc396e4231717c3d02b0f41570d497fda647f9a6755aa95951af61e"],"created_at":"2026-09-14T02:12:21Z","created_by_operation":"op_2f9e92b7c1f547c283e850d26069cf7d","id":"pg_01aefb49e79053c7b5e3c384b538bd70","maturity":"draft","page_type":"source","path":"pages/sources/letta-ai-letta-code-docs-examples-mods-readme-md-f2bd2392a824-c384b538bd70.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a1638063f650540daf5a1f1887067ac7"],"title":"letta-ai/letta-code/docs/examples/mods/README.md @ f2bd2392a824","updated_at":"2026-09-14T02:12:21Z","updated_by_operation":"op_2f9e92b7c1f547c283e850d26069cf7d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_a5af5e66f9b7ec630cf5849be87015b824226d2caa4e8cb36fafeda8d6bc02b6"],"opposing_claim_ids":[],"text":"A plan document specifies a bounded resume-tail fast path for boot/resume, with a backend getConversationResumeTail operation returning messages and pending approvals, and forbids conversation enumeration during normal boot."}],"claim_ids":["clm_a5af5e66f9b7ec630cf5849be87015b824226d2caa4e8cb36fafeda8d6bc02b6"],"created_at":"2026-09-14T02:12:21Z","created_by_operation":"op_2f9e92b7c1f547c283e850d26069cf7d","id":"pg_128a2be92a6a52288bfc2639d73d05d0","maturity":"draft","page_type":"source","path":"pages/sources/letta-ai-letta-code-docs-plans-resume-tail-fast-path-md-f2bd2392a824-2639d73d05d0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_31c1236ca2145d5381f5cf0d4496deab"],"title":"letta-ai/letta-code/docs/plans/resume-tail-fast-path.md @ f2bd2392a824","updated_at":"2026-09-14T02:12:21Z","updated_by_operation":"op_2f9e92b7c1f547c283e850d26069cf7d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0bdf3ad755279b20dc2cdf76e202c766c339f8fc0c6fa68dc16d3896c4140f43"],"opposing_claim_ids":[],"text":"Agents can be interacted with through a local CLI, a desktop app for macOS/Windows/Linux, a browser client at chat.letta.com, and messaging integrations such as Telegram, Slack, and Discord."},{"claim_ids":["clm_150b395f7f29843d07ce5140d29260b0aef513ddfb0c2c63729c720cad005f29"],"opposing_claim_ids":[],"text":"Agents rewrite their own context over time, including system-prompt learning via memory blocks and skill learning, with periodic 'dreaming' configurable via /sleeptime."},{"claim_ids":["clm_2929c9a941b9b177a2c2b23d466b31633afe5495aaf8d48cc5275ed311070e6d"],"opposing_claim_ids":[],"text":"Agent context, including memory blocks, is tracked via git under MemFS and can be synced to a user's GitHub repository via /memory-repository set."},{"claim_ids":["clm_471bc2006d66076d78180ecdd35f562327cd33eea584472c90ba5205c8beca48"],"opposing_claim_ids":[],"text":"AgentFile (.af) export/import has been removed: /export, /download, --import, and --from-af are no longer supported, though memory and transcript export are unaffected."},{"claim_ids":["clm_485351eacc6c4c9e5178ec7a259199c840e61270f7b49d3e2e77bd77589f06ee"],"opposing_claim_ids":[],"text":"The CLI exposes slash commands including /sleeptime, /doctor, /palace, /search, /memory-repository, /skills, /skill-creator, /connect, /model, and /login."},{"claim_ids":["clm_826b4ab57436728791fd3e246da44a122d50fc6f270597566eff4b816809111f"],"opposing_claim_ids":[],"text":"Built-in subagents (general-purpose, forked, recall, history-analyzer) can run in the background, and agents can call any other agent, including themselves, as subagents."},{"claim_ids":["clm_88f8897dcdd82b2bc128f44a6edd2889a2dd609032981ea5f72c689fa5a80245"],"opposing_claim_ids":[],"text":"Letta Code is distributed as the npm package @letta-ai/letta-code, installed globally via npm, and run with the `letta` command in a project directory."},{"claim_ids":["clm_aa91f3cd8e00f1038f0642b4ddad49270ffd46eff271899f42bb88928a5560ef"],"opposing_claim_ids":[],"text":"Skills load from global (~/.letta), project-scoped (.agents/skills), and agent-scoped (MemFS) locations, and can be installed from GitHub, ClawHub, or Hermes Skills Hub with `letta skills install`."},{"claim_ids":["clm_f0b286b5159d06786ef6d6efc694c78ef59c848b171f22134e16fd8ccb31ab93"],"opposing_claim_ids":[],"text":"Cloud-stored agents can run on multiple machines: `letta server --computer-name` registers a computer, `letta computers list/current` manage routing, and `--computer` routes headless messages to a specific machine or the cloud sandbox."}],"claim_ids":["clm_0bdf3ad755279b20dc2cdf76e202c766c339f8fc0c6fa68dc16d3896c4140f43","clm_150b395f7f29843d07ce5140d29260b0aef513ddfb0c2c63729c720cad005f29","clm_2929c9a941b9b177a2c2b23d466b31633afe5495aaf8d48cc5275ed311070e6d","clm_471bc2006d66076d78180ecdd35f562327cd33eea584472c90ba5205c8beca48","clm_485351eacc6c4c9e5178ec7a259199c840e61270f7b49d3e2e77bd77589f06ee","clm_826b4ab57436728791fd3e246da44a122d50fc6f270597566eff4b816809111f","clm_88f8897dcdd82b2bc128f44a6edd2889a2dd609032981ea5f72c689fa5a80245","clm_aa91f3cd8e00f1038f0642b4ddad49270ffd46eff271899f42bb88928a5560ef","clm_f0b286b5159d06786ef6d6efc694c78ef59c848b171f22134e16fd8ccb31ab93"],"created_at":"2026-09-14T02:12:21Z","created_by_operation":"op_2f9e92b7c1f547c283e850d26069cf7d","id":"pg_1a96d35335635b3985bf0bb88ceecc1a","maturity":"draft","page_type":"source","path":"pages/sources/letta-ai-letta-code-readme-md-f2bd2392a824-0bb88ceecc1a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_cf78e11954445d4b8b89cd2fedfc8e17"],"title":"letta-ai/letta-code/README.md @ f2bd2392a824","updated_at":"2026-09-14T02:12:21Z","updated_by_operation":"op_2f9e92b7c1f547c283e850d26069cf7d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_6f011801553da56d6b80491e324532f5200cd8f9bd91899cd26b9947f402a5a2"],"opposing_claim_ids":[],"text":"Repository development practice: the AI policy requires contributors to disclose all AI tool usage in issues and PRs, select an authorship option, include a human-verification phrase, and noncompliant submissions are automatically closed."}],"claim_ids":["clm_6f011801553da56d6b80491e324532f5200cd8f9bd91899cd26b9947f402a5a2"],"created_at":"2026-09-14T02:12:21Z","created_by_operation":"op_2f9e92b7c1f547c283e850d26069cf7d","id":"pg_1d1a23f846a55a41b189603e807bb309","maturity":"draft","page_type":"source","path":"pages/sources/letta-ai-letta-code-ai-policy-md-f2bd2392a824-603e807bb309.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_66b2451e98be56479908d0fa1e83fa58"],"title":"letta-ai/letta-code/AI_POLICY.md @ f2bd2392a824","updated_at":"2026-09-14T02:12:21Z","updated_by_operation":"op_2f9e92b7c1f547c283e850d26069cf7d"}
