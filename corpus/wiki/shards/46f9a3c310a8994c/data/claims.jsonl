{"access":"public","created_at":"2026-09-14T02:35:18Z","created_by_operation":"op_937ee4827699493082f8c10afe9f636e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c0f087015e0f49879d441108235060bca5a30d9a2f3abd16a09c2ddd6e7435d2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"ralph-workflow/ralph-workflow@3d9d847f41fe snapshot b4e9678f061e3d05","timeframe":null},"slice_ids":["slc_27aa610eeac30c18096d7325c6ae97414041885b7f812020c0927e10814db29c"],"source_ids":["src_554234629ff25ee7ab417a0f748d4709"],"text":"The core orchestration is a Ralph loop of plan, build, verify, and fix stages run with the selected coding agent, after which the user returns to inspect the result.","updated_at":"2026-09-14T02:35:18Z","updated_by_operation":"op_937ee4827699493082f8c10afe9f636e"}
{"access":"public","created_at":"2026-09-14T02:35:18Z","created_by_operation":"op_937ee4827699493082f8c10afe9f636e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_faac9936e43b482813be191f4051587cbf7d43e452cf683a9a33fb48caac1eb8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"ralph-workflow/ralph-workflow@3d9d847f41fe snapshot b4e9678f061e3d05","timeframe":null},"slice_ids":["slc_2853346d5b5c58fa31db72a69b2469f64f9b5f3eb47afee60e8f1a674503c5ae","slc_a1c0b3a3bc2c7c9919b1919ad80d387bcfae3b6db52b815a63d801164e5d9e8e"],"source_ids":["src_8da7d3fe5da75296b1f082770dfafc72"],"text":"Repository development practice: a three-level fabrication_guard.py checks public-facing markdown, with level 1 as a pre-commit hook and levels 2-3 verifying external repos, packages, and stats against live sources.","updated_at":"2026-09-14T02:35:18Z","updated_by_operation":"op_937ee4827699493082f8c10afe9f636e"}
