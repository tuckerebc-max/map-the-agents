{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4079e9a5f95e0f3a68aeaa244c07444fee8c706f7b4003a5a4b6cf4148ffcd16"],"opposing_claim_ids":[],"text":"Memory is local-first: an on-disk Ebbinghaus decay model combining BM25, tags, and graph connections, explicitly avoiding external vector databases."},{"claim_ids":["clm_68bea434bb774ec6fbf41c2092ccdf970c965cb65b40e25e2843c39c2ed9d326"],"opposing_claim_ids":[],"text":"ADR-0001 established a constraint of no GPU, no external model, and no external API, keeping the knowledge plane CPU-only and local."}],"claim_ids":["clm_4079e9a5f95e0f3a68aeaa244c07444fee8c706f7b4003a5a4b6cf4148ffcd16","clm_68bea434bb774ec6fbf41c2092ccdf970c965cb65b40e25e2843c39c2ed9d326"],"created_at":"2026-09-14T03:31:50Z","created_by_operation":"op_f19378182a2c4d69aeaff7821e002153","id":"pg_1b7cf6fd294a5cf0a2687267f9bdae67","maturity":"draft","page_type":"source","path":"pages/sources/agnusdei1207-opencode-orchestrator-docs-adr-0001-second-brain-knowledg-7267f9bdae67.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c3d7f5978f175f359db3bd11789d9095"],"title":"agnusdei1207/opencode-orchestrator/docs/adr/0001-second-brain-knowledge-graph-rag.md @ 572c7bef8ca0","updated_at":"2026-09-14T03:31:50Z","updated_by_operation":"op_f19378182a2c4d69aeaff7821e002153"}
