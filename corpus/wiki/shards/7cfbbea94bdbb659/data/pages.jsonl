1f8a0ba91859586a7f","maturity":"draft","page_type":"entity","path":"pages/entities/agnusdei1207-opencode-orchestrator-a91859586a7f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"agnusdei1207/opencode-orchestrator","updated_at":"2026-09-14T03:31:50Z","updated_by_operation":"op_f19378182a2c4d69aeaff7821e002153"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0e4916e227129b564798719821fdf45f20a4444b2390eb7a2ece73d60ccdb77f"],"opposing_claim_ids":[],"text":"Subagents inherit the primary agent's model unless agent.<name>.model is set, and context-window alerts use the window OpenCode reports for the active model, overridable via a contextMaxTokens integer option."},{"claim_ids":["clm_142959b40873bf1780db22802ccd05deabbb1eac7acb41c77c8f3d6aa03a604c"],"opposing_claim_ids":[],"text":"A bundled Rust CLI provides an optional multi-session TCP shell listener TUI for authorized testing environments, invoked as orchestrator shell-listener with --bind and --port flags."},{"claim_ids":["clm_3c99fbdc92be9da27c0f27f88a0f16cafcf6c8d79fb973e51790cfaf381965cc"],"opposing_claim_ids":[],"text":"Repository development practice: contributors verify the TypeScript side with npm run build, npx tsc --noEmit, and npm test, and the Rust side with cargo test --workspace plus clippy with -D warnings."},{"claim_ids":["clm_4079e9a5f95e0f3a68aeaa244c07444fee8c706f7b4003a5a4b6cf4148ffcd16"],"opposing_claim_ids":[],"text":"Memory is local-first: an on-disk Ebbinghaus decay model combining BM25, tags, and graph connections, explicitly avoiding external vector databases."},{"claim_ids":["clm_41133572ef6271fd9d303657818fc1ba77699a88ed22e07ec8da62460df96c7d"],"opposing_claim_ids":[],"text":"Plugin options include per-agent concurrency limits (commander, planner, worker, reviewer) and missionLoop toggles for ledger and markdownMemory, configured in opencode.jsonc."},{"claim_ids":["clm_4cccb0839fb0030b547acebb00d394882f4a00927ac4ff178f986e7b87911777"],"opposing_claim_ids":[],"text":"The architecture defines four agents: Commander (orchestrates missions and loop state), Planner (orders file-level tasks), Worker (isolated TDD edits), and Reviewer (verifies test evidence and builds)."},{"claim_ids":["clm_550ede2b76eb3a639a2676d9d0646c05a3f514ada8f4a8c5e1e969a2f5032dc7"],"opposing_claim_ids":[],"text":"OpenCode Orchestrator is an MIT-licensed npm package (opencode-orchestrator) at version 1.7.17, described as multi-agent mission control for OpenCode with four agent roles."},{"claim_ids":["clm_c8c2f278665120378adb7d10eddff598ed0a1fb289a0d7309d00dc19dd6abf35"],"opposing_claim_ids":[],"text":"The npm install hook automatically registers the plugin in opencode.json or opencode.jsonc, and a cleanup:plugin script exists for removal before uninstalling."},{"claim_ids":["clm_d591cc9ad2d9be8715ff3625b17813939ba929df41d0cb128a12d335cf4829d5"],"opposing_claim_ids":[],"text":"Users start a mission with /task <objective>, halt it with /stop or /cancel, and pause loop continuation with Esc interrupt; missions persist under .opencode/."}],"claim_ids":["clm_0e4916e227129b564798719821fdf45f20a4444b2390eb7a2ece73d60ccdb77f","clm_142959b40873bf1780db22802ccd05deabbb1eac7acb41c77c8f3d6aa03a604c","clm_3c99fbdc92be9da27c0f27f88a0f16cafcf6c8d79fb973e51790cfaf381965cc","clm_4079e9a5f95e0f3a68aeaa244c07444fee8c706f7b4003a5a4b6cf4148ffcd16","clm_41133572ef6271fd9d303657818fc1ba77699a88ed22e07ec8da62460df96c7d","clm_4cccb0839fb0030b547acebb00d394882f4a00927ac4ff178f986e7b87911777","clm_550ede2b76eb3a639a2676d9d0646c05a3f514ada8f4a8c5e1e969a2f5032dc7","clm_c8c2f278665120378adb7d10eddff598ed0a1fb289a0d7309d00dc19dd6abf35","clm_d591cc9ad2d9be8715ff3625b17813939ba929df41d0cb128a12d335cf4829d5"],"created_at":"2026-09-14T03:31:50Z","created_by_operation":"op_f19378182a2c4d69aeaff7821e002153","id":"pg_973aadf123b9595a8eb4ece93e8b1aa1","maturity":"draft","page_type":"source","path":"pages/sources/agnusdei1207-opencode-orchestrator-readme-md-572c7bef8ca0-ece93e8b1aa1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_80d4998ef6cd5ba6a6d0b958e8d0ec75"],"title":"agnusdei1207/opencode-orchestrator/README.md @ 572c7bef8ca0","updated_at":"2026-09-14T03:31:50Z","updated_by_operation":"op_f19378182a2c4d69aeaff7821e002153"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_add84c8bc349ce6124a5d44d071b691113167c8e407b272f1f2fdc24946b3fb9"],"opposing_claim_ids":[],"text":"The Knowledge Search deep-dive documents a BM25/tag/graph RRF pipeline, but AGENT_MEMORY states all 14 knowledge RAG modules were deleted per ADR-0019, so that documented pipeline likely no longer exists in the current version."},{"claim_ids":["clm_e679a07acdc5d75945d27c248aefa8379dc9f72c9ea91efb4fbee202bad0fe71"],"opposing_claim_ids":[],"text":"Mission-loop state is synced to markdown notes such as scratchpad.md, knowledge-map.canvas, and episodic notes, which were made self-contained with a lightweight inline frontmatter parser."}],"claim_ids":["clm_add84c8bc349ce6124a5d44d071b691113167c8e407b272f1f2fdc24946b3fb9","clm_e679a07acdc5d75945d27c248aefa8379dc9f72c9ea91efb4fbee202bad0fe71"],"created_at":"2026-09-14T03:31:50Z","created_by_operation":"op_f19378182a2c4d69aeaff7821e002153","id":"pg_bc8bdf2a7ce25abfa83b38d7200129be","maturity":"draft","page_type":"source","path":"pages/sources/agnusdei1207-opencode-orchestrator-agent-memory-md-572c7bef8ca0-38d7200129be.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f054c1eb8eb45eafbe59c26e3111e1e5"],"title":"agnusdei1207/opencode-orchestrator/AGENT_MEMORY.md @ 572c7bef8ca0","updated_at":"2026-09-14T03:31:50Z","updated_by_operation":"op_f19378182a2c4d69aeaff7821e002153"}
