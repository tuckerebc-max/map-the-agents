{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f143f5a5703c82c46fd9c8b872a0a079ffd96ad0d3899d151ee75cb4a0562322","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_0cb207ef123caa6243f40299386d1f13b60320c3536512f0fc50a7cdf36bd401","slc_56525f62874a4867d876601e6a83a2c2933b2c0450c249402dcd6ccadbf9baf4","slc_b7fa803ab365470feefe9d2a8b3a203ec74994deb8e0b9892ac417d4db658c8e","slc_d98e73125f096eea36d2cf92bbb8337232f88d52afbca22d1bf9e8548030acd5"],"source_ids":["src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"plan-orchestrate builds batches from the task dependency graph and runs independent tasks in parallel workers, so many tasks complete in a handful of batches rather than sequentially.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
