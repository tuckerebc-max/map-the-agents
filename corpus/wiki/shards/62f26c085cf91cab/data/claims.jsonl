{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_433cada7fa89f58dbd215a6c3e8c801ec05d337a9ea357d572c94827dd697e36","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_09ba908d8540c6778cb507c5b8f3a2a9cb7996cda602f5292e2d82a625dcb1f4","slc_34371244a8f7849fd02c9b93678df15c163841c59d1fcc12f3ef35bf7cabe5ef","slc_4ad71c82a9f844a2bab4af8c86f35aaba1e6ca380ea97b5ef01be1edf1d4cf26"],"source_ids":["src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"Only devils-advocate is enrolled by default (at post-plan); standards-enforcer ships with its enrollment commented out and can be enabled by uncommenting its phase key.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.5,"id":"clm_43e04a65e57fe98db28e142c59b407dfe49e3fa4eb704b861079c96124795628","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=inference; facet=design-choices","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_77d5b3fc69405622e4903840d5976b6aafd8d7960bf0470fe026fb0137a75a4a","slc_79934d8807f8c2532636d88fbf0d79c32fb3a74ba74ae23e374caa13a38d1bad","slc_e03f09721c39db39fc5a04d2f2c4c58dd9bea23e65eed73dd7dc2211422c9e3e"],"source_ids":["src_13d8ee4f54f95c4bacf29c91d3843b39","src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"Discovery failures are treated as hard errors (exit 3 for invalid phase/mode, exit 4 for mid-run enrollment change) rather than empty hooks, reflecting a design preference for failing loudly over silently running a different pipeline.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4c36484d66c9001ef9c48d7ed1505cc9193e6632f1e0a53a49028da3fcf77a6a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_8f1765b2af99215bf8405a7585068e7cc7157e07f4161f22b2831114bb5cc73d","slc_b24b3e6b9ccfe44eab9ff50048cc26f30bf57f23e522fe679e7b9f6fbf542800"],"source_ids":["src_13d8ee4f54f95c4bacf29c91d3843b39","src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"A malformed plansDir value (absolute path, .. segment, or empty string) stops the run rather than falling back to the default plans directory, and the resolver avoids a jq dependency.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_562b20ffe41f6baf0180df973be426249164a5f1cf12287b20b26847ef55943e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_1334947cb61c74b397ef2315db9f320dfa2a6bcb3063e238bb6230a3fc7d30bd","slc_c649c4b8bc40da1d64e57b961666296be6e986cdc8dc077bcd58b0877fc07c9d","slc_c7686046b19cf6c8c299a29b0d7dfbf048670e455b0868e8ab487b5ea6658b1d","slc_d59727fcdeec46f209142bad2645282e061737f56fffd073ac8d15aff67af528"],"source_ids":["src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"Repository development practice: the plugin can be tested locally without publishing using claude --plugin-dir /path/to/hcf, with skills namespaced as /hcf:skill-name and debug output via --debug.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_716a96a96797970e9ee08444fe74a273caaefed612d85446a447e038a9ef7ebe","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_b0a80ff2ad3fde78c085c2d93bd6ddfababc5bb9e3518048d6a4de6bfc9820de","slc_d6eff9839241cffc77767f2f50178af4a339a506b4bcd983a31101b25c6ff444","slc_e30e8fc783b7c5889d52a6d7e78a4e44fa833cb867b237ea4236b3a766047ef0","slc_f44cb8bb02e9aa57609ca3ef802897db6be8a774144323034dba785864e33eb8"],"source_ids":["src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"Plans default to .claude/plans/ but a project can set a relative plansDir in an optional .claude/hcf.json; no skill creates or modifies that file, and project-update only validates it if present.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8172659147badc30166238ef254e289de08d98f567d9a76a391721e474daa679","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_1f785af46b2c17db3d2588dada8364a4607a2538337227bc7dfd878a27931fd3","slc_917c96f9cfd1c54b2001fe09d440a70ad009f6b01d1b487c9b290ce12fbc5988","slc_d3bf7f082484e716ebcf95517a6bc5b4b07c0641f54ae7d01a82e4d434676e5d","slc_fd1704efd799a99628d97e3226db864ca99b3e993727fc261543da1566aee1b5"],"source_ids":["src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"The pipeline uses convention over configuration: there is no central registry, and each agent enrolls itself by declaring a phase, order, and mode in its own YAML frontmatter.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_96f842bf8e895a2de6454b7538dfd6e88a8c2c30cc55336fb7ecab92d332f69a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_29693f12511aa9e6c3b2a9ff69af40e4dc330fcf3b44db1cd16d858c27e97a9e","slc_3c416851f7816b63313a0aa0b7313538185c49b170909b12594552d8bbd68406"],"source_ids":["src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"Run state such as task statuses, requirement checkboxes, and retry counts lives in the plan files, so an interrupted run resumes by re-running the plan; terminal outputs are ALL_TASKS_COMPLETE or TASKS_BLOCKED.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b8313bf54a7739d54148bc81fcc6939fd4770d682ef263649a5ad94d6bbeec5c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_03ae9e15bb79ecbc15cb61ba39d6258e8491e8bac0e99ad2a588e7212a201121","slc_0d5fac308d706f73d9bd6080b8905be13cf32832bc57031d64ca30acb6b69c56"],"source_ids":["src_13d8ee4f54f95c4bacf29c91d3843b39","src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"HCF does not migrate plan folders when the plans directory changes; the user must move them, and project-update warns if .claude/plans still holds plan folders after a move.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c1fd868764ed5482baf33cc8e1d18703c4d6c95fd3b5a8f62897b7f8a9471760","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_095a6c79d5d87056f7ba1ec2a7487ecc093d7ff46b4b29fcdd08638811773567","slc_7cd52b85bac3185fe12c97c3abe881e86fa9f6aeb21edceea151c34eb3d40d88"],"source_ids":["src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"HCF separates planning (human-in-the-loop, where human and AI collaborate on requirements) from execution (fully autonomous parallel TDD implementation).","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c2be8e669245e73cc1a5935749e4217e8a86014a82241f7843fb5fc865f164ad","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_a511eda5dabf2905d831de22c1ed2c7f3bd03f8170958550dad017bda6ef5b9d"],"source_ids":["src_cc12aac486fc5eaba47ec414b1dce3f0"],"text":"There is deliberately no 'execution' hook; the implementation loop is already covered by the pre/post-implementation and pre/post-batch hooks, so an execution hook would only duplicate them.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
{"access":"public","created_at":"2026-09-14T04:08:07Z","created_by_operation":"op_5cdb538348354c13ae60e49d50595313","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c82bcc38c5d66716392763634a1e48caa3203ca3a2d272fc543266900f08a203","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"markshust/hcf@9cfca7de63c3 snapshot fd7ae5cfbe800a29","timeframe":null},"slice_ids":["slc_028117664e275d792c7d467697da13c6f373be552d7b4e314ea53612376b0a7c","slc_58638d6b0acfb327704d5ae99705cbf894bb84ae85a3c27b54ef02df5e9a5c82"],"source_ids":["src_13d8ee4f54f95c4bacf29c91d3843b39","src_51935a1d6afd5aa8979c5d3815e98a57"],"text":"Repository development practice: contributors fork, create a feature branch, test locally with --plugin-dir, add a CHANGELOG [Unreleased] entry for user-visible changes, and submit a pull request; the repo's own test suite runs via ./tests/run-tests.sh with no dependencies beyond bash/awk/sed/sort/grep.","updated_at":"2026-09-14T04:08:07Z","updated_by_operation":"op_5cdb538348354c13ae60e49d50595313"}
