{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_07a9dd93100d463cf6e74e3b9d120fb151c8aba2315f4a3a2b4d40b21b52a6da"],"opposing_claim_ids":[],"text":"The run_terminal_command tool separates process ownership from terminal UI ownership via a broker; a broker startup failure prevents the shell from running with no direct-console fallback."},{"claim_ids":["clm_9f143f097156a2e43c1d93d5b1e5b78c2b536e01daf8ab5da700188ae4e90d7b"],"opposing_claim_ids":[],"text":"Shell shims let users invoke agents as direct commands without a 'codebuff' prefix, installed via 'codebuff shims install' and an env eval."}],"claim_ids":["clm_07a9dd93100d463cf6e74e3b9d120fb151c8aba2315f4a3a2b4d40b21b52a6da","clm_9f143f097156a2e43c1d93d5b1e5b78c2b536e01daf8ab5da700188ae4e90d7b"],"created_at":"2026-09-14T03:40:43Z","created_by_operation":"op_3fca469f2e2e4bfa806adc3ecd19f9a7","id":"pg_f36d0fcadebc5f0d8a4e4ad8639b1faf","maturity":"draft","page_type":"source","path":"pages/sources/codebuffai-freebuff-docs-agents-and-tools-md-654a906e6758-4ad8639b1faf.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c7c3b059cf53599ca595410f10e7d98c"],"title":"CodebuffAI/freebuff/docs/agents-and-tools.md @ 654a906e6758","updated_at":"2026-09-14T03:40:43Z","updated_by_operation":"op_3fca469f2e2e4bfa806adc3ecd19f9a7"}
