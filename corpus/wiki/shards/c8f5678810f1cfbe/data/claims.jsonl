{"access":"public","created_at":"2026-09-14T01:59:22Z","created_by_operation":"op_0081817751834b5f998fcd1366fda1f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cd7a1bf6231d79a4a7d502245a606370cbfde2e93d85bfa5efe5f906f364050c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"alibaba/open-code-review@494bf1c8d7a1 snapshot 5996e384ce40ea12","timeframe":null},"slice_ids":["slc_a4cf2d15f90037155a51cfd2129718b1cbe93eeafd5076bad60202d10c47ec9f","slc_af4de10de9173ae38a5f751088d72f9c68fb29dfe5eff230bed9f766e95f0d05","slc_cea1c78e663616edd2039b3ad7900666476505ceb1fea45f67ac8ef77945cbf9"],"source_ids":["src_57bd6ea6268855678328178e8da46cb9","src_e74ef1e59e925fa4bc60464136f4f943"],"text":"Each review session writes to its own JSONL file with no shared state between sessions, and interrupted reviews can be resumed via `--resume <session-id>`.","updated_at":"2026-09-14T01:59:22Z","updated_by_operation":"op_0081817751834b5f998fcd1366fda1f7"}
{"access":"public","created_at":"2026-09-14T01:59:22Z","created_by_operation":"op_0081817751834b5f998fcd1366fda1f7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ef944e2c12e0e9d22011b892636f1b17fc6f493a5f9bafcd7fe1474ba70090c6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"alibaba/open-code-review@494bf1c8d7a1 snapshot 5996e384ce40ea12","timeframe":null},"slice_ids":["slc_5fa784e6b25f08a5fbf6c7f3dcbad82525c7abb83b179c97018ef5e668b9793c","slc_7e407973bfa26af1a5303c1f5fae83a12d9ab7d0ed3111ed6df4f99021f18c7f"],"source_ids":["src_57bd6ea6268855678328178e8da46cb9","src_61dab23f00e656758dd0ba176e7f9969"],"text":"The agent has tool-use capabilities: it can read full file contents, search the codebase, and inspect other changed files for context; built-in tools include file_read and code_search.","updated_at":"2026-09-14T01:59:22Z","updated_by_operation":"op_0081817751834b5f998fcd1366fda1f7"}
