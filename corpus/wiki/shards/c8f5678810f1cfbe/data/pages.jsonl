{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T01:59:22Z","created_by_operation":"op_0081817751834b5f998fcd1366fda1f7","id":"pg_5869d5a8408158c5839b3d052e66bf4e","maturity":"draft","page_type":"source","path":"pages/sources/alibaba-open-code-review-contributing-ru-ru-md-494bf1c8d7a1-3d052e66bf4e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3fc7f1c78275561a81c53f218ceac0f0"],"title":"alibaba/open-code-review/CONTRIBUTING.ru-RU.md @ 494bf1c8d7a1","updated_at":"2026-09-14T01:59:22Z","updated_by_operation":"op_0081817751834b5f998fcd1366fda1f7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_09b5fddd434153c0becee974b4945ee1ea9e124eb6fb9f96e71f05f38c1efbb5"],"opposing_claim_ids":[],"text":"Repository development practice: PRs must be focused on one logical change, include tests for behavior changes, update docs when user-facing behavior changes, pass all CI checks, and every contributor must sign the Alibaba CLA before merge."},{"claim_ids":["clm_afe52be53242a691c9958a7c95729c1cc094e4ea2ff2b8a45e2b42147c40f3e8"],"opposing_claim_ids":[],"text":"Repository development practice: AI-assisted contributions must be disclosed early, contributors must understand and be able to explain all AI-generated code, AI/LLM may only be used for translation or prose polishing of replies, and 'Assisted-by'/'Co-developed-by' trailers are prohibited."},{"claim_ids":["clm_b4cca94010c68f4a00f99b87b5a5728f695746469b1192ce87afe3d94729b8f9"],"opposing_claim_ids":[],"text":"The repository layout includes cmd/opencodereview (CLI entry), internal packages for agent, config, diff parsing, LLM clients (Anthropic & OpenAI), session, tool, telemetry (OpenTelemetry), and viewer, plus a pages/ WebUI frontend."}],"claim_ids":["clm_09b5fddd434153c0becee974b4945ee1ea9e124eb6fb9f96e71f05f38c1efbb5","clm_afe52be53242a691c9958a7c95729c1cc094e4ea2ff2b8a45e2b42147c40f3e8","clm_b4cca94010c68f4a00f99b87b5a5728f695746469b1192ce87afe3d94729b8f9"],"created_at":"2026-09-14T01:59:22Z","created_by_operation":"op_0081817751834b5f998fcd1366fda1f7","id":"pg_a73ad972f0215db0827367fa09b48649","maturity":"draft","page_type":"source","path":"pages/sources/alibaba-open-code-review-contributing-ja-jp-md-494bf1c8d7a1-67fa09b48649.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_140adfe1143e551ab910113e52e41a7e"],"title":"alibaba/open-code-review/CONTRIBUTING.ja-JP.md @ 494bf1c8d7a1","updated_at":"2026-09-14T01:59:22Z","updated_by_operation":"op_0081817751834b5f998fcd1366fda1f7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_afe52be53242a691c9958a7c95729c1cc094e4ea2ff2b8a45e2b42147c40f3e8"],"opposing_claim_ids":[],"text":"Repository development practice: AI-assisted contributions must be disclosed early, contributors must understand and be able to explain all AI-generated code, AI/LLM may only be used for translation or prose polishing of replies, and 'Assisted-by'/'Co-developed-by' trailers are prohibited."},{"claim_ids":["clm_b4cca94010c68f4a00f99b87b5a5728f695746469b1192ce87afe3d94729b8f9"],"opposing_claim_ids":[],"text":"The repository layout includes cmd/opencodereview (CLI entry), internal packages for agent, config, diff parsing, LLM clients (Anthropic & OpenAI), session, tool, telemetry (OpenTelemetry), and viewer, plus a pages/ WebUI frontend."},{"claim_ids":["clm_ef944e2c12e0e9d22011b892636f1b17fc6f493a5f9bafcd7fe1474ba70090c6"],"opposing_claim_ids":[],"text":"The agent has tool-use capabilities: it can read full file contents, search the codebase, and inspect other changed files for context; built-in tools include file_read and code_search."}],"claim_ids":["clm_afe52be53242a691c9958a7c95729c1cc094e4ea2ff2b8a45e2b42147c40f3e8","clm_b4cca94010c68f4a00f99b87b5a5728f695746469b1192ce87afe3d94729b8f9","clm_ef944e2c12e0e9d22011b892636f1b17fc6f493a5f9bafcd7fe1474ba70090c6"],"created_at":"2026-09-14T01:59:22Z","created_by_operation":"op_0081817751834b5f998fcd1366fda1f7","id":"pg_b051cbee70bb59e8a70f8ac19f6775de","maturity":"draft","page_type":"source","path":"pages/sources/alibaba-open-code-review-contributing-ko-kr-md-494bf1c8d7a1-8ac19f6775de.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_61dab23f00e656758dd0ba176e7f9969"],"title":"alibaba/open-code-review/CONTRIBUTING.ko-KR.md @ 494bf1c8d7a1","updated_at":"2026-09-14T01:59:22Z","updated_by_operation":"op_0081817751834b5f998fcd1366fda1f7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_32ef382ea12467e64979669c4b49e9d3923e03704b47ddfd7f2c12e82ad608c3"],"opposing_claim_ids":[],"text":"Related files are grouped into bundles, and each bundle runs as a sub-agent with isolated context, described as a divide-and-conquer strategy that stays stable on large changesets and supports concurrent review."},{"claim_ids":["clm_4db274464bd36c34f3faa27a3f21083ae8508ada708359789f4c62244b442338"],"opposing_claim_ids":[],"text":"The product exposes an `ocr` CLI with commands including `ocr review` (workspace, --from/--to branch range, --commit), `ocr scan`, `ocr config provider/model`, `ocr session list`, and `ocr delegate`."},{"claim_ids":["clm_69566f5e26c42329412adf5da2bee2455861ae1a111f0c3a1c3789802db73670"],"opposing_claim_ids":[],"text":"The README acknowledges lower recall than general-purpose agents, framed as a deliberate trade-off favoring precision over noise."},{"claim_ids":["clm_7911bd8adf73c81b8e0a95864815a9047316ecf757607bcfe0ab936e4fb17937"],"opposing_claim_ids":[],"text":"The core design pairs deterministic engineering (file selection, file bundling, template-based rule matching, positioning/reflection modules) with an agent for dynamic decisions and context retrieval."},{"claim_ids":["clm_907db88c7eb34dcb1278b0d9d49cd32cc541aac3cc2424fbae1dbda54ada8a86"],"opposing_claim_ids":[],"text":"The README reports a benchmark built from 50 open-source repositories, 200 real PRs, and 10 languages with 1,505 annotated issues, measuring F1, precision, recall, average time, and tokens; it claims higher precision/F1 than Claude Code at ~1/9 the tokens but lower recall by design."},{"claim_ids":["clm_cd7a1bf6231d79a4a7d502245a606370cbfde2e93d85bfa5efe5f906f364050c"],"opposing_claim_ids":[],"text":"Each review session writes to its own JSONL file with no shared state between sessions, and interrupted reviews can be resumed via `--resume <session-id>`."},{"claim_ids":["clm_ef944e2c12e0e9d22011b892636f1b17fc6f493a5f9bafcd7fe1474ba70090c6"],"opposing_claim_ids":[],"text":"The agent has tool-use capabilities: it can read full file contents, search the codebase, and inspect other changed files for context; built-in tools include file_read and code_search."},{"claim_ids":["clm_f4d0ec550119d8f1b82a56bcf0230b312989bb4051a35651252247dc329247af"],"opposing_claim_ids":[],"text":"The tool requires Git >= 2.41 for diff generation, code search, and repository operations, and is distributed as an npm package `@alibaba-group/open-code-review`."}],"claim_ids":["clm_32ef382ea12467e64979669c4b49e9d3923e03704b47ddfd7f2c12e82ad608c3","clm_4db274464bd36c34f3faa27a3f21083ae8508ada708359789f4c62244b442338","clm_69566f5e26c42329412adf5da2bee2455861ae1a111f0c3a1c3789802db73670","clm_7911bd8adf73c81b8e0a95864815a9047316ecf757607bcfe0ab936e4fb17937","clm_907db88c7eb34dcb1278b0d9d49cd32cc541aac3cc2424fbae1dbda54ada8a86","clm_cd7a1bf6231d79a4a7d502245a606370cbfde2e93d85bfa5efe5f906f364050c","clm_ef944e2c12e0e9d22011b892636f1b17fc6f493a5f9bafcd7fe1474ba70090c6","clm_f4d0ec550119d8f1b82a56bcf0230b312989bb4051a35651252247dc329247af"],"created_at":"2026-09-14T01:59:22Z","created_by_operation":"op_0081817751834b5f998fcd1366fda1f7","id":"pg_b082c59ad722538a868eb1ddc14f27a2","maturity":"draft","page_type":"source","path":"pages/sources/alibaba-open-code-review-readme-md-494bf1c8d7a1-b1ddc14f27a2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_57bd6ea6268855678328178e8da46cb9"],"title":"alibaba/open-code-review/README.md @ 494bf1c8d7a1","updated_at":"2026-09-14T01:59:22Z","updated_by_operation":"op_0081817751834b5f998fcd1366fda1f7"}
