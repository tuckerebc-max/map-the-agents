6f364050c","clm_ef944e2c12e0e9d22011b892636f1b17fc6f493a5f9bafcd7fe1474ba70090c6","clm_f4d0ec550119d8f1b82a56bcf0230b312989bb4051a35651252247dc329247af"],"created_at":"2026-09-14T01:59:22Z","created_by_operation":"op_0081817751834b5f998fcd1366fda1f7","id":"pg_dd37badd70505ab98039ecf4bb4b9612","maturity":"draft","page_type":"entity","path":"pages/entities/alibaba-open-code-review-ecf4bb4b9612.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"alibaba/open-code-review","updated_at":"2026-09-14T01:59:22Z","updated_by_operation":"op_0081817751834b5f998fcd1366fda1f7"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T01:59:22Z","created_by_operation":"op_0081817751834b5f998fcd1366fda1f7","id":"pg_ecf270c55b6f52b4895b30b0f1ddee3e","maturity":"draft","page_type":"source","path":"pages/sources/alibaba-open-code-review-contributing-zh-cn-md-494bf1c8d7a1-30b0f1ddee3e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ff8d8f8cf90c5a7ebc79800e7e57fc93"],"title":"alibaba/open-code-review/CONTRIBUTING.zh-CN.md @ 494bf1c8d7a1","updated_at":"2026-09-14T01:59:22Z","updated_by_operation":"op_0081817751834b5f998fcd1366fda1f7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_55f2c41ecca2f0651e336554e0448c4c81c5ba78cb74a1b39f80aa6dae785844"],"opposing_claim_ids":[],"text":"The product optionally serves a local web viewer for browsing review session history; the viewer binds to localhost by default and uses a host-header allowlist (configurable via OCR_VIEWER_ALLOWED_HOSTS) to block DNS rebinding."},{"claim_ids":["clm_56229336c50ba397bb242254f2fbe4cefda45d8c863c4e2a8ec1d030e049f5d9"],"opposing_claim_ids":[],"text":"Security defaults follow fail-safe principles: API keys come only from environment variables and are never logged or written to output files, and LLM responses undergo JSON schema validation with line-number bounds checking."},{"claim_ids":["clm_5e672a90824e6b18afaa8845da6b8d906e4dd2b188dcfc290d2475f8c1794579"],"opposing_claim_ids":[],"text":"Per the assurance case, agent file paths are validated against the repository root before and after symlink resolution, and external process execution is limited to git with hardcoded subcommands, plus a few user-configured call sites."},{"claim_ids":["clm_cd7a1bf6231d79a4a7d502245a606370cbfde2e93d85bfa5efe5f906f364050c"],"opposing_claim_ids":[],"text":"Each review session writes to its own JSONL file with no shared state between sessions, and interrupted reviews can be resumed via `--resume <session-id>`."}],"claim_ids":["clm_55f2c41ecca2f0651e336554e0448c4c81c5ba78cb74a1b39f80aa6dae785844","clm_56229336c50ba397bb242254f2fbe4cefda45d8c863c4e2a8ec1d030e049f5d9","clm_5e672a90824e6b18afaa8845da6b8d906e4dd2b188dcfc290d2475f8c1794579","clm_cd7a1bf6231d79a4a7d502245a606370cbfde2e93d85bfa5efe5f906f364050c"],"created_at":"2026-09-14T01:59:22Z","created_by_operation":"op_0081817751834b5f998fcd1366fda1f7","id":"pg_fd5f815674a755db91f72943828d7b31","maturity":"draft","page_type":"source","path":"pages/sources/alibaba-open-code-review-assurance-case-md-494bf1c8d7a1-2943828d7b31.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e74ef1e59e925fa4bc60464136f4f943"],"title":"alibaba/open-code-review/ASSURANCE_CASE.md @ 494bf1c8d7a1","updated_at":"2026-09-14T01:59:22Z","updated_by_operation":"op_0081817751834b5f998fcd1366fda1f7"}
