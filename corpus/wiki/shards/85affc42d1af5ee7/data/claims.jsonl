{"access":"public","created_at":"2026-09-14T03:36:01Z","created_by_operation":"op_78113e102fc0425b88268e44c8d07872","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ee074a789ea566314b7903a3be3089380c9ae6b8acf3de770f211e90ef4f7eb2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"arphanetx/monocle@6a865d767a96 snapshot 82058386115fbb7c","timeframe":null},"slice_ids":["slc_4fcc58fe35c769bee806edc92e79a1e467b5ed38aa5cef0e21a206d07934a9f8","slc_600e384accb43d9a01c20c7e86f294a081cc5fbcadce39c137bc21da5cf752b3"],"source_ids":["src_0f88a7c96ed8575a92f5bcbf671e48df"],"text":"The runtime model is Mistral-7B-Instruct-v0.2, an instruct fine-tuned Mistral-7B-v0.2 with 7.24B parameters, BF16 tensors, and a 32k context window.","updated_at":"2026-09-14T03:36:01Z","updated_by_operation":"op_78113e102fc0425b88268e44c8d07872"}
