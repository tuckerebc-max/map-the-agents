{"access":"public","created_at":"2026-09-14T03:36:01Z","created_by_operation":"op_78113e102fc0425b88268e44c8d07872","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d9a65cdee0dce8bb8766d2eebf840dd490af449d7a3619e47b930646aea73674","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"arphanetx/monocle@6a865d767a96 snapshot 82058386115fbb7c","timeframe":null},"slice_ids":["slc_ff1040485187c56661a16acdd43895edf07c6de4291049008b600ae1245124d9"],"source_ids":["src_0f88a7c96ed8575a92f5bcbf671e48df"],"text":"Monocle performs natural language searches against compiled binaries: given a binary and search criteria, it decompiles the binary and uses an in-built LLM to identify and score matching code areas.","updated_at":"2026-09-14T03:36:01Z","updated_by_operation":"op_78113e102fc0425b88268e44c8d07872"}
