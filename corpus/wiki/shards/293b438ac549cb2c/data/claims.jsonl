{"access":"public","created_at":"2026-09-14T03:23:40Z","created_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8a058060035a375dfc64a2e379fb2da6dd2fcea840ef965b22cec1eff20ed4c1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"willynikes2/agent-orchestrator@f99e1eaf7414 snapshot d5e8c36bd6e17b77","timeframe":null},"slice_ids":["slc_b6c58ea6f683cf391d2f7a981f3f3e9530ff9c368913d2a5be4cf32420861c64","slc_edc99dceafa535e21126669a734c8c07b9e080e52178719160b455ddf22324dd"],"source_ids":["src_03b44c47bcdd5a7e856ad23a4925d9b8","src_79423140d8855ca1b3a64e6c8fa67451"],"text":"requirements.txt lists openai>=1.0.0, anthropic>=0.34.0, google-genai>=1.0.0, and python-dotenv>=1.0.0; the README requires Python 3.10+ and at least one installed AI CLI.","updated_at":"2026-09-14T03:23:40Z","updated_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158"}
{"access":"public","created_at":"2026-09-14T03:23:40Z","created_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8dd44c98b08cf31c8704b1fd2da600583c0b6cd5b2819d5284a8a43c534db94e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"willynikes2/agent-orchestrator@f99e1eaf7414 snapshot d5e8c36bd6e17b77","timeframe":null},"slice_ids":["slc_332202df492790939a52fd06334235f058fd0c8d3b789771323633be266ec185","slc_4d33656699cb8ada7208891b6a4c723d3fda755c728bdef987b601e43bc93ae6"],"source_ids":["src_03b44c47bcdd5a7e856ad23a4925d9b8"],"text":"Messages are routed through ordered role chains; when an agent fails or is down, the next agent in the chain is tried, and if all fail an error with recovery options is shown.","updated_at":"2026-09-14T03:23:40Z","updated_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158"}
{"access":"public","created_at":"2026-09-14T03:23:40Z","created_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_93c59eb9f5faadee666edcb6067c6a4898e0d9726fdea38fb2656109b5685bf0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"willynikes2/agent-orchestrator@f99e1eaf7414 snapshot d5e8c36bd6e17b77","timeframe":null},"slice_ids":["slc_277675099102bd0bc228b0e3f00667c6a1f36d926830947784b850a6c4e66c74","slc_d29064c838b65e0dfcea7cae1e969aed72b163fb7547fc03b77764120c931bad"],"source_ids":["src_03b44c47bcdd5a7e856ad23a4925d9b8"],"text":"In full-host-unattended mode the agents can act without pausing for human approval, and directory whitelisting controls which directories agents may access.","updated_at":"2026-09-14T03:23:40Z","updated_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158"}
{"access":"public","created_at":"2026-09-14T03:23:40Z","created_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a4b59dd6e0551a6b8c13b58ba849cc03e392dc1d209b40c54a42b216781bc46e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"willynikes2/agent-orchestrator@f99e1eaf7414 snapshot d5e8c36bd6e17b77","timeframe":null},"slice_ids":["slc_e5b3d85c944451e094e4f18b562148962b986c1fc09b5deddaea2c149a9bceb6"],"source_ids":["src_03b44c47bcdd5a7e856ad23a4925d9b8"],"text":"Default role chains differ by role: orchestrator and review prefer Claude first, implementation prefers Codex first, and uidocs prefers Gemini first.","updated_at":"2026-09-14T03:23:40Z","updated_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158"}
{"access":"public","created_at":"2026-09-14T03:23:40Z","created_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a69d1f72d67d72b2cd4235e25e4e2b93e618116551e3827663eb7e93d8c20c35","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"willynikes2/agent-orchestrator@f99e1eaf7414 snapshot d5e8c36bd6e17b77","timeframe":null},"slice_ids":["slc_fb2a8649986f4b064b235781417d5285ba494cf6561aeb137388b64b7241bbf5"],"source_ids":["src_03b44c47bcdd5a7e856ad23a4925d9b8"],"text":"The product is a terminal-based orchestrator wrapping Claude, Codex, and Gemini CLIs with automatic failover and a shared knowledge base, advertised at roughly $60/month in subscriptions.","updated_at":"2026-09-14T03:23:40Z","updated_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158"}
{"access":"public","created_at":"2026-09-14T03:23:40Z","created_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b07188ce0de84d81a9aba7f8620e2f1046c859be5da3b09d71f0e7cf0fabda8f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"willynikes2/agent-orchestrator@f99e1eaf7414 snapshot d5e8c36bd6e17b77","timeframe":null},"slice_ids":["slc_1d9481c970201174a63f2884b019aef76428d4b025ee91151b85f5c6331cd6b3","slc_4d73261fead3ecac9a184247ceb72760545cf1829934fe63df21885213dc19f3","slc_a8f2dd65ffe83b3f1b123780e70f75b32b9358525fb93dd115a8cfdef9bec3b8"],"source_ids":["src_03b44c47bcdd5a7e856ad23a4925d9b8"],"text":"Prefix routing sends 'impl:' messages to the implementation chain and 'ui:' to the UI chain, while @claude/@codex/@gemini address a specific agent directly, bypassing failover.","updated_at":"2026-09-14T03:23:40Z","updated_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158"}
