{"access":"public","created_at":"2026-09-14T03:23:40Z","created_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_67f68a82347f866d9bf2fe1fe11a3310620511f11b24afb5d28f942e5836d472","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"willynikes2/agent-orchestrator@f99e1eaf7414 snapshot d5e8c36bd6e17b77","timeframe":null},"slice_ids":["slc_5192143be84c3ef3f3179e98692a795f683167fa48980395eea8ad65b7d24fb0","slc_51abcd28a74b4ce3e95a0abd1575bb9f121b84be1b4313ad0ccd25223124e239","slc_e52f18fe8154a319b199e7dfc78acb9a2f33373260ca63a1fe2e51a9854bf3ca"],"source_ids":["src_03b44c47bcdd5a7e856ad23a4925d9b8"],"text":"Codex and Gemini CLI permission modes are configurable between full-host-unattended (default) and sandboxed-auto; the former runs Codex with --dangerously-bypass-approvals-and-sandbox and Gemini with yolo approval and sandbox disabled.","updated_at":"2026-09-14T03:23:40Z","updated_by_operation":"op_2f96d87fbeb2451c8b0c20da3fc8d158"}
