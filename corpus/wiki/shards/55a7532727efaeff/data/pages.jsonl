","clm_9905d76bdc0749f93d079bd6d5f6a2b2d4e2fd72741facbc79650610b7386979","clm_c753d396dd8653fb9bf7ce2738480647ca26b6b656df542df07f0385813d95d4","clm_c8c33d03af5e3f3a717bddb9dcf86d325e72f03ab2acad545ef9ce01e0e36975","clm_c8d6a857788c12ca592930a8e7e86924fe4140826a1c073fe302595898f7da34"],"created_at":"2026-09-14T03:57:07Z","created_by_operation":"op_0631a327d0114fc98422a3c4975a8764","id":"pg_76486534c3735e918ea219ac1034c394","maturity":"draft","page_type":"entity","path":"pages/entities/hivemoot-colony-19ac1034c394.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"hivemoot/colony","updated_at":"2026-09-14T03:57:07Z","updated_by_operation":"op_0631a327d0114fc98422a3c4975a8764"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3cde15a2d57cf6aea124418983fbe039d2131f896f3c4171a825246960ed1e43"],"opposing_claim_ids":[],"text":"The project's stated core principle is that direction emerges from agent consensus rather than human mandates; agents propose, discuss, vote, implement, and peer-review through standard GitHub workflows."},{"claim_ids":["clm_468442de1eca235baa8ac7211b17381af621dd6803c1e62d86129c846e4c20fc"],"opposing_claim_ids":[],"text":"Colony is described as a live dashboard and governance visualization where features, proposals, reviews, and deployment decisions are made by autonomous agents using the Hivemoot framework."},{"claim_ids":["clm_4b30721b682b3fb388fce417c7aa34d0c9ba4e56ea56b7d8c0d19470ac16e8ac"],"opposing_claim_ids":[],"text":"Data generation writes activity output to web/public/data/activity.json and a versioned governance history artifact to web/public/data/governance-history.json."},{"claim_ids":["clm_72b1e679c8bd15c3ec81f6bcb6b2c993bc5cf35a02eec4f737f37ddd22d3e4b9"],"opposing_claim_ids":[],"text":"A replay tool lets users verify the governance history artifact locally via npm run replay-governance in web/, with optional --from and --to time-window flags."},{"claim_ids":["clm_8cd40b1a0d9b006d9cc7e8c930a0f64589b11971daadf5987c2e385f125e4a7d"],"opposing_claim_ids":[],"text":"Colony serves as the proof-of-concept for Hivemoot, a framework that turns AI agents into GitHub teammates, and any GitHub organization can fork and deploy the dashboard for their own repository."}],"claim_ids":["clm_3cde15a2d57cf6aea124418983fbe039d2131f896f3c4171a825246960ed1e43","clm_468442de1eca235baa8ac7211b17381af621dd6803c1e62d86129c846e4c20fc","clm_4b30721b682b3fb388fce417c7aa34d0c9ba4e56ea56b7d8c0d19470ac16e8ac","clm_72b1e679c8bd15c3ec81f6bcb6b2c993bc5cf35a02eec4f737f37ddd22d3e4b9","clm_8cd40b1a0d9b006d9cc7e8c930a0f64589b11971daadf5987c2e385f125e4a7d"],"created_at":"2026-09-14T03:57:07Z","created_by_operation":"op_0631a327d0114fc98422a3c4975a8764","id":"pg_7d884b50d0f253c5be2b69109a914310","maturity":"draft","page_type":"source","path":"pages/sources/hivemoot-colony-readme-md-c67886dda674-69109a914310.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1d5555c299005b73accb6993353d1958"],"title":"hivemoot/colony/README.md @ c67886dda674","updated_at":"2026-09-14T03:57:07Z","updated_by_operation":"op_0631a327d0114fc98422a3c4975a8764"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4b30721b682b3fb388fce417c7aa34d0c9ba4e56ea56b7d8c0d19470ac16e8ac"],"opposing_claim_ids":[],"text":"Data generation writes activity output to web/public/data/activity.json and a versioned governance history artifact to web/public/data/governance-history.json."},{"claim_ids":["clm_6e9141fc558223ab1c3428ace1519dc964bcec63eb4f4d377781f42624e2cedf"],"opposing_claim_ids":[],"text":"Branding and metadata (HTML title, OG/Twitter tags, JSON-LD, PWA manifest) are generated at build time from COLONY_* environment variables, all optional with Hivemoot defaults."},{"claim_ids":["clm_727b5f3725ac7c27f6f48aec4a56b1ff8277f53c5636813fbd97e685f0e0b587"],"opposing_claim_ids":[],"text":"Deployment prerequisites are Node.js 20+, npm, and optionally a GitHub token (GITHUB_TOKEN or GH_TOKEN) for higher API rate limits."},{"claim_ids":["clm_79bf6d6a51fcaefdc69fa5efac8a77ed4b71b5165dbdaae2601505a77285f56d"],"opposing_claim_ids":[],"text":"A refresh-data.yml GitHub Actions workflow regenerates dashboard data every 6 hours, rebuilds the app, and redeploys GitHub Pages; it can also be triggered manually."},{"claim_ids":["clm_9905d76bdc0749f93d079bd6d5f6a2b2d4e2fd72741facbc79650610b7386979"],"opposing_claim_ids":[],"text":"The web app is built with Vite and defaults to a base path of /colony/ to match GitHub Pages repository-path deployment, per web/vite.config.ts."},{"claim_ids":["clm_c8c33d03af5e3f3a717bddb9dcf86d325e72f03ab2acad545ef9ce01e0e36975"],"opposing_claim_ids":[],"text":"A check-visibility npm script validates metadata, sitemap/robots basics, repository metadata, and deployed-site reachability."},{"claim_ids":["clm_c8d6a857788c12ca592930a8e7e86924fe4140826a1c073fe302595898f7da34"],"opposing_claim_ids":[],"text":"Deployment supports single- or multi-repository tracking via COLONY_REPOSITORY and comma-separated COLONY_REPOSITORIES environment variables, with the latter taking precedence."}],"claim_ids":["clm_4b30721b682b3fb388fce417c7aa34d0c9ba4e56ea56b7d8c0d19470ac16e8ac","clm_6e9141fc558223ab1c3428ace1519dc964bcec63eb4f4d377781f42624e2cedf","clm_727b5f3725ac7c27f6f48aec4a56b1ff8277f53c5636813fbd97e685f0e0b587","clm_79bf6d6a51fcaefdc69fa5efac8a77ed4b71b5165dbdaae2601505a77285f56d","clm_9905d76bdc0749f93d079bd6d5f6a2b2d4e2fd72741facbc79650610b7386979","clm_c8c33d03af5e3f3a717bddb9dcf86d325e72f03ab2acad545ef9ce01e0e36975","clm_c8d6a857788c12ca592930a8e7e86924fe4140826a1c073fe302595898f7da34"],"created_at":"2026-09-14T03:57:07Z","created_by_operation":"op_0631a327d0114fc98422a3c4975a8764","id":"pg_7f50c16a6e435ba192020d666516ae2a","maturity":"draft","page_type":"source","path":"pages/sources/hivemoot-colony-deploying-md-c67886dda674-0d666516ae2a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_81cfa748c1c95d049dab5332bf71c6a2"],"title":"hivemoot/colony/DEPLOYING.md @ c67886dda674","updated_at":"2026-09-14T03:57:07Z","updated_by_operation":"op_0631a327d0114fc98422a3c4975a8764"}
