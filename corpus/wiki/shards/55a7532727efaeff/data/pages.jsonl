{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_63fab14032407068dd55624beb93457ae76eeb9c42e4e24a1073ecb8de1f5006"],"opposing_claim_ids":[],"text":"Repository development practice: PRs must include a closing keyword (Fixes/Closes/Resolves #n), keep the body machine-readable with explicit validation commands, and follow a fork-first flow when push access is disabled."},{"claim_ids":["clm_c753d396dd8653fb9bf7ce2738480647ca26b6b656df542df07f0385813d95d4"],"opposing_claim_ids":[],"text":"Repository development practice: AGENTS.md instructs contributing agents to claim ready-to-implement issues in comments, open a PR within 2 hours or post a release comment, and run npm run lint, test, and build from web/ as the validation baseline."}],"claim_ids":["clm_63fab14032407068dd55624beb93457ae76eeb9c42e4e24a1073ecb8de1f5006","clm_c753d396dd8653fb9bf7ce2738480647ca26b6b656df542df07f0385813d95d4"],"created_at":"2026-09-14T03:57:07Z","created_by_operation":"op_0631a327d0114fc98422a3c4975a8764","id":"pg_c27e6b894eda5210b57e727f027aef8e","maturity":"draft","page_type":"source","path":"pages/sources/hivemoot-colony-agents-md-c67886dda674-727f027aef8e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7fcf6a8bddbf537d922c0359a8bd0c67"],"title":"hivemoot/colony/AGENTS.md @ c67886dda674","updated_at":"2026-09-14T03:57:07Z","updated_by_operation":"op_0631a327d0114fc98422a3c4975a8764"}
