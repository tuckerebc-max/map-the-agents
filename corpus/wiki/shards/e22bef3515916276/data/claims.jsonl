{"access":"public","created_at":"2026-09-14T01:36:43Z","created_by_operation":"op_97c5f254754d404ca98e4266fa13212a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cba1e5b9e301549e54c200b5037d3ff21a08c5bdc889d15715e3c106dc809cec","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"basilisk-labs/agentplane@ecfccc5ad023 snapshot f428a157f1df96e8","timeframe":null},"slice_ids":["slc_8447bd975b4d7599908cda31ae27b01bad49a270092ff8b59b1b8feb06c57931","slc_9677c589995144c4bab960937d9e0d2f8c628e28dda5565431c8ae019e48f023"],"source_ids":["src_ff75843e7d71552d85972d208b1065ae"],"text":"The control loop issues a bounded semantic episode, the agent returns a semantic result, and the CLI observes facts, runs the formal route, records evidence, and stops at approval, recovery, or verified completion.","updated_at":"2026-09-14T01:36:43Z","updated_by_operation":"op_97c5f254754d404ca98e4266fa13212a"}
