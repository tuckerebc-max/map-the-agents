5f69afedb"],"created_at":"2026-09-14T01:36:43Z","created_by_operation":"op_97c5f254754d404ca98e4266fa13212a","id":"pg_92c3fe729cfe5a1b9de0bc2d1e12267b","maturity":"draft","page_type":"entity","path":"pages/entities/basilisk-labs-agentplane-bc2d1e12267b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"basilisk-labs/agentplane","updated_at":"2026-09-14T01:36:43Z","updated_by_operation":"op_97c5f254754d404ca98e4266fa13212a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1bc37a795fdb42e459d031a010e8591c0e5fcc568564d3fbb14ec4854b2c558e"],"opposing_claim_ids":[],"text":"A supervisor model prepares a bounded AgentWorkOrder, enforces state and authority preconditions, invokes one specialized semantic role, and records an independent ExecutionReceipt; state fingerprints reject stale results."},{"claim_ids":["clm_2e7b18cde13b2fde3c6870dc745e92a447b192908aed443020cbfa52828f22b2"],"opposing_claim_ids":[],"text":"The product exposes a CLI (npm package 'agentplane', short alias 'ap') with commands such as init, quickstart, task create/active/advance/run, and evaluator list/show/execute."},{"claim_ids":["clm_f7f8893373dca19d9be87d75299a84cd36526429ab714c7958e071998e306cea"],"opposing_claim_ids":[],"text":"Projects can store prompt modules under .agentplane/evaluators and run a read-only evaluation episode via 'agentplane evaluator execute <task-id>'; the roadmap plans comparative evaluation and quality gates in a later horizon."}],"claim_ids":["clm_1bc37a795fdb42e459d031a010e8591c0e5fcc568564d3fbb14ec4854b2c558e","clm_2e7b18cde13b2fde3c6870dc745e92a447b192908aed443020cbfa52828f22b2","clm_f7f8893373dca19d9be87d75299a84cd36526429ab714c7958e071998e306cea"],"created_at":"2026-09-14T01:36:43Z","created_by_operation":"op_97c5f254754d404ca98e4266fa13212a","id":"pg_997a3cf91ba35d59941583e21da65c15","maturity":"draft","page_type":"source","path":"pages/sources/basilisk-labs-agentplane-roadmap-md-ecfccc5ad023-83e21da65c15.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_642751c5f70755e28ae153c6abbd51e2"],"title":"basilisk-labs/agentplane/ROADMAP.md @ ecfccc5ad023","updated_at":"2026-09-14T01:36:43Z","updated_by_operation":"op_97c5f254754d404ca98e4266fa13212a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3bd92d6dbb61ff9b84997bcdf5104c2279e7afcf031f2b1b5c693308014fbb7a"],"opposing_claim_ids":[],"text":"Repository development practice: contributors work through the agentplane task lifecycle (task new, plan approve, verify, finish), open issues first for architectural or CLI-surface changes, and must keep src/cli, usecases, ports, and adapters layering with OS/git/network access confined to adapters."},{"claim_ids":["clm_54af9e8c2880354076c646a752754a6a987ca8ec3694c995b3ee6a52e8417d8a"],"opposing_claim_ids":[],"text":"Repository development practice: POLICY.md requires lint and full tests to pass before merging to main, tests for behavior changes, English-only user-facing strings, no accidental npm releases, and no uncommitted code changes under packages/**."}],"claim_ids":["clm_3bd92d6dbb61ff9b84997bcdf5104c2279e7afcf031f2b1b5c693308014fbb7a","clm_54af9e8c2880354076c646a752754a6a987ca8ec3694c995b3ee6a52e8417d8a"],"created_at":"2026-09-14T01:36:43Z","created_by_operation":"op_97c5f254754d404ca98e4266fa13212a","id":"pg_bb5a560c1ef555568d363e9caa6cfbd7","maturity":"draft","page_type":"source","path":"pages/sources/basilisk-labs-agentplane-policy-md-ecfccc5ad023-3e9caa6cfbd7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a763efb8a3b55f80a573851f45a444cb"],"title":"basilisk-labs/agentplane/POLICY.md @ ecfccc5ad023","updated_at":"2026-09-14T01:36:43Z","updated_by_operation":"op_97c5f254754d404ca98e4266fa13212a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_035f0bd1efc93eee97aeeab1f56f08edf6ff5659ec94791467cf1b5fc0792f3a"],"opposing_claim_ids":[],"text":"Operating state lives in the repository: AGENTS.md/CLAUDE.md as policy gateway, .agentplane/WORKFLOW.md, per-task README and acr.json (Agent Change Record), and pr/ artifacts; an optional Local Context layer adds source-backed repository knowledge."},{"claim_ids":["clm_1bc37a795fdb42e459d031a010e8591c0e5fcc568564d3fbb14ec4854b2c558e"],"opposing_claim_ids":[],"text":"A supervisor model prepares a bounded AgentWorkOrder, enforces state and authority preconditions, invokes one specialized semantic role, and records an independent ExecutionReceipt; state fingerprints reject stale results."},{"claim_ids":["clm_2d81e167ba8b55b621418b0ab80a5e452879911a5620eb747ea870975dbf4868"],"opposing_claim_ids":[],"text":"task advance returns a bounded episode packet containing the objective, writable scope, context, result schema, an exchange.result_path, and an exact exchange.resume_argv command for returning the typed result."},{"claim_ids":["clm_2e7b18cde13b2fde3c6870dc745e92a447b192908aed443020cbfa52828f22b2"],"opposing_claim_ids":[],"text":"The product exposes a CLI (npm package 'agentplane', short alias 'ap') with commands such as init, quickstart, task create/active/advance/run, and evaluator list/show/execute."},{"claim_ids":["clm_7e749beadf11d612b477abadf9e8156314497a0196fb978369c541a111167363"],"opposing_claim_ids":[],"text":"Writable roots and allowed effects for each episode are carried in that episode's WorkOrder, and semantic episodes cannot perform or claim formal lifecycle transitions."},{"claim_ids":["clm_c30a8292f1ebd0534402d3ba77dfd8feeed6a1c60a2492117dd278910b868a7f"],"opposing_claim_ids":[],"text":"The project is pre-1.0 and under active development; the README advises pinning the CLI version in automation and reviewing release notes when upgrading."},{"claim_ids":["clm_c9e78f670e1e03a49b6aaccc5330333d99c279eadb1e28ff93b53edee1d0e804"],"opposing_claim_ids":[],"text":"The CLI requires Node.js 24+ and Git, is distributed via npm, and is MIT licensed."},{"claim_ids":["clm_cba1e5b9e301549e54c200b5037d3ff21a08c5bdc889d15715e3c106dc809cec"],"opposing_claim_ids":[],"text":"The control loop issues a bounded semantic episode, the agent returns a semantic result, and the CLI observes facts, runs the formal route, records evidence, and stops at approval, recovery, or verified completion."},{"claim_ids":["clm_d3d6ce3cf3d725e39bc0b89f8f8251a33f4156c463e4909a150d6f99fbb3ffc9"],"opposing_claim_ids":[],"text":"Two workflow modes are offered: 'direct' for lighter local routes and 'branch_pr' for worktrees, branches, PR artifacts, and hosted checks; the agent declares a preferred mode but Agentplane can strengthen the route based on observed work."},{"claim_ids":["clm_fbfa6dec6f4134450cc76d2ea796618168bf82593401f626aeb2f955f69afedb"],"opposing_claim_ids":[],"text":"The design separates semantic judgment (agents) from mechanically authoritative workflow mechanics (CLI), with the CLI resolving authority, transitions, routing, schemas, and stop conditions in code rather than by model guesses."}],"claim_ids":["clm_035f0bd1efc93eee97aeeab1f56f08edf6ff5659ec94791467cf1b5fc0792f3a","clm_1bc37a795fdb42e459d031a010e8591c0e5fcc568564d3fbb14ec4854b2c558e","clm_2d81e167ba8b55b621418b0ab80a5e452879911a5620eb747ea870975dbf4868","clm_2e7b18cde13b2fde3c6870dc745e92a447b192908aed443020cbfa52828f22b2","clm_7e749beadf11d612b477abadf9e8156314497a0196fb978369c541a111167363","clm_c30a8292f1ebd0534402d3ba77dfd8feeed6a1c60a2492117dd278910b868a7f","clm_c9e78f670e1e03a49b6aaccc5330333d99c279eadb1e28ff93b53edee1d0e804","clm_cba1e5b9e301549e54c200b5037d3ff21a08c5bdc889d15715e3c106dc809cec","clm_d3d6ce3cf3d725e39bc0b89f8f8251a33f4156c463e4909a150d6f99fbb3ffc9","clm_fbfa6dec6f4134450cc76d2ea796618168bf82593401f626aeb2f955f69afedb"],"created_at":"2026-09-14T01:36:43Z","created_by_operation":"op_97c5f254754d404ca98e4266fa13212a","id":"pg_e8b51585d5355d8bbee73bbaedcc3f89","maturity":"draft","page_type":"source","path":"pages/sources/basilisk-labs-agentplane-readme-md-ecfccc5ad023-3bbaedcc3f89.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ff75843e7d71552d85972d208b1065ae"],"title":"basilisk-labs/agentplane/README.md @ ecfccc5ad023","updated_at":"2026-09-14T01:36:43Z","updated_by_operation":"op_97c5f254754d404ca98e4266fa13212a"}
