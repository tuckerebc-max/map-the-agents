{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_12d19271dfc920f21baf1fe644fa0568ed95a9ca4fe0d10c9f32355bd64ba5dd"],"opposing_claim_ids":[],"text":"The package includes input/output token accounting with price estimation, message conversion helpers, and UI translation utilities."},{"claim_ids":["clm_52f50981951a2a209868ecf981b93327b8fb28f862fe92889e546da364cb500c"],"opposing_claim_ids":[],"text":"Model chains are built on LiteLLM, and the README states the package no longer uses LangChain."},{"claim_ids":["clm_56c4f5020f3a450dc46aaa917a17ac19db7b2ab89aa90f83adfa53be4069f5f3"],"opposing_claim_ids":[],"text":"The package is described as a small shared library for Voicebot's streamed LLM calls."},{"claim_ids":["clm_7407c05f5ff68c89eab7ab378bdebb10b997fdd6e45c5ac6be78e1060c108874"],"opposing_claim_ids":[],"text":"Production model chains live in the bot's private configuration and are constructed by bot/parsing/generator.py, currently using Google Gemini as primary with OpenAI GPT-5.4 mini as fallback."},{"claim_ids":["clm_8169d6398e89f30b308fcd978634d37af491e34e82e1fd1a53cb4c681f6c97fb"],"opposing_claim_ids":[],"text":"It supports ordered fallback across configured model providers, plus empty-response and context-window error handling."},{"claim_ids":["clm_825fed1aba3b0c3157d91b29dfaa6d7d4cf7fe13b5443e6c2eb99d0e61271da7"],"opposing_claim_ids":[],"text":"It provides LiteLLM-based async chat streaming with bounded initial-request and mid-stream retries."}],"claim_ids":["clm_12d19271dfc920f21baf1fe644fa0568ed95a9ca4fe0d10c9f32355bd64ba5dd","clm_52f50981951a2a209868ecf981b93327b8fb28f862fe92889e546da364cb500c","clm_56c4f5020f3a450dc46aaa917a17ac19db7b2ab89aa90f83adfa53be4069f5f3","clm_7407c05f5ff68c89eab7ab378bdebb10b997fdd6e45c5ac6be78e1060c108874","clm_8169d6398e89f30b308fcd978634d37af491e34e82e1fd1a53cb4c681f6c97fb","clm_825fed1aba3b0c3157d91b29dfaa6d7d4cf7fe13b5443e6c2eb99d0e61271da7"],"created_at":"2026-09-14T03:53:44Z","created_by_operation":"op_9e3e27