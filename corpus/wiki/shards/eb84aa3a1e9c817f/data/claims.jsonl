{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a0506b716647e182c956caf14563aa7d5fe90c48f15c39764eeca067066e6efd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_4dffb029d06fcfa03ea95b54b989c2e39d0c827c2f097b25b06b14e7a6494ded"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc"],"text":"The README warns that some workflows automate actions on external platforms in ways that may violate platform Terms of Service, and directs users to LEGAL_NOTICE.md before running automation scripts.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b1dbd2ca5dfce865a0c23e8472d8e1e88b70d723c388d6f9d7b6b936ccae5d8b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_b6bec114f3a88ab2f1a5b379b140e61236880e54e9ebbfea2fa13baec96df2c6"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc"],"text":"The repository is organized into tool_connections/, triggers/, runtime/, workflows/, tests/, .cursor/skills/, .claude/skills/, and staging/, plus setup guides such as setup.md, add-new-tool.md, and setup-python.md.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
