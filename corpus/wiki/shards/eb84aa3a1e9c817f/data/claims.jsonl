{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_03da786cb1e986324876eeb3e75a1dd024f28e3b5322f9305e90dd8f763f0eb1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_73cc57b2e4060f6471040626c03b6fea64045544b9910d95517ed97708ca8230","slc_b60881005371c18a348eac5ae4f7748265b79281800cc127446c054f2ee7a2b7","slc_d6ac9ec2acfa4dd4d7f78fd105aa6ea6d6e5ad641592396c0427f96705be4d2d","slc_fe3e3471c3ea1c19851e25cb8bc7d642054274a2acc9474d13f57aed257ad125"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc"],"text":"The architecture separates a push layer (triggers that detect events via desktop/browser notifications, sessions, email, or polling and wake workflows) from a pull layer (tool connections that fetch context or act), with a thin local runtime handling polling, scheduling, state, dedupe, replies, and agent invocation.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_068019eb27bee991cf8ead377e1c05a04b8c701f520f710b23b4e3c881a0df57","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_0e6706fbbc6424225cd0770350bbacda43ed58897e87db2208f7bb071ebe2a86","slc_9e1e08a46528e2d12e93fa59f7bcc1ec5dc6d7dc42d9e1f00540e4c7eb33c24d","slc_a0926d7e2bda3d21acdc7e0be995eabaa11ae6d3565565835f5097d3b8621559"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc"],"text":"The project is positioned as a local-first personal AI assistant stack that reuses the user's existing coding agent, browser sessions, desktop apps, and permissions, explicitly avoiding new company-wide platforms, Slack apps, webhooks, or IT approval.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_15d4cdd5398ecc3101971110c8412b4c42ec86980f9a209a15a30b39a14a89ee","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_0e342e07e4c50dc0dc7064ff4d8e9499d3f981803c9961e5b25923d8005b6e19","slc_0f55ab909ba8d4f142eec2f4e5ae69a61d922bc4b11d3469ae3a2efbf3a7f4cb","slc_46adc171f933a1457ac3d03e384173dc588d00117aa450571867c7a4cb4af0f6"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc"],"text":"Setup requires a coding agent (Cursor, Claude Code, or Codex), a Python virtualenv with an editable dev install (pip install -e \".[dev]\"), and optionally Python/Playwright setup per setup-python.md.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1821159ea11e4e0b59af05346dfb84c37c2f7c038772322048bdd0a81470166c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_43dde317943db82ee989258d7184268b5cee3755eac3cad34ab4589c6a43309d","slc_45a57fded59a5adc4c360b0527aa4f278ec44e56442e62f6ec3add6446cf5b1b","slc_dac72c99fd8a9837ae453a69f84e37ca2f7cb9c3bcaff1a5e2ea4fb46b61b570"],"source_ids":["src_c068935bbab55ca4b80f4ee5db280e47"],"text":"The connection philosophy prioritizes zero-friction auth: supported API tokens first, then Agent Browser over existing sessions; OAuth requiring the user to create their own app or register credentials is explicitly rejected.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1f3451b5fef5a21d4077c8ce5bb84ca8f4ab660e2e6e36ff4d435370789cac88","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_d27a38746f114a5c53403578061b066e28630dc33bf377b23b4b6e1fbcfef500","slc_e97eb32b34028d216579d55de06726203e04b83e3d71d7256648c8660ba275b6"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc"],"text":"A second CLI, 10x-standup-prep, supports a --meeting-context flag and a --dry-run mode; posting to Slack requires reviewing output first and setting TENX_STANDUP_PREP_SLACK_CHANNEL before using --post.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_69aa9a134f225fb648805cabe845156d4f62a23851e72d3f0c06e007e8af48b3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_e8abdbc306ece311d1b81bf1e34a2699af1c37a65e0607170c17f6e530237790"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc"],"text":"Packaged Cursor and Claude Code skills cover tool setup, enterprise search, workflow creation, UI surface discovery, colleague distillation, and an assistant inbox/orchestrator skill.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_701d4f4cf6e92d869a0fbe8a1a44bb64694ab3eef424c4a71f9da30d32056670","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_0513554258d5b629352c6b55b997d4d982a0107acc864388eaa425433da7a64b","slc_c144b3432940debff9d764cbf0a1172c561ded383d11c6315c641eb28b6e972f"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc"],"text":"The runtime exposes a CLI entry point 10x-host that takes --trigger, --workflow, and --engine arguments, e.g. running a slack-polling trigger with the assistant workflow and the cursor engine.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_88a1bd886750686b0b20c4df52c45a5556c140c89121d5076bf250fed9809725","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_aebf8f32a0d0c8363043f5d30e2cff5341b0e94a41b07ef322dd3a34edd67c90","slc_c097184777cd813ffa2e4631132a3dac5c19cc2e694d62086b56c37b79cd0d71"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc","src_c068935bbab55ca4b80f4ee5db280e47"],"text":"Repository development practice: contributions follow a 'run before you write' rule — every snippet must be executed and seen to succeed — and new tool work starts in TENX_PRIVATE_DIR/personal/, never directly in tool_connections/, with promotion to the public repo only via staging/ and a PR after verification and scrubbing.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
{"access":"public","created_at":"2026-09-14T04:34:21Z","created_by_operation":"op_a524d100cdee46bc9d0e6a70073be399","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_88fb1340656cfebd26cee1886e7ced6d0ab09ee1500cbc411cd840262b348812","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"zhixiangluo/10xproductivity@9a7da40bc798 snapshot cfc92ae293e2d435","timeframe":null},"slice_ids":["slc_50e8a2f8fec0d1fba1ad0b8429d08b680efc30c9950c43fde9a65c4dade2dd3a","slc_caef1e1db86f588473238c505a87c011d227b47ec1d19a7828b3ee91db2ea60c"],"source_ids":["src_8b423c7f8e1e5eb09bfee65848222ffc"],"text":"Per the README's status table, tool connections, enterprise search, and agent skills are available today, while triggers, runtime, and reusable workflows are early; learning and memory (scheduled reflection, durable memory) are roadmap items not yet complete.","updated_at":"2026-09-14T04:34:21Z","updated_by_operation":"op_a524d100cdee46bc9d0e6a70073be399"}
