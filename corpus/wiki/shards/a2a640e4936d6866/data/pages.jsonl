,"clm_9949c9c5f9fd94f16d5909b6e4d3269c1086caa0d7b11e2925b0499568a82229","clm_9956bb50131e6ed127f2eda66b23e5f9e86f16ab9649e0740bff89cada5036aa","clm_ca1122903fb4773dd73c69ec81c2d3eb6077f29fdb48bc2758aeda3ab49a3f82","clm_cab5a1fa178971ea023cffef36eb30af85c3a1faef14849d68af9daecd41baf5","clm_d13e86e7b71a2d235b00d69607af451e7d611baabc9cec2863984070fc823c5a","clm_f5f29fbd0b7ae4437ede475e49b58c6a2e0a9b84600b96aa8dcda5093ca48e8c"],"created_at":"2026-09-14T02:29:04Z","created_by_operation":"op_fe0baadd82904f6aac1cede4954d8849","id":"pg_80a0640396c85c16af4db71f2ed2470e","maturity":"draft","page_type":"entity","path":"pages/entities/oxgeneral-orch-b71f2ed2470e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"oxgeneral/orch","updated_at":"2026-09-14T02:29:04Z","updated_by_operation":"op_fe0baadd82904f6aac1cede4954d8849"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:29:04Z","created_by_operation":"op_fe0baadd82904f6aac1cede4954d8849","id":"pg_870f0e40961e531583961030c3811010","maturity":"draft","page_type":"source","path":"pages/sources/oxgeneral-orch-claude-md-c066dc013e98-1030c3811010.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_95712034f6f45d75bfaf4fa2ce9367e9"],"title":"oxgeneral/ORCH/CLAUDE.md @ c066dc013e98","updated_at":"2026-09-14T02:29:04Z","updated_by_operation":"op_fe0baadd82904f6aac1cede4954d8849"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_08569e44fc8bd43487689889348c5d96d9dced2ae1a09a227644c62f95570c32"],"opposing_claim_ids":[],"text":"`orch serve` runs a headless daemon with a tick loop that picks up newly added tasks; a `--once` mode processes todo tasks and exits, with exit 0 meaning all done and exit 1 indicating failures."},{"claim_ids":["clm_0bd0f5f22d71c11d5ef518b271eb0f8eae03cad958f334c27546cd479d10c770"],"opposing_claim_ids":[],"text":"The package can be imported as a library; the core reportedly has no dependency on the CLI/TUI layers, letting users build their own interface on top."},{"claim_ids":["clm_13bd75b62e6872704931e609b0d874af568111c79315a5b02ed41b89bb2279eb"],"opposing_claim_ids":[],"text":"A CTO-style agent decomposes a high-level goal into tasks and delegates them; failed tasks auto-retry with exponential backoff and stalled agents are killed and re-queued by zombie detection."},{"claim_ids":["clm_4fca750d1579bb89b05b5efa0f3a5c80935ae5805b75527c1a6f1887e4112fe6"],"opposing_claim_ids":[],"text":"Storage is file-based using YAML/JSON/JSONL, and agents communicate through direct messages, team broadcasts, and a shared context store."},{"claim_ids":["clm_5ecd8e0f55cf6451263727dcc2012865189445fd8a7bf5ac96586463c8cca31b"],"opposing_claim_ids":[],"text":"The CLI is published as the npm package @oxgeneral/orch, installed globally, and launching `orch` in a project opens a TUI dashboard after auto-initialization."},{"claim_ids":["clm_639e84802208e1b57113845f1f3b831ab7353ba48554e3009d850bdad05f0bdc"],"opposing_claim_ids":[],"text":"ORCH targets solo founders and small teams running multiple AI coding/CLI agents on one project, positioning itself as open-source (MIT) orchestration where users pay only for their own AI API usage."},{"claim_ids":["clm_73a2fa9a38b90e6f54419894110e30021ecd96cfae5bac23943d763303bf82e5"],"opposing_claim_ids":[],"text":"Eight adapters are documented: Claude Code, OpenCode, Codex, Pi, Cursor, Grok, Antigravity, and Shell, where the shell adapter wraps any terminal CLI tool as an agent."},{"claim_ids":["clm_7516dc2b3db2d8609a70e6c20dd1259b622fd18cf9f5c898f37ea6740ce0c709"],"opposing_claim_ids":[],"text":"The daemon enforces single-orchestrator-per-project via a lock file (.orchestry/orchestry.lock), shuts down gracefully on SIGINT/SIGTERM, logs heap usage each tick, and throttles idle-tick logging."},{"claim_ids":["clm_81fca59ea3a29c8b3a5ac861dcd6d032cd4d76749a8650f0174e25496be49562"],"opposing_claim_ids":[],"text":"Pre-built organization templates are provided (e.g. startup-mvp, pr-review-corp, migration-squad, security-dept, content-agency, data-lab, sales-machine, docs-team) deployable via `orch org deploy`, with export of custom setups."},{"claim_ids":["clm_95b34a8fc44b365c6a4f30f774c90e4a0920f1eecc82f8a9fdfb9f711799b51e"],"opposing_claim_ids":[],"text":"The runtime requires Node.js >= 20 on macOS, Linux, or WSL2, and needs no database, cloud service, Docker, or GPU since LLMs are accessed via API."},{"claim_ids":["clm_9949c9c5f9fd94f16d5909b6e4d3269c1086caa0d7b11e2925b0499568a82229"],"opposing_claim_ids":[],"text":"After installation, an `/orch` skill is reportedly available in Claude Code, translating natural-language requests into orch commands for agents, tasks, goals, and runs."},{"claim_ids":["clm_9956bb50131e6ed127f2eda66b23e5f9e86f16ab9649e0740bff89cada5036aa"],"opposing_claim_ids":[],"text":"Each agent works in an isolated git worktree on its own branch, and code reaches main only after explicit user approval through a mandatory review step in the task state machine."},{"claim_ids":["clm_ca1122903fb4773dd73c69ec81c2d3eb6077f29fdb48bc2758aeda3ab49a3f82"],"opposing_claim_ids":[],"text":"Serve mode emits one JSON line per event (e.g. agent:started, task:status_changed, orchestrator:tick) with configurable json/text format, optional log file, and a default 10000 ms tick interval."},{"claim_ids":["clm_cab5a1fa178971ea023cffef36eb30af85c3a1faef14849d68af9daecd41baf5"],"opposing_claim_ids":[],"text":"Tasks flow through a state machine (todo → in_progress → review → done) with validated transitions, and no code merges without approval."},{"claim_ids":["clm_d13e86e7b71a2d235b00d69607af451e7d611baabc9cec2863984070fc823c5a"],"opposing_claim_ids":[],"text":"The documented source layout includes domain (models, state machine), application (orchestrator engine, services, event bus), infrastructure (adapters, file storage, process management, LiquidJS templates, git worktree workspace), cli (Commander.js), and tui (Ink + React)."},{"claim_ids":["clm_f5f29fbd0b7ae4437ede475e49b58c6a2e0a9b84600b96aa8dcda5093ca48e8c"],"opposing_claim_ids":[],"text":"ORCH exposes a CLI including commands such as orch init, doctor, agent add/list, org deploy/export, task add/assign/cancel, team create, goal add, msg send/broadcast, run, serve, status, logs, and tui."}],"claim_ids":["clm_08569e44fc8bd43487689889348c5d96d9dced2ae1a09a227644c62f95570c32","clm_0bd0f5f22d71c11d5ef518b271eb0f8eae03cad958f334c27546cd479d10c770","clm_13bd75b62e6872704931e609b0d874af568111c79315a5b02ed41b89bb2279eb","clm_4fca750d1579bb89b05b5efa0f3a5c80935ae5805b75527c1a6f1887e4112fe6","clm_5ecd8e0f55cf6451263727dcc2012865189445fd8a7bf5ac96586463c8cca31b","clm_639e84802208e1b57113845f1f3b831ab7353ba48554e3009d850bdad05f0bdc","clm_73a2fa9a38b90e6f54419894110e30021ecd96cfae5bac23943d763303bf82e5","clm_7516dc2b3db2d8609a70e6c20dd1259b622fd18cf9f5c898f37ea6740ce0c709","clm_81fca59ea3a29c8b3a5ac861dcd6d032cd4d76749a8650f0174e25496be49562","clm_95b34a8fc44b365c6a4f30f774c90e4a0920f1eecc82f8a9fdfb9f711799b51e","clm_9949c9c5f9fd94f16d5909b6e4d3269c1086caa0d7b11e2925b0499568a82229","clm_9956bb50131e6ed127f2eda66b23e5f9e86f16ab9649e0740bff89cada5036aa","clm_ca1122903fb4773dd73c69ec81c2d3eb6077f29fdb48bc2758aeda3ab49a3f82","clm_cab5a1fa178971ea023cffef36eb30af85c3a1faef14849d68af9daecd41baf5","clm_d13e86e7b71a2d235b00d69607af451e7d611baabc9cec2863984070fc823c5a","clm_f5f29fbd0b7ae4437ede475e49b58c6a2e0a9b84600b96aa8dcda5093ca48e8c"],"created_at":"2026-09-14T02:29:04Z","created_by_operation":"op_fe0baadd82904f6aac1cede4954d8849","id":"pg_b4a83545f7145fa187253d2b15e83295","maturity":"draft","page_type":"source","path":"pages/sources/oxgeneral-orch-readme-md-c066dc013e98-3d2b15e83295.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1a8c9323c4b859c1958c10eabc7950f2"],"title":"oxgeneral/ORCH/readme.md @ c066dc013e98","updated_at":"2026-09-14T02:29:04Z","updated_by_operation":"op_fe0baadd82904f6aac1cede4954d8849"}
