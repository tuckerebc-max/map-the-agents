turity":"draft","page_type":"entity","path":"pages/entities/jcz2020-par-0c85ada37076.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"jcz2020/par","updated_at":"2026-09-14T02:07:13Z","updated_by_operation":"op_ef33a2981a9b4133bc896ec929d9d310"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_287d7a6bdf205125f9a6aebb9a620f644db55db6c308a7ac2a3f10a5cb69631a"],"opposing_claim_ids":[],"text":"The bash tool uses a command ADT with no raw-shell constructor, so shell injection is claimed to be unrepresentable at the type level; duplicate tool names return an error rather than overwriting."},{"claim_ids":["clm_38b3b614dd6b2158cdac338005f9ced0ecc5692948609452d83720acd17ceea6"],"opposing_claim_ids":[],"text":"The codebase is layered into core (types, runtime, ReAct engine, workflow engine, cancellation, persistence writer), providers (OpenAI, Anthropic, mock), tools, persistence, event bus, and middleware modules."},{"claim_ids":["clm_fc38c0b95d1f3b738f6983995e6d5826619227dd4b46394b29a6442b274dc80b"],"opposing_claim_ids":[],"text":"PAR runs its stack on Eio structured concurrency: each Runtime has an Eio switch as cancellation root, and Runtime.close cancels all fibers including tool handlers and LLM streams."}],"claim_ids":["clm_287d7a6bdf205125f9a6aebb9a620f644db55db6c308a7ac2a3f10a5cb69631a","clm_38b3b614dd6b2158cdac338005f9ced0ecc5692948609452d83720acd17ceea6","clm_fc38c0b95d1f3b738f6983995e6d5826619227dd4b46394b29a6442b274dc80b"],"created_at":"2026-09-14T02:07:13Z","created_by_operation":"op_ef33a2981a9b4133bc896ec929d9d310","id":"pg_51eb060291ae5e5aaa3cf7b081f51690","maturity":"draft","page_type":"source","path":"pages/sources/jcz2020-par-docs-explanation-architecture-md-4b593db4465d-f7b081f51690.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_abf0d85fbb36593aa2b315e287eb9f3e"],"title":"jcz2020/par/docs/explanation/architecture.md @ 4b593db4465d","updated_at":"2026-09-14T02:07:13Z","updated_by_operation":"op_ef33a2981a9b4133bc896ec929d9d310"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:07:13Z","created_by_operation":"op_ef33a2981a9b4133bc896ec929d9d310","id":"pg_6024e43932145eb9936e6bf8a1d182fb","maturity":"draft","page_type":"source","path":"pages/sources/jcz2020-par-docs-sdk-workflow-md-4b593db4465d-6bf8a1d182fb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_de3a7ae5e96f5ea8ac5a826d44f2f26d"],"title":"jcz2020/par/docs/sdk/workflow.md @ 4b593db4465d","updated_at":"2026-09-14T02:07:13Z","updated_by_operation":"op_ef33a2981a9b4133bc896ec929d9d310"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4e6d0dcfda74efaaaa32a88ce824bed5daef8bfe4a891d2b072463f372f747a9"],"opposing_claim_ids":[],"text":"A Memory_service provides cross-session memory with a default SQLite+FTS5 backend, search modes (keyword, vector, hybrid with RRF, auto), and get_fn/upsert_fn for stable-ID plan-then-execute updates."},{"claim_ids":["clm_aaeb50c938b30d1eb43a048573f133afc3ef11d77e5125f031c6535936f6de5e"],"opposing_claim_ids":[],"text":"When memory is configured, three builtin tools (recall_memory, remember_memory, search_history) are auto-registered and scoped per session via invoke_context.session_id."},{"claim_ids":["clm_c8099bb7d88629e43b01524e418d0c8503408ca30ffca88a56a4aa6ea049e035"],"opposing_claim_ids":[],"text":"Each Runtime has its own memory service; cross-agent knowledge sharing requires a shared SQLite file or a future remote backend, per the memory docs."}],"claim_ids":["clm_4e6d0dcfda74efaaaa32a88ce824bed5daef8bfe4a891d2b072463f372f747a9","clm_aaeb50c938b30d1eb43a048573f133afc3ef11d77e5125f031c6535936f6de5e","clm_c8099bb7d88629e43b01524e418d0c8503408ca30ffca88a56a4aa6ea049e035"],"created_at":"2026-09-14T02:07:13Z","created_by_operation":"op_ef33a2981a9b4133bc896ec929d9d310","id":"pg_f3656d98511d55958445d29d1836142a","maturity":"draft","page_type":"source","path":"pages/sources/jcz2020-par-docs-sdk-memory-md-4b593db4465d-d29d1836142a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e71291c5e30b5f149db5da9d32b19cb8"],"title":"jcz2020/par/docs/sdk/memory.md @ 4b593db4465d","updated_at":"2026-09-14T02:07:13Z","updated_by_operation":"op_ef33a2981a9b4133bc896ec929d9d310"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_17efa93249569ba14f7061a5f1ff973c4d021c391ed930da6aa077a7e5358c4d"],"opposing_claim_ids":[],"text":"PAR is described as a modular, type-safe agent runtime written in OCaml, usable from Python or OCaml, positioned as a LangChain/LangGraph-style framework."},{"claim_ids":["clm_3d9ff12e2445ecbd994c1603fa82082ec7f8dd89782e87f5f7adb0b3b85b19ba"],"opposing_claim_ids":[],"text":"PAR builds on OCaml 5.4 effects, the Eio concurrency library, and dune, and is MIT-licensed; Python bindings are published on PyPI."},{"claim_ids":["clm_4f835b48204545903ae290e8d4f5018038f42faac4ab64a3f60992ff22b6f2c8"],"opposing_claim_ids":[],"text":"The runtime exposes two API surfaces: an OCaml SDK (installed via opam pin) and Python bindings installable with pip as par-runtime."},{"claim_ids":["clm_52ca1815796eb74a0131afeb6334200c72f4887b33bac4dae1b52dff9ac4c638"],"opposing_claim_ids":[],"text":"Repository development practice: contributions follow CONTRIBUTING.md for dev setup, PR conventions, and code style, and docs follow the Diataxis tutorial/how-to/reference/explanation structure."}],"claim_ids":["clm_17efa93249569ba14f7061a5f1ff973c4d021c391ed930da6aa077a7e5358c4d","clm_3d9ff12e2445ecbd994c1603fa82082ec7f8dd89782e87f5f7adb0b3b85b19ba","clm_4f835b48204545903ae290e8d4f5018038f42faac4ab64a3f60992ff22b6f2c8","clm_52ca1815796eb74a0131afeb6334200c72f4887b33bac4dae1b52dff9ac4c638"],"created_at":"2026-09-14T02:07:13Z","created_by_operation":"op_ef33a2981a9b4133bc896ec929d9d310","id":"pg_f6b05880cd525828ab605016c6e01cf6","maturity":"draft","page_type":"source","path":"pages/sources/jcz2020-par-readme-md-4b593db4465d-5016c6e01cf6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_05660ddbffd15a3db280352d74b41505"],"title":"jcz2020/par/README.md @ 4b593db4465d","updated_at":"2026-09-14T02:07:13Z","updated_by_operation":"op_ef33a2981a9b4133bc896ec929d9d310"}
