{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_093f811e18a7a7f0a85629e6a9f7dfe7f85aea0d18e7165abdfff6ff2958ce65","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_1a431bbd7d59671c3a7cbdd61c83110bcad3cf3f77498925c195fee0454de1e1","slc_229190db566977041d4671e2d875e705bdde19cb479e3119a1bb3617cd58c71c","slc_4ef11856bd8a7214df712ea69e4fe01aa652a13938c5d8f46179c8755c31880d","slc_b8ae6c1c7b5f3139a7be8cfdb7ac663d78e1b9aec1918b491e26b22849b363de","slc_f986626744f4c396313c8de117c6276ff878cb3f366e536daf38f151d4d69056"],"source_ids":["src_7703344396ae5857bf335a317b167f5e","src_7bbdab5e2b995489b8288bd030c53b41"],"text":"Repository development practice: fork PRs should change source only while maintainers regenerate the SDK after merge; releases use Changesets on main, npm trusted publishing via OIDC (no NPM_TOKEN), and a chart-release pipeline triggered after the trueforge npm publish.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_20253b23d80da82a0ea8f881cc79829cbf1b3a0bd160debad7f942525bb80008","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_2cf56716c3216aad4c0aca70aa5e3270023307829dde499b1865b6b292d36568","slc_428d22b6c9d023babb6da161a694ab5be620a2cae729ddb9962c0478dc405849"],"source_ids":["src_7bbdab5e2b995489b8288bd030c53b41"],"text":"TrueForge is an open-source agent harness that runs the agent execution loop (model calls, MCP tools, skills, sandboxing, approvals, context management, session state) and exposes it as a chat UI, an HTTP API with a TypeScript SDK, and an embeddable UI SDK.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_44b21d610b4018b6fae8bddca5dd0133d207f337af491549d90b463683bc0987","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_2686bb31ae155d1f157f1851f7620496b5b4e83b8452eea081f2980ca2f86f64","slc_698a518ca83a83f3d5657d2e8832f15dfa8d9daa10af1588ff666ebe2670aec4","slc_7123e4a15af6ba404422baf595d448896c9fff69c8cc13c7359a5916b789beb3","slc_81f94822eb76a2aeb28203fa9822d7096504d6bcdd9390d78f35e242ab6d2b4a","slc_87cc4090bdc4d4b160444a7608931e56ba02129f84640e62e3e4eea2ee53ba72"],"source_ids":["src_af4b9237e0ad510db44ff75978805333"],"text":"The UI SDK offers three levels of control: using the TrueForgeUI component directly, supplying a custom layout, or mounting providers manually; it exports runtime-connected containers (ThreadContainer, ComposerContainer, ThreadListContainer) and presentational atoms replaceable via an overrides mechanism.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6a0415fe45b851d4d066d9d809f8b1428afe6f9cb9252e534806fae6db2c95d4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_1139799acbbf2de5800d314026c687293a172a3a3dfc1e743c3035368d0209eb"],"source_ids":["src_7bbdab5e2b995489b8288bd030c53b41"],"text":"The harness provides context-engineering features including subagents, deferred tool loading, Code Mode, large-result offloading, and compaction, plus human checkpoints such as tool approval, ask-user-questions, and Generative UI in chat.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_71eb11687ed624c56a63f5257d4ea9dafd37e2ddd22d6a0a63ec72b619e9c768","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_d7d22adf7276ea90f6cdb4d354bd449a2303d15185abbafab312575901245930"],"source_ids":["src_d535d729c6e054c3ab4c07de8de30322"],"text":"Daytona is documented as the only sandbox provider supported today, with support for additional providers planned.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_78f9d7a12d59986c836ec66817d65ddd1827c03778fd1fc146ce118a18081657","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_2b1e280cdade4b9b1aa738be2c6f0e116c90a5bc08d758cc1aa6e12731bf0361","slc_ad19024d63a8d2958a4d80268d17ff832d292f0ae3455ea40b6936acc3a9f51b","slc_d0f77ebf927026aabed90f8a7877926b6f04e51dabd1874279051ff298020104"],"source_ids":["src_7703344396ae5857bf335a317b167f5e","src_7bbdab5e2b995489b8288bd030c53b41"],"text":"The project requires Node.js >= 22.14, is MIT-licensed, and its Helm chart bundles optional Bitnami Postgres and Redis subcharts that can be disabled via postgresql.enabled=false / redis.enabled=false.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7b4d2344119d1b2a05de17c62ee1d9f80c5d801f6e2c39e7e3c00a1e43fab86c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_1139799acbbf2de5800d314026c687293a172a3a3dfc1e743c3035368d0209eb","slc_4124f9af0d38d86459349d96f7ed68a93a0cc9b037131a6db2cd02518eb0af96","slc_49be54490bdf6e4d81b36414af95dbdaf1a3191d7aeacfd9c1020ceb41b3d3bf","slc_8e7cd5caa385549a32942bde0d5f6e9b9aa9a39ff39fdc7d3510946f149ba599"],"source_ids":["src_7bbdab5e2b995489b8288bd030c53b41","src_d535d729c6e054c3ab4c07de8de30322"],"text":"MCP tool connectivity supports remote servers with header auth or OAuth, including in-chat authorization; sandbox provider configuration requires a Daytona API key with snapshot-create permission, and the sandbox is off by default per agent.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7cd739cb3940f7caa6e602600f903871cc4e0e8d575b893474173211fe41fdc2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_0753c91a3a85d6ddf56f0802ac90462a4af260be158bbf635a14fc25f0f28e0b"],"source_ids":["src_af4b9237e0ad510db44ff75978805333"],"text":"The UI SDK exposes stable styling hooks (.aui-root, .aui-markdown, .aui-monaco, data-slot attributes), though some slot values like avatar and tool-call-card lack the aui_ prefix, so users should inspect elements rather than assume the prefix.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8bd2e81d588e3eca3a493ebabda623dc68d2b006af856c2a343748598d1772f6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_4a047c0b20ada160cf0c8c19b72abdf778f677e0f39f074802c53f319c2a8963","slc_6ca05b4d049d8c6746c1bf9dd871853acacc61b8a5c2e629b75713aa7c4cb4dd","slc_d1f200eeb665286ae31e9718847b8e1a678a504ca7d6abc0c0ca505d23d7d55f"],"source_ids":["src_7bbdab5e2b995489b8288bd030c53b41"],"text":"TrueForge runs in local mode (single process, SQLite, no login by default, intended for localhost only) or hosted mode (Postgres + Redis) deployable via Docker Compose, Helm, or Railway.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_99f4b979158eba961984bec1d22ca7c98a82f33ec9ed483588a9a68f4eab5fd6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_63a1e2bff95360c7913f5726c292c515b86a5aff0a7c3424c55ec7fd65b64bef","slc_c8aef5259a090aad1aaa20452be56059961e7fd7bc62130e487e3a6dc086fd22"],"source_ids":["src_7bbdab5e2b995489b8288bd030c53b41"],"text":"The README reports benchmarks comparing TrueForge against Claude Managed Agents and deepagents on the same tasks, tools, and model, claiming equal accuracy at lower cost, with reproduction materials in the benchmark/ directory.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a89dea5ff8fe2a79c96701733122f6784feeba26eeaba48ad1189b976bcd3890","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_07be49f0ea4ab6f44d08b7bf05df5e155bde22ded2049f01c9b73dc5b2063317","slc_70b6d031cd88cdeb2e994cef503e874bdb08871340d7c4f4a671422eab460320","slc_f6b05c34b00e01546dda3266e1eb3896089edc149dde1e8e69f6265da35a844b","slc_fb1116ee04a665817f5791fc13a1f5ffb6014aaf949e69c061b82b536b3af40c"],"source_ids":["src_0bf5565b74485e13bf77cb1be60755d0"],"text":"Skills are git-backed directories rooted at a SKILL.md with YAML frontmatter (name, description); only the description is visible upfront (progressive disclosure), and when chosen the repo is materialized under /opt/tfy/skills/{name} in the sandbox, which must be enabled.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e18d3f2a282a09a65796cd0920ade1ac22a786c0da091bcc1af20e09b6a22071","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_0b6144a3b7f9755ad8fc43833a11b1fe8f62746441864404cd4fe8aa60f7b712","slc_4956dc17815950fb998b7e225d7379d2e243c9af18f843d03fe58ca1728799c4","slc_b43f8e6f0f3af123926908ee9c0b3f9b37904cc50c8ea7be320018e3804aeb9d","slc_ea759b065c92cb248ca5316b4f5b129bcd36da5a1a5e8e69373ae05c860d6d9a"],"source_ids":["src_d535d729c6e054c3ab4c07de8de30322"],"text":"TrueForge adopts a 'sandbox as tool' pattern: the agent loop and credentials stay in the harness while the sandbox only runs code, file, and shell operations, is provisioned on demand, and never holds model or MCP credentials.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e1b36f0681d3738e57f4fdf5ea5d6447d7685f1cadb715be60e239d409a24dbb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_129281011096eb7a6af93c6af8ab39edce4cdb5032b3d97f9fc3c5d956f22757","slc_618bb42b18e62457ff3069afa014e314f4fc4350200ba760e75a1c86604f9e4a"],"source_ids":["src_7703344396ae5857bf335a317b167f5e"],"text":"The repo ships four npm packages: trueforge-core (library), trueforge (app + CLI, tarball includes dist/_frontend/), trueforge-sdk (Fern-generated, not hand-edited), and trueforge-ui (embeddable chat UI); packages/frontend is unpublished and its build is copied into the trueforge tarball.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
{"access":"public","created_at":"2026-09-14T03:19:56Z","created_by_operation":"op_cb812f1ec59a49c198d03df585045e60","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e96706f5f9f4c895019cf7594376e62a1bf9d29617e70dfde421504ef0d4c98c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"truefoundry/trueforge@4bf9ce063019 snapshot 3a164df5c5bd7b77","timeframe":null},"slice_ids":["slc_68b79a8873bedb995543ed98c7558ed73fdd815595e76e6ba28fc1a839a3c20d","slc_b7ae8cdfffb730366363630e3c760f10d0a78c15b021747ba2530eecebf40899","slc_e75a6cd774efd46621755cef252962ac006b9dc62d80afc769c22d98d15799a1"],"source_ids":["src_005664ec711d5c4c9a7c7416a8a1880c"],"text":"In hosted mode with login enabled, the agent library is not scoped per user or team: agents created by anyone are visible to all authenticated users on the deployment, though session history stays owner-scoped and settings remain admin-only.","updated_at":"2026-09-14T03:19:56Z","updated_by_operation":"op_cb812f1ec59a49c198d03df585045e60"}
