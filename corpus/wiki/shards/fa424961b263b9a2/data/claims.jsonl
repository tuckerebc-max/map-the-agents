{"access":"public","created_at":"2026-09-14T04:01:14Z","created_by_operation":"op_65611af5f50f4aa38b45a1633cd795ed","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_42f4ad5dacb79504f42de84f269a6a34fca034edcf82b5d2820131447546e83b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"jo-inc/pi-reflect@33a72886c8d5 snapshot 48284f3d7486af39","timeframe":null},"slice_ids":["slc_9c28950affa688699395c4fde4b61c53092a6627f657979746ebe3b9eef72f3b"],"source_ids":["src_d502c9fcc43755b3a8a64eeded33742e"],"text":"Documented runtime constraints: sessions with fewer than 3 exchanges are not considered substantive, and the target file must be at least 100 bytes; skipped edits are logged with reasons such as ambiguous match or text not found.","updated_at":"2026-09-14T04:01:14Z","updated_by_operation":"op_65611af5f50f4aa38b45a1633cd795ed"}
