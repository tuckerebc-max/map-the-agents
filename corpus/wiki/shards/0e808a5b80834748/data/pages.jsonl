{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_260b9aab8b9fd25e04baa5583a17c8fa36f5189f1ec44a357580eea248080e6c"],"opposing_claim_ids":[],"text":"The product supports four LLM providers (LiteLLM, OpenAI, Groq, OpenRouter) per MODEL-CONFIGS.md, with LiteLLM enabling local models via Ollama; CLAUDE.md additionally lists cerebras and anthropic providers."},{"claim_ids":["clm_397777d17a11c7c6ec5839c577732e1bfc70033e9df97af1f3fe91daf46b6551"],"opposing_claim_ids":[],"text":"Repository development practice: contributors use gclient sync and npm install, build via npm run build, run Karma/Mocha unit tests, Puppeteer webtests, and ESLint, and must add tests and pass lint before PRs reviewed by maintainers."}],"claim_ids":["clm_260b9aab8b9fd25e04baa5583a17c8fa36f5189f1ec44a357580eea248080e6c","clm_397777d17a11c7c6ec5839c577732e1bfc70033e9df97af1f3fe91daf46b6551"],"created_at":"2026-09-14T03:05:59Z","created_by_operation":"op_5dd7823929194c2ab5c0d74488307978","id":"pg_2fa556756c0557199e9850ab18b92680","maturity":"draft","page_type":"source","path":"pages/sources/browseroperator-browser-operator-core-claude-md-85da86c2a942-50ab18b92680.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c40a356f5c8d5824a4200837928a61db"],"title":"BrowserOperator/browser-operator-core/CLAUDE.md @ 85da86c2a942","updated_at":"2026-09-14T03:05:59Z","updated_by_operation":"op_5dd7823929194c2ab5c0d74488307978"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_260b9aab8b9fd25e04baa5583a17c8fa36f5189f1ec44a357580eea248080e6c"],"opposing_claim_ids":[],"text":"The product supports four LLM providers (LiteLLM, OpenAI, Groq, OpenRouter) per MODEL-CONFIGS.md, with LiteLLM enabling local models via Ollama; CLAUDE.md additionally lists cerebras and anthropic providers."},{"claim_ids":["clm_58a6e97f53bb4db7a1aa17c4cac19e949ea5884b80486adc2573f1f8ed86a722"],"opposing_claim_ids":[],"text":"Browser Operator is described as an open-source, privacy-focused AI browser for research, analysis, and automation that runs locally, with releases for macOS and Windows."},{"claim_ids":["clm_7321942547ace4ab29baf69a23e68b5a79a131f7d9f9e5118e081d07b1b6cfef"],"opposing_claim_ids":[],"text":"Stated system requirements are macOS 10.15+ or Windows 10 64-bit, 8GB RAM (16GB recommended), and 2GB free disk space; the project is licensed under BSD-3-Clause."}],"claim_ids":["clm_260b9aab8b9fd25e04baa5583a17c8fa36f5189f1ec44a357580eea248080e6c","clm_58a6e97f53bb4db7a1aa17c4cac19e949ea5884b80486adc2573f1f8ed86a722","clm_7321942547ace4ab29baf69a23e68b5a79a131f7d9f9e5118e081d07b1b6cfef"],"created_at":"2026-09-14T03:05:59Z","created_by_operation":"op_5dd7823929194c2ab5c0d74488307978","id":"pg_5450086dbcaa51088af7555380cc0635","maturity":"draft","page_type":"source","path":"pages/sources/browseroperator-browser-operator-core-readme-md-85da86c2a942-555380cc0635.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d7cfebb240705b38965bfe35144922db"],"title":"BrowserOperator/browser-operator-core/README.md @ 85da86c2a942","updated_at":"2026-09-14T03:05:59Z","updated_by_operation":"op_5dd7823929194c2ab5c0d74488307978"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_260b9aab8b9fd25e04baa5583a17c8fa36f5189f1ec44a357580eea248080e6c"],"opposing_claim_ids":[],"text":"The product supports four LLM providers (LiteLLM, OpenAI, Groq, OpenRouter) per MODEL-CONFIGS.md, with LiteLLM enabling local models via Ollama; CLAUDE.md additionally lists cerebras and anthropic providers."},{"claim_ids":["clm_877e56586ffe66be75a509e9c3016bd12078f04190a0d376e6d7603becd1bd52"],"opposing_claim_ids":[],"text":"Provider, model, and API-key settings are persisted in localStorage under keys such as ai_chat_provider, ai_chat_model_selection, ai_chat_mini_model, ai_chat_nano_model, and per-provider API key/endpoint keys."},{"claim_ids":["clm_97dd9429faaef74c1a78553c2dfde848594b6653837284b225455e37193d79e5"],"opposing_claim_ids":[],"text":"An evaluation protocol defines JSON-RPC methods including 'configure_llm' for persistent LLM configuration and 'evaluate' requests that can carry per-request model, provider, API key, and endpoint overrides."},{"claim_ids":["clm_c1ba1e5c03074ff33b7e3b526c2b83d60f5242e6b3baa6e00e82816b2f0a7dad"],"opposing_claim_ids":[],"text":"The configuration rollout notes agent-server support for persistent configuration and comprehensive tests/performance testing as still pending (marked in-progress), while earlier phases are marked completed."},{"claim_ids":["clm_e76fda5ac983280fa6a052d8e40fae6757e011a5f1bb41a4952752a234db0aca"],"opposing_claim_ids":[],"text":"LLM configuration uses a three-tier model scheme (Main for agent execution, Mini for lightweight operations, Nano for simple tasks) with configuration precedence of override first, then localStorage fallback."}],"claim_ids":["clm_260b9aab8b9fd25e04baa5583a17c8fa36f5189f1ec44a357580eea248080e6c","clm_877e56586ffe66be75a509e9c3016bd12078f04190a0d376e6d7603becd1bd52","clm_97dd9429faaef74c1a78553c2dfde848594b6653837284b225455e37193d79e5","clm_c1ba1e5c03074ff33b7e3b526c2b83d60f5242e6b3baa6e00e82816b2f0a7dad","clm_e76fda5ac983280fa6a052d8e40fae6757e011a5f1bb41a4952752a234db0aca"],"created_at":"2026-09-14T03:05:59Z","created_by_operation":"op_5dd7823929194c2ab5c0d74488307978","id":"pg_5ba032633b2f52b0bb37147a3a2e6a45","maturity":"draft","page_type":"source","path":"pages/sources/browseroperator-browser-operator-core-model-configs-md-85da86c2a942-147a3a2e6a45.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_38ad4e075add52718a2ce786bcd4d979"],"title":"BrowserOperator/browser-operator-core/MODEL-CONFIGS.md @ 85da86c2a942","updated_at":"2026-09-14T03:05:59Z","updated_by_operation":"op_5dd7823929194c2ab5c0d74488307978"}
