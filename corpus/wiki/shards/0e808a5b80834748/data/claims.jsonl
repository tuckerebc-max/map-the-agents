{"access":"public","created_at":"2026-09-14T03:05:59Z","created_by_operation":"op_5dd7823929194c2ab5c0d74488307978","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_877e56586ffe66be75a509e9c3016bd12078f04190a0d376e6d7603becd1bd52","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"browseroperator/browser-operator-core@85da86c2a942 snapshot 0ff1a873cb718770","timeframe":null},"slice_ids":["slc_7e22aa7a2cc1e37f74a494990c99bf6a06ebb9fe93d222fb64a5f279cfbc5820","slc_8bff759d9de9b27910620d8cf4f4474056337534878efd8449f98fe55c1c5f6f"],"source_ids":["src_38ad4e075add52718a2ce786bcd4d979"],"text":"Provider, model, and API-key settings are persisted in localStorage under keys such as ai_chat_provider, ai_chat_model_selection, ai_chat_mini_model, ai_chat_nano_model, and per-provider API key/endpoint keys.","updated_at":"2026-09-14T03:05:59Z","updated_by_operation":"op_5dd7823929194c2ab5c0d74488307978"}
{"access":"public","created_at":"2026-09-14T03:05:59Z","created_by_operation":"op_5dd7823929194c2ab5c0d74488307978","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_97dd9429faaef74c1a78553c2dfde848594b6653837284b225455e37193d79e5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"browseroperator/browser-operator-core@85da86c2a942 snapshot 0ff1a873cb718770","timeframe":null},"slice_ids":["slc_09e04d2b55d4dba7f4d2958664ad2231d1f8200428b3ed123ccc1f46a48cbb33","slc_155ae435c43daff69f59bf0b82de6042586aada6f2f53d9a1156593e9b8d7f73","slc_1cd490ed49c1836253cadc99b7c90fead8a88b8039dce64910b4b72a15186ac6","slc_d43043f93deb0664a41de03389a3e0a147c23083c946877347c5ca08e2d5ba58"],"source_ids":["src_38ad4e075add52718a2ce786bcd4d979"],"text":"An evaluation protocol defines JSON-RPC methods including 'configure_llm' for persistent LLM configuration and 'evaluate' requests that can carry per-request model, provider, API key, and endpoint overrides.","updated_at":"2026-09-14T03:05:59Z","updated_by_operation":"op_5dd7823929194c2ab5c0d74488307978"}
{"access":"public","created_at":"2026-09-14T03:05:59Z","created_by_operation":"op_5dd7823929194c2ab5c0d74488307978","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c1ba1e5c03074ff33b7e3b526c2b83d60f5242e6b3baa6e00e82816b2f0a7dad","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"browseroperator/browser-operator-core@85da86c2a942 snapshot 0ff1a873cb718770","timeframe":null},"slice_ids":["slc_b39a8170fa0786dee2783603e1aa1950220a2b6441ddb4a06ba1588b16c0e88f","slc_b9920860d5f9e41647aafcf24be555e767de8f2b1f992efa285ab7eed777a5ee"],"source_ids":["src_38ad4e075add52718a2ce786bcd4d979"],"text":"The configuration rollout notes agent-server support for persistent configuration and comprehensive tests/performance testing as still pending (marked in-progress), while earlier phases are marked completed.","updated_at":"2026-09-14T03:05:59Z","updated_by_operation":"op_5dd7823929194c2ab5c0d74488307978"}
