{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2408e8f33183dcd90e2ff8396d9e8056f0117cf12876ef72c30161a837da3c89"],"opposing_claim_ids":[],"text":"The plan_and_code agent accepts agent_config options: planning_actions, codegen_actions, and max_codegen_iterations (default 5)."},{"claim_ids":["clm_3dc4bafe7ae41a81772fe7063e68430f8163578031ae6c0113ad264770e6a7a0"],"opposing_claim_ids":[],"text":"AutoPR is a GitHub Action that automatically writes pull requests in response to issues, per its usage guide."},{"claim_ids":["clm_4d9e084e52aebd01a63ef21deb59a10ecda8e047199fe5d28a37469d293e15a1"],"opposing_claim_ids":[],"text":"The action requires an OpenAI API key with ChatGPT access, supplied via the OPENAI_API_KEY secret."},{"claim_ids":["clm_660a173d9b27c35f74bfa43ba91ce0d633d206d9c26673ab15560e4832570687"],"opposing_claim_ids":[],"text":"AutoPR is documented as not optimized for gpt-3.5-turbo; users with gpt-4 API access are advised to use that instead."},{"claim_ids":["clm_7a763f6f905b4edb71d175b28021efd7ec78915dcb8c4aa4593b542ead89a167"],"opposing_claim_ids":[],"text":"Documented inputs include github_token (required), base_branch (default main), model (default gpt-4), context_limit (8192), min/max_tokens, num_reasks, temperature, agent_id (default plan_and_code), and overwrite_existing."},{"claim_ids":["clm_8a908aa0db557dcadaacbe630929da67d1b031907ca55d3d8243a7d9fed71b82"],"opposing_claim_ids":[],"text":"The action is invoked as docker://ghcr.io/irgolic/autopr:latest and configured through workflow 'with:' parameters such as github_token and model."},{"claim_ids":["clm_e22c83a7df8d3c7a5bcc5094a8841d3d99472d82df2767efffb365d120c2d8c7"],"opposing_claim_ids":[],"text":"Triggered runs create a branch named autopr/issue-# and open a PR to the base branch; an existing branch is overwritten by default behavior described in the usage steps."}],"claim_ids":["clm_2408e8f33183dcd90e2ff8396d9e8056f0117cf12876ef72c30161a837da3c89","clm_3dc4bafe7ae41a81772fe7063e68430f8163578031ae6c0113ad264770e6a7a0","clm_4d9e084e52aebd01a63ef21deb59a10ecda8e047199fe5d28a37469d293e15a1","clm_660a173d9b27c35f74bfa43ba91ce0d633d206d9c26673ab15560e4832570687","clm_7a763f6f905b4edb71d175b28021efd7ec78915dcb8c4aa4593b542ead89a167","clm_8a908aa0db557dcadaacbe630929da67d1b031907ca55d3d8243a7d9fed71b82","clm_e22c83a7df8d3c7a5bcc5094a8841d3d99472d82df2767efffb365d120c2d8c7"],"created_at":"2026-09-14T02:05:59Z","created_by_operation":"op_e9727344134948aca44de96d2482b71b","id":"pg_24b761189bad5b31827932e931928054","maturity":"draft","page_type":"source","path":"pages/sources/irgolic-autopr-usage-md-a95671a20d8d-32e931928054.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9d9cac9282ba5e158b3ae8128df8efa3"],"title":"irgolic/AutoPR/USAGE.md @ a95671a20d8d","updated_at":"2026-09-14T02:05:59Z","updated_by_operation":"op_e9727344134948aca44de96d2482b71b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_399d16008598e563f5393cf1f00baae7e37cec11739885977cfcd5d1dd0a184a"],"opposing_claim_ids":[],"text":"Repository development practice: contributors extend AutoPR by subclassing Action (with an id and run method) or Agent (with handle_event), and actions share state via a ContextDict passed between actions."},{"claim_ids":["clm_778e6a72ac56a618bb891b46e62e44b2cd49daeae71496fa3b050c9f1003a60a"],"opposing_claim_ids":[],"text":"Repository development practice: only the IssueLabeledEvent event type is currently supported, with events defined in autopr/models/events.py."},{"claim_ids":["clm_b653979a20ef02eb3857e1d830d13833759dc79f1f4d1d0fba37233b746f4c0b"],"opposing_claim_ids":[],"text":"Repository development practice: each rail run makes two LLM calls — a natural-language chat message, then a guardrails call serializing the response to typed JSON."}],"claim_ids":["clm_399d16008598e563f5393cf1f00baae7e37cec11739885977cfcd5d1dd0a184a","clm_778e6a72ac56a618bb891b46e62e44b2cd49daeae71496fa3b050c9f1003a60a","clm_b653979a20ef02eb3857e1d830d13833759dc79f1f4d1d0fba37233b746f4c0b"],"created_at":"2026-09-14T02:05:59Z","created_by_operation":"op_e9727344134948aca44de96d2482b71b","id":"pg_39e605ad76555b9d8b81f59a033fc4f4","maturity":"draft","page_type":"source","path":"pages/sources/irgolic-autopr-contributing-md-a95671a20d8d-f59a033fc4f4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0dc6ce3784a15daf8cfeeab0b3bc3340"],"title":"irgolic/AutoPR/CONTRIBUTING.md @ a95671a20d8d","updated_at":"2026-09-14T02:05:59Z","updated_by_operation":"op_e9727344134948aca44de96d2482b71b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_33c5062df646da823faccacd3f49ca95de497afc703a2b5a9f01dc7fb7864602"],"opposing_claim_ids":[],"text":"AutoPR is built with Guardrails, described as prompting LLMs to generate structured data with JSON Schemas and re-asking when output does not adhere."},{"claim_ids":["clm_5f0f5e7f4c83e17652c1c69ac12a58e307611ac411b2eb02f0d7c7fecc320a3f"],"opposing_claim_ids":[],"text":"The README frames the project as a historical demo from early 2023 that worked only about 20% of the time, so it appears to be of archival rather than production value."},{"claim_ids":["clm_a7c1bd809b6bccca6ee7ae185620ef39702c0e69844ef976f4bfb6b015033652"],"opposing_claim_ids":[],"text":"The README lists known defects: incorrectly referencing code in other files, duplicating lines, calling nonexistent functions, and only working on GitHub."},{"claim_ids":["clm_af541d84286334777ab40c323ac8dcd3fdf5a51e4daf79d4acab23d8804e7a14"],"opposing_claim_ids":[],"text":"When an issue gets a label containing 'AutoPR', the bot plans a fix, writes code, pushes a branch, and opens a pull request."},{"claim_ids":["clm_b5c91ddb35409d23a2623207d53087bd6b139df6eb10b35e87e7a366432a8707"],"opposing_claim_ids":[],"text":"The GitHub Action was in development and in alpha release at the time of writing."}],"claim_ids":["clm_33c5062df646da823faccacd3f49ca95de497afc703a2b5a9f01dc7fb7864602","clm_5f0f5e7f4c83e17652c1c69ac12a58e307611ac411b2eb02f0d7c7fecc320a3f","clm_a7c1bd809b6bccca6ee7ae185620ef39702c0e69844ef976f4bfb6b015033652","clm_af541d84286334777ab40c323ac8dcd3fdf5a51e4daf79d4acab23d8804e7a14","clm_b5c91ddb35409d23a2623207d53087bd6b139df6eb10b35e87e7a366432a8707"],"created_at":"2026-09-14T02:05:59Z","created_by_operation":"op_e9727344134948aca44de96d2482b71b","id":"pg_83f61840bc6e57d18e471ecd7d33746d","maturity":"draft","page_type":"source","path":"pages/sources/irgolic-autopr-readme-md-a95671a20d8d-1ecd7d33746d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ddb9d1ee012257238df7301d6aa38fb3"],"title":"irgolic/AutoPR/README.md @ a95671a20d8d","updated_at":"2026-09-14T02:05:59Z","updated_by_operation":"op_e9727344134948aca44de96d2482b71b"}
