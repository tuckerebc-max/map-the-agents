{"access":"public","created_at":"2026-09-14T01:44:07Z","created_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a3e393526097aad75f6d81295342d9aeb3a4c008e5a02cbfedd29f17293332ab","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"continuedev/continue@5522c6f44ca0 snapshot 41756b650b1e5612","timeframe":null},"slice_ids":["slc_014ddee9934a6a5f1c27ca93133f361aa89080915df1a76a9be372e79793ea2f","slc_6fb1d959e189ac9188fc2c8add129b5f33b99909ed7b6981e869c600e6b6cdbf","slc_ac1bf0477dcde2e5f39e31dabb5857719e603bad68910a82220a62e52f23bb5d","slc_acb715e8658548e57c25ebaf71ca09cb295b4242443009c58dbb03abd4a065b6","slc_e2f305543172e520362356929b07c98a6bc04bc8b6d02b49dd5b1e2931c65041"],"source_ids":["src_ff692ef8ec3951d2b40c65f104848892"],"text":"Legacy configuration methods are deprecated: `config.json`, workspace-level `.continuerc.json` (with a `mergeBehavior` of merge or overwrite), and programmatic `config.ts` exporting `modifyConfig`.","updated_at":"2026-09-14T01:44:07Z","updated_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d"}
{"access":"public","created_at":"2026-09-14T01:44:07Z","created_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b9805a083b12d5aac53af94492af3febcf9049c14a40bcdbfd5fd354cf60e30a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"continuedev/continue@5522c6f44ca0 snapshot 41756b650b1e5612","timeframe":null},"slice_ids":["slc_1099e384340df578e7320b30db1913a4f855d52f8cdaacb9be5accfe2ac60e3e"],"source_ids":["src_a0f85db0d9c95d59b95f05f0316ba565"],"text":"The project recommends using the Continue CLI instead of the JetBrains plugin.","updated_at":"2026-09-14T01:44:07Z","updated_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d"}
{"access":"public","created_at":"2026-09-14T01:44:07Z","created_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d22f21a396d154d7cd6b5b8a43ea95021f04dafe26f5557f0887365651e93db9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"continuedev/continue@5522c6f44ca0 snapshot 41756b650b1e5612","timeframe":null},"slice_ids":["slc_203fc8a4812c9abac989cf874d58027dbff4370a4739bdb789708a14ef21a025","slc_44456f002cf7c06a22c65169564377b39948b4d5b471a1746aec2b47f4f0e192","slc_77df727011b3aeb6ef651334f5fa7a07879076c5699218764724826704085f8c","slc_ac985ba064d22e5c65a2a9f8066827496f5dd9a48cdfbde76a96b0e73fe809c1","slc_dbf48af88f45165549037a0cdf643ce383ba9b99c132b161ff23c93dbe241e0b"],"source_ids":["src_32828b59d75e5a61bb5cc62b1fb2bf54"],"text":"Repository development practice: CI workflows reference many secrets, including marketplace publishing tokens (VSCE_TOKEN, VSX_REGISTRY_TOKEN), JetBrains signing/notarization credentials, semantic-release npm/GitHub tokens, and AI provider API keys used in PR checks and releases.","updated_at":"2026-09-14T01:44:07Z","updated_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d"}
{"access":"public","created_at":"2026-09-14T01:44:07Z","created_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_eb9bd6021c717d81109cfea7204c6bdbf9dd32bfc05f15c807a07c72a106d138","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"continuedev/continue@5522c6f44ca0 snapshot 41756b650b1e5612","timeframe":null},"slice_ids":["slc_9e7f6218599e79b52b5e57e4929e7de9f829da2c64b866ac54d4c71fec4a3c9c","slc_ce608aee7f61dc34ce7360b1249e5e5b5bd576e4640a82d55fb34fc3ffb812c9"],"source_ids":["src_4c1e20ba052d5b38ba487a6fc6e80a95"],"text":"Sensitive values in config are referenced as environment variables using the `${{ secrets.MY_API_KEY }}` syntax.","updated_at":"2026-09-14T01:44:07Z","updated_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d"}
