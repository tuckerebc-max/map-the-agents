{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_09c19f0310c7ed476f7b7d3f50c5900b375e8fbf42ae4b06d2ccef79099a5878"],"opposing_claim_ids":[],"text":"The README states the continuedev/continue repository is no longer actively maintained and is read-only for all users."},{"claim_ids":["clm_121fbb2742fb703817bcfc68fbe77539468ed59f5dcc0d00181ce04e5ed0d378"],"opposing_claim_ids":[],"text":"Continue is shipped as a CLI, a VS Code extension, and a JetBrains plugin."},{"claim_ids":["clm_7db55eaed9461d1ed54dc03c85da04248d70fa3d1cfe4c5860456f1a0a08d6a9"],"opposing_claim_ids":[],"text":"The final 2.0.0 release removed anonymous telemetry and pulled out authentication across the VS Code extension, CLI, and JetBrains plugin."},{"claim_ids":["clm_b9805a083b12d5aac53af94492af3febcf9049c14a40bcdbfd5fd354cf60e30a"],"opposing_claim_ids":[],"text":"The project recommends using the Continue CLI instead of the JetBrains plugin."}],"claim_ids":["clm_09c19f0310c7ed476f7b7d3f50c5900b375e8fbf42ae4b06d2ccef79099a5878","clm_121fbb2742fb703817bcfc68fbe77539468ed59f5dcc0d00181ce04e5ed0d378","clm_7db55eaed9461d1ed54dc03c85da04248d70fa3d1cfe4c5860456f1a0a08d6a9","clm_b9805a083b12d5aac53af94492af3febcf9049c14a40bcdbfd5fd354cf60e30a"],"created_at":"2026-09-14T01:44:07Z","created_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d","id":"pg_570fbf3726e75a1287d9d749b7bcf368","maturity":"draft","page_type":"source","path":"pages/sources/continuedev-continue-readme-md-5522c6f44ca0-d749b7bcf368.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a0f85db0d9c95d59b95f05f0316ba565"],"title":"continuedev/continue/README.md @ 5522c6f44ca0","updated_at":"2026-09-14T01:44:07Z","updated_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4d5864539bcdf51e95a81c3e778b258bbf1afc348a88eb2603a8c9d83372070a"],"opposing_claim_ids":[],"text":"The CLI uses `CONTINUE_API_BASE` (defaulting to https://api.continue.dev/) and `CONTINUE_API_KEY` for Continue API authentication, per the repository's build-dependency catalog."},{"claim_ids":["clm_d22f21a396d154d7cd6b5b8a43ea95021f04dafe26f5557f0887365651e93db9"],"opposing_claim_ids":[],"text":"Repository development practice: CI workflows reference many secrets, including marketplace publishing tokens (VSCE_TOKEN, VSX_REGISTRY_TOKEN), JetBrains signing/notarization credentials, semantic-release npm/GitHub tokens, and AI provider API keys used in PR checks and releases."}],"claim_ids":["clm_4d5864539bcdf51e95a81c3e778b258bbf1afc348a88eb2603a8c9d83372070a","clm_d22f21a396d154d7cd6b5b8a43ea95021f04dafe26f5557f0887365651e93db9"],"created_at":"2026-09-14T01:44:07Z","created_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d","id":"pg_6f8aa98156175e6883f66e72b672d954","maturity":"draft","page_type":"source","path":"pages/sources/continuedev-continue-build-dependencies-md-5522c6f44ca0-6e72b672d954.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_32828b59d75e5a61bb5cc62b1fb2bf54"],"title":"continuedev/continue/BUILD_DEPENDENCIES.md @ 5522c6f44ca0","updated_at":"2026-09-14T01:44:07Z","updated_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4e7fe7c6a75f64fbda130b207761a141f7578bbea4b1ddfa8dd3399cb91f9a09"],"opposing_claim_ids":[],"text":"Repository development practice: contributors accept an Individual CLA by commenting an agreement phrase on a pull request; the CLA grants Continue Dev, Inc. copyright and patent licenses and terminates patent licenses upon litigation."}],"claim_ids":["clm_4e7fe7c6a75f64fbda130b207761a141f7578bbea4b1ddfa8dd3399cb91f9a09"],"created_at":"2026-09-14T01:44:07Z","created_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d","id":"pg_7b984af5963d5197b5406d036994d304","maturity":"draft","page_type":"source","path":"pages/sources/continuedev-continue-cla-md-5522c6f44ca0-6d036994d304.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_65e6eac83591591bb48643be048c0a62"],"title":"continuedev/continue/CLA.md @ 5522c6f44ca0","updated_at":"2026-09-14T01:44:07Z","updated_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_41906ac0ec4c107b0537188a2ee3562a0c21a39a665fb5bf1dfd99a2dd56cc6b"],"opposing_claim_ids":[],"text":"Inside a CLI TUI session, the `/config` command lists available local configurations and the selection persists to the next session."},{"claim_ids":["clm_674a2ff212bbf8940bc4e473505cab6f4e14bb849447d9e59682a44bf99ef4c9"],"opposing_claim_ids":[],"text":"The CLI supports repeatable launch flags such as `--rule` (file path or inline string) and `--agent` (e.g. `my-org/pr-reviewer`) to inject configuration without editing files."},{"claim_ids":["clm_eb9bd6021c717d81109cfea7204c6bdbf9dd32bfc05f15c807a07c72a106d138"],"opposing_claim_ids":[],"text":"Sensitive values in config are referenced as environment variables using the `${{ secrets.MY_API_KEY }}` syntax."},{"claim_ids":["clm_f9793019a66b0a2c3af655f952dc21515f4050463a82f67fa81f4793e5939c12"],"opposing_claim_ids":[],"text":"The CLI (`cn`) resolves configuration in order: a `--config` file path flag, the last-used saved config, then the default `~/.continue/config.yaml`."}],"claim_ids":["clm_41906ac0ec4c107b0537188a2ee3562a0c21a39a665fb5bf1dfd99a2dd56cc6b","clm_674a2ff212bbf8940bc4e473505cab6f4e14bb849447d9e59682a44bf99ef4c9","clm_eb9bd6021c717d81109cfea7204c6bdbf9dd32bfc05f15c807a07c72a106d138","clm_f9793019a66b0a2c3af655f952dc21515f4050463a82f67fa81f4793e5939c12"],"created_at":"2026-09-14T01:44:07Z","created_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d","id":"pg_c9560508360b548dafd6fecf7b13b893","maturity":"draft","page_type":"source","path":"pages/sources/continuedev-continue-docs-cli-configuration-mdx-5522c6f44ca0-fecf7b13b893.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4c1e20ba052d5b38ba487a6fc6e80a95"],"title":"continuedev/continue/docs/cli/configuration.mdx @ 5522c6f44ca0","updated_at":"2026-09-14T01:44:07Z","updated_by_operation":"op_5aa3f64662b3417295bb00cfd924e45d"}
