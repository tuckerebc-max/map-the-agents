{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_36850e209d5ad562c9fe5522e7deaea9b40cf63a15c48000e5c727f292e347ec","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_996ca0e004e37c24cb80cd971181f46f66032b9df970ceaa5369f0c61b53929f"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"The agent loop remains owned by loushang.agent; plugins may contribute tools, resources, capability providers, and adapters but cannot replace its state machine.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_398429fd77078216e050041812640bbc8965511e7f55d0e0f3d041d4f761a2d5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_020b7ce29d54eb26ca9fb0a1a469df35caaacd7085313e7908ede1ccc85fdc0a","slc_e4e2785a50f2285467de6dc48e48af31c7036fdbf2959b42e51fa0c893239c2e"],"source_ids":["src_c6614789a2475064b7aab9c950e7a14c"],"text":"Loushang is described as a method-native AI work system for running complex work from intent to verified delivery, with the current focus on a coding CLI.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3b80c839ff4fe94da270af5359e37313e09a844637af63371223825f0f54a925","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_856bde11a7515a283aaed48506d066437027912c1d1502053913814458e70559"],"source_ids":["src_c6614789a2475064b7aab9c950e7a14c"],"text":"The system is organized into named layers: method (work contract), work (runtime fact), agent (execution kernel), ai (model access), harness (substrate), coding (V1 surface), tui, and channel.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3bca7e114ba718fa0234897b938aadf034bdf90c90018b1de224e77f933eec5d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_7b7e325b9b9242f08e6bb1b577cd76e42538e2be89274ca1c1bdb15961fff556","slc_90727da35111e109c384221bcff1e53b3bd3000959e8c609b9285ec0b1748804"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"The plugin runtime manifest is a strict plugin.json carrying identity, version, engine range, contribution index, configuration schema, dependencies, requested authority, and execution topology.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_42db6cd5c884fa23bd3ce3a04528b19747e16c2ce8ef2b2e014b0f81a33ee28d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_ef262340d3c4a0744e10c7a2a741ac02b09338acc8b1a6e49b536a4e70d622b4","slc_ef88b47645f78d578c048c4b6519005257dce370c7fedd43a536b5b09b8cdd4d"],"source_ids":["src_c6614789a2475064b7aab9c950e7a14c"],"text":"Tools are defined as executable capabilities made available to the agent under policy, and the product offers built-in coding tools plus configurable tool surfaces.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_57338955f7519da31ab6a1dcd5465cb40648e912aefd623b7fa5beed8ccc6c63","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_174279e3d3d8d00867734b3b97749d7194b34040df63f7a459ccc22f930f0563","slc_a6dca30841e78f381ad0072c4f99673edcec9329bdde8329cdca05ab42fc3d6f"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"Plugin discovery, inspection, dependency solving, and selection operate on inert serializable data and never import modules or run scripts; execution starts only after revalidation of revision, scope, authority, and approval.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5d164e60f352336836b10738691eba4c0ee9e4baa87d510a87a9a5665f00db23","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_8097e3af199b6c8195eb161bde3a3497a028c453548ba6bf3a0efccfbcc8be1f"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"The current PyPI materializer can invoke uv pip install/pip install without wheel-only or contained build service, which the document calls an explicit current security gap for untrusted plugin admission.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6f20407cb0f47be747b4458f6e55972ef3308f67b300aaa3bd564eede04c21d6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_140184852c2a9425da5a22d7968b2ef842861034904e91e0d10284c5873098de","slc_225a5b9a692af0ca1e2fc976519a04e1068fac7240e86be310650bc3c5e383de"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"The threat model assumes plugins and dependencies may be malicious or compromised, and mandates fail-closed handling of traversal, symlink escape, approval replay, stale IPC, and output floods.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7e2d1c9d73000aa14376b7b18de478a16a07b0660ca1443fbd71c2d37e4f7530","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_f6b4937233a801694afca7a932468308eb6494affa623ad518d3e76021ac08fa"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"The plugin architecture document states implementation is partial: strict codecs, ledgers, and some coding paths exist, while the public SDK, managed Skill actions, and isolated Plugin Workers remain future delivery work.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a5d20332662bed4cd17db01f11749498d0cee804c323974803fdfeaf0e9285be","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_3bde716fbc97494b572460406808a846444753b9f1f0caece21f108cfb6fdd36"],"source_ids":["src_c6614789a2475064b7aab9c950e7a14c"],"text":"The CLI exposes flags such as --help, --list-models, and --list-commands, and supports a prompt mode like `loushang -p \"...\"` for one-shot requests.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c3d4b2a534ce839726525a6c572f1d41238c45bcc6a2a19fec109f3b76197c02","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_cc69c2696c4ea51fcafea578fba000e976cbc53937f439626b2d142fe6b63f23"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"Manifests may request authority but cannot grant it, self-mark trust, choose sandbox exemptions, or widen product policy; trust is evaluated by Host-owned policy.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cb197ff0b99e1c364b2a8cf847282e21d897324035c16dd0492420229308cf7f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_6e2cf709b4ab2322f75bd3586ccfa839c533002a2500a47f3f1aa76b7321a94c","slc_a3782416b2176a6af9863ebbbb7d8e9de0c748b33445e30817621729eaf0c0a3","slc_bc555720fc96910a8248e36e3cec47a1ee82f9572e7734a7eb70fa927d41bcf7"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"Skills are typed Resource projections containing instructions, metadata, assets, and optional scripts; script existence grants no execution authority, and the catalog/Skill parser never executes scripts.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ce0c26e1443a55dcd3d480879215783cda2d0eb8cd3edf9da5c64f2c5156e9f6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_bfe3f95642bbbb2fa61453f85953a57480aa05fd03ab2cd699980206cfc6f891","slc_d82e33bc3cb6faca78604a31ae3f1135ac6ea10d6d56cd041a705ae903d2b4e2"],"source_ids":["src_c6614789a2475064b7aab9c950e7a14c"],"text":"Loushang is in active early development; the stable focus is loushang code and the loushang.ai SDK, while work/research/ppt surfaces are roadmap directions only.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.5,"id":"clm_d428b6c2a8c8ab8f42e7ca5cd2982410a2a09c712538d9823e70ecdbb1098b01","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=inference; facet=design-choices","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_ef262340d3c4a0744e10c7a2a741ac02b09338acc8b1a6e49b536a4e70d622b4"],"source_ids":["src_c6614789a2475064b7aab9c950e7a14c"],"text":"The loushang.ai SDK appears to provide provider-aware model access with a model registry, streaming, tool calls, and cost helpers, per the README feature list.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d4ea3da642146da12e478885cc91159d3e75f10232bd0e13e8eca10027f2060d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_77c20a37ae22d53b7f9a15cfb3777ee638c75cd94f19b1a6dd840b4d2e34711b","slc_d2c8c6d7d3a8618fdf39a1929570ef0e6a4b99c5182520f63bfb7653dadab85d","slc_e1ff273acdd9d96acfeae78c9b18cd46e4cb051c2f9e0676defd668e8d64af37"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"Process isolation is treated as distinct from security isolation: Policy, Approval, Sandbox, Host, and Domain are separate axes, and required containment fails closed before spawn.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
{"access":"public","created_at":"2026-09-14T03:27:30Z","created_by_operation":"op_440a939d464c4469953f2da01ff19bb2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d80b16e83656ad4a5d617dafcf0a548c425635363c621e570fb4dce15ac9c91d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"zhnt/loushang@89d885f53c1a snapshot c0aea91282c5ba83","timeframe":null},"slice_ids":["slc_3ba2d6511e059212ab1b8d188c96a3d96372fe9484bce8f054e46184f2fd11f2","slc_5163dbe5a8b9d090a6f07a04dc9139e7c95a8aa288db119d975d1e2b2f79fbcd","slc_720eafe816a73464898cc0c5ff0d0751070a07ffecdbca9bff26a8dff499d5ae"],"source_ids":["src_9d2505e27d7550328ad9a442fa3f4e45"],"text":"The architecture keeps declaration axes independent (artifact, identity, contribution, capability, execution topology, trust, lifetime, scope), so resource/capability/worker/remote are not Plugin types.","updated_at":"2026-09-14T03:27:30Z","updated_by_operation":"op_440a939d464c4469953f2da01ff19bb2"}
