{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_102203d8abce7135a0eda9395204ea40176213c405f41e2ddd949ec85a883032","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_99dad68a83ca3852a18cc02bd7c2693804e7b8e923a8f9af10d1d42199c15fbd","slc_d8b962e33c060e416a3e33a342e8d6c419351b9905daef23776e08f546f79047"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"In chat mode Claude sees the full content of all buffers listed in :buffers, and proposed code changes pop up a diff mode for review when possible.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1bed4b64f90aa730550980d6038a12ae1b89a4f7b6e93917efa00c2098c63947","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_931b619763e6fe40fda47d8fabc0c19b0395bf9e53b82f72114c17b6e407a31d"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"Because Sonnet 3.5 is not deemed capable of fully autonomous complex tasks, the design keeps the human in control: users chat, review, and can reject changes and tool execution attempts.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2d71c488f932588b7bc7560de473d884f49277e963c58828ca1d89853f9e43f8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_6f070db267a56a63ae2855c6136735edd0f43726baba21ebc8e473da7da0d70c","slc_76f599852b67406bcb75023874fc9a96f86fedeca63c0205f0375ab9c75cd551","slc_a21a2f684250c4cedb3b54d52abe4463e9f0aba3b7573ec07c7b1bddcbe9991d"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"The current version can also execute shell scripts, and the plugin can search the web when it lacks knowledge, with web access requiring elinks or felinks installed.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4923a2a6b08b23d4247ede45e8b579681767f28167a0d3466c2ad141d0f1083b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_7fcb07887d6827f05673a8ce8a6fe1a9d84f07dd72930af4e530eeb4534d091e","slc_a0c1b4b795acb0d1ee120c4f975eb1a489b3034cf709b771a5c050249c9472ab"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"The plugin offers two main interaction modes: a simple implementation assistant (ClaudeImplement) and a chat interface (ClaudeChat).","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_517af2b4125878100c8cbde83c2e48511aef95c9f18dcdb2ef122a5e167df5f0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_510210815074ba6e2d87fbf0405f69abaa49973cab767eff1f9380e776ee9a68"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"The plugin is explicitly not code completion like Copilot; it provides a chat/instruction-centric interface optimized for human collaboration, with chat history access and vimdiff review as key features.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7a7f496c7ca0f7e03673acdcd4dc8a08960f48a0ba2816147f5b25b490769ab7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_0ab9280dff41a672cb9f36ec4f091c8aa55f58bba584130d8f775d90dc6dd849"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"Chat history is sent to Claude with each request; previous interactions are folded in the buffer and users can edit or delete the history to redact it.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a132885a2e579777985788b683f9fae055de7ef82cef7db8797388673df713de","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_4ff98d5100755b12878cba6a72ce308d493195606f640b257ed6affe2b03d2b2","slc_7c7fc992483b5b675fcb09adf909d483392b6c1265d55fd0b93fc2fd7f80ad51"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"ClaudeImplement works on a visual-mode selection: the selected block is all Claude sees, with no additional context, and proposed changes are reviewed in diff mode.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a7e1944d19dafdbc9423b023d42332b8175d6210863e4cd985c584943fdb9b5c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_015e62d08791dde96bf28ce57514968ad38e6818b073a06270c85c7cc0f8856b"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"The README warns this is early alpha software expected to evolve rapidly, possibly in backwards-incompatible ways.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b3d2a3a113433b0327b82fa572039d0c4b5894c27b9ac6db331414f61fdd689d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_6a51d5ffd1f5b779450b6f0dbb3031ab79c5fe7bcd465de0a7a2afcc69ff9c1c","slc_7d7de6b0ca5cf6597d7ecb763fefc027fc574e9f614694ca325f350000f328cf","slc_fe7efb861c865e504ab12a6368e80929936d908d927c917e764378bc5e85dd45"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"The plugin uses the Anthropic Claude API by default (API key set via g:claude_api_key), with AWS Bedrock available as an alternative provider via g:claude_use_bedrock.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b5abb95f3f3e6459767f2ef32c921303392f5208cc71734431185a594b389226","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_76f599852b67406bcb75023874fc9a96f86fedeca63c0205f0375ab9c75cd551"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"Web access depends on installing elinks or felinks; Google search additionally requires a one-time manual cookie-consent step in elinks.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c69732881bc932410b70b0e14693d641e63037117e45487d31382d250f02d5e9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_279cdfe39616034ba9c4b397938e7c7d913857cf8de218c9412b2f50b439dffa","slc_63e04e105105850b1ab980501033dde51e60c8d8ab0f788c62c0f45aeffc8034"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"Every Q&A roundtrip sends full chat history and all buffer content, which can consume tokens quickly and incur real API costs; users are advised to prune history and watch billing.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
{"access":"public","created_at":"2026-09-14T02:30:00Z","created_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f8a16fedbc10325381988940ccf8620333b547224957949982543fab8ebe159c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"pasky/claude.vim@06baac1ed450 snapshot ab4d248724fbd4e3","timeframe":null},"slice_ids":["slc_81b04c6e7fbaf65a92aa0e01c909fb8661409d4664c162308540e5f90d45873b","slc_c869f2384081e92a62090462b463d23a33283f95b8dfb0b733f9961df7621393"],"source_ids":["src_868fbc5fc430505f91f505dce3fd2bf0"],"text":"The plugin can open files and execute vim commands via a Claude Tools interface, and can evaluate Python expressions only with the user's case-by-case consent.","updated_at":"2026-09-14T02:30:00Z","updated_by_operation":"op_a181c80f746e4956abc52ac98a1f51fb"}
