{"access":"public","created_at":"2026-09-14T04:18:52Z","created_by_operation":"op_07994310489043728ef7c5e18fbccbae","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5f3b5c11ac21fd3f6fb9fd5eb94b91361a6111842ccea9df18f910b5b6711447","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"ref-tools/ref-tools-mcp@83970a356277 snapshot 42028e6fd913d6f0","timeframe":null},"slice_ids":["slc_c90c67762f570ce8ccb4817be1e637dd290d8a697395def69e2284cf8ad6dde0"],"source_ids":["src_063842ea336b5246a2c6960d583dc223"],"text":"Within a session, repeated similar searches never return duplicate results, letting the agent both page deeper and adjust its prompt.","updated_at":"2026-09-14T04:18:52Z","updated_by_operation":"op_07994310489043728ef7c5e18fbccbae"}
