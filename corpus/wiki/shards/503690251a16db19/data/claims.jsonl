{"access":"public","created_at":"2026-09-14T04:18:52Z","created_by_operation":"op_07994310489043728ef7c5e18fbccbae","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_10625900b6bcd50ce341aace770a2ffee83746f000eff44217c40b045277c762","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"ref-tools/ref-tools-mcp@83970a356277 snapshot 42028e6fd913d6f0","timeframe":null},"slice_ids":["slc_343080ff1a72cb7343821fe2fc9e4dd1013dde72bc9d6471ce3ce0110eeb0368"],"source_ids":["src_063842ea336b5246a2c6960d583dc223"],"text":"When reading a documentation page, Ref uses the session's search history to drop less relevant sections and return the most relevant 5k tokens instead of pulling in 20k+ tokens.","updated_at":"2026-09-14T04:18:52Z","updated_by_operation":"op_07994310489043728ef7c5e18fbccbae"}
{"access":"public","created_at":"2026-09-14T04:18:52Z","created_by_operation":"op_07994310489043728ef7c5e18fbccbae","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_222183e44d19853f990d7750bf7056b4fd3433af45a89f83f67ab478896adfe9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"ref-tools/ref-tools-mcp@83970a356277 snapshot 42028e6fd913d6f0","timeframe":null},"slice_ids":["slc_8297dce0cc7a53d508e8fc02b67997e3623d752c46922dae6963fbad4d988827","slc_c772f846f12148a4965079df59290e0eb7d6b796ebeae626c8a1e14f70ba5a3c"],"source_ids":["src_063842ea336b5246a2c6960d583dc223"],"text":"For OpenAI deep-research clients, the same tools are provided under different names: ref_search_documentation(query) becomes search(query) and ref_read_url(url) becomes fetch(id).","updated_at":"2026-09-14T04:18:52Z","updated_by_operation":"op_07994310489043728ef7c5e18fbccbae"}
