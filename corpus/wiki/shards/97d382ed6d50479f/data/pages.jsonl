,"clm_5c836b847b7e0f4edbd516f67e78bbcaa02aea4a7251d2238130b83df29470eb","clm_5e0d041a5aa6b71618416834fe147649eb2775be6a8cabd03377f5bc14518709","clm_6284ad912d5f8d58ab3fc76e9db43e1121b25f194b38616f8471c51827bb3907","clm_7d53517883f87e7e9e6ee152531f4f1d1daabcdc0b641fc3592e3057630dafb3","clm_8408746c8d3f5d30f6274d9328670bc6678f2b5d2655b0a91a5389df213a2c69","clm_8681a067b467fd47e2bde2d6a36c3bb3bd0cb42ea0d43cb35de964aaecb31ff5","clm_8947e8289a18c308863022fa4ba22b2954b24763433d2e5e7c71e68cb1e387de","clm_8e36d303fb7c3b7f02885e59915a461e7de307cfd6239f856b89aa63e80b906a","clm_bc394e17d63d26b10dcec08cac4001456b5f19e3fcb1c1561f02e943025dd2fe","clm_c341709600308201865df64c31a5134c6de266aded16baee1cdd5b230a20ab34","clm_c773afaf2ffa741e5aa121747236680e3d16a014ecd9c10f95180112a860bc8c","clm_eb912c2843273e979dd2af371249a486799ed49a714c7ecdb915181ae3d13305"],"created_at":"2026-09-14T03:24:57Z","created_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55","id":"pg_0b693ac6dcbd54d1b02b1911f04b31d2","maturity":"draft","page_type":"entity","path":"pages/entities/yc-software-qm-1911f04b31d2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"yc-software/qm","updated_at":"2026-09-14T03:24:57Z","updated_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_8681a067b467fd47e2bde2d6a36c3bb3bd0cb42ea0d43cb35de964aaecb31ff5"],"opposing_claim_ids":[],"text":"A deployment runs three application workloads: core, web-ui (chat plus admin under /admin), and portal, which is the public entry point and hosts the optional built-in auth broker; Slack stays in core."}],"claim_ids":["clm_8681a067b467fd47e2bde2d6a36c3bb3bd0cb42ea0d43cb35de964aaecb31ff5"],"created_at":"2026-09-14T03:24:57Z","created_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55","id":"pg_0dc81d0fa9655bc1b599d97f1e801871","maturity":"draft","page_type":"source","path":"pages/sources/yc-software-qm-docs-combined-services-md-361a6c0095dc-d97f1e801871.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_55ee532709e2527a9097030284bfac39"],"title":"yc-software/qm/docs/combined-services.md @ 361a6c0095dc","updated_at":"2026-09-14T03:24:57Z","updated_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_07be4d77d6df7cdbf7e16516b36ea11732c96e02572ce632f9da338f01417380"],"opposing_claim_ids":[],"text":"The sandbox.egress contract clause is VALIDATED-ONLY: qm check emits wildcard/host warnings, but runtime enforcement of egress is explicitly absent."},{"claim_ids":["clm_0b823cb54ca3e16b3bc83d065b8a0b69569b469f57e00bb763aa81520ba0c97d"],"opposing_claim_ids":[],"text":"The deployment config root requires contract: 1, orgId, publicUrl, target, and a services list including core; target is docker, fly, or aws, and unknown contract majors fail closed."},{"claim_ids":["clm_43e6a44524b7999ec69c6d1db772b7d4218d73c0c963af9c71d73aab299ba7b2"],"opposing_claim_ids":[],"text":"Deployments depend on the @yc-software/qm package; the deployment directory's package.json pins the engine at the exact scaffolding version so the directory records which CLI interprets it."},{"claim_ids":["clm_7d53517883f87e7e9e6ee152531f4f1d1daabcdc0b641fc3592e3057630dafb3"],"opposing_claim_ids":[],"text":"Repository development practice: the normal deployment gate order is check, doctor, plan, up --yes, then check --live, with infra build-image preceding plan on AWS MicroVM sandboxes."},{"claim_ids":["clm_8e36d303fb7c3b7f02885e59915a461e7de307cfd6239f856b89aa63e80b906a"],"opposing_claim_ids":[],"text":"Published apps receive AGENT_API_URL and AGENT_CREDENTIAL_TOKEN and call $AGENT_API_URL/v1/credentials/broker with the token in x-agent-capability, authorizing as the immutable publisher rather than the viewing person."},{"claim_ids":["clm_bc394e17d63d26b10dcec08cac4001456b5f19e3fcb1c1561f02e943025dd2fe"],"opposing_claim_ids":[],"text":"The security screen proxy contract specifies HTTPS POSTs with a JSON body carrying text, hook (user_input or tool_response), and chunk metadata; providers return score and threshold in 0..1 plus an optional primary_outcome label."},{"claim_ids":["clm_c341709600308201865df64c31a5134c6de266aded16baee1cdd5b230a20ab34"],"opposing_claim_ids":[],"text":"Contract v1 defines a committed, portable deployment directory whose sole interpreter is the qm CLI, which validates the same inputs it uses to render containers, task definitions, secret routing, and the agent-computer layer."}],"claim_ids":["clm_07be4d77d6df7cdbf7e16516b36ea11732c96e02572ce632f9da338f01417380","clm_0b823cb54ca3e16b3bc83d065b8a0b69569b469f57e00bb763aa81520ba0c97d","clm_43e6a44524b7999ec69c6d1db772b7d4218d73c0c963af9c71d73aab299ba7b2","clm_7d53517883f87e7e9e6ee152531f4f1d1daabcdc0b641fc3592e3057630dafb3","clm_8e36d303fb7c3b7f02885e59915a461e7de307cfd6239f856b89aa63e80b906a","clm_bc394e17d63d26b10dcec08cac4001456b5f19e3fcb1c1561f02e943025dd2fe","clm_c341709600308201865df64c31a5134c6de266aded16baee1cdd5b230a20ab34"],"created_at":"2026-09-14T03:24:57Z","created_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55","id":"pg_0ead2e0cd83b586c9b4879dd054bde79","maturity":"draft","page_type":"source","path":"pages/sources/yc-software-qm-docs-deploy-directory-md-361a6c0095dc-79dd054bde79.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_352b0e355cbd54268718831d36e39e0e"],"title":"yc-software/qm/docs/deploy-directory.md @ 361a6c0095dc","updated_at":"2026-09-14T03:24:57Z","updated_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:24:57Z","created_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55","id":"pg_2174f4f2a952545abfe69e631fd016cb","maturity":"draft","page_type":"source","path":"pages/sources/yc-software-qm-deployment-md-361a6c0095dc-9e631fd016cb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f90acca1c14552b6a1e1dfa3748d6560"],"title":"yc-software/qm/deployment.md @ 361a6c0095dc","updated_at":"2026-09-14T03:24:57Z","updated_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_6284ad912d5f8d58ab3fc76e9db43e1121b25f194b38616f8471c51827bb3907"],"opposing_claim_ids":[],"text":"Admin model verification's small probe does not certify prices, maximum advertised context/output limits, image support, every reasoning level, or correct tool execution; admin-managed API models remain Pi-only in normal use."}],"claim_ids":["clm_6284ad912d5f8d58ab3fc76e9db43e1121b25f194b38616f8471c51827bb3907"],"created_at":"2026-09-14T03:24:57Z","created_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55","id":"pg_3529bac99e855229b05be674a2a880c6","maturity":"draft","page_type":"source","path":"pages/sources/yc-software-qm-docs-admin-model-verification-md-361a6c0095dc-e674a2a880c6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_14ea236fd30f549f8f8853f8a22682b9"],"title":"yc-software/qm/docs/admin-model-verification.md @ 361a6c0095dc","updated_at":"2026-09-14T03:24:57Z","updated_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0d76cf275a7ab00269188349f6ed6b173d09fa3946a2a3c36026c0c450792ba6"],"opposing_claim_ids":[],"text":"Without DATABASE_URL and SESSION_STORE=postgres, sessions live in process memory and vanish on restart; Postgres otherwise holds user data, session history, and durable state."},{"claim_ids":["clm_1d5847e861a37f4714dd5d00d846e7b7da4cd4e41e6f7fa42521b4556afb6dac"],"opposing_claim_ids":[],"text":"The core runs TypeScript directly on Node with Fastify for HTTP; the Slack plugin uses Bolt, and the web UI builds with Vite and renders with Lit."},{"claim_ids":["clm_29aa8bc90c4bf89f650bd770b65d2349abdf5faa8c416e6bf36e6e42e4c38eac"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are accepted as human-written text, not code — contributors describe changes informally in a .txt or .md file under adrs/, and maintainers handle implementation; vulnerabilities are reported privately."},{"claim_ids":["clm_2d3163258b3cb69d281475a7278c4258dc53f6d95f2bd230ba8cca327ec5cafe"],"opposing_claim_ids":[],"text":"Each person and each room gets its own scoped memory, files, keychain view, permissions, crons, web apps, and durable sandbox, so employees work independently while collaborating in channels and projects."},{"claim_ids":["clm_43e6a44524b7999ec69c6d1db772b7d4218d73c0c963af9c71d73aab299ba7b2"],"opposing_claim_ids":[],"text":"Deployments depend on the @yc-software/qm package; the deployment directory's package.json pins the engine at the exact scaffolding version so the directory records which CLI interprets it."},{"claim_ids":["clm_5c836b847b7e0f4edbd516f67e78bbcaa02aea4a7251d2238130b83df29470eb"],"opposing_claim_ids":[],"text":"Every turn runs through a central core that can use various models and harnesses; the agent has a small fixed tool surface, including execute, which runs commands in the scope's own durable isolated sandbox."},{"claim_ids":["clm_5e0d041a5aa6b71618416834fe147649eb2775be6a8cabd03377f5bc14518709"],"opposing_claim_ids":[],"text":"QM targets startups wanting a company-wide agent: employees get isolated workspaces, collaborate in Slack channels and projects, and the same identity and configuration carries between Slack and the web app."},{"claim_ids":["clm_8408746c8d3f5d30f6274d9328670bc6678f2b5d2655b0a91a5389df213a2c69"],"opposing_claim_ids":[],"text":"In Open sharing posture, included memories are loaded into the prompt in full with source-scope labels and are searchable, with no relevance ranking applied; the candidate window is 100 recent sessions and 200 files."},{"claim_ids":["clm_8947e8289a18c308863022fa4ba22b2954b24763433d2e5e7c71e68cb1e387de"],"opposing_claim_ids":[],"text":"A predeclared command policy with approval rules and hard denials for destructive operations like recursive deletes applies in every posture, including Dangerous."},{"claim_ids":["clm_c773afaf2ffa741e5aa121747236680e3d16a014ecd9c10f95180112a860bc8c"],"opposing_claim_ids":[],"text":"Orgs pick one security posture — Strict (human approval per tool call), Auto (default; classifier screens provenance-labelled external data), or Dangerous (no screening or pauses) — and narrower scopes can only tighten it."},{"claim_ids":["clm_eb912c2843273e979dd2af371249a486799ed49a714c7ecdb915181ae3d13305"],"opposing_claim_ids":[],"text":"The core is generic: org-specific config, tools, skills, sandbox image, and infrastructure live in a deployment directory, and every substrate (harness, session store, sandbox, memory) sits behind an interface."}],"claim_ids":["clm_0d76cf275a7ab00269188349f6ed6b173d09fa3946a2a3c36026c0c450792ba6","clm_1d5847e861a37f4714dd5d00d846e7b7da4cd4e41e6f7fa42521b4556afb6dac","clm_29aa8bc90c4bf89f650bd770b65d2349abdf5faa8c416e6bf36e6e42e4c38eac","clm_2d3163258b3cb69d281475a7278c4258dc53f6d95f2bd230ba8cca327ec5cafe","clm_43e6a44524b7999ec69c6d1db772b7d4218d73c0c963af9c71d73aab299ba7b2","clm_5c836b847b7e0f4edbd516f67e78bbcaa02aea4a7251d2238130b83df29470eb","clm_5e0d041a5aa6b71618416834fe147649eb2775be6a8cabd03377f5bc14518709","clm_8408746c8d3f5d30f6274d9328670bc6678f2b5d2655b0a91a5389df213a2c69","clm_8947e8289a18c308863022fa4ba22b2954b24763433d2e5e7c71e68cb1e387de","clm_c773afaf2ffa741e5aa121747236680e3d16a014ecd9c10f95180112a860bc8c","clm_eb912c2843273e979dd2af371249a486799ed49a714c7ecdb915181ae3d13305"],"created_at":"2026-09-14T03:24:57Z","created_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55","id":"pg_f0d0986791c05cc9969c3850cbe69f5f","maturity":"draft","page_type":"source","path":"pages/sources/yc-software-qm-readme-md-361a6c0095dc-3850cbe69f5f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_aa7699a5d8a05d50b92ea81e54e642c3"],"title":"yc-software/qm/README.md @ 361a6c0095dc","updated_at":"2026-09-14T03:24:57Z","updated_by_operation":"op_6298d4fca4ce4ad08b9ec1c6739f6e55"}
