{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_065ce5448784ce133fb7e4386ab08106312a6bc197943e0955a6156a6aefb6d2"],"opposing_claim_ids":[],"text":"A JavaScript SDK, aipexbase.js, integrates frontends with the AIPEXBASE backend, and the AI is said to automatically use it when generating code."},{"claim_ids":["clm_a475a0c49a83fcfea4a9b67170eb723f3ed9f402d96ea6717beb58b5f7591019"],"opposing_claim_ids":[],"text":"AI IDEs connect via an MCP server endpoint of the form /mcp/sse?token=<apikey>, configured in Cursor's mcpServers settings."}],"claim_ids":["clm_065ce5448784ce133fb7e4386ab08106312a6bc197943e0955a6156a6aefb6d2","clm_a475a0c49a83fcfea4a9b67170eb723f3ed9f402d96ea6717beb58b5f7591019"],"created_at":"2026-09-14T04:03:49Z","created_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc","id":"pg_a7000e87744a5ae8b6b2eaaa7411dd24","maturity":"draft","page_type":"source","path":"pages/sources/kuafuai-aipexbase-docs-integrationai-md-bf523cfa479f-eaaa7411dd24.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_04dac57c1d2c5c05af39283950e5f431"],"title":"kuafuai/aipexbase/docs/IntegrationAI.md @ bf523cfa479f","updated_at":"2026-09-14T04:03:49Z","updated_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_72d9e90bdaef7eebba65b8b86bda525a0280233a303bbe6d406751aed04323fc"],"opposing_claim_ids":[],"text":"Docker Compose deployment is the recommended install method; prerequisites are Linux, Docker, and Docker Compose v2.5+, started with docker-compose up -d."},{"claim_ids":["clm_f2e250d0fbb169ddeb3093a3b99ded31a0cf541cc04fd8cccbbea61779a93f97"],"opposing_claim_ids":[],"text":"External reverse-proxy setups are supported with nginx snippets routing /baas-api and /mcp to port 8080, with long-connection timeouts (86400s) and buffering disabled for the MCP route."}],"claim_ids":["clm_72d9e90bdaef7eebba65b8b86bda525a0280233a303bbe6d406751aed04323fc","clm_f2e250d0fbb169ddeb3093a3b99ded31a0cf541cc04fd8cccbbea61779a93f97"],"created_at":"2026-09-14T04:03:49Z","created_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc","id":"pg_e0fd6aa030bd54f79f485f28544063d3","maturity":"draft","page_type":"source","path":"pages/sources/kuafuai-aipexbase-docs-install-md-bf523cfa479f-5f28544063d3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_301b6c9ef94959088ee8f498eef6091a"],"title":"kuafuai/aipexbase/docs/INSTALL.md @ bf523cfa479f","updated_at":"2026-09-14T04:03:49Z","updated_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc"}
