{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:03:49Z","created_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc","id":"pg_255d01628ee65e5ea0b9437666a128c5","maturity":"draft","page_type":"source","path":"pages/sources/kuafuai-aipexbase-docs-roadmap-md-bf523cfa479f-437666a128c5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5cb1e0f32df25d108c34165266daa5e3"],"title":"kuafuai/aipexbase/docs/ROADMAP.md @ bf523cfa479f","updated_at":"2026-09-14T04:03:49Z","updated_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:03:49Z","created_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc","id":"pg_265f84da80105cfd8e3845f37de00f33","maturity":"draft","page_type":"source","path":"pages/sources/kuafuai-aipexbase-docs-zh-install-md-bf523cfa479f-45f37de00f33.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dc11613bd7a257f8803da72873a168ec"],"title":"kuafuai/aipexbase/docs/zh/INSTALL.md @ bf523cfa479f","updated_at":"2026-09-14T04:03:49Z","updated_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0464457376fa17c1689b1f07a13a52ae25ede9fc3af2ee218ef9bb304c27e33b"],"opposing_claim_ids":[],"text":"The core philosophy is providing a complete backend without writing backend code, so developers can skip backend implementation and integrate via SDK from any AI coding tool."},{"claim_ids":["clm_08d4e8e5e3002d8f835360b60f07d9d0573bf0bb3f8acf10aed4c9d247d57ed0"],"opposing_claim_ids":[],"text":"The stack includes a Spring Boot 2 backend and a Vue 3 management console, per README badges."},{"claim_ids":["clm_1664e5a66b28200ace3bae43f5da7db612e4c82c1ed1bdb3bc040c9b898f6126"],"opposing_claim_ids":[],"text":"Out-of-the-box capabilities include automated data storage, user authentication with permission control, third-party AI service integration, and session/state context management."},{"claim_ids":["clm_5c8599c16cc547b44005296716380af121ed10f80b75ba5d5e2e052d94bf168e"],"opposing_claim_ids":[],"text":"Source installation requires Java 1.8+, Node.js 18+, MySQL 8.0+, importing an init SQL script, editing JDBC config in application-mysql.yml, then running mvn spring-boot:run (service on port 8080)."},{"claim_ids":["clm_72d9e90bdaef7eebba65b8b86bda525a0280233a303bbe6d406751aed04323fc"],"opposing_claim_ids":[],"text":"Docker Compose deployment is the recommended install method; prerequisites are Linux, Docker, and Docker Compose v2.5+, started with docker-compose up -d."},{"claim_ids":["clm_a4d23f2e873a0fec29372099564bfc76fc0d88a4e7f7a0ec9d3e70472540b865"],"opposing_claim_ids":[],"text":"The product offers native MCP compatibility so models and agents can directly invoke backend capabilities, plus a unified context and data layer for long-term memory and traceable state."},{"claim_ids":["clm_a78831c6afffe4b9ef034c72d49c36382034a2f6c1ebfbe197d2b5bf05bd6787"],"opposing_claim_ids":[],"text":"The platform advertises native support for Chinese ecosystem platforms including Feishu, DingTalk, and WeChat, plus HarmonyOS apps, mini-programs, and WebView containers."},{"claim_ids":["clm_e3d8d8a9155a1e30c209e3253527f306685e8df36cbefd5169ce253478fdbab2"],"opposing_claim_ids":[],"text":"The project is described as backend-as-a-service infrastructure for the AI era, versioned 1.0.0 and licensed under Apache 2.0."}],"claim_ids":["clm_0464457376fa17c1689b1f07a13a52ae25ede9fc3af2ee218ef9bb304c27e33b","clm_08d4e8e5e3002d8f835360b60f07d9d0573bf0bb3f8acf10aed4c9d247d57ed0","clm_1664e5a66b28200ace3bae43f5da7db612e4c82c1ed1bdb3bc040c9b898f6126","clm_5c8599c16cc547b44005296716380af121ed10f80b75ba5d5e2e052d94bf168e","clm_72d9e90bdaef7eebba65b8b86bda525a0280233a303bbe6d406751aed04323fc","clm_a4d23f2e873a0fec29372099564bfc76fc0d88a4e7f7a0ec9d3e70472540b865","clm_a78831c6afffe4b9ef034c72d49c36382034a2f6c1ebfbe197d2b5bf05bd6787","clm_e3d8d8a9155a1e30c209e3253527f306685e8df36cbefd5169ce253478fdbab2"],"created_at":"2026-09-14T04:03:49Z","created_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc","id":"pg_6a1c6a75427d528c8817c21628c07c51","maturity":"draft","page_type":"source","path":"pages/sources/kuafuai-aipexbase-readme-md-bf523cfa479f-c21628c07c51.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_009c3351663c576ab34bfc5323c9336a"],"title":"kuafuai/aipexbase/README.md @ bf523cfa479f","updated_at":"2026-09-14T04:03:49Z","updated_by_operation":"op_468f10ce652d4968aa0c75a6d5bab4bc"}
