{"access":"public","created_at":"2026-09-14T02:32:47Z","created_by_operation":"op_b853511f6cf7437296cd9bbc56d77590","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_994851ec715d13bd3c17e01cb8f590fa504145cccfc2362879a238a9127a0f32","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"pythagora-io/gpt-pilot@9b763fdaf002 snapshot e71333c416601489","timeframe":null},"slice_ids":["slc_537a69f28bee62c9a3116abc9abc070f7da370bc552c58d6e9d30bed20346e06","slc_9ea41be72923967f0c92e6b40416878474e5860186019f11ea0861c82d5ea548","slc_b0c4a3ab2ec30690e7d5e99a65338324aba4577099d5db92dc32acb3fecd6c55"],"source_ids":["src_d8ec9606c4bf54bdb578c4e50ad21c00"],"text":"A credential-stealing supply-chain worm was hidden in core/telemetry/ from August 2025 until 11 June 2026; users who cloned and ran GPT Pilot from source in that window are told to rotate credentials.","updated_at":"2026-09-14T02:32:47Z","updated_by_operation":"op_b853511f6cf7437296cd9bbc56d77590"}
{"access":"public","created_at":"2026-09-14T02:32:47Z","created_by_operation":"op_b853511f6cf7437296cd9bbc56d77590","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a5d89c1cde16839702308dc926c5836aadccf59c9976fa17934353a8ad57849f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pythagora-io/gpt-pilot@9b763fdaf002 snapshot e71333c416601489","timeframe":null},"slice_ids":["slc_2eae82cbc6a3fabd8a296f75c695095c74f73dddad8cf4692c380fba0f2f1134","slc_330dd376282c796dabe3578df815f17a3b7cac786ca76a68eb06fb5e0a75bac4"],"source_ids":["src_d8ec9606c4bf54bdb578c4e50ad21c00"],"text":"Documented warnings state that resuming from a specific step deletes all progress after that step, and that deleting a project cannot be undone.","updated_at":"2026-09-14T02:32:47Z","updated_by_operation":"op_b853511f6cf7437296cd9bbc56d77590"}
{"access":"public","created_at":"2026-09-14T02:32:47Z","created_by_operation":"op_b853511f6cf7437296cd9bbc56d77590","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_add6e19d55c26b3f7c801e06a31a1216fd1970c21d0aee6985264a8504c42436","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"pythagora-io/gpt-pilot@9b763fdaf002 snapshot e71333c416601489","timeframe":null},"slice_ids":["slc_7a99cda1b0e2811cd932dbde3969e700f4f318e99866acb6a18c9153ecedf3fe"],"source_ids":["src_d8ec9606c4bf54bdb578c4e50ad21c00"],"text":"The malicious commit added a hidden loader (core/telemetry/_hooks.py) wired via core/telemetry/__init__.py that downloaded the Bun runtime to execute an obfuscated payload (core/telemetry/_runtime.bin) harvesting cloud/AWS keys, GitHub and npm tokens, and SSH keys.","updated_at":"2026-09-14T02:32:47Z","updated_by_operation":"op_b853511f6cf7437296cd9bbc56d77590"}
