2a4","clm_f249718646009c7d14adb692388a2cdc346e7c8cdfeeba12d77d8b438c8782fd","clm_f9e824e1e6881aefa94bbddb1ce04a569cda2114bef8cab53ec0d8db3d6f307a","clm_fbc13657badf933c0d1f1ffe782e56e956f1fa3cf44671e37a63de42798a50dd","clm_ff96f8498a135ecfaac9e344939b2beb3145cfc0d39cd5f148fd205a98001c87"],"created_at":"2026-09-14T03:54:34Z","created_by_operation":"op_f75dba6450bf4b9296f95ba1e09d4cb4","id":"pg_693bcdf429dc5f46b4674d42bd06413d","maturity":"draft","page_type":"entity","path":"pages/entities/greydgl-pentestgpt-4d42bd06413d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"greydgl/pentestgpt","updated_at":"2026-09-14T03:54:34Z","updated_by_operation":"op_f75dba6450bf4b9296f95ba1e09d4cb4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9e12ccf0fb81be7cd0b9df43431155d0ccd1e6796c3660efaa0adb87e6973eb6"],"opposing_claim_ids":[],"text":"The framework depends on the external unified-agent package, pinned to a public Git commit, with a test verifying the installed dependency is imported rather than the root copy."}],"claim_ids":["clm_9e12ccf0fb81be7cd0b9df43431155d0ccd1e6796c3660efaa0adb87e6973eb6"],"created_at":"2026-09-14T03:54:34Z","created_by_operation":"op_f75dba6450bf4b9296f95ba1e09d4cb4","id":"pg_8ba9c66ae7f859188db2ae4657720beb","maturity":"draft","page_type":"source","path":"pages/sources/greydgl-pentestgpt-pentestgpt-agent-new-migration-report-md-e8b1bb77d1-ae4657720beb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4fd0baf9c0de5ee8a704121f9091001e"],"title":"GreyDGL/PentestGPT/PENTESTGPT_AGENT_NEW_MIGRATION_REPORT.md @ e8b1bb77d1ac","updated_at":"2026-09-14T03:54:34Z","updated_by_operation":"op_f75dba6450bf4b9296f95ba1e09d4cb4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1e45a8cc7ac69781a4b62abc5b8326e4e7b652c5dea56adc27c95e63fad6eb47"],"opposing_claim_ids":[],"text":"The root Docker image does not contain pentestgpt_agent, so make docker-run deliberately fails fast with a wiring diagnostic instead of invoking an absent CLI."},{"claim_ids":["clm_8549e47c5de988b1e9384954d7333913aa037ea70f6c3f286363ba4bec1d288d"],"opposing_claim_ids":[],"text":"Both Supervisor and Executor run with provider FULL_ACCESS; the deployment environment (container or attack box) is the security boundary, with no second tool or filesystem sandbox."},{"claim_ids":["clm_f249718646009c7d14adb692388a2cdc346e7c8cdfeeba12d77d8b438c8782fd"],"opposing_claim_ids":[],"text":"The Docker image bundles Ubuntu 24.04, Python 3.12, Node 20, Claude Code and Codex CLIs, pentest tools like nmap and gobuster, and persistent auth volumes for both providers."}],"claim_ids":["clm_1e45a8cc7ac69781a4b62abc5b8326e4e7b652c5dea56adc27c95e63fad6eb47","clm_8549e47c5de988b1e9384954d7333913aa037ea70f6c3f286363ba4bec1d288d","clm_f249718646009c7d14adb692388a2cdc346e7c8cdfeeba12d77d8b438c8782fd"],"created_at":"2026-09-14T03:54:34Z","created_by_operation":"op_f75dba6450bf4b9296f95ba1e09d4cb4","id":"pg_a231b459fb6d55f2a46c076ed79f3f53","maturity":"draft","page_type":"source","path":"pages/sources/greydgl-pentestgpt-docs-docker-dev-plan-md-e8b1bb77d1ac-076ed79f3f53.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ddb11ec6714b539998f54d3a66b07868"],"title":"GreyDGL/PentestGPT/docs/docker-dev-plan.md @ e8b1bb77d1ac","updated_at":"2026-09-14T03:54:34Z","updated_by_operation":"op_f75dba6450bf4b9296f95ba1e09d4cb4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0d2eda7a7c3b92853e681d5791e6ed118954f0e87153766ba2877c9637c1cb6a"],"opposing_claim_ids":[],"text":"SQLite is the canonical memory; provider transcripts are treated as diagnostic traces rather than memory, and each episode starts fresh."},{"claim_ids":["clm_8549e47c5de988b1e9384954d7333913aa037ea70f6c3f286363ba4bec1d288d"],"opposing_claim_ids":[],"text":"Both Supervisor and Executor run with provider FULL_ACCESS; the deployment environment (container or attack box) is the security boundary, with no second tool or filesystem sandbox."},{"claim_ids":["clm_9e12ccf0fb81be7cd0b9df43431155d0ccd1e6796c3660efaa0adb87e6973eb6"],"opposing_claim_ids":[],"text":"The framework depends on the external unified-agent package, pinned to a public Git commit, with a test verifying the installed dependency is imported rather than the root copy."},{"claim_ids":["clm_aca20dfe1605ba313de64522b4f1c18ba29923a83be7fd2f022da17d00a79b60"],"opposing_claim_ids":[],"text":"The loop has exactly two LLM roles: a Supervisor that picks one task or proposes completion, and an Executor that performs one leased task and returns a typed result."},{"claim_ids":["clm_f10b5a345356f1fd2b00ab035b396933045e6f3c2800149bb4604cbe4808d2a4"],"opposing_claim_ids":[],"text":"The maintained autonomous framework pentestgpt_agent is a nested uv project, while pentestgpt_legacy is a separately maintained human-driven client with its own provider clients."},{"claim_ids":["clm_ff96f8498a135ecfaac9e344939b2beb3145cfc0d39cd5f148fd205a98001c87"],"opposing_claim_ids":[],"text":"Deterministic code owns scope validation, leases, evidence provenance, retries, revisions, and canonical state; there is intentionally no always-on judge, RAG service, or parallel scheduler."}],"claim_ids":["clm_0d2eda7a7c3b92853e681d5791e6ed118954f0e87153766ba2877c9637c1cb6a","clm_8549e47c5de988b1e9384954d7333913aa037ea70f6c3f286363ba4bec1d288d","clm_9e12ccf0fb81be7cd0b9df43431155d0ccd1e6796c3660efaa0adb87e6973eb6","clm_aca20dfe1605ba313de64522b4f1c18ba29923a83be7fd2f022da17d00a79b60","clm_f10b5a345356f1fd2b00ab035b396933045e6f3c2800149bb4604cbe4808d2a4","clm_ff96f8498a135ecfaac9e344939b2beb3145cfc0d39cd5f148fd205a98001c87"],"created_at":"2026-09-14T03:54:34Z","created_by_operation":"op_f75dba6450bf4b9296f95ba1e09d4cb4","id":"pg_d94a7c742f245c90b4a9bc7bf86d06a4","maturity":"draft","page_type":"source","path":"pages/sources/greydgl-pentestgpt-docs-architecture-md-e8b1bb77d1ac-bc7bf86d06a4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_094a0c4313ef5e1cbaeaac5fff0e5750"],"title":"GreyDGL/PentestGPT/docs/architecture.md @ e8b1bb77d1ac","updated_at":"2026-09-14T03:54:34Z","updated_by_operation":"op_f75dba6450bf4b9296f95ba1e09d4cb4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0d2eda7a7c3b92853e681d5791e6ed118954f0e87153766ba2877c9637c1cb6a"],"opposing_claim_ids":[],"text":"SQLite is the canonical memory; provider transcripts are treated as diagnostic traces rather than memory, and each episode starts fresh."},{"claim_ids":["clm_1e45a8cc7ac69781a4b62abc5b8326e4e7b652c5dea56adc27c95e63fad6eb47"],"opposing_claim_ids":[],"text":"The root Docker image does not contain pentestgpt_agent, so make docker-run deliberately fails fast with a wiring diagnostic instead of invoking an absent CLI."},{"claim_ids":["clm_8549e47c5de988b1e9384954d7333913aa037ea70f6c3f286363ba4bec1d288d"],"opposing_claim_ids":[],"text":"Both Supervisor and Executor run with provider FULL_ACCESS; the deployment environment (container or attack box) is the security boundary, with no second tool or filesystem sandbox."},{"claim_ids":["clm_f10b5a345356f1fd2b00ab035b396933045e6f3c2800149bb4604cbe4808d2a4"],"opposing_claim_ids":[],"text":"The maintained autonomous framework pentestgpt_agent is a nested uv project, while pentestgpt_legacy is a separately maintained human-driven client with its own provider clients."},{"claim_ids":["clm_f9e824e1e6881aefa94bbddb1ce04a569cda2114bef8cab53ec0d8db3d6f307a"],"opposing_claim_ids":[],"text":"Repository development practice: AGENT.md instructs coding agents to read docs/architecture.md before architecture work, not edit the root README during cleanup, and run pytest, ruff, mypy, and uv checks inside pentestgpt_agent."},{"claim_ids":["clm_ff96f8498a135ecfaac9e344939b2beb3145cfc0d39cd5f148fd205a98001c87"],"opposing_claim_ids":[],"text":"Deterministic code owns scope validation, leases, evidence provenance, retries, revisions, and canonical state; there is intentionally no always-on judge, RAG service, or parallel scheduler."}],"claim_ids":["clm_0d2eda7a7c3b92853e681d5791e6ed118954f0e87153766ba2877c9637c1cb6a","clm_1e45a8cc7ac69781a4b62abc5b8326e4e7b652c5dea56adc27c95e63fad6eb47",