,"clm_c6d255fff9cc69c930dcb5477ccfe7f9f6932c6071c2ac51f110f846cbd45925","clm_d8fa316303943e746c310a035765d7ea0737813033af4f211105c458812fdaec","clm_e85e3ed4e6a2db8394ba311936c20f589e68d905f9822b8cb3c013442ae96c83","clm_f88044cbedd83b1cd2d4aca015c09174c7b895f7313dff05bb0e8f9401dd3cc3"],"created_at":"2026-09-14T04:08:11Z","created_by_operation":"op_55b16c5a376141809153e5e0d626b3df","id":"pg_01949e64b2fa55c8a1ffecd90aae2e93","maturity":"draft","page_type":"entity","path":"pages/entities/maxkle1nz-m1nd-ecd90aae2e93.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"maxkle1nz/m1nd","updated_at":"2026-09-14T04:08:11Z","updated_by_operation":"op_55b16c5a376141809153e5e0d626b3df"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_041ae54109a30f0111f1cc3ff9b37b14ca3b6908a9285d3c9fc538c9075048a7"],"opposing_claim_ids":[],"text":"Release installation verifies signatures with cosign plus SHA-256 and size checks, refusing unverified paths rather than falling back."},{"claim_ids":["clm_10d099761f7f5460768fafb68fd9b14af0e1454c21eefc7185d900e9dfd95767"],"opposing_claim_ids":[],"text":"Each repository gets one brain with its own graph and memory bound to a repo root; a served owner on port 1337 hosts many brains and refuses unhosted repos with a typed refusal."},{"claim_ids":["clm_1cee31dc802b3e7790c8bdb275e59b7996950f3719c8f8974c81817b4bb3b61a"],"opposing_claim_ids":[],"text":"xray_gate can return blocked only from a human-ratified boundary manifest; other signals arrive as warnings with reasons, and the transplant money zone fails closed server-side."},{"claim_ids":["clm_2552fd49b8b2ccd8c8892cf40461ac07757a8fb1118270813e2d76b7d242584c"],"opposing_claim_ids":[],"text":"Mission tools (mission_start, mission_event, mission_next, mission_verify, mission_handoff, mission_close) create repo-scoped routes and budgets and reject graph-only claims."},{"claim_ids":["clm_41354846212bfe2d2c0eb3ddb7aa401a71744e658dfa67ed7af6273e4ed18856"],"opposing_claim_ids":[],"text":"north(task) is described as the front door returning one orientation packet with binding trust, memory, sufficiency, next_move, and honest_gaps."},{"claim_ids":["clm_72e784b7e8fc046e68ce2ee2ff3421d210952fb1cb5aa1adefef53154043eadd"],"opposing_claim_ids":[],"text":"The MCP surface exposes verbs including impact, seek, why, north, ghost_edges, xray_gate, antibody_scan, missing, trust_selftest, and predict."},{"claim_ids":["clm_880a355988391a86b97106740b5c21dafed99e8a07723c6bc19bfe3c1057b5b2"],"opposing_claim_ids":[],"text":"There is no uninstall command yet; hosts plan serves as the list of what to remove by hand."},{"claim_ids":["clm_ba7ae6e5e0e3580a29a9a0f55ee2d4f59b6b5e24ac5c5d207ca3aab2792c50aa"],"opposing_claim_ids":[],"text":"Transplant v1 is documented as Rust-only, top-level fn only, same-crate, requiring an existing destination file, and blind to references born inside macros."},{"claim_ids":["clm_c50ca6dafd1c03c228cdbfd6aeff4a2202c07649a4cdc341cb4e7a9653f206ed"],"opposing_claim_ids":[],"text":"Everything runs locally with no telemetry, no account, and no cloud; memory is stored as plain markdown under agent-memory/ so it survives without m1nd installed."},{"claim_ids":["clm_c6d255fff9cc69c930dcb5477ccfe7f9f6932c6071c2ac51f110f846cbd45925"],"opposing_claim_ids":[],"text":"Conclusions memorized with evidence persist across sessions and agents, are flagged stale if code changed, and confirmed results reinforce edges Hebbian-style."},{"claim_ids":["clm_d8fa316303943e746c310a035765d7ea0737813033af4f211105c458812fdaec"],"opposing_claim_ids":[],"text":"The runtime is a single Rust binary fetched as a signed release by the npm installer package @maxkle1nz/m1nd; cargo install m1nd-mcp is an alternative."},{"claim_ids":["clm_e85e3ed4e6a2db8394ba311936c20f589e68d905f9822b8cb3c013442ae96c83"],"opposing_claim_ids":[],"text":"Multiple agents on one repo register presences with TTLs; overlapping work triggers collision warnings in both agents' orientation packets before changes land."}],"claim_ids":["clm_041ae54109a30f0111f1cc3ff9b37b14ca3b6908a9285d3c9fc538c9075048a7","clm_10d099761f7f5460768fafb68fd9b14af0e1454c21eefc7185d900e9dfd95767","clm_1cee31dc802b3e7790c8bdb275e59b7996950f3719c8f8974c81817b4bb3b61a","clm_2552fd49b8b2ccd8c8892cf40461ac07757a8fb1118270813e2d76b7d242584c","clm_41354846212bfe2d2c0eb3ddb7aa401a71744e658dfa67ed7af6273e4ed18856","clm_72e784b7e8fc046e68ce2ee2ff3421d210952fb1cb5aa1adefef53154043eadd","clm_880a355988391a86b97106740b5c21dafed99e8a07723c6bc19bfe3c1057b5b2","clm_ba7ae6e5e0e3580a29a9a0f55ee2d4f59b6b5e24ac5c5d207ca3aab2792c50aa","clm_c50ca6dafd1c03c228cdbfd6aeff4a2202c07649a4cdc341cb4e7a9653f206ed","clm_c6d255fff9cc69c930dcb5477ccfe7f9f6932c6071c2ac51f110f846cbd45925","clm_d8fa316303943e746c310a035765d7ea0737813033af4f211105c458812fdaec","clm_e85e3ed4e6a2db8394ba311936c20f589e68d905f9822b8cb3c013442ae96c83"],"created_at":"2026-09-14T04:08:11Z","created_by_operation":"op_55b16c5a376141809153e5e0d626b3df","id":"pg_19602cc0a42b5d24ad3ffd29c44324ec","maturity":"draft","page_type":"source","path":"pages/sources/maxkle1nz-m1nd-readme-md-5e208d6ccdff-fd29c44324ec.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d54b7cef8feb5826b8aad0732bb01c2f"],"title":"maxkle1nz/m1nd/README.md @ 5e208d6ccdff","updated_at":"2026-09-14T04:08:11Z","updated_by_operation":"op_55b16c5a376141809153e5e0d626b3df"}
