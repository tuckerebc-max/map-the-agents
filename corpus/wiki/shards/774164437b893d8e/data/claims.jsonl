{"access":"public","created_at":"2026-09-14T02:00:56Z","created_by_operation":"op_5a5f5cce8b0c4534b78a45f54533e7e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9215fdb78259aba7db133f138b162abff61b43d56b8ac1e817e2f0840aca51b3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"esengine/deepseek-reasonix@8679e1f0b614 snapshot 1fb4383a9229e205","timeframe":null},"slice_ids":["slc_e2a94dbed652a5027eeb7094b636b4e8061990b47dd55778799f87bd41c05f0b"],"source_ids":["src_c04af4a5fae153ada087f2de349c8d33"],"text":"MCP servers contribute tools, prompts, and resources, and Extension Protocol v1 sidecars can intercept runtime events and contribute providers and structured UI.","updated_at":"2026-09-14T02:00:56Z","updated_by_operation":"op_5a5f5cce8b0c4534b78a45f54533e7e9"}
