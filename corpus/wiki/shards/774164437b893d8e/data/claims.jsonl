{"access":"public","created_at":"2026-09-14T02:00:56Z","created_by_operation":"op_5a5f5cce8b0c4534b78a45f54533e7e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_30aba16090a5c19f0648f37a29def9e3550668490d5b538de0f1c2ff6eceeebb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"esengine/deepseek-reasonix@8679e1f0b614 snapshot 1fb4383a9229e205","timeframe":null},"slice_ids":["slc_2faed9fc0b806defd7d5cf1e9c3a0df97bffcfe89402355720b2b149e1410e31","slc_9f048920e8142210f7cd19204c368a2877e71ad94a56570cbf7deb13128bdaad"],"source_ids":["src_294a47589e8a579e94ec3d5329cac65d"],"text":"ACP exposes session lifecycle methods including session/new, load, resume, prompt, cancel, list, close, and delete, each session owning an isolated controller, workspace root, model, and transcript.","updated_at":"2026-09-14T02:00:56Z","updated_by_operation":"op_5a5f5cce8b0c4534b78a45f54533e7e9"}
{"access":"public","created_at":"2026-09-14T02:00:56Z","created_by_operation":"op_5a5f5cce8b0c4534b78a45f54533e7e9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_44183ae25a0abfc887cd7e2b66eebd2e869c60d133b5a891384bd60e3b845b15","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"esengine/deepseek-reasonix@8679e1f0b614 snapshot 1fb4383a9229e205","timeframe":null},"slice_ids":["slc_7d695d25269d61ebbd15978e5d5ca5da62e9829cf68a851b94b28cc4726247e8","slc_ccd6d8eaf4409c3d693021ebc9f1baa5cff81d3ee0d12a32ebc50d69be265cd9"],"source_ids":["src_294a47589e8a579e94ec3d5329cac65d"],"text":"Permission presets are read-only, workspace-write, and danger-full-access; tool-approval changes update the gate in place without rebuilding the session controller.","updated_at":"2026-09-14T02:00:56Z","updated_by_operation":"op_5a5f5cce8b0c4534b78a45f54533e7e9"}
