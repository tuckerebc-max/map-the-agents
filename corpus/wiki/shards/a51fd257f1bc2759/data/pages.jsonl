4c93e55cb09e","clm_814b17e26d0e35ca4d7c41029c87f04f4e9f0754d75c68d61551b1ecb28d470e","clm_ac540355f2735fe65cf002c40adb78b1a4296b55c27a4b2df42bce2c6f52b610","clm_b2ebb52efb770194de9e23493e8876977bfbf858ba75e5de184bac5f92c854fd","clm_bc2992af2dd306609af118971956e4ac9ffc32f9531edee8beca8ea0b72d0ac7","clm_be401918ae212601f9cda08dc2055f173efdb60890bd1a5a5be51c93279a548a","clm_c5ae0912b8e34c7e43b1d00d5502955ab37192f70074d5ffe7c83d78183ba3cb","clm_c80f2ec2b4c6b97e415d39d84c23f1409741682ebcba03ae75f09919f7239cf1","clm_d8e73c1c1a9f59525009408ae781e7da160376e5a67f1eacb55ac5e7b637e8fb"],"created_at":"2026-09-14T02:03:14Z","created_by_operation":"op_61913d5056c64d80bd0080562e4edfcf","id":"pg_0d233a17a58955e795306459ebd34e64","maturity":"draft","page_type":"entity","path":"pages/entities/harnessrouter-harnessrouter-6459ebd34e64.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"harnessrouter/harnessrouter","updated_at":"2026-09-14T02:03:14Z","updated_by_operation":"op_61913d5056c64d80bd0080562e4edfcf"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_09d7b48b2c01a0ef2e3b11cc39a9f9512bcbab4e757179e2fc64210528c9a519"],"opposing_claim_ids":[],"text":"Repository development practice: protocol changes follow a UEP process (issue labelled 'uep' with Problem, Proposal, Compatibility, Alternatives; maintainer response within 10 working days; accepted UEPs land as one PR updating spec, schema, implementation, conformance test, and changelog)."},{"claim_ids":["clm_6818878674cdb7981e0b6b0d1dc21b436eecb27c306161c6448b4c93e55cb09e"],"opposing_claim_ids":[],"text":"Repository development practice: substantial changes require an issue describing problem, proposal, and impact before implementation; small obvious fixes may go straight to a pull request."},{"claim_ids":["clm_814b17e26d0e35ca4d7c41029c87f04f4e9f0754d75c68d61551b1ecb28d470e"],"opposing_claim_ids":[],"text":"Repository development practice: harness-support changes must be measured against five scenarios per harness and model plus a custom harness with its own skill and tool policy, judged by code-enforced rules per docs/harness-verification.md."},{"claim_ids":["clm_bc2992af2dd306609af118971956e4ac9ffc32f9531edee8beca8ea0b72d0ac7"],"opposing_claim_ids":[],"text":"Repository development practice: main accepts PRs only with one approval and all checks green, no self-approval; agent-driven PRs are opened via an 'open-pr' workflow as github-actions[bot]."},{"claim_ids":["clm_d8e73c1c1a9f59525009408ae781e7da160376e5a67f1eacb55ac5e7b637e8fb"],"opposing_claim_ids":[],"text":"Repository development practice: contributor checks include npm type-check/test/build for the console, pytest for the gateway, and building the image plus walking the self-hosted flow for container changes."}],"claim_ids":["clm_09d7b48b2c01a0ef2e3b11cc39a9f9512bcbab4e757179e2fc64210528c9a519","clm_6818878674cdb7981e0b6b0d1dc21b436eecb27c306161c6448b4c93e55cb09e","clm_814b17e26d0e35ca4d7c41029c87f04f4e9f0754d75c68d61551b1ecb28d470e","clm_bc2992af2dd306609af118971956e4ac9ffc32f9531edee8beca8ea0b72d0ac7","clm_d8e73c1c1a9f59525009408ae781e7da160376e5a67f1eacb55ac5e7b637e8fb"],"created_at":"2026-09-14T02:03:14Z","created_by_operation":"op_61913d5056c64d80bd0080562e4edfcf","id":"pg_6a113e6815565ba28061cf7f7ab278d9","maturity":"draft","page_type":"source","path":"pages/sources/harnessrouter-harnessrouter-contributing-md-5637717816b5-cf7f7ab278d9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7b489ba2180251d18998735aa7044d69"],"title":"HarnessRouter/harnessrouter/CONTRIBUTING.md @ 5637717816b5","updated_at":"2026-09-14T02:03:14Z","updated_by_operation":"op_61913d5056c64d80bd0080562e4edfcf"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0ef56bd52ff2bf8205a1a36f75be03098f132cdb4686b54255baec8170b14aec"],"opposing_claim_ids":[],"text":"The API surface supports starting tasks, continuing sessions with previous_response_id, streaming progress, file attach/retrieve, cancellation, and structured errors/traces."},{"claim_ids":["clm_1ba4e3d95ad2157d7ab1d5e9a8b16acafcc9e7575b5ecf7620b3470880328033"],"opposing_claim_ids":[],"text":"Running the Community Edition requires Docker, about 4 GB of disk, and a user-supplied provider API key; no bundled model or trial key is included."},{"claim_ids":["clm_2a264bdbc6cf7163747479e2563d2228f99b90f244d17babfdf5157d928a6687"],"opposing_claim_ids":[],"text":"One Docker container runs three parts: Console on :3000 (only published port, entry point for UI and API), Gateway on :8080 (Responses API and harness lifecycle), and Runner on :8081 (runs harnesses in session workspaces)."},{"claim_ids":["clm_46969869d5117528e88af70833f12218724ee8f9b629dc8ba5408d72b9f51c67"],"opposing_claim_ids":[],"text":"The product exposes an OpenAI Responses-compatible API; callers select a harness via metadata.harness_id and can set stream:true for server-sent events."},{"claim_ids":["clm_564a3e27b3b8e5aa588df1507c7b532302b9daf74f19c5773dd2d7036aa38347"],"opposing_claim_ids":[],"text":"The project implements the Unified Harness Protocol (UHP), a versioned public contract whose task surface is deliberately compatible with the OpenAI Responses API, with spec, schemas, and conformance suite in the repo."},{"claim_ids":["clm_59a33dbb925a14a8fbe3d177e149e105fa0e75556ea8ff4bdb6514de67cc0801"],"opposing_claim_ids":[],"text":"Community Edition disables the Console analytics pipeline, and provider keys, sessions, files, and workspaces remain under the self-hosting operator's control."},{"claim_ids":["clm_657c66e3b5e815c686d892e912afcd550d020ee23108a4b89c83e268f42d7bb5"],"opposing_claim_ids":[],"text":"Sessions use separate workspaces and operating-system users rather than separate containers; the Console and Gateway run unprivileged while the entrypoint and Runner need root to manage per-session users."},{"claim_ids":["clm_ac540355f2735fe65cf002c40adb78b1a4296b55c27a4b2df42bce2c6f52b610"],"opposing_claim_ids":[],"text":"A /data volume persists the database, files, secrets, installed harness CLIs, and workspaces across container restarts."},{"claim_ids":["clm_b2ebb52efb770194de9e23493e8876977bfbf858ba75e5de184bac5f92c854fd"],"opposing_claim_ids":[],"text":"The Runner executes harnesses inside per-session workspaces, and the first container launch installs the enabled harness CLIs."},{"claim_ids":["clm_be401918ae212601f9cda08dc2055f173efdb60890bd1a5a5be51c93279a548a"],"opposing_claim_ids":[],"text":"README benchmark figures compare eight harness-and-model configurations on the same task, reporting best-vs-worst cost (223 to 0.47 credits) and end-to-end latency (4m36s to 1m25s), with methodology linked externally."},{"claim_ids":["clm_c5ae0912b8e34c7e43b1d00d5502955ab37192f70074d5ffe7c83d78183ba3cb"],"opposing_claim_ids":[],"text":"The product handles persistent sessions: follow-up instructions can be sent with previous_response_id, and tasks with transcripts appear in the same Console workspace."},{"claim_ids":["clm_c80f2ec2b4c6b97e415d39d84c23f1409741682ebcba03ae75f09919f7239cf1"],"opposing_claim_ids":[],"text":"Agent harness CLIs are installed on first launch and remain governed by their respective upstream licenses; the edition itself is Apache 2.0."}],"claim_ids":["clm_0ef56bd52ff2bf8205a1a36f75be03098f132cdb4686b54255baec8170b14aec","clm_1ba4e3d95ad2157d7ab1d5e9a8b16acafcc9e7575b5ecf7620b3470880328033","clm_2a264bdbc6cf7163747479e2563d2228f99b90f244d17babfdf5157d928a6687","clm_46969869d5117528e88af70833f12218724ee8f9b629dc8ba5408d72b9f51c67","clm_564a3e27b3b8e5aa588df1507c7b532302b9daf74f19c5773dd2d7036aa38347","clm_59a33dbb925a14a8fbe3d177e149e105fa0e75556ea8ff4bdb6514de67cc0801","clm_657c66e3b5e815c686d892e912afcd550d020ee23108a4b89c83e268f42d7bb5","clm_ac540355f2735fe65cf002c40adb78b1a4296b55c27a4b2df42bce2c6f52b610","clm_b2ebb52efb770194de9e23493e8876977bfbf858ba75e5de184bac5f92c854fd","clm_be401918ae212601f9cda08dc2055f173efdb60890bd1a5a5be51c93279a548a","clm_c5ae0912b8e34c7e43b1d00d5502955ab37192f70074d5ffe7c83d78183ba3cb","clm_c80f2ec2b4c6b97e415d39d84c23f1409741682ebcba03ae75f09919f7239cf1"],"created_at":"2026-09-14T02:03:14Z","created_by_operation":"op_61913d5056c64d80bd0080562e4edfcf","id":"pg_d7d63e6ce88b55b696959be0c56f3da2","maturity":"draft","page_type":"source","path":"pages/sources/harnessrouter-harnessrouter-readme-md-5637717816b5-9be0c56f3da2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7f0ef24dc5485eed9310fc0f989cfc1b"],"title":"HarnessRouter/harnessrouter/README.md @ 5637717816b5","updated_at":"2026-09-14T02:03:14Z","updated_by_operation":"op_61913d5056c64d80bd0080562e4edfcf"}
