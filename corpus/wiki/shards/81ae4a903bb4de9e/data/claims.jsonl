{"access":"public","created_at":"2026-09-14T01:46:09Z","created_by_operation":"op_9825200f94ac4545b67ff4f74e320c71","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_da2338b44673550ad1b62d8095e5089bcd522cc178bc0a8b2cdb0fd18c5afe46","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"dinoanderson/qwen_cli_coder@dbf277291908 snapshot 6cb863d3cc58a3c7","timeframe":null},"slice_ids":["slc_2f1b5bdbfe5c4725bdd24654108b098e832652ff08d462cfd7f6257d552334db","slc_4f1247e4a7aae401dd77e7064f71ea316f837609e87007fda66872a26976d142","slc_bc0ca95d05d0e0b73653b65f2dd8af45446e21dda9471839ec4e2c4fc40e62bf"],"source_ids":["src_16d8c179d7fe5a08b13fb542c9f932df"],"text":"Architecture splits a user-facing CLI package (packages/cli) from a backend core package (packages/core) that handles API calls, prompt construction, and tool execution.","updated_at":"2026-09-14T01:46:09Z","updated_by_operation":"op_9825200f94ac4545b67ff4f74e320c71"}
{"access":"public","created_at":"2026-09-14T01:46:09Z","created_by_operation":"op_9825200f94ac4545b67ff4f74e320c71","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_df4e9ba854adec92754593aace44cb45803b46cbd65f141bd1f67cf2fcc4cfe8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"dinoanderson/qwen_cli_coder@dbf277291908 snapshot 6cb863d3cc58a3c7","timeframe":null},"slice_ids":["slc_3739097e6f644763174af556c36fcc76d4f43fc6312762261b0c7f9c201f197c","slc_6d3dfc091a6892caf1b93f7113c9f19a5ea16589ec77eaa9d3516e67b1176651","slc_7e9b63f69d37201d5a91ce1bed9406054ba89c69c2eaf49a69b0a3397430605f","slc_8d3a8a1d6d55eb319da692fb795114b6ddf3f813b8324748872d1f2ed3c037ce"],"source_ids":["src_a2f84ecd173455eb86fb66763d359908"],"text":"Requires Node.js 18 or higher; authentication uses a DashScope API key via DASHSCOPE_API_KEY or QWEN_API_KEY with region-specific QWEN_BASE_URL endpoints.","updated_at":"2026-09-14T01:46:09Z","updated_by_operation":"op_9825200f94ac4545b67ff4f74e320c71"}
{"access":"public","created_at":"2026-09-14T01:46:09Z","created_by_operation":"op_9825200f94ac4545b67ff4f74e320c71","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f20e44e77791b3083b5444559fb2aee65000939a8937166362bd2459da26d5e1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"dinoanderson/qwen_cli_coder@dbf277291908 snapshot 6cb863d3cc58a3c7","timeframe":null},"slice_ids":["slc_0a68d74a2d90312acd80ed31cfa010a49074046cbf1f0a9b0f4a64eb8bafc572","slc_8af319a8c3bf8f2dd2275917bdf7abf7d1e10cb9775ec194ed20de8c1755cfe9"],"source_ids":["src_a2f84ecd173455eb86fb66763d359908"],"text":"Multi-agent tools (spawn_sub_agent, delegate_task, aggregate_results) support up to 5 concurrent agents with priority-based scheduling and multiple aggregation formats.","updated_at":"2026-09-14T01:46:09Z","updated_by_operation":"op_9825200f94ac4545b67ff4f74e320c71"}
