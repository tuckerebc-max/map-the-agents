{"access":"public","created_at":"2026-09-14T01:46:09Z","created_by_operation":"op_9825200f94ac4545b67ff4f74e320c71","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2b3c2494f21bce0938a752fef934ee454339ef2f371e0e7e1ffea15ab4f81087","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"dinoanderson/qwen_cli_coder@dbf277291908 snapshot 6cb863d3cc58a3c7","timeframe":null},"slice_ids":["slc_b74b198a183307b7f244288709d46e2cfa32f934f8145506a975c6ebfba0fa98","slc_cf99ead284fdc5d6f40ed4b8eef94b5391820d1236d0587fdb4871c549431529"],"source_ids":["src_a2f84ecd173455eb86fb66763d359908"],"text":"The fork is not published to npm registries, so installation requires cloning and building from source with npm install, build, and bundle steps.","updated_at":"2026-09-14T01:46:09Z","updated_by_operation":"op_9825200f94ac4545b67ff4f74e320c71"}
{"access":"public","created_at":"2026-09-14T01:46:09Z","created_by_operation":"op_9825200f94ac4545b67ff4f74e320c71","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2e5de9ecaf5b2e1081e5fc58deca443b55b93e3f6ae545a826150b128686b37e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"dinoanderson/qwen_cli_coder@dbf277291908 snapshot 6cb863d3cc58a3c7","timeframe":null},"slice_ids":["slc_1fb68e9ec16c13d4da0f553f5279eaa06657f103990baad2a9e30500700a2dc8"],"source_ids":["src_df9eee72339a527ba13f5036cd481d8b"],"text":"MCP servers are configured via mcpServers settings; same-named tools from multiple servers are prefixed with the server alias to avoid conflicts.","updated_at":"2026-09-14T01:46:09Z","updated_by_operation":"op_9825200f94ac4545b67ff4f74e320c71"}
{"access":"public","created_at":"2026-09-14T01:46:09Z","created_by_operation":"op_9825200f94ac4545b67ff4f74e320c71","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4ae8bc2bf1ebacf4a76ea5354c118c460b99f65b67ea6ee2b91b989d19fb2016","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"dinoanderson/qwen_cli_coder@dbf277291908 snapshot 6cb863d3cc58a3c7","timeframe":null},"slice_ids":["slc_271ff535884d4a1d853a01eb60dad4fbe7b1046189804f9f75833fc0931af39d","slc_62815e1860ff91378ddc0cf6842b98f358bbe80577598ac7ea9d26ac681f1801","slc_b764df6655121d43630c2e3dfc87d13511b103ef54c7e99d4a56d109e37c21c4"],"source_ids":["src_df9eee72339a527ba13f5036cd481d8b"],"text":"Settings support coreTools and excludeTools lists to restrict which built-in tools the model can use, plus an autoAccept option to skip confirmation for safe tools.","updated_at":"2026-09-14T01:46:09Z","updated_by_operation":"op_9825200f94ac4545b67ff4f74e320c71"}
{"access":"public","created_at":"2026-09-14T01:46:09Z","created_by_operation":"op_9825200f94ac4545b67ff4f74e320c71","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4c76e9b1001fa64c9bca01293770aa7eb012d21325439fe7f8873bd98b62e68d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"dinoanderson/qwen_cli_coder@dbf277291908 snapshot 6cb863d3cc58a3c7","timeframe":null},"slice_ids":["slc_6dbb7688494c97bc3498b71cfa31d1d2c4d3090e6d8807677ee8ba83994cdd97","slc_a75fb97f00b429d41837d9c14727b0b81245b19407e3369cc137d04436fa5e65"],"source_ids":["src_df9eee72339a527ba13f5036cd481d8b"],"text":"Configuration uses ~/.qwen/settings.json (user) and .qwen/settings.json (project, overriding user), with a five-layer precedence ending in command-line arguments.","updated_at":"2026-09-14T01:46:09Z","updated_by_operation":"op_9825200f94ac4545b67ff4f74e320c71"}
{"access":"public","created_at":"2026-09-14T01:46:09Z","created_by_operation":"op_9825200f94ac4545b67ff4f74e320c71","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5b3a2e05f63d08c11182108e4872e10ebfcdae7df1395e0b3e0e421fc3f3cfa5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"dinoanderson/qwen_cli_coder@dbf277291908 snapshot 6cb863d3cc58a3c7","timeframe":null},"slice_ids":["slc_1fb68e9ec16c13d4da0f553f5279eaa06657f103990baad2a9e30500700a2dc8","slc_9a86db8ab9fca8f6267371a2897d05bbb0747720d010eb0c712073bdeab4b57c"],"source_ids":["src_df9eee72339a527ba13f5036cd481d8b"],"text":"A sandbox setting (default false) enables tool execution inside a pre-built Qwen-cli-sandbox Docker image, and MCP server configs can set a trust flag bypassing tool confirmations.","updated_at":"2026-09-14T01:46:09Z","updated_by_operation":"op_9825200f94ac4545b67ff4f74e320c71"}
