{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1bc47c994d43ff224e4c0e0b2db88fb2be7b3bc98418608bb6920fe662d92a4b"],"opposing_claim_ids":[],"text":"PreToolUse hooks gate Honeydew MCP tool calls: query, exploration, and typed create/update calls are blocked once per session when the matching skill is not loaded, with the block naming the skill to load before the retry proceeds."},{"claim_ids":["clm_2a906f7fa72b7c6c0e561a1ba549193a9d800a50f6484e37a34c037faa77bc4e"],"opposing_claim_ids":[],"text":"The hook gating is designed to be non-wedging: a block fires at most once per skill so a retry always goes through, and uncertain cases such as a missing skill or unparseable payload let the call proceed."}],"claim_ids":["clm_1bc47c994d43ff224e4c0e0b2db88fb2be7b3bc98418608bb6920fe662d92a4b","clm_2a906f7fa72b7c6c0e561a1ba549193a9d800a50f6484e37a34c037faa77bc4e"],"created_at":"2026-09-14T03:57:08Z","created_by_operation":"op_750a4a272dee49638174d507fb349cbc","id":"pg_268185d4a5c1537bbbeccfb2201ee6e6","maturity":"draft","page_type":"source","path":"pages/sources/honeydew-ai-honeydew-ai-coding-agents-plugins-changelog-md-36797d906d0-cfb2201ee6e6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4accc8e09612593dbd18f43f0c4d405c"],"title":"honeydew-ai/honeydew-ai-coding-agents-plugins/CHANGELOG.md @ 36797d906d0a","updated_at":"2026-09-14T03:57:08Z","updated_by_operation":"op_750a4a272dee49638174d507fb349cbc"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_92be926ba41044dd0a9a93026967b48c013cf07ab3be04e0a2f0c79b544c4ead"],"opposing_claim_ids":[],"text":"Repository development practice: adding a new skill requires creating SKILL.md with YAML frontmatter, updating .cursor/skills symlinks, the GitHub Copilot plugin.json skills array, the README table, and AGENTS.md, then bumping the version."},{"claim_ids":["clm_b8df81b2a76109e7eb7063c0052b95ca8c0fb7d932dc8c233d6044270f7f2365"],"opposing_claim_ids":[],"text":"Repository development practice: version bumps treat .claude-plugin/plugin.json as the source of truth, require updating ten version-bearing files, and contributors run ./scripts/validate-versions.sh locally before pushing."},{"claim_ids":["clm_dd1c51eed1e72df619f1676282df2f108f775b635f5a311ab01f9e4af6ecae64"],"opposing_claim_ids":[],"text":"Repository development practice: GitHub Actions CI on PRs validates YAML frontmatter, plugin structure and version consistency, and skill registration (Copilot skills array, .cursor/skills symlinks, README table and count)."}],"claim_ids":["clm_92be926ba41044dd0a9a93026967b48c013cf07ab3be04e0a2f0c79b544c4ead","clm_b8df81b2a76109e7eb7063c0052b95ca8c0fb7d932dc8c233d6044270f7f2365","clm_dd1c51eed1e72df619f1676282df2f108f775b635f5a311ab01f9e4af6ecae64"],"created_at":"2026-09-14T03:57:08Z","created_by_operation":"op_750a4a272dee49638174d507fb349cbc","id":"pg_7268eb06e49855b7beb19dcee7bd36bc","maturity":"draft","page_type":"source","path":"pages/sources/honeydew-ai-honeydew-ai-coding-agents-plugins-agents-md-36797d906d0a-9dcee7bd36bc.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_14c9b28b473257c7878684bc5f7cf50a"],"title":"honeydew-ai/honeydew-ai-coding-agents-plugins/AGENTS.md @ 36797d906d0a","updated_at":"2026-09-14T03:57:08Z","updated_by_operation":"op_750a4a272dee49638174d507fb349cbc"}
