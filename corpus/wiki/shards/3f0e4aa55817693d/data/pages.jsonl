{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_28d08999a45dc91800411134014c6ecc02cae2ea660ad7769bc5ba726e3cd488"],"opposing_claim_ids":[],"text":"Repository development practice: the documented build pipeline compiles CSS via PostCSS, transpiles JS via Babel, copies theme files, and outputs a distributable theme zip under dist/."},{"claim_ids":["clm_c2e57751cd7dc221d4e5e28d8dd573075ce7816badcfa382e6f0265f6f91efd5"],"opposing_claim_ids":[],"text":"Repository development practice: CLAUDE.md provides guidance to Claude Code when working with code in this repository."}],"claim_ids":["clm_28d08999a45dc91800411134014c6ecc02cae2ea660ad7769bc5ba726e3cd488","clm_c2e57751cd7dc221d4e5e28d8dd573075ce7816badcfa382e6f0265f6f91efd5"],"created_at":"2026-09-14T04:06:58Z","created_by_operation":"op_b4063eb0174b4405bdf3d95a3f6907d7","id":"pg_2f20b2072f4a53b88afb31352542d74e","maturity":"draft","page_type":"source","path":"pages/sources/luangjokaj-wordpressify-claude-md-df91d7e2d2ef-31352542d74e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_df59a50b997b517780e0047fdbf33a83"],"title":"luangjokaj/wordpressify/CLAUDE.md @ df91d7e2d2ef","updated_at":"2026-09-14T04:06:58Z","updated_by_operation":"op_b4063eb0174b4405bdf3d95a3f6907d7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_82b9a4ed64cfa801ee88f3d209bc71f59aa7881137edc48bb95caef41e70b570"],"opposing_claim_ids":[],"text":"Repository development practice: the contributor workflow uses five Docker services (MariaDB, WordPress PHP-FPM, nginx, a permissions helper, and a Node.js Gulp/BrowserSync container), with BrowserSync on port 3010 and nginx on 8080."},{"claim_ids":["clm_aa69fab023b00fe1fc16699406b6bbda68b49a6236ba3f46e804c793ea1e0e5c"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork and clone, install Docker and Node.js v16+, scaffold with npx wordpressify, then run npm start and npm run dev inside the container."}],"claim_ids":["clm_82b9a4ed64cfa801ee88f3d209bc71f59aa7881137edc48bb95caef41e70b570","clm_aa69fab023b00fe1fc16699406b6bbda68b49a6236ba3f46e804c793ea1e0e5c"],"created_at":"2026-09-14T04:06:58Z","created_by_operation":"op_b4063eb0174b4405bdf3d95a3f6907d7","id":"pg_74569337ca905217b8d69137db67bb42","maturity":"draft","page_type":"source","path":"pages/sources/luangjokaj-wordpressify-contributing-md-df91d7e2d2ef-9137db67bb42.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3acca66979505a98b2f2b73d8cf8886e"],"title":"luangjokaj/wordpressify/CONTRIBUTING.md @ df91d7e2d2ef","updated_at":"2026-09-14T04:06:58Z","updated_by_operation":"op_b4063eb0174b4405bdf3d95a3f6907d7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_c2a5430b4bbede37b88bd8631f501cf12c3f44798c53df5ec78a55c9b78aa4bf"],"opposing_claim_ids":[],"text":"The project requires Docker and is stated to be compatible with macOS, Windows, and Linux."},{"claim_ids":["clm_fdd54be33397d39f9f5f7e7793179e31f65050127901c8d8b2c177bf84871fc7"],"opposing_claim_ids":[],"text":"WordPressify is described as a tool to automate the WordPress development workflow."}],"claim_ids":["clm_c2a5430b4bbede37b88bd8631f501cf12c3f44798c53df5ec78a55c9b78aa4bf","clm_fdd54be33397d39f9f5f7e7793179e31f65050127901c8d8b2c177bf84871fc7"],"created_at":"2026-09-14T04:06:58Z","created_by_operation":"op_b4063eb0174b4405bdf3d95a3f6907d7","id":"pg_b771b1c949c159afb93a3e0aec88864b","maturity":"draft","page_type":"source","path":"pages/sources/luangjokaj-wordpressify-readme-md-df91d7e2d2ef-3e0aec88864b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6a19397fae3d57dabb38a14542fac86e"],"title":"luangjokaj/wordpressify/README.md @ df91d7e2d2ef","updated_at":"2026-09-14T04:06:58Z","updated_by_operation":"op_b4063eb0174b4405bdf3d95a3f6907d7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_398dbdeb907696681c5fe42f9a941d2b7e79942a8736bffcba7e59f6936e60b4"],"opposing_claim_ids":[],"text":"Since v0.4.0, NodeJS is no longer a global dependency; Docker is the only main dependency, enabling cross-platform runs."},{"claim_ids":["clm_54cad9df560a82e52ec55eda90207e0f3230d8b55e174cf543457812dd19a6bd"],"opposing_claim_ids":[],"text":"Export and export:backup scripts auto-stop Docker containers when the stack was not already running, and a healthcheck was added to the WordPress service to fix a chmod race condition."},{"claim_ids":["clm_81d60215c751a5fef171b8b929b7218da4077ffcbbfe379ce31173947c70359a"],"opposing_claim_ids":[],"text":"v0.4.0 replaced older npm tasks with commands such as npm run start, npm run export, npm run export:backup, npm run lintcss, and docker compose equivalents."},{"claim_ids":["clm_86a965440a8e19cc0b591a9ac34c05b6d625821e65174176018259cb68f1c3cd"],"opposing_claim_ids":[],"text":"The default theme was rewritten as a modern block-based theme using HTML markup instead of PHP templates (v0.5.0)."},{"claim_ids":["clm_9327d227a8f18ce7996c9f88a6b6adda6004d11dfe17a73662a2d3a093a5ffa0"],"opposing_claim_ids":[],"text":"The v0.6.3 installer adds an update subcommand that upgrades existing projects without overwriting theme source files."},{"claim_ids":["clm_bc69155ee6e94bd774b0d13ecdc7d014dfd111f75b6824d4c3ed6f0c05e321d5"],"opposing_claim_ids":[],"text":"v0.6.0 replaced chalk and prompts with native ANSI codes and Node's readline, cutting installer dependencies from over 100 to 18 packages."}],"claim_ids":["clm_398dbdeb907696681c5fe42f9a941d2b7e79942a8736bffcba7e59f6936e60b4","clm_54cad9df560a82e52ec55eda90207e0f3230d8b55e174cf543457812dd19a6bd","clm_81d60215c751a5fef171b8b929b7218da4077ffcbbfe379ce31173947c70359a","clm_86a965440a8e19cc0b591a9ac34c05b6d625821e65174176018259cb68f1c3cd","clm_9327d227a8f18ce7996c9f88a6b6adda6004d11dfe17a73662a2d3a093a5ffa0","clm_bc69155ee6e94bd774b0d13ecdc7d014dfd111f75b6824d4c3ed6f0c05e321d5"],"created_at":"2026-09-14T04:06:58Z","created_by_operation":"op_b4063eb0174b4405bdf3d95a3f6907d7","id":"pg_f4d0ba0d24b752baa73f91d5dbc9a8f3","maturity":"draft","page_type":"source","path":"pages/sources/luangjokaj-wordpressify-changelog-md-df91d7e2d2ef-91d5dbc9a8f3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c550ca26f60f5f42b305e06392d8e0b1"],"title":"luangjokaj/wordpressify/CHANGELOG.md @ df91d7e2d2ef","updated_at":"2026-09-14T04:06:58Z","updated_by_operation":"op_b4063eb0174b4405bdf3d95a3f6907d7"}
