82472790b8bff1b7","maturity":"draft","page_type":"entity","path":"pages/entities/rawwerks-recursive-coding-agents-2790b8bff1b7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"rawwerks/recursive-coding-agents","updated_at":"2026-09-14T04:18:23Z","updated_by_operation":"op_69ddb64322f84dfcb83839c66eca801c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5e0b569c37b01eaf2352f7477fcb236d8549bf8f1e98dfa99d6f5e8d204ec123"],"opposing_claim_ids":[],"text":"The rubric directory includes an RLM definition, a seven-gate rubric, and a judging methodology document for evidence-based system judgment."},{"claim_ids":["clm_818a0386e1685d777421725e5856dc32aae5fc72915f90643751edc4bb8a9634"],"opposing_claim_ids":[],"text":"The repository contains four main parts: a SvelteKit web deck, an rlm-rubric directory, Claude Code workflow examples, and OpenProse program examples."},{"claim_ids":["clm_8d390bb8f8460d636fcdc11861db6754deaa2fc587ce513a57953e3e087f7529"],"opposing_claim_ids":[],"text":"The repo defines Recursive Language Models (RLMs) as systems that keep context as symbolic state, inspect and slice it with code, call models or agents over slices, and aggregate results verifiably."},{"claim_ids":["clm_96d149639f2c716d58f9ad730264ea548c90312f03a5e88148c4a9873d7e3dfd"],"opposing_claim_ids":[],"text":"A one-line RLM definition states the task context moves into a persistent executable environment, the root model works through handles, and final answers return through the outer model-call interface."},{"claim_ids":["clm_a0fd590c6161d104aba847c616fe6c38c5e4f983986fb8d75de79c7c904a366a"],"opposing_claim_ids":[],"text":"Example folders are verdict-shaped: files under rlm/ are passing or intended-passing examples, while not-rlm/ holds nearby negative controls."},{"claim_ids":["clm_bd9f11e1326185da122390fd41494ec98e5fb591598035e49fcac6aad8ee44a3"],"opposing_claim_ids":[],"text":"Judging is by run shape rather than product label: a full RLM requires externalized context behind handles, model-chosen decomposition, programmatic calls over slices, and symbolic aggregation."},{"claim_ids":["clm_f63be282c293b048dd3cf6658694a13c3baffccb798897157a3630994c5563ab"],"opposing_claim_ids":[],"text":"The live presentation is a website at https://recursivecodingagents.com, described as the public deck for the AI Engineer World's Fair 2026 talk."}],"claim_ids":["clm_5e0b569c37b01eaf2352f7477fcb236d8549bf8f1e98dfa99d6f5e8d204ec123","clm_818a0386e1685d777421725e5856dc32aae5fc72915f90643751edc4bb8a9634","clm_8d390bb8f8460d636fcdc11861db6754deaa2fc587ce513a57953e3e087f7529","clm_96d149639f2c716d58f9ad730264ea548c90312f03a5e88148c4a9873d7e3dfd","clm_a0fd590c6161d104aba847c616fe6c38c5e4f983986fb8d75de79c7c904a366a","clm_bd9f11e1326185da122390fd41494ec98e5fb591598035e49fcac6aad8ee44a3","clm_f63be282c293b048dd3cf6658694a13c3baffccb798897157a3630994c5563ab"],"created_at":"2026-09-14T04:18:23Z","created_by_operation":"op_69ddb64322f84dfcb83839c66eca801c","id":"pg_b7a0be9205b35779a8a73b7dec2e01f9","maturity":"draft","page_type":"source","path":"pages/sources/rawwerks-recursive-coding-agents-readme-md-0c71127a731c-3b7dec2e01f9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_04375187f52f59899b07578409753668"],"title":"rawwerks/recursive-coding-agents/README.md @ 0c71127a731c","updated_at":"2026-09-14T04:18:23Z","updated_by_operation":"op_69ddb64322f84dfcb83839c66eca801c"}
