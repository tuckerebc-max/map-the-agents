{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0fa108caa900742341b04ccb4580e7a452cfa5660e137fc235ae9f71966f3943","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_18ade2141957a2a20efbf55a730ddcab10ea5770df02fb4072706ebf2523d39c","slc_4a5186f9111a013e714ef412a0de1965d69aa14ac233b419cfa57ab7896f0c04"],"source_ids":["src_70ef8de10b695a6283ae3d4dbd18d470"],"text":"Remote access is designed to go directly over a private Tailscale network with no Wolfpack-hosted relay or account, and the phone client is a PWA with touch-friendly controls and optional notifications.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_216c859cc158079d8c730e03a1d0d0d173946fb3509052258955304cf524b348","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_18ade2141957a2a20efbf55a730ddcab10ea5770df02fb4072706ebf2523d39c","slc_27140722c589502f68f1ab69ab8929a14703400140844c3707c041996656b99e"],"source_ids":["src_70ef8de10b695a6283ae3d4dbd18d470"],"text":"The product supports built-in coding-agent providers Claude Code, Codex, Gemini CLI, Cursor, and Pi, with shell as an always-available fallback and custom PATH commands configurable in Settings → Agents.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_509700169736615b2f314d3025837f8e38210ea583917ad88ff8b5c9ef068414","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_ffa0e82d10a68aae9cc093be5fb918bac63b33f1d1bbd36438d06a5175f8587b"],"source_ids":["src_70ef8de10b695a6283ae3d4dbd18d470"],"text":"The tool grants browser users shell-level control over configured projects; session control follows the global API auth policy and has no inter-session authorization layer, so it should be kept on a trusted Tailnet with ACLs or JWT.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6933f3720f210b8a6857ae4e11e2a83bc70dc19497de91927f86a7a6fa7baf10","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_018f268c6964fb2bd7c9602b22d78b1f72c47943e4b9b5d2a44ca10aa0999b66","slc_4a5186f9111a013e714ef412a0de1965d69aa14ac233b419cfa57ab7896f0c04"],"source_ids":["src_70ef8de10b695a6283ae3d4dbd18d470"],"text":"Wolfpack is a self-hosted control room for running coding agents remotely, letting users monitor and control persistent agent terminals from a desktop or phone.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_761d356669adf9a507d1eda599c92ff49f7ce5bb34c1565d329bebda5a05963b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_505d8e6a3ac857add2173868624542bef9437a98812fc4620726ce577f9e9d7d","slc_abcb909df3d1a90a884162524da29dd570371e09e1732dbf2a46a65c07c2fc0a","slc_b53740a41fe1dac9fe6d702d75a441b2070bad247f569080263686224d2cce8a"],"source_ids":["src_70ef8de10b695a6283ae3d4dbd18d470"],"text":"A CLI exposes JSON session control, e.g. wolfpack --machine <peer> list --json, session status, session create with --harness and --plan, and agent spawn with --notify-parent.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_902ef62c1703f863b0a8dddd1b789fdbd0162d71bd4ce77e3588973f70f59b4b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_8f7daf0162d39cbdccf5a2146d69802bafc0a5a15269e39bee59a9ab5d7d29e0"],"source_ids":["src_70ef8de10b695a6283ae3d4dbd18d470"],"text":"Sessions run in a Rust PTY broker separate from the web server, so closing the browser or restarting only the web server does not end sessions; a broker restart or login-service reinstall can terminate them.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ab7a08ce2dce81b49d82b4737793755b3a55f6a6f232f4e74ac83685c3058514","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_c21fd1f6e7876bf5ce30e902d0c6befec09af32be8dcfafb12b24a44cef4987d"],"source_ids":["src_1c15434b9c51557dab591f21f6daa54c"],"text":"Repository development practice: contributors need Bun (v1.4.2+ pinned in CI) and a Rust toolchain, plus a pinned Zig toolchain and Ghostty VT build only for source builds of the broker; release-install users need neither Zig nor Ghostty.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c10bb93fe6e4ecbcb1249b68d42a7377fd448532265faea577d25dc073a84aff","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_289ec8d3d57c880f29f255636e6e865e8e3f2d400f8455e8ffb844e24e582693","slc_4a5186f9111a013e714ef412a0de1965d69aa14ac233b419cfa57ab7896f0c04"],"source_ids":["src_70ef8de10b695a6283ae3d4dbd18d470"],"text":"Remote access depends on a Tailscale network; machine targeting uses configured tailscaleHostname suffixes, and the CLI sends JWT authorization on a bounded GET /api/machine handshake, failing closed on invalid or unreachable targets.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e23b9376c60c35e5917ae0b6e257860391cac79f320c98fc7b3e350e12c6fe8e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_5b69ffd7f4020ba4257d3ca64f45333f2e5f29d20d67843afa0642d5fafedb54","slc_76a279f5f8bbdeed11375834e5fbebe78dd6a18497f5463151badb63e8f74d05","slc_a2665e08f7b3be8e30a594e8be96eb12d778866e9be3d3c1b4a40b7e7a597e7a","slc_cc993a9673ae67fbc4663c3f4e7c69a40f8fe800d019718618ecbd04e98dcfc6"],"source_ids":["src_1c15434b9c51557dab591f21f6daa54c"],"text":"Repository development practice: tests run via bun test (unit/integration/snapshot under tests/), Playwright for e2e, and cargo test for the Rust broker; PRs must branch off main, pass bun test, and stay focused.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ed0c78d742e2cb47f9906201e0935ca093c7c812fdf5ebce513bc1e413bcd6af","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_c87e72654636a0b4389749cbe62fc83abf910f470b20ed25aceed029201256c7"],"source_ids":["src_70ef8de10b695a6283ae3d4dbd18d470"],"text":"Wolfpack ships agent skills: wolfpack-tailnet-control for session control across Agent Skills-compatible harnesses, and wolfpack-pi-task-delegation teaching Pi durable task routing via agent_task_* commands.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
