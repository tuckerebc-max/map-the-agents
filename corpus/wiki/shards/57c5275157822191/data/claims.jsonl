{"access":"public","created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fdf737ac4f634f099d284d68a77bb026bc35d6e5f714d1f7ce7e886bfe79bbf7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"almogdepaz/wolfpack@0c7ee60e7163 snapshot 1ef435f5947eaa2c","timeframe":null},"slice_ids":["slc_8f7daf0162d39cbdccf5a2146d69802bafc0a5a15269e39bee59a9ab5d7d29e0"],"source_ids":["src_70ef8de10b695a6283ae3d4dbd18d470"],"text":"Session persistence has boundaries: a broker restart or login-service reinstallation can terminate sessions, per the README's lifecycle description.","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
