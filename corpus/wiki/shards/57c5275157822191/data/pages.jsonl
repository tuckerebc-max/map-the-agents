{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_ab7a08ce2dce81b49d82b4737793755b3a55f6a6f232f4e74ac83685c3058514"],"opposing_claim_ids":[],"text":"Repository development practice: contributors need Bun (v1.4.2+ pinned in CI) and a Rust toolchain, plus a pinned Zig toolchain and Ghostty VT build only for source builds of the broker; release-install users need neither Zig nor Ghostty."},{"claim_ids":["clm_e23b9376c60c35e5917ae0b6e257860391cac79f320c98fc7b3e350e12c6fe8e"],"opposing_claim_ids":[],"text":"Repository development practice: tests run via bun test (unit/integration/snapshot under tests/), Playwright for e2e, and cargo test for the Rust broker; PRs must branch off main, pass bun test, and stay focused."},{"claim_ids":["clm_ed3869a6e44fde4fddcaa6526ccddb963a3d73868141f9c4d5ccfda3a57348c6"],"opposing_claim_ids":[],"text":"Repository development practice: frontend assets in public/ are embedded into the binary via scripts/gen-assets.ts, and src/public-assets.ts must not be edited manually."}],"claim_ids":["clm_ab7a08ce2dce81b49d82b4737793755b3a55f6a6f232f4e74ac83685c3058514","clm_e23b9376c60c35e5917ae0b6e257860391cac79f320c98fc7b3e350e12c6fe8e","clm_ed3869a6e44fde4fddcaa6526ccddb963a3d73868141f9c4d5ccfda3a57348c6"],"created_at":"2026-09-14T01:32:37Z","created_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac","id":"pg_e86c2398f53f589ca9dde596efb18865","maturity":"draft","page_type":"source","path":"pages/sources/almogdepaz-wolfpack-contributing-md-0c7ee60e7163-e596efb18865.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1c15434b9c51557dab591f21f6daa54c"],"title":"almogdepaz/wolfpack/CONTRIBUTING.md @ 0c7ee60e7163","updated_at":"2026-09-14T01:32:37Z","updated_by_operation":"op_b5ee997775584d76b9a6b80ba6f1c1ac"}
