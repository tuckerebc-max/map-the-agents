{"access":"public","created_at":"2026-09-14T04:31:39Z","created_by_operation":"op_e7231624ba1f4c6fa1b7d180bc3cd167","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c614187fabbc61e893fa280980afd917e6d3a1ee9a3dbc42e0762f77a27e7378","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"wienerdog-ai/wienerdog@91668da62822 snapshot 10c545f38401b46b","timeframe":null},"slice_ids":["slc_6223f4806cc7a76e63cac07538a226e8690440ecab80328c183956defdb65fda","slc_672bc16866eca24564283355999f51dc339dbb9976843dc00a7f3c644977e2d9"],"source_ids":["src_006c0cd9cbd35cd98e0ab4656a4191f3"],"text":"The memory vault defaults to ~/wienerdog/ with PARA-style folders (00-Inbox through 07-Daily, reports, .git); machine state such as watermarks, queue, and score cache lives in ~/.wienerdog/state/, never in the vault.","updated_at":"2026-09-14T04:31:39Z","updated_by_operation":"op_e7231624ba1f4c6fa1b7d180bc3cd167"}
{"access":"public","created_at":"2026-09-14T04:31:39Z","created_by_operation":"op_e7231624ba1f4c6fa1b7d180bc3cd167","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_feed64bc9c0751c31cc18715057ab3dda50d967c176a0cf4e0f4aa767835c7b9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"wienerdog-ai/wienerdog@91668da62822 snapshot 10c545f38401b46b","timeframe":null},"slice_ids":["slc_7d792ba1395fcdd4773ed03f791c173a90a4a6b8b40881e309fd9da3c1044b32"],"source_ids":["src_006c0cd9cbd35cd98e0ab4656a4191f3"],"text":"The architecture describes the product as a compiler plus prompts, not an application: a thin CLI, short-lived hook scripts, and scheduled jobs whose brain is claude -p or codex exec, targeting under ~4k LOC of plain Node 18+ with no build step.","updated_at":"2026-09-14T04:31:39Z","updated_by_operation":"op_e7231624ba1f4c6fa1b7d180bc3cd167"}
