0a32324ccad3ed","maturity":"draft","page_type":"entity","path":"pages/entities/herry2059-project-os-for-codex-32324ccad3ed.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"herry2059/project-os-for-codex","updated_at":"2026-09-14T02:03:21Z","updated_by_operation":"op_c2f7300587ae444b8ff3b0c1c38b5b5f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_d5ee7eba328c2168569c7a435e4c6b2e8c81109864dc019699b222a873cbe029"],"opposing_claim_ids":[],"text":"High-risk actions such as payment, deletion, role changes, publication, deployment, and rollback stay outside the MCP surface and require explicit human confirmation."},{"claim_ids":["clm_db3b24e29683f5708b493e5bd57d102e200e4fcd1e758d41836aec85ccd24a52"],"opposing_claim_ids":[],"text":"Repository development practice: AGENTS.md instructs contributors to work one vertical slice at a time, use pnpm, run pnpm run check before committing, and inspect affected UI in light and dark themes."},{"claim_ids":["clm_f00787d89e66c27b7e7dea63559e294e777c2d02b11d20e25efa9eb4ace123e9"],"opposing_claim_ids":[],"text":"Repository development practice: the Codex session protocol requires calling project_os_get_context before planning, running pnpm codex:doctor on failure, and only appending progress after verifying one vertical slice."}],"claim_ids":["clm_d5ee7eba328c2168569c7a435e4c6b2e8c81109864dc019699b222a873cbe029","clm_db3b24e29683f5708b493e5bd57d102e200e4fcd1e758d41836aec85ccd24a52","clm_f00787d89e66c27b7e7dea63559e294e777c2d02b11d20e25efa9eb4ace123e9"],"created_at":"2026-09-14T02:03:21Z","created_by_operation":"op_c2f7300587ae444b8ff3b0c1c38b5b5f","id":"pg_a7116820e96c5b2196f50eecfff35674","maturity":"draft","page_type":"source","path":"pages/sources/herry2059-project-os-for-codex-agents-md-3cb909ab9f61-0eecfff35674.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_51b598ac71105681abcb22f8eb78d374"],"title":"herry2059/project-os-for-codex/AGENTS.md @ 3cb909ab9f61","updated_at":"2026-09-14T02:03:21Z","updated_by_operation":"op_c2f7300587ae444b8ff3b0c1c38b5b5f"}
