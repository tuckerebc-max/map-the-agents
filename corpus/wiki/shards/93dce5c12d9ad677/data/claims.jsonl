{"access":"public","created_at":"2026-09-14T01:30:55Z","created_by_operation":"op_f90d6e44959d46e085cbff70119051a9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0f7c27ceaa1217161883da3f892d00d77c6e866af7962d31ebab250d484909cc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"aizenvoltprime/damocles@b8787a5e9b69 snapshot 87e325b5b99a6e04","timeframe":null},"slice_ids":["slc_7aa0cdee194d687578170e36e0b710baf6e992be5a764978abeafd606bf37450","slc_c5c584e9067f0693f22da3094a47a8215431a1491c78f67e8612745bcedb7896"],"source_ids":["src_6f3f4ffccf0b5c7e9050cce7ca22f6e7"],"text":"The README warns that the Claude 'allowance' authentication mode, which routes OAuth through a third-party plugin impersonating the official Claude Code CLI to draw on included subscription quota, very likely violates Anthropic's Terms of Service.","updated_at":"2026-09-14T01:30:55Z","updated_by_operation":"op_f90d6e44959d46e085cbff70119051a9"}
