{"access":"public","created_at":"2026-09-14T01:37:57Z","created_by_operation":"op_732e7f6aef6a48409dc0ea7f6a61b183","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_299bcb4871abf4771455bd883ffbd2fc56e4118d300e1ca82c97dabb44a175dc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"blushyes/coro-code@679c57af5376 snapshot d60a9546779f7cea","timeframe":null},"slice_ids":["slc_16b82c7e1cb210f8b7c82564f97d725f3d08e4d6c16fc3e17f58d6c1e3b5ef2c","slc_45995cc5667398aab25486364a5e7f05a7c2c823b577c9eeeed55089b6fca4f2","slc_a0693081b533cd92a843dfaaa4f842427f8cec91a72f3ab828bf3c6fe891bc3f","slc_ac12c3d4086a2c0658f2cef8af7714b8c3fc3c8c1663987eb01201e9d00779d5"],"source_ids":["src_87dc71e2c99d5f76b6f90c47974a473b"],"text":"Repository development practice: contributors are strongly recommended to install pre-commit hooks via platform-specific scripts; the hooks run cargo fmt --check, cargo clippy, and cargo test before each commit, and the contribution flow is fork, branch, change, test, PR.","updated_at":"2026-09-14T01:37:57Z","updated_by_operation":"op_732e7f6aef6a48409dc0ea7f6a61b183"}
