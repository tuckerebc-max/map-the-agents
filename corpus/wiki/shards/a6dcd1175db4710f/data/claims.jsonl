{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_14571f2290ebc55febcdc46a4bb40def3470ac79f66868295bcfdf15fabd0cea","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_5fd2b3097ee41f9eb8fc160c97540b7346ca0a3cca5b2c5636be1db248dddb7d","slc_79b348e4d0d094d1f32396513b1691e5b944584eaee5c2e3b10e59abde6ed065","slc_9a0792143de11ea68d52dc6ad03e0a80a0665299ac92dd45babe32e629fa6408"],"source_ids":["src_acb354116db656d79018bb0a218f23d6","src_e51629529cdc5475a1629192aeef18ed"],"text":"Repository development practice: every pull request must include before/after evidence under the PR template's '### Before' and '### After' headings, enforced by an automated 'PR evidence' check; PRs failing it do not merge, with only a maintainer-applied no-visual-change label as exemption.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_48f3414a230ea43a10887f6e6861efe1e4ff8fdc5440503271c72e6c675b624e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_4c654abb4d044b742e65a8b558d5f060addfafb7a1c2dbe7bc1e423ed8085117","slc_56d8108f38c2c40c02ef0bdcf39e71566db22c44234a80e1104d50fd47b7d26d","slc_cbd82dd5373722770ef39989252643868d872947d1c5b41491054088fa9d1fb1"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"Supported agent CLIs include Claude Code, Codex, Grok, Kimi, Gemini CLI, Antigravity, Qwen, OpenCode, Crush, pi.dev, Copilot CLI, and Cursor, plus custom commands and local models via Ollama, LM Studio, or vLLM.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_65cf00780d4f07718226eae1a26da217219985d373045518e0de39091763f1bf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_104db1e21f515a662a6a730bb2e0e18def16eb8bc0fcc6a070a67dac61597be3","slc_424d549fcd93e009ae418d244b5fc857e4b2e21c1983a717f1c17eabc5fd9173","slc_83427b22fd8aaf4cadb6494a801d7e45e366b14ce52615aefc6c77462f91ea28"],"source_ids":["src_acb354116db656d79018bb0a218f23d6","src_e51629529cdc5475a1629192aeef18ed"],"text":"Repository development practice: contributors run npm install && npm run dev, keep npm run typecheck green, run npm run test:focused, confirm npm run build works, derive new UI from DESIGN.md tokens, and keep changes scoped to one improvement per PR.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_68821c5d4852b33fa4210e587093a776a5c9101453878e18dd635fc0b9b51fe2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_a8d79b66a248e900abc8b1a48fcb87d67b55d40bc796a78a7f8e1373d7d528f2"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"Running from source requires Node.js 18+, npm, a C/C++ toolchain for node-pty's native addon, and at least one supported agent CLI on PATH; missing CLIs can self-heal via an in-terminal installer.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_94e66f6e6fbbcc586ddf284bd30d34f4d63364bfb126e87fff2ad7c1969488bb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_104d145b1c052f0de5612bbcc7a7cc0f4c869a0a86bb7436230d5e002be54510","slc_a6509e860c0d826e86f57c878515d10c0c8470704315bfefc8e47c9ab4901576"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"A GOD agent acts as orchestrator: it reads requests, resolves routine ones autonomously, routes messages between agent inboxes, and escalates critical items (spend, destructive ops, scope changes) to a human approvals queue.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_acb94360ef1f441b69bdbf73cde7c4ebbf6115edd3baa81bf45f616540ba7c18","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_d6c307539a2d79269d4edd07c9261fe80518b39c9591c5af05fd0dec10616c97"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"The UI includes a Command Center with kanban tasks, scheduled missions, live fleet monitoring, memory search, a Skills catalog of 227 installable skills, and a built-in Monaco IDE with git rails; all fs/git access is brokered through main.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c006d9232cba52d1aab4fd8e674d1604ad01321cb285cdcd3dc55e167d210632","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_a6509e860c0d826e86f57c878515d10c0c8470704315bfefc8e47c9ab4901576"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"The hive is a local git repo of plain files: agents write to their own outbox, a router delivers to recipients' inboxes, and only the harness touches git (single-committer design to avoid index.lock corruption).","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d0ff5ac873f6207e95b546debce6147a2628a3f10d622477772e2d4c2f22ce7f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_3b4df65b5edc76785bd68e6375095d7bb4ac213e1352aef07cc7aa6c980e8eb8","slc_dc29586ff66200ceab3649806b1691cd89d007bc3a1bc664338e9c6c3992a6dd"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"Per-agent autonomy settings control how far agents act alone; spend, scope, and destructive operations escalate to the user, and a circuit breaker steers, constrains, then stops looping or runaway agents.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d1d0bd3ef3c5bea3aa82d4ec6a60e604b755d58608782991a4227bf843176e33","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_e177968ebbaad5295a685283b46e85acb140e7545431edaa0a53e9acb4234fc1"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"The architecture has two data planes — a terminal plane owning PTYs, filesystem and git, and an event plane running the hive, hook server, and router — with the renderer accessing both only through a typed bridge.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d4f2c143576f72c17b29e346fd4affe3de9c10d38f31e299eb333f8a0697fd79","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_104d145b1c052f0de5612bbcc7a7cc0f4c869a0a86bb7436230d5e002be54510","slc_a8d79b66a248e900abc8b1a48fcb87d67b55d40bc796a78a7f8e1373d7d528f2","slc_dd2b39e93ea0d0378169050346f6744b3be39b57c303c1ccfe6663a0f760d75c"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"Each agent keeps markdown memory mined into a shared searchable memory palace with a semantic recall index, persisting across sessions; the semantic index is optional and markdown memory works without it.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e7384455ef5657337aee8f18de3759367f7cdbe54b5f004d55836bbb51d187c4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_25ff90e0d6492ef5f68c8b2a3f6029facc3bab6490ba68e651db82fe33db33af"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"The product is a desktop app that wraps real terminal-agent CLIs as agents, wires them into a hive mind, and puts a clone agent (Michael) in charge of coordination.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
{"access":"public","created_at":"2026-09-14T02:00:05Z","created_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fed551d34d91f84d971dd2a7474833e2a48bc6a5fa7203a9e8cd9a5daed43c3e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"chaitanyagiri/munder-difflin@417d8decf08c snapshot ba331b94f28a7410","timeframe":null},"slice_ids":["slc_104d145b1c052f0de5612bbcc7a7cc0f4c869a0a86bb7436230d5e002be54510","slc_5e4ddeec59579dec5f0764e4f6f38a49a604f4310d522a79ecccda761159f554"],"source_ids":["src_acb354116db656d79018bb0a218f23d6"],"text":"The app is built with Electron, React, TypeScript, Pixi.js, xterm.js, and node-pty; each agent session runs as a real process in a pseudo-terminal rendered with xterm.js.","updated_at":"2026-09-14T02:00:05Z","updated_by_operation":"op_9f7260b1e8e047e2987f573dab8cf630"}
