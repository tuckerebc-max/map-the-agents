{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3b4e5e1b8a5d9e15f7fea2161dc93a640f16df865886cf8a28b0efb0f5ea6745"],"opposing_claim_ids":[],"text":"openspec init --tools <ids> generates per-tool skill and command files for the selected AI assistants, and the README claims support for 30+ tools."},{"claim_ids":["clm_ac33c0f7ea1d148c315cbb9d2e9331a0a435acbf08e632d7cc9d657f2255fb0e"],"opposing_claim_ids":[],"text":"Repository development practice: install.md is an agent-facing setup prompt directing the installing agent to verify Node, install the CLI globally with user confirmation, run openspec init --tools, and report what init actually created."},{"claim_ids":["clm_d2da4b46c34912e686ae17ecf9bb610008b2ce226f9a8cc2d0929ac48159753d"],"opposing_claim_ids":[],"text":"OpenSpec is driven from AI coding tools via slash commands such as /opsx:explore, /opsx:propose, /opsx:apply, and /opsx:archive, with tool-specific spellings like /opsx-propose (Cursor, Copilot), @opsx-propose (Amazon Q), or $openspec-propose (Codex)."},{"claim_ids":["clm_fd0e3f2c1c9b0799904a331c0536f8db65804b63d3d453b723a73a994be40f3d"],"opposing_claim_ids":[],"text":"OpenSpec requires Node.js 20.19.0 or higher, and the install prompt instructs checking node --version before installing."},{"claim_ids":["clm_fdc4018060eb05485d101a2401b5a598f4f45a67d9b30d460d4e00466788ae4f"],"opposing_claim_ids":[],"text":"The product ships a CLI installed globally via npm, pnpm, yarn, or bun (with a Nix option), with commands including openspec init, openspec update, and openspec config profile."}],"claim_ids":["clm_3b4e5e1b8a5d9e15f7fea2161dc93a640f16df865886cf8a28b0efb0f5ea6745","clm_ac33c0f7ea1d148c315cbb9d2e9331a0a435acbf08e632d7cc9d657f2255fb0e","clm_d2da4b46c34912e686ae17ecf9bb610008b2ce226f9a8cc2d0929ac48159753d","clm_fd0e3f2c1c9b0799904a331c0536f8db65804b63d3d453b723a73a994be40f3d","clm_fdc4018060eb05485d101a2401b5a598f4f45a67d9b30d460d4e00466788ae4f"],"created_at":"2026-09-14T03:51:47Z","created_by_operation":"op_b1c93e384bab4e93959e05f5b79cc044","id":"pg_04b8f80b6dcc53d7ae578c951801b3d5","maturity":"draft","page_type":"source","path":"pages/sources/fission-ai-openspec-install-md-9d4e5974e5c0-8c951801b3d5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_787b91bb9f8252e08622199f5d764a33"],"title":"Fission-AI/OpenSpec/install.md @ 9d4e5974e5c0","updated_at":"2026-09-14T03:51:47Z","updated_by_operation":"op_b1c93e384bab4e93959e05f5b79cc044"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_8735d28797c6fc9a93d8bf276f856768ee7b83c870fb0ab1176d9bd966733b34"],"opposing_claim_ids":[],"text":"An internal plan document records that archiving applies requirement-level replacements, so two changes touching the same requirement can silently drop scenarios with no warning or conflict indicator."},{"claim_ids":["clm_d54684e2f16387899f5f58a71ac766974e66698473e975b1f682f76169e47d39"],"opposing_claim_ids":[],"text":"The same plan notes changes do not persist the requirement content they were authored against, so the archive step cannot detect divergence between the author's base and the live spec."}],"claim_ids":["clm_8735d28797c6fc9a93d8bf276f856768ee7b83c870fb0ab1176d9bd966733b34","clm_d54684e2f16387899f5f58a71ac766974e66698473e975b1f682f76169e47d39"],"created_at":"2026-09-14T03:51:47Z","created_by_operation":"op_b1c93e384bab4e93959e05f5b79cc044","id":"pg_46cbd0af086052e2a3162b4335abd20b","maturity":"draft","page_type":"source","path":"pages/sources/fission-ai-openspec-openspec-parallel-merge-plan-md-9d4e5974e5c0-2b4335abd20b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0bc2e0f8b4695c50a69b95d2103a487b"],"title":"Fission-AI/OpenSpec/openspec-parallel-merge-plan.md @ 9d4e5974e5c0","updated_at":"2026-09-14T03:51:47Z","updated_by_operation":"op_b1c93e384bab4e93959e05f5b79cc044"}
