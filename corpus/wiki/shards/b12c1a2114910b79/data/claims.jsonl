{"access":"public","created_at":"2026-09-14T01:59:39Z","created_by_operation":"op_35c1086f7984478f9d3976eac4294ddf","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b95e15240a16ea0435d682f5db24433bfad078e95fafadb3ead3e660a1940b78","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"atomgit-atomcode/atomcode@287bff70f940 snapshot 21b0b17abcf968f4","timeframe":null},"slice_ids":["slc_0dc1b6a298a13cd31873f5ecf247eb48895742f0e1a3fd8c3cab155451444917","slc_622d63e7ae58e634315b73c23fea20e939e115f1a4ebdc2ac89d314c108ed3f4","slc_a63779275328d248575e998e2eaf230b4f0a8c1b9bce7cee72bc7d8df56a1094","slc_e2d2c1e472ad5e402a85a810fa84a69b1afd1f00c3281f22f5dd8f1ea80a4cc9","slc_e47dd3902eae2ff0b2970f552912118811a3a703671c09247a629705b635dbb6"],"source_ids":["src_3fe97386ba0f5755ac042e1a14e827ec"],"text":"Stated design principles include tech-stack agnosticism via descriptor-file detection (package.json, Cargo.toml, etc.), a single CodingRuntime owner, tool safety, token-budget-aware context windowing, and directed dependencies keeping the kernel neutral.","updated_at":"2026-09-14T01:59:39Z","updated_by_operation":"op_35c1086f7984478f9d3976eac4294ddf"}
