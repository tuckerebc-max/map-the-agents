{"access":"public","created_at":"2026-09-14T02:43:45Z","created_by_operation":"op_58a2e388e59f4b24b91893d885751332","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d2749f1e3e19ac4df142a4651e444d318f2bb4f3e27339876e84b5c61ed59442","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"stippi/code-assistant@ba818a46c472 snapshot 114d3c2ae22361f3","timeframe":null},"slice_ids":["slc_8fb16c261d8cd3bafad90c715fc0ac1b3a8854937c933867eb042fcc795141c6","slc_f6b06e6a5298fb49488ede73104aabdcbfeff344dc857eeef4be5cd36d4005a9"],"source_ids":["src_af48ddd846c15f26bb9af44635475d94","src_b3efe320bae2544289f1a323ed424221"],"text":"Format-on-save runs project formatters after the assistant modifies matching files and updates tool parameters to reflect formatted content, keeping the model's view in sync without re-reading files; mappings pair glob patterns with shell commands.","updated_at":"2026-09-14T02:43:45Z","updated_by_operation":"op_58a2e388e59f4b24b91893d885751332"}
