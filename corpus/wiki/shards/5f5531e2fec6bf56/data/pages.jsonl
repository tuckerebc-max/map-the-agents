{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0deb7ce6519f2b7d980323d37e5ba2d8cfd60f1ffbae46f55104d3f7bddef08a"],"opposing_claim_ids":[],"text":"Running Teta OSS requires Git and Flutter installed, and both the server and desktop components must be started."},{"claim_ids":["clm_2c3f8d9d9cb3f097a03fb2e198ddbc00206cb27a40b98f4df03fd4f654316749"],"opposing_claim_ids":[],"text":"The open-source version includes only the editor, works with a single project, and requires the project path to be declared in a .env file."},{"claim_ids":["clm_32e623c78713ad8f999b21b55a6bb5fc906bd26ca63959f6de15cb2524611b8a"],"opposing_claim_ids":[],"text":"The project is under active development and currently in technical preview, with the repository updated regularly."},{"claim_ids":["clm_c8770cc6ed920b15dcbc62b4f712553ef0e1f4c58671f374d865bb65657cfd84"],"opposing_claim_ids":[],"text":"Teta OSS consists of two components: pkgs/server, a lightweight server for project operations, and apps/desktop, a Flutter desktop app with the programming editor."},{"claim_ids":["clm_d7f421c95bcd870ac691911938e7517c2726ba34e37c69226faa83cf2a022b66"],"opposing_claim_ids":[],"text":"Teta is available for macOS; versions for other platforms are stated as under development."},{"claim_ids":["clm_eb711c3dc8193be2603727d12b0475e99d980b24b4e4b30189dbf5ac06565acd"],"opposing_claim_ids":[],"text":"Teta is described as an open-source, AI-powered app builder for creating mobile apps by describing them."}],"claim_ids":["clm_0deb7ce6519f2b7d980323d37e5ba2d8cfd60f1ffbae46f55104d3f7bddef08a","clm_2c3f8d9d9cb3f097a03fb2e198ddbc00206cb27a40b98f4df03fd4f654316749","clm_32e623c78713ad8f999b21b55a6bb5fc906bd26ca63959f6de15cb2524611b8a","clm_c8770cc6ed920b15dcbc62b4f712553ef0e1f4c58671f374d865bb65657cfd84","clm_d7f421c95bcd870ac691911938e7517c2726ba34e37c69226faa83cf2a022b66","clm_eb711c3dc8193be2603727d12b0475e99d980b24b4e4b30189dbf5ac06565acd"],"created_at":"2026-09-14T02:24:36Z","created_by_operation":"op_5d