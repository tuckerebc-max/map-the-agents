maturity":"draft","page_type":"entity","path":"pages/entities/no1msd-seance-6fb96220a3fd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"no1msd/seance","updated_at":"2026-09-14T03:10:48Z","updated_by_operation":"op_0d5ca2e20fac4657b8d4e45ab024490b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_048c54e97869dc7b77a73ae335767c79d87b866705adf3aa9ad9a75f31dafa47"],"opposing_claim_ids":[],"text":"A bundled skill file (skills/seance-skill.md) provides AI agents a complete reference for the seance ctl API so they can operate the multiplexer on their own."},{"claim_ids":["clm_0539637090f04212af5e9436b1a44647d26c50032299ea2867140cd44f7450c4"],"opposing_claim_ids":[],"text":"Building from source requires Zig 0.16.x, GTK4, libadwaita, OpenGL 4.3+, and Linux (X11 or Wayland)."},{"claim_ids":["clm_0b432d9882c48a5c04da761fb14d60eee5ba9d69876cf91c4d9476cd9724309f"],"opposing_claim_ids":[],"text":"Séance is a GTK4 terminal multiplexer for Linux that auto-detects Claude Code, Codex, Pi, OpenCode, and Antigravity CLI sessions running inside it and tracks their status live in a sidebar."},{"claim_ids":["clm_27e25a6d258d5404d5927eade9e5fa7cb9bed22f2c8586a636f2c75d07b756c3"],"opposing_claim_ids":[],"text":"Panes are arranged in a horizontally scrolling strip, a layout model borrowed from niri, described as fitting long linear agent sessions better than a tiling grid."},{"claim_ids":["clm_3c3752a63ed9393219506eed404d3fc8949dec80ea99af47b476b12b04d8edd7"],"opposing_claim_ids":[],"text":"Terminal rendering is GPU-accelerated via libghostty (Ghostty used as a library), and the app is built with Zig, GTK4, and libadwaita."},{"claim_ids":["clm_4c9ff3aee28a9357e53c014246fb19988679dfe1317be7855c5d9c35b52db31b"],"opposing_claim_ids":[],"text":"Remote `opencode attach` sessions and `--pure` OpenCode launches are not tracked."},{"claim_ids":["clm_68d285b24c93ee4585c1ea420859df5bd63b8e22b6ca6ad58644bb26ca2fc7ad"],"opposing_claim_ids":[],"text":"Antigravity CLI tracking uses its status-line callback, which the wrapper adds to ~/.gemini/antigravity-cli/settings.json on first launch, keeping a backup at settings.json.seance-backup."},{"claim_ids":["clm_d9f6096a4449c892b9d9f7ab6c43e95fe78152eaa39f8bfdb4698a739a1bb893"],"opposing_claim_ids":[],"text":"The product includes workspaces, session persistence across restarts, tabs within columns, a command palette, focus-follows-mouse, and no telemetry; F11 toggles fullscreen and the header bar hides in fullscreen."},{"claim_ids":["clm_edd8647667664411b743c2f02e1f5ed4ca3b6a8c1aef1bed7faa31699fbe158e"],"opposing_claim_ids":[],"text":"Every action is available through `seance ctl`, which talks to the running instance over a Unix domain socket; scripts can create workspaces, open panes, send input, read terminal output, and query the session hierarchy, with JSON output for all commands."}],"claim_ids":["clm_048c54e97869dc7b77a73ae335767c79d87b866705adf3aa9ad9a75f31dafa47","clm_0539637090f04212af5e9436b1a44647d26c50032299ea2867140cd44f7450c4","clm_0b432d9882c48a5c04da761fb14d60eee5ba9d69876cf91c4d9476cd9724309f","clm_27e25a6d258d5404d5927eade9e5fa7cb9bed22f2c8586a636f2c75d07b756c3","clm_3c3752a63ed9393219506eed404d3fc8949dec80ea99af47b476b12b04d8edd7","clm_4c9ff3aee28a9357e53c014246fb19988679dfe1317be7855c5d9c35b52db31b","clm_68d285b24c93ee4585c1ea420859df5bd63b8e22b6ca6ad58644bb26ca2fc7ad","clm_d9f6096a4449c892b9d9f7ab6c43e95fe78152eaa39f8bfdb4698a739a1bb893","clm_edd8647667664411b743c2f02e1f5ed4ca3b6a8c1aef1bed7faa31699fbe158e"],"created_at":"2026-09-14T03:10:48Z","created_by_operation":"op_0d5ca2e20fac4657b8d4e45ab024490b","id":"pg_8aa6fba0bef15404a796e4c23cd36206","maturity":"draft","page_type":"source","path":"pages/sources/no1msd-seance-readme-md-f3b74415085d-e4c23cd36206.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_70dc1db2c3785338b20263c990e638bc"],"title":"no1msd/seance/README.md @ f3b74415085d","updated_at":"2026-09-14T03:10:48Z","updated_by_operation":"op_0d5ca2e20fac4657b8d4e45ab024490b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_142cece552d1144c16f1fcbfbdbf52c20b6292bf20a9c78a9a042f2ddd574db9"],"opposing_claim_ids":[],"text":"Repository development practice: security issues must be reported privately via GitHub's private vulnerability reporting rather than public issues, with acknowledgment aimed within 72 hours; only the latest pre-1.0 release is supported with security fixes."}],"claim_ids":["clm_142cece552d1144c16f1fcbfbdbf52c20b6292bf20a9c78a9a042f2ddd574db9"],"created_at":"2026-09-14T03:10:48Z","created_by_operation":"op_0d5ca2e20fac4657b8d4e45ab024490b","id":"pg_d9fbb0f818245ae59e0283799235e5fc","maturity":"draft","page_type":"source","path":"pages/sources/no1msd-seance-security-md-f3b74415085d-83799235e5fc.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3fdeda5ae7f852f9bab7f1243d72c67f"],"title":"no1msd/seance/SECURITY.md @ f3b74415085d","updated_at":"2026-09-14T03:10:48Z","updated_by_operation":"op_0d5ca2e20fac4657b8d4e45ab024490b"}
