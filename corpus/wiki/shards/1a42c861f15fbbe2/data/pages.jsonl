{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_803cd32fad2502b6317608c3b2717bfc976202452825fb6fb903bd1a7ab8c9d1"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run `G_DEBUG=fatal-criticals GTK_A11Y=none xvfb-run -a zig build test` and `xvfb-run zig build e2e`, and CI must pass before merge."},{"claim_ids":["clm_f14ad48abc4727e5adc4c66261f05d08ddc2afc4cddfaff1ea9c0cbf252fbfc0"],"opposing_claim_ids":[],"text":"Repository development practice: Zig code should follow `zig fmt` with functions kept small (~80 lines), new dependencies require a Discussion first, and PRs should contain one focused change."}],"claim_ids":["clm_803cd32fad2502b6317608c3b2717bfc976202452825fb6fb903bd1a7ab8c9d1","clm_f14ad48abc4727e5adc4c66261f05d08ddc2afc4cddfaff1ea9c0cbf252fbfc0"],"created_at":"2026-09-14T03:10:48Z","created_by_operation":"op_0d5ca2e20fac4657b8d4e45ab024490b","id":"pg_50e95bc2abe95498a459ff679b696597","maturity":"draft","page_type":"source","path":"pages/sources/no1msd-seance-contributing-md-f3b74415085d-ff679b696597.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c824506cb3725ff68812c3dfa5e1b8ed"],"title":"no1msd/seance/CONTRIBUTING.md @ f3b74415085d","updated_at":"2026-09-14T03:10:48Z","updated_by_operation":"op_0d5ca2e20fac4657b8d4e45ab024490b"}
