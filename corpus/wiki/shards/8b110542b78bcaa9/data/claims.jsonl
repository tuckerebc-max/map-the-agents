{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0adb3cce0386055f7816236bb303e9b2e02dccb065ab5ab5d597dabbfc81df6f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_01461a7bed1a3fe1b04df4785adb6b7c6a1e8762ad5953f80dad81ff7ca4a2eb","slc_48155ae2cbd5a01ca499fc3cff6a4559c4a9014fc522bcf3df1da41e414fdf86","slc_70aab7d6a376ff1ed01b7c48d466147059dcee7102530b2671e3815fc7f9301d"],"source_ids":["src_89f25906ba435fa4a110380c26bcb74a","src_f1a20d2129ba54bda19c895e73341f2b"],"text":"Repository development practice: releases publish to npm via OIDC trusted publishing from a v* tag-triggered GitHub Actions workflow, with an optional maintainer-approval environment gate; contributing guidance points to CONTRIBUTING.md and CLAUDE.md and notes strict typing with no 'any' or typecasts.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3be86c5d68e9296651c8470c1b9d8d231f1ef0dbdcb7231c0692eead852bd82d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_722f2754ad785fdc400ca48b0636f9a4219dc0ea8c45ef6c92119541ed8e8a39","slc_d407f6c08c8ee0f0847f58e03716394dcbb94e0cc67de1456a9869f44442e002"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"There is no universal /concord slash command; integration is via MCP tools plus installed per-client instructions, and live delivery depends on the receiving harness and session state.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3d576647722fe4ebafc08002ae00258134af940f394b5814e0d6bc8496883b09","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_a5cb4211cab831ea0049de5ae2a26b02bc39a7468dcc55209a6d3d84306cf1dc","slc_e9e0cde6dd282c8dc5620edb6f5518237eadc95fad169ffefe29bc61d49a0f84"],"source_ids":["src_89f25906ba435fa4a110380c26bcb74a","src_f1a20d2129ba54bda19c895e73341f2b"],"text":"The package is distributed as @concord-ai/concord-mcp on npm, installed globally, and the release workflow requires Node 24 and npm >= 11.5.1.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_67bb37c8a7515cbbf62772910001b991f80b70438b022c63a59069dcd1ebe5ad","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_459685a2cf7c198042efc027264af357ff3c5baf34baed61150f82fc9eb220b9"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"Delivery fails immediately when the named agent has no reachable endpoint rather than silently rerouting; hook-only integrations leave a durable pull message and state that limitation in the result.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_730768a1bf06d275b6d25698b32d44a78ca7e25a39de167902d3e44676d794cf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_b514720286be761084f1f947911b985f3bbf639cef6b27abe77dcde35f1deb04","slc_d7eab85b76d4c99efd9ebb32ebb36c5d60befad0a9e55738cc990a42439fcde9"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"Besides MCP tools, Concord offers a CLI (setup, status, dashboard, who, tasks, handoff, review-packet, export, doctor, adapters status) operating on the same shared workspace.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_791d497129e7081ea5165b5dc4bb0574e5e1e7f24cf5af61968f5e1aa7a1be6e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_df18160a08e2707e1e4c5903e665a7992153f909e4a16a922c46b889e5bdb436"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"Telemetry is sent to getconcord.ai but excludes code, paths, identifiers, and message content; CONCORD_TELEMETRY_DISABLED=1 or DO_NOT_TRACK=1 disables it, and delivery is best-effort so it can never fail an operation.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_89aa6cdd2162c79a7f25bb0eed3b0c9b53dd2c6fb088d412a5f2f7edddf8c75e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_64a23ba1db03e6264c2466c2fa7efb2e5c4264c1170e41550b652f3fbe89b504"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"Lifecycle-changing operations use the task's monotonic version as expected_version, so of two agents acting on the same version only the first transition succeeds; ownership changes are kept in an append-only audit history.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9082783e8004127566c87c8d7ee790f38f890473fec3b6becb81e9fc8cd2f5a4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_50dc98e6230e4b2e55aa76c8edaa7cb5055b054ce8ace1e0b839699a78574d24"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"SQLite in the repo-root .concord/ directory is the local source of truth; the root is resolved from CONCORD_REPO_ROOT, then CLAUDE_PROJECT_DIR, then the working directory, so agents in one repo share one store.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b1c6343914e410896c5e4ee6937a85cd6088beb07fe5867e77596b452c52c445","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_459685a2cf7c198042efc027264af357ff3c5baf34baed61150f82fc9eb220b9"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"Agent-to-agent prompts use update_work with operation \"prompt\", a to_agent_id, content, and idempotency_key; replies use operation \"reply\" with reply_to_message_id.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d8fe9d7f0184b63d76ae218922c599b68898b559ede3d386a4c8d3d91837fb23","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_cd436bd610354a3b7823d2b0752f76c80d4e2abe98130d0e5be812c8fd50fdab"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"The product exposes five MCP tools: start_work, inspect_work, update_work, transfer_work, and finish_work, covering presence/claims, state reads, prompts, ownership changes, and completion evidence.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_dd3337486c17d78b768c84b25445f138775744bf0bcfe8bad4686c4d37ee7a94","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_a9ccda6189381572434bee20f77441c4bad3d5c049dce8d005a4623aa1cd7024","slc_f170f44b908ef769936746b87818ac3d916d5c48a8abdf6645c5ba782dede628"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"The .concord/ workspace holds concord.db, HANDOFF.md, REVIEW_PACKET.md, and an optional WORK_STATE.json export; setup gitignores the directory so it stays local by default.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
{"access":"public","created_at":"2026-09-14T03:53:39Z","created_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f2153a3de9b07a225994ed0018bec4e003653fcd097d5f65a7b5f7cff4406b82","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"get-concord-ai/concord-mcp@d2408b0cbce5 snapshot 53cc4a249ea2b42d","timeframe":null},"slice_ids":["slc_c0c60e8e9a445b7ed0d659bb9049514a428eea3519bc466e0779945c0d2b2f42"],"source_ids":["src_f1a20d2129ba54bda19c895e73341f2b"],"text":"The README states Concord is not an orchestrator, code reviewer, hosted sync service, memory vector DB, or autonomous coding agent — it is a shared work-state layer for agents in the same local checkout.","updated_at":"2026-09-14T03:53:39Z","updated_by_operation":"op_6a056ce0c7f343da9edbda8d77b188cc"}
