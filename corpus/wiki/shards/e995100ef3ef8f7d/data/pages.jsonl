f822643","maturity":"draft","page_type":"entity","path":"pages/entities/almanaccode-codealmanac-e574cf822643.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"almanaccode/codealmanac","updated_at":"2026-09-14T03:34:14Z","updated_by_operation":"op_1f309a049f714fd685e389cedc550d24"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:34:14Z","created_by_operation":"op_1f309a049f714fd685e389cedc550d24","id":"pg_8be2ba85dc27530d91ef93852eeaf9a6","maturity":"draft","page_type":"source","path":"pages/sources/almanaccode-codealmanac-agents-md-0f153501f40a-93852eeaf9a6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c7a3085f17835a618f65d09d2a49784b"],"title":"AlmanacCode/codealmanac/AGENTS.md @ 0f153501f40a","updated_at":"2026-09-14T03:34:14Z","updated_by_operation":"op_1f309a049f714fd685e389cedc550d24"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2977149c896d390d85dc7b688e24d0de53cc006e0462a859791ae8181d201d77"],"opposing_claim_ids":[],"text":"The product is local-only: no hosted login, connect, or upload commands, no public SDK or MCP package, and no alternate wiki roots beyond almanac/."},{"claim_ids":["clm_356548984db3b70dec0dac9254b93e3319b3637b92c1356fdc4205836dc4903d"],"opposing_claim_ids":[],"text":"Lifecycle agents run with broad, non-interactive filesystem permissions; the almanac/ boundary is described as an instruction and commit policy rather than an OS sandbox."},{"claim_ids":["clm_3c496fa181c347d4d2bc5d1d713272a867683522e9293cbe867f2d628f5edf49"],"opposing_claim_ids":[],"text":"The serve command opens a read-only local web viewer rendering pages, search, topics, backlinks, and file-reference navigation, with --no-open and --wiki options."},{"claim_ids":["clm_51f805147a670437263e2ea05c5038d3e55dae7996da0334828ae8a95a7e926e"],"opposing_claim_ids":[],"text":"The tool requires Python 3.12+, is distributed via PyPI (the npm package is retired), and uses almanac-yoke as its single provider boundary for Codex and Claude runners."},{"claim_ids":["clm_628012f55f1759ff16b6fdc0a848a6034952fe44437ec4da5938bf74d3466e08"],"opposing_claim_ids":[],"text":"Sync scans local Codex and Claude transcript stores and queues conversations from registered repositories as ingest jobs, possibly deciding a conversation holds no durable knowledge."},{"claim_ids":["clm_8c7894a7fa7f85c096726b8d440f1909f6aad5fd0aa7fb372d1edd8beffe0310"],"opposing_claim_ids":[],"text":"Lifecycle commands (init, ingest, garden) queue runs and start a local worker; jobs can be listed, shown, logged, attached to, or cancelled, and records persist after the starting terminal closes."},{"claim_ids":["clm_9a37a215454350cff077b7be60a3ad65d016ecccda6d8b76a32553e61d876430"],"opposing_claim_ids":[],"text":"Setup installs three macOS launchd jobs: Sync every 5 hours scanning agent conversations, Garden every 24 hours reviewing wikis, and Update every 24 hours installing safe CLI updates."},{"claim_ids":["clm_a563bc20230ea2696cfc480d8afcdee4f3ffd70199fb71282981b6de00cb24bd"],"opposing_claim_ids":[],"text":"Optional anonymous telemetry sends command/lifecycle outcomes and sanitized crashes under a random install UUID, never code, paths, prompts, or credentials; it can be disabled via setup flag, config, or DO_NOT_TRACK=1."},{"claim_ids":["clm_b156661f134fe4a626a4c5ef6cab80740e13d404de73f21a6b965a6c9ab242b3"],"opposing_claim_ids":[],"text":"The wiki is plain markdown stored in the repo under almanac/, indexed locally and reviewed in Git like other code changes; a repo counts as a wiki when almanac/topics.yaml and almanac/README.md exist."},{"claim_ids":["clm_d312c51a35551142730fe5916cd76a6658ca102cc1958b87ea57f9e26cb6ef3a"],"opposing_claim_ids":[],"text":"Read commands accept --wiki <name> to target another registered local wiki; by default they target the exact current directory when it is a registered repository root."},{"claim_ids":["clm_d8e825009f4e4be073c8dc8c811ddef411ea6948c8737fe98e5c9f03f46fe9a1"],"opposing_claim_ids":[],"text":"Derived local state lives under ~/.codealmanac/, including a main database recording repositories, runs, run events, worker locks, and sync state, plus per-repo index databases."},{"claim_ids":["clm_f1216dbd966231217d4dea2f9e592660ca95c677ee81d60d67548fbea74aee7c"],"opposing_claim_ids":[],"text":"Support is currently limited to macOS with Codex or Claude Code, and the rewrite is described as local-only for now, with hosted integration possible later but not in this release surface."}],"claim_ids":["clm_2977149c896d390d85dc7b688e24d0de53cc006e0462a859791ae8181d201d77","clm_356548984db3b70dec0dac9254b93e3319b3637b92c1356fdc4205836dc4903d","clm_3c496fa181c347d4d2bc5d1d713272a867683522e9293cbe867f2d628f5edf49","clm_51f805147a670437263e2ea05c5038d3e55dae7996da0334828ae8a95a7e926e","clm_628012f55f1759ff16b6fdc0a848a6034952fe44437ec4da5938bf74d3466e08","clm_8c7894a7fa7f85c096726b8d440f1909f6aad5fd0aa7fb372d1edd8beffe0310","clm_9a37a215454350cff077b7be60a3ad65d016ecccda6d8b76a32553e61d876430","clm_a563bc20230ea2696cfc480d8afcdee4f3ffd70199fb71282981b6de00cb24bd","clm_b156661f134fe4a626a4c5ef6cab80740e13d404de73f21a6b965a6c9ab242b3","clm_d312c51a35551142730fe5916cd76a6658ca102cc1958b87ea57f9e26cb6ef3a","clm_d8e825009f4e4be073c8dc8c811ddef411ea6948c8737fe98e5c9f03f46fe9a1","clm_f1216dbd966231217d4dea2f9e592660ca95c677ee81d60d67548fbea74aee7c"],"created_at":"2026-09-14T03:34:14Z","created_by_operation":"op_1f309a049f714fd685e389cedc550d24","id":"pg_fbbc3f69e06958d4887ad72bb23d312c","maturity":"draft","page_type":"source","path":"pages/sources/almanaccode-codealmanac-readme-md-0f153501f40a-d72bb23d312c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_07acea46c7545d4084ff9872d0c06910"],"title":"AlmanacCode/codealmanac/README.md @ 0f153501f40a","updated_at":"2026-09-14T03:34:14Z","updated_by_operation":"op_1f309a049f714fd685e389cedc550d24"}
