{"access":"public","created_at":"2026-09-14T03:57:24Z","created_by_operation":"op_2af64d625b21474f9bb084aa88c1dd00","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cd567eb22cf8c9a0be118b5cb106817e61fdd1b7759f5f41f428a2e638c7284f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"human-agent-society/coral@0123dfb939b3 snapshot c9eb36b50c78ec1e","timeframe":null},"slice_ids":["slc_0e8453ab2f5bc5ff2679acd8eb3eaf79bb90a39a0e0d6a64dbf2f71b66daeb70","slc_1e0714da0eebb3a8a785e723e43a26d9306d99697efa22ce72345d5f73f71f13","slc_513e8b052af13de3bde73ac578bf638178f0c26c9a680295d6cd156653aa33c6","slc_e74c14336816d1570eb2da7b601d7f77071612ee23ece2ad491c7886e7b0abd2","slc_ea1db25ef452587f3cd0745a34067b01f9addf5dbc2eae8af5410f798f9e47fa"],"source_ids":["src_c78c91182b1e55e7913f161a97d3623e"],"text":"A top-level preset field layers reusable defaults between schema defaults and task.yaml, with CLI overrides winning over everything; presets cannot stack, and the resolved config is fully expanded so resume and the grader daemon never need the preset file.","updated_at":"2026-09-14T03:57:24Z","updated_by_operation":"op_2af64d625b21474f9bb084aa88c1dd00"}
