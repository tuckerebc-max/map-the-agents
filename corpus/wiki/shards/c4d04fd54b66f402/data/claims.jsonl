{"access":"public","created_at":"2026-09-14T03:45:32Z","created_by_operation":"op_7cd02c5a73a7485caa9122ef31063b67","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_70f500d3a7288c99cf497d14f98e9b2fad8a72cb9663b5e71a6d5dcdee49831e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"decron/whitebox-code-gpt@a5dbf33d4dd9 snapshot c6051f3e9be846f1","timeframe":null},"slice_ids":["slc_1bbcfd42b5401471717d45e71ea822a802dd3d840890e7836910d707871389c4","slc_3e8834e1bd133245e7fef1162f3d7535e45e763e1fe44c3c8120b0ab02b08de5","slc_814afb1bec65573521cbbdd27522d51bf64582c81c524ed53356527b3e26b206"],"source_ids":["src_02b80fe741335f89afebd7970b50266c"],"text":"The project targets the OpenAI custom GPT marketplace and invites reports on whether its knowledge files transfer effectively to other models; it is volunteer-maintained and seeks sponsors.","updated_at":"2026-09-14T03:45:32Z","updated_by_operation":"op_7cd02c5a73a7485caa9122ef31063b67"}
{"access":"public","created_at":"2026-09-14T03:45:32Z","created_by_operation":"op_7cd02c5a73a7485caa9122ef31063b67","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a1357d8913c2cb92bc43b21ddaf73db147f720fbb9910e3d710f012221a6337d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"decron/whitebox-code-gpt@a5dbf33d4dd9 snapshot c6051f3e9be846f1","timeframe":null},"slice_ids":["slc_e198a7da949488fe4f36fe3e36f1e18b97a41a6e5d64bbfcc1cc2e58bd71af03"],"source_ids":["src_02b80fe741335f89afebd7970b50266c"],"text":"The project warns that conversation-training settings cannot be truly verified and that knowledge-file/document training cannot be disabled in GPT builder, so users should avoid including sensitive material.","updated_at":"2026-09-14T03:45:32Z","updated_by_operation":"op_7cd02c5a73a7485caa9122ef31063b67"}
