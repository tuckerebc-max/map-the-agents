{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_a7ea26407b3a277f6f6dac37c6b53ba34812d167a8288425a04edd41b152ee72"],"opposing_claim_ids":[],"text":"A git utility module /backend/utils/git_operations.py provides get_git_info(repo_path), running git rev-parse commands with a 5-second timeout and returning branch, commit_hash, and error fields; the checklist marks it created."},{"claim_ids":["clm_d683b121f2f8d511491627e5047f2e4bcdbf7ded920164d222e02e7068f23bde"],"opposing_claim_ids":[],"text":"A GET /git-info/{repository} endpoint returns git branch and short commit hash for a repository, with 404 for missing repositories and 500 on failure; the checklist marks it implemented."}],"claim_ids":["clm_a7ea26407b3a277f6f6dac37c6b53ba34812d167a8288425a04edd41b152ee72","clm_d683b121f2f8d511491627e5047f2e4bcdbf7ded920164d222e02e7068f23bde"],"created_at":"2026-09-14T03:47:02Z","created_by_operation":"op_6e71cd42ce9f403e8ef830f8f2e075c8","id":"pg_22e75f81a4d95324a3fc4ebd1df70f2d","maturity":"draft","page_type":"source","path":"pages/sources/dharllc-speech-to-code-git-branch-implementation-checklist-md-c2756161-4ebd1df70f2d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_fffdb8ba144950998c247b66cc7f44d2"],"title":"dharllc/speech-to-code/git-branch-implementation-checklist.md @ c2756161e3ce","updated_at":"2026-09-14T03:47:02Z","updated_by_operation":"op_6e71cd42ce9f403e8ef830f8f2e075c8"}
