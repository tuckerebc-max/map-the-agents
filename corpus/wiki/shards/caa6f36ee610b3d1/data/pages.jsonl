{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1f279a9815daec4bf8db82b54d2bb55e59f642c523b71cbb89f13c1e680e98d2"],"opposing_claim_ids":[],"text":"Repository development practice: setup is via platform scripts (setup_windows.bat, setup_linux.sh) or manual venv creation plus pip install -r requirements.txt and a .env file."},{"claim_ids":["clm_1f6db99ab0c539bd9c610a285ff0ffb8e33c2d6afab573fc26fbcfc78ebeefc7"],"opposing_claim_ids":[],"text":"Performance can be tuned via PERFORMANCE_MODE (LOW/MEDIUM/MAX), MAX_THREADS, embedding cache size, similarity threshold, and per-provider API delay settings."},{"claim_ids":["clm_254a4ec615c5ccbfe8623974811120f33db685fdad36f97628467a52a32d3b75"],"opposing_claim_ids":[],"text":"The app runs via `python app.py` with a main menu offering Chat with AI, Agent Mode, Reindex Project, Project Info, Settings, and Exit."},{"claim_ids":["clm_4c52c6a4997e97a6951af68698879785680eb833d78a081e1d997ea4273bcd57"],"opposing_claim_ids":[],"text":"Anthropic and Groq do not provide embedding capabilities, so a different provider must be used for embeddings when those providers are selected."},{"claim_ids":["clm_525b64bb7f8f6b109fb5cdc115487b7c5199583462720c20e8b6de0fb2e20527"],"opposing_claim_ids":[],"text":"Repository development practice: contributions follow a fork, feature-branch, commit, push, and pull-request workflow, and PRs are welcomed."},{"claim_ids":["clm_80742661beddb1a77a576c05f7d3386ba8469136d39c519535cd1ebd5ddd749c"],"opposing_claim_ids":[],"text":"Supported LLM providers are Ollama (default, local), Google AI, OpenAI, Anthropic, Groq, and OpenRouter, each configured via .env provider and API-key variables."},{"claim_ids":["clm_948d0361ca80b1dbd1a45b782799f68b948900c469871185afec537c35bb0a6d"],"opposing_claim_ids":[],"text":"The AI has a memory system for project information, controlled by MEMORY_ENABLED with a configurable MAX_MEMORY_ITEMS cap (default 10)."},{"claim_ids":["clm_aa509a4cfca10b1f3fcf95ce6848ed728adb6f423f5253e44c47138a4d1e04d0"],"opposing_claim_ids":[],"text":"VerbalCodeAI is a terminal-based AI code companion offering code analysis, natural-language code search, chat, and agent mode, using embeddings and LLM integration."},{"claim_ids":["clm_b006ee4fbdf795a91b4f35fdf2e14c9e6649eb2bf47253d7e90712fcdb2fd680"],"opposing_claim_ids":[],"text":"Agent Mode provides search, file, code-analysis, git, memory, system-command, and web tools, including embed_search, run_command, git_history, and google_search."},{"claim_ids":["clm_d5708579cd114a667b9a9a2fd8897a1fc69c319fd263337c0af87d497fa3e89e"],"opposing_claim_ids":[],"text":"The HTTP server accepts only localhost connections by default; setting HTTP_ALLOW_ALL_ORIGINS=TRUE in .env allows connections from any IP address."},{"claim_ids":["clm_e2f0f67a0911193cdc777d97548a1bcadf45988fc2c5a5641e399ead6b246c0d"],"opposing_claim_ids":[],"text":"A built-in HTTP API server is started with `python app.py --serve [PORT]` (default 8000) and exposes health, initialize, ask, index/start, and index/status endpoints."}],"claim_ids":["clm_1f279a9815daec4bf8db82b54d2bb55e59f642c523b71cbb89f13c1e680e98d2","clm_1f6db99ab0c539bd9c610a285ff0ffb8e33c2d6afab573fc26fbcfc78ebeefc7","clm_254a4ec615c5ccbfe8623974811120f33db685fdad36f97628467a52a32d3b75","clm_4c52c6a4997e97a6951af68698879785680eb833d78a081e1d997ea4273bcd57","clm_525b64bb7f8f6b109fb5cdc115487b7c5199583462720c20e8b6de0fb2e20527","clm_80742661beddb1a77a576c05f7d3386ba8469136d39c519535cd1ebd5ddd749c","clm_948d0361ca80b1dbd1a45b782799f68b948900c469871185afec537c35bb0a6d","clm_aa509a4cfca10b1f3fcf95ce6848ed728adb6f423f5253e44c47138a4d1e04d0","clm_b006ee4fbdf795a91b4f35fdf2e14c9e6649eb2bf47253d7e90712fcdb2fd680","clm_d5708579cd114a667b9a9a2fd8897a1fc69c319fd263337c0af87d497fa3e89e","clm_e2f0f67a0911193cdc777d97548a1bcadf45988fc2c5a5641e399ead6b246c0d"],"created_at":"2026-09-14T03:22:07Z","created_by_operation":"op_6b8232537d594beea9d2a1b48264d1c1","id":"pg_07dda5063b0654e0b292f93177e72b33","m