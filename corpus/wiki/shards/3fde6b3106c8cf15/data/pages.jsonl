{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_121f0f46667a72276e0c3450521179690c97553c2e15f35680fe7549075d5d04"],"opposing_claim_ids":[],"text":"Orbital ships as a dedicated AI-first IDE plus extensions for VS Code, Cursor, and Windsurf; JetBrains IDEs and a CLI are listed as coming soon."},{"claim_ids":["clm_30d6db484c0d1dfe20f3fb86ed7b3215778b9223972086e987c4769f31dfd047"],"opposing_claim_ids":[],"text":"The product exposes agentic tools including fileEdit, executeCommand, read_multi_file, writeToFile, searchFiles, web_search, web_fetch, newTask, updateTodoList, and code-structure analysis tools."},{"claim_ids":["clm_4a0d8cf616c8bbc8f4df42be4c90555bc136d49635583e21121fae4aa47e5272"],"opposing_claim_ids":[],"text":"Per the README, JetBrains IDE support and a command-line interface are marked 'Coming Soon', and tab auto-complete is listed as coming soon."},{"claim_ids":["clm_779ba9109098addc5feddbe48774ce9bc99d5f80a51c570ca4ac5eae3acf85cc"],"opposing_claim_ids":[],"text":"The model catalog is served dynamically from the MatterAI backend, so new models appear in the selector without an extension update."},{"claim_ids":["clm_9651deec57cd27f2ecd21bb4046a33f2ae3c47e527471a4333b0eba385fef461"],"opposing_claim_ids":[],"text":"Repository development practice: contributors clone the axon-code repository and run pnpm install to set up the development environment, and the README points to a CONTRIBUTING.md guide."}],"claim_ids":["clm_121f0f46667a72276e0c3450521179690c97553c2e15f35680fe7549075d5d04","clm_30d6db484c0d1dfe20f3fb86ed7b3215778b9223972086e987c4769f31dfd047","clm_4a0d8cf616c8bbc8f4df42be4c90555bc136d49635583e21121fae4aa47e5272","clm_779ba9109098addc5feddbe48774ce9bc99d5f80a51c570ca4ac5eae3acf85cc","clm_9651deec57cd27f2ecd21bb4046a33f2ae3c47e527471a4333b0eba385fef461"],"created_at":"2026-09-14T02:16:22Z","created_by_operation":"op_8d2e3af1567a4a2a9a30e76d90bf54f9","id":"pg_26ea8b9fdd8a56b4a21412ea74d8f378","maturity":"draft","page_type":"source","path":"pages/sources/matteraiorg-orbital-extension-readme-md-ac82a92110ac-12ea74d8f378.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7ef300506d1d5abc9aaa59da3c8da305"],"title":"MatterAIOrg/Orbital-Extension/README.md @ ac82a92110ac","updated_at":"2026-09-14T02:16:22Z","updated_by_operation":"op_8d2e3af1567a4a2a9a30e76d90bf54f9"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_20e3e817d292ded8844cc4ba33bfb41d055ac7cbeb21295d6a5470f08ec7094e"],"opposing_claim_ids":[],"text":"search_files is ripgrep-first with FFF as fallback, one-shot with no cursor parameter, and results capped at 100 with pages telling the model to refine the pattern instead of paginating."},{"claim_ids":["clm_48b917c6e30b3d5d9bca9f7730e80d83ca628f6b0092b16634f5e37ba31cf7f0"],"opposing_claim_ids":[],"text":"A generate_file native tool produces file artifacts (PDF, DOCX, PPTX, XLSX, CSV, MD, TXT, HTML) via the MatterAI backend, holding binaries in memory until the user explicitly saves to the Downloads folder."},{"claim_ids":["clm_4a6639708a628936ef72a8b27396a72bb4fe2813e0887b9352946354e110d577"],"opposing_claim_ids":[],"text":"A /create-skill command lets users describe a workflow in plain language and creates or updates a reusable skill under .orb/skills/<skill-name>/ with supporting scripts and assets."},{"claim_ids":["clm_57396ddeffff09e57df546c57b442ba66a1e5bc0b40e1bc5eff2bd86df3eb00f"],"opposing_claim_ids":[],"text":"AGENTS.md project memory is loaded from the repo-level .orb/ directory (alongside project root and legacy .orbital/), shared between the IDE extension and the OrbCode CLI."},{"claim_ids":["clm_5c41c45eff133494a955862ad2a3fcc3b5c05073676bd61a8287a4614a9f5524"],"opposing_claim_ids":[],"text":"Models are fetched from the backend /v1/models endpoint and registered into the client registry, refreshing on window focus, via a refresh button, and through a 10-minute background poller."},{"claim_ids":["clm_b5262fbb4f45509d498fda953b33db229247b4f4756b6c0fcb5ba7e1fecdfa35"],"opposing_claim_ids":[],"text":"Independent read-only tools (read_file, search_files, list_files, list_code_definition_names, codebase_search, lsp) run concurrently up to 4 at a time, with results committed in model order; mutating and interactive tools stay serialized."},{"claim_ids":["clm_b97dcb4745b89dc4e389bb8187538b90c523817ba4a56b4c74f72b7e1ea422f5"],"opposing_claim_ids":[],"text":"File-edit tools require old_string to match exactly one location copied verbatim from a current read, and replace_all must be set intentionally after verifying all occurrences should change."}],"claim_ids":["clm_20e3e817d292ded8844cc4ba33bfb41d055ac7cbeb21295d6a5470f08ec7094e","clm_48b917c6e30b3d5d9bca9f7730e80d83ca628f6b0092b16634f5e37ba31cf7f0","clm_4a6639708a628936ef72a8b27396a72bb4fe2813e0887b9352946354e110d577","clm_57396ddeffff09e57df546c57b442ba66a1e5bc0b40e1bc5eff2bd86df3eb00f","clm_5c41c45eff133494a955862ad2a3fcc3b5c05073676bd61a8287a4614a9f5524","clm_b5262fbb4f45509d498fda953b33db229247b4f4756b6c0fcb5ba7e1fecdfa35","clm_b97dcb4745b89dc4e389bb8187538b90c523817ba4a56b4c74f72b7e1ea422f5"],"created_at":"2026-09-14T02:16:22Z","created_by_operation":"op_8d2e3af1567a4a2a9a30e76d90bf54f9","id":"pg_6ba9db44a1875749bde37250b28e323c","maturity":"draft","page_type":"source","path":"pages/sources/matteraiorg-orbital-extension-changelog-md-ac82a92110ac-7250b28e323c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0c71e76a85045de39bee0694ef1b117c"],"title":"MatterAIOrg/Orbital-Extension/CHANGELOG.md @ ac82a92110ac","updated_at":"2026-09-14T02:16:22Z","updated_by_operation":"op_8d2e3af1567a4a2a9a30e76d90bf54f9"}
