{"access":"public","created_at":"2026-09-14T04:03:28Z","created_by_operation":"op_69acd873cd044343bac3bedd47967276","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5eb3e72825e6d10306645adce4fe2a85f1652ff8629bac52644c047ab29854c1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"kingbootoshi/rgr@45ffc907a54b snapshot 608a715aaa98a9c8","timeframe":null},"slice_ids":["slc_2aceac6eb362501459924ecd7027677738c7a4495065b9d444a4e8bf32d3df6e","slc_2f6fd363eaf122f007839c6b4cfcd12d6842db8a4446c64e10aaa3ceb3e2d7d8","slc_4d380bbedd17f9dc387163cf3a1caa7568dc5ac012fc4c38c6c8546adcd34fc9"],"source_ids":["src_f643615a30725a0a9f54396e31684599"],"text":"The intent-lock feature adds core files intent.ts, scope-audit.ts, glob.ts, and stable-json.ts, with the scope audit composed inside verifyCommand rather than as a standalone authoritative command.","updated_at":"2026-09-14T04:03:28Z","updated_by_operation":"op_69acd873cd044343bac3bedd47967276"}
