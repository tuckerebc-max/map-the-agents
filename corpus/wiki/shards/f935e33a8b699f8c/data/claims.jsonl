{"access":"public","created_at":"2026-09-14T04:08:35Z","created_by_operation":"op_0024526ced714ac1b47b0f98e6b39691","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f6c319071be93e39acc6028b2c95c01675ea56733979472c08e65d3d5d8891fc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"lucasduys/forge@642c60b104f0 snapshot 6c3a4dda31584cbd","timeframe":null},"slice_ids":["slc_571b1b289de7776926b2fa5947aa4cbbedbd20fbb438d918011e54fb8ffa66b3","slc_73fa268f114b2f4b00df12db4127bdc3e0a1734d7b9d21da6c31a3ff041f4af4"],"source_ids":["src_7c798626c2b65109885d832c1564a228"],"text":"The brainstorm phase turns a one-line idea into an R-numbered spec with testable acceptance criteria, and every task must map to at least one R-number.","updated_at":"2026-09-14T04:08:35Z","updated_by_operation":"op_0024526ced714ac1b47b0f98e6b39691"}
