{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_721c9da5f83fdf93d7e210689ba21400c6c993409b1814c47fac3c1e4bea6e92"],"opposing_claim_ids":[],"text":"Repository development practice: CLAUDE.md defers to AGENTS.md as the single source of truth, and AGENTS.md mandates tests for new behavior, XML docs on public APIs, and no static mutable data."}],"claim_ids":["clm_721c9da5f83fdf93d7e210689ba21400c6c993409b1814c47fac3c1e4bea6e92"],"created_at":"2026-09-14T01:41:42Z","created_by_operation":"op_04d4b048cb3d48ff8df397e5e46894ef","id":"pg_83100b65c22755e38c94078d1595334f","maturity":"draft","page_type":"source","path":"pages/sources/codealta-codealta-claude-md-823f847297aa-078d1595334f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d2137e7510b35c76ae2d9e2fb4c86ebb"],"title":"CodeAlta/CodeAlta/CLAUDE.md @ 823f847297aa","updated_at":"2026-09-14T01:41:42Z","updated_by_operation":"op_04d4b048cb3d48ff8df397e5e46894ef"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0eec30d1d88beb8ad7c5cc5969a19787270def7e5ad0dc07c71fbd47ec6426ec"],"opposing_claim_ids":[],"text":"The TUI exposes slash commands and shortcuts such as `/open` (Ctrl+O), `/prompt`, `/model_providers`, `/models`, `/logs`, and `/help`."},{"claim_ids":["clm_273f1f6d380f8126f781489b3deefb03ed1cda43de79b591b6863f366295d712"],"opposing_claim_ids":[],"text":"Installation requires .NET 10 and is done via `dotnet tool install -g CodeAlta`, with updates via `dotnet tool update -g CodeAlta`."},{"claim_ids":["clm_4fb51b45446c4fc50320e764c9919189090f247ee1ec419d6bd76b3d4ac5d757"],"opposing_claim_ids":[],"text":"CodeAlta runs as a terminal workspace invoked via the `alta` command, providing a keyboard-first TUI with tabs, prompt editor, project sidebar, and command discovery."},{"claim_ids":["clm_62191ab58edb1d8e18a05f804eb2d7c56fd76345433ab2fc9e12d483cb5efd15"],"opposing_claim_ids":[],"text":"Supported model providers include Codex, Copilot, xAI Grok, OpenAI/Azure OpenAI/Alibaba APIs, Anthropic, Gemini/Vertex, and custom endpoints."},{"claim_ids":["clm_7e22fe5742cbcec9f00ea2005a4d13769f868f5bbf4282445ccf9b03d6775bf3"],"opposing_claim_ids":[],"text":"CodeAlta is pre-release software; configuration, screenshots, and extension APIs may change before version 1.0."},{"claim_ids":["clm_8201ed11d6397eaa2f3160e11324088928bc29f08b89602208ac1b51ce4b46b5"],"opposing_claim_ids":[],"text":"The UI is multilingual, offering Auto, English, Spanish, French, German, Japanese, or Simplified Chinese via Workspace Settings."},{"claim_ids":["clm_9cd83eb66198470021588e31e602ed326a8c85d86c7c02c8d0358f2fb170c627"],"opposing_claim_ids":[],"text":"Agent sessions are durable and project-scoped, stored in CodeAlta-owned journals, and can be reopened independently of provider startup; prompts can be queued on busy sessions."},{"claim_ids":["clm_d5f8c94c30368f21bcb1cc4dfa11db134a0ebca986a73af09807f5ed7ed65e8e"],"opposing_claim_ids":[],"text":"The repository includes a skills feature documented in doc/skills.md, referenced from the readme's documentation list."},{"claim_ids":["clm_e3bb666a49f4d38533de7f03f341fa0088bd15e61e8ef1b96eb805698534ad2a"],"opposing_claim_ids":[],"text":"On first launch the tool creates `~/.alta/config.toml` and leaves existing config untouched on later launches; if no provider is enabled, a Model Providers dialog opens."}],"claim_ids":["clm_0eec30d1d88beb8ad7c5cc5969a19787270def7e5ad0dc07c71fbd47ec6426ec","clm_273f1f6d380f8126f781489b3deefb03ed1cda43de79b591b6863f366295d712","clm_4fb51b45446c4fc50320e764c9919189090f247ee1ec419d6bd76b3d4ac5d757","clm_62191ab58edb1d8e18a05f804eb2d7c56fd76345433ab2fc9e12d483cb5efd15","clm_7e22fe5742cbcec9f00ea2005a4d13769f868f5bbf4282445ccf9b03d6775bf3","clm_8201ed11d6397eaa2f3160e11324088928bc29f08b89602208ac1b51ce4b46b5","clm_9cd83eb66198470021588e31e602ed326a8c85d86c7c02c8d0358f2fb170c627","clm_d5f8c94c30368f21bcb1cc4dfa11db134a0ebca986a73af09807f5ed7ed65e8e","clm_e3bb666a49f4d38533de7f03f341fa0088bd15e61e8ef1b96eb805698534ad2a"],"created_at":"2026-09-14T01:41:42Z","created_by_operation":"op_04d4b048cb3d48ff8df397e5e46894ef","id":"pg_8b12c41cabf55ccf8854c1037f69c54b","maturity":"draft","page_type":"source","path":"pages/sources/codealta-codealta-readme-md-823f847297aa-c1037f69c54b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_401af064b3dc571ba474ace989399845"],"title":"CodeAlta/CodeAlta/readme.md @ 823f847297aa","updated_at":"2026-09-14T01:41:42Z","updated_by_operation":"op_04d4b048cb3d48ff8df397e5e46894ef"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1ed53038245916a41b9aa6eb2958fbdca79352232ec8edef3206eab4cd9fb2d7"],"opposing_claim_ids":[],"text":"Repository development practice: commit subjects must use dotnet-releaser autolabel prefixes such as `Breaking Change`, `Add`, `Fix`, or `Enhance`, with issue references in parentheses."},{"claim_ids":["clm_721c9da5f83fdf93d7e210689ba21400c6c993409b1814c47fac3c1e4bea6e92"],"opposing_claim_ids":[],"text":"Repository development practice: CLAUDE.md defers to AGENTS.md as the single source of truth, and AGENTS.md mandates tests for new behavior, XML docs on public APIs, and no static mutable data."},{"claim_ids":["clm_8f659276043daaf1bf8644326e1eb6ea257309ea72531249d32ff90761bbc2e2"],"opposing_claim_ids":[],"text":"Repository development practice: contributors build with `dotnet build -c Release` and test with `dotnet test -c Release` in src/, and must keep docs updated before submitting."}],"claim_ids":["clm_1ed53038245916a41b9aa6eb2958fbdca79352232ec8edef3206eab4cd9fb2d7","clm_721c9da5f83fdf93d7e210689ba21400c6c993409b1814c47fac3c1e4bea6e92","clm_8f659276043daaf1bf8644326e1eb6ea257309ea72531249d32ff90761bbc2e2"],"created_at":"2026-09-14T01:41:42Z","created_by_operation":"op_04d4b048cb3d48ff8df397e5e46894ef","id":"pg_baadf3de48565b5081bd367abb3fc8e2","maturity":"draft","page_type":"source","path":"pages/sources/codealta-codealta-agents-md-823f847297aa-367abb3fc8e2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_faa3917eb4115dffac5fbdf541ab320f"],"title":"CodeAlta/CodeAlta/AGENTS.md @ 823f847297aa","updated_at":"2026-09-14T01:41:42Z","updated_by_operation":"op_04d4b048cb3d48ff8df397e5e46894ef"}
