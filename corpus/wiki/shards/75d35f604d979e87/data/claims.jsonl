{"access":"public","created_at":"2026-09-14T03:20:56Z","created_by_operation":"op_1dde686dc03d478986814c01ea5587d0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7a4717280e90169f10c53337ceb2cd862d8d1632dc6635871d0202f03da8ba77","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"truffle-ai/dexto@a910e0ef36f2 snapshot 491bca189af9a968","timeframe":null},"slice_ids":["slc_085bc4583b82c77d3662fb4000c995a46d7b4ad7e9b70f143ceddade45288de2","slc_13f095a94d345e3387f3ca70c46b2752b9c9838f28d273f8877e2f2ab078e679","slc_534ad4dd6f95870d1bd2e09c73bc5f56ef7ea9a03900f96169691efaa9f97813","slc_818d7b0ce5602b814e9df2fb23f91da6cc0e00006ece652e870c0e0879908ae8","slc_d02c7563781ba24f96e991df3aa67dcd3a6075aaaf87b36173fd2f726ff9caba"],"source_ids":["src_fcf32ae43a5657cab30fb11696cfa004"],"text":"An MCPManager class in @dexto/core connects to MCP servers, exposes tools, prompts, and resources, executes tools, and disconnects all servers.","updated_at":"2026-09-14T03:20:56Z","updated_by_operation":"op_1dde686dc03d478986814c01ea5587d0"}
{"access":"public","created_at":"2026-09-14T03:20:56Z","created_by_operation":"op_1dde686dc03d478986814c01ea5587d0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9d5b6a343b2ec5aeb51a12adb44ec370da15884ea52e178035ff8afd6e99a260","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"truffle-ai/dexto@a910e0ef36f2 snapshot 491bca189af9a968","timeframe":null},"slice_ids":["slc_3f8d98ba8e1254ba49ff7f2e7fc199b8ace0bd6c74795908591f9c84f16939f5","slc_750dd11a6e3ecb5b2591a8708910334d0c8fe24c4559f448a4abc40076106e5e","slc_baa0e0e2374980eadb115a3184437d4936e9589a8aa03d86b6d94d48dc53e139"],"source_ids":["src_fcf32ae43a5657cab30fb11696cfa004"],"text":"Storage is configurable with cache backends Redis or in-memory and database backends PostgreSQL, SQLite, or in-memory, plus session settings like maxSessions and sessionTTL.","updated_at":"2026-09-14T03:20:56Z","updated_by_operation":"op_1dde686dc03d478986814c01ea5587d0"}
{"access":"public","created_at":"2026-09-14T03:20:56Z","created_by_operation":"op_1dde686dc03d478986814c01ea5587d0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b84f0d65aff22e4d873362a8ab19b96afa2ae464604e295054b57333564329ef","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"truffle-ai/dexto@a910e0ef36f2 snapshot 491bca189af9a968","timeframe":null},"slice_ids":["slc_2fee2267c8240a2083cdd97e1f4ec02252a810b0978ec7144ab5abc3c8bff672","slc_c793c056570f572a5c08db2d3d5b31332855b62bccf09ecc03d9fe5942a4930e"],"source_ids":["src_fcf32ae43a5657cab30fb11696cfa004"],"text":"MCP servers are configured in agent YAML with stdio type, command, and args (e.g. filesystem or Puppeteer servers), and servers can be added via an MCP Store in the Web UI or /mcp CLI commands.","updated_at":"2026-09-14T03:20:56Z","updated_by_operation":"op_1dde686dc03d478986814c01ea5587d0"}
