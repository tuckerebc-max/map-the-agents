{"access":"public","created_at":"2026-09-14T03:35:15Z","created_by_operation":"op_4351f93141a34092bdfa567d49d41262","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2c1b59e55b0b0464c09ba4fd8aee189e3548ef39726834691ab3c5420394c13f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"angleschina/angles-cli@53cf51b702e4 snapshot 8818c2194b628043","timeframe":null},"slice_ids":["slc_0c8c5c08b2c906816ea047d65e39b7d6dc24a1c6e18668a032e5906cd545b1ca","slc_3116b98cdfcf65dc6d0be7a70797cde5e944f93c28d2ba36a895dc0e9da8d6cb","slc_b2befdc85f2d9753dbccbe04b786e30ce396e4ef5072abf8e4e49c688e339a71"],"source_ids":["src_aeaab04e90e45dc8b5b3007da6ae6ef3"],"text":"The tool ships as a single static ~1.6 MB Rust binary with zero runtime dependencies (no Node, Python, or dynamic libc), aimed at constrained environments like ARM64 SBCs, rootless containers, and iSH.","updated_at":"2026-09-14T03:35:15Z","updated_by_operation":"op_4351f93141a34092bdfa567d49d41262"}
{"access":"public","created_at":"2026-09-14T03:35:15Z","created_by_operation":"op_4351f93141a34092bdfa567d49d41262","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_41f06f5f6f6ba41e44dff6c443f3e2f8072039013482bd8e80437725096bb408","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"angleschina/angles-cli@53cf51b702e4 snapshot 8818c2194b628043","timeframe":null},"slice_ids":["slc_0b5b2e7fd0109f49f884ac8ee0545300934e8a11dd1db76784f90e2ccd79233c"],"source_ids":["src_aeaab04e90e45dc8b5b3007da6ae6ef3"],"text":"All agent capabilities are exposed as curated angles-* commands rather than free-form shell improvisation, binding the model to a deterministic tool set.","updated_at":"2026-09-14T03:35:15Z","updated_by_operation":"op_4351f93141a34092bdfa567d49d41262"}
