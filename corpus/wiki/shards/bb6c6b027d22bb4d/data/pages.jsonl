0b9e4df03695205d5cac","clm_c96a92398785db0486c4bf504a7c374c1dbbb57c552ae303f22c74cfc5bc52f4","clm_e6f94952e7b83f4fcb140d791d39e84b2bafc6a83e84021d874ad5962185e2d4"],"created_at":"2026-09-14T02:03:25Z","created_by_operation":"op_8911ecc87f084f3b85559f1f914e816c","id":"pg_174656a922ee52108255461028f2d9f7","maturity":"draft","page_type":"entity","path":"pages/entities/hoangsonww-forge-agentic-coding-cli-461028f2d9f7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"hoangsonww/forge-agentic-coding-cli","updated_at":"2026-09-14T02:03:25Z","updated_by_operation":"op_8911ecc87f084f3b85559f1f914e816c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_151c0f049be0b8941c038e6e50f43ceb47df0a47305ac940b31f69d338b59b8f"],"opposing_claim_ids":[],"text":"Forge auto-detects local providers (Ollama, LM Studio, vLLM, llama.cpp) on default ports; cloud providers (Anthropic, OpenAI-compatible, etc.) are opt-in rather than required."},{"claim_ids":["clm_4af778d0d79f9ab775256ce8fb6f28a4883fe8039274d2e6cf176c2755d6bcc3"],"opposing_claim_ids":[],"text":"Modes carry enforceable budgets: e.g. fast allows 2 executor turns and 0 validation retries, heavy 8 turns and 2 retries, plan and audit disallow mutations."},{"claim_ids":["clm_65d310024b1462ebaa0c8110e25ee99a934ecd857d5058cd6bae4fe2f1448c16"],"opposing_claim_ids":[],"text":"Forge is described as a local-first, plan-first, multi-agent, programmable software-engineering runtime where users pick and host the model and approve actions."},{"claim_ids":["clm_7266234cbaba90fccf6c19877c2bc9a0540a89d2f0a3fa20244a275b3068f12e"],"opposing_claim_ids":[],"text":"The runtime has 13 npm dependencies with zero optional, including @modelcontextprotocol/sdk, better-sqlite3, commander, undici, ws, yaml, and zod; Node.js >= 20 is required via package.json engines."},{"claim_ids":["clm_c96a92398785db0486c4bf504a7c374c1dbbb57c552ae303f22c74cfc5bc52f4"],"opposing_claim_ids":[],"text":"Repository development practice: README metrics are regenerated with 'bash scripts/metrics.sh' from docs/metrics.json, and contributor setup is pointed to docs/SETUP.md."}],"claim_ids":["clm_151c0f049be0b8941c038e6e50f43ceb47df0a47305ac940b31f69d338b59b8f","clm_4af778d0d79f9ab775256ce8fb6f28a4883fe8039274d2e6cf176c2755d6bcc3","clm_65d310024b1462ebaa0c8110e25ee99a934ecd857d5058cd6bae4fe2f1448c16","clm_7266234cbaba90fccf6c19877c2bc9a0540a89d2f0a3fa20244a275b3068f12e","clm_c96a92398785db0486c4bf504a7c374c1dbbb57c552ae303f22c74cfc5bc52f4"],"created_at":"2026-09-14T02:03:25Z","created_by_operation":"op_8911ecc87f084f3b85559f1f914e816c","id":"pg_4d7e728fc76a5fb3b4a56d5d3039f9c9","maturity":"draft","page_type":"source","path":"pages/sources/hoangsonww-forge-agentic-coding-cli-readme-md-50e173d93806-6d5d3039f9c9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c43ba3092cf857cbbfa8d6abc1d57568"],"title":"hoangsonww/Forge-Agentic-Coding-CLI/README.md @ 50e173d93806","updated_at":"2026-09-14T02:03:25Z","updated_by_operation":"op_8911ecc87f084f3b85559f1f914e816c"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:03:25Z","created_by_operation":"op_8911ecc87f084f3b85559f1f914e816c","id":"pg_555f39337e1152c69384588973cea40a","maturity":"draft","page_type":"source","path":"pages/sources/hoangsonww-forge-agentic-coding-cli-docs-install-md-50e173d93806-588973cea40a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9340a019db6c5e07b0ea8a9e26306762"],"title":"hoangsonww/Forge-Agentic-Coding-CLI/docs/INSTALL.md @ 50e173d93806","updated_at":"2026-09-14T02:03:25Z","updated_by_operation":"op_8911ecc87f084f3b85559f1f914e816c"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:03:25Z","created_by_operation":"op_8911ecc87f084f3b85559f1f914e816c","id":"pg_576c7af2a6b1528c99b1a3731528c3ec","maturity":"draft","page_type":"source","path":"pages/sources/hoangsonww-forge-agentic-coding-cli-flywheel-md-50e173d93806-a3731528c3ec.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_14467b7c101b5815abd17fa902dae1a1"],"title":"hoangsonww/Forge-Agentic-Coding-CLI/FLYWHEEL.md @ 50e173d93806","updated_at":"2026-09-14T02:03:25Z","updated_by_operation":"op_8911ecc87f084f3b85559f1f914e816c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_14c2ec4ca1804a02c6b60d141348d71d53b2211492427c3d4c2d9c61ba774e2b"],"opposing_claim_ids":[],"text":"The architecture claims capability-tier floors (e.g. 7B for single-file edits, hosted frontier for refactors) are 'measured empirically', suggesting some agent-performance evaluation was done, though no eval harness appears in the evidence."},{"claim_ids":["clm_151c0f049be0b8941c038e6e50f43ceb47df0a47305ac940b31f69d338b59b8f"],"opposing_claim_ids":[],"text":"Forge auto-detects local providers (Ollama, LM Studio, vLLM, llama.cpp) on default ports; cloud providers (Anthropic, OpenAI-compatible, etc.) are opt-in rather than required."},{"claim_ids":["clm_1d0999541735061d979772aff1d713bc60892e8ef85c26e803effada0d9f7b87"],"opposing_claim_ids":[],"text":"Four memory tiers are documented: hot (per-task, cleared on completion), warm (SQLite recent-task metadata), cold (lazy file/grep/AST index), and learning (patterns with confidence, read by the planner)."},{"claim_ids":["clm_3c84fa73a87579d4dd5dce64b3e027d783f59cadc6e1cefd8f63a0e78e4d5371"],"opposing_claim_ids":[],"text":"The agentic loop flows classify → plan → user approval → DAG execution with a validation gate, bounded retries, and a reviewer step before completion."},{"claim_ids":["clm_4af778d0d79f9ab775256ce8fb6f28a4883fe8039274d2e6cf176c2755d6bcc3"],"opposing_claim_ids":[],"text":"Modes carry enforceable budgets: e.g. fast allows 2 executor turns and 0 validation retries, heavy 8 turns and 2 retries, plan and audit disallow mutations."},{"claim_ids":["clm_61dc062fdff850671fd58e448e4708fe1b13c2c9ea4f35e424b1defd78eb599d"],"opposing_claim_ids":[],"text":"Tasks move through a state machine (draft, planned, approved, scheduled, running, verifying, completed/failed/blocked/cancelled); illegal transitions throw state_invalid and terminal states re-enter only via forge resume."},{"claim_ids":["clm_7556f6bccf835d13668ec07db1e1e09c5440f9429bf0b49c989dc47e6d349ee4"],"opposing_claim_ids":[],"text":"Filesystem access is realpath-resolved and confined to projectRoot plus whitelisted extra roots, with always-forbidden targets like /etc/passwd and SSH keys; grants persist in a SQLite permission_grants table."},{"claim_ids":["clm_7bc3fedf368b02481be35a73a2ba9a73e56e0d47d6ccbb00ec83130d17f0038c"],"opposing_claim_ids":[],"text":"Every tool invocation is risk-classified; low-risk reads auto-allow, medium/high risk prompts the user, sandbox violations hard-block, and critical shell commands are blocked regardless of preferences."},{"claim_ids":["clm_b238ccaeb9ece091962f41c9909581f12b83ec25306cad19c1ad3619138d51d8"],"opposing_claim_ids":[],"text":"The MCP server exposes read-only tools (forge_status, forge_plan, forge_get_task, forge_list_tasks) by default; forge_run and forge_cancel_task require opt-in via --allow-execute or FORGE_MCP_ALLOW_EXECUTE=true."},{"claim_ids":["clm_bc8985490d6e8f4272a56baac96c9f5d2b86f61906c50b9e4df03695205d5cac"],"opposing_claim_ids":[],"text":"Forge ships multiple surfaces: a commander-based CLI (24 commands), a raw-mode REPL, an HTTP/WebSocket dashboard, a VS Code extension, and an MCP server via 'forge mcp serve'."},{"claim_ids":["clm_e6f94952e7b83f4fcb140d791d39e84b2bafc6a83e84021d874ad5962185e2d4"],"opposing_claim_ids":[],"text":"The architecture defines six role-typed agents (planner, architect, executor, reviewer, debugger, memory) under src/agents, plus an orchestrator and agentic loop in src/core."}],"claim_ids":["clm_14c2ec4ca1804a02c6b60d141348d71d53b2211492427c3d4c2d9c61ba774e2b","clm_151c0f049be0b8941c038e6e50f43ceb47df0a47305ac940b31f69d338b59b8f","clm_1d0999541735061d979772aff1d713bc60892e8ef85c26e803effada0d9f7b87","clm_3c84fa73a87579d4dd5dce64b3e027d783f59cadc6e1cefd8f63a0e78e4d5371","clm_4af778d0d79f9ab775256ce8fb6f28a4883fe8039274d2e6cf176c2755d6bcc3","clm_61dc062fdff850671fd58e448e4708fe1b13c2c9ea4f35e424b1defd78eb599d","clm_7556f6bccf835d13668ec07db1e1e09c5440f9429bf0b49c989dc47e6d349ee4","clm_7bc3fedf368b02481be35a73a2ba9a73e56e0d47d6ccbb00ec83130d17f0038c","clm_b238ccaeb9ece091962f41c9909581f12b83ec25306cad19c1ad3619138d51d8","clm_bc8985490d6e8f4272a56baac96c9f5d2b86f61906c50b9e4df03695205d5cac","clm_e6f94952e7b83f4fcb140d791d39e84b2bafc6a83e84021d874ad5962185e2d4"],"created_at":"2026-09-14T02:03:25Z","created_by_operation":"op_8911ecc87f084f3b85559f1f914e816c","id":"pg_74f27b35b72d59e9938af452dbefd5c0","maturity":"draft","page_type":"source","path":"pages/sources/hoangsonww-forge-agentic-coding-cli-docs-architecture-md-50e173d93806-f452dbefd5c0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c986852811ef5211a8516914c424402b"],"title":"hoangsonww/Forge-Agentic-Coding-CLI/docs/ARCHITECTURE.md @ 50e173d93806","updated_at":"2026-09-14T02:03:25Z","updated_by_operation":"op_8911ecc87f084f3b85559f1f914e816c"}
