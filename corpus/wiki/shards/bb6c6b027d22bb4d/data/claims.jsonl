{"access":"public","created_at":"2026-09-14T02:03:25Z","created_by_operation":"op_8911ecc87f084f3b85559f1f914e816c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e6f94952e7b83f4fcb140d791d39e84b2bafc6a83e84021d874ad5962185e2d4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"hoangsonww/forge-agentic-coding-cli@50e173d93806 snapshot 67f90918cac0237a","timeframe":null},"slice_ids":["slc_1837d359613efe7949125c9e2c7876e3b86019f96ad5736f7597d22b37dc0339","slc_64dfe6ecffe2f2f03c2d73da287a0c31f0620e91efcaea9cd19b687b572ca40d"],"source_ids":["src_c986852811ef5211a8516914c424402b"],"text":"The architecture defines six role-typed agents (planner, architect, executor, reviewer, debugger, memory) under src/agents, plus an orchestrator and agentic loop in src/core.","updated_at":"2026-09-14T02:03:25Z","updated_by_operation":"op_8911ecc87f084f3b85559f1f914e816c"}
