{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_32c6238a233292b67da41ffe243ac40ab6edf64ab17dd5f27ab64405034c9b56"],"opposing_claim_ids":[],"text":"CLI options include --version, --dev (development mode launch), and --help."},{"claim_ids":["clm_98a44489363c5d90b422858fbd14b14a50b8b81803e855fcab84c59beaef1de3"],"opposing_claim_ids":[],"text":"The CLI accepts `biscuit [OPTIONS] [PATH]`, with subcommands including open, goto (line:column), clone, diff, and doc."}],"claim_ids":["clm_32c6238a233292b67da41ffe243ac40ab6edf64ab17dd5f27ab64405034c9b56","clm_98a44489363c5d90b422858fbd14b14a50b8b81803e855fcab84c59beaef1de3"],"created_at":"2026-09-14T03:19:52Z","created_by_operation":"op_d78a9c77afc44ec1853c91b8c95fcffa","id":"pg_0cbed714ac415af9bb0463caf642be92","maturity":"draft","page_type":"source","path":"pages/sources/tomlin7-biscuit-docs-cli-reference-mdx-85c5beb0c624-63caf642be92.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_db4f70b4b31d598f816d3ce6d1e6d76e"],"title":"tomlin7/biscuit/docs/cli-reference.mdx @ 85c5beb0c624","updated_at":"2026-09-14T03:19:52Z","updated_by_operation":"op_d78a9c77afc44ec1853c91b8c95fcffa"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_40c83cdcf21f3b201c2da4a4efdf01b0570e41b13bf076e72b0308a6d7ef03df"],"opposing_claim_ids":[],"text":"The extension system is Python-based, covering language servers, formatters, AI providers, and UI views, contrasting with JS/TS plugin systems of traditional editors."},{"claim_ids":["clm_93ac0411ece4dc1826b3f4ce74f01d0551eb292266c692bb2d9df88452bd00b9"],"opposing_claim_ids":[],"text":"The editor is built with Python and Tkinter, runs natively on Windows, Linux, and macOS, and is not an Electron app."},{"claim_ids":["clm_a48fad887d5b6a96a1e3c123e1944612268a4ee01a7a69e669d2c725824cff28"],"opposing_claim_ids":[],"text":"Biscuit is described as a fast, extensible native code editor with agents, under 20 MB in size, installable in seconds."},{"claim_ids":["clm_d1a3d8738564346186256a7d96adeab5c270a71c80fa7795ca0218e3684e0f42"],"opposing_claim_ids":[],"text":"The built-in planning agent ships with eleven tools, including ReadFile, EditFile, DeleteFile, ListDir, GlobFileSearch, Grep, CodebaseSearch, RunTerminalCmd, TodoWrite, GetWorkspaceInfo, and GetActiveEditor."}],"claim_ids":["clm_40c83cdcf21f3b201c2da4a4efdf01b0570e41b13bf076e72b0308a6d7ef03df","clm_93ac0411ece4dc1826b3f4ce74f01d0551eb292266c692bb2d9df88452bd00b9","clm_a48fad887d5b6a96a1e3c123e1944612268a4ee01a7a69e669d2c725824cff28","clm_d1a3d8738564346186256a7d96adeab5c270a71c80fa7795ca0218e3684e0f42"],"created_at":"2026-09-14T03:19:52Z","created_by_operation":"op_d78a9c77afc44ec1853c91b8c95fcffa","id":"pg_0d4b562e5b32510f86765c562d3b2751","maturity":"draft","page_type":"source","path":"pages/sources/tomlin7-biscuit-docs-index-mdx-85c5beb0c624-5c562d3b2751.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d6e600287cf25f8a9439c5cc5c770e77"],"title":"tomlin7/biscuit/docs/index.mdx @ 85c5beb0c624","updated_at":"2026-09-14T03:19:52Z","updated_by_operation":"op_d78a9c77afc44ec1853c91b8c95fcffa"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_476218364a80222ce97f6907ae611b1ed01afc6d29028c4b04679d8b7e7bbbbb"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are directed to a contributing guide and docs for project structure and environment setup, and the project supports both Poetry and uv for dependency management."},{"claim_ids":["clm_60d844d9217015d89201914f2b57f8425aed37dc19e3ae40d2dac2bdb840784f"],"opposing_claim_ids":[],"text":"Per the README checklist, full DAP client integration, vim mode support, LLM provider extension examples, and an ollama extension rewrite remain incomplete; the old ollama and several formatter extensions are deprecated."},{"claim_ids":["clm_7878b95867aa8d35473f1c4398098296e09bf68f091a9a5123981356e6206d2e"],"opposing_claim_ids":[],"text":"Source control features include a split diff viewer, git operations (push, pull, commit, stage, unstage, branch switching), and repository cloning; GitHub issues/PR viewing is currently disabled pending conversion to an extension."},{"claim_ids":["clm_a48fad887d5b6a96a1e3c123e1944612268a4ee01a7a69e669d2c725824cff28"],"opposing_claim_ids":[],"text":"Biscuit is described as a fast, extensible native code editor with agents, under 20 MB in size, installable in seconds."},{"claim_ids":["clm_aa3163a8490f476852ff672986d4e6275bc7987e82977a700d6ae98f1e9a808d"],"opposing_claim_ids":[],"text":"The agent supports Gemini and Anthropic APIs (claude-4-5-opus/sonnet/haiku, gemini-2-5-flash/pro), file attachment for chat context, and additional LLM providers via extensions."},{"claim_ids":["clm_c9061fde8880895b165c7a61361b6ed8fa8119479150eb2af5c3420985095494"],"opposing_claim_ids":[],"text":"Code intelligence features tree-sitter parsing/highlights, completions, hover docs, symbol outline, symbol search, peek-to-definition, and references, with more language servers added via extensions."},{"claim_ids":["clm_d1a3d8738564346186256a7d96adeab5c270a71c80fa7795ca0218e3684e0f42"],"opposing_claim_ids":[],"text":"The built-in planning agent ships with eleven tools, including ReadFile, EditFile, DeleteFile, ListDir, GlobFileSearch, Grep, CodebaseSearch, RunTerminalCmd, TodoWrite, GetWorkspaceInfo, and GetActiveEditor."},{"claim_ids":["clm_ed00676f8acf685710ec605ca6658485b7af8ab3572b2f6c2593b90fd4496e14"],"opposing_claim_ids":[],"text":"Debugging includes breakpoints, runtime variable inspection and modification, call stack visualization, and a built-in Python debugger; additional debuggers can be registered via extensions."},{"claim_ids":["clm_f7fd5e4d88aba0ae25efcf4fa2f6fb07f088c8d9be136f5659657ffa211bbc8e"],"opposing_claim_ids":[],"text":"Search is ripgrep-based with regex and case-sensitivity support, individual or bulk replace, and a floating find-replace widget in open editors."}],"claim_ids":["clm_476218364a80222ce97f6907ae611b1ed01afc6d29028c4b04679d8b7e7bbbbb","clm_60d844d9217015d89201914f2b57f8425aed37dc19e3ae40d2dac2bdb840784f","clm_7878b95867aa8d35473f1c4398098296e09bf68f091a9a5123981356e6206d2e","clm_a48fad887d5b6a96a1e3c123e1944612268a4ee01a7a69e669d2c725824cff28","clm_aa3163a8490f476852ff672986d4e6275bc7987e82977a700d6ae98f1e9a808d","clm_c9061fde8880895b165c7a61361b6ed8fa8119479150eb2af5c3420985095494","clm_d1a3d8738564346186256a7d96adeab5c270a71c80fa7795ca0218e3684e0f42","clm_ed00676f8acf685710ec605ca6658485b7af8ab3572b2f6c2593b90fd4496e14","clm_f7fd5e4d88aba0ae25efcf4fa2f6fb07f088c8d9be136f5659657ffa211bbc8e"],"created_at":"2026-09-14T03:19:52Z","created_by_operation":"op_d78a9c77afc44ec1853c91b8c95fcffa","id":"pg_0fd5ad40b16457dba260c32b311fb925","maturity":"draft","page_type":"source","path":"pages/sources/tomlin7-biscuit-readme-md-85c5beb0c624-c32b311fb925.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a066be3d6e1e5368aa6aa09d35136b01"],"title":"tomlin7/biscuit/README.md @ 85c5beb0c624","updated_at":"2026-09-14T03:19:52Z","updated_by_operation":"op_d78a9c77afc44ec1853c91b8c95fcffa"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_21408efd9f3ff9cd2d3be42b08ad74659ed1b0dc4777452ff209256eb276a8da"],"opposing_claim_ids":[],"text":"Repository development practice: source installation uses `poetry install` or `uv sync`, then runs via `poetry run biscuit` or `uv run biscuit`; Python 3.10+ is required (3.11+ recommended for development)."},{"claim_ids":["clm_99da2986b0907c2f008e8b9f604761a09266c1342dc5ebff0a5eaba9faba87b2"],"opposing_claim_ids":[],"text":"Linux installation may require system packages such as fontconfig, a C++ compiler, and CMake, plus pip-installed scikit-build on Debian-based distributions."}],"claim_ids":["clm_21408efd9f3ff9cd2d3be42b08ad74659ed1b0dc4777452ff209256eb276a8da","clm_99da2986b0907c2f008e8b9f604761a09266c1342dc5ebff0a5eaba9faba87b2"],"created_at":"2026-09-14T03:19:52Z","created_by_operation":"op_d78a9c77afc44ec1853c91b8c95fcffa","id":"pg_4543181e4e2a5820bdd75609c32b31e5","maturity":"draft","page_type":"source","path":"pages/sources/tomlin7-biscuit-docs-installation-mdx-85c5beb0c624-5609c32b31e5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e07f2c39f86954eba941be25fa68720c"],"title":"tomlin7/biscuit/docs/installation.mdx @ 85c5beb0c624","updated_at":"2026-09-14T03:19:52Z","updated_by_operation":"op_d78a9c77afc44ec1853c91b8c95fcffa"}
