2","maturity":"draft","page_type":"entity","path":"pages/entities/kilo-org-kilocode-7256ec806a52.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"kilo-org/kilocode","updated_at":"2026-09-14T02:09:52Z","updated_by_operation":"op_9d591287982140e4a8f8c162115fa5f5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_a7a407485803ccc1d971b27f77e4784e547fbf571c766cdfa415cf59767a651b"],"opposing_claim_ids":[],"text":"The privacy policy states prompts and relevant project context are sent to the user's chosen AI model provider (e.g., OpenAI, Anthropic, OpenRouter), and API keys are stored locally on the device."}],"claim_ids":["clm_a7a407485803ccc1d971b27f77e4784e547fbf571c766cdfa415cf59767a651b"],"created_at":"2026-09-14T02:09:52Z","created_by_operation":"op_9d591287982140e4a8f8c162115fa5f5","id":"pg_8766a8f2ca2559bc8ee455f0403c1fb8","maturity":"draft","page_type":"source","path":"pages/sources/kilo-org-kilocode-privacy-md-c36e22634860-55f0403c1fb8.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d0ca5759d2325397be6e0d21c0e12f54"],"title":"Kilo-Org/kilocode/PRIVACY.md @ c36e22634860","updated_at":"2026-09-14T02:09:52Z","updated_by_operation":"op_9d591287982140e4a8f8c162115fa5f5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7065836d8d126c3c73cab862751e87c3c8b23879aef152eebaba77b39db2cbeb"],"opposing_claim_ids":[],"text":"Tool output persisted in session history is size-bounded by the Tool Registry; oversized output is retained in a temporary managed tool-output file under a shared directory."},{"claim_ids":["clm_82a1dc7ff3dc65c425b84d05768f618fea08a90c56049220bcd51a6e2ccfba6e"],"opposing_claim_ids":[],"text":"The runtime defines a session context model: a System Context assembled from typed Context Sources, Session History projected per provider turn, and a Context Snapshot tracking each source's last-admitted value."},{"claim_ids":["clm_97c56a1931f126ae17e420eb8a81d0d87e8ee25f72f11ab519f9017da33f74be"],"opposing_claim_ids":[],"text":"Context changes are admitted lazily at a Safe Provider-Turn Boundary rather than pushed asynchronously, and changes from multiple sources at one boundary combine into a single Mid-Conversation System Message."},{"claim_ids":["clm_c5148cdb21b2e43917cead849e0db5672cb0a2e6768276469370f2ceb19246df"],"opposing_claim_ids":[],"text":"The architecture exposes a public HttpApi from which Promise and Effect clients are generated, plus an Embedded OpenCode in-process host using an in-memory HTTP transport against the same router."}],"claim_ids":["clm_7065836d8d126c3c73cab862751e87c3c8b23879aef152eebaba77b39db2cbeb","clm_82a1dc7ff3dc65c425b84d05768f618fea08a90c56049220bcd51a6e2ccfba6e","clm_97c56a1931f126ae17e420eb8a81d0d87e8ee25f72f11ab519f9017da33f74be","clm_c5148cdb21b2e43917cead849e0db5672cb0a2e6768276469370f2ceb19246df"],"created_at":"2026-09-14T02:09:52Z","created_by_operation":"op_9d591287982140e4a8f8c162115fa5f5","id":"pg_94f52b87669d52728bfecdbe50bc42bb","maturity":"draft","page_type":"source","path":"pages/sources/kilo-org-kilocode-context-md-c36e22634860-cdbe50bc42bb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8aff3e65fa025adaadc7d8b9baaa8b3a"],"title":"Kilo-Org/kilocode/CONTEXT.md @ c36e22634860","updated_at":"2026-09-14T02:09:52Z","updated_by_operation":"op_9d591287982140e4a8f8c162115fa5f5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_21c520353e67b952c43e9e79d36a1d03fc4d24209560ab4f298070e5bab1002b"],"opposing_claim_ids":[],"text":"The CLI's `kilo run --auto` mode disables all permission prompts and executes actions without confirmation, intended for trusted CI/CD environments."},{"claim_ids":["clm_5557ca92e1957cfa412537786b0a1863464170391d330837433f34cf36118c0c"],"opposing_claim_ids":[],"text":"Kilo ships specialized agents: Code (default, implements code), Plan (architecture and plans), Ask (answers without touching files), Debug, and Review, and users can build custom agents."},{"claim_ids":["clm_5d282645eb1235d4da66f19328fbcf5d5bbb3267d973b1fdec99e2c8d6c2a85e"],"opposing_claim_ids":[],"text":"The CLI ships as platform binaries for Windows, macOS (Intel and Apple Silicon), and Linux x64/ARM, including a musl build for Alpine and a non-AVX baseline build for older CPUs."},{"claim_ids":["clm_93523d95a1c2cce4d77642b75496c70cfa3c308fb57a32fe5bda137ba0039e88"],"opposing_claim_ids":[],"text":"Kilo Code is an AI coding agent available for VS Code, JetBrains IDEs, and as a CLI, installable via npm, curl, pnpm, bun, Homebrew, and AUR."},{"claim_ids":["clm_e7599b7c3bfd1f687b597d4f8bb46f0172b4e31f5462e0ce81146961b282727a"],"opposing_claim_ids":[],"text":"Documented capabilities include multi-file code generation, inline ghost-text autocomplete, self-checking, terminal and browser control, an MCP marketplace, and 500+ models with mid-task switching."}],"claim_ids":["clm_21c520353e67b952c43e9e79d36a1d03fc4d24209560ab4f298070e5bab1002b","clm_5557ca92e1957cfa412537786b0a1863464170391d330837433f34cf36118c0c","clm_5d282645eb1235d4da66f19328fbcf5d5bbb3267d973b1fdec99e2c8d6c2a85e","clm_93523d95a1c2cce4d77642b75496c70cfa3c308fb57a32fe5bda137ba0039e88","clm_e7599b7c3bfd1f687b597d4f8bb46f0172b4e31f5462e0ce81146961b282727a"],"created_at":"2026-09-14T02:09:52Z","created_by_operation":"op_9d591287982140e4a8f8c162115fa5f5","id":"pg_bb7038ea1ae7501db29ba8c97fbdc2a1","maturity":"draft","page_type":"source","path":"pages/sources/kilo-org-kilocode-readme-md-c36e22634860-a8c97fbdc2a1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ab0342261a4e579aa6c53008f336190c"],"title":"Kilo-Org/kilocode/README.md @ c36e22634860","updated_at":"2026-09-14T02:09:52Z","updated_by_operation":"op_9d591287982140e4a8f8c162115fa5f5"}
