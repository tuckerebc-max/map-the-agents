{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_17892d27beda224b80f43bdf6a71bbc91c2167a3cf214628b81dec3494027395"],"opposing_claim_ids":[],"text":"A draft 0xSKL integration spec (v0.1.0) defines an extended skill manifest with an AIP author block (DID, public key, Ed25519 signature over sha256 of name+version+content_hash+timestamp) and Cage execution policy based on author trust score."}],"claim_ids":["clm_17892d27beda224b80f43bdf6a71bbc91c2167a3cf214628b81dec3494027395"],"created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","id":"pg_39a9bf6481aa53c992810662f89e2aeb","maturity":"draft","page_type":"source","path":"pages/sources/the-nexus-guard-aip-docs-0xskl-integration-spec-md-3d8c873139ea-0662f89e2aeb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dae9d7254c9e57e0bd5001bff74d8f2b"],"title":"The-Nexus-Guard/aip/docs/0xskl_integration_spec.md @ 3d8c873139ea","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
