{"access":"public","created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3715f251fceb5812b75246e44ef07b0f02bfd974d74f356d5ccfb1d01d6fbb00","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"the-nexus-guard/aip@3d8c873139ea snapshot e93b0149ff82da41","timeframe":null},"slice_ids":["slc_2748bd3f1fbc613f359cb32f177e6f1ae124476b465ef6d8fa8c1f4ea7860cff","slc_60d5e44a07f363693298c16a7c10cb145425f2e884bde91b1bc186002bec820c","slc_63f71dd982d7d974321f49fe885a8f5df725b4ed01e3afde089d5a01723954a9","slc_baa97ee7b243eb9a09f277a12e606a5cbc635fa34dafcd2052fb0ed077f2320b","slc_cb4fc76ebc6290e6ee2204cd496781d4b784ab66f329a6d571d5e5298c60790b"],"source_ids":["src_383914975aaf5cbbbb09ab19317e0008"],"text":"AIP targets agent-to-agent security gaps: verifying who an agent is, deciding trustworthiness via vouch chains, signing skills for code provenance, and private messaging, including MCP and A2A protocol integrations.","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
{"access":"public","created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_612a45aec8782e67978dbf64daa8d4cb5e87536f369ad477b92e75110922e0ef","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"the-nexus-guard/aip@3d8c873139ea snapshot e93b0149ff82da41","timeframe":null},"slice_ids":["slc_18c5945f8111c0ffbd6386c9a54e15e5f8f9e9391935a722ce2a730b12cd0150","slc_221d1990f8f8be6c28cd9c379199f2af184f37311c80fe5c241d6e4359e14a07","slc_e0ab138775c99d81c972af16416a53d507b5a7f7ec0dc3be7c3f0b8565f866f3"],"source_ids":["src_383914975aaf5cbbbb09ab19317e0008"],"text":"A CLI named 'aip' exposes commands including init, register, verify, vouch, revoke, sign, message, messages, reply, rotate-key, trust-score, trust-graph, doctor, export, import, search, and cache.","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
{"access":"public","created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_65b86f13998ec396cca9bb073d7e369a1f2960beddc417ed6699eaca8820a199","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"the-nexus-guard/aip@3d8c873139ea snapshot e93b0149ff82da41","timeframe":null},"slice_ids":["slc_1f188fa2ea3ace3b93d330e306139e063b789a3008162dd8973dc538d574b182","slc_af5d0a00201621d391f7f043d13debe530cfdbed4f3ccbc46102b558fe215bfa","slc_c8bd4f52a5e27168dc266ec4a87c9a7b1825ce37d5e6aae40b0c9ddc7ed810f1"],"source_ids":["src_383914975aaf5cbbbb09ab19317e0008"],"text":"A pure-Python implementation exists with zero dependencies; optional performance dependencies include cryptography or pynacl, and langchain-core is an optional dependency for framework tools.","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
{"access":"public","created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_69941c125971d2e5c56fd8abb934dd0c71702f1049b279f9d40d4f9878707724","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"the-nexus-guard/aip@3d8c873139ea snapshot e93b0149ff82da41","timeframe":null},"slice_ids":["slc_af5d0a00201621d391f7f043d13debe530cfdbed4f3ccbc46102b558fe215bfa","slc_d306c96934e425b4747c00b79690b4787cf6feb1d8d3e8b31258e7e7cf82e191"],"source_ids":["src_383914975aaf5cbbbb09ab19317e0008"],"text":"The protocol is designed to be decentralized with no central registry, local-first so each agent keeps its own trust view, and auditable via signed 'isnad' trust chains.","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
{"access":"public","created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ba7db7ae40652595d077e6138ae6ac1a97d039c1984ae8a81d7d2ea32bb8af37","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"the-nexus-guard/aip@3d8c873139ea snapshot e93b0149ff82da41","timeframe":null},"slice_ids":["slc_02d0150502c51397728daa6ad9d8b017fcf14b5477fdc330b08bf1574bac4f9a","slc_04da8fa661f689d8b330c70ed8d834a21278d8e060a326a2b4fa3c299b2f8d94","slc_d93455bb0c901296a89ab87e422e9666edffbb582bc995dec3a22659dd8cd89b"],"source_ids":["src_383914975aaf5cbbbb09ab19317e0008"],"text":"Message signing uses the payload format sender_did|recipient_did|timestamp|encrypted_content; the older format without encrypted_content still works but is deprecated and slated for removal.","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
{"access":"public","created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c7792ef0f183a74aa8ce2b5b8d55e63032db8e712c5919c3d0b2576a4cff8e02","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"the-nexus-guard/aip@3d8c873139ea snapshot e93b0149ff82da41","timeframe":null},"slice_ids":["slc_b3784683d0f11557dff30fa404ee53dbd1c5971545e1c5b5914ca818ec99c040","slc_d3d47f6033ab198770acbde5e12c643e5bf577c656d686957c90a27ebc55b9f7"],"source_ids":["src_383914975aaf5cbbbb09ab19317e0008"],"text":"Trust paths use decay scoring across hops (e.g., a documented example of 0.64 for two hops at 0.8 decay), and badges turn green 'Verified' at 3+ CODE_SIGNING vouches.","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
{"access":"public","created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c8161a12388fd119441499c2afc79faee98109dfed98008c618fd30f334addbe","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"the-nexus-guard/aip@3d8c873139ea snapshot e93b0149ff82da41","timeframe":null},"slice_ids":["slc_3f817f122ab994eb5a2a3d65b0fe6420b3fefb0e732eedf5f0f40e1ec1d45aef","slc_a6787e2eba1dcb30f19478b00898e8bb60d84edd448b97186186c4e4845ce31d","slc_dd8730be4c8a77bacd2e8babd2f67579262e5419cfc8b72b77ff6bc0b6e97957","slc_ff86531380112d82da38cf08ac30847cfed669b1b8dd2ba56c06dd634d576586"],"source_ids":["src_383914975aaf5cbbbb09ab19317e0008"],"text":"An identity middleware (AIPMiddleware) signs outgoing HTTP requests and verifies incoming ones, exposing trust-score-gated processing and peer discovery by minimum trust.","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
{"access":"public","created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d0a97f31febeb14bd0df7911e4774f70f7c7b41fe550626bd9992f08889f46d2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"the-nexus-guard/aip@3d8c873139ea snapshot e93b0149ff82da41","timeframe":null},"slice_ids":["slc_5aed92c3650c8b363cdc14a7c9c2a7455102030863549b63f62ab459bde479f4","slc_7604fb54af74ca133724c5e5a65011f66995580f5a3364be381b0381ca4b580a"],"source_ids":["src_383914975aaf5cbbbb09ab19317e0008"],"text":"The status checklist marks trust gossip protocol and reputation scoring as unchecked, indicating these are not yet implemented in v0.5.46.","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
{"access":"public","created_at":"2026-09-14T05:10:26Z","created_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f8d132b6b3202243fe667dc83b212702ae75f1ac3c533ef13766dde48ff432aa","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"the-nexus-guard/aip@3d8c873139ea snapshot e93b0149ff82da41","timeframe":null},"slice_ids":["slc_2e344c1b4d19ce22b29829f7588df7a9d551a898a0a9d8836a4ce159d8419066","slc_30e6b14f71d50221e10a9f81c9961d7b1bd434e795a099c234d62e5e0a3cb963","slc_5e63242d968f0c9cda0ce4dfb20c12a59f5a32220922e4320a4c9b13846bdb9e","slc_7adebcfd25c946c69c395fce4393b26f2e04686d766a042537948cd373fa9cc3"],"source_ids":["src_383914975aaf5cbbbb09ab19317e0008"],"text":"AIP is organized into three layers: an identity layer (Ed25519 keypairs, DIDs, challenge-response), a trust layer (vouches, scopes, paths, revocation), and a communication layer (E2E encrypted messaging).","updated_at":"2026-09-14T05:10:26Z","updated_by_operation":"op_8e51539aaeea4b72ae26d08d8d7198f1"}
