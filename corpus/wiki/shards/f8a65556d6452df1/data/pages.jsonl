{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_087e28555c753195be5df8bd27fe3875f05dcd4debaa7e20d3f4ee1bc8c774d6"],"opposing_claim_ids":[],"text":"The book explicitly disclaims official status: it is reverse-engineering-based research and does not represent Anthropic's official documentation or positions."},{"claim_ids":["clm_6605f5458a680287f86491998a219d1f0474d1deccfba36fb67f1095c8d65b99"],"opposing_claim_ids":[],"text":"The repository intentionally tracks only files needed to publish the book to GitHub Pages; the English edition is a scaffolded preview while the Chinese edition is canonical."},{"claim_ids":["clm_cd71afbcb3deec8c95e4e59d0dabd8d819818183e0194c3bcfc008fa032cf803"],"opposing_claim_ids":[],"text":"The book targets engineers building AI coding products, agent frameworks, and tool-calling platforms who want to understand Claude Code's implementation details."},{"claim_ids":["clm_f7cca01e0c1bcb56006b8d6dc17cf8cf6d15811de0d5424c6c5680f10d414ba9"],"opposing_claim_ids":[],"text":"The repository publishes a Chinese technical book on Harness Engineering, analyzed from the publicly released Claude Code v2.1.88 package and its source-map reconstruction rather than official docs."},{"claim_ids":["clm_fed995223ea96b889c9e91ffb9df1ff3e2f56c990417d4965eb88759f5c39f9f"],"opposing_claim_ids":[],"text":"Local preview is done with 'mdbook build book' and 'mdbook serve book', serving by default at http://localhost:3000."}],"claim_ids":["clm_087e28555c753195be5df8bd27fe3875f05dcd4debaa7e20d3f4ee1bc8c774d6","clm_6605f5458a680287f86491998a219d1f0474d1deccfba36fb67f1095c8d65b99","clm_cd71afbcb3deec8c95e4e59d0dabd8d819818183e0194c3bcfc008fa032cf803","clm_f7cca01e0c1bcb56006b8d6dc17cf8cf6d15811de0d5424c6c5680f10d414ba9","clm_fed995223ea96b889c9e91ffb9df1ff3e2f56c990417d4965eb88759f5c39f9f"],"created_at":"2026-09-14T04:34:01Z","created_by_operation":"op_a95afc84d16542639370032b9ae6d21a","id":"pg_34254c8ea3a65c20bd4644d0904941e4","maturity":"draft","page_type":