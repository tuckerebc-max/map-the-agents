{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_119061ea0f4763c9cea4fa163be056e6a83588f3c301708c8ed2ee2b58cd79e0"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are told to fork the repo, create a feature branch, commit, push, and open a pull request."},{"claim_ids":["clm_35e950f9afd7a3484141c7ca7b8374763d19c6bae7ed298129c94dadf14f6728"],"opposing_claim_ids":[],"text":"The plugin exposes multiple ways to open items in Cursor: a command palette command ('Open in Cursor'), a right-click context menu on files or folders, and a sidebar Cursor icon for the current file."},{"claim_ids":["clm_3e2f52a60c42b7480135821c94a015ee51f6fc46ae2b61c43d6e8999667f11bb"],"opposing_claim_ids":[],"text":"The plugin requires Cursor to be installed and the Cursor executable to be available on the system PATH, with instructions given for adding it and restarting the computer."},{"claim_ids":["clm_781ad13695b1199e9bafb5cab288ba71ef05a117a16c92c7aa09548d7178c93f"],"opposing_claim_ids":[],"text":"The product is an Obsidian community plugin that bridges Obsidian and the Cursor AI code editor, letting users open notes and project folders directly in Cursor."},{"claim_ids":["clm_a58ff9b937617931a6c5a462942f6eef3dcd89b4aedf7335ecd2ab20d6040e14"],"opposing_claim_ids":[],"text":"Repository development practice: installation for end users is via Obsidian's Community Plugins browse-and-install flow after disabling Safe Mode."},{"claim_ids":["clm_bde56ffbb69d67dc13f27c2a3f9ac2a0601c418314d21c12ebfd524363522e61"],"opposing_claim_ids":[],"text":"The README states support for Windows and Apple systems; other platforms are not mentioned as supported."},{"claim_ids":["clm_e83ccc62327c2be62f83d45e58e2f187a28fdc459971986fd9b28fd450ad44ec"],"opposing_claim_ids":[],"text":"Plugin settings reportedly include a custom Cursor executable path, a choice between opening new windows or reusing existing ones, and a default project folder."}],"claim_ids":["clm_119061ea0f4