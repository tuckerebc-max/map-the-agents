81e","clm_c2e31087356a2932e37d1ebc9c7b8083d0a4b44e83d4364ee7e4c812a6b5d7a5","clm_e2adc14c99702f12f6f24596de61e3736c145656179f72308feb2603f287cf56","clm_f475384775a5a00165b86df217bd062deedd4a007e6fbbfc1b27739f182932b1","clm_fcf9822ea88a5abd24909640e137840d381bf64b809dacb21239fbe0c7f39009"],"created_at":"2026-09-14T04:04:38Z","created_by_operation":"op_91c2fa8210644eb483ae74b9aa55eda8","id":"pg_31da049010585d00a28d7b051457a29c","maturity":"draft","page_type":"entity","path":"pages/entities/landing-ai-ade-cli-7b051457a29c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"landing-ai/ade-cli","updated_at":"2026-09-14T04:04:38Z","updated_by_operation":"op_91c2fa8210644eb483ae74b9aa55eda8"}
