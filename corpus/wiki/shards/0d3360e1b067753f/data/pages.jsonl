{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3b4f40bfc68d6cbe7e9e80433c89580cfe6840845ee8c1f50bc726f5361838d9"],"opposing_claim_ids":[],"text":"The TypeScript conversion plugin provides a step-by-step playbook addressing UI5-specific migration challenges like the class system, sap.ui.define loader, and runtime-generated getters/setters."},{"claim_ids":["clm_4a5a9da267d38cb2d4bad0be9cd4c72691f9a8a2d4d7d58a3345c0321b9be4e8"],"opposing_claim_ids":[],"text":"The ui5-typescript-conversion plugin is installed with 'claude plugin install ui5-typescript-conversion@claude-plugins-official'."},{"claim_ids":["clm_7750d26c7e78dbf70875212a4767be27ed9b68e103c8ae466da01d2f6d4cd808"],"opposing_claim_ids":[],"text":"The changelog records added skills for the ui5 plugin covering accessibility, QUnit, Smart & MDC controls, tables, OPA5 guidelines, UI Integration Cards, and general UI5 guidelines."},{"claim_ids":["clm_a137df06aca6815ef8f1275fc2286eece18bf93679bc42446afe54cf6e9b2f6a"],"opposing_claim_ids":[],"text":"The ui5 plugin can be installed via 'claude plugin install ui5@claude-plugins-official' or the in-app '/plugin install ui5@claude-plugins-official' command."},{"claim_ids":["clm_a5209f299104933aec0a0702ea80c97af5b4fdc6d791b48de2b770324571f86a"],"opposing_claim_ids":[],"text":"The ui5 plugin is described as a wrapper around the UI5 MCP server, with possible future additions such as more skills."},{"claim_ids":["clm_ef6457b8044213fda2048a57ec7451c3c485226be0858eae67ac627e6d330940"],"opposing_claim_ids":[],"text":"The ui5-modernization plugin includes skills such as fix-cyclic-deps, fix-js-globals, fix-xml-globals, modernize-flp-sandbox, modernize-test-starter, and modernize-ui5-app."}],"claim_ids":["clm_3b4f40bfc68d6cbe7e9e80433c89580cfe6840845ee8c1f50bc726f5361838d9","clm_4a5a9da267d38cb2d4bad0be9cd4c72691f9a8a2d4d7d58a3345c0321b9be4e8","clm_7750d26c7e78dbf70875212a4767be27ed9b68e103c8ae466da01d2f6d4cd808","clm_a137df06aca6815ef8f1275fc2286eece18bf93679bc42446afe54cf6e9b2f6a","clm_a5209f299104933aec0a0702ea80c97af5b4fdc6d791b48de2b770324571f86a","clm_ef6457b8044213fda2048a57ec7451c3c485226be0858eae67ac627e6d330940"],"created_at":"2026-09-14T04:28:50Z","created_by_operation":"op_aab9ccfde408477693e4b391d2526cb1","id":"pg_1bb5cf0434a0588da01e9e6bdd2e4f29","maturity":"draft","page_type":"source","path":"pages/sources/ui5-plugins-coding-agents-changelog-md-4c3754ae5b66-9e6bdd2e4f29.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3cf65076002a51b09d06f32a259ed9c9"],"title":"UI5/plugins-coding-agents/CHANGELOG.md @ 4c3754ae5b66","updated_at":"2026-09-14T04:28:50Z","updated_by_operation":"op_aab9ccfde408477693e4b391d2526cb1"}
