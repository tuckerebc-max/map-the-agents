{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a0ecbb78afd35417b6e76252c23084651d223461b88c242e37daf64035ab9a84","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_ddc87fe4b967b62fe9b768cb59461628f79c2f8b6fee79fdccb9ee8f52072cd2"],"source_ids":["src_07338b95b48959f0b85c915869bf7cff"],"text":"The project positions itself around managing agents rather than creating them, emphasizing plans before execution, tracked deliverables, conflict prevention, and a single source of truth for team state.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
