{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b86f56d76785dd4533a77ac945c6ef48bfc9df226367060bf8b1e88ccd508516","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_0b94635bdfc08741c6e8eb83b19993ccc2d327888436093c435f8f3a4deca203","slc_9fbf3cecc6ce9613c73410a5b1b83a11a444a4d099cf26b1ccfe10156803ebb6","slc_da21199b9aa74cf131e272981c7c2374f0f51a4b33a0114ee288a0c65f3d8985","slc_df5541b179a029615f204812fe026b10e0d0115fa1c70573215cce9f6b3208d2"],"source_ids":["src_07338b95b48959f0b85c915869bf7cff","src_24a9aba2fdee5ba695632321b1a698bd"],"text":"Repository development practice: contributions are welcome under guidelines in CONTRIBUTING.md, and a code of conduct adapted from the Contributor Covenant applies to issues, pull requests, and discussions, with violations reportable to conduct@myteamhero.com.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d100b75e8a5618dad61497b6a184e564733b6b1251eca9e64ba7bc28790cdc47","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_1614aa56299f8f24fa9eb665410ba197a7db64b6b8c75d3dac2c860226ebdafa"],"source_ids":["src_f67ee848e07d5ac785ffd93fa77fcb30"],"text":"The task lifecycle uses statuses including planning, pending_approval, working, done, and closed, with simplified transition actions (Accept, Improve, Hold, Cancel) and a done-to-closed auto-lifecycle on a 2-day timer.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d4593cf1bb68cd89008d24ffa0939979c7976f354c712dd2d890ee6844488755","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_7ac196136be5379a8998232c4d6be411ce1ff6b4f7e7c5d80d0a933051bd81ff"],"source_ids":["src_07338b95b48959f0b85c915869bf7cff"],"text":"Tasks follow a plan, review, execute, and deliver lifecycle, and every file an agent will touch is declared upfront so agents do not overwrite each other's work.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
