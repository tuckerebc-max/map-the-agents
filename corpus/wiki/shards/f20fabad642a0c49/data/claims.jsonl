{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_12f3ed7c8a55fb41f385c9789a098368223e1040f5d341b3b3c16d337c0be9a4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_94c77448ddad6e570cf98facfbb7d2d8670cde3ebfc5de7e96c6f724c89a25dc"],"source_ids":["src_f67ee848e07d5ac785ffd93fa77fcb30"],"text":"The changelog documents autopilot scheduling with recurring and one-time timed tasks, smart model routing for cost-efficient execution, and dependency auto-triggering so tasks start when their dependencies complete.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_22757dbdc65ec7c526af68ee4406f21c91fe0ee02db4950f0799913436079911","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_c7e61dd4889934664546b1df26cb965438df17aa4dc04ca757900866677d3bf2","slc_cfdcb05d986bafddd9ad3f3df4472696f44470413a68207ab468b226ff3b1d64"],"source_ids":["src_07338b95b48959f0b85c915869bf7cff"],"text":"The project targets developers working with Claude Code who want structure around their agents, and it is a builder platform requiring comfort with CLI and Node.js.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3c21d5a18011a11c22414a065f4dffae4da7dd26c46c1223b10a1f700c0ead63","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_79c494952446cbfcdabe3cf36c42078fce7ea9ea860fce419b06c08b5177e836","slc_87c635aa41cef1383fee4bb666e54a5b51bd6f1a37b789da22c829b53e969d7b"],"source_ids":["src_07338b95b48959f0b85c915869bf7cff","src_f67ee848e07d5ac785ffd93fa77fcb30"],"text":"Each agent is documented to have persistent short- and long-term memory that carries across sessions.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3e7d4a05b3565367525b2c4769be0c67bb3b7538b958f961fd9f7aaa8183ee36","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_87c635aa41cef1383fee4bb666e54a5b51bd6f1a37b789da22c829b53e969d7b"],"source_ids":["src_07338b95b48959f0b85c915869bf7cff"],"text":"The platform includes a web dashboard for managing an agent team, a Command Center terminal for talking to an orchestrator agent, a task system with plans, versions, approvals and deliverable tracking, agent memory, a knowledge base, optional skills, and file-scope conflict prevention.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_47fa4abba9d1c0b515ef01cc90c62f319663f0fba29dffe859c952c2760bf3be","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_583861a6eccdd6a3d2a1ecd62279d879a7a2214865406e80850f71a4029c9942","slc_9725878a814d92cd272f531205a3c6d9827e432da30505453708d74195aa22a4"],"source_ids":["src_07338b95b48959f0b85c915869bf7cff"],"text":"Prerequisites are Node.js 18+ and the Claude CLI, described as the AI backbone powering the agents; the Claude CLI is installed globally via npm.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5b69c1c73c9e93cec290ab254119960f0455db58a746f5c53b211ecdd8c5f57c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_391bb350ce39e711d7e0d9270ff1cb56430d4dc14e8b91c0566710f7211402c3","slc_984f4d7bf65ff3ae6f927d10f806290ec7f4960f939bb5919481a69e5afecf66","slc_f98c0621f699f8738e45453fbce9d6004ce96a72e606569eca0de7fb3fd91722"],"source_ids":["src_07338b95b48959f0b85c915869bf7cff"],"text":"After launching via launch.bat on Windows or bash launch.sh on Mac/Linux, the dashboard is served at http://localhost:3777.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7dd718f1737cfa1fc13010b534ba5161f4e75ee5361229db968eeedd3b482d56","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"sagiyaacoby/teamhero@25466cdbfbcf snapshot d87a745d3ec5f54b","timeframe":null},"slice_ids":["slc_1614aa56299f8f24fa9eb665410ba197a7db64b6b8c75d3dac2c860226ebdafa","slc_87c635aa41cef1383fee4bb666e54a5b51bd6f1a37b789da22c829b53e969d7b"],"source_ids":["src_07338b95b48959f0b85c915869bf7cff","src_f67ee848e07d5ac785ffd93fa77fcb30"],"text":"Skills are optional integrations such as browser automation and GitHub; the changelog also mentions a skills UI separating curated from user-installed skills and a Vercel CLI skill in the catalog.","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
