88755"],"created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","id":"pg_79d92e8e7a345be2913a12d2c936d3cb","maturity":"draft","page_type":"entity","path":"pages/entities/sagiyaacoby-teamhero-12d2c936d3cb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"sagiyaacoby/teamhero","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_22757dbdc65ec7c526af68ee4406f21c91fe0ee02db4950f0799913436079911"],"opposing_claim_ids":[],"text":"The project targets developers working with Claude Code who want structure around their agents, and it is a builder platform requiring comfort with CLI and Node.js."},{"claim_ids":["clm_3c21d5a18011a11c22414a065f4dffae4da7dd26c46c1223b10a1f700c0ead63"],"opposing_claim_ids":[],"text":"Each agent is documented to have persistent short- and long-term memory that carries across sessions."},{"claim_ids":["clm_3e7d4a05b3565367525b2c4769be0c67bb3b7538b958f961fd9f7aaa8183ee36"],"opposing_claim_ids":[],"text":"The platform includes a web dashboard for managing an agent team, a Command Center terminal for talking to an orchestrator agent, a task system with plans, versions, approvals and deliverable tracking, agent memory, a knowledge base, optional skills, and file-scope conflict prevention."},{"claim_ids":["clm_47fa4abba9d1c0b515ef01cc90c62f319663f0fba29dffe859c952c2760bf3be"],"opposing_claim_ids":[],"text":"Prerequisites are Node.js 18+ and the Claude CLI, described as the AI backbone powering the agents; the Claude CLI is installed globally via npm."},{"claim_ids":["clm_5b69c1c73c9e93cec290ab254119960f0455db58a746f5c53b211ecdd8c5f57c"],"opposing_claim_ids":[],"text":"After launching via launch.bat on Windows or bash launch.sh on Mac/Linux, the dashboard is served at http://localhost:3777."},{"claim_ids":["clm_7dd718f1737cfa1fc13010b534ba5161f4e75ee5361229db968eeedd3b482d56"],"opposing_claim_ids":[],"text":"Skills are optional integrations such as browser automation and GitHub; the changelog also mentions a skills UI separating curated from user-installed skills and a Vercel CLI skill in the catalog."},{"claim_ids":["clm_8e8b297f66679588a73bc51e21c7144919f7b28e91cd81e7937c77d729284d89"],"opposing_claim_ids":[],"text":"The project is released under the MIT License, with TeamHero and Kapow noted as trademarks of Sagi Yaacoby."},{"claim_ids":["clm_a0ecbb78afd35417b6e76252c23084651d223461b88c242e37daf64035ab9a84"],"opposing_claim_ids":[],"text":"The project positions itself around managing agents rather than creating them, emphasizing plans before execution, tracked deliverables, conflict prevention, and a single source of truth for team state."},{"claim_ids":["clm_b86f56d76785dd4533a77ac945c6ef48bfc9df226367060bf8b1e88ccd508516"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are welcome under guidelines in CONTRIBUTING.md, and a code of conduct adapted from the Contributor Covenant applies to issues, pull requests, and discussions, with violations reportable to conduct@myteamhero.com."},{"claim_ids":["clm_d4593cf1bb68cd89008d24ffa0939979c7976f354c712dd2d890ee6844488755"],"opposing_claim_ids":[],"text":"Tasks follow a plan, review, execute, and deliver lifecycle, and every file an agent will touch is declared upfront so agents do not overwrite each other's work."}],"claim_ids":["clm_22757dbdc65ec7c526af68ee4406f21c91fe0ee02db4950f0799913436079911","clm_3c21d5a18011a11c22414a065f4dffae4da7dd26c46c1223b10a1f700c0ead63","clm_3e7d4a05b3565367525b2c4769be0c67bb3b7538b958f961fd9f7aaa8183ee36","clm_47fa4abba9d1c0b515ef01cc90c62f319663f0fba29dffe859c952c2760bf3be","clm_5b69c1c73c9e93cec290ab254119960f0455db58a746f5c53b211ecdd8c5f57c","clm_7dd718f1737cfa1fc13010b534ba5161f4e75ee5361229db968eeedd3b482d56","clm_8e8b297f66679588a73bc51e21c7144919f7b28e91cd81e7937c77d729284d89","clm_a0ecbb78afd35417b6e76252c23084651d223461b88c242e37daf64035ab9a84","clm_b86f56d76785dd4533a77ac945c6ef48bfc9df226367060bf8b1e88ccd508516","clm_d4593cf1bb68cd89008d24ffa0939979c7976f354c712dd2d890ee6844488755"],"created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","id":"pg_aee7c8f12f0254d89811ab8871b2eee5","maturity":"draft","page_type":"source","path":"pages/sources/sagiyaacoby-teamhero-readme-md-25466cdbfbcf-ab8871b2eee5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_07338b95b48959f0b85c915869bf7cff"],"title":"sagiyaacoby/TeamHero/README.md @ 25466cdbfbcf","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_12f3ed7c8a55fb41f385c9789a098368223e1040f5d341b3b3c16d337c0be9a4"],"opposing_claim_ids":[],"text":"The changelog documents autopilot scheduling with recurring and one-time timed tasks, smart model routing for cost-efficient execution, and dependency auto-triggering so tasks start when their dependencies complete."},{"claim_ids":["clm_3c21d5a18011a11c22414a065f4dffae4da7dd26c46c1223b10a1f700c0ead63"],"opposing_claim_ids":[],"text":"Each agent is documented to have persistent short- and long-term memory that carries across sessions."},{"claim_ids":["clm_7dd718f1737cfa1fc13010b534ba5161f4e75ee5361229db968eeedd3b482d56"],"opposing_claim_ids":[],"text":"Skills are optional integrations such as browser automation and GitHub; the changelog also mentions a skills UI separating curated from user-installed skills and a Vercel CLI skill in the catalog."},{"claim_ids":["clm_ae6003dcbe7bdd4155217d67e860761b5bdf928f817ffa4190aa48f1f4cbf052"],"opposing_claim_ids":[],"text":"Vendor libraries including xterm, marked, and qrcode are bundled to support CDN-free offline operation."},{"claim_ids":["clm_d100b75e8a5618dad61497b6a184e564733b6b1251eca9e64ba7bc28790cdc47"],"opposing_claim_ids":[],"text":"The task lifecycle uses statuses including planning, pending_approval, working, done, and closed, with simplified transition actions (Accept, Improve, Hold, Cancel) and a done-to-closed auto-lifecycle on a 2-day timer."}],"claim_ids":["clm_12f3ed7c8a55fb41f385c9789a098368223e1040f5d341b3b3c16d337c0be9a4","clm_3c21d5a18011a11c22414a065f4dffae4da7dd26c46c1223b10a1f700c0ead63","clm_7dd718f1737cfa1fc13010b534ba5161f4e75ee5361229db968eeedd3b482d56","clm_ae6003dcbe7bdd4155217d67e860761b5bdf928f817ffa4190aa48f1f4cbf052","clm_d100b75e8a5618dad61497b6a184e564733b6b1251eca9e64ba7bc28790cdc47"],"created_at":"2026-09-14T02:37:45Z","created_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466","id":"pg_e976b658a1b65d188bc1098d369a374b","maturity":"draft","page_type":"source","path":"pages/sources/sagiyaacoby-teamhero-changelog-md-25466cdbfbcf-098d369a374b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f67ee848e07d5ac785ffd93fa77fcb30"],"title":"sagiyaacoby/TeamHero/CHANGELOG.md @ 25466cdbfbcf","updated_at":"2026-09-14T02:37:45Z","updated_by_operation":"op_a9a1b2ff14b44d68ad246d7c69a8e466"}
