w_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"its-maestro-baby/maestro","updated_at":"2026-09-14T02:06:00Z","updated_by_operation":"op_79631db1d3164a16a5194ddd2ee731fb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1c0849298b95eed49532e84affd5feeb55920f7de74fe9cb490446d0f1f5d214"],"opposing_claim_ids":[],"text":"The app offers a dynamic 1x1 to 2x3 session grid, iTerm2-style split panes, real-time status indicators, and per-session mode selection among Claude Code, Gemini CLI, OpenAI Codex, or plain terminal."},{"claim_ids":["clm_248bb5f6ad6f2a74156a21a49b5099cd4b92f7574cb5ecc673ba3d95375c1a5c"],"opposing_claim_ids":[],"text":"Each session gets its own terminal with a full shell environment, a git worktree for code isolation, an assigned branch, and a port allocation for web development."},{"claim_ids":["clm_2d499e816f49acee5ced8448599a7e5cbb77964bccb6a79c9a23bff3c94ec308"],"opposing_claim_ids":[],"text":"A documented keyboard shortcut set covers session creation, pane splitting, terminal cycling, zoom, copy, and line navigation, with Cmd mapping to Ctrl on Windows/Linux."},{"claim_ids":["clm_342d88330415eee03074a448698d6dc81d70c77c9c35e4a2a2d256fc01dab58d"],"opposing_claim_ids":[],"text":"A built-in MCP server lets AI sessions report their state (idle, working, needs input, finished, error) via the maestro_status tool, with updates shown in the session grid."},{"claim_ids":["clm_4468a53a68ba69156f46f849f625e23c4f984ec33835da42f218dff2c388716b"],"opposing_claim_ids":[],"text":"A Rust ProcessManager manages sessions whose worktrees live under ~/.claude-maestro/worktrees/{repo}/{branch}, connecting to the MCP server over stdio."},{"claim_ids":["clm_805b92d6b1a65f991c5c74d2e381d6127d71790701899ae52df4459f4bfd9ea5"],"opposing_claim_ids":[],"text":"The stack comprises a Tauri 2.0/Rust backend, a React + TypeScript + Tailwind CSS frontend, xterm.js terminal emulation, a Rust MCP server, and native git CLI for git operations."},{"claim_ids":["clm_94013cf1de6ea65ce1a1ea4998857a8f98f02cf6cdb04f3e64058d9480a913ac"],"opposing_claim_ids":[],"text":"Maestro is a cross-platform desktop application for running 1-6 Claude Code (or other AI CLI) sessions simultaneously, each in its own isolated git worktree."}],"claim_ids":["clm_1c0849298b95eed49532e84affd5feeb55920f7de74fe9cb490446d0f1f5d214","clm_248bb5f6ad6f2a74156a21a49b5099cd4b92f7574cb5ecc673ba3d95375c1a5c","clm_2d499e816f49acee5ced8448599a7e5cbb77964bccb6a79c9a23bff3c94ec308","clm_342d88330415eee03074a448698d6dc81d70c77c9c35e4a2a2d256fc01dab58d","clm_4468a53a68ba69156f46f849f625e23c4f984ec33835da42f218dff2c388716b","clm_805b92d6b1a65f991c5c74d2e381d6127d71790701899ae52df4459f4bfd9ea5","clm_94013cf1de6ea65ce1a1ea4998857a8f98f02cf6cdb04f3e64058d9480a913ac"],"created_at":"2026-09-14T02:06:00Z","created_by_operation":"op_79631db1d3164a16a5194ddd2ee731fb","id":"pg_67bb1a7837a2579dbff44e69f41194e6","maturity":"draft","page_type":"source","path":"pages/sources/its-maestro-baby-maestro-readme-md-a10500d09983-4e69f41194e6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0b9bd27fba16534894a6cc76acec9616"],"title":"its-maestro-baby/maestro/README.md @ a10500d09983","updated_at":"2026-09-14T02:06:00Z","updated_by_operation":"op_79631db1d3164a16a5194ddd2ee731fb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_039bd1db609224cd2a16193080f49bd8d77b87d9aa9efb44dbbfd4d55a1fc7d8"],"opposing_claim_ids":[],"text":"Key frontend dependencies include @tauri-apps/api ^2.10.1, @xterm/xterm ^5.5.0, react ^18.3.0, zustand ^5.0.10, and tailwindcss ^3.4.0; the backend uses Tauri 2.0, tokio, serde, and DashMap."},{"claim_ids":["clm_26603713113acd85c431057d86988577713fe8d6e8ebfcff966d31b8076ffadf"],"opposing_claim_ids":[],"text":"Frontend state is organized into Zustand stores including useGitHubStore, useGitStore, useWorkspaceStore, useSessionStore, useMarketplaceStore, and useMcpStore."},{"claim_ids":["clm_f3e7c9bb07fec59fcbe24ebca9d4300675180b39d3ad6b9b222c822cef23db56"],"opposing_claim_ids":[],"text":"The Rust backend has command handlers for git, worktrees, GitHub, marketplace, MCP, sessions, terminals, updates, and usage, plus core modules for process, plugin, worktree, and session management."}],"claim_ids":["clm_039bd1db609224cd2a16193080f49bd8d77b87d9aa9efb44dbbfd4d55a1fc7d8","clm_26603713113acd85c431057d86988577713fe8d6e8ebfcff966d31b8076ffadf","clm_f3e7c9bb07fec59fcbe24ebca9d4300675180b39d3ad6b9b222c822cef23db56"],"created_at":"2026-09-14T02:06:00Z","created_by_operation":"op_79631db1d3164a16a5194ddd2ee731fb","id":"pg_7352b09220545efca75937acb1bb6b39","maturity":"draft","page_type":"source","path":"pages/sources/its-maestro-baby-maestro-architecture-overview-md-a10500d09983-37acb1bb6b39.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3e46076c523e52e5a1f9eb050b13b3dc"],"title":"its-maestro-baby/maestro/ARCHITECTURE-OVERVIEW.md @ a10500d09983","updated_at":"2026-09-14T02:06:00Z","updated_by_operation":"op_79631db1d3164a16a5194ddd2ee731fb"}
