{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_01b94b1f276274c9c36394941f7a9d94d691395711547e539b7e463df578f57c"],"opposing_claim_ids":[],"text":"Workspaces are isolated from each other, and accumulated work becomes documents forming a knowledge base; agents can read what they need from any node while working."},{"claim_ids":["clm_1bc4c70078b70f3b78e23c5235fee21d6ca7dd9ec41402f336ffcbc6fc99ac3a"],"opposing_claim_ids":[],"text":"The product exposes an Open API built on standard APIs with both SSE and WebSocket support, intended for integrating expert and task agents into external apps and workflows."},{"claim_ids":["clm_3f324e80b37ec3fa6a60809e5a0e4adb9ae75bd29af467e8c05baa8ae4f708d8"],"opposing_claim_ids":[],"text":"Documentation is hosted at yaoagents.com/docs with a community Discord, and the repository provides both English and Chinese READMEs."},{"claim_ids":["clm_49f0ab71a1f3f81fcff49b3fb2edbd2622123aeebd765d6b973e65d0a71babd2"],"opposing_claim_ids":[],"text":"Task agents can be connected to the user's own apps or shared with others."},{"claim_ids":["clm_5a01f3404d5900e523fa4e4a593a97332d47fc58775e9d160c56bff62ded7768"],"opposing_claim_ids":[],"text":"Yao Agents is described as a self-hosted platform holding all agents and workspaces in one place, accessible from desktop, mobile, browser, or API."},{"claim_ids":["clm_87ccd95a98174b9eb878a69532d3f09f6b25fd5c1310ca88293f37e4727f2ce8"],"opposing_claim_ids":[],"text":"Agents run on the user's own devices, with each added machine serving as another place for agents to work, all managed from one place."},{"claim_ids":["clm_a5d4f6cd7612c739ddf5c24bf15921ef2bf1fe44d709f24160797da85a73fc6c"],"opposing_claim_ids":[],"text":"The product ships as a desktop app (Yao Desktop) and an Android client in beta, distributed as an APK version 0.6.37."},{"claim_ids":["clm_accb2c4b486a4c2a85741e15cc271cf259717eefb714d4094dbb7a93803b1c25"],"opposing_claim_ids":[],"text":"The README states that a DeepSeek Harness is integrated and usable directly in the desktop app, Android, or browser across devices."},{"claim_ids":["clm_bdc2007be1d065f4648b3cab7e13af43cdb7b3ffcd59fb531db14ff040f7a36a"],"opposing_claim_ids":[],"text":"Conversational requests become tasks on a task board, and continued conversation and running are said to grow the task into a purpose-built agent."}],"claim_ids":["clm_01b94b1f276274c9c36394941f7a9d94d691395711547e539b7e463df578f57c","clm_1bc4c70078b70f3b78e23c5235fee21d6ca7dd9ec41402f336ffcbc6fc99ac3a","clm_3f324e80b37ec3fa6a60809e5a0e4adb9ae75bd29af467e8c05baa8ae4f708d8","clm_49f0ab71a1f3f81fcff49b3fb2edbd2622123aeebd765d6b973e65d0a71babd2","clm_5a01f3404d5900e523fa4e4a593a97332d47fc58775e9d160c56bff62ded7768","clm_87ccd95a98174b9eb878a69532d3f09f6b25fd5c1310ca88293f37e4727f2ce8","clm_a5d4f6cd7612c739ddf5c24bf15921ef2bf1fe44d709f24160797da85a73fc6c","clm_accb2c4b486a4c2a85741e15cc271cf259717eefb714d4094dbb7a93803b1c25","clm_bdc2007be1d065f4648b3cab7e13af43cdb7b3ffcd59fb531db14ff040f7a36a"],"created_at":"2026-09-14T03:24:54Z","created_by_operation":"op_be90d5385321424d9d46ef461d9d798b","id":"pg_9046d23ccf265585af6869df2c72b5fe","maturity":"draft","page_type":"source","path":"pages/sources/yaoapp-yao-readme-md-5774ce8de5a4-69df2c72b5fe.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4436737c56c6518faab32a78deb8f836"],"title":"YaoApp/yao/README.md @ 5774ce8de5a4","updated_at":"2026-09-14T03:24:54Z","updated_by_operation":"op_be90d5385321424d9d46ef461d9d798b"}
