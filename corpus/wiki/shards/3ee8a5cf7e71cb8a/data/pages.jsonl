{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_238efcf62959fe6a02f80350898e78bb05baac66149716872c4a09057fcd5e9c"],"opposing_claim_ids":[],"text":"JaxARC environment integration exposes four ARC datasets (Mini, AGI1, AGI2, ConceptARC), three action modes (point, bbox, mask), and domain metrics like best_similarity and solved via an ExtendedMetrics wrapper."}],"claim_ids":["clm_238efcf62959fe6a02f80350898e78bb05baac66149716872c4a09057fcd5e9c"],"created_at":"2026-09-14T03:49:05Z","created_by_operation":"op_13e68b81831c469e9684c751cb14099f","id":"pg_f1a50a1344215b03b2135acde05753cd","maturity":"draft","page_type":"source","path":"pages/sources/edantoledo-stoix-docs-envs-jaxarc-md-8fff19c94a47-5acde05753cd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6a524f0af5dc5d31b18f635c5f63b20d"],"title":"EdanToledo/Stoix/docs/envs/jaxarc.md @ 8fff19c94a47","updated_at":"2026-09-14T03:49:05Z","updated_by_operation":"op_13e68b81831c469e9684c751cb14099f"}
