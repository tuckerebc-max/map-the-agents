{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_10436225c91522b6d72002002493ca0b7f21522a857462ad0d3393858840b1af","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_3ef0d6e73acb2d5401385900d2451d9cf0ab97ab538c9dddd0293421d3841196","slc_6cbc71862e2061df0d8b165d7da56475fb27f154553eec9bbd7cd088dd36b8ba","slc_97648c02ddf3daa422654839a6d9780bd97c5d88bd847b9b4eaec0675deee83e","slc_bcce7da5e8a403c83183f0802d8374a97757f2b2f8f2724af90bcbbe7cd98645"],"source_ids":["src_c5748391262a51cab022cc676bb13071"],"text":"Repository development practice: the repo is an npm-workspaces monorepo of 8 packages using Node.js 22, TypeScript ~5.7, jest/vitest tests, eslint+prettier, and a solution-style tsc build that must run before cdk synth/deploy.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_28ab3c3b9ed2b584111e11bf16067878253ec91a71376953c2b1f665435124f1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_792595c8718312c282777520a25d5c506d075055368cf1146ede10e5123c8eb9","slc_edda1960de33fd2a4eccaba29a1ab26e9a65eb88adfff138bd4d65c0cfe83aeb"],"source_ids":["src_e776f7df96ca5c0cbd883c327e3affee"],"text":"The platform supports extensible tools including command execution, web search, image generation, and external service integration, configurable per agent.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_42dfca3119df3e3a7650a56d8d88b7857d6bb675ea435fcafae1f16b1cf797b7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_4219475965b82c722d1e081a9c0014e590a2d7597717a33c35a409a89a47c877","slc_641a2494608767335a545045ae51b3c1f3a4de2bc3eedf65ea64e9ee97eb9edf"],"source_ids":["src_e776f7df96ca5c0cbd883c327e3affee"],"text":"The default model is Claude Opus 4.8; Claude Fable 5 is selectable but requires the account's Bedrock data retention mode set to provider_data_share in the invocation region.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_431feadeb20e4f2b25dce59860e57404d1451dc2bd6695ab70ca0aa28d5a070c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_6cbc71862e2061df0d8b165d7da56475fb27f154553eec9bbd7cd088dd36b8ba","slc_ab4b009f47ba8004a0f81e72153e8a9d9030c481aaf8a8badd506b87d9022f33","slc_abc40628244cd32a69f868ea4ac0d4e10232525941c85c2b6665f5f81bf5d840"],"source_ids":["src_c5748391262a51cab022cc676bb13071","src_e776f7df96ca5c0cbd883c327e3affee"],"text":"The agent runs as a Docker container on AgentCore Runtime using the Strands Agents SDK (TypeScript), implemented as an Express server on port 8080.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5986ecd89c16493d8bc68bb0c106e42de1443bb90f505dfc01611c80dacc020c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_7ff60f6a3e4b3812f5029fc7e1a3a24c6e3ddbc6a3f05b039fed2159540739e1"],"source_ids":["src_e776f7df96ca5c0cbd883c327e3affee"],"text":"The stack includes a React SPA frontend on CloudFront+S3, Cognito JWT auth, an Express.js API on Lambda/API Gateway, DynamoDB+S3 storage, AppSync Events WebSocket, and EventBridge scheduling.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_61f99d2df2455d24385ff0fbbeeaa1665bbf1e6b721be2ffb5e7bb5dd9e7fe30","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_7ff60f6a3e4b3812f5029fc7e1a3a24c6e3ddbc6a3f05b039fed2159540739e1","slc_ab4b009f47ba8004a0f81e72153e8a9d9030c481aaf8a8badd506b87d9022f33","slc_abc40628244cd32a69f868ea4ac0d4e10232525941c85c2b6665f5f81bf5d840"],"source_ids":["src_c5748391262a51cab022cc676bb13071","src_e776f7df96ca5c0cbd883c327e3affee"],"text":"Real-time streaming is achieved via AppSync Events (WebSocket), and a session-stream-handler Lambda relays DynamoDB Streams to AppSync.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_91cad1974df75f0a8c4de6e2c6b9eb2ef8f2be234e48399a93e83c36fac7d400","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_7863c8891cc01b3e4fd83ae6a90dde84f73f85185d9dfe2905f35c773c77bed4"],"source_ids":["src_e776f7df96ca5c0cbd883c327e3affee"],"text":"User requests flow from the React frontend through Cognito authentication to AgentCore Runtime, which orchestrates agent execution with tool integration via AgentCore Gateway.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d558f25f2d8e013a943d6284825366c7a68e4814f60db513a61a9c8c29e6816b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_abc40628244cd32a69f868ea4ac0d4e10232525941c85c2b6665f5f81bf5d840"],"source_ids":["src_e776f7df96ca5c0cbd883c327e3affee"],"text":"Agents use AgentCore Memory with both short-term memory (session history) for conversational context and long-term persistent memory enabled.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d8558b387ac5122e79bd85a00f5cede471de6fa7ae87854d432322dda0f1da74","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_60607704983b3b978726c83235394de169877ecec52708ee5ba8299941769a30","slc_8a34174a34c77b27e467780f4a4649905fecd633b8c539205fb9a05d965fa8ca"],"source_ids":["src_e776f7df96ca5c0cbd883c327e3affee"],"text":"The product is a multi-agent platform for creating, customizing, and sharing AI agents across an organization, built on Amazon Bedrock AgentCore.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ed6f090d67ca6416f7b2c85b208d34f5e45f7a752e7c4733383a34600b6be7e8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_4a25863db352e74d71de92f9fa507774179e4f811481981954d63b5d08da1578","slc_cc32a65bec1efc9b8760c7ff736a5d7ea534f2d247d8869a5e5bd961f836ae8b"],"source_ids":["src_e776f7df96ca5c0cbd883c327e3affee"],"text":"The application is explicitly not designed for production use; it is a proof-of-concept not intended to support more than a few hundred users.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
{"access":"public","created_at":"2026-09-14T03:05:41Z","created_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ff261e7a169eac0533978874ee0637e9d83797ec57b9a6b4343afaa2282743c8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"aws-samples/sample-multi-agent-orchestration-chat-on-agentcore@b48bcb476d08 snapshot c3c4e8e8d4cbc12e","timeframe":null},"slice_ids":["slc_ab4b009f47ba8004a0f81e72153e8a9d9030c481aaf8a8badd506b87d9022f33"],"source_ids":["src_c5748391262a51cab022cc676bb13071"],"text":"Repository development practice: CI runs secret scanning via detect-secrets through ASH, with test files excluded by globs in .ash/ash.yaml and documented pragma/ignore_paths handling for false positives.","updated_at":"2026-09-14T03:05:41Z","updated_by_operation":"op_5df5b50a8dc649eeb41a4e873dcd55b7"}
