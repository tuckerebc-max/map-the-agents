{"access":"public","created_at":"2026-09-14T03:50:29Z","created_by_operation":"op_f4e4d7a389ea4c16ab474da00f345f50","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bb336a938368bd6895b58328cb2c807cb3ad8be0d1ee054491cce29e60003d29","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"fareedkhan-dev/multi-agent-training-grpo@48758c5e67e7 snapshot 57f32112a4bb2240","timeframe":null},"slice_ids":["slc_8b0185fd6ea3afcb11a645a39d1699fdbdf5f51490490d88f65c133513c42ce7","slc_9209432e94c2ff7fe5e12dd0f329bb219bf22297d1c6f4d91fb730660b12b954","slc_e145e83158b42f38019f3c5f95b278be86f1f53a68f620ba0e8ca8d75b6f550d"],"source_ids":["src_4bfa8cc503ac5736bf465d93c8d86ac8"],"text":"GRPO is described as group-based: the agent attempts the same query multiple times, and strategies are reinforced relative to the group average rather than graded in isolation.","updated_at":"2026-09-14T03:50:29Z","updated_by_operation":"op_f4e4d7a389ea4c16ab474da00f345f50"}
