{"access":"public","created_at":"2026-09-14T01:39:41Z","created_by_operation":"op_a067f423887d4e82be9d896000d8faf8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e84ccf9c333cc2fd9e51fd973c59808460c778a86ea5c652c65a1f9f9d0081fe","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"cfal/garcon@42a5322794a9 snapshot 76fa39f541038aba","timeframe":null},"slice_ids":["slc_08c514c38c101ddc8f68e9308cf19df16e8e1846bff84cbd5a9973b30ad201cb"],"source_ids":["src_d065bd85d7505ba6802d09640821a8d4"],"text":"The repository is organized into a SvelteKit/Svelte 5 frontend (web/), a Bun server handling chat lifecycle, providers, Git, auth, and notifications (server/), agent-specific runtimes (server-agents/), shared contracts (common/), and black-box integration tests.","updated_at":"2026-09-14T01:39:41Z","updated_by_operation":"op_a067f423887d4e82be9d896000d8faf8"}
{"access":"public","created_at":"2026-09-14T01:39:41Z","created_by_operation":"op_a067f423887d4e82be9d896000d8faf8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f1bde8ef6a719c03ac9426124604535b8752b557e99fda47e06b319acc6d4e02","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"cfal/garcon@42a5322794a9 snapshot 76fa39f541038aba","timeframe":null},"slice_ids":["slc_cef3b824b7444cc7aa0cef932b3ed7c482098d13692ee19f3a54c1b134312b16"],"source_ids":["src_d065bd85d7505ba6802d09640821a8d4"],"text":"Chats can exchange provenance-labeled messages, launch delegated child chats, and receive their final results while keeping parentage auditable; the workspace tiles up to four resizable windows and tracks lineage in Chat Map.","updated_at":"2026-09-14T01:39:41Z","updated_by_operation":"op_a067f423887d4e82be9d896000d8faf8"}
