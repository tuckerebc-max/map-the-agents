{"access":"public","created_at":"2026-09-14T01:39:41Z","created_by_operation":"op_a067f423887d4e82be9d896000d8faf8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_33b52fd12413901b72a930d99ec0b3a6fb790c9f23501134f7fb474d98d3f506","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"cfal/garcon@42a5322794a9 snapshot 76fa39f541038aba","timeframe":null},"slice_ids":["slc_3e009c4021b4ffa8add13fb7c5919f4a481aead7aa22de48ea3df9c708e541c9","slc_3f9be0d70e639096bfd409647fb96688796c5c9b573994a220ac488b3a1562f4","slc_64179a2c86902ba4e6b8affc0f9ac1e6a39663d48b7ddd2db6780a4c88ebc614","slc_9e2fc24a676c04aeed66ada43559d5a9a13b30ea67a38381f640aec6d2f5ce79"],"source_ids":["src_d065bd85d7505ba6802d09640821a8d4"],"text":"A companion garcon-skills package exposes the control plane to skill-aware agents via skills like garcon-captain, garcon-agent, garcon-task, garcon-message, garcon-schedule, and garcon-amp, installed with a link.sh script.","updated_at":"2026-09-14T01:39:41Z","updated_by_operation":"op_a067f423887d4e82be9d896000d8faf8"}
