c0eebed782","maturity":"draft","page_type":"entity","path":"pages/entities/sipyourdrink-ltd-bernstein-f3c0eebed782.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"sipyourdrink-ltd/bernstein","updated_at":"2026-09-14T04:21:54Z","updated_by_operation":"op_daba580b51694f77bb109a2ca40ec175"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1f1dc01c0820dba305326130bbf571201bdaadab1e6d52f74cd6bec1699931f9"],"opposing_claim_ids":[],"text":"The Task Server is a FastAPI REST application on port 8052 exposing /tasks, /status, and /metrics, with routes split across roughly 70 modules in core/routes/ and state checkpointed to .sdd/runtime/tasks.jsonl."},{"claim_ids":["clm_30baedf91f92c1f02efc97178cb0e217e8876fe0cc41365e146b423d57b5bc55"],"opposing_claim_ids":[],"text":"A LineageSpine provides an always-on Merkle+HMAC provenance chain; every adapter artifact write routes through LineageSpine.record at a single write boundary, appending hash-chained rows to .sdd/lineage/<run_id>/spine.jsonl."},{"claim_ids":["clm_587f4e0bee99f1d4a569b68b5914f1ab5d931735e118a675b35b9b3bbdc01b6c"],"opposing_claim_ids":[],"text":"A janitor verifies task completion via concrete signals (files exist, tests pass, content matches) and moves tasks to done/ or failed/ without trusting agent claims; a separate LLM reviewer runs afterward and can push corrections back into the queue."},{"claim_ids":["clm_5d1e66f623075314a51fcf11be130f3b3b8a31bfd9796e1654645e763070de4f"],"opposing_claim_ids":[],"text":"All state is stored as files under .sdd/ with no databases or hidden memory, chosen for inspectability, recoverability, auditability, and git-friendliness; runtime state under .sdd/runtime/ is ephemeral."},{"claim_ids":["clm_86720398fff7f344e1d1b38cfcd51aed69ca2788453df3828eba6e18d87da653"],"opposing_claim_ids":[],"text":"The orchestrator is deterministic Python with no model in the coordination loop; only one planning LLM call happens up front, and the same plan replays to a byte-identical task graph."},{"claim_ids":["clm_f6f971e5b4d98701fbd3d303301d5dde08acb83da7ac3bfefdce9a5f55675b4c"],"opposing_claim_ids":[],"text":"Pluggable sandbox backends implement a SandboxBackend/SandboxSession protocol; first-party options are worktree (default), docker, e2b Firecracker microVMs, and modal serverless containers, with third parties registering via an entry-point group."}],"claim_ids":["clm_1f1dc01c0820dba305326130bbf571201bdaadab1e6d52f74cd6bec1699931f9","clm_30baedf91f92c1f02efc97178cb0e217e8876fe0cc41365e146b423d57b5bc55","clm_587f4e0bee99f1d4a569b68b5914f1ab5d931735e118a675b35b9b3bbdc01b6c","clm_5d1e66f623075314a51fcf11be130f3b3b8a31bfd9796e1654645e763070de4f","clm_86720398fff7f344e1d1b38cfcd51aed69ca2788453df3828eba6e18d87da653","clm_f6f971e5b4d98701fbd3d303301d5dde08acb83da7ac3bfefdce9a5f55675b4c"],"created_at":"2026-09-14T04:21:54Z","created_by_operation":"op_daba580b51694f77bb109a2ca40ec175","id":"pg_35defd83afe85bd5b82c1d8a36c10376","maturity":"draft","page_type":"source","path":"pages/sources/sipyourdrink-ltd-bernstein-docs-architecture-architecture-md-ce5c5217c-1d8a36c10376.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d9afc24621755158bfc599654af39cac"],"title":"sipyourdrink-ltd/bernstein/docs/architecture/ARCHITECTURE.md @ ce5c5217c1dc","updated_at":"2026-09-14T04:21:54Z","updated_by_operation":"op_daba580b51694f77bb109a2ca40ec175"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_13ac6865f2dc9682ee16f009703530addada0796f1539cf0d1828b475a359a66"],"opposing_claim_ids":[],"text":"The project targets Python 3.12+ per its README badge, is published on PyPI and GHCR, and is licensed Apache-2.0."},{"claim_ids":["clm_24b48cfaf202ca21249154cfe5d376d482f770b9e5743a3908602581d21a96f9"],"opposing_claim_ids":[],"text":"Runs are declared in YAML manifests defining phases, roles, node dependencies, conditional edges, and retry policies; workflow resume validates the manifest digest at start and refuses a changed spec."},{"claim_ids":["clm_86720398fff7f344e1d1b38cfcd51aed69ca2788453df3828eba6e18d87da653"],"opposing_claim_ids":[],"text":"The orchestrator is deterministic Python with no model in the coordination loop; only one planning LLM call happens up front, and the same plan replays to a byte-identical task graph."},{"claim_ids":["clm_9a4dd64a7a3eecb1a0aed8ed6d90bf6af73529b3ec4bb9f4f62d3ec8b92780cb"],"opposing_claim_ids":[],"text":"Volunteer compute tasks are constrained by a volunteer.json manifest declaring sandbox backend, network allowlist, and wall-clock/memory ceilings; a donor's own limits can only narrow, never widen, the declared containment."},{"claim_ids":["clm_aacb4e5277f4c603c2fb561322cfad94c777f5c72965b6ee1da0bcf98c4c310d"],"opposing_claim_ids":[],"text":"The project is beta, solo-maintained, and under active development; minor versions may change interfaces, and users are advised to pin versions. The volunteer one-command runner and the hosted api.bernstein.run service are not yet available."},{"claim_ids":["clm_bfc7ebce5ce6e4415806c3018a6a5963ee577342abc517038d699d809e1e5a1e"],"opposing_claim_ids":[],"text":"The CLI surface includes bernstein init, -g, live, run plan.yaml, stop, workflow run/resume, replay/lineage/audit verification commands, and bernstein verify receipt for offline receipt checking."},{"claim_ids":["clm_ec6127f7c96f95933f033be31f1faa794485ef1a6cda73a9abe39dbfc7e10088"],"opposing_claim_ids":[],"text":"bernstein bench run <suite> --reliability k (also spelled bernstein eval) runs each task k times under fixed coordination and reports a pass^k floor alongside pass@1, sealing the result in a signed receipt that can be re-verified offline."}],"claim_ids":["clm_13ac6865f2dc9682ee16f009703530addada0796f1539cf0d1828b475a359a66","clm_24b48cfaf202ca21249154cfe5d376d482f770b9e5743a3908602581d21a96f9","clm_86720398fff7f344e1d1b38cfcd51aed69ca2788453df3828eba6e18d87da653","clm_9a4dd64a7a3eecb1a0aed8ed6d90bf6af73529b3ec4bb9f4f62d3ec8b92780cb","clm_aacb4e5277f4c603c2fb561322cfad94c777f5c72965b6ee1da0bcf98c4c310d","clm_bfc7ebce5ce6e4415806c3018a6a5963ee577342abc517038d699d809e1e5a1e","clm_ec6127f7c96f95933f033be31f1faa794485ef1a6cda73a9abe39dbfc7e10088"],"created_at":"2026-09-14T04:21:54Z","created_by_operation":"op_daba580b51694f77bb109a2ca40ec175","id":"pg_7f2dedbe1e155662bce42843e4f8b293","maturity":"draft","page_type":"source","path":"pages/sources/sipyourdrink-ltd-bernstein-readme-md-ce5c5217c1dc-2843e4f8b293.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d129993ae9a751d88bad1c6df6a96bb0"],"title":"sipyourdrink-ltd/bernstein/README.md @ ce5c5217c1dc","updated_at":"2026-09-14T04:21:54Z","updated_by_operation":"op_daba580b51694f77bb109a2ca40ec175"}
