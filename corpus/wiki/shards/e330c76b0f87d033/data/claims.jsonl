{"access":"public","created_at":"2026-09-14T04:12:52Z","created_by_operation":"op_3d7aa9fb36424be4ae3cb9fc32a86a85","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_69cb42c1483cd3487995e0efe9bc10b74be112b42a1b396d4e0c857600b4473d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"nicobailon/pi-interactive-shell@eedb89a9e461 snapshot 8fd72b37ae0f9648","timeframe":null},"slice_ids":["slc_4258e3732f40402ff188a1e8efde54d56dd9bdc529ed2d259dac5a11db1efe94","slc_d28b43364c8e1b09d55ce6fec78ec49329b198555b139a520b3bb67470950773","slc_f1c2b3916a00d3ae975e1b5268705b543311620a7d963072b10c5cb6485a374a"],"source_ids":["src_08d8758f0c235db7bc1cdefc998ce549","src_cc69fba9f22550818922d12ae768d48d"],"text":"New sessions use Pi's Bash resolver rather than ambient $SHELL/COMSPEC; on Windows it discovers Git Bash, and legacy WSL stdin-only bash is rejected for interactive PTYs.","updated_at":"2026-09-14T04:12:52Z","updated_by_operation":"op_3d7aa9fb36424be4ae3cb9fc32a86a85"}
{"access":"public","created_at":"2026-09-14T04:12:52Z","created_by_operation":"op_3d7aa9fb36424be4ae3cb9fc32a86a85","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7367b0209f2dcfe6aeb3e1271efbfcc7170930c9c64079dca0effb754b4aa6dd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"nicobailon/pi-interactive-shell@eedb89a9e461 snapshot 8fd72b37ae0f9648","timeframe":null},"slice_ids":["slc_8e4a1e2c6fd72817ecfb21050f4efb77f234c6ea3fde96e0a6087c9289b6957c"],"source_ids":["src_08d8758f0c235db7bc1cdefc998ce549"],"text":"The tool supports four modes: interactive (default), hands-free, dispatch, and monitor, all returning immediately without the agent waiting.","updated_at":"2026-09-14T04:12:52Z","updated_by_operation":"op_3d7aa9fb36424be4ae3cb9fc32a86a85"}
