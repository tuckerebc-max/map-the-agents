{"access":"public","created_at":"2026-09-14T04:12:52Z","created_by_operation":"op_3d7aa9fb36424be4ae3cb9fc32a86a85","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5bd135e3ba8c5868b922e22de54e5891075bbc9d278e993dabe543b05f0a2f59","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"nicobailon/pi-interactive-shell@eedb89a9e461 snapshot 8fd72b37ae0f9648","timeframe":null},"slice_ids":["slc_11cd50776faae2ba7ce6673598c3a342f79dba49e9a16d95c5be5e05ab13a659","slc_325964ab8869c5075f1c106c3cb1083d92379cc76dba43b88ee6877d9e894e9d","slc_594aab877fd0e5f8155f07724af67ff5c9ccc505f64859aaad8ae0f975c184c0","slc_7432394804b9bcae4f535a0a8a6b47a43d99049b089344431bc61317ca289c31","slc_cc045ee2e7b8272f9ebe31421b5f4d223d4aa11122412eacaa500f5dbf3a029b"],"source_ids":["src_08d8758f0c235db7bc1cdefc998ce549"],"text":"Sessions return a stable sessionId; the agent can send input with submit, named keys, bracketed paste, or raw hex bytes, and query status/output.","updated_at":"2026-09-14T04:12:52Z","updated_by_operation":"op_3d7aa9fb36424be4ae3cb9fc32a86a85"}
