{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_22bd14b15df8dbd9ebc8176eeff6373582dca5b86d068bd7e400e26849491547"],"opposing_claim_ids":[],"text":"The backend exposes REST endpoints for uploading and listing session attachments (POST/GET /api/uploads/{session_id}), artifact-event polling, per-artifact download with meta/stream modes, and a whole-session zip download, with WebSocket mirrors emitting artifact_created events."}],"claim_ids":["clm_22bd14b15df8dbd9ebc8176eeff6373582dca5b86d068bd7e400e26849491547"],"created_at":"2026-09-14T02:26:10Z","created_by_operation":"op_42f8b51d9c4943029c62e10d087e8171","id":"pg_c8875b5ce7d75570b42ab2cd00fd9d51","maturity":"draft","page_type":"source","path":"pages/sources/openbmb-chatdev-docs-user-guide-en-attachments-md-4fb2db0ea903-b2cd00fd9d51.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3b39b0d1596e5140812e4c2dc62fa26e"],"title":"OpenBMB/ChatDev/docs/user_guide/en/attachments.md @ 4fb2db0ea903","updated_at":"2026-09-14T02:26:10Z","updated_by_operation":"op_42f8b51d9c4943029c62e10d087e8171"}
