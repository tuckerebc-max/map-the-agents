{"access":"public","created_at":"2026-09-14T02:01:03Z","created_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_882cd4d50867a2d64e0bcd1ae50a6765a1db83508846c15337bfea581ac7da53","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"feiskyer/koder@55f553326039 snapshot 46fb8c41ea09079f","timeframe":null},"slice_ids":["slc_5072da9d9029788d26df485ea98e7a25184616ed076d7bd8277c0f3283612d9f","slc_8cd772c9168b3f85dce9e084e4fa91d65f3c59ee7169d94a7e891e89d67f3af7","slc_9f265f11996d748bffe26687b33215dacaf0de31b224208044f7706e24658b69","slc_f7aca6cc23241fe1fb28917d3729018a837c1fe3b5d43e2f2c1f62af96db2140"],"source_ids":["src_644c2f113f7c534da6521882167388c1"],"text":"Skills are local instruction bundles loaded on demand from .koder/skills/ or ~/.koder/skills/ as SKILL.md files with frontmatter including name, description, and allowed_tools; plugins can contribute skills, commands, MCP servers, channels, and dependencies.","updated_at":"2026-09-14T02:01:03Z","updated_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338"}
{"access":"public","created_at":"2026-09-14T02:01:03Z","created_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9b91732c095465e78c07c8bfc395c9576fccb738fddb1e5a0f64e9f67db71edd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"feiskyer/koder@55f553326039 snapshot 46fb8c41ea09079f","timeframe":null},"slice_ids":["slc_2cfca4839a6928735301006d9fba6bd49def7e02da669ef6d0878cc043e145fc","slc_5f46ebcd219dc24f38d19b74314a2234a0d14b6c169d80d6eb44a846b6eb4925"],"source_ids":["src_f4840b9d60c7513ea0881a81a6dfcf63"],"text":"An optional local managed policy file ~/.koder/managed-settings.json can define high-priority hook settings and sandbox policy keys (enabled, mode, backend, autoAllowBashIfSandboxed); no hosted managed-settings service is fetched.","updated_at":"2026-09-14T02:01:03Z","updated_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338"}
{"access":"public","created_at":"2026-09-14T02:01:03Z","created_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d010d5caed9876e94fa8ebafbe7a96df4c2c6c188c37f76c536eb4268dd038a4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"feiskyer/koder@55f553326039 snapshot 46fb8c41ea09079f","timeframe":null},"slice_ids":["slc_3ce07c1a2afa5014a2b76fe98a6b344381db2fa6f5d9a5bf598bf57903f4e340","slc_8acbc56701dd6d15ef821dfa5e58e4fb439c580dfb38bc850da02eca94a70c45","slc_99ddb36b340ce3c9176d2cbce407f4cc76d5141b286832c35e23cf146571c5f8"],"source_ids":["src_644c2f113f7c534da6521882167388c1"],"text":"Runtime state is stored locally: SQLite sessions and transcripts in ~/.koder/koder.db, goals, memories, settings, OAuth tokens under ~/.koder/tokens/, and team state under ~/.koder/ and project .koder/ paths; sessions are not uploaded to a Koder-hosted service.","updated_at":"2026-09-14T02:01:03Z","updated_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338"}
