{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:01:03Z","created_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338","id":"pg_359b346069ad520b8e3a57655a11e1e0","maturity":"draft","page_type":"source","path":"pages/sources/feiskyer-koder-docs-sandbox-md-55f553326039-57655a11e1e0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_25b013d564ba535d8ff80c44aa257226"],"title":"feiskyer/koder/docs/sandbox.md @ 55f553326039","updated_at":"2026-09-14T02:01:03Z","updated_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2387c9da7ef7a5914910e8d0c01e00943c2cbc4a3aa2ae4493cf9949d38d593a"],"opposing_claim_ids":[],"text":"Koder supports background subagents via /fork and task_delegate with isolated default context, plus local teams via /peers with mailbox routing, task records, and team memory; teammates run in-process (default) or in tmux panes."},{"claim_ids":["clm_d2ca4f0502aeaff82bcc5cbed1c85b86a3ce0b5b710717b7df24e017e49142c7"],"opposing_claim_ids":[],"text":"Agents with isolation: worktree frontmatter run in their own git worktree under .koder/worktrees/; empty worktrees are auto-removed and ones with uncommitted work are kept, with SubagentStart/Stop and WorktreeCreate/Remove hook events."}],"claim_ids":["clm_2387c9da7ef7a5914910e8d0c01e00943c2cbc4a3aa2ae4493cf9949d38d593a","clm_d2ca4f0502aeaff82bcc5cbed1c85b86a3ce0b5b710717b7df24e017e49142c7"],"created_at":"2026-09-14T02:01:03Z","created_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338","id":"pg_4074c402fda15b8e9070987d653e02ce","maturity":"draft","page_type":"source","path":"pages/sources/feiskyer-koder-docs-agents-and-teams-md-55f553326039-987d653e02ce.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8228fcd4f2dd5d8da7dbe4c6e915c127"],"title":"feiskyer/koder/docs/agents-and-teams.md @ 55f553326039","updated_at":"2026-09-14T02:01:03Z","updated_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4d8bc7825855389170daecb49ea3b693b282ab114288602de290d30e2eb73f6e"],"opposing_claim_ids":[],"text":"Permission rules live in settings files under permissions.allow/deny as tool_name(content) strings with deny winning over allow; KODER_ENFORCE_TOOL_APPROVAL controls approval-required tool calls, failing closed when non-interactive by default."},{"claim_ids":["clm_9b91732c095465e78c07c8bfc395c9576fccb738fddb1e5a0f64e9f67db71edd"],"opposing_claim_ids":[],"text":"An optional local managed policy file ~/.koder/managed-settings.json can define high-priority hook settings and sandbox policy keys (enabled, mode, backend, autoAllowBashIfSandboxed); no hosted managed-settings service is fetched."}],"claim_ids":["clm_4d8bc7825855389170daecb49ea3b693b282ab114288602de290d30e2eb73f6e","clm_9b91732c095465e78c07c8bfc395c9576fccb738fddb1e5a0f64e9f67db71edd"],"created_at":"2026-09-14T02:01:03Z","created_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338","id":"pg_59b9a6cdc9dc5370a812cc68f0cc91cc","maturity":"draft","page_type":"source","path":"pages/sources/feiskyer-koder-docs-configuration-md-55f553326039-cc68f0cc91cc.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f4840b9d60c7513ea0881a81a6dfcf63"],"title":"feiskyer/koder/docs/configuration.md @ 55f553326039","updated_at":"2026-09-14T02:01:03Z","updated_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_754f80e4ec207d0d08592b539a3bbf32f4c8dd0b973f521d37500b769909f038"],"opposing_claim_ids":[],"text":"Repository development practice: the generated command reference is regenerated and verified by maintainers via scripts/tmux_feature_scenarios.py --check, optionally with --strict-acceptance; this is doc-verification tooling, not a scored agent benchmark."},{"claim_ids":["clm_7d26ccba856793d4d1f0e75f5dee36f70760ccd5fcc514be5072965339712970"],"opposing_claim_ids":[],"text":"The TUI exposes a slash-command registry (79 runtime commands per the generated reference) including /status, /model, /permissions, /diff, /review, /goal, /loop, /agents, /fork, /peers, /skills, /mcp, and /sandbox."}],"claim_ids":["clm_754f80e4ec207d0d08592b539a3bbf32f4c8dd0b973f521d37500b769909f038","clm_7d26ccba856793d4d1f0e75f5dee36f70760ccd5fcc514be5072965339712970"],"created_at":"2026-09-14T02:01:03Z","created_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338","id":"pg_5d04a8e64a5f5075961f603f5181bb05","maturity":"draft","page_type":"source","path":"pages/sources/feiskyer-koder-docs-commands-md-55f553326039-603f5181bb05.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8d8c3dd892e35bcbb2524e58226a2c21"],"title":"feiskyer/koder/docs/commands.md @ 55f553326039","updated_at":"2026-09-14T02:01:03Z","updated_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:01:03Z","created_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338","id":"pg_efa79ec82ed852a796f6dbb8ed398f5b","maturity":"draft","page_type":"source","path":"pages/sources/feiskyer-koder-docs-workflows-md-55f553326039-dbb8ed398f5b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_909e2d858850592982de02e2890253b1"],"title":"feiskyer/koder/docs/workflows.md @ 55f553326039","updated_at":"2026-09-14T02:01:03Z","updated_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4d8bc7825855389170daecb49ea3b693b282ab114288602de290d30e2eb73f6e"],"opposing_claim_ids":[],"text":"Permission rules live in settings files under permissions.allow/deny as tool_name(content) strings with deny winning over allow; KODER_ENFORCE_TOOL_APPROVAL controls approval-required tool calls, failing closed when non-interactive by default."},{"claim_ids":["clm_56ad9bfb2a1dcc719d9de3d5a1d8c981547f4671413a0115e068193860cd0db2"],"opposing_claim_ids":[],"text":"Koder is an experimental, open-source terminal AI coding assistant in Python (3.10+), MIT-licensed, in alpha status, combining a streaming TUI, persistent sessions, goals, scheduled loops, skills, MCP, sandbox-aware permissions, and multi-agent workflows."},{"claim_ids":["clm_7a82cba2f97ded2812781d3f25c70c0cea832429ec658504a877456530160630"],"opposing_claim_ids":[],"text":"The CLI supports interactive TUI mode, one-shot prompts (koder \"...\"), script-friendly --print output, named sessions via -s, and --resume/--continue for resuming prior work."},{"claim_ids":["clm_7d26ccba856793d4d1f0e75f5dee36f70760ccd5fcc514be5072965339712970"],"opposing_claim_ids":[],"text":"The TUI exposes a slash-command registry (79 runtime commands per the generated reference) including /status, /model, /permissions, /diff, /review, /goal, /loop, /agents, /fork, /peers, /skills, /mcp, and /sandbox."},{"claim_ids":["clm_7f720e9d62c2316f1468d04f2b8b01ae522168dba020dcfbc93e44038b09d912"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork, create a feature branch, make focused changes with tests, and open PRs; the repo uses uv for setup, black/ruff for formatting and linting, and pytest for tests (uv run pytest)."},{"claim_ids":["clm_882cd4d50867a2d64e0bcd1ae50a6765a1db83508846c15337bfea581ac7da53"],"opposing_claim_ids":[],"text":"Skills are local instruction bundles loaded on demand from .koder/skills/ or ~/.koder/skills/ as SKILL.md files with frontmatter including name, description, and allowed_tools; plugins can contribute skills, commands, MCP servers, channels, and dependencies."},{"claim_ids":["clm_d010d5caed9876e94fa8ebafbe7a96df4c2c6c188c37f76c536eb4268dd038a4"],"opposing_claim_ids":[],"text":"Runtime state is stored locally: SQLite sessions and transcripts in ~/.koder/koder.db, goals, memories, settings, OAuth tokens under ~/.koder/tokens/, and team state under ~/.koder/ and project .koder/ paths; sessions are not uploaded to a Koder-hosted service."}],"claim_ids":["clm_4d8bc7825855389170daecb49ea3b693b282ab114288602de290d30e2eb73f6e","clm_56ad9bfb2a1dcc719d9de3d5a1d8c981547f4671413a0115e068193860cd0db2","clm_7a82cba2f97ded2812781d3f25c70c0cea832429ec658504a877456530160630","clm_7d26ccba856793d4d1f0e75f5dee36f70760ccd5fcc514be5072965339712970","clm_7f720e9d62c2316f1468d04f2b8b01ae522168dba020dcfbc93e44038b09d912","clm_882cd4d50867a2d64e0bcd1ae50a6765a1db83508846c15337bfea581ac7da53","clm_d010d5caed9876e94fa8ebafbe7a96df4c2c6c188c37f76c536eb4268dd038a4"],"created_at":"2026-09-14T02:01:03Z","created_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338","id":"pg_f2f50cededa85d408b418c742d026c19","maturity":"draft","page_type":"source","path":"pages/sources/feiskyer-koder-readme-md-55f553326039-8c742d026c19.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_644c2f113f7c534da6521882167388c1"],"title":"feiskyer/koder/README.md @ 55f553326039","updated_at":"2026-09-14T02:01:03Z","updated_by_operation":"op_ea3a1f81dc4e4599b6e9f48af30f3338"}
