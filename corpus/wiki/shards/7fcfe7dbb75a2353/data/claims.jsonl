{"access":"public","created_at":"2026-09-14T03:19:45Z","created_by_operation":"op_8d4401d8b3644dac8cca4642992bb6a8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0fee14fdb77b10f2cae1af975bfbc5526b6f69cab61b4f81827abbc807df066c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"timvw/tmux-assistant-resurrect@4d740923614a snapshot 819817bffcc019b3","timeframe":null},"slice_ids":["slc_24c8bb55eacdb2878d90c19a58154054fa1e1fd04e0afad4d8ab968bee6dfe78","slc_2522f73558eecea80d6a8184c8b076ede83e6fa48470c3d28f933ea180dd4043","slc_6a218ac76d4ddf810af3019e659bf120dd870bc9ec99518c1200fce77dd36b25","slc_ecc3fc80e0455ba213ebf54d4ae3b98bddcf7f4514e1074e03758068db9cc764"],"source_ids":["src_83420083763d561d8bfa6086401cb304"],"text":"A Docker benchmark matrix measures save-hook performance, producing CSV and Markdown summaries in test-results/ and running on every push/PR in GitHub Actions with published step summaries and artifacts.","updated_at":"2026-09-14T03:19:45Z","updated_by_operation":"op_8d4401d8b3644dac8cca4642992bb6a8"}
{"access":"public","created_at":"2026-09-14T03:19:45Z","created_by_operation":"op_8d4401d8b3644dac8cca4642992bb6a8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_11b73566a7f2715ef5d53706c983c00895b8f8c168dec5279eefc64dc41827fd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"timvw/tmux-assistant-resurrect@4d740923614a snapshot 819817bffcc019b3","timeframe":null},"slice_ids":["slc_046581a8ea47aa676f9d58e2f086c33a994539077f5fd86ed7b206e4f0114a70","slc_346c53e602887bcde7f1af9789a41ab10f1718a8ceb55e61f95496a706e7c267","slc_669cb9fe5b68094e655a2e47380f3e63accbe23f586faa7b46e88e0773807b55"],"source_ids":["src_83420083763d561d8bfa6086401cb304"],"text":"Session-less commands such as 'claude agents' are only relaunched if the user explicitly vouches the exact canonical command in a plain-text voucher file; restore reads the current voucher, never the sidecar value, and missing vouchers leave panes as bare shells.","updated_at":"2026-09-14T03:19:45Z","updated_by_operation":"op_8d4401d8b3644dac8cca4642992bb6a8"}
