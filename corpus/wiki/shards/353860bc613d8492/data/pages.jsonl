{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_627a2a8ef85d6de427eeba0cb35bf6e2164fc753a18c3b43b02b00e481c57cc3"],"opposing_claim_ids":[],"text":"SSH port 22 is blocked to prevent proxy-bypassing tunnels, and the container's system git config rewrites SSH GitHub URLs to HTTPS; the image ships Git 2.50.1 with worktree.useRelativePaths=true."}],"claim_ids":["clm_627a2a8ef85d6de427eeba0cb35bf6e2164fc753a18c3b43b02b00e481c57cc3"],"created_at":"2026-09-14T04:08:39Z","created_by_operation":"op_84e7f777387f4e07b68325bf069db430","id":"pg_b8b10213000250c29e6bb0c30ed6d564","maturity":"draft","page_type":"source","path":"pages/sources/mattolson-agent-sandbox-docs-git-md-5df0b4bc6c57-b0c30ed6d564.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_75b12db71e5a50f982b3a4a5aceb354c"],"title":"mattolson/agent-sandbox/docs/git.md @ 5df0b4bc6c57","updated_at":"2026-09-14T04:08:39Z","updated_by_operation":"op_84e7f777387f4e07b68325bf069db430"}
