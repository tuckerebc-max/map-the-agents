{"access":"public","created_at":"2026-09-14T03:32:04Z","created_by_operation":"op_ac281f8a929d436eb3baad045bd795c9","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ef50337cb48de0fa54c2697b5b03cfcee4379b43ddfbd01899da3cb3a22d9485","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"agentmd/agent.md@e86e5c8b57d5 snapshot d9bd0b2eecce1b16","timeframe":null},"slice_ids":["slc_7a6844e7b32304eff24b4a6f4d530cce7f406245a02d5fdc30279bc148c187f5","slc_b8fd108d6a7e1cab613c2f183f6b2836d103177b7d05d3eb12f94589abe3e3f3"],"source_ids":["src_f322e22946775c708d663f0f3ce14dea"],"text":"Implementations should support a hierarchy of AGENT.md files: root-level for general guidance, subdirectory files for subsystems, and a user-global file at ~/.config/AGENT.md.","updated_at":"2026-09-14T03:32:04Z","updated_by_operation":"op_ac281f8a929d436eb3baad045bd795c9"}
