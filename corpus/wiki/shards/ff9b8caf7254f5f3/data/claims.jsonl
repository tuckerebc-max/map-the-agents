{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2082704fcac7ad0b1684e0868dd3273b36da797da4d0880a7caded6e1ced4fe2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_0c69b0ff195008283d83f548e6e198135ffdd82395ec8a364c30576fe87ca982","slc_2518cdba7b59d46abf3d3e95b08708c17aafa0af718ceacb64862524f626164b","slc_3b1fdec798cdc9a8ec37d6416c0e94c14a778be9ffdb5cce0c1d9d62c992c16e","slc_894aeaba0df95b41598dc3a8265d775cd782bb7e0d9e797846859886017372ab","slc_89783708a38afedf97673ac8363c73daea726db7c283d9ff6d6fef5def34d740","slc_cfa42cce071fbdbcdb21f508675ac7116b42c5fb0537e4e74744c14b3dfd95cc"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"The generator emits a constructor taking an HttpClient parameter, and the generated method builds route, query, and header dictionaries before delegating to HttpClientHelper.SendAsync.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_304fb050a1c5157ae6855b48ca14c512fb94e64a3a0222f1ab46cb05f33d901a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_394244cfa44a00e357347e12440ec36fd1b1560e36ec8a2fbc55a60317e7d9fb","slc_744c2502bf296564d728ebc1fb14a8806b77b0ad58d13760cd7cdd87bb87014b","slc_9662f96fddec328db05810cd2968941e6c44acd019fb66507bfc823aaa2ad4de"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"If the user defines their own HttpClient field/property or a parameterless method returning HttpClient, the generator will use that instead of injecting via constructor.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_47d345402434dc7e9afa6b4eeefbc05dc2b9af148658a56d189f1d3bfd7f60dc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_2e84aa362ec9a99fe130f839e81af6b67b588e682bd2de120a7cc0eeb973252e","slc_5006a545ab0e0f96304d7592a9c0973c15a479753f7ec7d1bc4f911f197a4e30","slc_555e2daa563607f3c282c697fac82232ea7daa7bd0ef1c10bdd6c4d979faf4f6","slc_68dfaf5642743bf76d05acafe76002640170ea20d0051ded956e985e42cd3752","slc_89783708a38afedf97673ac8363c73daea726db7c283d9ff6d6fef5def34d740"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"The package targets .NET 5 console apps and is installed via the HttpClientGenerator NuGet package; generated code relies on HttpClientGenerator.Shared helpers and System.Text.Json serialization attributes.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4a4491cd845c62b1d2f98860ea5f7b28ae3eda59e758a161ee5c17258813e5ab","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_dc9923feb6f6e1176ba79a08bcdc6cdbcd1ee75ec27b874454be987dfc69f384"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"The tool uses the Roslyn C# source generator feature to write boilerplate HttpClient code on behalf of the developer.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_57d947abd23d4c31c5edd3633f9650edf8dde944dc0c2045380a69990c3e3bda","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_858973a425e7ef9b33ef62bb162d1a6a7f6bc4155c754313c407535d99f2f6e1"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"Generated code is produced in-memory at build time and never written to disk, so it needs no source-control tracking.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.5,"id":"clm_5c5fbd0bc953a26b6aec7f2bd6e3ddcb7645257fe3bae051739cab4edfec1230","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=inference; facet=design-choices","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_68dfaf5642743bf76d05acafe76002640170ea20d0051ded956e985e42cd3752","slc_cfa42cce071fbdbcdb21f508675ac7116b42c5fb0537e4e74744c14b3dfd95cc"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"The tool appears to support route parameters by substituting method arguments into the attribute's path template, as shown by the id route and dictionary usage.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_80149ea18ecfd4bc42896614332984f8b60681b9ff13dc5f9c33ee67657b6d0e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_9cc1db0d082b64d8270d74314ef258dc2a806344640d5ad203b3e867c7ceb5e4"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"The README strongly recommends using IHttpClientFactory to resolve HttpClient instances rather than manual instantiation.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_99c1f787e911def18f47be0cab3b3f742ace2fa8b6102071d58649eb559d2c0d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_254335514002728f4e78dd9bb5c5a1674672e40b89c5d926dfe4be522ac55856","slc_fc9f0ae33a614b75147da695f5734f3c3f76bbd8a939400e80d1610ed3a65755"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"The design philosophy is that no boilerplate or auto-generated code should be written, tracked in the repository, or regenerated manually when HTTP contracts change.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
