{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b1337f2071efa93a672eebdb588d140bab7f081f9e6148fc8d84e56da3ff0e8b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_182bf5046d1bada047724b5b6986241c1bd8c3794c5905af6e0d20ffa8130a8e","slc_68dfaf5642743bf76d05acafe76002640170ea20d0051ded956e985e42cd3752"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"Users declare partial classes with partial methods decorated by attributes such as HttpGet containing route templates like \"todos/{id}\"; the generator implements those methods.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
{"access":"public","created_at":"2026-09-14T04:00:20Z","created_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cbeeeb77440fe920478a2afb85a2f0b101b880a0f5a7cf81db577e1bd216e14a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"jalalx/httpclientcodegenerator@96f70bf67dbf snapshot ca06fc6ab6a97d6b","timeframe":null},"slice_ids":["slc_fc9f0ae33a614b75147da695f5734f3c3f76bbd8a939400e80d1610ed3a65755"],"source_ids":["src_7a83efe701cc5d508eed4a5db1a6606a"],"text":"The library claims no runtime dependency on third-party code, since generation happens at compile time within the consumer's project.","updated_at":"2026-09-14T04:00:20Z","updated_by_operation":"op_4b1d152f73974960a48f7e9d1e0390b0"}
