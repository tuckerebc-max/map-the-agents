{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_97b65571e0a43b62007d14db24bf4efe2de8432d59c674d4fd10addef21a9a36"],"opposing_claim_ids":[],"text":"Repository development practice: English locale files are the source of truth, other locales must mirror their key structure with automatic English fallback, and a CI check warns on missing keys; contributions fall under a CLA granting Dyad Tech, Inc. copyright and patent licenses."},{"claim_ids":["clm_9b3c91818d60f5530bbde12d7e4b1ad5c8a88965c585a1bc5edbd93204c5e575"],"opposing_claim_ids":[],"text":"The product includes agent built-in tool permission settings with per-tool options: Ask, Always allow, and Never allow."},{"claim_ids":["clm_fdcfbd7d59c5b1635f2773858dceaf4b5e18246abde4a3e1d7adf1f499c4986b"],"opposing_claim_ids":[],"text":"The i18n design specifies react-i18next and i18next (installed via npm) for translations with bundled locale JSON and no HTTP backend, and notes date-fns as an existing dependency for locale-aware date formatting."}],"claim_ids":["clm_97b65571e0a43b62007d14db24bf4efe2de8432d59c674d4fd10addef21a9a36","clm_9b3c91818d60f5530bbde12d7e4b1ad5c8a88965c585a1bc5edbd93204c5e575","clm_fdcfbd7d59c5b1635f2773858dceaf4b5e18246abde4a3e1d7adf1f499c4986b"],"created_at":"2026-09-14T01:47:29Z","created_by_operation":"op_4a8727fb3d4b402c9a62f82ea905a2b7","id":"pg_b65f085ba64650a7bfa8e287b971bef9","maturity":"draft","page_type":"source","path":"pages/sources/dyad-sh-dyad-docs-i18n-md-0c8403662504-e287b971bef9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6086510952ea55a9bf328ec9f50cae91"],"title":"dyad-sh/dyad/docs/i18n.md @ 0c8403662504","updated_at":"2026-09-14T01:47:29Z","updated_by_operation":"op_4a8727fb3d4b402c9a62f82ea905a2b7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_e82e778498dbe870ef3a7075d7f2118b79cbc920ccc1990e88bb611d4908286a"],"opposing_claim_ids":[],"text":"Dyad is a local, open-source AI app builder where users describe an app in plain language and the AI generates code with a live preview on their machine, with local-first operation as the core differentiator."}],"claim_ids":["clm_e82e778498dbe870ef3a7075d7f2118b79cbc920ccc1990e88bb611d4908286a"],"created_at":"2026-09-14T01:47:29Z","created_by_operation":"op_4a8727fb3d4b402c9a62f82ea905a2b7","id":"pg_c44d6f6f45af57f1821d26d0644529b5","maturity":"draft","page_type":"source","path":"pages/sources/dyad-sh-dyad-readme-md-0c8403662504-26d0644529b5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9a5d244828145a4b93279988a67db069"],"title":"dyad-sh/dyad/README.md @ 0c8403662504","updated_at":"2026-09-14T01:47:29Z","updated_by_operation":"op_4a8727fb3d4b402c9a62f82ea905a2b7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4c65b4db85feb487fadaf1cf896b9e78c5694531131908bb1ee4bfa6eec7913f"],"opposing_claim_ids":[],"text":"By default each LLM request includes the entire codebase plus a system prompt instructing XML-like responses; Smart Context uses smaller models to filter important files, and agentic iterative search is avoided mainly for cost reasons."},{"claim_ids":["clm_6c09f7f3268f9571d5ef067bd4b16aa0b7d99a7dda9b97b0f7b95ea7a8bde254"],"opposing_claim_ids":[],"text":"Dyad historically simulated tool calling with custom XML-like tags instead of models' formal tool calling, citing the ability to batch many calls and evidence that JSON code output hurts quality; a newer agent architecture moves toward standard tool calling."},{"claim_ids":["clm_7a4359e0ce5debf9d1744e4fa427e19066036f4b785f2750d248c7595fe1f42c"],"opposing_claim_ids":[],"text":"The LLM responds with <dyad-*> tags (e.g. <dyad-write path=...>) that a specialized Markdown parser renders in the UI, and a response processor in the main process applies after user approval—writing or deleting files, adding NPM packages, etc."},{"claim_ids":["clm_b09bc830f2a70cc6465620b593cf964c2e0fa59edf489ad8e23e7a38504202b2"],"opposing_claim_ids":[],"text":"Dyad is an Electron app with a React renderer process (sandboxed) and a privileged Node.js main process that accesses the filesystem, communicating via IPC."},{"claim_ids":["clm_b0e4cd46aefc75a2605ffd866daf5a42f1aa0da8abfd4652d0eddd991cae5599"],"opposing_claim_ids":[],"text":"Dyad deliberately keeps a simple agentic loop—usually a single AI request, with optional auto-fix of TypeScript compiler errors—to keep costs low compared to more agentic tools."}],"claim_ids":["clm_4c65b4db85feb487fadaf1cf896b9e78c5694531131908bb1ee4bfa6eec7913f","clm_6c09f7f3268f9571d5ef067bd4b16aa0b7d99a7dda9b97b0f7b95ea7a8bde254","clm_7a4359e0ce5debf9d1744e4fa427e19066036f4b785f2750d248c7595fe1f42c","clm_b09bc830f2a70cc6465620b593cf964c2e0fa59edf489ad8e23e7a38504202b2","clm_b0e4cd46aefc75a2605ffd866daf5a42f1aa0da8abfd4652d0eddd991cae5599"],"created_at":"2026-09-14T01:47:29Z","created_by_operation":"op_4a8727fb3d4b402c9a62f82ea905a2b7","id":"pg_f7917516603557c582f432e690ab82d6","maturity":"draft","page_type":"source","path":"pages/sources/dyad-sh-dyad-docs-architecture-md-0c8403662504-32e690ab82d6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_52a90da7cbd75fea9519d0578ce94f4e"],"title":"dyad-sh/dyad/docs/architecture.md @ 0c8403662504","updated_at":"2026-09-14T01:47:29Z","updated_by_operation":"op_4a8727fb3d4b402c9a62f82ea905a2b7"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9229067de4508db47853798c2b748aa1d4e0659b732b217895fe52767ae25398"],"opposing_claim_ids":[],"text":"The primary users are non-technical builders with no coding background running Dyad locally on Mac or Windows; a secondary audience brings their own API keys and local models."},{"claim_ids":["clm_e82e778498dbe870ef3a7075d7f2118b79cbc920ccc1990e88bb611d4908286a"],"opposing_claim_ids":[],"text":"Dyad is a local, open-source AI app builder where users describe an app in plain language and the AI generates code with a live preview on their machine, with local-first operation as the core differentiator."}],"claim_ids":["clm_9229067de4508db47853798c2b748aa1d4e0659b732b217895fe52767ae25398","clm_e82e778498dbe870ef3a7075d7f2118b79cbc920ccc1990e88bb611d4908286a"],"created_at":"2026-09-14T01:47:29Z","created_by_operation":"op_4a8727fb3d4b402c9a62f82ea905a2b7","id":"pg_ff77890612005d3e82b17ad4472966f5","maturity":"draft","page_type":"source","path":"pages/sources/dyad-sh-dyad-product-md-0c8403662504-7ad4472966f5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_36b1ce03dad55f99a65722d832fa42f5"],"title":"dyad-sh/dyad/PRODUCT.md @ 0c8403662504","updated_at":"2026-09-14T01:47:29Z","updated_by_operation":"op_4a8727fb3d4b402c9a62f82ea905a2b7"}
