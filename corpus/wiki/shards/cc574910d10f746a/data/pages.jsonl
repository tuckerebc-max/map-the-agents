{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1ca5741422a9c1f936c97c7b3e088e66872d4c3cd2f40c66124dbec5a9fa9d74"],"opposing_claim_ids":[],"text":"Repository development practice: all development work must target the 'development' branch as the PR base, with 'main' updated only by merging development for releases."},{"claim_ids":["clm_5653095da1cd3c97d1873114bcc1cbf651a3d199ec00d8f30b0d0902097bc1a8"],"opposing_claim_ids":[],"text":"Repository development practice: contributors must never use the em dash character (U+2014) in output, comments, commit messages, or documentation."},{"claim_ids":["clm_b8ba4d054c7a780d4da3229d783cde6335d46d21647d85b25782b7e266f13525"],"opposing_claim_ids":[],"text":"Repository development practice: merge conflicts must be resolved file-by-file without blanket 'ours/theirs' strategies or deleting untouched development files, then verified with 'dotnet build src/Ivy.Tendril/Ivy.Tendril.slnx'."}],"claim_ids":["clm_1ca5741422a9c1f936c97c7b3e088e66872d4c3cd2f40c66124dbec5a9fa9d74","clm_5653095da1cd3c97d1873114bcc1cbf651a3d199ec00d8f30b0d0902097bc1a8","clm_b8ba4d054c7a780d4da3229d783cde6335d46d21647d85b25782b7e266f13525"],"created_at":"2026-09-14T02:05:51Z","created_by_operation":"op_19526f8d187e4322b15718f3647610fb","id":"pg_4cdfefc8f282549fa2cda980f45c29ce","maturity":"draft","page_type":"source","path":"pages/sources/ivy-interactive-ivy-tendril-agents-md-3c17eb4573b3-a980f45c29ce.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_538c8d5610c950f58bde172eda7413c5"],"title":"Ivy-Interactive/Ivy-Tendril/AGENTS.md @ 3c17eb4573b3","updated_at":"2026-09-14T02:05:51Z","updated_by_operation":"op_19526f8d187e4322b15718f3647610fb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_09c5c2f8bdb4a80d3e9f42572920679f4dda52e0bfd6e9a80d1395ef1e8775d1"],"opposing_claim_ids":[],"text":"Official Tendril engineering and debugging skills can be installed with 'npx skills add ivy-interactive/ivy-tendril', optionally targeting a specific skill or agent such as github-copilot or cursor."},{"claim_ids":["clm_0bb494bd6a68b6f8ca0813be09b8f9ee5a3383f5299678fa2a38a30f9f55ad75"],"opposing_claim_ids":[],"text":"The product runs agents in isolated git worktrees so the main branch stays clean until changes are reviewed, approved, and merged."},{"claim_ids":["clm_1eab3878d743e942695d9b8fb1ceac1e88844a72afebb582c02d1cd9ab0cb512"],"opposing_claim_ids":[],"text":"The review feature lets users inspect diffs and approve agent changes with automated verification gates."},{"claim_ids":["clm_370b8a129d9eadc207a787e6be9d0c4e73e412120a6d3a1024bac35b08b35936"],"opposing_claim_ids":[],"text":"The app includes built-in Whisper voice dictation for prompts and drag-and-drop attachment of text files, logs, or documents."},{"claim_ids":["clm_3b6bb1e1b0ae88b5d7f36e43217cb0bad2646eee6b6662658bc9a5cbd7995a81"],"opposing_claim_ids":[],"text":"Tendril works with any CLI agent that runs in a terminal, naming Claude Code, Codex, GitHub Copilot, Gemini, and OpenCode as examples."},{"claim_ids":["clm_55ab9ae2bb32dd957c5347aa88b26834fa28d9c0ef8bb7cb35aa7f729c18bc79"],"opposing_claim_ids":[],"text":"GitHub Issues or jam.dev bug reports can be ingested via webhooks, converting markdown plans into active jobs automatically."},{"claim_ids":["clm_648ac6698be2ac3e9e1657a24713f2851a92cb3050b02dd5bd78b042ef9ae5d6"],"opposing_claim_ids":[],"text":"Users can annotate plan drafts inline to automatically update plans with revised agent goals."},{"claim_ids":["clm_741863640740d061443bddee8d5b1062717bbb90059bf5d0ce484acfbab0ade3"],"opposing_claim_ids":[],"text":"Tendril positions itself as a developer tool for the agentic era, described as replacing the IDE when AI agents write most of the code."},{"claim_ids":["clm_7b619f7c29fae38bfaedd91ded997b1072895de7b01625647669ef8917e59655"],"opposing_claim_ids":[],"text":"Tendril can expose its server via Cloudflare Quick Tunnels so agent runs can be monitored and steered remotely."},{"claim_ids":["clm_a9f67df364557528557b570a1404f489f46f5424b8edbe0a840f577236587bda"],"opposing_claim_ids":[],"text":"Skills can also be installed as plugins for Claude Code, Codex, Gemini CLI, and Antigravity CLI, or copied into tool-specific skills directories."},{"claim_ids":["clm_c6b16b8b214a3fc22af021c847d8c935314b7c52c4d8ea37e08eb7398ad30114"],"opposing_claim_ids":[],"text":"The CLI offers a desktop launch via 'tendril' and a headless web-server mode via 'tendril --web'."},{"claim_ids":["clm_da4619d7627010f6c9c378317bbfc28d7a5bedd171d51aa0438c5865466e9dfa"],"opposing_claim_ids":[],"text":"Standalone desktop installers (.pkg, .AppImage, .exe) are published on GitHub Releases, with curl/powershell install scripts for macOS/Linux and Windows."},{"claim_ids":["clm_f4b3f64dc4b0f2992d1bcd5d91eb9cfe6b0d1e09258dbeb06f7f06c90c440189"],"opposing_claim_ids":[],"text":"Tendril is source-available under the Functional Source License (FSL-1.1-ALv2)."}],"claim_ids":["clm_09c5c2f8bdb4a80d3e9f42572920679f4dda52e0bfd6e9a80d1395ef1e8775d1","clm_0bb494bd6a68b6f8ca0813be09b8f9ee5a3383f5299678fa2a38a30f9f55ad75","clm_1eab3878d743e942695d9b8fb1ceac1e88844a72afebb582c02d1cd9ab0cb512","clm_370b8a129d9eadc207a787e6be9d0c4e73e412120a6d3a1024bac35b08b35936","clm_3b6bb1e1b0ae88b5d7f36e43217cb0bad2646eee6b6662658bc9a5cbd7995a81","clm_55ab9ae2bb32dd957c5347aa88b26834fa28d9c0ef8bb7cb35aa7f729c18bc79","clm_648ac6698be2ac3e9e1657a24713f2851a92cb3050b02dd5bd78b042ef9ae5d6","clm_741863640740d061443bddee8d5b1062717bbb90059bf5d0ce484acfbab0ade3","clm_7b619f7c29fae38bfaedd91ded997b1072895de7b01625647669ef8917e59655","clm_a9f67df364557528557b570a1404f489f46f5424b8edbe0a840f577236587bda","clm_c6b16b8b214a3fc22af021c8