{"access":"public","created_at":"2026-09-14T03:34:16Z","created_by_operation":"op_94f9df5b820048c8a00466826ef6c6af","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9f3064bee04729bf4c796e1e78a648cce9ce2c3deebf958eee41190820959691","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"amix/dunk@c82459356688 snapshot 39f303c315706246","timeframe":null},"slice_ids":["slc_05213915e75f69c47cd21e2fad56d95a42871f283b98b1e1f5b444c73341ed42","slc_28ee77c75c8897a463836b8eac3d56558c4a5c14b6622d7202c14e305f3af30a","slc_437a55ec7ea7d381e44fbfedb1d247cf312c148934df142ed21dd49c9d5e1905"],"source_ids":["src_c59cbcaa1c895d1695debca63d455aa7","src_eac0d473961157e7b010d72941b56a21"],"text":"Review comments are stored in .dunk/comments.json with the file path, hunk anchor line, body, and a context hash so comments survive small nearby edits; the file is meant to stay local and gitignored, and is deleted once the last comment is resolved.","updated_at":"2026-09-14T03:34:16Z","updated_by_operation":"op_94f9df5b820048c8a00466826ef6c6af"}
