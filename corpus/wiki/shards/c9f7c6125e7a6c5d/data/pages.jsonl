207abf7e","maturity":"draft","page_type":"entity","path":"pages/entities/ashish200729-orbiteditor-068f207abf7e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"ashish200729/orbiteditor","updated_at":"2026-09-14T01:35:26Z","updated_by_operation":"op_ebc6d0b56aa44f60b71f4994fa48ff31"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_19b15ed3b38521c10eaaef69b1b71e041722d6b68c2429aa243717b6585f2356"],"opposing_claim_ids":[],"text":"Orbit is a fork of Void Editor, itself a fork of VS Code; additions are Apache 2.0 while the VS Code base remains MIT."},{"claim_ids":["clm_7c41acae6aed8b3f0e957d919e859eb0d7851133a9c3960e5b8dfca6c5f4b74b"],"opposing_claim_ids":[],"text":"The product is in beta and available only for macOS (Apple Silicon and Intel); Windows and Linux support is stated as coming soon."}],"claim_ids":["clm_19b15ed3b38521c10eaaef69b1b71e041722d6b68c2429aa243717b6585f2356","clm_7c41acae6aed8b3f0e957d919e859eb0d7851133a9c3960e5b8dfca6c5f4b74b"],"created_at":"2026-09-14T01:35:26Z","created_by_operation":"op_ebc6d0b56aa44f60b71f4994fa48ff31","id":"pg_51e5f9103ca15990af5660780d6329a1","maturity":"draft","page_type":"source","path":"pages/sources/ashish200729-orbiteditor-readme-md-6acd0c1e9ae0-60780d6329a1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_570722bd3666582fab1f164cd0997484"],"title":"ashish200729/orbiteditor/readme.md @ 6acd0c1e9ae0","updated_at":"2026-09-14T01:35:26Z","updated_by_operation":"op_ebc6d0b56aa44f60b71f4994fa48ff31"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T01:35:26Z","created_by_operation":"op_ebc6d0b56aa44f60b71f4994fa48ff31","id":"pg_66cb314e13c15b7784133964ad93d1c5","maturity":"draft","page_type":"source","path":"pages/sources/ashish200729-orbiteditor-orbit-production-plan-md-6acd0c1e9ae0-3964ad93d1c5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9acdf69f52a053cd8ee412d775bf2cff"],"title":"ashish200729/orbiteditor/ORBIT_PRODUCTION_PLAN.md @ 6acd0c1e9ae0","updated_at":"2026-09-14T01:35:26Z","updated_by_operation":"op_ebc6d0b56aa44f60b71f4994fa48ff31"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0a06aad296b9046fe8f2d030107618997089cf5fc5e61b4cdca1c40c401bb1a5"],"opposing_claim_ids":[],"text":"Skills are reusable instruction packs loaded on demand via a skill tool, sourced from built-in, user (~/.orbit/skills), and project (.orbit/skills) registries."},{"claim_ids":["clm_334e25b38984fe51b970be6520c331b9564a32f283547b38c3286e57e0ea24c0"],"opposing_claim_ids":[],"text":"The LLM pipeline spans chatThreadService (threads/streaming/checkpoints), convertToLLMMessageService, sendLLMMessage impl/channel, modelCapabilities, and orbitSettingsTypes."},{"claim_ids":["clm_7c408b454ab80018c5ec9d03ceba53567f3f6a962f5354f4aa049672830e7dda"],"opposing_claim_ids":[],"text":"MCP servers extend agent mode with extra tools, configured at ~/.orbit-editor/mcp.json, with a built-in orbit-ide-browser server exposing 17 tools and toggleable via browserAutomationEnabled."},{"claim_ids":["clm_7e1a43cb0f6aa65928d780e7926c044503100635297dbcfdd2da5e0786e2c98c"],"opposing_claim_ids":[],"text":"Most of Orbit's code lives in src/vs/workbench/contrib/orbit/, per the codebase guide and contributing doc."},{"claim_ids":["clm_8ffae93eac7cf6da6818754083bf8106b27c9d55ae0f439ddef72c91c3d9e1ff"],"opposing_claim_ids":[],"text":"Orbit snapshots file state before each user message and LLM edit, letting users restore checkpoints to roll back changes."},{"claim_ids":["clm_b672104f8c674fb6231b51f1fdf4820d1d8d6fdfb546f748947e7a12dff25716"],"opposing_claim_ids":[],"text":"Orbit defines three chat modes — agent, plan, normal — with a capability matrix differing in file edit, terminal, plan tools, MCP, and subagent access."},{"claim_ids":["clm_e0c648a2e274629352267e907dfdaaffb1b847ab05064ee71cd6d0d72e48d32d"],"opposing_claim_ids":[],"text":"LLM messages are sent from the Electron main process, which the guide says avoids CSP issues with local providers and eases node_modules use."},{"claim_ids":["clm_e82f2b87b0e646cd29f287d5d63d68542d6c190229d9c0f21a1384a9a8fd2a25"],"opposing_claim_ids":[],"text":"Apply has two modes: Fast Apply using Search/Replace blocks and Slow Apply that rewrites the whole file; Edit tool calls and Cmd+K reuse the same Apply machinery."},{"claim_ids":["clm_fd150437a2d27656e73624d9d5998cbc985f63e55200bcb462f4ad6cfbb6d643"],"opposing_claim_ids":[],"text":"A subagent system lets the main agent delegate bounded tasks to isolated child agents with restricted tool policies that return structured summaries; built-ins include explore, plan, and general."}],"claim_ids":["clm_0a06aad296b9046fe8f2d030107618997089cf5fc5e61b4cdca1c40c401bb1a5","clm_334e25b38984fe51b970be6520c331b9564a32f283547b38c3286e57e0ea24c0","clm_7c408b454ab80018c5ec9d03ceba53567f3f6a962f5354f4aa049672830e7dda","clm_7e1a43cb0f6aa65928d780e7926c044503100635297dbcfdd2da5e0786e2c98c","clm_8ffae93eac7cf6da6818754083bf8106b27c9d55ae0f439ddef72c91c3d9e1ff","clm_b672104f8c674fb6231b51f1fdf4820d1d8d6fdfb546f748947e7a12dff25716","clm_e0c648a2e274629352267e907dfdaaffb1b847ab05064ee71cd6d0d72e48d32d","clm_e82f2b87b0e646cd29f287d5d63d68542d6c190229d9c0f21a1384a9a8fd2a25","clm_fd150437a2d27656e73624d9d5998cbc985f63e55200bcb462f4ad6cfbb6d643"],"created_at":"2026-09-14T01:35:26Z","created_by_operation":"op_ebc6d0b56aa44f60b71f4994fa48ff31","id":"pg_6881967b83475869966e6c40d5992e00","maturity":"draft","page_type":"source","path":"pages/sources/ashish200729-orbiteditor-orbit-codebase-guide-md-6acd0c1e9ae0-6c40d5992e00.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_fad545b25a9f593f9d8d80d1f8396593"],"title":"ashish200729/orbiteditor/ORBIT_CODEBASE_GUIDE.md @ 6acd0c1e9ae0","updated_at":"2026-09-14T01:35:26Z","updated_by_operation":"op_ebc6d0b56aa44f60b71f4994fa48ff31"}
