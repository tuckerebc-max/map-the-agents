{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_00e7ccc40e51b91ddcac71a8cac423d31bf5251c73b1a367056be014cd6f27b1"],"opposing_claim_ids":[],"text":"Repository development practice: the project follows Conventional Commits (feat, fix, docs, etc.) and a Git Flow-inspired branch strategy with main, develop, feature/*, bugfix/*, hotfix/*, and release/* branches."},{"claim_ids":["clm_14ccaef5b309de6e4fa5864b849687ba9671328c743ff61ad983da17f32811b9"],"opposing_claim_ids":[],"text":"Repository development practice: contributors initialize the environment with scripts/setup.sh, build with scripts/build.sh, and run tests with scripts/test.sh; development mode uses npm run dev for the extension host and ./gradlew runIde for the plugin."},{"claim_ids":["clm_8b13d67d1f8c5a0207565cdede51eb2aa47b7b5c33e28f7946be11a95de0e550"],"opposing_claim_ids":[],"text":"Repository development practice: TypeScript code should follow ESLint/Prettier configs with camelCase variables, and Kotlin code should follow Kotlin conventions with ktlint formatting; .editorconfig sets 2-space TS and 4-space Kotlin indentation."}],"claim_ids":["clm_00e7ccc40e51b91ddcac71a8cac423d31bf5251c73b1a367056be014cd6f27b1","clm_14ccaef5b309de6e4fa5864b849687ba9671328c743ff61ad983da17f32811b9","clm_8b13d67d1f8c5a0207565cdede51eb2aa47b7b5c33e28f7946be11a95de0e550"],"created_at":"2026-09-14T01:53:11Z","created_by_operation":"op_611e8e036fbe4f2194cc465f3a67bbfd","id":"pg_209bcba92e1159fd9b4da96d5499bf46","maturity":"draft","page_type":"source","path":"pages/sources/haleclipse-codex-jetbrains-contributing-md-e2db6655d78d-a96d5499bf46.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_01af999089395456bb9cd946fe746916"],"title":"Haleclipse/Codex-JetBrains/CONTRIBUTING.md @ e2db6655d78d","updated_at":"2026-09-14T01:53:11Z","updated_by_operation":"op_611e8e036fbe4f2194cc465f3a67bbfd"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_14ccaef5b309de6e4fa5864b849687ba9671328c743ff61ad983da17f32811b9"],"opposing_claim_ids":[],"text":"Repository development practice: contributors initialize the environment with scripts/setup.sh, build with scripts/build.sh, and run tests with scripts/test.sh; development mode uses npm run dev for the extension host and ./gradlew runIde for the plugin."},{"claim_ids":["clm_3633d7f61e8835fe4fe91d08f02bd59f87c15b38b4321459ee6de6f7381fb702"],"opposing_claim_ids":[],"text":"RunVSAgent is a cross-platform tool that runs VSCode-based coding agents and extensions inside JetBrains IDEs such as IntelliJ IDEA, WebStorm, and PyCharm."},{"claim_ids":["clm_3fe1934c00857f8fccca2a2f7f4c49fa92746f5dfcf3c1ca1cf169128bf582b9"],"opposing_claim_ids":[],"text":"The extension host's TypeScript source includes main.ts, extensionManager.ts for extension lifecycle, rpcManager.ts for RPC, and webViewManager.ts for WebView support."},{"claim_ids":["clm_5c48edafaef4a3ea2044db77e8bc5d12df60e408416eeb92f63e0e00bf10cbdb"],"opposing_claim_ids":[],"text":"Running/building the project requires Node.js 18+, a JetBrains IDE 2023.1+, Git, and JDK 17+."},{"claim_ids":["clm_871331dfaa31e7413383f270e258bc4acda592dd9e72f18db80e3c9dbe9216d8"],"opposing_claim_ids":[],"text":"Supported JetBrains IDEs include IntelliJ IDEA, WebStorm, PyCharm, PhpStorm, RubyMine, CLion, GoLand, DataGrip, Rider, and Android Studio."},{"claim_ids":["clm_b4e982a2640e2b82baebac088f99e65e7f198f9c996c9432683d761323b593c4"],"opposing_claim_ids":[],"text":"The plugin can be installed from the JetBrains Marketplace via Settings/Preferences → Plugins, or from a downloaded .zip via 'Install Plugin from Disk', followed by an IDE restart."},{"claim_ids":["clm_ba3ba25d7f6c283a3b91fab993e0a81e6e06ea4e92c19fa0311d3abaaf1e77dd"],"opposing_claim_ids":[],"text":"The project lists Roo Code, Cline, and Kilo Code as supported VSCode-based coding agents."},{"claim_ids":["clm_c9ccf96dec331fcde3725d4b08ce585abb3951bffefd054e2ee9c0648a26e611"],"opposing_claim_ids":[],"text":"The README notes that JetBrains IDE version 2023.1 or later is required for optimal compatibility."},{"claim_ids":["clm_ce81d6370238dce250a3764cda026766875d5677096be78227601e99bcba6f1a"],"opposing_claim_ids":[],"text":"The architecture comprises a Kotlin JetBrains plugin (with UI integration and editor bridge), a Node.js extension host providing a VSCode API compatibility layer, and VSCode agents, connected via RPC."},{"claim_ids":["clm_d37e3c623d5b5729a4c01c3c3afcf2a16ce54d2abdb1f861711a2730bca864d9"],"opposing_claim_ids":[],"text":"Communication between the plugin and extension host uses RPC over Unix Domain Sockets or Named Pipes, per the technology stack description."}],"claim_ids":["clm_14ccaef5b309de6e4fa5864b849687ba9671328c743ff61ad983da17f32811b9","clm_3633d7f61e8835fe4fe91d08f02bd59f87c15b38b4321459ee6de6f7381fb702","clm_3fe1934c00857f8fccca2a2f7f4c49fa92746f5dfcf3c1ca1cf169128bf582b9","clm_5c48edafaef4a3ea2044db77e8bc5d12df60e408416eeb92f63e0e00bf10cbdb","clm_871331dfaa31e7413383f270e258bc4acda592dd9e72f18db80e3c9dbe9216d8","clm_b4e982a2640e2b82baebac088f99e65e7f198f9c996c9432683d761323b593c4","clm_ba3ba25d7f6c283a3b91fab993e0a81e6e06ea4e92c19fa0311d3abaaf1e77dd","clm_c9ccf96dec331fcde3725d4b08ce585abb3951bffefd054e2ee9c0648a26e611","clm_ce81d6370238dce250a3764cda026766875d5677096be78227601e99bcba6f1a","clm_d37e3c623d5b5729a4c01c3c3afcf2a16ce54d2abdb1f861711a2730bca864d9"],"created_at":"2026-09-14T01:53:11Z","created_by_operation":"op_611e8e036fbe4f2194cc465f3a67bbfd","id":"pg_5d02e83d503c5098b8a0e18e05f67747","maturity":"draft","page_type":"source","path":"pages/sources/haleclipse-codex-jetbrains-readme-md-e2db6655d78d-e18e05f67747.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0dce8ec969e75b75a02b79148afa1a00"],"title":"Haleclipse/Codex-JetBrains/README.md @ e2db6655d78d","updated_at":"2026-09-14T01:53:11Z","up