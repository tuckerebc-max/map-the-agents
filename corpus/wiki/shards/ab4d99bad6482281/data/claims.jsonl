{"access":"public","created_at":"2026-09-14T01:58:51Z","created_by_operation":"op_e84b170547b94b28be27584dd3fef74b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_875620f8d8be213726cb6b23a92683f08dd62fbfe6931f5ebea93653520bb1d4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"2389-research/tracker@de156192ce90 snapshot 573327dee8852ffb","timeframe":null},"slice_ids":["slc_637bc923f3178edc92c922225c964f190e1a30fc40f571226c10c28b4e3c2ac9","slc_8b4a39703132b3811bd9d2db84abaa35f07ba5f5793e32d3fa1f4acb4d4f1767","slc_a05ed756ffefadfb6cb0ec9b47e6022b81d82160e1fdd613e8cd85ff8e1f4e80"],"source_ids":["src_f5a5af977b98529a99d0e932a0b32ae7"],"text":"Variable expansion is single-pass so resolved values are never re-scanned, preventing recursive expansion; unknown --param keys hard-fail at startup.","updated_at":"2026-09-14T01:58:51Z","updated_by_operation":"op_e84b170547b94b28be27584dd3fef74b"}
