{"access":"public","created_at":"2026-09-14T03:51:26Z","created_by_operation":"op_d57b3e21d3704a5fb6b74250da44395b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4df4c55fe6b47733f3208fd5ea5929f9553efab2a9311583bdcc1ec9a90d9975","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"fireproof-storage/fireproof@404e6c5c7f28 snapshot 11291582979dda34","timeframe":null},"slice_ids":["slc_8a6bb1949534faae5db9632837be45cae14eeec1c2f9e27a67f6edb55a50554c"],"source_ids":["src_1e881265e22e5188bb66425f1da7e0bf"],"text":"From version 0.19 onward the database format is stated to be stable with no backward-compatibility breaks, though internal APIs changed between the 0.19 and 0.20 series.","updated_at":"2026-09-14T03:51:26Z","updated_by_operation":"op_d57b3e21d3704a5fb6b74250da44395b"}
{"access":"public","created_at":"2026-09-14T03:51:26Z","created_by_operation":"op_d57b3e21d3704a5fb6b74250da44395b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_853f95f046657846674dd79451c0ab71264a5c331c03595fe56301e8157950bc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"fireproof-storage/fireproof@404e6c5c7f28 snapshot 11291582979dda34","timeframe":null},"slice_ids":["slc_2a88254c55df3c6c43bb190c6db9fcd9c34078716f137bafed94b72a13985c32"],"source_ids":["src_1e881265e22e5188bb66425f1da7e0bf"],"text":"The 0.20 series changes the Gateway interface to pass semantic runtime objects instead of Uint8Arrays and Url, renames Database to Ledger with no functional change, replaces memfs with a memory:// URL scheme, and adds a GatewayInterceptor for logging, encryption, or compression.","updated_at":"2026-09-14T03:51:26Z","updated_by_operation":"op_d57b3e21d3704a5fb6b74250da44395b"}
{"access":"public","created_at":"2026-09-14T03:51:26Z","created_by_operation":"op_d57b3e21d3704a5fb6b74250da44395b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_902843c54db66c07b075c91fe5ba530f52f83a62988468a56533c4f468284b50","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"fireproof-storage/fireproof@404e6c5c7f28 snapshot 11291582979dda34","timeframe":null},"slice_ids":["slc_55ca4f84f9c24cba12962377eca5d857c408f59e940bc0c56a5bca1bcb5bbf59","slc_59a37311213910b56de847ded796f03099077f90e5376f9619bf067db4e094a4","slc_8ad40210f40ef943b3a16d8289adb6a4d0ef0c1c4e05a9c58166d7c1d3eca003","slc_9460bcfeea2a36bca66c5071b2baebdff24abb81b8070bb2bad8079f0cd86d94"],"source_ids":["src_41ebcae2d9675ab68d8bc923d54a526b"],"text":"Deno compatibility requires specific run flags, and the README notes tests are not currently run under Deno, marking Deno publishing as TODO.","updated_at":"2026-09-14T03:51:26Z","updated_by_operation":"op_d57b3e21d3704a5fb6b74250da44395b"}
{"access":"public","created_at":"2026-09-14T03:51:26Z","created_by_operation":"op_d57b3e21d3704a5fb6b74250da44395b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_927b24419fede3dac7c1521f78bea5292ed99546ad2d28e23d440a5b310d18f0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"fireproof-storage/fireproof@404e6c5c7f28 snapshot 11291582979dda34","timeframe":null},"slice_ids":["slc_87139fcd46f6d3746617f7a4268b7b670bb2fe0be4d73d20193174bed3c299e3"],"source_ids":["src_41ebcae2d9675ab68d8bc923d54a526b"],"text":"The ledger enforces cryptographic causal consistency and integrity using a hash history, storing and replicating data as content-addressed encrypted blobs suitable for syncing via object storage.","updated_at":"2026-09-14T03:51:26Z","updated_by_operation":"op_d57b3e21d3704a5fb6b74250da44395b"}
