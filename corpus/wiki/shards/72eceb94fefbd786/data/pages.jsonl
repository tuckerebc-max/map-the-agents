{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7ab7053d239ab35d4273036a7109ca202039f6f9ae471768f9e67632aee98e3f"],"opposing_claim_ids":[],"text":"The project describes itself as an experimental application provided as-is without warranty, and warns that GPT-4 usage can be expensive, advising users to monitor their own API costs."}],"claim_ids":["clm_7ab7053d239ab35d4273036a7109ca202039f6f9ae471768f9e67632aee98e3f"],"created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","id":"pg_b87fc3409abb587f8e16b350eec08a2f","maturity":"draft","page_type":"source","path":"pages/sources/antonosika-gpt-engineer-disclaimer-md-a90fcd543eed-b350eec08a2f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c3467bdd4d8d5863adf4b51eb48ddf1a"],"title":"AntonOsika/gpt-engineer/DISCLAIMER.md @ a90fcd543eed","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","id":"pg_b8c312c7aeba5906966668ad377f519a","maturity":"draft","page_type":"source","path":"pages/sources/antonosika-gpt-engineer-governance-md-a90fcd543eed-68ad377f519a.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0a060e78dc015ba58769e049a94f6629"],"title":"AntonOsika/gpt-engineer/GOVERNANCE.md @ a90fcd543eed","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_d61dbd155698026aeeea21bb1fc1ef8781a06acf5fd60ff08ee48c9d13bdf846"],"opposing_claim_ids":[],"text":"Optional usage-data collection is opt-in: it occurs only when a consent file named .gpte_consent exists in the gpt-engineer directory."}],"claim_ids":["clm_d61dbd155698026aeeea21bb1fc1ef8781a06acf5fd60ff08ee48c9d13bdf846"],"created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","id":"pg_cc655cab59a45829a9be33b859f0b93b","maturity":"draft","page_type":"source","path":"pages/sources/antonosika-gpt-engineer-terms-of-use-md-a90fcd543eed-33b859f0b93b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e30698c3294756879459bd0c9f7a6f80"],"title":"AntonOsika/gpt-engineer/TERMS_OF_USE.md @ a90fcd543eed","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_094948b95144e1107865d19360c242ecb9ccd936647da6c0f8e4eb6bc90352aa"],"opposing_claim_ids":[],"text":"Installing gpt-engineer provides a `bench` binary for benchmarking custom agent implementations against public datasets, currently APPS and MBPP, with a separate template repo for getting started."},{"claim_ids":["clm_2cfe8e325151f496686c94c162a14084655b1b44963d0b6b392ee32cb04cad02"],"opposing_claim_ids":[],"text":"Python 3.10-3.12 is actively supported; versions 0.2.6 and earlier were the last to support Python 3.8-3.9."},{"claim_ids":["clm_739a2fc9f068a38de9d1ba38d30b4873cb18f04fbb9874ee9d045e3c0b82cf72"],"opposing_claim_ids":[],"text":"Vision-capable models can receive image inputs via an image directory flag, with the model name given as the second CLI argument, e.g. gpt-4-vision-preview."},{"claim_ids":["clm_7b7485ee33859e9e4cf8a6810cf5680be5446fcd66c8f8c598d8fbaa45b7581b"],"opposing_claim_ids":[],"text":"The tool installs via `python -m pip install gpt-engineer` for stable releases; development setup uses git clone plus poetry install and `poetry shell`."},{"claim_ids":["clm_7fb1ce9c2372ca48d49429bda813c5194b82ca1ec9789c76b75abc9c67ed9b4e"],"opposing_claim_ids":[],"text":"The CLI accepts a `--use-custom-preprompts` flag to override the built-in preprompts folder, letting users change the agent's identity and persistence across projects."},{"claim_ids":["clm_82e2af3d3111cbb96cccccf372b8bbbfd0f29288e75324950f9fbe9008ac19d8"],"opposing_claim_ids":[],"text":"Users run the `gpte` CLI against a project directory containing an extension-less `prompt` file with natural-language instructions, e.g. `gpte projects/my-new-project`."},{"claim_ids":["clm_8859ccaa32842be75d6a1ef25c537b346822d1fa8949e105c027776d2330b3c7"],"opposing_claim_ids":[],"text":"Improving existing code is done by placing a `prompt` file in the target code folder and running `gpte <project_dir> -i`."},{"claim_ids":["clm_a8680023473091ec4f8a64ce36add12c92ae2387744261c90908877e9c73226a"],"opposing_claim_ids":[],"text":"By default the tool supports OpenAI models via the OpenAI or Azure OpenAI APIs and Anthropic models; open-source models like WizardCoder require extra setup, and API keys are configured via env var or .env file."},{"claim_ids":["clm_c49cb0e45504806921065f995a962f4dfe65e6d0687895f86627e7ad5f375d40"],"opposing_claim_ids":[],"text":"The project positions itself as a code-generation experimentation platform where users specify software in natural language, watch AI write and execute code, and request improvements."}],"claim_ids":["clm_094948b95144e1107865d19360c242ecb9ccd936647da6c0f8e4eb6bc90352aa","clm_2cfe8e325151f496686c94c162a14084655b1b44963d0b6b392ee32cb04cad02","clm_739a2fc9f068a38de9d1ba38d30b4873cb18f04fbb9874ee9d045e3c0b82cf72","clm_7b7485ee33859e9e4cf8a6810cf5680be5446fcd66c8f8c598d8fbaa45b7581b","clm_7fb1ce9c2372ca48d49429bda813c5194b82ca1ec9789c76b75abc9c67ed9b4e","clm_82e2af3d3111cbb96cccccf372b8bbbfd0f29288e75324950f9fbe9008ac19d8","clm_8859ccaa32842be75d6a1ef25c537b346822d1fa8949e105c027776d2330b3c7","clm_a8680023473091ec4f8a64ce36add12c92ae2387744261c90908877e9c73226a","clm_c49cb0e45504806921065f995a962f4dfe65e6d0687895f86627e7ad5f375d40"],"created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","id":"pg_fd11d72a444453b28ab223af0d1dbd45","maturity":"draft","page_type":"source","path":"pages/sources/antonosika-gpt-engineer-readme-md-a90fcd543eed-23af0d1dbd45.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"title":"AntonOsika/gpt-engineer/README.md @ a90fcd543eed","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
