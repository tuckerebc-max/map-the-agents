{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_094948b95144e1107865d19360c242ecb9ccd936647da6c0f8e4eb6bc90352aa","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=evaluation","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_a6ffe6b508581fd2e692c777b9d5fa6e378406219ddd4b7a48134b5ab286a5c6"],"source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"text":"Installing gpt-engineer provides a `bench` binary for benchmarking custom agent implementations against public datasets, currently APPS and MBPP, with a separate template repo for getting started.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2cfe8e325151f496686c94c162a14084655b1b44963d0b6b392ee32cb04cad02","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_b4d6f444936227d6747120f094768f29cabddeb7692d93a72ae355c9157072df"],"source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"text":"Python 3.10-3.12 is actively supported; versions 0.2.6 and earlier were the last to support Python 3.8-3.9.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5fd829e063db32cbc86e594f718a09524b0aab69c0dcb2a86f763a4c6a4a3e5f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_2a1c519aa450126c5a66240ff330dffde7c7f396879290651eb82a9f0a972567","slc_d8da870b1dbfacbddea8701855beda287428f85fe88522f614a22d915f866b21"],"source_ids":["src_3035b948752c58ea9889539f8d7a0f7e"],"text":"Repository development practice: contributors can propose roadmap designs as Google Docs in Discord, submit PRs for roadmap items, or review others' PRs, with volunteer work acknowledged.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_739a2fc9f068a38de9d1ba38d30b4873cb18f04fbb9874ee9d045e3c0b82cf72","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_3b62e8bb222cfc1fa6aafe301425d9d242ca95b6c17d5f0ca1f7bdf711d416f1","slc_f02da110c6c4564925db1fbb6aa5e32fe7c3a44c6a41317bf55d75973486c884"],"source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"text":"Vision-capable models can receive image inputs via an image directory flag, with the model name given as the second CLI argument, e.g. gpt-4-vision-preview.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7ab7053d239ab35d4273036a7109ca202039f6f9ae471768f9e67632aee98e3f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_aaaf03b9007d7a61f8f30e42de4b33f4d1426d69232b62c6c24746e827a179b4","slc_ba982a5123f8e9909ef301c37caf254b7af80549b925f56246fa4e69966ba461"],"source_ids":["src_c3467bdd4d8d5863adf4b51eb48ddf1a"],"text":"The project describes itself as an experimental application provided as-is without warranty, and warns that GPT-4 usage can be expensive, advising users to monitor their own API costs.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7b7485ee33859e9e4cf8a6810cf5680be5446fcd66c8f8c598d8fbaa45b7581b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_8c9a4f2ddda0327932a57524318bf13fa7b5afe9d48c1b6815541c5c8f535fa2","slc_ed35cc4429114e393e1f4d84dbd5eeefea37539f3ab451b52b914e589a2c8d75"],"source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"text":"The tool installs via `python -m pip install gpt-engineer` for stable releases; development setup uses git clone plus poetry install and `poetry shell`.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7fb1ce9c2372ca48d49429bda813c5194b82ca1ec9789c76b75abc9c67ed9b4e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_053a551f83a443af154c55084f859070adc709923b55b292073fbd80a691daaa","slc_e08b9065b181a060d118f60efd8e9c2a764cebfd87877eaa434216db31e3f15e"],"source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"text":"The CLI accepts a `--use-custom-preprompts` flag to override the built-in preprompts folder, letting users change the agent's identity and persistence across projects.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_82e2af3d3111cbb96cccccf372b8bbbfd0f29288e75324950f9fbe9008ac19d8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_57aa3348b7cac0b544e3953f4c4c3ce6b1b9377fafb6e0b44fd8b9c58a616954"],"source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"text":"Users run the `gpte` CLI against a project directory containing an extension-less `prompt` file with natural-language instructions, e.g. `gpte projects/my-new-project`.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8859ccaa32842be75d6a1ef25c537b346822d1fa8949e105c027776d2330b3c7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_ea2d29bc32a1ead29ec3f0677b5bad460542205531e2876fa45717d39aab5092"],"source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"text":"Improving existing code is done by placing a `prompt` file in the target code folder and running `gpte <project_dir> -i`.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a8680023473091ec4f8a64ce36add12c92ae2387744261c90908877e9c73226a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_1ce4872a9e2416f75f6f7684fc11113f6ff39ad8d7703bc1c0569d2810520f57","slc_3b503dc3a704b986cd785e4d7a31a08a883bb678e3bde14873f061ebd01d5870","slc_5c85572309f2287e64ac54f492bb020630a72a909e550925fd2d38760cd5cb59"],"source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"text":"By default the tool supports OpenAI models via the OpenAI or Azure OpenAI APIs and Anthropic models; open-source models like WizardCoder require extra setup, and API keys are configured via env var or .env file.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c49cb0e45504806921065f995a962f4dfe65e6d0687895f86627e7ad5f375d40","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_a7bbecc69df7022490320f54534744dd7a6af9cf53e3f352c92027afb58aa1f7","slc_c7547b0ed070329aa660c29fd692b04866c386ec5334ecd32072a2e2b6f723e4"],"source_ids":["src_62b30ea94d5059c1b08b6969e830ff42"],"text":"The project positions itself as a code-generation experimentation platform where users specify software in natural language, watch AI write and execute code, and request improvements.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
{"access":"public","created_at":"2026-09-14T01:34:30Z","created_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d61dbd155698026aeeea21bb1fc1ef8781a06acf5fd60ff08ee48c9d13bdf846","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"antonosika/gpt-engineer@a90fcd543eed snapshot 2f719d3003f5982a","timeframe":null},"slice_ids":["slc_b4a6d9011c4a16e6cee38b368014bc6fe7a042b0724a5d68a744aea1b25295fa"],"source_ids":["src_e30698c3294756879459bd0c9f7a6f80"],"text":"Optional usage-data collection is opt-in: it occurs only when a consent file named .gpte_consent exists in the gpt-engineer directory.","updated_at":"2026-09-14T01:34:30Z","updated_by_operation":"op_5e7e230b6a864e3293e3eb1289335ad4"}
