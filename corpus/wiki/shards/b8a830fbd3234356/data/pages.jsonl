a66c424","clm_ec0e79cadce8a4949affda4c97fb06a160f4bb6876835e4e0ec15c2c5442a216","clm_f2c77567cc1282f620102fd97e3cb101abd5a8eaf77548312e477c73d6ef9e70"],"created_at":"2026-09-14T04:28:53Z","created_by_operation":"op_8fe787eb5ac643ab9764168a560dda30","id":"pg_405ce21c8572522e836d1b7b5048baca","maturity":"draft","page_type":"entity","path":"pages/entities/valuecell-ai-valuecell-1b7b5048baca.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"valuecell-ai/valuecell","updated_at":"2026-09-14T04:28:53Z","updated_by_operation":"op_8fe787eb5ac643ab9764168a560dda30"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:28:53Z","created_by_operation":"op_8fe787eb5ac643ab9764168a560dda30","id":"pg_4fcf1240cca353c385e87669ae15d286","maturity":"draft","page_type":"source","path":"pages/sources/valuecell-ai-valuecell-readme-zh-md-9793e9c0563f-7669ae15d286.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9511b611b35e5fafa2dc934bc84221f7"],"title":"ValueCell-ai/valuecell/README.zh.md @ 9793e9c0563f","updated_at":"2026-09-14T04:28:53Z","updated_by_operation":"op_8fe787eb5ac643ab9764168a560dda30"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_16deed8a2612548e48257be0810050eea35f78cebbd5b760d9ea4d86046d89a1"],"opposing_claim_ids":[],"text":"Users configure AI model API keys and exchange credentials (Binance, HyperLiquid, OKX, Coinbase) through the web interface, then create strategies combining models with exchanges and start/stop traders with real-time monitoring."},{"claim_ids":["clm_1fcfc26e753786f09c570b54eb2b2704ec4c21d9c2767af698644316a1315aca"],"opposing_claim_ids":[],"text":"Exchange connectivity is documented for OKX, Binance, and Hyperliquid as fully tested, with Coinbase, Gate.io, MEXC, and a Blockchain option listed as partially tested."},{"claim_ids":["clm_4cdf94b760a195a2b3959e44a305bdfe09943b843439c98a51ee1afbab222b31"],"opposing_claim_ids":[],"text":"The project targets Python 3.12+ and is licensed under Apache 2.0, which applies only to original ValueCell code; third-party components like TradingView widgets and exchange/LLM APIs are governed by their own terms."},{"claim_ids":["clm_5a809f8d877300eaa620fbe4799da15e458ab6ace8bb8525735d81c96b6e594c"],"opposing_claim_ids":[],"text":"The product supports multiple LLM providers including OpenRouter, SiliconFlow, Azure, Google, OpenAI-compatible endpoints, OpenAI, and DeepSeek, per the README's integrations section."},{"claim_ids":["clm_b3504277c27aa4649ffd15b827c3f78a5b528562e3431fb2e514733cca2ecc58"],"opposing_claim_ids":[],"text":"The application stores local data in a LanceDB directory, a knowledge directory, and a SQLite database file (valuecell.db) under the system application directory, and users may delete these to reset state."},{"claim_ids":["clm_bf8f8b57007986f1ad5d712f00ecfcf67668a290832baf109edd7d0023008037"],"opposing_claim_ids":[],"text":"When launched, the application serves a web UI at http://localhost:1420 and streams backend and agent logs to the terminal."},{"claim_ids":["clm_dc94f19a8d5716d4c22bb8c9e4d60b00b209905d4a517e7d8395e95510d34493"],"opposing_claim_ids":[],"text":"Repository setup instructions: clone the repo, copy .env.example to .env and add API keys, then launch everything with bash start.sh (Linux/macOS) or .\\start.ps1 (Windows PowerShell)."},{"claim_ids":["clm_e0e69fe17f088275a5236923036589b46d34d9d614ba50369f0d6156ca66c424"],"opposing_claim_ids":[],"text":"Live trading currently supports only contract (leverage) trading, with spot implemented as 1X contracts, so users must maintain sufficient contract account balance."},{"claim_ids":["clm_ec0e79cadce8a4949affda4c97fb06a160f4bb6876835e4e0ec15c2c5442a216"],"opposing_claim_ids":[],"text":"The README describes a multi-agent system including a DeepResearch Agent for analyzing fundamental documents, a Strategy Agent for multi-strategy crypto trading, and a News Retrieval Agent for scheduled news delivery, with more agents planned."}],"claim_ids":["clm_16deed8a2612548e48257be0810050eea35f78cebbd5b760d9ea4d86046d89a1","clm_1fcfc26e753786f09c570b54eb2b2704ec4c21d9c2767af698644316a1315aca","clm_4cdf94b760a195a2b3959e44a305bdfe09943b843439c98a51ee1afbab222b31","clm_5a809f8d877300eaa620fbe4799da15e458ab6ace8bb8525735d81c96b6e594c","clm_b3504277c27aa4649ffd15b827c3f78a5b528562e3431fb2e514733cca2ecc58","clm_bf8f8b57007986f1ad5d712f00ecfcf67668a290832baf109edd7d0023008037","clm_dc94f19a8d5716d4c22bb8c9e4d60b00b209905d4a517e7d8395e95510d34493","clm_e0e69fe17f088275a5236923036589b46d34d9d614ba50369f0d6156ca66c424","clm_ec0e79cadce8a4949affda4c97fb06a160f4bb6876835e4e0ec15c2c5442a216"],"created_at":"2026-09-14T04:28:53Z","created_by_operation":"op_8fe787eb5ac643ab9764168a560dda30","id":"pg_907f35719f8c5cd4b80c0684903bcea8","maturity":"draft","page_type":"source","path":"pages/sources/valuecell-ai-valuecell-readme-md-9793e9c0563f-0684903bcea8.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8d99c6014e5e5fe5aa437b8983edac23"],"title":"ValueCell-ai/valuecell/README.md @ 9793e9c0563f","updated_at":"2026-09-14T04:28:53Z","updated_by_operation":"op_8fe787eb5ac643ab9764168a560dda30"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:28:53Z","created_by_operation":"op_8fe787eb5ac643ab9764168a560dda30","id":"pg_954af5f6113b5429895685fb7a8d0b43","maturity":"draft","page_type":"source","path":"pages/sources/valuecell-ai-valuecell-readme-zh-hant-md-9793e9c0563f-85fb7a8d0b43.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c8a93c5b7b775b718c666bd3dc3eeb24"],"title":"ValueCell-ai/valuecell/README.zh_Hant.md @ 9793e9c0563f","updated_at":"2026-09-14T04:28:53Z","updated_by_operation":"op_8fe787eb5ac643ab9764168a560dda30"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_03cc7b432c12c3be37e9a8870a9edf744179ae78dfb98bb3dfb1ab2b00c6e3f3"],"opposing_claim_ids":[],"text":"Configuration uses a three-tier system: environment variables override .env file settings, which override YAML defaults stored under python/configs/."},{"claim_ids":["clm_18ed2feda03bc1f4f46b297704a9367036b2020add5c72963f017106970c6599"],"opposing_claim_ids":[],"text":"OKX trading defaults to a paper environment, and OKX_ALLOW_LIVE_TRADING defaults to false and must be set to true before orders are routed to mainnet."},{"claim_ids":["clm_4506f8b38ee393ced746c211673e7b403dcdd1482331c2dabe45e77338399461"],"opposing_claim_ids":[],"text":"The system auto-detects a primary provider from available API keys in a priority order starting with OpenRouter, SiliconFlow, Google, OpenAI, OpenAI-compatible, and Azure; this can be overridden via PRIMARY_PROVIDER or disabled with AUTO_DETECT_PROVIDER=false."},{"claim_ids":["clm_51006d9adba37f417f12e4232d397046d0326a05d0c8b0ba8ff167d975246c30"],"opposing_claim_ids":[],"text":"If the primary provider fails, the system automatically tries fallback providers built from other enabled providers with valid keys, stopping at the first successful model creation; fallback can be overridden or disabled per agent with use_fallback: false."},{"claim_ids":["clm_b3504277c27aa4649ffd15b827c3f78a5b528562e3431fb2e514733cca2ecc58"],"opposing_claim_ids":[],"text":"The application stores local data in a LanceDB directory, a knowledge directory, and a SQLite database file (valuecell.db) under the system application directory, and users may delete these to reset state."},{"claim_ids":["clm_dc94f19a8d5716d4c22bb8c9e4d60b00b209905d4a517e7d8395e95510d34493"],"opposing_claim_ids":[],"text":"Repository setup instructions: clone the repo, copy .env.example to .env and add API keys, then launch everything with bash start.sh (Linux/macOS) or .\\start.ps1 (Windows PowerShell)."},{"claim_ids":["clm_f2c77567cc1282f620102fd97e3cb101abd5a8eaf77548312e477c73d6ef9e70"],"opposing_claim_ids":[],"text":"Agent YAML configs support per-provider model mappings (provider_models) and env_overrides, suggesting agents can run different models per provider and be tuned at runtime without code changes."}],"claim_ids":["clm_03cc7b432c12c3be37e9a8870a9edf744179ae78dfb98bb3dfb1ab2b00c6e3f3","clm_18ed2feda03bc1f4f46b297704a9367036b2020add5c72963f017106970c6599","clm_4506f8b38ee393ced746c211673e7b403dcdd1482331c2dabe45e77338399461","clm_51006d9adba37f417f12e4232d397046d0326a05d0c8b0ba8ff167d975246c30","clm_b3504277c27aa4649ffd15b827c3f78a5b528562e3431fb2e514733cca2ecc58","clm_dc94f19a8d5716d4c22bb8c9e4d60b00b209905d4a517e7d8395e95510d34493","clm_f2c77567cc1282f620102fd97e3cb101abd5a8eaf77548312e477c73d6ef9e70"],"created_at":"2026-09-14T04:28:53Z","created_by_operation":"op_8fe787eb5ac643ab9764168a560dda30","id":"pg_b190b6976bba5733a84feac209b39809","maturity":"draft","page_type":"source","path":"pages/sources/valuecell-ai-valuecell-docs-configuration-guide-md-9793e9c0563f-eac209b39809.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6345424397fd56d0aff4255986966f5e"],"title":"ValueCell-ai/valuecell/docs/CONFIGURATION_GUIDE.md @ 9793e9c0563f","updated_at":"2026-09-14T04:28:53Z","updated_by_operation":"op_8fe787eb5ac643ab9764168a560dda30"}
