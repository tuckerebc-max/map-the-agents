{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_17019c432e9f8bc809006ca9fff6249fe47476d21ea0c28eac488000a7949651","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_0362021372f062aaa196ec8f3202aea6dad46ff1db9f210d61ca7338dd7c4334","slc_03cbccae8b7f70b4112dd5fdcb4996b248558a60cf44cab43d97c003e2a1ec08","slc_33b630dd3ee8e79dbdda4f341ffb3508008c3afaf722455a35093c5e5907fd4c","slc_91849987de1366f623682335060d3bfe82453a47eb1a5a322aa6f5c65a1a7d02","slc_bf73627564fbcfaeb317fc7e968f4d820a252a9f22ef2fd50793953ec259558d","slc_c1c6f71cd08e5fc0f52642078cd6880a6ebca4fb94649bebc9f74dafbf646c66"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"An optional agent-callable `boomerang` tool supports task mode (queued autonomous execution) and anchor mode (toggle a summary point); it is disabled by default and enabled via `/boomerang tool on`.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1fdcd62eda1cd35372613ac2217abf4c758c41078eafa3d30fd7808a3ea190fa","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_553341a0fa2bd98a2c1ac03e66b0f09b4253efc49ad659cc7d0d59de2a1fa38d"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"Boomerang summarizes only context/tokens and never touches file state; all file changes made during a task are preserved on disk.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_25056fa832859cc129439995d0be008c159b1e980889b73c122d8f4409dac22f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_b549dd495e482560d054f937fa490b8f5778f3c1d5c34bfc33eacc82607b55a2","slc_f019f6120055c96c0d3d295dae5dfdbf8027b393f3760a8c415e1c0b21957f38","slc_fbb38c94796652c0e8cfb840ea53e5012fb404fea6e013d9b4c4757e8f2130e6"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300","src_986d67ad853c554e97490ed72ab9cc64"],"text":"After completion, raw turn history is replaced in future context by an expanded handoff summary containing outcome, changed files, relevant reads, validation commands, failures, and config metadata.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_599228afc967fef35c60dc291c2276814232ad73d8fbc79d8e49e699d6d39bd5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_d492a31343dabb4f6b7e9443f100815ffbb691fa11078ea6782cad5313432510","slc_d6e0ead7967f439cd80930c284bed242d632275359a0b9f8fc4256e359075149"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"The session tree preserves full history for `/tree` navigation, so only future context is collapsed while the underlying history remains accessible.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_68a38b2ae4350b2100afd876044ff55e730f624b7828240125278b2fd51ae4fe","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_30d395151534a755704852a56f659620fb9b09fa76988f4122f80f1b4b60a556","slc_949d76f1481f77debb223e467b13b871c6366da20bb15f45a80d948ada8d3660"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"Tool state and guidance persist to `~/.pi/agent/boomerang.json` across restarts, while anchor state is in-memory only and clears on session start or switch.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7c4f251abe90fc57ca931b6a42d1457405259c7ab85deada8f915eeaca8e44cf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_078fc1431bcd9dad8daf52bbb4ed5fe3ba3dfb5eee154a6e15d1b4486d4f5ef2","slc_1588f7d41c1c8316993923bb37f364d989feff33a473e48b4e6d7b099f06f5e5","slc_6df3085c3ee01f2afc2ec0ff41a3cd0b211a78a5d9836302a6b106ebf55ffbf3","slc_b63db03963c3b2f1d7e824aae762b2582180824aae65e3a06bfda41a5da6b1c1","slc_d23824d069e90a652024620999ed1c96b15c7016f2fcad0cdd1f0d3e5e2bb737"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"Chained templates can be run in sequence (e.g. `/boomerang /scout -> /planner -> /impl`) with per-step inline args, global fallback args after `--`, and a single summary return at the end.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_919899d9296e1b3b05f46285e769ee6489f9c48b201dd96bbcb061116870b5bd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_24a170adef835119bcf29c5788f12efee3f113e190289b2d112aa51266c0324a","slc_3d1b69976e624d1fec2178cb5c6b5fce2291a4269186106c129b9d8581c5113e","slc_6eaa044e8a9060859c922a84a7e5c220a72fa7c1561f0dbdf4453589c1d70487"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"Template frontmatter fields `model`, `skill`, and `thinking` control each chain step's configuration, and boomerang restores the original config after the summary return.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c5dd72a4b88d678e304d363f3e66c996a75b77e8221c0d2e3892ca622e243e28","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_7c6b0ab3fea185aafb3d516d32bb6a94e53b5320d2e7167790070c0e8736b357","slc_828ad0983819a9d6fb5db79e04bffc1176bcf06e8a16dacdab173d7bc2374a27"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"`--rethrow N` (N required, 1-999) reruns the full task N times, summarizing between passes; file changes persist on disk and each pass sees accumulated summaries rather than raw history.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c9a8639ad875020b5e4a7caaace4436eda1afefcb8f7853c2ca752d6d82f4026","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_898a9b141cd21d40bf3bf81c7fbc39ea889d43284fa1588bedccd4fec4a58e20","slc_949d76f1481f77debb223e467b13b871c6366da20bb15f45a80d948ada8d3660"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"Documented limitations: summaries are heuristic and may miss semantic details, the agent may still ask questions, anchor state is in-memory only, and tool-initiated summaries may lag in the UI until `/reload`.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cc3fadac1a039620f9a1c7f171aa4de77e909eb14d2d484e590fc96b610f3a5a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_7a159e8e57f24b04398a72bd268773387d08a15928978ba0a11b32dc39cc7a75","slc_8a6396745f1c0471c98db6dc14d3354c484752f63fa44056e4731481686efff7","slc_e8a8c2a64c134f8c31d4d8cd5fda75fbc5e02bc189ae23d315065d499c26420b","slc_fbb38c94796652c0e8cfb840ea53e5012fb404fea6e013d9b4c4757e8f2130e6"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"The extension exposes a `/boomerang <task>` command that executes a task autonomously and summarizes context afterward, plus `/boomerang-cancel` to abort without summarizing.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e0c6d478fe2aa23774b8688700c92310cceb9ed99265b213a2e13436287fb8ad","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_178d623a00371d9ad9d58b1cfba6240c2b80a5f629db6677811e6edcb6a9d0b4","slc_3e61438d497de148ef1e490b70cd7f2c409d89c11f2081b6d8c98c2df4e2c358","slc_91b737148b0dd47e3ea14a7b488afbf8ee9dae343eb5a857cab963fe48100a3b"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300","src_986d67ad853c554e97490ed72ab9cc64"],"text":"`--loop N` is treated as an alias for `--rethrow N`; if both flags are present `--rethrow` wins, loop metadata is stripped from rendered tasks, and bare `--loop` is invalid.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
{"access":"public","created_at":"2026-09-14T04:11:46Z","created_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f9d977542e326a78296791841676d7ddb29eb2d09f6f9524ebef378f6558c443","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"nicobailon/pi-boomerang@1a5985b2d92c snapshot f61ed095535cf80d","timeframe":null},"slice_ids":["slc_3bdad9991c5820ea7201318f74cecd6b3523bf8a9fb928ab1a9f4d80e91d9614","slc_6eaa044e8a9060859c922a84a7e5c220a72fa7c1561f0dbdf4453589c1d70487","slc_d099d65fb87103333a36e4a5130c6cdd1e972b4cab358b9d2d57e85033a62bc1"],"source_ids":["src_925c2e1ad1c957cf898dfa3a10e51300"],"text":"Tasks starting with `/` are treated as prompt templates loaded from `<cwd>/.pi/prompts/` then `~/.pi/agent/prompts/`, with subdirectories mapping to path segments; `$@` and `$1`/`$2` expand args.","updated_at":"2026-09-14T04:11:46Z","updated_by_operation":"op_6e95a19acaa34bc894ac2b53a84e8f4c"}
