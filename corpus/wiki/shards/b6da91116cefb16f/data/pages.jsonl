e":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"vocodedev/vocode-core","updated_at":"2026-09-14T04:31:45Z","updated_by_operation":"op_283b0054a97f41a9bfdfee6167c8edcb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_6000df28c4541a07313c0709c13ea804fbe26c3976299baa511f074dcf54a23c"],"opposing_claim_ids":[],"text":"An Enterprise-plan feature lets users connect their own OpenAI account via account connections and use custom or fine-tuned models through an openai_model_name_override agent parameter."}],"claim_ids":["clm_6000df28c4541a07313c0709c13ea804fbe26c3976299baa511f074dcf54a23c"],"created_at":"2026-09-14T04:31:45Z","created_by_operation":"op_283b0054a97f41a9bfdfee6167c8edcb","id":"pg_319ce18ef7935bef969c42ffbd585e3f","maturity":"draft","page_type":"source","path":"pages/sources/vocodedev-vocode-core-docs-bring-your-own-openai-mdx-e054c33a7278-42ffbd585e3f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0efc0ddde7355104b169d7102976f9a9"],"title":"vocodedev/vocode-core/docs/bring-your-own-openai.mdx @ e054c33a7278","updated_at":"2026-09-14T04:31:45Z","updated_by_operation":"op_283b0054a97f41a9bfdfee6167c8edcb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0df76e340b358da39d08cadc318614a1b41ebf0703fbb54750ca874f4ea62313"],"opposing_claim_ids":[],"text":"A hosted REST API at api.vocode.dev exposes endpoints such as /v1/actions/create and /v1/numbers/update with Bearer-token authentication, shown in Python, TypeScript, and cURL examples."},{"claim_ids":["clm_14a69fd5e9aa4cdfe323c078de6e61ff61da7e610e14ecc091c1802b026f5609"],"opposing_claim_ids":[],"text":"Actions fire via two trigger mechanisms: the default FunctionCallActionTrigger, where the agent decides based on prompting, or PhraseBasedActionTrigger, which fires after the bot speaks a configured phrase."}],"claim_ids":["clm_0df76e340b358da39d08cadc318614a1b41ebf0703fbb54750ca874f4ea62313","clm_14a69fd5e9aa4cdfe323c078de6e61ff61da7e610e14ecc091c1802b026f5609"],"created_at":"2026-09-14T04:31:45Z","created_by_operation":"op_283b0054a97f41a9bfdfee6167c8edcb","id":"pg_672b41bc0fb65b9da936d7d8186b0991","maturity":"draft","page_type":"source","path":"pages/sources/vocodedev-vocode-core-docs-actions-mdx-e054c33a7278-d7d8186b0991.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c52f5f5c0ff05bd2b9e93bf041eecbdb"],"title":"vocodedev/vocode-core/docs/actions.mdx @ e054c33a7278","updated_at":"2026-09-14T04:31:45Z","updated_by_operation":"op_283b0054a97f41a9bfdfee6167c8edcb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_14a69fd5e9aa4cdfe323c078de6e61ff61da7e610e14ecc091c1802b026f5609"],"opposing_claim_ids":[],"text":"Actions fire via two trigger mechanisms: the default FunctionCallActionTrigger, where the agent decides based on prompting, or PhraseBasedActionTrigger, which fires after the bot speaks a configured phrase."},{"claim_ids":["clm_cf11b136c8a82144e1ff2886eb3c9d6bc424ece6fa771e12d775b2f509b03dce"],"opposing_claim_ids":[],"text":"The only supported phrase-trigger condition type is 'phrase_condition_type_contains', which matches case-insensitively against the bot's spoken turn."}],"claim_ids":["clm_14a69fd5e9aa4cdfe323c078de6e61ff61da7e610e14ecc091c1802b026f5609","clm_cf11b136c8a82144e1ff2886eb3c9d6bc424ece6fa771e12d775b2f509b03dce"],"created_at":"2026-09-14T04:31:45Z","created_by_operation":"op_283b0054a97f41a9bfdfee6167c8edcb","id":"pg_6a97bc34f0be57bdb5a798e57b5374a6","maturity":"draft","page_type":"source","path":"pages/sources/vocodedev-vocode-core-docs-action-triggers-mdx-e054c33a7278-98e57b5374a6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dc8e0c85b3e351dda300287389d89846"],"title":"vocodedev/vocode-core/docs/action-triggers.mdx @ e054c33a7278","updated_at":"2026-09-14T04:31:45Z","updated_by_operation":"op_283b0054a97f41a9bfdfee6167c8edcb"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_187d21c4871adfb1d833f955a812ec9f161514c38fb363b94ec46312d317ae6f"],"opposing_claim_ids":[],"text":"Repository development practice: contributing is welcomed via a Contribution Guide and a roadmap file in the repo, with a Discord community for ideas and contributions, and the project seeks community maintainers."},{"claim_ids":["clm_439511c98d56f73f7f7db548c6068e46ca99ea540692f2ea6a03813347666a16"],"opposing_claim_ids":[],"text":"The quickstart configures settings (OpenAI, Azure, Deepgram keys) via pydantic-settings, overridable through environment variables or a .env file."},{"claim_ids":["clm_70c6c2da4e267b54ea274e165b360112b852453fc8b413c8e11e036d055bcdb3"],"opposing_claim_ids":[],"text":"A StreamingConversation composes a transcriber (e.g. Deepgram with punctuation endpointing), an agent (e.g. ChatGPTAgent with prompt and initial message), and a synthesizer (e.g. Azure)."},{"claim_ids":["clm_98441b90c9ba6b8d69b494593e6a869e75118b628af1caed10ad80d5afc72176"],"opposing_claim_ids":[],"text":"The library is installed via pip as the 'vocode' package and exposes a Python API including StreamingConversation, ChatGPTAgent, DeepgramTranscriber, and AzureSynthesizer."},{"claim_ids":["clm_abe44b3c00221e3daa5aed1796b2d6f5c02df2133a80fdcc30b22bf4f7baf0c5"],"opposing_claim_ids":[],"text":"Documented out-of-the-box transcription integrations include AssemblyAI, Deepgram, Gladia, Google Cloud, Azure, RevAI, Whisper, and Whisper.cpp; LLM integrations include OpenAI and Anthropic."},{"claim_ids":["clm_d2ab8a4f9033991bfa9270820bd1b6ae5562843ca4a543aef03676aa5f9ecc2d"],"opposing_claim_ids":[],"text":"Vocode is an open source library for building voice-based LLM apps, supporting real-time streaming conversations deployable to phone calls, Zoom meetings, and more."}],"claim_ids":["clm_187d21c4871adfb1d833f955a812ec9f161514c38fb363b94ec46312d317ae6f","clm_439511c98d56f73f7f7db548c6068e46ca99ea540692f2ea6a03813347666a16","clm_70c6c2da4e267b54ea274e165b360112b852453fc8b413c8e11e036d055bcdb3","clm_98441b90c9ba6b8d69b494593e6a869e75118b628af1caed10ad80d5afc72176","clm_abe44b3c00221e3daa5aed1796b2d6f5c02df2133a80fdcc30b22bf4f7baf0c5","clm_d2ab8a4f9033991bfa9270820bd1b6ae5562843ca4a543aef03676aa5f9ecc2d"],"created_at":"2026-09-14T04:31:45Z","created_by_operation":"op_283b0054a97f41a9bfdfee6167c8edcb","id":"pg_9de8bd6c7d9257fb99ec985ec7c71819","maturity":"draft","page_type":"source","path":"pages/sources/vocodedev-vocode-core-readme-md-e054c33a7278-985ec7c71819.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_175a0ce911c458ec9f58127bbf9fe95c"],"title":"vocodedev/vocode-core/README.md @ e054c33a7278","updated_at":"2026-09-14T04:31:45Z","updated_by_operation":"op_283b0054a97f41a9bfdfee6167c8edcb"}
