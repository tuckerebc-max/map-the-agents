59","maturity":"draft","page_type":"entity","path":"pages/entities/ise-uiuc-magicoder-edcc9ef89359.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"ise-uiuc/magicoder","updated_at":"2026-09-14T03:59:17Z","updated_by_operation":"op_a135aec11b8a4c5f85595c6b6e30b6e1"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_04fa35283f5d0c0c3668d9c5aa4cf857c01f2d7fda3b4a1354836c88e5dde203"],"opposing_claim_ids":[],"text":"Models are trained on synthetic data from OpenAI models, so users are directed to consider OpenAI's terms of use; the models are stated not to compete with OpenAI commercial products."},{"claim_ids":["clm_1a68a9f0d6b5a2d0d26c942a2eba31ee0e0d6c44cb06f532f62b307e331429e7"],"opposing_claim_ids":[],"text":"Magicoder is a family of code models built with OSS-Instruct, an approach that uses open-source code snippets to generate instruction data for code."},{"claim_ids":["clm_57f7f21ada92fbd5dc6bbefac25de08c0dc646b357623b4aabcc0c5b5c4d25c2"],"opposing_claim_ids":[],"text":"Models are prompted with a template containing a system-style preamble plus '@@ Instruction' and '@@ Response' sections, usable via a Hugging Face transformers text-generation pipeline."},{"claim_ids":["clm_6010f2b10222feb563e1e7d7fb1d7b46ac444feffd5a6e556c4031f159e92e69"],"opposing_claim_ids":[],"text":"The quick-start and demo code imply runtime dependencies on transformers, torch (bfloat16, CUDA device), and gradio."},{"claim_ids":["clm_7c6962959d5426a7c16d1f753046888594191b8984be38b6f421caae92ecbb35"],"opposing_claim_ids":[],"text":"The README warns that Magicoders may make errors, produce misleading content, or struggle with tasks unrelated to coding."},{"claim_ids":["clm_9f4b7da26647e13d2ecd2c3335944c76fdc9e8f3b6fc80dc0ee7451009c16ce4"],"opposing_claim_ids":[],"text":"Two datasets are published: Magicoder-OSS-Instruct-75K (generated with gpt-3.5-turbo-1106, used for both model series) and Magicoder-Evol-Instruct-110K (decontaminated redistribution of evol-codealpaca-v1, used for the -S models)."},{"claim_ids":["clm_b2543392a1cc9d0e416791fb19e3e844107dd88aba2ae419e478b4f1a22be3f2"],"opposing_claim_ids":[],"text":"The README reports HumanEval(+) and MBPP(+) scores per model, with Magicoder-S-DS-6.7B at 76.8 (70.7) on HumanEval(+), and claims it outperforms gpt-3.5-turbo-1106 and Gemini Ultra on HumanEval."},{"claim_ids":["clm_ba5ae804e9e253481c0f2304c95329e181bdde23b6ac3686015635cb5c2e7483"],"opposing_claim_ids":[],"text":"A hosted Gradio demo (Magicoder Playground) is available on Hugging Face Spaces, and a local Gradio demo server script is provided under demo/."},{"claim_ids":["clm_daf03888311fd7aa71a8380ff2f79d44d3182986256671abbee2febde7680be3"],"opposing_claim_ids":[],"text":"Four released models are listed: Magicoder-CL-7B and Magicoder-S-CL-7B (Llama2 license) and Magicoder-DS-6.7B and Magicoder-S-DS-6.7B (DeepSeek license), hosted on Hugging Face."},{"claim_ids":["clm_e77b1f1c9dfa1f589f71ad2f891fa3012967a4f90b32027f3153d3db17dbb278"],"opposing_claim_ids":[],"text":"Magicoder-DS models are built on DeepSeek-Coder base models and Magicoder-CL models on CodeLlama; StarCoder is credited for data decontamination."}],"claim_ids":["clm_04fa35283f5d0c0c3668d9c5aa4cf857c01f2d7fda3b4a1354836c88e5dde203","clm_1a68a9f0d6b5a2d0d26c942a2eba31ee0e0d6c44cb06f532f62b307e331429e7","clm_57f7f21ada92fbd5dc6bbefac25de08c0dc646b357623b4aabcc0c5b5c4d25c2","clm_6010f2b10222feb563e1e7d7fb1d7b46ac444feffd5a6e556c4031f159e92e69","clm_7c6962959d5426a7c16d1f753046888594191b8984be38b6f421caae92ecbb35","clm_9f4b7da26647e13d2ecd2c3335944c76fdc9e8f3b6fc80dc0ee7451009c16ce4","clm_b2543392a1cc9d0e416791fb19e3e844107dd88aba2ae419e478b4f1a22be3f2","clm_ba5ae804e9e253481c0f2304c95329e181bdde23b6ac3686015635cb5c2e7483","clm_daf03888311fd7aa71a8380ff2f79d44d3182986256671abbee2febde7680be3","clm_e77b1f1c9dfa1f589f71ad2f891fa3012967a4f90b32027f3153d3db17dbb278"],"created_at":"2026-09-14T03:59:17Z","created_by_operation":"op_a135aec11b8a4c5f85595c6b6e30b6e1","id":"pg_9833333dc6245d10a7dace6f178e9fdf","maturity":"draft","page_type":"source","path":"pages/sources/ise-uiuc-magicoder-readme-md-3ef43f0feaa2-ce6f178e9fdf.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0cbc439056455031a479acadd58a3459"],"title":"ise-uiuc/magicoder/README.md @ 3ef43f0feaa2","updated_at":"2026-09-14T03:59:17Z","updated_by_operation":"op_a135aec11b8a4c5f85595c6b6e30b6e1"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2c5bc321221fb56ffdaaaf4560e09b682c5d42a313497f8b70fc25ab2d8d611e"],"opposing_claim_ids":[],"text":"Repository development practice: Magicoder-S is produced by continuing training from the Magicoder checkpoint on Evol-Instruct data with a shorter max sequence length (1024 vs 1216), using bf16, adafactor, and linear LR scheduling."},{"claim_ids":["clm_7fde25c7385eb3c15f5ebabe7518367c9517bcbbd40d955c36827bb3fbb654cc"],"opposing_claim_ids":[],"text":"Repository development practice: the developer guide (marked WIP) documents a pipeline of scripts for data generation (generate_data.py with OPENAI_API_KEY), cleaning/decontamination, preprocessing, and instruction tuning via accelerate launch of magicoder.train."}],"claim_ids":["clm_2c5bc321221fb56ffdaaaf4560e09b682c5d42a313497f8b70fc25ab2d8d611e","clm_7fde25c7385eb3c15f5ebabe7518367c9517bcbbd40d955c36827bb3fbb654cc"],"created_at":"2026-09-14T03:59:17Z","created_by_operation":"op_a135aec11b8a4c5f85595c6b6e30b6e1","id":"pg_aa497cdb819453afbf86136800427a2b","maturity":"draft","page_type":"source","path":"pages/sources/ise-uiuc-magicoder-readme-dev-md-3ef43f0feaa2-136800427a2b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5b76a10c0c335058b120b52b342f74fd"],"title":"ise-uiuc/magicoder/README-DEV.md @ 3ef43f0feaa2","updated_at":"2026-09-14T03:59:17Z","updated_by_operation":"op_a135aec11b8a4c5f85595c6b6e30b6e1"}
