{"access":"public","created_at":"2026-09-14T01:52:26Z","created_by_operation":"op_45450b4980b74604b6daef981c8701c8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_be3324d5b9714a8e8ac2988c8b8dc6401a06e22005e5c6e9fd3d738342265382","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"gitlawb/zero@c1937dfac72e snapshot 20ad3944dceb5124","timeframe":null},"slice_ids":["slc_1a1ad52b9f5c651b9b474dc7d8a15a69d4c9fa9f92f18f52f2cf15194e60bab5"],"source_ids":["src_ae6d5e8ed8b0548596abde224658e4fd"],"text":"The web_fetch tool refuses loopback, private, and special-use addresses by checking the URL, resolving the host, and dialing the validated address to prevent DNS rebinding.","updated_at":"2026-09-14T01:52:26Z","updated_by_operation":"op_45450b4980b74604b6daef981c8701c8"}
