{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_12835b3581a8ee06b361d386a3427530e6fe681c6be566b795a534fede23bed5"],"opposing_claim_ids":[],"text":"OpenCode is installable via a curl script and many package managers including npm/bun/pnpm/yarn, Scoop, Chocolatey, Homebrew, pacman, AUR, mise, and nix."},{"claim_ids":["clm_8f729e7c537ee21ae268179046ee5dafdbcd30d81eea055a0f05f9e8f6a795e2"],"opposing_claim_ids":[],"text":"The README documents two built-in agents switchable with the Tab key: build (default, full access) and plan (read-only, denies file edits by default and asks before running bash commands), plus a general subagent invoked via @general."},{"claim_ids":["clm_e2c4a7e02780c99a606d0a060b9d957ee88177403dc648913f9761d6ebb17d7a"],"opposing_claim_ids":[],"text":"A desktop application is offered in BETA for macOS (arm64/x64 dmg), Windows exe, and Linux deb/rpm/AppImage, also installable via Homebrew cask or Scoop extras."},{"claim_ids":["clm_fb4a742c61058378a2a37f96f8b255894389ee4a827d408ef50887732cf8911a"],"opposing_claim_ids":[],"text":"The install script resolves its target directory by priority: OPENCODE_INSTALL_DIR, XDG_BIN_DIR, $HOME/bin, then $HOME/.opencode/bin as fallback."},{"claim_ids":["clm_fc1ca4942c79f5850132d0872162d751598a6781dfdd6f5ca83d9fa84d75c4bb"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are directed to read CONTRIBUTING.md before submitting pull requests, and derivative projects using 'opencode' in their name must state they are unaffiliated with the OpenCode team."}],"claim_ids":["clm_12835b3581a8ee06b361d386a3427530e6fe681c6be566b795a534fede23bed5","clm_8f729e7c537ee21ae268179046ee5dafdbcd30d81eea055a0f05f9e8f6a795e2","clm_e2c4a7e02780c99a606d0a060b9d957ee88177403dc648913f9761d6ebb17d7a","clm_fb4a742c61058378a2a37f96f8b255894389ee4a827d408ef50887732cf8911a","clm_fc1ca4942c79f5850132d0872162d751598a6781dfdd6f5ca83d9fa84d75c4bb"],"created_at":"2026-09-14T01:33:42Z","created_by_operation":"op_b1922a57b4274f1ebedf36621839c849","id":"pg_04da15216afa57529b88bdf3c4988757","maturity":"draft","page_type":"source","path":"pages/sources/anomalyco-opencode-readme-md-df23b7f9488a-bdf3c4988757.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f45e46cdb1725033a5de810b64cbcad3"],"title":"anomalyco/opencode/README.md @ df23b7f9488a","updated_at":"2026-09-14T04:57:56Z","updated_by_operation":"op_625d6526496849d087a88131eea300f8"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1176f09332c5614cc004d9b9eeb3ebd6559e421adfe33d32b6505671c4bdc9e1"],"opposing_claim_ids":[],"text":"An agent 'generate' capability creates new agent configurations from a natural-language description via a model generateObject call with a JSON schema (identifier, whenToUse, systemPrompt), avoiding existing agent names."},{"claim_ids":["clm_1b722a96998551c2e371ccd69cb681aff5ce7826205a90242f0e3ba809be73b9"],"opposing_claim_ids":[],"text":"The plan agent's permission config denies all edit tools except plan markdown files under .opencode/plans and the global plans data directory, and denies the general task subagent."},{"claim_ids":["clm_52653c22300f4bf762d55655160607ebada35949b0ede69d870973b2ed46199c"],"opposing_claim_ids":[],"text":"The agent implementation uses the Effect ecosystem (Effect, Context, Layer, Schema), the Vercel AI SDK (generateObject/streamObject), remeda, and OpenTelemetry tracing when experimental.openTelemetry is enabled."},{"claim_ids":["clm_7f26c1b592ffbe2129326498d0d5cce2264b8fc21bcb9f65126676d220a41058"],"opposing_claim_ids":[],"text":"The agent module defines default permission rules: wildcard allow, ask for doom_loop and external directories, deny for question and plan transitions, and ask for reading .env files while allowing .env.example."},{"claim_ids":["clm_bf240727f34ea7d66dad7a62252e6ffdd0813477d8cbf800033efacd24ee93ea"],"opposing_claim_ids":[],"text":"Agent configuration is a schema with name, description, mode (subagent/primary/all), permission ruleset, optional model, prompt, temperature, topP, steps, variant, color, and hidden fields."},{"claim_ids":["clm_f02872071bd0737ac15bb3d378e35a9ef8f52c8eda09471ede5acaf61b1d7ef8"],"opposing_claim_ids":[],"text":"Users can define custom agents in config; entries can disable built-ins or add new agents whose properties (model, prompt, permissions, mode, etc.) are merged over defaults."}],"claim_ids":["clm_1176f09332c5614cc004d9b9eeb3ebd6559e421adfe33d32b6505671c4bdc9e1","clm_1b722a96998551c2e371ccd69cb681aff5ce7826205a90242f0e3ba809be73b9","clm_52653c22300f4bf762d55655160607ebada35949b0ede69d870973b2ed46199c","clm_7f26c1b592ffbe2129326498d0d5cce2264b8fc21bcb9f65126676d220a41058","clm_bf240727f34ea7d66dad7a62252e6ffdd0813477d8cbf800033efacd24ee93ea","clm_f02872071bd0737ac15bb3d378e35a9ef8f52c8eda09471ede5acaf61b1d7ef8"],"created_at":"2026-09-14T01:33:42Z","created_by_operation":"op_b1922a57b4274f1ebedf36621839c849","id":"pg_50d1044e6cf45908a058ab414f01c169","maturity":"draft","page_type":"source","path":"pages/sources/anomalyco-opencode-packages-opencode-src-agent-agent-ts-df23b7f9488a-ab414f01c169.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e0d83cbec32e5a5397fe3c37998b1556"],"title":"anomalyco/opencode/packages/opencode/src/agent/agent.ts @ df23b7f9488a","updated_at":"2026-09-14T01:33:42Z","updated_by_operation":"op_b1922a57b4274f1ebedf36621839c849"}
