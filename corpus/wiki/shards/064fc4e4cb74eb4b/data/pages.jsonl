058","clm_8f729e7c537ee21ae268179046ee5dafdbcd30d81eea055a0f05f9e8f6a795e2","clm_9cd244ecc341f8f15c68a067fe2177e5916cb3901bdcc67957c0084961560d26","clm_bf240727f34ea7d66dad7a62252e6ffdd0813477d8cbf800033efacd24ee93ea","clm_d2adc8097b8bd0ef4ea7fbabdfb8bed7b1a3e2021af15b73cf1be3316352ab7c","clm_e2c4a7e02780c99a606d0a060b9d957ee88177403dc648913f9761d6ebb17d7a","clm_f02872071bd0737ac15bb3d378e35a9ef8f52c8eda09471ede5acaf61b1d7ef8","clm_fb4a742c61058378a2a37f96f8b255894389ee4a827d408ef50887732cf8911a","clm_fc1ca4942c79f5850132d0872162d751598a6781dfdd6f5ca83d9fa84d75c4bb"],"created_at":"2026-09-14T01:33:42Z","created_by_operation":"op_b1922a57b4274f1ebedf36621839c849","id":"pg_8342b02ab7e75144bba4bb349f22a39d","maturity":"draft","page_type":"entity","path":"pages/entities/anomalyco-opencode-bb349f22a39d.md","record_type":"page","review_state":"unverified","schema_version":"1.0","source_ids":[],"title":"anomalyco/opencode","updated_at":"2026-09-14T04:57:56Z","updated_by_operation":"op_625d6526496849d087a88131eea300f8"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T01:33:42Z","created_by_operation":"op_b1922a57b4274f1ebedf36621839c849","id":"pg_866b91ec654c51188c29dc4f5a97b120","maturity":"draft","page_type":"source","path":"pages/sources/anomalyco-opencode-readme-bn-md-df23b7f9488a-dc4f5a97b120.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e22116f9508153c788b95ac0a26fe6ce"],"title":"anomalyco/opencode/README.bn.md @ df23b7f9488a","updated_at":"2026-09-14T01:33:42Z","updated_by_operation":"op_b1922a57b4274f1ebedf36621839c849"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_645ac21eec51b4cff13e948c1f843e5af8a06e547f02ce06d3ac89ef6585cda7"],"opposing_claim_ids":[],"text":"The client architecture derives Promise and Effect SDK clients from a public HttpApi; an Embedded OpenCode host reuses the same router and handlers over an in-memory HTTP transport."},{"claim_ids":["clm_76811de7c97bae5ef508e5093e34fb07476bb588abef97791352c5e1feacb3af"],"opposing_claim_ids":[],"text":"CONTEXT.md flags that the legacy experimental.chat.system.transform plugin hook can arbitrarily mutate the baseline system prompt, and V2 plugins do not yet expose an equivalent hook."},{"claim_ids":["clm_9cd244ecc341f8f15c68a067fe2177e5916cb3901bdcc67957c0084961560d26"],"opposing_claim_ids":[],"text":"Tool outputs exceeding history limits are projected into bounded Model Tool Output, with full oversized output retained in a managed temporary file under a shared tool-output directory."},{"claim_ids":["clm_d2adc8097b8bd0ef4ea7fbabdfb8bed7b1a3e2021af15b73cf1be3316352ab7c"],"opposing_claim_ids":[],"text":"CONTEXT.md defines a session runtime where sessions preserve durable conversation history and assemble a System Context from typed Context Sources, with changes admitted as Mid-Conversation System Messages at safe provider-turn boundaries."}],"claim_ids":["clm_645ac21eec51b4cff13e948c1f843e5af8a06e547f02ce06d3ac89ef6585cda7","clm_76811de7c97bae5ef508e5093e34fb07476bb588abef97791352c5e1feacb3af","clm_9cd244ecc341f8f15c68a067fe2177e5916cb3901bdcc67957c0084961560d26","clm_d2adc8097b8bd0ef4ea7fbabdfb8bed7b1a3e2021af15b73cf1be3316352ab7c"],"created_at":"2026-09-14T01:33:42Z","created_by_operation":"op_b1922a57b4274f1ebedf36621839c849","id":"pg_88b85824ac8f5bc19d8a160a4c04871f","maturity":"draft","page_type":"source","path":"pages/sources/anomalyco-opencode-context-md-df23b7f9488a-160a4c04871f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5ada12a6318b55cfa754