{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_040524f28ef577b0fb44702f800c2163d6541316712c0dc646b260d13bb1a6fa"],"opposing_claim_ids":[],"text":"Repository development practice: conventional commit message formats (feat, fix, docs, refactor, test) are required, with ESLint, Prettier, and TypeScript recommended for code style."},{"claim_ids":["clm_a78f09f49530523a8a7f742d65b83a29b4d00c688de46c77b8cbe77d2a69300c"],"opposing_claim_ids":[],"text":"The project structure includes an Electron main process, preload scripts, a Vue.js renderer, scripts, resources, tests, and docs directories."},{"claim_ids":["clm_e84f28194cc92622bfc81ff3c0263019803d26535915967c1f8680a27840f772"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork the repo, branch from main, and submit PRs that require approval from at least one maintainer before merging."}],"claim_ids":["clm_040524f28ef577b0fb44702f800c2163d6541316712c0dc646b260d13bb1a6fa","clm_a78f09f49530523a8a7f742d65b83a29b4d00c688de46c77b8cbe77d2a69300c","clm_e84f28194cc92622bfc81ff3c0263019803d26535915967c1f8680a27840f772"],"created_at":"2026-09-14T02:00:13Z","created_by_operation":"op_f903ac8e31314b6f91abf20d8d8cfa4c","id":"pg_8ea4c6340af45835956c88756e9f4447","maturity":"draft","page_type":"source","path":"pages/sources/chaterm-chaterm-contributing-zh-md-1ca378cb7eda-88756e9f4447.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5d22c1dcd9615b1e89de921539bb2fca"],"title":"chaterm/Chaterm/CONTRIBUTING_zh.md @ 1ca378cb7eda","updated_at":"2026-09-14T02:00:13Z","updated_by_operation":"op_f903ac8e31314b6f91abf20d8d8cfa4c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_51f4c8629351baabaacebe70bd708a25fc6a16d20ba49026ccaca0480a6ebccc"],"opposing_claim_ids":[],"text":"Settings allow configuring per-model context window and maximum output tokens, used for both context management and API requests."},{"claim_ids":["clm_58a23a26a818eec81554d72339cea619a28d90c9f64958e2668ab9fd58999ed4"],"opposing_claim_ids":[],"text":"The product claims long-term memory and team knowledge bases from which it learns team knowledge and user habits."},{"claim_ids":["clm_59e9906f04d4363da295ab52406dba8a486558d8e724ef08acb96c867595cf4f"],"opposing_claim_ids":[],"text":"A database workspace supports connecting to MySQL, PostgreSQL, SQLite, and Oracle for schema browsing, queries, DDL inspection, row editing, and database-aware AI assistance."},{"claim_ids":["clm_69de236be9a4ce11db71fe6ba5e26820c5e30b33da666d951919455078afd177"],"opposing_claim_ids":[],"text":"Portions of the AI Agent system are adapted from Cline, and RTK is used for command output filtering to reduce token usage in agent workflows."},{"claim_ids":["clm_95241ed94d0eca9a272a200df12a28d6a627ff8ffcc033ea4cee4f9314ffc2c6"],"opposing_claim_ids":[],"text":"The agent is documented to understand targets, autonomously plan, and perform multi-host problem analysis and root-cause localization, closing the loop on complex processes."},{"claim_ids":["clm_95a4686d2b5ff45cf122b813227919d7019167f9714d232cd4349b1fc544a2de"],"opposing_claim_ids":[],"text":"Chaterm is described as an AI-native terminal for infrastructure and cloud resource management, letting engineers perform tasks like deployment and troubleshooting via natural language."},{"claim_ids":["clm_b71903cc7194bf5d4544131350e9c972687ea2ed6f0444970de73485be117e7c"],"opposing_claim_ids":[],"text":"Agent Skills encapsulate complex maintenance procedures into reusable AI skills for structured, reliable automated execution."},{"claim_ids":["clm_dea4d502b43f17ab330ed718c5b4ea42944b354faa906807dfa1a3e04afda5ac"],"opposing_claim_ids":[],"text":"Knowledge retrieval combines vector and keyword search using RRF fusion into a unified ranking, with visible embedding, hybrid search, and reranking stages."},{"claim_ids":["clm_e6d4dc258bf08c3895dd83abdae0cf7f3499b3fb24416bcea3dcb298055d9ef6"],"opposing_claim_ids":[],"text":"New retrieval configurations default to Qwen-Plus in the China edition and Gemini 2.5 Flash in the global edition for reranking."}],"claim_ids":["clm_51f4c8629351baabaacebe70bd708a25fc6a16d20ba49026ccaca0480a6ebccc","clm_58a23a26a818eec81554d72339cea619a28d90c9f64958e2668ab9fd58999ed4","clm_59e9906f04d4363da295ab52406dba8a486558d8e724ef08acb96c867595cf4f","clm_69de236be9a4ce11db71fe6ba5e26820c5e30b33da666d951919455078afd177","clm_95241ed94d0eca9a272a200df12a28d6a627ff8ffcc033ea4cee4f9314ffc2c6","clm_95a4686d2b5ff45cf122b813227919d7019167f9714d232cd4349b1fc544a2de","clm_b71903cc7194bf5d4544131350e9c972687ea2ed6f0444970de73485be117e7c","clm_dea4d502b43f17ab330ed718c5b4ea42944b354faa906807dfa1a3e04afda5ac","clm_e6d4dc258bf08c3895dd83abdae0cf7f3499b3fb24416bcea3dcb298055d9ef6"],"created_at":"2026-09-14T02:00:13Z","created_by_operation":"op_f903ac8e31314b6f91abf20d8d8cfa4c","id":"pg_8f88a5be051050688280daf1ddbe68ac","maturity":"draft","page_type":"source","path":"pages/sources/chaterm-chaterm-readme-md-1ca378cb7eda-daf1ddbe68ac.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f2db61a640355e05912d2c435139294b"],"title":"chaterm/Chaterm/README.md @ 1ca378cb7eda","updated_at":"2026-09-14T02:00:13Z","updated_by_operation":"op_f903ac8e31314b6f91abf20d8d8cfa4c"}
