{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0e3a016b1349fb661a4c0363bce2456acc990b786e32e0fdb8b74480f99c0445"],"opposing_claim_ids":[],"text":"The database schema defines users with an access-type enum of user/admin, repositories keyed by provider repo id, and guidelines with content, creator, and timestamps."}],"claim_ids":["clm_0e3a016b1349fb661a4c0363bce2456acc990b786e32e0fdb8b74480f99c0445"],"created_at":"2026-09-14T04:17:13Z","created_by_operation":"op_ab2ca8a1fe69400c82e3a088ea237c1a","id":"pg_151ddf8af82e5393b39ff3955c8540d5","maturity":"draft","page_type":"source","path":"pages/sources/quack-ai-companion-docs-dbdiagram-txt-ce9a10ac7924-f3955c8540d5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0606bfd3afc9586ebf6217bacc9dbe3e"],"title":"quack-ai/companion/docs/dbdiagram.txt @ ce9a10ac7924","updated_at":"2026-09-14T04:17:13Z","updated_by_operation":"op_ab2ca8a1fe69400c82e3a088ea237c1a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1b6dc6061f77c2bf20fd6b580f0959a4b8dc19abef8b668e8e302da4f15f4dda"],"opposing_claim_ids":[],"text":"Repository development practice: docs changes deploy to production automatically on push to the default branch, and pull requests generate preview links."},{"claim_ids":["clm_f192e86daf0e6ef7398a3457fb27e3d7f8d865b4e154e389b01f9c77c126c970"],"opposing_claim_ids":[],"text":"Repository development practice: docs contributors install the Mintlify CLI globally and run 'mintlify dev' in the folder containing mint.json to preview changes locally."}],"claim_ids":["clm_1b6dc6061f77c2bf20fd6b580f0959a4b8dc19abef8b668e8e302da4f15f4dda","clm_f192e86daf0e6ef7398a3457fb27e3d7f8d865b4e154e389b01f9c77c126c970"],"created_at":"2026-09-14T04:17:13Z","created_by_operation":"op_ab2ca8a1fe69400c82e3a088ea237c1a","id":"pg_5520eb410df15498b63c6dc9a54f09cb","maturity":"draft","page_type":"source","path":"pages/sources/quack-ai-companion-docs-readme-md-ce9a10ac7924-6dc9a54f09cb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c46dcb55b53e5cd58ebe8e9177c12a62"],"title":"quack-ai/companion/docs/README.md @ ce9a10ac7924","updated_at":"2026-09-14T04:17:13Z","updated_by_operation":"op_ab2ca8a1fe69400c82e3a088ea237c1a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0a7b2c2a1c47d5470773e1fc2e962cdb5331c1dfa017704324a31ac9c8bb8e4d"],"opposing_claim_ids":[],"text":"The product exposes a REST API for guideline management and LLM inference, browsable via Swagger docs at localhost:5050/docs or through HTTP requests."},{"claim_ids":["clm_4530cec3cddd4e68c27607137f5dd083f721264c868049af5ec0433fce43a2da"],"opposing_claim_ids":[],"text":"A code chat endpoint is offered as a coding-specific LLM chat, with the backend API acting as gatekeeper for an Ollama-powered inference container."},{"claim_ids":["clm_7cb942447a13189d9f297255c689e772652df493ae1b9c3acd8a1c542e9094a5"],"opposing_claim_ids":[],"text":"Running the service requires Git, Docker, Docker Compose, and the NVIDIA Container Toolkit with a GPU of at least 6 GB VRAM for good latency."},{"claim_ids":["clm_9defe6bf36c82621edfc5fea7eca0ad5ea4085b320ae4fea1315123ad36f3b82"],"opposing_claim_ids":[],"text":"Quack Companion targets software teams, acting like an onboarded team member with knowledge of internal libraries and coding standards, and is positioned against GitHub Copilot with team-guideline context."},{"claim_ids":["clm_d0c2a2898f9f9ef3d08827e52a68b8953193e960ded1b6d40c0186ff94f60961"],"opposing_claim_ids":[],"text":"A deployment includes a backend API on port 5050, an APM dashboard on port 3000, and a Gradio chat interface on port 7860."}],"claim_ids":["clm_0a7b2c2a1c47d5470773e1fc2e962cdb5331c1dfa017704324a31ac9c8bb8e4d","clm_4530cec3cddd4e68c27607137f5dd083f721264c868049af5ec0433fce43a2da","clm_7cb942447a13189d9f297255c689e772652df493ae1b9c3acd8a1c542e9094a5","clm_9defe6bf36c82621edfc5fea7eca0ad5ea4085b320ae4fea1315123ad36f3b82","clm_d0c2a2898f9f9ef3d08827e52a68b8953193e960ded1b6d40c0186ff94f60961"],"created_at":"2026-09-14T04:17:13Z","created_by_operation":"op_ab2ca8a1fe69400c82e3a088ea237c1a","id":"pg_7dd2e5698f8c57cb951bdf9f50761b48","maturity":"draft","page_type":"source","path":"pages/sources/quack-ai-companion-readme-md-ce9a10ac7924-df9f50761b48.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_46bdd9a644f35a928458901f0c83808a"],"title":"quack-ai/companion/README.md @ ce9a10ac7924","updated_at":"2026-09-14T04:17:13Z","updated_by_operation":"op_ab2ca8a1fe69400c82e3a088ea237c1a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9defe6bf36c82621edfc5fea7eca0ad5ea4085b320ae4fea1315123ad36f3b82"],"opposing_claim_ids":[],"text":"Quack Companion targets software teams, acting like an onboarded team member with knowledge of internal libraries and coding standards, and is positioned against GitHub Copilot with team-guideline context."},{"claim_ids":["clm_dd64fc060e3d56266bf5a6177c8de4845c82d069cec515b103c81fceaa50123a"],"opposing_claim_ids":[],"text":"The community edition lets users choose their own locally-run open-source models; recommended options include Deepseek Coder 6.7B, Gemma 7b, and Dolphin Mistral 7b."},{"claim_ids":["clm_ffeca12d02198a8f54567589c2e7b13e84e4f40f8ee2ef663145bc5a4f04d09a"],"opposing_claim_ids":[],"text":"IDE support currently covers VSCode only, with other development environments planned gradually; the best-supported languages so far are Python and JavaScript/TypeScript."}],"claim_ids":["clm_9defe6bf36c82621edfc5fea7eca0ad5ea4085b320ae4fea1315123ad36f3b82","clm_dd64fc060e3d56266bf5a6177c8de4845c82d069cec515b103c81fceaa50123a","clm_ffeca12d02198a8f54567589c2e7b13e84e4f40f8ee2ef663145bc5a4f04d09a"],"created_at":"2026-09-14T04:17:13Z","created_by_operation":"op_ab2ca8a1fe69400c82e3a088ea237c1a","id":"pg_7e91d51a237e58ff93442ae494e3e506","maturity":"draft","page_type":"source","path":"pages/sources/quack-ai-companion-docs-community-faq-mdx-ce9a10ac7924-2ae494e3e506.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d6bad29ab8f556d9a5df48ff0ce7fb13"],"title":"quack-ai/companion/docs/community/faq.mdx @ ce9a10ac7924","updated_at":"2026-09-14T04:17:13Z","updated_by_operation":"op_ab2ca8a1fe69400c82e3a088ea237c1a"}
