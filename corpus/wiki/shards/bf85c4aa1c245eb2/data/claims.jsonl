{"access":"public","created_at":"2026-09-14T02:30:06Z","created_by_operation":"op_cbfe3869314a491a8ba9d5b0e6b29aba","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_47c97e0b1ae495ff5fae8d6fddbe51100710e2bb64f6f148d2c16c25253a876b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"patrickdappollonio/dux@14e044d616d2 snapshot 9cf959f4d95c8dad","timeframe":null},"slice_ids":["slc_a0e53428f30f429a8da3ac32652ed05644b9b5a3da8f78eabc5bf0ff62264bab","slc_daf7bc18697317645778c51d14afb71d2f1c20df0b23283f73d45d4de86d6d0d","slc_f26ab04840d2f2379d2a2a6f82156cf69a3c57ff50ec62348b968b915ebd1e74"],"source_ids":["src_1a20a257cf9e59208174d271dbe9b397"],"text":"Projects support a startup command run in the new worktree before the provider launches, with env expansion, DUX_* environment variables, and log/rerun palette commands; failure does not block agent creation.","updated_at":"2026-09-14T02:30:06Z","updated_by_operation":"op_cbfe3869314a491a8ba9d5b0e6b29aba"}
{"access":"public","created_at":"2026-09-14T02:30:06Z","created_by_operation":"op_cbfe3869314a491a8ba9d5b0e6b29aba","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_566f79842b0096c0e360c3a6e5a49fc17ac9911db93c1d27b585f4916483cb45","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"patrickdappollonio/dux@14e044d616d2 snapshot 9cf959f4d95c8dad","timeframe":null},"slice_ids":["slc_1789a3ee30121e9a13c3dbc7e064098620812ef91c88186c9e7fb9f4bcdc84ed","slc_219e0ea35efffcc2dde76a13eae14c891f0831cd8d4b93c80589f4456f32a310","slc_ad756fed77c2db775b65ba8f836be9e43451373d9c3937f1f5502d069a95c74d","slc_deae41cdbe1038acaec5ceb4092c48968a093875286899141b9e376bec9f0238"],"source_ids":["src_fbc4e6918b155fc1ad9b2ebbf18cdfb8"],"text":"Repository development practice: the src/app/ TUI is split into focused submodules (mod.rs, input.rs, render.rs, sessions.rs, workers.rs), and changes should stay scoped to the relevant submodule.","updated_at":"2026-09-14T02:30:06Z","updated_by_operation":"op_cbfe3869314a491a8ba9d5b0e6b29aba"}
{"access":"public","created_at":"2026-09-14T02:30:06Z","created_by_operation":"op_cbfe3869314a491a8ba9d5b0e6b29aba","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6af25d1b0d573d5832195e4efa762443efcd4a1ab5def7154d4b4ce7cb011643","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"patrickdappollonio/dux@14e044d616d2 snapshot 9cf959f4d95c8dad","timeframe":null},"slice_ids":["slc_27138a0a64bf17be2c6b9b299ae880863acb7df1e80b971d751806741af68df4","slc_9cf52b50b7cc333781a80a260d2803a7f110345976c4b6e17e027b203383df1d"],"source_ids":["src_1a20a257cf9e59208174d271dbe9b397"],"text":"The right pane provides git staging: stage/unstage files, view syntax-highlighted diffs, write commit messages, push, and pull; AI commit-message drafting uses the provider in oneshot mode with a customizable prompt.","updated_at":"2026-09-14T02:30:06Z","updated_by_operation":"op_cbfe3869314a491a8ba9d5b0e6b29aba"}
