{"access":"public","created_at":"2026-09-14T04:24:22Z","created_by_operation":"op_705275a69d2d4ab6903bf4ce6c686445","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_49ca772a38e6eff8ef8ae591fa0ce3d07c2bbbbc0c1d79b39fe631c0b77879b7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"sudo-tee/opencode.nvim@636a26425227 snapshot 166e3c2d123d18b6","timeframe":null},"slice_ids":["slc_4300aee06e89ff7c49826953b83fce178c5d7b730f078118f341c64a61d3c26f"],"source_ids":["src_a2bbf80420c95f7ca096a720cb368939"],"text":"A dedicated chat panel window inside Neovim shows previous messages and responses and uses workspace/editor state as context for iterating on code.","updated_at":"2026-09-14T04:24:22Z","updated_by_operation":"op_705275a69d2d4ab6903bf4ce6c686445"}
