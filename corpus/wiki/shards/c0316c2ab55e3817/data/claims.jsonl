{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0c40d1f24190c39551ddf0eb50288376fb4e688991a5948ac280ddf563a1f0c2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_4cfab7f8bdbbc5f788a93691b64f3b3ca938b81ae7cdff7a12ba04b81137f284"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"A local-network collaboration feature shares loom sessions over WebSocket so team members can sync edits and model outputs without internet.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1aff519aae4c3939f1ef7a30b22f53aab0adc822cbaa6d4f0c5d110f2533646f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_64acab42e088cef2d40acc15d4a46f86576a87b0c58f85ee9487ba18002c03b1","slc_d4527a7dd3b328ea985629a0031f49c058f9ea5b35d4147d0ca0e3ab681dec8d"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"Inference runs via local backends including llama.cpp, ExLlama, and MLX, and models can be imported from Hugging Face, Ollama, or local GGUF/GPTQ files.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1f71f80423c143f50d67feb1216a3efc34453e6cfbfe1b8add349f0fc79d3414","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_3ae7209cf3981876d533f2c799c84e1c20d43407c7b6f0c01b555792937b55c1","slc_b86d4a62460c880bd0bc96e22b97a116ce3fafb17fc8575314710ed6c09ebc6f"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"A 'loom' concept assigns a main 'warp' model for heavy tasks and auxiliary 'weft' models for fast tasks, with a cross-thread shuttle passing tokens between threads.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_244f13b9d2eafcb0a93e09e9685de9f6edb0c1b608f1af51d9bcd9f6bdf14edd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_12208baa22f9bbb50b32295415da6ba80a43dab8c6df5e0e687349b8ade619ba","slc_dc7b72170fdf9a2f1aa9d7f88f99e2dc513d4751071d285c4828acf280e0ad6e"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"The project is MIT-licensed, and a disclaimer notes that orchestrated models carry their own licenses and usage terms for which users are responsible.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_32a706b7df033f96e32085a3c5c379ef89a7b6dcd4cdf236c9b3d20a2ce2b8df","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_dc57561aef2503991d08934b237efe5fa7fd21c3995c6e49e0007f2645285e58","slc_e10bc026d6a1b26b2f7e6726fea43c00af9d725fe3fb3b95e43d645817209b5c"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"CodeLoom is designed as an offline-only desktop tool that runs multiple open-source models locally with no cloud dependencies or data leaving the machine.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_35c508f0a0ac363d91d79f270924eb2de42200a2c0f73dc8c1cd12c9d81d5a9a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_7583e31cf9a1bc28dc402cc43f56b5e4ccbd1fdef3d9c1e49f9fa4573d451f8a"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"Advanced users can write custom 'loom scripts' in Lua that define model interactions, thread switching, and output merging.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5c841f4ee2958fee2f9985721b5678c5ba1ab77cfcd5b8451699182023252f48","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_4e3db7b3426d4ed5a6fe5d95cf29bd16499f3d147660a64dc0f86b25a1d4ab73"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"The app indexes a codebase as context up to 100k tokens and splits it across model threads so each model sees a relevant slice.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9ee4ea1bd53bc51a05e76708d5c818440eab719c683f18c2618a5c63107bc042","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_38676d550433cba4192ca0905b4353cc845bf4822cce280fff5b7e949c3edb7f"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"Stated system requirements: 16 GB RAM minimum (32 GB recommended), 6 GB VRAM minimum (12 GB+ recommended), 10 GB storage, on Windows 10, macOS 12+, or Linux kernel 5.x.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d6206c565ced58d367136d55323c4ceb868fff078f43f912fbc96d707a4d5259","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_1e6a1e5e854913dd18b6066828ec760e46d25ff8e03caa15f32cebc3c4f8c1af","slc_4dd349e71f10148b474fd1cb5cc947b13b35cc2571b675304557899570825627","slc_b39b10e1e87cd17138624446da1640b3796b44e73bef52e9078da28f29f22465"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"Per the FAQ, there is no cloud version by design, updates are manual downloads that only check a URL for version strings, and 7B models at 4-bit need at least 6 GB VRAM.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_dc3d49f4d72e0242de79b014c31f7bc95b2f7ad73c8a491f7b2241555105694e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_92410b69a3b7aaf5c50221e4d42258e7fdc1d6e9557ff656f8a48d1748439cb0"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"The product supports up to five concurrent model sessions, each with its own context window, history, and parameters, and lets the user pick which thread's answer wins.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e23daa62e7c7ef158479c5e0c7640cd2454827c82c0006d018a3125029978433","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_1602127c9e406af781742649f22140f6212f9c0aa90631e74728aec207943eab","slc_bb12d15417cb50538ab37eed6cf8238c3e7fae27b5f5b256f238c2ac845291f7"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"Configuration is exposed through a loom_config.yaml file covering per-task model assignments, token budgets, sampling parameters, context-sharing rules, theme, and LAN-only remote access.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
{"access":"public","created_at":"2026-09-14T02:18:48Z","created_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_eede548c2c423cda8a9059c4286058050856f6a2402abcb014b28953613f2659","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"mikotokawaii25/local-ai-code-assistant@1ca5630df925 snapshot 0b528688abe8a25c","timeframe":null},"slice_ids":["slc_714def682d03d4abf01056d09b33f9f7096ccf49a18117edc74fe81bdcc79e43"],"source_ids":["src_d18a0c72988a5000a5d3a24638a8c621"],"text":"Context can be merged between model threads manually or automatically, e.g. passing a small model's draft to a larger model without copy/paste.","updated_at":"2026-09-14T02:18:48Z","updated_by_operation":"op_883a3d32c4314e0091c35c5f46220ff2"}
