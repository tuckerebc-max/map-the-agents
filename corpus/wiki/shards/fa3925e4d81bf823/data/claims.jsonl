{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_28a390ed4616a085c05558bea2c20495b5f70a3aa95d208eb196e26f2b162aa0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_87eb90a2e6f85b11250009a93a77f38f4e29841272819fd1510f82f47e2dd991"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"Requires Neovim 0.10+ and a globally installed pi binary, installed via a curl script; models must be available in pi.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_51a9c1b91ad342590ec9159e66c0fad19de7bc4aa6eb16e11e3a7710982eb3e6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_43275e86646ff4625a7799098841f5575442ea4066df6d16bfa0e4876caa7c3d"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"Setting a custom system_prompt overrides pi's generated baseline instructions, which the README flags as something to use with care.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5b36b0ea4a337697cb3b8da3f5f2956ba55038e9f6355dc951a6aabf620967bd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_2cb68cfa93c0c9c0eb4c2b36d07f9b676976e34ae13729ef49e3a5a04728d2ec"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"Status updates use nvim-notify or mini.notify when available, falling back to a floating status window otherwise.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_62ad7e0089384df6254c03da4eb470dacf1fc945e1bed692886c4dcb1aed1a3f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_43275e86646ff4625a7799098841f5575442ea4066df6d16bfa0e4876caa7c3d"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"The tools option lets users restrict pi's tools; read, edit, and write are always enabled, and an empty list disables bash.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6618eb0df2f2fd1ff23c07c8c861a578638e68cc71e2fc064fed57c622218136","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_1c2b74ad001adff9b92c8eb158fd500e732a629ef4e37fcb4c059e9c5167d6d8","slc_43275e86646ff4625a7799098841f5575442ea4066df6d16bfa0e4876caa7c3d"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"The plugin wraps the external pi CLI binary (default \"pi\", configurable to a custom path or wrapper command array) rather than implementing the agent itself.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_69a750720892e130c64a1c2becf3f1138e584f8770b09cf3532caa2634c0953e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_2cb68cfa93c0c9c0eb4c2b36d07f9b676976e34ae13729ef49e3a5a04728d2ec"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"Requests run asynchronously so editing stays nonblocking, and changed loaded buffers are reloaded after successful pi edits.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a4fe14f010e1d0b7237efcdaac5abdd9fc6c503e8d1d25323645ee0c79e65e94","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_b7cdc0a1866dcd7a128c854582f59cbbf6c105b5d23fa24688b85a59700d0a83"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"The plugin exposes four user commands: :PiAsk (normal mode, prompts and sends buffer context), :PiAskSelection (visual), :PiCancel, and :PiLog which opens a session log split.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a7db40426f031c7e0e8272dc339cf8e356cfd0a106f3e1396a92f06ee7fb8f4a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_618c103d24734e3b8c49eb21d2522978f87262b9272b371a769ad359e5309294","slc_8ca332c9eb81ae57a9d998871ca6c50f0cf94f9ff6401a108362f6f969c67fd2","slc_d3b7153eff32df3fe5f1e46f148e3da1ebac4c670f44365ae7e33b3de8350b6f"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"A Lua setup API is documented via require(\"pi\").setup with all options optional, plus programmatic get_cmd() and run() functions.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bb1cd15dba29e82634dbb26b02229ed71cc9bab73fa7bb46298fd724c3a57c5d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_2cb68cfa93c0c9c0eb4c2b36d07f9b676976e34ae13729ef49e3a5a04728d2ec","slc_43275e86646ff4625a7799098841f5575442ea4066df6d16bfa0e4876caa7c3d"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"Oversized context is trimmed (default max 24000 bytes) for speed rather than always sending the full file.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d77bfa6588d952a8cbbe61cce0cd8d11581593368eb685a00d10818ad53f2ddc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_1c2b74ad001adff9b92c8eb158fd500e732a629ef4e37fcb4c059e9c5167d6d8","slc_43275e86646ff4625a7799098841f5575442ea4066df6d16bfa0e4876caa7c3d"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"Configuration options include binary path, provider, model, thinking level (off through xhigh), tools list, system prompts, and context sizing knobs like max_bytes and surrounding_lines.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e3d7c9a0bafda0c239d62511456a473786c1c82887005c5f7070fe56e0d8780a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_6e3964015347fd9d0001e12da9d401061b5964dd07dbce49dc6f5ecfd58ce2a0","slc_bf99cd583b056fca3ff1e6834833d26f7178ba0f809c577bbea61984f5850e60","slc_dfe17eb23a44bdd9ebea21577973912dd0a1ca0640ca6ec2ac10eb0661c60be7"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"No default keymaps are set; users configure their own, with example mappings for :PiAsk and :PiAskSelection provided.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
{"access":"public","created_at":"2026-09-14T04:15:03Z","created_by_operation":"op_e9d09684f4324352949843380a917974","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_eabac3ec142aeca91f8738484861ea3c1896c9a0de38ff28044478d7cbad3ca9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"pablopunk/pi.nvim@fab2a7932a54 snapshot 91394a9b37fe7fe2","timeframe":null},"slice_ids":["slc_13b51a0df80a6b64af9db1d4880b9d5a5e2510b2001a52236aa9f9ae92a85bba","slc_2cb68cfa93c0c9c0eb4c2b36d07f9b676976e34ae13729ef49e3a5a04728d2ec"],"source_ids":["src_d5f093c182785dbcb8b593ed8c1bf86f"],"text":"Context sent to pi includes the current buffer, cwd, selection, and optionally LSP/linter diagnostics via vim.diagnostic, with unsaved buffer content treated as the source of truth over disk.","updated_at":"2026-09-14T04:15:03Z","updated_by_operation":"op_e9d09684f4324352949843380a917974"}
