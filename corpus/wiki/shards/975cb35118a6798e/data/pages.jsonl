{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_17845ea1e0a1cbc74a76502d12642592ac0cddb0c1a68f579f9514b0ae03d936"],"opposing_claim_ids":[],"text":"All data is stored locally as plain Markdown with no proprietary formats, so users can inspect, edit, back up, or delete everything."},{"claim_ids":["clm_3edb3165d93930470844bc7caf2b84c78e274f2fa6c8817a57a1e76afb8fced5"],"opposing_claim_ids":[],"text":"Optional features use API keys in ~/.rowboat/config JSON files: Deepgram (voice input), ElevenLabs (voice output), Exa (search), and Composio (external tools/MCP servers), all sharing an apiKey format."},{"claim_ids":["clm_400d016aeab93ea766cd79365bb9b1df2f13650a07eb6b9f53a4c81240f174b6"],"opposing_claim_ids":[],"text":"The product indexes email, meetings, Slack and assistant conversations into a living, Obsidian-style backlinked knowledge graph used as long-lived, accumulating context."},{"claim_ids":["clm_485e67bbb31a030edaa0ec59643d1356960419562b52e2023b92e9db0859dfdb"],"opposing_claim_ids":[],"text":"External tools connect via Model Context Protocol; servers are configured under Settings → MCP Servers as an mcpServers JSON object, using an existing Streamable HTTP client."},{"claim_ids":["clm_5a65903fed2e11449a1d9a891ae2099b714b058dc6b9f8c773cb7938c58e21c6"],"opposing_claim_ids":[],"text":"A local meeting note-taker captures mic and speaker audio, produces a live transcript, summarizes to a markdown file, and updates the knowledge graph."},{"claim_ids":["clm_7bf18f86d3109cd019521b6bee9ccc4f6a2f7c646aab94679212c50e23b61a03"],"opposing_claim_ids":[],"text":"Background agents can run on events (e.g. new email) or schedules, connect to tools, search the web, use the browser, and write code via Claude Code or Codex."},{"claim_ids":["clm_b05bae2cdc053b2594511cfcde4bd63321f391bd82cb0146c326b2350941397e"],"opposing_claim_ids":[],"text":"Rowboat supports bring-your-own-model: local models via Ollama or LM Studio or hosted providers with the user's own API key, swappable anytime."},{"claim_ids":["clm_bfa152802082c801684cc249c671de796535c4e232ab462bda4bac783bcd45c1"],"opposing_claim_ids":[],"text":"Rowboat ships built-in work surfaces including an email client, notes, browser, code mode, meeting note taker, and per-project workspaces."},{"claim_ids":["clm_d5039186183a71e0f1ad25ad538694bbd60e8e83262b99077a9c58b4630a4271"],"opposing_claim_ids":[],"text":"MCP tool invocation is subject to the user's MCP tool permissions, per the Parallel web-search example."}],"claim_ids":["clm_17845ea1e0a1cbc74a76502d12642592ac0cddb0c1a68f579f9514b0ae03d936","clm_3edb3165d93930470844bc7caf2b84c78e274f2fa6c8817a57a1e76afb8fced5","clm_400d016aeab93ea766cd79365bb9b1df2f13650a07eb6b9f53a4c81240f174b6","clm_485e67bbb31a030edaa0ec59643d1356960419562b52e2023b92e9db0859dfdb","clm_5a65903fed2e11449a1d9a891ae2099b714b058dc6b9f8c773cb7938c58e21c6","clm_7bf18f86d3109cd019521b6bee9ccc4f6a2f7c646aab94679212c50e23b61a03","clm_b05bae2cdc053b2594511cfcde4bd63321f391bd82cb0146c326b2350941397e","clm_bfa152802082c801684cc249c671de796535c4e232ab462bda4bac783bcd45c1","clm_d5039186183a71e0f1ad25ad538694bbd60e8e83262b99077a9c58b4630a4271"],"created_at":"2026-09-14T02:36:26Z","created_by_operation":"op_cb1c51a79adb4a8bbf3efe1872274f7a","id":"pg_478b9fbf58f35265a8cac873dc02add5","maturity":"draft","page_type":"source","path":"pages/sources/rowboatlabs-rowboat-readme-md-c9ef9e29cea9-c873dc02add5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4f94329fee815c4a80df890a11f21a3d"],"title":"rowboatlabs/rowboat/README.md @ c9ef9e29cea9","updated_at":"2026-09-14T02:36:26Z","updated_by_operation":"op_cb1c51a79adb4a8bbf3efe1872274f7a"}
