{"access":"public","created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ca65677fdf10d66c7a7a11caafd5d049235687dfc9147d98d6734c58832e2ecf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"langchain-ai/deepagents@c08cae693e00 snapshot a946885b8fc52b92","timeframe":null},"slice_ids":["slc_6620358c8084a487ee280b0e537ad2d97accb4ea2267022f5ffdb1d8317dc49d","slc_787ff0ce84ca630a74cf991791b76beab432b5aadf36f39962ccdabcf7f8c953"],"source_ids":["src_10aa5f3656be5082b7eeddfffc0cbe0e"],"text":"The harness is model-agnostic: it works with any tool-calling LLM, including frontier APIs, open-weight hosted models, and self-hosted models via Ollama, vLLM, or llama.cpp.","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
{"access":"public","created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d1e54f5f9038b10b6dad7aa5734a9a9aa424eb229a12d98dcb7b73099896bcdd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"langchain-ai/deepagents@c08cae693e00 snapshot a946885b8fc52b92","timeframe":null},"slice_ids":["slc_837386350433801aab07a6b9a812843789bfbf9db5168b8c4dd5e259625f7d26","slc_c1a48e4514ea3d138783b9e55be9ad6ebbffcdf4b70cdf5d1673a67ab0db5297"],"source_ids":["src_10aa5f3656be5082b7eeddfffc0cbe0e"],"text":"Deep Agents layers on LangChain's create_agent, which itself runs on the LangGraph graph runtime, bundling filesystem, sub-agents, context management, and skills on top.","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
{"access":"public","created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d2591d701be68d53b9400b6ac5347f246c2961f917c1104778c0344774efe6b1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"langchain-ai/deepagents@c08cae693e00 snapshot a946885b8fc52b92","timeframe":null},"slice_ids":["slc_6ca5c1e228743bebabc815b0c7113b3db4df0599bb1aa327ecfc9b40fb54bfad","slc_787ff0ce84ca630a74cf991791b76beab432b5aadf36f39962ccdabcf7f8c953"],"source_ids":["src_10aa5f3656be5082b7eeddfffc0cbe0e"],"text":"Deep Agents is an open-source agent harness that runs out of the box and can be extended, overridden, or replaced piece by piece without forking.","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
