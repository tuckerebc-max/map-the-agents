{"access":"public","created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_762e9bec4b04cd8c319e7fc54e0bd24c7a3268637ea7ae88c0a96508a0cf567f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"langchain-ai/deepagents@c08cae693e00 snapshot a946885b8fc52b92","timeframe":null},"slice_ids":["slc_4d0ab6ba583ca1b5aefa60491b7fc1283e0efa287ff38b88e9482dda10c52f1a","slc_f36db89b88e11fab2ca93952131f21dd148b37e093e9ff311e23bee7c12045c2"],"source_ids":["src_10aa5f3656be5082b7eeddfffc0cbe0e"],"text":"The Python API exposes create_deep_agent, which accepts a model string, custom tools, and a system prompt, and is invoked with a messages payload.","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
{"access":"public","created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8eed8e4bd58b734c05360c1dee969544a02b890d0a97caf86884ff09f77540bf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"langchain-ai/deepagents@c08cae693e00 snapshot a946885b8fc52b92","timeframe":null},"slice_ids":["slc_295e75ad9895f1ed9e23c4340dccf7c7bd6919a923a52eb0be516b349bbd81ce"],"source_ids":["src_10aa5f3656be5082b7eeddfffc0cbe0e"],"text":"The product follows a 'trust the LLM' security model: the agent can do anything its tools allow, and boundaries should be enforced at the tool or sandbox level rather than by model self-policing.","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
{"access":"public","created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ab2f6ab52b0f8017b7999413b4b354e9b677cab8c8b6095addd9526241b3e7ca","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"langchain-ai/deepagents@c08cae693e00 snapshot a946885b8fc52b92","timeframe":null},"slice_ids":["slc_2959d9833708ae873a424194a1d2e3a93ccb752315789bee472dfdd94547b45a","slc_4751cc0b386c674b7ba92ed2ab1e5976a826ef22b8333426a54fb702186d5576","slc_69271e78458733fe0c7262874932a93565978f15dbb5b1d48bca1535639f3692","slc_e0c6142e80ac98c14dbf977679bdcdab426f44531718d32b158154afef3ad9a6","slc_f28d950858485aa52e7a2e1cbfc27d478cadc457da332e823ba98e97de0fbd6d"],"source_ids":["src_98699008b741510daeb169a6ce6b63e9"],"text":"Repository development practice: contributors follow Conventional Commits with scopes, branch naming of username/scope/description, a PR template with a release-note summary, and unit tests split into tests/unit_tests and tests/integration_tests with warnings treated as errors.","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
