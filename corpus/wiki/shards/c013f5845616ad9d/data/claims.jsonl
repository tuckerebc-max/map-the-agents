{"access":"public","created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2946bb3316cf14a7c5ad4825ddc58e21899f97318d28b25ad20b811e9e826d55","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"langchain-ai/deepagents@c08cae693e00 snapshot a946885b8fc52b92","timeframe":null},"slice_ids":["slc_56ba845a9c266a57d373e431bd7ce08f9d9979a4dbcb491ae94a12654d4fbff6"],"source_ids":["src_10aa5f3656be5082b7eeddfffc0cbe0e"],"text":"Documented features include sub-agents with isolated context windows, pluggable filesystem backends, context summarization with tool-output offloading, shell access, persistent memory, human-in-the-loop tool approval, skills, and custom or MCP tools.","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
