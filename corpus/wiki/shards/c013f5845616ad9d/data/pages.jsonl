96e15a61","clm_d5ae1a55633b923136eb1490946c05a8cb0dc2fd4f5069d00a5e0e5e10d8bc90","clm_e0d10f5857f8e11d9dfa4e38506e90c283187c0f5e18c995f0920290f54f9c26"],"created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","id":"pg_0d53ea3116ca59b38822c5b465c9c8e7","maturity":"draft","page_type":"entity","path":"pages/entities/langchain-ai-deepagents-c5b465c9c8e7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"langchain-ai/deepagents","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_ab2f6ab52b0f8017b7999413b4b354e9b677cab8c8b6095addd9526241b3e7ca"],"opposing_claim_ids":[],"text":"Repository development practice: contributors follow Conventional Commits with scopes, branch naming of username/scope/description, a PR template with a release-note summary, and unit tests split into tests/unit_tests and tests/integration_tests with warnings treated as errors."},{"claim_ids":["clm_ba95cf42718fa9c3fa5c76de85ce4d5951458f61707cfb0b24eeb10e6c452daa"],"opposing_claim_ids":[],"text":"Repository development practice: public API changes must preserve exported signatures, add new parameters as keyword-only with defaults, and mark experimental features with docstring warnings."},{"claim_ids":["clm_d5ae1a55633b923136eb1490946c05a8cb0dc2fd4f5069d00a5e0e5e10d8bc90"],"opposing_claim_ids":[],"text":"Repository development practice: the monorepo layout includes libs/deepagents, libs/code, libs/acp, libs/talon, libs/evals, and partner packages, with benchmarks run via package bench and bench-memory Make targets rather than pytest directly."}],"claim_ids":["clm_ab2f6ab52b0f8017b7999413b4b354e9b677cab8c8b6095addd9526241b3e7ca","clm_ba95cf42718fa9c3fa5c76de85ce4d5951458f61707cfb0b24eeb10e6c452daa","clm_d5ae1a55633b923136eb1490946c05a8cb0dc2fd4f5069d00a5e0e5e10d8bc90"],"created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","id":"pg_2b76c52baa495625943e22c3957eca8d","maturity":"draft","page_type":"source","path":"pages/sources/langchain-ai-deepagents-agents-md-c08cae693e00-22c3957eca8d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_98699008b741510daeb169a6ce6b63e9"],"title":"langchain-ai/deepagents/AGENTS.md @ c08cae693e00","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_34f4a5ebe5ed14fae7dc3a7447090b3c64d3944acbbb844011d8ee9b204b5ba5"],"opposing_claim_ids":[],"text":"The repository's root action.yml runs dcode non-interactively in GitHub Actions, with inputs for prompt, model, API keys, shell_allow_list, max_turns, task_timeout, quiet, and json output."},{"claim_ids":["clm_aedaaa38be07471c52dcdf1792330f70e02144a092d146315056d4296228620e"],"opposing_claim_ids":[],"text":"In the GitHub Action, shell commands are permitted via a shell_allow_list input; interactive-only options like --auto-approve are intentionally not exposed."},{"claim_ids":["clm_e0d10f5857f8e11d9dfa4e38506e90c283187c0f5e18c995f0920290f54f9c26"],"opposing_claim_ids":[],"text":"The GitHub Action enables persistent memory by default through actions/cache, with memory_scope (pr, branch, or repo) and agent_name inputs controlling cache sharing and separation."}],"claim_ids":["clm_34f4a5ebe5ed14fae7dc3a7447090b3c64d3944acbbb844011d8ee9b204b5ba5","clm_aedaaa38be07471c52dcdf1792330f70e02144a092d146315056d4296228620e","clm_e0d10f5857f8e11d9dfa4e38506e90c283187c0f5e18c995f0920290f54f9c26"],"created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","id":"pg_dcc3b7a8dedf5c06a40f72611a7fce86","maturity":"draft","page_type":"source","path":"pages/sources/langchain-ai-deepagents-action-md-c08cae693e00-72611a7fce86.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e0cc30d53872579db1f72f8c99bd20de"],"title":"langchain-ai/deepagents/ACTION.md @ c08cae693e00","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2946bb3316cf14a7c5ad4825ddc58e21899f97318d28b25ad20b811e9e826d55"],"opposing_claim_ids":[],"text":"Documented features include sub-agents with isolated context windows, pluggable filesystem backends, context summarization with tool-output offloading, shell access, persistent memory, human-in-the-loop tool approval, skills, and custom or MCP tools."},{"claim_ids":["clm_5a025992201f12d33b773cf68a10c9cb340e78f641c8efffae2e2185179477b0"],"opposing_claim_ids":[],"text":"The package is distributed on PyPI as deepagents under an MIT license and is installed with uv; a separate JavaScript/TypeScript library exists in deepagentsjs."},{"claim_ids":["clm_762e9bec4b04cd8c319e7fc54e0bd24c7a3268637ea7ae88c0a96508a0cf567f"],"opposing_claim_ids":[],"text":"The Python API exposes create_deep_agent, which accepts a model string, custom tools, and a system prompt, and is invoked with a messages payload."},{"claim_ids":["clm_8eed8e4bd58b734c05360c1dee969544a02b890d0a97caf86884ff09f77540bf"],"opposing_claim_ids":[],"text":"The product follows a 'trust the LLM' security model: the agent can do anything its tools allow, and boundaries should be enforced at the tool or sandbox level rather than by model self-policing."},{"claim_ids":["clm_ca65677fdf10d66c7a7a11caafd5d049235687dfc9147d98d6734c58832e2ecf"],"opposing_claim_ids":[],"text":"The harness is model-agnostic: it works with any tool-calling LLM, including frontier APIs, open-weight hosted models, and self-hosted models via Ollama, vLLM, or llama.cpp."},{"claim_ids":["clm_d1e54f5f9038b10b6dad7aa5734a9a9aa424eb229a12d98dcb7b73099896bcdd"],"opposing_claim_ids":[],"text":"Deep Agents layers on LangChain's create_agent, which itself runs on the LangGraph graph runtime, bundling filesystem, sub-agents, context management, and skills on top."},{"claim_ids":["clm_d2591d701be68d53b9400b6ac5347f246c2961f917c1104778c0344774efe6b1"],"opposing_claim_ids":[],"text":"Deep Agents is an open-source agent harness that runs out of the box and can be extended, overridden, or replaced piece by piece without forking."},{"claim_ids":["clm_d331baed67d974ec520db3c44235208699bafcb5a02b71dfb6c0ad5e96e15a61"],"opposing_claim_ids":[],"text":"Any LangGraph CompiledStateGraph can be passed in as a sub-agent, allowing custom orchestration to plug into the harness."}],"claim_ids":["clm_2946bb3316cf14a7c5ad4825ddc58e21899f97318d28b25ad20b811e9e826d55","clm_5a025992201f12d33b773cf68a10c9cb340e78f641c8efffae2e2185179477b0","clm_762e9bec4b04cd8c319e7fc54e0bd24c7a3268637ea7ae88c0a96508a0cf567f","clm_8eed8e4bd58b734c05360c1dee969544a02b890d0a97caf86884ff09f77540bf","clm_ca65677fdf10d66c7a7a11caafd5d049235687dfc9147d98d6734c58832e2ecf","clm_d1e54f5f9038b10b6dad7aa5734a9a9aa424eb229a12d98dcb7b73099896bcdd","clm_d2591d701be68d53b9400b6ac5347f246c2961f917c1104778c0344774efe6b1","clm_d331baed67d974ec520db3c44235208699bafcb5a02b71dfb6c0ad5e96e15a61"],"created_at":"2026-09-14T02:10:56Z","created_by_operation":"op_0857200d689e4d99adad3ea40bb3439b","id":"pg_e8f72138e3555da8be4c283ede53fc5c","maturity":"draft","page_type":"source","path":"pages/sources/langchain-ai-deepagents-readme-md-c08cae693e00-283ede53fc5c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_10aa5f3656be5082b7eeddfffc0cbe0e"],"title":"langchain-ai/deepagents/README.md @ c08cae693e00","updated_at":"2026-09-14T02:10:56Z","updated_by_operation":"op_0857200d689e4d99adad3ea40bb3439b"}
