{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1c04ce76d55cc863498d3343071da4a6e57dac7c0a4b605ec50ec15e62080911"],"opposing_claim_ids":[],"text":"Rollback restores a selected commit into the current branch, creates a new commit, and redeploys without rewriting existing history, using Cloudflare Artifacts as the version-history layer."},{"claim_ids":["clm_85ce3c4ba0262f1ad835c9303782c658bead9f3d1baeb8bd76c20211849e6723"],"opposing_claim_ids":[],"text":"The docs explicitly state the older phase-based sandbox architecture diagrams are retired historical context and must not be used to describe the current Think, SpaceDO, Artifacts, Worker Loader, and App Facet implementation."}],"claim_ids":["clm_1c04ce76d55cc863498d3343071da4a6e57dac7c0a4b605ec50ec15e62080911","clm_85ce3c4ba0262f1ad835c9303782c658bead9f3d1baeb8bd76c20211849e6723"],"created_at":"2026-09-14T01:42:01Z","created_by_operation":"op_44f36ce79fc54898900a70d10df50054","id":"pg_2bb5bf38b29c534086160edd8ecf9695","maturity":"draft","page_type":"source","path":"pages/sources/cloudflare-vibesdk-docs-architecture-diagrams-md-9da158d82c59-0edd8ecf9695.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e1d11c0e5b465f23ada21bb060fcce6b"],"title":"cloudflare/vibesdk/docs/architecture-diagrams.md @ 9da158d82c59","updated_at":"2026-09-14T01:42:01Z","updated_by_operation":"op_44f36ce79fc54898900a70d10df50054"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1c04ce76d55cc863498d3343071da4a6e57dac7c0a4b605ec50ec15e62080911"],"opposing_claim_ids":[],"text":"Rollback restores a selected commit into the current branch, creates a new commit, and redeploys without rewriting existing history, using Cloudflare Artifacts as the version-history layer."},{"claim_ids":["clm_270924ac5fadd22b3221e4231b0fc73e5ed35fe99c3bc52caa0b27461314b125"],"opposing_claim_ids":[],"text":"VibeSDK is MIT-licensed, and support is available through GitHub issues, GitHub discussions, and the Cloudflare Developers Discord."},{"claim_ids":["clm_47110c0fca0e665b4a38b848e0dacd231107f36a4f472547a987288f72c2565d"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork and clone, run bun install and bun run setup, follow AGENTS.md, then run bun run typecheck, lint, and test before opening a pull request describing the change and its validation."},{"claim_ids":["clm_794da97cd7fbe66face7a05a67606d00119d8be1a65facca41a4e8f3fcecc5dd"],"opposing_claim_ids":[],"text":"Repository development practice: local development uses Node.js 18+, Bun, and commands such as bun run dev, build, typecheck, lint, and test, with bun run deploy building, migrating, and deploying via .prod.vars."},{"claim_ids":["clm_7b0167b183fffdf93959a8459a370a3e31f9f97705574ebc75e70d9888883d32"],"opposing_claim_ids":[],"text":"Model providers are routed through Cloudflare AI Gateway with centralized observability and caching; deploying requires a Cloudflare account, Workers Paid plan, Workers for Platforms access for production previews, and an API token."},{"claim_ids":["clm_8b456beb70aa3563a60317763a6d14e17a3ce07e6d4f563d9a9cc13c82beb954"],"opposing_claim_ids":[],"text":"Each generated application gets isolated SQLite-backed storage via a Durable Object Facet, with database inspection and reset controls available to users."},{"claim_ids":["clm_8fad8a7021adb74686f4ba2e3e0dab0764eef50385d5bfc6b1d7b357cde8f28e"],"opposing_claim_ids":[],"text":"Feature settings are dashboard-managed rather than committed in wrangler.jsonc, with keep_vars: true preserving production values across deploys; listed toggles default to off while ENABLE_EMAIL_AUTH defaults to on."},{"claim_ids":["clm_94a04e26ea207c07d22ce0d485d65286df9d06156211a8a138edc085dbab4a46"],"opposing_claim_ids":[],"text":"The architecture comprises a ThinkAgent Durable Object running the model-and-tool loop, a SpaceDO workspace per project, Cloudflare Artifacts for git history and restore points, a Worker Loader for Dynamic Worker previews, and a generated App Durable Object Facet with SQLite."},{"claim_ids":["clm_9edb720ea8bae704540ba778d8b2fd0ddab91c4e4586cc2286f41adeaefd22d0"],"opposing_claim_ids":[],"text":"VibeSDK is described as an open-source agentic platform for building and deploying full-stack applications on Cloudflare, with a hosted demo at build.cloudflare.dev."},{"claim_ids":["clm_b266d8afaafce287057a065a89a686166376d70c71c51784947580f8444a912d"],"opposing_claim_ids":[],"text":"ThinkAgent runs an iterative model-and-tool loop, managing conversation history, streaming, and skills; its explicit tools edit the workspace, create restore points, deploy previews, inspect browser logs, and ask clarifying questions, while bash access is disabled."},{"claim_ids":["clm_bc232e434c2866ccfea3b9097c650df0fc29fe0c196dccbd4ec08e7f359aeaa2"],"opposing_claim_ids":[],"text":"Previews are produced by bundling each committed deployment with @cloudflare/worker-bundler and loading it through the Worker Loader binding; SpaceDO serves static assets while backend requests and WebSockets are forwarded to the generated App Facet."},{"claim_ids":["clm_d2d6e9deed8413ceabb48152c0a037f356912150c29cc495c6b1399233050a9c"],"opposing_claim_ids":[],"text":"The product's tool model uses explicit workspace and product tools with workspace bash access disabled, and preview URLs use signed, branch-scoped access for authorization."},{"claim_ids":["clm_fcfcfeafca14000d0e05e799db222ca626e0515d30aaf44126ab80a417d2a38e"],"opposing_claim_ids":[],"text":"Users build apps by describing what they want and answering clarifying questions while the agent plans, edits files, deploys previews, inspects errors, and iterates with the human in the loop."}],"claim_ids":["clm_1c04ce76d55cc863498d3343071da4a6e57dac7c0a4b605ec50ec15e62080911","clm_270924ac5fadd22b3221e4231b0fc73e5ed35fe99c3bc52caa0b27461314b125","clm_47110c0fca0e665b4a38b848e0dacd231107f36a4f472547a987288f72c2565d","clm_794da97cd7fbe66face7a05a67606d00119d8be1a65facca41a4e8f3fcecc5dd","clm_7b0167b183fffdf93959a8459a370a3e31f9f97705574ebc75e70d9888883d32","clm_8b456beb70aa3563a60317763a6d14e17a3ce07e6d4f563d9a9cc13c82beb954","clm_8fad8a7021adb74686f4ba2e3e0dab0764eef50385d5bfc6b1d7b357cde8f28e","clm_94a04e26ea207c07d22ce0d485d65286df9d06156211a8a138edc085dbab4a46","clm_9edb720ea8bae704540ba778d8b2fd0ddab91c4e4586cc2286f41adeaefd22d0","clm_b266d8afaafce287057a065a89a686166376d70c71c51784947580f8444a912d","clm_bc232e434c2866ccfea3b9097c650df0fc29fe0c196dccbd4ec08e7f359aeaa2","clm_d2d6e9deed8413ceabb48152c0a037f356912150c29cc495c6b1399233050a9c","clm_fcfcfeafca14000d0e05e799db222ca626e0515d30aaf44126ab80a417d2a38e"],"created_at":"2026-09-14T01:42:01Z","created_by_operation":"op_44f36ce79fc54898900a70d10df50054","id":"pg_376916e81efa577d9b32696d01f2e5aa","maturity":"draft","page_type":"source","path":"pages/sources/cloudflare-vibesdk-readme-md-9da158d82c59-696d01f2e5aa.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_01567cf0c04a5a4a84dff6cdb4d4505a"],"title":"cloudflare/vibesdk/README.md @ 9da158d82c59","updated_at":"2026-09-14T01:42:01Z","updated_by_operation":"op_44f36ce79fc54898900a70d10df50054"}
