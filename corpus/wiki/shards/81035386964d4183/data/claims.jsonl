{"access":"public","created_at":"2026-09-14T04:29:07Z","created_by_operation":"op_d2632a4fd34648909716145915d73107","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_51ec24c5ef775928953e202fc8f5888eb7330505f4c178bed895397ed55663ca","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"urbint/cortex@b2897306c6cd snapshot d05249608d46ce1b","timeframe":null},"slice_ids":["slc_3d222be2df8ff459389e1d1095e0a31a183a37146d9aada5774f425462d8bcd6","slc_78d4a3c4b6d9b6eed5a8f0bcef2c756fe2555bd28859fe374611ec7355ad0c2c","slc_e652ce9114c722d31d1093762aea50348fd9b92dc40728a3def8631447571246"],"source_ids":["src_83a955983f725e37954ff96cefb2d20c"],"text":"Cortex is described as an intelligent coding assistant for Elixir, installed by adding it as a Mix dependency (e.g. {:cortex, \"~> 0.1\", only: [:dev, :test]}).","updated_at":"2026-09-14T04:29:07Z","updated_by_operation":"op_d2632a4fd34648909716145915d73107"}
{"access":"public","created_at":"2026-09-14T04:29:07Z","created_by_operation":"op_d2632a4fd34648909716145915d73107","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5df61da6779547f1d88a68b57395b32ef6b71134b456367bd929281c952bbf06","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"urbint/cortex@b2897306c6cd snapshot d05249608d46ce1b","timeframe":null},"slice_ids":["slc_2fc334f1417257259dddf12421917c63d087e9e8754411ace350ea05d219ae22","slc_a5405df0760faf82f3a79d096b2d9c29a7f7f1cd9d850c0d0df00d67eb004bc2"],"source_ids":["src_83a955983f725e37954ff96cefb2d20c"],"text":"For umbrella applications, users are instructed to add Cortex to each monitored sub-app's dependencies rather than the root mix.exs, because root umbrella dependencies are not automatically started, a process Cortex depends on.","updated_at":"2026-09-14T04:29:07Z","updated_by_operation":"op_d2632a4fd34648909716145915d73107"}
{"access":"public","created_at":"2026-09-14T04:29:07Z","created_by_operation":"op_d2632a4fd34648909716145915d73107","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_830b26a1d96350b70ab92900339657b5813048fa85078cb237ecb28eaeee3ca6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"urbint/cortex@b2897306c6cd snapshot d05249608d46ce1b","timeframe":null},"slice_ids":["slc_0b1cbe1209dce92611c68c8cb0d13e88ebdf6156ce9483d41e2f1bc1d2eace50","slc_2abfb276b6a9af93fbc37ead4b50b94de1a5c34f46c4d470aa9861436274fae0","slc_a17c63523b1466a3b11f17f6a3f91995ccd10724c925d024ebffd676085d5239","slc_bada1a0ecc9babf0078a4813607c467a32725aed6357b40512d4e937b491350d"],"source_ids":["src_83a955983f725e37954ff96cefb2d20c"],"text":"Cortex runs automatically alongside the mix app (e.g. via iex -S mix); under MIX_ENV=test it automatically runs tests for saved test files and for tests paired with saved lib files.","updated_at":"2026-09-14T04:29:07Z","updated_by_operation":"op_d2632a4fd34648909716145915d73107"}
