{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3a40fa0208bb18e5513f35db0e9746a1e7c454a6c705c37c1d65d401f8d9120c"],"opposing_claim_ids":[],"text":"Memory persists in a local SQLite database with FTS5 updated via triggers; embeddings are computed out-of-band by a background worker that auto-spawns on the first hook and self-exits when idle."}],"claim_ids":["clm_3a40fa0208bb18e5513f35db0e9746a1e7c454a6c705c37c1d65d401f8d9120c"],"created_at":"2026-09-14T04:02:15Z","created_by_operation":"op_600549f9d99043a29fff3532a2af3d54","id":"pg_dbf856918ad159fa97666a22217636c2","maturity":"draft","page_type":"source","path":"pages/sources/juliusbrussee-cavemem-docs-architecture-md-166078dd7c46-6a22217636c2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b8ec8cca1475590ea11ce2aa10062ce8"],"title":"JuliusBrussee/cavemem/docs/architecture.md @ 166078dd7c46","updated_at":"2026-09-14T04:02:15Z","updated_by_operation":"op_600549f9d99043a29fff3532a2af3d54"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_480027dceffab8387cd4e6f137c4e4000d2e01c942ca21d43dfd440fac4d33fb"],"opposing_claim_ids":[],"text":"Search is hybrid: SQLite FTS5 BM25 keyword matching blended with a local vector index, weighted by the tunable search.alpha setting (default 0.5)."},{"claim_ids":["clm_678ba0783d1b892060edc42a069e4f41b9b62d173e8bcbc803e80e3812eb98f6"],"opposing_claim_ids":[],"text":"The MCP server exposes search, timeline, get_observations, and list_sessions, plus an opt-in enrich tool; search and timeline return compact results while get_observations fetches full bodies."},{"claim_ids":["clm_88e327d845e8cf0a9d80c8b1987b52295573e0bbd7f024ed555958ff70fda8a3"],"opposing_claim_ids":[],"text":"The enrich tool is off by default and unregistered when disabled, so no network call occurs; when enabled it enforces SSRF protections, rejecting private, loopback, link-local, and unique-local targets including obfuscated numeric forms."}],"claim_ids":["clm_480027dceffab8387cd4e6f137c4e4000d2e01c942ca21d43dfd440fac4d33fb","clm_678ba0783d1b892060edc42a069e4f41b9b62d173e8bcbc803e80e3812eb98f6","clm_88e327d845e8cf0a9d80c8b1987b52295573e0bbd7f024ed555958ff70fda8a3"],"created_at":"2026-09-14T04:02:15Z","created_by_operation":"op_600549f9d99043a29fff3532a2af3d54","id":"pg_deb0613a971c5bf990576182833a7c88","maturity":"draft","page_type":"source","path":"pages/sources/juliusbrussee-cavemem-docs-mcp-md-166078dd7c46-6182833a7c88.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ccfbe069f86c50da825cf1a154a54a0d"],"title":"JuliusBrussee/cavemem/docs/mcp.md @ 166078dd7c46","updated_at":"2026-09-14T04:02:15Z","updated_by_operation":"op_600549f9d99043a29fff3532a2af3d54"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_18acbaf207d45397b5f47addc0e5747760c7e681967331a2aa39d8d00550abb7"],"opposing_claim_ids":[],"text":"The project is frozen as of August 2026: no new features or fixes are expected, and development continues in the related caveman repository."},{"claim_ids":["clm_2dc40f3f1621f08f7f134df1cf8eb2329213d80b85017dd08d9224d6d3095f15"],"opposing_claim_ids":[],"text":"The viewer worker binds to 127.0.0.1 only, checks Host/Origin headers, and requires a local bearer token (mode 0600) on /api/* endpoints."},{"claim_ids":["clm_351188e71d23d66b0f6244052fa9c8a7e615a26f9a71c7801bdce4688162ab51"],"opposing_claim_ids":[],"text":"The npm package cavemem installs globally via npm; the default embedding provider is local (Transformers.js per CLAUDE.md), with ollama and openai as opt-in remote providers."},{"claim_ids":["clm_3a40fa0208bb18e5513f35db0e9746a1e7c454a6c705c37c1d65d401f8d9120c"],"opposing_claim_ids":[],"text":"Memory persists in a local SQLite database with FTS5 updated via triggers; embeddings are computed out-of-band by a background worker that auto-spawns on the first hook and self-exits when idle."},{"claim_ids":["clm_480027dceffab8387cd4e6f137c4e4000d2e01c942ca21d43dfd440fac4d33fb"],"opposing_claim_ids":[],"text":"Search is hybrid: SQLite FTS5 BM25 keyword matching blended with a local vector index, weighted by the tunable search.alpha setting (default 0.5)."},{"claim_ids":["clm_5876598e81e58c868cf404f2baa200a4126ea147b0101e82383e4a359dcaa183"],"opposing_claim_ids":[],"text":"Per-IDE installers wire hooks and MCP: Claude Code, OpenCode, Codex, Copilot, and Augment capture observations, while Cursor, Gemini CLI, Antigravity, and IBM Bob are query-only over memory captured elsewhere."},{"claim_ids":["clm_678ba0783d1b892060edc42a069e4f41b9b62d173e8bcbc803e80e3812eb98f6"],"opposing_claim_ids":[],"text":"The MCP server exposes search, timeline, get_observations, and list_sessions, plus an opt-in enrich tool; search and timeline return compact results while get_observations fetches full bodies."},{"claim_ids":["clm_709d3de502f98f815dd6192a06d792030c4c8233931a2f2d64d83755f34a14af"],"opposing_claim_ids":[],"text":"The CLI offers commands including install/uninstall per IDE, status, config show/get/set/open, viewer, doctor, search, compress, reindex, export/import JSONL, and an stdio MCP server."},{"claim_ids":["clm_88e327d845e8cf0a9d80c8b1987b52295573e0bbd7f024ed555958ff70fda8a3"],"opposing_claim_ids":[],"text":"The enrich tool is off by default and unregistered when disabled, so no network call occurs; when enabled it enforces SSRF protections, rejecting private, loopback, link-local, and unique-local targets including obfuscated numeric forms."}],"claim_ids":["clm_18acbaf207d45397b5f47addc0e5747760c7e681967331a2aa39d8d00550abb7","clm_2dc40f3f1621f08f7f134df1cf8eb2329213d80b85017dd08d9224d6d3095f15","clm_351188e71d23d66b0f6244052fa9c8a7e615a26f9a71c7801bdce4688162ab51","clm_3a40fa0208bb18e5513f35db0e9746a1e7c454a6c705c37c1d65d401f8d9120c","clm_480027dceffab8387cd4e6f137c4e4000d2e01c942ca21d43dfd440fac4d33fb","clm_5876598e81e58c868cf404f2baa200a4126ea147b0101e82383e4a359dcaa183","clm_678ba0783d1b892060edc42a069e4f41b9b62d173e8bcbc803e80e3812eb98f6","clm_709d3de502f98f815dd6192a06d792030c4c8233931a2f2d64d83755f34a14af","clm_88e327d845e8cf0a9d80c8b1987b52295573e0bbd7f024ed555958ff70fda8a3"],"created_at":"2026-09-14T04:02:15Z","created_by_operation":"op_600549f9d99043a29fff3532a2af3d54","id":"pg_ebb523cd39cb571cb0e2327d412e899b","maturity":"draft","page_type":"source","path":"pages/sources/juliusbrussee-cavemem-readme-md-166078dd7c46-327d412e899b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_963027d9569757669775d414e46e68a8"],"title":"JuliusBrussee/cavemem/README.md @ 166078dd7c46","updated_at":"2026-09-14T04:02:15Z","updated_by_operation":"op_600549f9d99043a29fff3532a2af3d54"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_79544db9a6dd960cbb0764a47337b6d8b58bb0b46c5b87effbfbcfc206148890"],"opposing_claim_ids":[],"text":"Compression is deterministic and offline, never invoking a model; technical tokens (code, URLs, paths, commands, versions, dates, numbers, identifiers) are preserved byte-for-byte and prose is lossy only on filler/hedging words."},{"claim_ids":["clm_bcab83a0d9115abec8ffdc6c784f16baca14f9faa4ad507429688007dac9c093"],"opposing_claim_ids":[],"text":"An evals/ harness measures compression performance: fixtures verify determinism and technical-token round-trip, and the benchmark corpus requires at least 30% average token reduction (targets of 40% at full and 55% at ultra intensity)."}],"claim_ids":["clm_79544db9a6dd960cbb0764a47337b6d8b58bb0b46c5b87effbfbcfc206148890","clm_bcab83a0d9115abec8ffdc6c784f16baca14f9faa4ad507429688007dac9c093"],"created_at":"2026-09-14T04:02:15Z","created_by_operation":"op_600549f9d99043a29fff3532a2af3d54","id":"pg_f101fc1249a85f0c8eaeb079c9aad7d7","maturity":"draft","page_type":"source","path":"pages/sources/juliusbrussee-cavemem-docs-compression-md-166078dd7c46-b079c9aad7d7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a50c3bd1b6a353988963cf933ebd8af6"],"title":"JuliusBrussee/cavemem/docs/compression.md @ 166078dd7c46","updated_at":"2026-09-14T04:02:15Z","updated_by_operation":"op_600549f9d99043a29fff3532a2af3d54"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0c12ac598840de1d240853f7894df7c1af5156a02b57b7dc602dc169e4ad271c"],"opposing_claim_ids":[],"text":"Repository development practice: an end-to-end publish script (scripts/e2e-publish.sh) must pass in CI before changeset publish, driving real hook events, FTS search, and the MCP server in an isolated install prefix."},{"claim_ids":["clm_2a2353bea03c8280a40b04662eb0a4d0823fb74a0e0d1cda4460d532d3c3faff"],"opposing_claim_ids":[],"text":"Repository development practice: contributors must pass four gates (pnpm typecheck, lint, test, build) before merging, add changesets for package changes, use Conventional Commits, and get one review on PRs."},{"claim_ids":["clm_351188e71d23d66b0f6244052fa9c8a7e615a26f9a71c7801bdce4688162ab51"],"opposing_claim_ids":[],"text":"The npm package cavemem installs globally via npm; the default embedding provider is local (Transformers.js per CLAUDE.md), with ollama and openai as opt-in remote providers."},{"claim_ids":["clm_bcab83a0d9115abec8ffdc6c784f16baca14f9faa4ad507429688007dac9c093"],"opposing_claim_ids":[],"text":"An evals/ harness measures compression performance: fixtures verify determinism and technical-token round-trip, and the benchmark corpus requires at least 30% average token reduction (targets of 40% at full and 55% at ultra intensity)."}],"claim_ids":["clm_0c12ac598840de1d240853f7894df7c1af5156a02b57b7dc602dc169e4ad271c","clm_2a2353bea03c8280a40b04662eb0a4d0823fb74a0e0d1cda4460d532d3c3faff","clm_351188e71d23d66b0f6244052fa9c8a7e615a26f9a71c7801bdce4688162ab51","clm_bcab83a0d9115abec8ffdc6c784f16baca14f9faa4ad507429688007dac9c093"],"created_at":"2026-09-14T04:02:15Z","created_by_operation":"op_600549f9d99043a29fff3532a2af3d54","id":"pg_fc492f4becfe5d82a31b42800f92d1a5","maturity":"draft","page_type":"source","path":"pages/sources/juliusbrussee-cavemem-claude-md-166078dd7c46-42800f92d1a5.md","record_type":"page","review_state":"mechanically_checked","schema_version"