{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:11:02Z","created_by_operation":"op_058f4e809230402dbca24f621cab3606","id":"pg_3385fec3e45556eeb2884fc5e14412a2","maturity":"draft","page_type":"source","path":"pages/sources/openai-codex-security-agents-md-75914c46386e-4fc5e14412a2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_6593eafd6ecf581684b6bb4c54edfea2"],"title":"openai/codex-security/AGENTS.md @ 75914c46386e","updated_at":"2026-09-14T03:11:02Z","updated_by_operation":"op_058f4e809230402dbca24f621cab3606"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_47b50309adebda75fb9fc8a606567e889b95406e9565faf4757cce5d24a50888"],"opposing_claim_ids":[],"text":"The product ships as a CLI and TypeScript SDK; the SDK exposes a CodexSecurity class with run() accepting options like mode, workers, subagents, and maxTimeHours, plus a close() method."},{"claim_ids":["clm_8231562a344e80320068977e13af1913161345bed4c613decfa278fab6631769"],"opposing_claim_ids":[],"text":"A findings service (preview) runs from the same ghcr.io/openai/codex-security image, stores findings and embeddings in SQLite, serves a read-only /dashboard refreshing every five seconds, and returns duplicate candidates by embedding similarity."},{"claim_ids":["clm_8a0fc9831562973ae8549085492350895a3737bb5a1e172577c5e6b51cdc1fc6"],"opposing_claim_ids":[],"text":"The tool requires Node.js 22.13.0 or later and Python 3.10 or later, and is installed via npm as @openai/codex-security."},{"claim_ids":["clm_c9debfacb60ec1a1b56f75fa257fbb2a436596415e251c5e30a1cb6c969b8b43"],"opposing_claim_ids":[],"text":"Alternative inference providers are supported via --provider with documented examples for amazon-bedrock, openrouter, and fireworks, each using its own API-key environment variable."},{"claim_ids":["clm_e7431597e8b814377aa9179a759376552573e5b742a70641f2783c2eb4d0ebdb"],"opposing_claim_ids":[],"text":"The policy command drafts SECURITY.md guidance outside the checkout without installing it or scanning, and supporting architecture or threat-model documents are kept outside the repository."}],"claim_ids":["clm_47b50309adebda75fb9fc8a606567e889b95406e9565faf4757cce5d24a50888","clm_8231562a344e80320068977e13af1913161345bed4c613decfa278fab6631769","clm_8a0fc9831562973ae8549085492350895a3737bb5a1e172577c5e6b51cdc1fc6","clm_c9debfacb60ec1a1b56f75fa257fbb2a436596415e251c5e30a1cb6c969b8b43","clm_e7431597e8b814377aa9179a759376552573e5b742a70641f2783c2eb4d0ebdb"],"created_at":"2026-09-14T03:11:02Z","created_by_operation":"op_058f4e809230402dbca24f621cab3606","id":"pg_44b4f64c5f8555e6a8fe228aad086360","maturity":"draft","page_type":"source","path":"pages/sources/openai-codex-security-readme-md-75914c46386e-228aad086360.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9b22d7c956425666a855a4dc95bd72e3"],"title":"openai/codex-security/README.md @ 75914c46386e","updated_at":"2026-09-14T03:11:02Z","updated_by_operation":"op_058f4e809230402dbca24f621cab3606"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3455ec9b588d4f19b3e1f68d740824c7bc7db574da880d32e9c911b5e3a31580"],"opposing_claim_ids":[],"text":"Repository development practice: pull request titles must follow a Conventional Commit form (<type>[scope][!]: <description>), which drives release categories and version bumping under a 0.x policy where features are patch releases."},{"claim_ids":["clm_ec080d87d2db66b25791e412032384cfef92df5be88304a8e7a9298069b68fbe"],"opposing_claim_ids":[],"text":"Repository development practice: releases are automated via node-release-pr, node-release-cut, node-release, and node-github-release workflows; Dependabot applies a seven-day age policy to non-OpenAI dependencies, and updates still require review and passing CI."}],"claim_ids":["clm_3455ec9b588d4f19b3e1f68d740824c7bc7db574da880d32e9c911b5e3a31580","clm_ec080d87d2db66b25791e412032384cfef92df5be88304a8e7a9298069b68fbe"],"created_at":"2026-09-14T03:11:02Z","created_by_operation":"op_058f4e809230402dbca24f621cab3606","id":"pg_56cc4cf3b88453b1a74155a55759852c","maturity":"draft","page_type":"source","path":"pages/sources/openai-codex-security-releasing-md-75914c46386e-55a55759852c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ce54d3940ed0504889470270111cc13b"],"title":"openai/codex-security/RELEASING.md @ 75914c46386e","updated_at":"2026-09-14T03:11:02Z","updated_by_operation":"op_058f4e809230402dbca24f621cab3606"}
