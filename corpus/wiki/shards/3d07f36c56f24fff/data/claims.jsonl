{"access":"public","created_at":"2026-09-14T03:28:42Z","created_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2adce312392441e935479965283adcba53dec710902699c2701ba25d37ff8e55","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"2389-research/gossip@fb54508fa18c snapshot 1475be12321052f4","timeframe":null},"slice_ids":["slc_30ab13fca06c0f08e66b366c1e49f893e472592ffb88638c911df5daa0025043","slc_50bb7145938f68af446b5337106f875fe1a10cf09cdfb2274498e6024a3bd3e6","slc_f3538e3a91acf7452cc0774a92da312d557f5961282a6b4afe21b2ab34804be2"],"source_ids":["src_0c95d33d560456ed81ceeb4bd3c04f98","src_960815dffbe2551ca15432d1efd2ecd0"],"text":"A signed design contract (docs/contract.md) defines v1 semantics: event types, validation rules, view rules, and a standalone trust model, with amendments requiring design-room consensus rather than silent edits.","updated_at":"2026-09-14T03:28:42Z","updated_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f"}
{"access":"public","created_at":"2026-09-14T03:28:42Z","created_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2dd6e649c21b8a74b3929645d7afb4a083db9d2d3ffafc3a3e3a00a530d13d96","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"2389-research/gossip@fb54508fa18c snapshot 1475be12321052f4","timeframe":null},"slice_ids":["slc_0c3e0eb278a4b2767cdcdd9ed671f6d5c86bdd69df74862c72a8f8dcb147f8a2","slc_0f00620fde58580234bb2a7512717ad08c4466f5bbbc9b5f414c30cc9c67de1a"],"source_ids":["src_0c95d33d560456ed81ceeb4bd3c04f98","src_960815dffbe2551ca15432d1efd2ecd0"],"text":"Filesystem access to the SQLite file is the trust boundary and effectively membership; validation runs inside the CLI, and a hostile writer with file access can bypass it entirely.","updated_at":"2026-09-14T03:28:42Z","updated_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f"}
