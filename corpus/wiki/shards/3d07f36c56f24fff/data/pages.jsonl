{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_15c53c9fc340f6900e9c6d34946a26da746e5f464497cb1696034e7833bdd610"],"opposing_claim_ids":[],"text":"Repository development practice: the canonical gate is ./scripts/check (gofmt, vet, test) run before every commit, with conventional commits, ABOUTME header lines in .go and YAML files, and hooks never bypassed."},{"claim_ids":["clm_aee5553be45bc74727ad77b37f6ec40a44e5129bcfa1b498654373cdf76c8bd4"],"opposing_claim_ids":[],"text":"The tool is a single Go binary built with cobra, using pure-Go SQLite via modernc.org/sqlite so CGO_ENABLED=0 cross-compiles cleanly for darwin/linux on amd64 and arm64."},{"claim_ids":["clm_b7b13fb3d0d804bd0640fddcb0311a5f070a31fd13f2023920c83bbb4c3621bb"],"opposing_claim_ids":[],"text":"Repository development practice: releases are automated via a tag-push (v*) GitHub Actions workflow running goreleaser, which builds binaries, creates the GitHub release, and publishes a formula to 2389-research/homebrew-tap."}],"claim_ids":["clm_15c53c9fc340f6900e9c6d34946a26da746e5f464497cb1696034e7833bdd610","clm_aee5553be45bc74727ad77b37f6ec40a44e5129bcfa1b498654373cdf76c8bd4","clm_b7b13fb3d0d804bd0640fddcb0311a5f070a31fd13f2023920c83bbb4c3621bb"],"created_at":"2026-09-14T03:28:42Z","created_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f","id":"pg_6e058f399bf45a13be7e7f33bbb2cc69","maturity":"draft","page_type":"source","path":"pages/sources/2389-research-gossip-docs-superpowers-plans-2026-07-16-goreleaser-home-7f33bbb2cc69.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_23beecac8b1759b39b2d9c9cc280a543"],"title":"2389-research/gossip/docs/superpowers/plans/2026-07-16-goreleaser-homebrew.md @ fb54508fa18c","updated_at":"2026-09-14T03:28:42Z","updated_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f"}
