4a67","maturity":"draft","page_type":"entity","path":"pages/entities/2389-research-gossip-0f8516614a67.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"2389-research/gossip","updated_at":"2026-09-14T03:28:42Z","updated_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0abc3ca6f661346f62ca77c940aeb462692a36d12a06d4bc08f3ae9ef1514018"],"opposing_claim_ids":[],"text":"TTLs are speaker-chosen within store-configured default_ttl/max_ttl bounds, persisted as absolute expires_at at append; out-of-bounds TTLs are validation errors, not silent clamps."},{"claim_ids":["clm_1e730d26242fefe98aff50f4d37fbfb23471e6fd9c5952914decb3c82688c6f2"],"opposing_claim_ids":[],"text":"The store is an append-only, immutable event log in one SQLite file; all derived state (badges, views) is folded at read time and never stored, and the audit log retains everything including expired and hidden posts."},{"claim_ids":["clm_2adce312392441e935479965283adcba53dec710902699c2701ba25d37ff8e55"],"opposing_claim_ids":[],"text":"A signed design contract (docs/contract.md) defines v1 semantics: event types, validation rules, view rules, and a standalone trust model, with amendments requiring design-room consensus rather than silent edits."},{"claim_ids":["clm_2dd6e649c21b8a74b3929645d7afb4a083db9d2d3ffafc3a3e3a00a530d13d96"],"opposing_claim_ids":[],"text":"Filesystem access to the SQLite file is the trust boundary and effectively membership; validation runs inside the CLI, and a hostile writer with file access can bypass it entirely."},{"claim_ids":["clm_952497d2acafad3c4d45cde7311ee58b7a5bf2a4e4aa8cd7fe66fcbf4175da2e"],"opposing_claim_ids":[],"text":"Identity is configured via GOSSIP_ACTOR_ID and GOSSIP_PRINCIPAL_ID environment variables, and the store path defaults to ~/.gossip/gossip.db with GOSSIP_DB (or --db) to override."},{"claim_ids":["clm_990c63672b8e8bdfff528f43d83c29a4ac66a98ca8fa59e544aa4f5eff58e5df"],"opposing_claim_ids":[],"text":"Every post carries a rumor or observed label; there is deliberately no verified status in v1 because no verifier mechanism exists, and badges display evidence without ever minting truth."},{"claim_ids":["clm_d411149fb8119d5c8d888c4404f30a1d13ec506f1aaa129daa657c70d8853794"],"opposing_claim_ids":[],"text":"The CLI exposes commands including start, threads, read, post, corroborate, receipt, retract, hide, whoami, and log, with flags such as --label, --ttl, --ref, and --reason."},{"claim_ids":["clm_ea24042fc64980ae1a7c6d85f4945a91fcfd62feccdaff7844caede7d446b6c9"],"opposing_claim_ids":[],"text":"Documented v1 cuts include no verifier or verified status, no cross-store sharing, no per-thread ACLs, no rooms, no SSE/watch, no cryptographic identity, and no publish/live subscribers."}],"claim_ids":["clm_0abc3ca6f661346f62ca77c940aeb462692a36d12a06d4bc08f3ae9ef1514018","clm_1e730d26242fefe98aff50f4d37fbfb23471e6fd9c5952914decb3c82688c6f2","clm_2adce312392441e935479965283adcba53dec710902699c2701ba25d37ff8e55","clm_2dd6e649c21b8a74b3929645d7afb4a083db9d2d3ffafc3a3e3a00a530d13d96","clm_952497d2acafad3c4d45cde7311ee58b7a5bf2a4e4aa8cd7fe66fcbf4175da2e","clm_990c63672b8e8bdfff528f43d83c29a4ac66a98ca8fa59e544aa4f5eff58e5df","clm_d411149fb8119d5c8d888c4404f30a1d13ec506f1aaa129daa657c70d8853794","clm_ea24042fc64980ae1a7c6d85f4945a91fcfd62feccdaff7844caede7d446b6c9"],"created_at":"2026-09-14T03:28:42Z","created_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f","id":"pg_421869d734e851d092a7c000a14e3236","maturity":"draft","page_type":"source","path":"pages/sources/2389-research-gossip-docs-contract-md-fb54508fa18c-c000a14e3236.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0c95d33d560456ed81ceeb4bd3c04f98"],"title":"2389-research/gossip/docs/contract.md @ fb54508fa18c","updated_at":"2026-09-14T03:28:42Z","updated_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1e730d26242fefe98aff50f4d37fbfb23471e6fd9c5952914decb3c82688c6f2"],"opposing_claim_ids":[],"text":"The store is an append-only, immutable event log in one SQLite file; all derived state (badges, views) is folded at read time and never stored, and the audit log retains everything including expired and hidden posts."},{"claim_ids":["clm_2adce312392441e935479965283adcba53dec710902699c2701ba25d37ff8e55"],"opposing_claim_ids":[],"text":"A signed design contract (docs/contract.md) defines v1 semantics: event types, validation rules, view rules, and a standalone trust model, with amendments requiring design-room consensus rather than silent edits."},{"claim_ids":["clm_2dd6e649c21b8a74b3929645d7afb4a083db9d2d3ffafc3a3e3a00a530d13d96"],"opposing_claim_ids":[],"text":"Filesystem access to the SQLite file is the trust boundary and effectively membership; validation runs inside the CLI, and a hostile writer with file access can bypass it entirely."},{"claim_ids":["clm_952497d2acafad3c4d45cde7311ee58b7a5bf2a4e4aa8cd7fe66fcbf4175da2e"],"opposing_claim_ids":[],"text":"Identity is configured via GOSSIP_ACTOR_ID and GOSSIP_PRINCIPAL_ID environment variables, and the store path defaults to ~/.gossip/gossip.db with GOSSIP_DB (or --db) to override."},{"claim_ids":["clm_990c63672b8e8bdfff528f43d83c29a4ac66a98ca8fa59e544aa4f5eff58e5df"],"opposing_claim_ids":[],"text":"Every post carries a rumor or observed label; there is deliberately no verified status in v1 because no verifier mechanism exists, and badges display evidence without ever minting truth."},{"claim_ids":["clm_9b7ec6d7ed190398b6266c15d18e01076085f4d22c17b0aa09cd75241811a642"],"opposing_claim_ids":[],"text":"The CLI mints a fresh command key per invocation, so it offers no retry semantics in v1; re-running a command like retract is a distinct later command that is correctly rejected."},{"claim_ids":["clm_d411149fb8119d5c8d888c4404f30a1d13ec506f1aaa129daa657c70d8853794"],"opposing_claim_ids":[],"text":"The CLI exposes commands including start, threads, read, post, corroborate, receipt, retract, hide, whoami, and log, with flags such as --label, --ttl, --ref, and --reason."}],"claim_ids":["clm_1e730d26242fefe98aff50f4d37fbfb23471e6fd9c5952914decb3c82688c6f2","clm_2adce312392441e935479965283adcba53dec710902699c2701ba25d37ff8e55","clm_2dd6e649c21b8a74b3929645d7afb4a083db9d2d3ffafc3a3e3a00a530d13d96","clm_952497d2acafad3c4d45cde7311ee58b7a5bf2a4e4aa8cd7fe66fcbf4175da2e","clm_990c63672b8e8bdfff528f43d83c29a4ac66a98ca8fa59e544aa4f5eff58e5df","clm_9b7ec6d7ed190398b6266c15d18e01076085f4d22c17b0aa09cd75241811a642","clm_d411149fb8119d5c8d888c4404f30a1d13ec506f1aaa129daa657c70d8853794"],"created_at":"2026-09-14T03:28:42Z","created_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f","id":"pg_4677fa5e4d715b5ab8ac14a140bc6dd0","maturity":"draft","page_type":"source","path":"pages/sources/2389-research-gossip-readme-md-fb54508fa18c-14a140bc6dd0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_960815dffbe2551ca15432d1efd2ecd0"],"title":"2389-research/gossip/README.md @ fb54508fa18c","updated_at":"2026-09-14T03:28:42Z","updated_by_operation":"op_98eaafe799dd42c7886d0639aa52e21f"}
