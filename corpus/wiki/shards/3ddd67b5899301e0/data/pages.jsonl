{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_253c50f7f0225a6bef01fb1103d26154a5cca98057d9ef0dd5fea2de3111677f"],"opposing_claim_ids":[],"text":"The Pair is a free, open-source desktop app running two AI coding agents: a read-only Mentor that plans and reviews, and an Executor that writes code and runs commands, cross-checking each other's work."},{"claim_ids":["clm_44c3166fc8505eaa9932da57e432394649fb40b2a15c7cb52e50c9d164e5fdfc"],"opposing_claim_ids":[],"text":"Session snapshots are saved automatically; on relaunch the app detects interrupted sessions and offers to restore them with full conversation history and turn state."},{"claim_ids":["clm_e503dbd2ed75c7658f7ddf87c196fc2e6291cbd052a168000735f39a19ec893b"],"opposing_claim_ids":[],"text":"The product is model-agnostic: it can pair provider CLIs including opencode, Claude Code, OpenAI Codex, Gemini CLI, and Kimi Code in any combination, plus local models via Ollama."}],"claim_ids":["clm_253c50f7f0225a6bef01fb1103d26154a5cca98057d9ef0dd5fea2de3111677f","clm_44c3166fc8505eaa9932da57e432394649fb40b2a15c7cb52e50c9d164e5fdfc","clm_e503dbd2ed75c7658f7ddf87c196fc2e6291cbd052a168000735f39a19ec893b"],"created_at":"2026-09-14T03:19:47Z","created_by_operation":"op_167d8ec523564903bbeac6d27167d803","id":"pg_0e345bb6b9c059a5b6f8b6a3e6e17a9f","maturity":"draft","page_type":"source","path":"pages/sources/timwuhaotian-the-pair-llms-txt-8d678875f777-b6a3e6e17a9f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0d026a8468b854e489bf35e81a2d3cc1"],"title":"timwuhaotian/the-pair/llms.txt @ 8d678875f777","updated_at":"2026-09-14T03:19:47Z","updated_by_operation":"op_167d8ec523564903bbeac6d27167d803"}
