{"access":"public","created_at":"2026-09-14T02:00:55Z","created_by_operation":"op_66b14ef9a2984a849c024faadd745a0e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_95412ace5f12b83315def870104145fffb95a11cfb725736c30c60f80fa8d8e8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"emilianomusso/entwinellm@05d11506b780 snapshot 791760b25dea897c","timeframe":null},"slice_ids":["slc_945cd60c7a0b1d6d5c7b9fd70606dce3fdb6d941e48b0cc482a744d38ab3dffe"],"source_ids":["src_eef50f07ee655226b1f596c57191d43f"],"text":"Prompts target multiple languages (C#, Python, Java), reject non-coding requests, and enforce Clean Code principles with raw, comment-free output following Allman-style braces.","updated_at":"2026-09-14T02:00:55Z","updated_by_operation":"op_66b14ef9a2984a849c024faadd745a0e"}
