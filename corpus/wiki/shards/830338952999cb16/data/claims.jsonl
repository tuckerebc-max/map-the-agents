{"access":"public","created_at":"2026-09-14T03:33:51Z","created_by_operation":"op_7042051a3a6f4b0d9066c504450c5cda","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5b235ada0b054a12ce2cf13e967dc354b11e830b1e3eb53c2007eeeff5817918","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"anaconda-labs/building-intelligent-apps-with-anaconda@e178c9baf99f snapshot 33cc142722d4db88","timeframe":null},"slice_ids":["slc_959dc9cc75da2c90a4e73fdade66d2a56f52963346be86f20a53a9582461de37","slc_e34d479d16712026554c1c30063ce26ec12d18e28df4d29f6bf3f1b8dc0125b9"],"source_ids":["src_95f7dcd2167a521890fbe5f9549a96b4"],"text":"The pipeline payload (ingestion.py and ValidationReport) is deliberately invariant across modules; only where it runs and what reasons about it changes.","updated_at":"2026-09-14T03:33:51Z","updated_by_operation":"op_7042051a3a6f4b0d9066c504450c5cda"}
{"access":"public","created_at":"2026-09-14T03:33:51Z","created_by_operation":"op_7042051a3a6f4b0d9066c504450c5cda","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_708e8213cbef4edeadd0e6bce91ab5690be99c80743a5c016f5248266cbcb0f8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"anaconda-labs/building-intelligent-apps-with-anaconda@e178c9baf99f snapshot 33cc142722d4db88","timeframe":null},"slice_ids":["slc_10665d6c42a80bfc8b28389e5040f41459e3155fb1ef9753dc52b20f71932324","slc_61e4ace7358c2ed20ce345643a5e195e8216573c6d7aff4947d60f1310863c42"],"source_ids":["src_95f7dcd2167a521890fbe5f9549a96b4"],"text":"Module 07 uses conda-lockfiles to pin environment.yml into a reproducible deployment contract, anaconda-audit for NVD/NIST CVE scanning, and conda-pack for offline deployment.","updated_at":"2026-09-14T03:33:51Z","updated_by_operation":"op_7042051a3a6f4b0d9066c504450c5cda"}
