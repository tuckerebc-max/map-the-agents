{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1b985c126853df7260d22911d90fe9de9fb3c4661729cf736bc014c9b10d7cd5"],"opposing_claim_ids":[],"text":"The model router is documented to connect to 40+ providers through one standard interface, naming OpenAI, Anthropic, and Gemini among supported model sources."},{"claim_ids":["clm_31ae4f4ee582f19c2969e09354956672374ac89757f93b34ea3874edb15ebb16"],"opposing_claim_ids":[],"text":"Mastra is documented as a TypeScript framework for building AI-powered applications and agents, integrating with React, Next.js, and Node or deployable as a standalone server."},{"claim_ids":["clm_55c2c3a59f3034c484ebc42b1b8086c9f6f4dcfbc72a3c90f912812d1019b7ff"],"opposing_claim_ids":[],"text":"Suspended agents or workflows use storage to remember execution state, allowing indefinite pausing and later resumption where execution left off."},{"claim_ids":["clm_6e902f92e265f05afa8d442deda91b061daead240772a952e530bcfee6a498fe"],"opposing_claim_ids":[],"text":"The repository uses dual licensing: Apache-2.0 for most code, while any directory named ee/ (e.g., packages/core/src/auth/ee/) falls under the Mastra Enterprise License, free for development/testing but requiring a license for production use."},{"claim_ids":["clm_70715d4cfe85ab6d7d28475a9780ac4309b0076106819a9dae7a3d01b863f44a"],"opposing_claim_ids":[],"text":"Documented capabilities include model routing to 40+ providers, autonomous agents, a graph-based workflow engine, human-in-the-loop suspend/resume, memory and RAG context management, MCP server authoring, and built-in evals and observability."},{"claim_ids":["clm_d9b432f90d2de20983246f880b759c632ec2307a24cfa98e8ced68f678a22c98"],"opposing_claim_ids":[],"text":"Mastra Studio is presented as a web interface at http://localhost:4111 for building, testing, and managing agents, workflows, and tools after starting the dev server."},{"claim_ids":["clm_dea4cdd59b2ea7d72708bba8f2d71d613e14cceeb9b60068632f42b07edaa0da"],"opposing_claim_ids":[],"text":"The workflow engine's documented control-flow syntax includes methods such as .then(), .branch(), and .parallel() for orchestrating multi-step processes."}],"claim_ids":["clm_1b985c126853df7260d22911d90fe9de9fb3c4661729cf736bc014c9b10d7cd5","clm_31ae4f4ee582f19c2969e09354956672374ac89757f93b34ea3874edb15ebb16","clm_55c2c3a59f3034c484ebc42b1b8086c9f6f4dcfbc72a3c90f912812d1019b7ff","clm_6e902f92e265f05afa8d442deda91b061daead240772a952e530bcfee6a498fe","clm_70715d4cfe85ab6d7d28475a9780ac4309b0076106819a9dae7a3d01b863f44a","clm_d9b432f90d2de20983246f880b759c632ec2307a24cfa98e8ced68f678a22c98","clm_dea4cdd59b2ea7d72708bba8f2d71d613e14cceeb9b60068632f42b07edaa0da"],"created_at":"2026-09-14T02:16:42Z","created_by_operation":"op_6423925cdbcf49528cef66292fc478b8","id":"pg_0be38107f3185541b068552e17b852cc","maturity":"draft","page_type":"source","path":"pages/sources/mastra-ai-mastra-readme-md-f04f724c6c58-552e17b852cc.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c51601eef4675946aa7e4987da6370db"],"title":"mastra-ai/mastra/README.md @ f04f724c6c58","updated_at":"2026-09-14T02:16:42Z","updated_by_operation":"op_6423925cdbcf49528cef66292fc478b8"}
