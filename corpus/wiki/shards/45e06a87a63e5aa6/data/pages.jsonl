{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1237d0054c9c9546007f261e427acb6ca3adf1a6d752bf8d1e331eee583f0168"],"opposing_claim_ids":[],"text":"Repository development practice: before requesting review, PRs must target main, build locally, pass linting and formatting, include passing tests, and update documentation when applicable."},{"claim_ids":["clm_1cf170cab058ceebd7324ebbdc0f0f30a9a5a25670a0438654408e65b1549c39"],"opposing_claim_ids":[],"text":"Repository development practice: contributors fork the repo, install dependencies with pnpm (preferred), create .env.local from .env.example, and confirm the app runs before making changes."},{"claim_ids":["clm_51125bf6ebd5bddbe59b2fedf457dd6acdf5891ef8dec945e52db2f57a46594d"],"opposing_claim_ids":[],"text":"Repository development practice: contributors branch from main using feature/, fix/, or chore/ prefixes and are asked to use conventional commits such as 'feat: add X'."},{"claim_ids":["clm_59490d55d679d2c285eb94a746d77b8a369d0dcaf4c870689cc7b77d1640ee9f"],"opposing_claim_ids":[],"text":"Repository development practice: bug reports should search existing issues first and include expected vs actual behavior, reproduction steps, environment details, and error output."},{"claim_ids":["clm_5b362885e06126c6d3a3b9894f9351ee9d8765c988ab039687a760cbcefc7436"],"opposing_claim_ids":[],"text":"Repository development practice: security vulnerabilities must follow the repository's SECURITY.yaml guidance and not be disclosed in public issues."},{"claim_ids":["clm_84acd0456a20266752241b931258bc5a5aa57db10af4a9acd7dc8201f92eb9ef"],"opposing_claim_ids":[],"text":"Repository development practice: the project uses Prettier and ESLint, has a __tests__ folder and Playwright configuration for end-to-end tests, and contributors should check package.json for test, lint, format, and dev scripts."},{"claim_ids":["clm_e063959a9ec49f2b2c2880a823440ac46f122c116b944307a92cf5792114df4e"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are licensed under the repository's MIT license, and the project adopts a Contributor Covenant 2.0 code of conduct with an enforcement ladder up to permanent bans."}],"claim_ids":["clm_1237d0054c9c9546007f261e427acb6ca3adf1a6d752bf8d1e331eee583f0168","clm_1cf170cab058ceebd7324ebbdc0f0f30a9a5a25670a0438654408e65b1549c39","clm_51125bf6ebd5bddbe59b2fedf457dd6acdf5891ef8dec945e52db2f57a46594d","clm_59490d55d679d2c285eb94a746d77b8a369d0dcaf4c870689cc7b77d1640ee9f","clm_5b362885e06126c6d3a3b9894f9351ee9d8765c988ab039687a760cbcefc7436","clm_84acd0456a20266752241b931258bc5a5aa57db10af4a9acd7dc8201f92eb9ef","clm_e063959a9ec49f2b2c2880a823440ac46f122c116b944307a92cf5792114df4e"],"created_at":"2026-09-14T01:42:53Z","created_by_operation":"op_f03bc3675ead4514ac6ff86f3cbe67d8","id":"pg_3e86f74382ee5afe8f67a684865bc3f3","maturity":"draft","page_type":"source","path":"pages/sources/codinit-dev-codinit-dev-contributing-md-daab8c9ef39b-a684865bc3f3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_fac6ae8fdfcd5e879af6dd6056703777"],"title":"codinit-dev/codinit-dev/CONTRIBUTING.md @ daab8c9ef39b","updated_at":"2026-09-14T01:42:53Z","updated_by_operation":"op_f03bc3675ead4514ac6ff86f3cbe67d8"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_724cb279ac40241046226c57ed93de601e7997a13d9d35879cfb9a3ad8be018d"],"opposing_claim_ids":[],"text":"Users can configure AI provider keys in a .env file and mix multiple providers, switching providers dynamically per task; the architecture is described as vendor-neutral to avoid lock-in."},{"claim_ids":["clm_75c29c9373a02dc1cb47e4c973bdd2c9ce476aab77cfc9496d1d69a65a0cfca3"],"opposing_claim_ids":[],"text":"The product supports both web browser and desktop (Electron) environments, and prebuilt desktop releases are offered for macOS, Windows, and Linux."},{"claim_ids":["clm_952f5b58a8d8bccc0ae9b3e5e237a68c84f41a0cc15170a8d57f08c66018ba3c"],"opposing_claim_ids":[],"text":"CodinIT.dev is described as an open-source AI full-stack development platform for building Node.js applications, combining code generation, project management, and deployment in one workflow."},{"claim_ids":["clm_b13578ec76dbc89b3898ef74a2e5bb78fe98bfac07e3e7d56645796aaff3e1ed"],"opposing_claim_ids":[],"text":"The README lists cloud AI providers including OpenAI, Anthropic, Google, Groq, xAI, DeepSeek, Cohere, Mistral, Together, Perplexity, HuggingFace, and OpenRouter, plus local options Ollama, LM Studio, and OpenAI-compatible endpoints."},{"claim_ids":["clm_f08f2f8b4e6521250633a8fd33b466b62b44dc880d2d5557f08ce652d20b24d8"],"opposing_claim_ids":[],"text":"The README claims an integrated suite with semantic search, diff visualization, concurrency file-locking, Supabase integration, real-time data visualization, and voice-command interfaces."}],"claim_ids":["clm_724cb279ac40241046226c57ed93de601e7997a13d9d35879cfb9a3ad8be018d","clm_75c29c9373a02dc1cb47e4c973bdd2c9ce476aab77cfc9496d1d69a65a0cfca3","clm_952f5b58a8d8bccc0ae9b3e5e237a68c84f41a0cc15170a8d57f08c66018ba3c","clm_b13578ec76dbc89b3898ef74a2e5bb78fe98bfac07e3e7d56645796aaff3e1ed","clm_f08f2f8b4e6521250633a8fd33b466b62b44dc880d2d5557f08ce652d20b24d8"],"created_at":"2026-09-14T01:42:53Z"