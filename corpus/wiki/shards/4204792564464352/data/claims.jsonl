{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2d4904ee0d9cd448f68a8e636c13d2e2678e9103316d5b18ba9c8cbe21d1ea57","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_a1d2e4e88b8c38282831e3361be14bcc5148ee4a3bdb97d8120b9d28710ab710","slc_dc2b2240b764a19d2de17e718d637c815860daef0c2eeefbf6914dc2ae3e7e27"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"On Windows the default shell is resolved in order DINOTTY_SHELL, pwsh.exe, powershell.exe, then %ComSpec%/cmd.exe, and DINOTTY_SHELL can override auto-detection.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_327828a440937367a150deb050e5ba08f9d713b5038c163d6163fcec99e96709","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_24ff3cb31f92a94ae311822ec34efe16a82c17adae622a22a40cc1ce53f00165","slc_99388358e0c71edfa4c853bf1a21eec2b5b373d39d6441bca4cff5945fafc6b4"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"Dinotty is described as a terminal built for coding agents, letting users run Claude Code, opencode, Codex, or OpenClaw on any device with multi-device session continuity.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4a52f411821b431f916e5ec025b42339d70e56b84a8e0e0971550e6cd87cfa59","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_20e4b2978a6e4e4cebb3adbe78aee7930cd43d066207b86b0a51d36fc0d18305","slc_39edbf0692f50955fcc505fd372bd5058998098971289c0b186ef6cd2a909f04","slc_8e10811065df5c0f98e9f6103f8d91394b0e9a131bd5b7af84f3e47bb88d6ef7"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"The server defaults to port 8999, accepts a -p flag for a custom port, and is accessed via browser at http://<ip>:8999.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5ddcbc6ca82ab604c7f4d80f3b52f7e2100bee9f42bf6f8ca9acd27d7dedfc03","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_2be8bd3774d6e8967d9a20f514259f0ed7ddaaa86b3d8db7c60e0b908f206a03"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"A built-in MCP JSON-RPC server is documented, allowing AI assistants to operate terminal sessions.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_866ed5a8d49dd5f4862de64277097f58b3f46fb18ca2d5b6ce9fd4f3bebcbf64","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_65404af3cd4734aa293301d3e985378931f2f7905e097a1527e186d03dd31b76","slc_ce91c54fd566034f10b30eafbee5d8c6714e3a476ab53a6cb5c537657cbb0066"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"A plugin system supports hot-reloadable JavaScript plugins with an API for custom commands, terminal interaction, event subscriptions, and CLI integration; built-ins include CC Switch and JSON Formatter.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9e0eaa98a7875abc9ea0ead65b0c1b3b3356de85b27fdc35fdfc3c8518fdd5ce","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_1921627c7e0aa64218e047d28adb699c62a4828ae6e2eba477c831eaae1e7b7f","slc_5b1b3b06bd6e87265674d4c436792771ab0f6bfe8ffa5c656b0e40151c2e1c93"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"PTY processes survive disconnection with auto-reconnect using exponential backoff; refreshing the page restores the session where it left off.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ad5ff4d42ed18b2dcdbdc097107ab78881e9de0ab1529fd89e68dd9bd142be3b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_b15bf8b4797e31ca245ddd163e7fff063264a712576cec1d11296dc86e7b8a09"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"The tech stack is Rust with Axum 0.7, Tokio, portable-pty, vte, russh, and russh-sftp on the backend; Vue 3, TypeScript, Vite, and xterm.js 5 on the frontend; Tauri for desktop.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b7b19fc28e6a895181ffd780e67090e25872687f745634b8f80260fd16c37b8f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_1bb60295928e0cfab466d7ab1692d28440faddebcf2a54c1c7cc09e5758cca78"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"Verification-code login requires a notifier plugin subscribed to the auth.verification_code event; uninstalling such a plugin while that mode is active is rejected with HTTP 409 to prevent lockout.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d19ce7efd39552779f364d828d9294a2f823fa5bd8901fd1cabbe34579ab64d8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_1921627c7e0aa64218e047d28adb699c62a4828ae6e2eba477c831eaae1e7b7f","slc_f09903cf6e088a711e910cba4b8a30f4711a0a5c97ad69160c1f1c9ef92969cb"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"Dinotty includes a built-in SSH client supporting password and key auth, with SFTP file browsing, editing, upload, and download auto-enabled over SSH connections.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e172be5daf7108b12c0f42d2bfc0608625abd8bc1b6b0f904b7f3171213b7b4a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_16ccf84b88e88fef4ef8424222f1c39e1f16a4f74eafb696c38fb9514bb64d51","slc_4783e955e6fa482332567133db895dce4d11d7b2ce946913e24a14591fe145a4"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"The server is described as a single Rust binary with zero dependencies, self-hosted with no subscription or relay, keeping data on the user's machine.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e5e8eba659fa5cc0ed6a9da852dd166456e37e47faa1e5de7d32d8de78b76037","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_abbef8e42716ed9f5fc77bbe11903d32e8695ff58655a4857130119db2ec166a"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"Access control includes a default token login plus a mutually exclusive 6-digit verification-code mode: codes are server-generated, pushed via a notifier plugin, valid 5 minutes, single-use, and invalidated after 5 wrong attempts.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
{"access":"public","created_at":"2026-09-14T03:24:52Z","created_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e961c520bbe8e278f7f24922b134f59a1c29e52a680b64db2d767a77bc657b79","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"xichan96/dinotty@b8081196ed61 snapshot 4521443326693707","timeframe":null},"slice_ids":["slc_1921627c7e0aa64218e047d28adb699c62a4828ae6e2eba477c831eaae1e7b7f","slc_1d4355b89524e29784d43c57e04a25243989f51715ebb9a164fe83b1b4df984a","slc_4783e955e6fa482332567133db895dce4d11d7b2ce946913e24a14591fe145a4"],"source_ids":["src_1b0d30a9c5a1523e89703c91ef5375fc"],"text":"The product uses a server-side virtual terminal: a full VTE parser runs on the server so it knows exact screen state, enabling session recovery and screen snapshots rather than acting as a WebSocket-to-PTY pipe.","updated_at":"2026-09-14T03:24:52Z","updated_by_operation":"op_8e4fdedec8d544e4be85bc88193c10dd"}
