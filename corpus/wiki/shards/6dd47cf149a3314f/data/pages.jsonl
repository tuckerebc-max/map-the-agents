{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0f30224cd5a009b77255ff4acd4cf574d153af37c74d0a7324aa97232b3c6dfc"],"opposing_claim_ids":[],"text":"The Discord bot configuration guide is described as basic, and running the Discord bots in production is stated to be at the user's own risk with permissions to be optimized as needed."},{"claim_ids":["clm_3a0733c8f0467b61f304c90ef7e1da85b21811d5c0f521d09ca2b5429858a6d5"],"opposing_claim_ids":[],"text":"Discord setup requires channel IDs per location in .env as <LOCATION_NAME>_CHANNEL_ID and bot tokens as <BOT_FIRST_NAME>_DISCORD_TOKEN, with the announcer bot needing Message Content Intent enabled."},{"claim_ids":["clm_5e73729f5f75557f071987b963f5d208d9f4cab32f3c0329281a5417ec006634"],"opposing_claim_ids":[],"text":"In the Discord integration, each world maps to a Discord guild, each location to a channel, each agent to a separate bot application, plus an announcer bot that announces agent movement between rooms."}],"claim_ids":["clm_0f30224cd5a009b77255ff4acd4cf574d153af37c74d0a7324aa97232b3c6dfc","clm_3a0733c8f0467b61f304c90ef7e1da85b21811d5c0f521d09ca2b5429858a6d5","clm_5e73729f5f75557f071987b963f5d208d9f4cab32f3c0329281a5417ec006634"],"created_at":"2026-09-14T03:28:23Z","created_by_operation":"op_d337ff31220b455fb492265d674b36c1","id":"pg_803a8b61bb275601ad74e84944d52a18","maturity":"draft","page_type":"source","path":"pages/sources/101dotxyz-gpteam-discord-md-a216364ea2db-e84944d52a18.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_728066ec12e157248ce2a7fefb37996d"],"title":"101dotxyz/GPTeam/DISCORD.md @ a216364ea2db","updated_at":"2026-09-14T03:28:23Z","updated_by_operation":"op_d337ff31220b455fb492265d674b36c1"}
