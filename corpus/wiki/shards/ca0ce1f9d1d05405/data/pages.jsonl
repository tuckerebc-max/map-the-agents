{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_8412cde7c165d5c716fad9a9a6ebe7c54d601865e5e8cf9a8b00454e039246ab"],"opposing_claim_ids":[],"text":"requirements.txt pins gradio==5.3.0, transformers==4.43.4, llama-recipes==0.0.3, and vllm==0.6.1; torch and openai are minimum-bounded (>=2.0, >=1.0), and datasets, fire, peft, accelerate, and wandb are unpinned."}],"claim_ids":["clm_8412cde7c165d5c716fad9a9a6ebe7c54d601865e5e8cf9a8b00454e039246ab"],"created_at":"2026-09-14T03:19:03Z","created_by_operation":"op_c0f81f3bb38041bf9835c2d85bb5041b","id":"pg_a5658f60d8c2564fbf2babfe04507319","maturity":"draft","page_type":"source","path":"pages/sources/thudm-scenegenagent-requirements-txt-cbaeeb96860f-abfe04507319.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5e2f0fce8f6e54c8a406b05e40b494e8"],"title":"THUDM/SceneGenAgent/requirements.txt @ cbaeeb96860f","updated_at":"2026-09-14T03:19:03Z","updated_by_operation":"op_c0f81f3bb38041bf9835c2d85bb5041b"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_37008e7e1337d799ae90204017f2f4bf26bd87850403608c49f892b1ee06cb73"],"opposing_claim_ids":[],"text":"Separate linked docs cover running the Gradio demo with API-based or offline models, training with SceneInstruct, building the SceneInstruct dataset, and running benchmark generation."},{"claim_ids":["clm_3c2aea56abc6126810a2d8bbc073b1a7db69c03eeedf08eeb5602a9303744a66"],"opposing_claim_ids":[],"text":"Precise layout planning is reportedly ensured through a structured, calculable format, layout verification, and iterative refinement to meet quantitative industrial requirements."},{"claim_ids":["clm_4d44144348fd136992a4185c7ee0cca4d172fdf1542b9a90ffbaa738a3ce9708"],"opposing_claim_ids":[],"text":"Installation is via git clone of the THUDM/SceneGenAgent repository followed by pip install -r requirements.txt."},{"claim_ids":["clm_5ba315d076d971c4378a0200c54b921bc1ca8f1071b8a769c9cad3a5b0609ded"],"opposing_claim_ids":[],"text":"SceneGenAgent is an LLM-based agent that generates industrial scenes through C# code, targeting precise measurements and positioning in industrial scene generation."},{"claim_ids":["clm_98b0719b3de55437a5703137485a8a3c6c9d248895b8f9a2f23703b0f614bd80"],"opposing_claim_ids":[],"text":"The repository provides code for deploying SceneGenAgent as a Gradio application."},{"claim_ids":["clm_9f77c4ee5da92ae207f527d497e5ae5d693d367e8d915597074bc7de0c5b644d"],"opposing_claim_ids":[],"text":"SceneInstruct is a dataset built for fine-tuning open-source LLMs to integrate into SceneGenAgent; fine-tuned Llama3.1-70B reportedly approaches GPT-4o capability."},{"claim_ids":["clm_caaab00ba6d5cd7c0affae318ea4b114dda6decae5df62c33c9b88b00ef261dc"],"opposing_claim_ids":[],"text":"The work is documented in an arXiv paper (2410.21909, 2024) with a linked Hugging Face collection."},{"claim_ids":["clm_cb0e2b6fba1174e40230f3b2e3fe57346b40eca18fa5f89e3bf5ce52877c6bc4"],"opposing_claim_ids":[],"text":"The README reports that LLMs powered by SceneGenAgent reach up to an 81.0% success rate on real-world industrial scene generation tasks."},{"claim_ids":["clm_d732bf585fea1b8fbc9295f5177f114b160f7e72f6e99fde1a42b2367861d222"],"opposing_claim_ids":[],"text":"Evaluation uses a curated benchmark of engineer-written scene descriptions, with manual checking of each generation's correctness."}],"claim_ids":["clm_37008e7e1337d799ae90204017f2f4bf26bd87850403608c49f892b1ee06cb73","clm_3c2aea56abc6126810a2d8bbc073b1a7db69c03eeedf08eeb5602a9303744a66","clm_4d44144348fd136992a4185c7ee0cca4d172fdf1542b9a90ffbaa738a3ce9708","clm_5ba315d076d971c4378a0200c54b921bc1ca8f1071b8a769c9cad3a5b0609ded","clm_98b0719b3de55437a5703137485a8a3c6c9d248895b8f9a2f23703b0f614bd80","clm_9f77c4ee5da92ae207f527d497e5ae5d693d367e8d915597074bc7de0c5b644d","clm_caaab00ba6d5cd7c0affae318ea4b114dda6decae5df62c33c9b88b00ef261dc","clm_cb0e2b6fba1174e40230f3b2e3fe57346b40eca18fa5f89e3bf5ce52877c6bc4","clm_d732bf585fea1b8fbc9295f5177f114b160f7e72f6e99fde1a42b2367861d222"],"created_at":"2026-09-14T03:19:03Z","created_by_operation":"op_c0f81f3bb38041bf9835c2d85bb5041b","id":"pg_b1955a6911c35e0a9cf0c4d9e334cbde","maturity":"draft","page_type":"source","path":"pages/sources/thudm-scenegenagent-readme-md-cbaeeb96860f-c4d9e334cbde.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8edf8434fe025a1b86b30f6460da046e"],"title":"THUDM/SceneGenAgent/README.md @ cbaeeb96860f","updated_at":"2026-09-14T03:19:03Z","updated_by_operation":"op_c0f81f3bb38041bf9835c2d85bb5041b"}
