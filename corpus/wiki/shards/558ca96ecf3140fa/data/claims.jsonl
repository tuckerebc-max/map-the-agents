{"access":"public","created_at":"2026-09-14T01:47:10Z","created_by_operation":"op_aa728a78c20745828d6ba859a88c0efb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_795605d98e326819d8e94b5cfb4f0aba6e3aed5806476995f9c15f1ea851eb32","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"egoist/waku@968d42dd38b7 snapshot 623975403b923962","timeframe":null},"slice_ids":["slc_89e17fa077f166df2e66095b589897b71af08ec0e99ca4947258a89797d4fb39"],"source_ids":["src_d76612cdd51155da99fc20dd87a3646e"],"text":"Waku is a native desktop app for working with local coding agents, built in Rust with GPUI, keeping projects, sessions, and transcripts on the user's machine.","updated_at":"2026-09-14T01:47:10Z","updated_by_operation":"op_aa728a78c20745828d6ba859a88c0efb"}
{"access":"public","created_at":"2026-09-14T01:47:10Z","created_by_operation":"op_aa728a78c20745828d6ba859a88c0efb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c3fa5df1dd0ae9d920e62a6e7a013929d934a74d6c7cd67267064401f56057e4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"egoist/waku@968d42dd38b7 snapshot 623975403b923962","timeframe":null},"slice_ids":["slc_de7032e8292be097db2fd5e2885d19b7315d8ab130e3c14eaca2e32bfea70079","slc_f90d31408d7f028046a6c4f9d83a9feea70cea5780cbc32fc6e3cf473ad6f9b2"],"source_ids":["src_1a5e633947505ce285964dd9c4b42be0"],"text":"Waku discovers provider-native slash commands and skills from installed agent CLIs, including multiline YAML descriptions, and invokes Codex, Pi, and Oh My Pi skills with their native syntax.","updated_at":"2026-09-14T01:47:10Z","updated_by_operation":"op_aa728a78c20745828d6ba859a88c0efb"}
