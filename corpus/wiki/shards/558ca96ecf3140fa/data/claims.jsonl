{"access":"public","created_at":"2026-09-14T01:47:10Z","created_by_operation":"op_aa728a78c20745828d6ba859a88c0efb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_403b5bd15160d4db108a59740d1c844418e7100cf38ac655c8f7bee21b37c44a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"egoist/waku@968d42dd38b7 snapshot 623975403b923962","timeframe":null},"slice_ids":["slc_9276752b023b15163e2fc39b05e785a9155ff6e1d6929eb9fd7580e9f85efbe0"],"source_ids":["src_d76612cdd51155da99fc20dd87a3646e"],"text":"The desktop's Settings → Daemon page can expose the child daemon on a fixed port, configure exact browser origins, and copy its stable authentication token; the daemon remains loopback-only by default.","updated_at":"2026-09-14T01:47:10Z","updated_by_operation":"op_aa728a78c20745828d6ba859a88c0efb"}
{"access":"public","created_at":"2026-09-14T01:47:10Z","created_by_operation":"op_aa728a78c20745828d6ba859a88c0efb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_490f5b6ee1ee9bfacd9afba1f33d6809099828ec6fd0d995bd182f33e7e9394a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"egoist/waku@968d42dd38b7 snapshot 623975403b923962","timeframe":null},"slice_ids":["slc_f68a543c2d28c892e40cefb8d09790b4a27f03dfede82d61278b018db07beee5"],"source_ids":["src_d76612cdd51155da99fc20dd87a3646e"],"text":"The app supports queueing or steering follow-up messages while an agent works, switching models, reasoning effort, and access modes from a shared interface, and rewinding Git-backed tasks with conversation-aware checkpoints.","updated_at":"2026-09-14T01:47:10Z","updated_by_operation":"op_aa728a78c20745828d6ba859a88c0efb"}
