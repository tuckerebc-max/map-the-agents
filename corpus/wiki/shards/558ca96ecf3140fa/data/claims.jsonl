{"access":"public","created_at":"2026-09-14T01:47:10Z","created_by_operation":"op_aa728a78c20745828d6ba859a88c0efb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f9694f1930b71ce797e0d4c510a656d43de690afc22ddf864901b2eed36c4f55","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"egoist/waku@968d42dd38b7 snapshot 623975403b923962","timeframe":null},"slice_ids":["slc_5216d1e820415e694d48d57dd739f533f7f175499a666889f7cfc39c0b1630a4","slc_ed42356690321011560ca8043e38f155b5b4da997c5242c91c2a291aa96a2f0f"],"source_ids":["src_d76612cdd51155da99fc20dd87a3646e"],"text":"When connected to an externally managed daemon, the local folder picker and PTY are unavailable until the protocol gains daemon-host picker and terminal-stream endpoints; the embedded browser and experimental computer-use integration are currently macOS-only.","updated_at":"2026-09-14T01:47:10Z","updated_by_operation":"op_aa728a78c20745828d6ba859a88c0efb"}
