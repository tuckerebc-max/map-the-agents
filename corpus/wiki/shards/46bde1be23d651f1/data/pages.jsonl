{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_15e033e9723e27160d29fcd09d0a504cfbc1e9330990f5dff131e3ddd7517803"],"opposing_claim_ids":[],"text":"The README states automations can be triggered from GitHub, Linear, or Slack events, or run manually from git events."},{"claim_ids":["clm_2c1418464554370fa222e5945a48440de3adc2f7908f05a958673857acaa47eb"],"opposing_claim_ids":[],"text":"1Code is described as an open-source coding agent client for running Claude Code, Codex, and other coding agents locally or in the cloud."},{"claim_ids":["clm_5d0bbb369dbb78f9f312e8a919ce26b70d5bb21503412e1448e6e9cef58a8a34"],"opposing_claim_ids":[],"text":"Plan mode documentation states the agent's proposed plan must be reviewed and approved, or modified, by the user before the agent acts."},{"claim_ids":["clm_6be633ef9a04445b47b6ac21a74d95342d4e8a48c76fcb5c87a2ba884c15be3c"],"opposing_claim_ids":[],"text":"Documented features include a Kanban board for visualizing agent sessions and a built-in Git client supporting staging, diffs, and pull request creation."},{"claim_ids":["clm_c75fcee7c0aed4d6591b8514ba48d5a8100ba28fd689f267ad5918bd70228660"],"opposing_claim_ids":[],"text":"The README comparison names diff previews, an integrated Git client, and viewing changes before they land as 1Code features."},{"claim_ids":["clm_cb5dd25cabee6bc339b4b00834d40adf08328069ce2729e5bdb68e330a4807c3"],"opposing_claim_ids":[],"text":"Documentation states each chat session runs in its own isolated git worktree, and background agents execute in cloud sandboxes while the local machine sleeps."},{"claim_ids":["clm_ce239e5e9a3dcaeb22d19f0e7795adcff00aa5ae323a7465ad9043879cc64b32"],"opposing_claim_ids":[],"text":"Documented features include custom skills and slash commands, plus custom sub-agents shown with a visual task display in the sidebar."},{"claim_ids":["clm_dc9b5565709c8481200df0a339c2cff82c7000b618190c0eaf6dcb2787927c2b"],"opposing_claim_ids":[],"text":"The documented feature list includes a model selector for switching providers and an integrated terminal panel toggled with a Cmd+J shortcut."},{"claim_ids":["clm_ea082ac3d1db9558150e3a2503a753be96a62b3c3a6e983e5f3a6877532c748d"],"opposing_claim_ids":[],"text":"The documented feature list states the product supports persistent memory through CLAUDE.md and AGENTS.md files."},{"claim_ids":["clm_f70cccd960512aff24e806378e6e6fc0005ba58c69e3a619dbff327713cb99fe"],"opposing_claim_ids":[],"text":"Build-from-source documentation states Python 3.11 is recommended for native module rebuilds, and setuptools must be installed manually on Python 3.12 and newer."}],"claim_ids":["clm_15e033e9723e27160d29fcd09d0a504cfbc1e9330990f5dff131e3ddd7517803","clm_2c1418464554370fa222e5945a48440de3adc2f7908f05a958673857acaa47eb","clm_5d0bbb369dbb78f9f312e8a919ce26b70d5bb21503412e1448e6e9cef58a8a34","clm_6be633ef9a04445b47b6ac21a74d95342d4e8a48c76fcb5c87a2ba884c15be3c","clm_c75fcee7c0aed4d6591b8514ba48d5a8100ba28fd689f267ad5918bd70228660","clm_cb5dd25cabee6bc339b4b00834d40adf08328069ce2729e5bdb68e330a4807c3","clm_ce239e5e9a3dcaeb22d19f0e7795adcff00aa5ae323a7465ad9043879cc64b32","clm_dc9b5565709c8481200df0a339c2cff82c7000b618190c0eaf6dcb2787927c2b","clm_ea082ac3d1db9558150e3a2503a753be96a62b3c3a6e983e5f3a6877532c748d","clm_f70cccd960512aff24e806378e6e6fc0005ba58c69e3a619dbff327713cb99fe"],"created_at":"2026-09-14T01:58:36Z","created_by_operation":"op_5d0fd275ae5840abacf6879050a8a774","id":"pg_12720aaa98e85d6aa183a96668b9ccf5","maturity":"draft","page_type":"source","path":"pages/sources/21st-dev-1code-readme-md-9f1bc76fa437-a96668b9ccf5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2379e307a65856dba60829351941515f"],"title":"21st-dev/1code/README.md @ 9f1bc76fa437","updated_at":"2026-09-14T01:58:36Z","updated_by_operation":"op_5d0fd275ae5840abacf6879050a8a774"}
