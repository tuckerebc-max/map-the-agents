{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0e8e01b736a37147daf48c02dbd9f84b6dbb2d743192fde4f9f674bdc7658823","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_27524be59d8a717adf6bbcfeb954645f5fa7188183ad95b078fa4c0d974659ad","slc_295aaa44d58ad02c69e090bedab61355505e2ce1def5c021b57b3387a8353fbe","slc_481f11cf8fa9a71f1c41799dd29e132e231e837b6d6f80fcebc1bde0c5f9501f","slc_95e59d1f08078cd635361734d08017a84863854a1b46743b0762730149511b4d","slc_e01a779d96015fb2033c2b311471391d04dcda95ea06c11f2ec4693a74bbbaa2"],"source_ids":["src_8686524fb1765efcb829ba3538313f7b"],"text":"The SDK (`@cline/sdk`) exposes the agent core programmatically, allowing custom tools via createTool and plugins with lifecycle hooks, and powers the CLI, desktop app, VS Code extension, and JetBrains plugin.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_12c7b18a122f2b80a8518ffe771b0312576d9877f370f3ae54617b29c10330cd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_9a2109881f96002d477b199fd127b05c85b5b79b16ea8df26c3af8377142d2e0"],"source_ids":["src_8686524fb1765efcb829ba3538313f7b"],"text":"Cline supports multiple model providers including Anthropic, OpenAI, Google, OpenRouter (200+ models), AWS Bedrock, Azure/GCP Vertex, Cerebras/Groq, Ollama/LM Studio for local models, and any OpenAI-compatible API.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_54f38b09322b5a051f001d517e9d52f9e6c40a293aca04698fbd9125742bcfbf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_fbeca97510e5e7f2fe03e576fce42a3b36d6064433671d1a98e4c2ad8208372d"],"source_ids":["src_8686524fb1765efcb829ba3538313f7b"],"text":"Repository development practice: contributors are directed to start with the Contributing Guide (CONTRIBUTING.md) and join the #contributors Discord channel.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_763d40f53afb4d9336220bf23ccd58ad63d9f143823ab3e6911520e75807f8d4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_5c08a82eb87f410f3238a5573d6c10d4a36df30cddbc231ef60722d9cd752297"],"source_ids":["src_d87d8cf7a2e15163bdcd9a6a00091494"],"text":"Sandbox mode can be enabled via the CLINE_SANDBOX environment variable, with sandbox session storage configurable through CLINE_SANDBOX_DATA_DIR.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8c22eb9ee4a201647dc88eb2cb86ee050b39f8e4fbe8fa9c3d92b22ad5d2a161","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_31d086c4c1e654994a0a238ce960679416c98517acbd4f1f0cfcaa0d7676292c","slc_9a179c1e281882eab2cad129f568326299e2a96eb6233448638954a2c5c32466","slc_b80128c9ebb847248b0182679bde40a7311c9aab264870cc43b2d94b41f058d3","slc_cfb2fd32c28744767c6af6fd20dbcc4a4d0190cdb7e691b50325f1a8633c9571"],"source_ids":["src_8686524fb1765efcb829ba3538313f7b"],"text":"The CLI installs via `npm i -g cline` and supports interactive chat or fully headless mode for CI/CD and scripting, including JSON output and piped input.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_97bb50af6163a9968c5c1b9d984ae6ad1db9d866f035235bdfc8f404ce19b03d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_3a7e0173d71d6bd6eb0d5eb603e9c5e83f4005c4566e0612539c34dfa06786f2","slc_9663e5e8f94350d67290b06c755a27db892983fbbc155ca86ab71f2ae55ae9c8","slc_a9f09ec2b5b6226144db0521dad887d02c30441d5de122639f02526608ee5bb7","slc_c7256867e279ea8ee9f9c3602fc6ec9ac553c251ca0e47738410413ce230d5f8","slc_d9858533982861a1af6c8a10ef28817347cadb3737c8545ae4b425e320c9ae5f"],"source_ids":["src_e635279e77cc5484b5e07f8f2a622b39"],"text":"Skills are modular instruction sets loaded on demand (unlike always-active rules): metadata loads at startup (~100 tokens), full SKILL.md instructions load when triggered via the use_skill tool or slash commands, and resources load as needed.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a1128ff581601d5289b832527018075de09885afd1e86ef6b24f37ec560c2e45","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_1a3d5eccf6bdf94f626ca8f30782b221c649d8cd2e76503e3aeba15ba6f2047a","slc_e22fa494249b7c93f10821df5ae8aefe1f0287df1a0a9e5866b69e5ea91d27f6","slc_eeb34b3f328b34bcd061232cba3329fe0f42f8a1d001962d98cbd8d7caa4c18c"],"source_ids":["src_a3b958a4c4425bd99985eded9c9264ae"],"text":"The Cline API requires a Bearer token in the Authorization header, with two auth methods: API keys created in the web dashboard and account auth tokens generated automatically on sign-in.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a1d75f5dc152d0af92a2c04f55654d4279a5d377a96cee4c1b5ec64117f612d9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_7d6ba4a3a1a691b86ca640927b8986b069fb05cb9ca0e9493e6138ca3c4deb2b"],"source_ids":["src_8686524fb1765efcb829ba3538313f7b"],"text":"The repository ships several products: an SDK, a CLI, a VS Code extension, a native macOS/Windows desktop app (Tauri shell, Bun sidecar, Next.js UI), and docs; the JetBrains plugin is not open-sourced.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b349330bcd7c830e7aec3560106bd0ae829bd972a279b7bbdb33d99a7660bae0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_4bba62728e457aa8957e6e7b2b67eb7f3889cd5ce00660913d0cb5ca0e036d60","slc_5c08a82eb87f410f3238a5573d6c10d4a36df30cddbc231ef60722d9cd752297","slc_8b218f2765797dbf2e9d838cd4eb8be6c744cb069d8f0af54173a665526c09c0","slc_ac0aab78558df3a184776228b2a6438db3eda976f8a60706342060fa5b319438","slc_f0c6d99a12413756ac943bb22ce51f2669103ca2271b2bc01e355c0a311d1c09"],"source_ids":["src_d87d8cf7a2e15163bdcd9a6a00091494"],"text":"Configuration lives in two scopes: global `~/.cline/` (with data/settings, teams, sessions, SQLite databases, workflows, rules, hooks, skills, agents, plugins, cron) and per-workspace `.cline/`; a custom directory can be set via CLINE_DATA_DIR.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c73caeb46327c64d7614220398aff12b28c6b88b7bc05a0d3954334771124eaf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_ec4942cb83c7ebe0431ba95fc32d2f82c5eb5e8ad898edeedccc4fa545886884"],"source_ids":["src_8686524fb1765efcb829ba3538313f7b"],"text":"Cline offers Plan and Act modes: Plan mode explores the codebase and proposes a strategy, Act mode executes, and every file edit and terminal command requires user approval unless auto-approve is toggled.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d06d78d5cd8373f0f6a24f03099e854573e204cacd03f44603974b67687a0e1c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_18301fc658c2b2e4bf8cb93192e39766d391737cf1a5ae124223d1fc45f4404e","slc_1de400015ccff75653b4ae8ebe28d9d26fcbc9a8fb0ecc3a67aee396956933e5","slc_667a338ba04e72354289cd3c3fed75a84c4476094232c58df362656427b5c53b","slc_fb5538165a75ef015d0562be353155da18751bb639b7e74334aacb0c41fc565c"],"source_ids":["src_e635279e77cc5484b5e07f8f2a622b39"],"text":"A skill is a directory containing a required SKILL.md with YAML frontmatter (name matching the directory, description up to 1024 chars), optionally with docs/ and scripts/ subdirectories; skills are discovered from .cline/skills/ or ~/.cline/skills/.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e19b334c79f94df6bbfd1f0dccdbd94d688298ce17ac9cdeb66f5a139ce50c8b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_352532ef8b1a11a6c09ee9e4a04f70e18093733b06dca14da3a46823f13a5c23","slc_5c08a82eb87f410f3238a5573d6c10d4a36df30cddbc231ef60722d9cd752297","slc_88b47b9dc7c04db5addca6f2a8759f4ce17e5ec4464f00309e397566b5684dd8","slc_95b726aa26cf6e4651f01688934572d26d182d2e5d8b9b42141eb78628d42816","slc_97c908e1fc10c454cd49a1ec20151c6b39dbcd7db4ff813e05b626af25586917"],"source_ids":["src_d87d8cf7a2e15163bdcd9a6a00091494"],"text":"Shell command execution can be restricted at runtime via the CLINE_COMMAND_PERMISSIONS environment variable, a JSON policy with allow/deny glob patterns where deny overrides allow, plus an allowRedirects option defaulting to false.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fccf4c08bf006e90479704661f754874ea704b5f43fb901a69cd238bf991c0bf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"cline/cline@c1c0b55ca03a snapshot ebde58e88eff80d7","timeframe":null},"slice_ids":["slc_07386117e530d4b4251716a124762cab951411089553a94b6504152cbff955d7","slc_e627a19c74db5f0da0e94cf846ec2816ec9abd9ac0fc1253bcece3d26a84173f"],"source_ids":["src_8686524fb1765efcb829ba3538313f7b"],"text":"In multi-agent teams, team state persists across sessions so work can be resumed, and scheduled cron agents persist across restarts and run independently of any terminal session.","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
