{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","id":"pg_21547ae32a7356138765b5c563da4af4","maturity":"draft","page_type":"source","path":"pages/sources/cline-cline-docs-sdk-tools-mdx-c1c0b55ca03a-b5c563da4af4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ace1cb67bd625b32b19ce3c003fb912d"],"title":"cline/cline/docs/sdk/tools.mdx @ c1c0b55ca03a","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_06c0c8d808e3415b0079d5265ddab81b741eb2f0db99d365c49e55aec0c1d94f"],"opposing_claim_ids":[],"text":"The CLI exposes commands including `cline auth` for sign-in, `cline mcp` for MCP server management, and `cline connect` for messaging integrations such as Telegram and Slack."},{"claim_ids":["clm_0e8e01b736a37147daf48c02dbd9f84b6dbb2d743192fde4f9f674bdc7658823"],"opposing_claim_ids":[],"text":"The SDK (`@cline/sdk`) exposes the agent core programmatically, allowing custom tools via createTool and plugins with lifecycle hooks, and powers the CLI, desktop app, VS Code extension, and JetBrains plugin."},{"claim_ids":["clm_12c7b18a122f2b80a8518ffe771b0312576d9877f370f3ae54617b29c10330cd"],"opposing_claim_ids":[],"text":"Cline supports multiple model providers including Anthropic, OpenAI, Google, OpenRouter (200+ models), AWS Bedrock, Azure/GCP Vertex, Cerebras/Groq, Ollama/LM Studio for local models, and any OpenAI-compatible API."},{"claim_ids":["clm_54f38b09322b5a051f001d517e9d52f9e6c40a293aca04698fbd9125742bcfbf"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are directed to start with the Contributing Guide (CONTRIBUTING.md) and join the #contributors Discord channel."},{"claim_ids":["clm_8c22eb9ee4a201647dc88eb2cb86ee050b39f8e4fbe8fa9c3d92b22ad5d2a161"],"opposing_claim_ids":[],"text":"The CLI installs via `npm i -g cline` and supports interactive chat or fully headless mode for CI/CD and scripting, including JSON output and piped input."},{"claim_ids":["clm_a1d75f5dc152d0af92a2c04f55654d4279a5d377a96cee4c1b5ec64117f612d9"],"opposing_claim_ids":[],"text":"The repository ships several products: an SDK, a CLI, a VS Code extension, a native macOS/Windows desktop app (Tauri shell, Bun sidecar, Next.js UI), and docs; the JetBrains plugin is not open-sourced."},{"claim_ids":["clm_c73caeb46327c64d7614220398aff12b28c6b88b7bc05a0d3954334771124eaf"],"opposing_claim_ids":[],"text":"Cline offers Plan and Act modes: Plan mode explores the codebase and proposes a strategy, Act mode executes, and every file edit and terminal command requires user approval unless auto-approve is toggled."},{"claim_ids":["clm_fccf4c08bf006e90479704661f754874ea704b5f43fb901a69cd238bf991c0bf"],"opposing_claim_ids":[],"text":"In multi-agent teams, team state persists across sessions so work can be resumed, and scheduled cron agents persist across restarts and run independently of any terminal session."}],"claim_ids":["clm_06c0c8d808e3415b0079d5265ddab81b741eb2f0db99d365c49e55aec0c1d94f","clm_0e8e01b736a37147daf48c02dbd9f84b6dbb2d743192fde4f9f674bdc7658823","clm_12c7b18a122f2b80a8518ffe771b0312576d9877f370f3ae54617b29c10330cd","clm_54f38b09322b5a051f001d517e9d52f9e6c40a293aca04698fbd9125742bcfbf","clm_8c22eb9ee4a201647dc88eb2cb86ee050b39f8e4fbe8fa9c3d92b22ad5d2a161","clm_a1d75f5dc152d0af92a2c04f55654d4279a5d377a96cee4c1b5ec64117f612d9","clm_c73caeb46327c64d7614220398aff12b28c6b88b7bc05a0d3954334771124eaf","clm_fccf4c08bf006e90479704661f754874ea704b5f43fb901a69cd238bf991c0bf"],"created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","id":"pg_37147285fcf45f59acbc673270f4376c","maturity":"draft","page_type":"source","path":"pages/sources/cline-cline-readme-md-c1c0b55ca03a-673270f4376c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8686524fb1765efcb829ba3538313f7b"],"title":"cline/cline/README.md @ c1c0b55ca03a","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_97bb50af6163a9968c5c1b9d984ae6ad1db9d866f035235bdfc8f404ce19b03d"],"opposing_claim_ids":[],"text":"Skills are modular instruction sets loaded on demand (unlike always-active rules): metadata loads at startup (~100 tokens), full SKILL.md instructions load when triggered via the use_skill tool or slash commands, and resources load as needed."},{"claim_ids":["clm_d06d78d5cd8373f0f6a24f03099e854573e204cacd03f44603974b67687a0e1c"],"opposing_claim_ids":[],"text":"A skill is a directory containing a required SKILL.md with YAML frontmatter (name matching the directory, description up to 1024 chars), optionally with docs/ and scripts/ subdirectories; skills are discovered from .cline/skills/ or ~/.cline/skills/."}],"claim_ids":["clm_97bb50af6163a9968c5c1b9d984ae6ad1db9d866f035235bdfc8f404ce19b03d","clm_d06d78d5cd8373f0f6a24f03099e854573e204cacd03f44603974b67687a0e1c"],"created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","id":"pg_6ef80011f33f598390acc8aa33956eac","maturity":"draft","page_type":"source","path":"pages/sources/cline-cline-docs-customization-skills-mdx-c1c0b55ca03a-c8aa33956eac.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e635279e77cc5484b5e07f8f2a622b39"],"title":"cline/cline/docs/customization/skills.mdx @ c1c0b55ca03a","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
