lm_e19b334c79f94df6bbfd1f0dccdbd94d688298ce17ac9cdeb66f5a139ce50c8b","clm_fccf4c08bf006e90479704661f754874ea704b5f43fb901a69cd238bf991c0bf"],"created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","id":"pg_7e3cdc42b1d755578440fe56868d8dff","maturity":"draft","page_type":"entity","path":"pages/entities/cline-cline-fe56868d8dff.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"cline/cline","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_06c0c8d808e3415b0079d5265ddab81b741eb2f0db99d365c49e55aec0c1d94f"],"opposing_claim_ids":[],"text":"The CLI exposes commands including `cline auth` for sign-in, `cline mcp` for MCP server management, and `cline connect` for messaging integrations such as Telegram and Slack."},{"claim_ids":["clm_a1128ff581601d5289b832527018075de09885afd1e86ef6b24f37ec560c2e45"],"opposing_claim_ids":[],"text":"The Cline API requires a Bearer token in the Authorization header, with two auth methods: API keys created in the web dashboard and account auth tokens generated automatically on sign-in."}],"claim_ids":["clm_06c0c8d808e3415b0079d5265ddab81b741eb2f0db99d365c49e55aec0c1d94f","clm_a1128ff581601d5289b832527018075de09885afd1e86ef6b24f37ec560c2e45"],"created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","id":"pg_c5fc9962b17f566f9b859e1a0b015ae2","maturity":"draft","page_type":"source","path":"pages/sources/cline-cline-docs-api-authentication-mdx-c1c0b55ca03a-9e1a0b015ae2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a3b958a4c4425bd99985eded9c9264ae"],"title":"cline/cline/docs/api/authentication.mdx @ c1c0b55ca03a","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_763d40f53afb4d9336220bf23ccd58ad63d9f143823ab3e6911520e75807f8d4"],"opposing_claim_ids":[],"text":"Sandbox mode can be enabled via the CLINE_SANDBOX environment variable, with sandbox session storage configurable through CLINE_SANDBOX_DATA_DIR."},{"claim_ids":["clm_b349330bcd7c830e7aec3560106bd0ae829bd972a279b7bbdb33d99a7660bae0"],"opposing_claim_ids":[],"text":"Configuration lives in two scopes: global `~/.cline/` (with data/settings, teams, sessions, SQLite databases, workflows, rules, hooks, skills, agents, plugins, cron) and per-workspace `.cline/`; a custom directory can be set via CLINE_DATA_DIR."},{"claim_ids":["clm_e19b334c79f94df6bbfd1f0dccdbd94d688298ce17ac9cdeb66f5a139ce50c8b"],"opposing_claim_ids":[],"text":"Shell command execution can be restricted at runtime via the CLINE_COMMAND_PERMISSIONS environment variable, a JSON policy with allow/deny glob patterns where deny overrides allow, plus an allowRedirects option defaulting to false."}],"claim_ids":["clm_763d40f53afb4d9336220bf23ccd58ad63d9f143823ab3e6911520e75807f8d4","clm_b349330bcd7c830e7aec3560106bd0ae829bd972a279b7bbdb33d99a7660bae0","clm_e19b334c79f94df6bbfd1f0dccdbd94d688298ce17ac9cdeb66f5a139ce50c8b"],"created_at":"2026-09-14T01:42:03Z","created_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c","id":"pg_f468137ed2ec5693bcd47e6fb64f73e1","maturity":"draft","page_type":"source","path":"pages/sources/cline-cline-docs-getting-started-config-mdx-c1c0b55ca03a-7e6fb64f73e1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d87d8cf7a2e15163bdcd9a6a00091494"],"title":"cline/cline/docs/getting-started/config.mdx @ c1c0b55ca03a","updated_at":"2026-09-14T01:42:03Z","updated_by_operation":"op_6c222957f7d74cdfa3b83e7f7d290c2c"}
