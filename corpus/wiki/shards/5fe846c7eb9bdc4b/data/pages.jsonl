{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5785201efd8539f70fe48600e9e8f3dff986a9014e74ac69809ee8c218468a3d"],"opposing_claim_ids":[],"text":"Repository development practice: security bugs must not be disclosed in public issues; reporters should contact the team by email instead."},{"claim_ids":["clm_c4bb3b9bd0c41152265c75e1d660c763f27e2833dffffac921e1de9c7a7d5f75"],"opposing_claim_ids":[],"text":"Repository development practice: PRs should follow AngularJS commit message conventions, pass lint (gofmt, golangci-lint), and include test cases; git-flow branching is used."}],"claim_ids":["clm_5785201efd8539f70fe48600e9e8f3dff986a9014e74ac69809ee8c218468a3d","clm_c4bb3b9bd0c41152265c75e1d660c763f27e2833dffffac921e1de9c7a7d5f75"],"created_at":"2026-09-14T03:42:58Z","created_by_operation":"op_7ba8e055603e4e7a9b6fae33bb8ffcac","id":"pg_b27a845a925756a9a24242005c10c9fc","maturity":"draft","page_type":"source","path":"pages/sources/coze-dev-coze-studio-contributing-md-fefb05ff27be-42005c10c9fc.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_17914f6884d2524d9b194e1977359f93"],"title":"coze-dev/coze-studio/CONTRIBUTING.md @ fefb05ff27be","updated_at":"2026-09-14T03:42:58Z","updated_by_operation":"op_7ba8e055603e4e7a9b6fae33bb8ffcac"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_25810b429e727ab22fff0acff556f07cf65533ef5dbb93c768010d7f178fd5c2"],"opposing_claim_ids":[],"text":"Repository development practice: contributors use a Rush.js monorepo with 135+ frontend packages, run tests via rush test / go test, and follow coverage targets by package level (80% for level 1)."},{"claim_ids":["clm_45445fbdf514406b74e3437b967142d27a0b8de6e334151a763a369fbc6f7f1e"],"opposing_claim_ids":[],"text":"Repository development practice: model configuration requires copying a template in backend/conf/model/ and setting id, API key, and model; supported providers include OpenAI, Volcengine Ark, Claude, Gemini, Qwen, DeepSeek, and Ollama."}],"claim_ids":["clm_25810b429e727ab22fff0acff556f07cf65533ef5dbb93c768010d7f178fd5c2","clm_45445fbdf514406b74e3437b967142d27a0b8de6e334151a763a369fbc6f7f1e"],"created_at":"2026-09-14T03:42:58Z","created_by_operation":"op_7ba8e055603e4e7a9b6fae33bb8ffcac","id":"pg_d5987279080c509db2db111c0840c4b2","maturity":"draft","page_type":"source","path":"pages/sources/coze-dev-coze-studio-claude-md-fefb05ff27be-111c0840c4b2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b314598f5fd255fb835b9e176f8bd01e"],"title":"coze-dev/coze-studio/CLAUDE.md @ fefb05ff27be","updated_at":"2026-09-14T03:42:58Z","updated_by_operation":"op_7ba8e055603e4e7a9b6fae33bb8ffcac"}
