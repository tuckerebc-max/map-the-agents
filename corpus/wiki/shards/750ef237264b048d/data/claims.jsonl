{"access":"public","created_at":"2026-09-14T03:29:37Z","created_by_operation":"op_b64393a459e845329241e61928992ba6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_30db35620469a1b2153e76249e09c65a4e4081e83c651af3fe46796bf1c92f97","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"a115/icodes@8961152cb0a9 snapshot 36f1d6ab199e7277","timeframe":null},"slice_ids":["slc_41d50dc75b2700b20e043ea4885e80c72315a1717a30ea0fefb7520a4d80c12f","slc_8128b0b999c1d70c6d1d3eed16ff88cc0bca8a69b74872129bab9e79ef209813"],"source_ids":["src_ab22b94920ed55d099016db90c7bd50b"],"text":"The 'build-index' command generates an indexed database of commit insights for a given Git repository.","updated_at":"2026-09-14T03:29:37Z","updated_by_operation":"op_b64393a459e845329241e61928992ba6"}
{"access":"public","created_at":"2026-09-14T03:29:37Z","created_by_operation":"op_b64393a459e845329241e61928992ba6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_36b34bb3978f7b4ca98b7d5d86b83a8f00301b5c132feaf753613f9ec431294d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"a115/icodes@8961152cb0a9 snapshot 36f1d6ab199e7277","timeframe":null},"slice_ids":["slc_0a51a2a5a9c05434332ef09b4512687827c420170a1f6ad95c39ddf52890968a"],"source_ids":["src_ab22b94920ed55d099016db90c7bd50b"],"text":"iCODES analyzes and indexes Git commit histories using LLM techniques, summarizing commit intents and enabling semantic search over codebases.","updated_at":"2026-09-14T03:29:37Z","updated_by_operation":"op_b64393a459e845329241e61928992ba6"}
{"access":"public","created_at":"2026-09-14T03:29:37Z","created_by_operation":"op_b64393a459e845329241e61928992ba6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_726c396279c7108e8fe733963f2dfd93807afe634aad74501443b352d5e8d02e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"a115/icodes@8961152cb0a9 snapshot 36f1d6ab199e7277","timeframe":null},"slice_ids":["slc_7e0d5fdc961983dded3aca8f256fc94b7d671258ef22df2460e45e6f7c6374a9","slc_e926d79c1b43188f932841389721ffcc75075966a3b501a66235a01a8c4fd29e","slc_fa52ee6380ded21f1d92ce2dadd0cea57da578ae243e431c941b083f4569b274"],"source_ids":["src_ab22b94920ed55d099016db90c7bd50b"],"text":"The CLI provides an 'inspect-repo' command taking a repository path and an optional --branch-name flag; without a branch it uses the current branch and analyzes the latest commit.","updated_at":"2026-09-14T03:29:37Z","updated_by_operation":"op_b64393a459e845329241e61928992ba6"}
{"access":"public","created_at":"2026-09-14T03:29:37Z","created_by_operation":"op_b64393a459e845329241e61928992ba6","evidence_type":"organizational_statement","extraction_confidence":0.5,"id":"clm_78dbc26a8b0f0fbda28f2dc69b3c807cf69f8092254fff86c1c45463758a3c25","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=inference; facet=design-choices","setting":"a115/icodes@8961152cb0a9 snapshot 36f1d6ab199e7277","timeframe":null},"slice_ids":["slc_2d1ac03add99b2f2c03e20efa8f755441a5b313a7e59769905364293c9335420"],"source_ids":["src_ab22b94920ed55d099016db90c7bd50b"],"text":"The default model choice of gpt-3.5-turbo appears to reflect a deliberate price/quality tradeoff stated in the documentation.","updated_at":"2026-09-14T03:29:37Z","updated_by_operation":"op_b64393a459e845329241e61928992ba6"}
{"access":"public","created_at":"2026-09-14T03:29:37Z","created_by_operation":"op_b64393a459e845329241e61928992ba6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a371e45e86c7ab740d6c9e2103aa026a480e05b6c95fac133ce82df6d1b81b1b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"a115/icodes@8961152cb0a9 snapshot 36f1d6ab199e7277","timeframe":null},"slice_ids":["slc_2d1ac03add99b2f2c03e20efa8f755441a5b313a7e59769905364293c9335420"],"source_ids":["src_ab22b94920ed55d099016db90c7bd50b"],"text":"The only supported LLM backend is OpenAI; the OPENAI_API_KEY environment variable must be exported, and DEFAULT_MODEL selects the GPT model (default gpt-3.5-turbo).","updated_at":"2026-09-14T03:29:37Z","updated_by_operation":"op_b64393a459e845329241e61928992ba6"}
