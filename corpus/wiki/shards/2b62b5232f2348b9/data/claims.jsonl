{"access":"public","created_at":"2026-09-14T01:44:06Z","created_by_operation":"op_ba954430b879456fa1e6599cb581e387","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f781504c28d792a98b1db39c555896954a53e7c1415b1f8ae0f0e1642040448f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"construct-worlds/construct@cf75b7398c78 snapshot c959755ce3b13c69","timeframe":null},"slice_ids":["slc_c565343822b0150417b3ec86ada54fd336c64731d2359b3f4f78a2ce2fce2eab"],"source_ids":["src_7a0a58936ecc5662b59e0741d37b912f"],"text":"The TUI supports `?` for help and `M-x` for a command palette, and users can create sessions, switch agents, send input, inspect diffs, and interrupt work from it.","updated_at":"2026-09-14T01:44:06Z","updated_by_operation":"op_ba954430b879456fa1e6599cb581e387"}
