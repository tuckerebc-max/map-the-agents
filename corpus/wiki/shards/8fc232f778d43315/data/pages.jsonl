{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1623001b537bb3811391522a819665a30fba37fb3fbfdde411e6f52d000c3fc1"],"opposing_claim_ids":[],"text":"Session 1 covers getting started with AI and building basic automation scripts in Python, with example notebooks for an automated email broadcaster and an automated report builder/emailer."},{"claim_ids":["clm_1937b6af621ea945268b9c7f507c3a991aaac7d6068b7431f4dc8af4b73b6ce1"],"opposing_claim_ids":[],"text":"Session 6 covers AI project management, presenting a framework for achieving ROI on AI projects along with best practices."},{"claim_ids":["clm_35674d9580d5247eb3a063e9445edbb4a03e96f7b592caca7e36964196f27655"],"opposing_claim_ids":[],"text":"Session 5 addresses fine-tuning for model customization via additional training, with examples of fine-tuning BERT for text classification and a LinkedIn post writer."},{"claim_ids":["clm_663accdf756175d54541aec60db35e97e346fe0956325ad4a7e3cd0c7c7d3434"],"opposing_claim_ids":[],"text":"Session 4 covers RAG and text embeddings, with example notebooks on unstructured survey analysis, semantic search over blog posts, and a RAG chatbot over a blog series."},{"claim_ids":["clm_6e4275d392a208c865435b80570917d891c39a03ad2a8f8ade6d6467b51d35d0"],"opposing_claim_ids":[],"text":"The repository holds code for AI Builders Bootcamp #1, a course with a homepage hosted on Maven."},{"claim_ids":["clm_b1bee2bab2399335b66d56028ad850e03097e50038ff03d24ddf777bae72cc26"],"opposing_claim_ids":[],"text":"The course material appears organized as one directory per session, each containing numbered example Jupyter notebooks, based on the linked notebook paths in the README."},{"claim_ids":["clm_c7f06b2604db1ea60357f8d5ff8b0ba81866bc1179ce688a10ae715ebc8bea26"],"opposing_claim_ids":[],"text":"Session 2 focuses on ETL pipelines for machine learning, illustrated by a Gmail inbox ETL notebook and an email classifier training notebook."},{"claim_ids":["clm_d8638cd14fccdf229467b3b676475e11769136cb0c2e14dc41d4ccd2b9634761"],"opposing_claim_ids":[],"text":"Session 3 introduces building AI systems with LLMs, noting datasets are not needed to start, with examples including a paper summarizer, text classifier, and local document QA using LLaMA 3.2 Vision."}],"claim_ids":["clm_1623001b537bb3811391522a819665a30fba37fb3fbfdde411e6f52d000c3fc1","clm_1937b6af621ea945268b9c7f507c3a991aaac7d6068b7431f4dc8af4b73b6ce1","clm_35674d9580d5247eb3a063e9445edbb4a03e96f7b592caca7e36964196f27655","clm_663accdf756175d54541aec60db35e97e346fe0956325ad4a7e3cd0c7c7d3434","clm_6e4275d392a208c865435b80570917d891c39a03ad2a8f8ade6d6467b51d35d0","clm_b1bee2bab2399335b66d56028ad850e03097e50038ff03d24ddf777bae72cc26","clm_c7f06b2604db1ea60357f8d5ff8b0ba81866bc1179ce688a10ae715ebc8bea26","clm_d8638cd14fccdf229467b3b676475e11769136cb0c2e14dc41d4ccd2b9634761"],"created_at":"2026-09-14T04:20:35Z","created_by_operation":"op_86a4a40e8da04d128cc63448a17824ba","id":"pg_b23d0af62a845c878f0ad6819d7c3476","maturity":"draft","page_type":"source","path":"pages/sources/shawhint-ai-builders-bootcamp-1-readme-md-175b96b2324b-d6819d7c3476.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_39d8727f056a559e8c823c2027132fcc"],"title":"ShawhinT/AI-Builders-Bootcamp-1/README.md @ 175b96b2324b","updated_at":"2026-09-14T04:20:35Z","updated_by_operation":"op_86a4a40e8da04d128cc63448a17824ba"}
