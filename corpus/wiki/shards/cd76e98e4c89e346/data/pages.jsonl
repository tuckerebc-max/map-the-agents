{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_42996f6c0ef0ccdada72823ee04b1ec0344b3341a2d059d0532834ef13e7ec66"],"opposing_claim_ids":[],"text":"Repository development practice: the codebase is organized as packages/core (shared engine), apps/cli (raw-ANSI TUI, one file per command), apps/desktop (WIP), and bun:test tests; runtime state lives in gitignored .workstreams/."},{"claim_ids":["clm_49f53e40598741ec4399cc9660a585d71fac53097d4169cd5a51ed085219201b"],"opposing_claim_ids":[],"text":"Repository development practice: contributors clone, run bun install and bun link, run tests with bun test, and submit small PRs from main after adding tests."}],"claim_ids":["clm_42996f6c0ef0ccdada72823ee04b1ec0344b3341a2d059d0532834ef13e7ec66","clm_49f53e40598741ec4399cc9660a585d71fac53097d4169cd5a51ed085219201b"],"created_at":"2026-09-14T03:23:41Z","created_by_operation":"op_e8b2bb14422f487bbff4dba09b1a1183","id":"pg_29c3b48c140d56a7ab43b5e29e3e6334","maturity":"draft","page_type":"source","path":"pages/sources/workstream-labs-workstreams-contributing-md-ef30f54b40fe-b5e29e3e6334.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4313dd9d5f7a51028862c321ec48de1b"],"title":"workstream-labs/workstreams/CONTRIBUTING.md @ ef30f54b40fe","updated_at":"2026-09-14T03:23:41Z","updated_by_operation":"op_e8b2bb14422f487bbff4dba09b1a1183"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_040a80a5f2e20aa741c539c25213ff0864db55762df1eb1ccafe8aa6ef50c08b"],"opposing_claim_ids":[],"text":"The app is not yet signed with an Apple certificate, so users must strip the macOS quarantine flag with xattr to avoid a misleading 'damaged app' error."},{"claim_ids":["clm_048a6eae2350834a948877ff5b4f0f3431d66b73e6785d9f53c969172ec35d99"],"opposing_claim_ids":[],"text":"The project ships as a macOS desktop app distributed via DMG installers for Apple Silicon (arm64) and Intel (x64), with built-in auto-update."},{"claim_ids":["clm_089206d0451d8d43c51a4557030254f40a5b5be51271b4cd43615de5fb537a71"],"opposing_claim_ids":[],"text":"Claude Code lifecycle events (idle, working, awaiting permission, ready for review) are tracked per worktree via hooks and shown as animated sidebar status indicators."},{"claim_ids":["clm_1b3c529982c492b4553b00a69c106edd15de05b871a3d8136191bd39d4be1141"],"opposing_claim_ids":[],"text":"The product is agent-agnostic and reportedly works with Claude, Codex, Aider, and other agents."},{"claim_ids":["clm_213b19c0d2513292ea35d7c73c15da5f706ba1c68b51a702a9b2388535d65e09"],"opposing_claim_ids":[],"text":"Each workstream is defined with a natural-language prompt and an agent choice, and gets its own isolated git worktree."},{"claim_ids":["clm_225a7453cc4fbe74be088ceb941184b33e133b7ff7b58a2eb391c9834e2579c6"],"opposing_claim_ids":[],"text":"Workstreams is described as an IDE for orchestrating parallel AI coding agents, each running in an isolated git worktree."},{"claim_ids":["clm_3cb340164dbe4116e1235090f0b1e66fd8c273bdffb2247313f8b9b509bda963"],"opposing_claim_ids":[],"text":"Users can leave inline comments on split-side diffs and send them to Claude as structured prompts containing file path, line number, and diff context."},{"claim_ids":["clm_453f7343d96facf90ca6b6c523e32536b7d398b751f12370e6c3132c71bf03fc"],"opposing_claim_ids":[],"text":"An orchestrator sidebar manages multiple git worktrees per repository, showing real-time addition/deletion counts and preserving per-worktree terminals, editors, and state."},{"claim_ids":["clm_7864cacbe35ca983fa3a01bd85fffa5ed6fd9bfd90f0e05c31a252523173821f"],"opposing_claim_ids":[],"text":"A CLI named `ws` (in apps/cli) supports commands such as init, create, run, and dashboard for terminal-driven workstream management."},{"claim_ids":["clm_db28710bcf2c03063fa5a081cde8afa3aeecff4c3aceac7498c2b175be4809c3"],"opposing_claim_ids":[],"text":"Running the project requires macOS, Node.js 22, Git, and Bun for CLI installation."}],"claim_ids":["clm_040a80a5f2e20aa741c539c25213ff0864db55762df1eb1ccafe8aa6ef50c08b","clm_048a6eae2350834a948877ff5b4f0f3431d66b73e6785d9f53c969172ec35d99","clm_089206d0451d8d43c51a4557030254f40a5b5be51271b4cd43615de5fb537a71","clm_1b3c529982c492b4553b00a69c106edd15de05b871a3d8136191bd39d4be1141","clm_213b19c0d2513292ea35d7c73c15da5f706ba1c68b51a702a9b2388535d65e09","clm_225a7453cc4fbe74be088ceb941184b33e133b7ff7b58a2eb391c9834e2579c6","clm_3cb340164dbe4116e1235090f0b1e66fd8c273bdffb2247313f8b9b509bda963","clm_453f7343d96facf90ca6b6c523e32536b7d398b751f12370e6c3132c71bf03fc","clm_7864cacbe35ca983fa3a01bd85fffa5ed6fd9bfd90f0e05c31a252523173821f","clm_db28710bcf2c03063fa5a081cde8afa3aeecff4c3aceac7498c2b175be4809c3"],"created_at":"2026-09-14T03:23:41Z","created_by_operation":"op_e8b2bb14422f487bbff4dba09b1a1183","id":"pg_738babfd31bb511e8ae8fdc13ff6d42e","maturity":"draft","page_type":"source","path":"pages/sources/workstream-labs-workstreams-readme-md-ef30f54b40fe-fdc13ff6d42e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_21d1c00d94d959448df32227df7f91f9"],"title":"workstream-labs/workstreams/README.md @ ef30f54b40fe","updated_at":"2026-09-14T03:23:41Z","updated_by_operation":"op_e8b2bb14422f487bbff4dba09b1a1183"}
