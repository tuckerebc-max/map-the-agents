{"access":"public","created_at":"2026-09-14T03:25:17Z","created_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c6e1a3789e00d96753593140255b3969b9fe57f76e0218dc715db158caf2590c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"xiaomimimo/mimo-code@6fbb1732232c snapshot d96a162cc3e28c0a","timeframe":null},"slice_ids":["slc_670b184e867e78b9cba5d0ea85d6fe6c836654f1047cd5e157146305e3e09a0f","slc_dcf7032602361434c00c205fbbfc69924632573d7d519b486ebbbc582d4ab8dc"],"source_ids":["src_90482fc645e750f795208ff2bb5d75a2"],"text":"Builtin skills are matched by exact name, localized alias, or BM25 relevance; high-confidence matches auto-load, and users can override builtins with same-name skills in project or personal skill directories.","updated_at":"2026-09-14T03:25:17Z","updated_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb"}
