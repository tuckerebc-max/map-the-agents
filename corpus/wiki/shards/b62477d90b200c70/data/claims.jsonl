{"access":"public","created_at":"2026-09-14T03:25:17Z","created_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_15240c53919e0e0e430d8728137c74f3bb4b04d4d00c7b9e6367afeb3b26045a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"xiaomimimo/mimo-code@6fbb1732232c snapshot d96a162cc3e28c0a","timeframe":null},"slice_ids":["slc_95aacfde970cf69b017b466d92b1ea4026712085a6184cceaa488035f8662fcb"],"source_ids":["src_90482fc645e750f795208ff2bb5d75a2"],"text":"The README states MiMoCode does not support the built-in macOS Terminal.app, recommending iTerm2 or the VS Code integrated terminal for rendering issues.","updated_at":"2026-09-14T03:25:17Z","updated_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb"}
{"access":"public","created_at":"2026-09-14T03:25:17Z","created_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2045fffbe584c14a0c4ac8123f674e87a3459fafa70a169f661d9c3dd9d6b935","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"xiaomimimo/mimo-code@6fbb1732232c snapshot d96a162cc3e28c0a","timeframe":null},"slice_ids":["slc_0474e9d3f62af027a14e29e4aad601b1ca19ea87a8ecbdf1f92b8e697d3530ed","slc_6ae63ff584e0feccf58ef4c7111ba33aa3f1e53a33dbc889f88bcac58cca9c43","slc_7bdc9cd5ceffeac0b8283d852746a5dad273cf0084dbb959a93767d79eacfc29"],"source_ids":["src_90482fc645e750f795208ff2bb5d75a2"],"text":"Workflows are deterministic JavaScript scripts orchestrating multiple agents with fixed phases, bounded retries, and automatic parallelization; four built-ins ship (compose, deep-research, fact-check, research-experiment), and custom ones go in .mimocode/workflows/.","updated_at":"2026-09-14T03:25:17Z","updated_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb"}
{"access":"public","created_at":"2026-09-14T03:25:17Z","created_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2990f3cc22d78682a10f6967c7ffc961156bfc83574fed19cc0fb69812d369c9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"xiaomimimo/mimo-code@6fbb1732232c snapshot d96a162cc3e28c0a","timeframe":null},"slice_ids":["slc_0e544a9b478678c6c7feede3d7ab75af3dd67b714a34f789d262f035ff5a3ed9","slc_49e0e4b93edf59c25539c71bba6c8dd97ae0343404e84617f64f45f77c936986"],"source_ids":["src_6b019d2dcaa65e8b94675c5a2066b0e4"],"text":"For GPT/Codex models, a smaller tool ABI (bash, apply_patch, view_image, exec) is exposed; exec composes host tools inside QuickJS while permissions and side effects remain under host control.","updated_at":"2026-09-14T03:25:17Z","updated_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb"}
{"access":"public","created_at":"2026-09-14T03:25:17Z","created_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_34fa756b8b6e3b0863234103e432abd8f028ea360aea448417665ba6410f991a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"xiaomimimo/mimo-code@6fbb1732232c snapshot d96a162cc3e28c0a","timeframe":null},"slice_ids":["slc_0df45d62a273575d558f38e49ba880bd1f5e6aec96821cee4327fcb2053bf567","slc_a765819b0f18e4b79d1430f27a42e72b17461447e760fba90b5d0ee3a4d4fe4a","slc_d7422bded0f187b0673772acd9d3523fcd1a22f65550574d510cafef7bc6663d"],"source_ids":["src_90482fc645e750f795208ff2bb5d75a2"],"text":"Cross-session memory uses SQLite FTS5 with files for project memory (MEMORY.md), session checkpoints, scratch notes, and per-task progress; memory is injected automatically on session resume.","updated_at":"2026-09-14T03:25:17Z","updated_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb"}
{"access":"public","created_at":"2026-09-14T03:25:17Z","created_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_50be779ee40350ac4133631be84aa6ba913f0ae16ea3b1330e2c856e01a743e2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"xiaomimimo/mimo-code@6fbb1732232c snapshot d96a162cc3e28c0a","timeframe":null},"slice_ids":["slc_6ca2c713215f867a3fa2fcde307afaa990aa403d93c5ec41afed714b43109575","slc_c6d6f6f0095b72ad901dc14bdb080edd7130251e4e28c49e5d372393fb8beb0f"],"source_ids":["src_90482fc645e750f795208ff2bb5d75a2"],"text":"Context management includes automatic checkpoints, context reconstruction near the window limit, budgeted injection with importance ranking, and a per-model adjustable compaction point via /context-limit or compaction.max_context.","updated_at":"2026-09-14T03:25:17Z","updated_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb"}
{"access":"public","created_at":"2026-09-14T03:25:17Z","created_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5bb0176e60f170b8b00bd0321b586e5178b37b447c1a16a0a04da0642accec96","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"xiaomimimo/mimo-code@6fbb1732232c snapshot d96a162cc3e28c0a","timeframe":null},"slice_ids":["slc_1b5381cd71c7ef1097f03762687dc93e1d7e28e08d8a4e81f70edfca2268db78","slc_1e32b090fde2dbac245cb239279cb054d7e42a1d474d819f608035cb29f3f123","slc_dbe244d7fabac5d9d1b60c2fe4c26ba65413d02d67afdcb446ce45a40ce3fb3a"],"source_ids":["src_90482fc645e750f795208ff2bb5d75a2"],"text":"File access outside the project directory triggers an external_directory permission prompt by default; /tmp can be allowlisted in config, and --dangerously-skip-permissions injects an allow-all base while explicit deny rules still block.","updated_at":"2026-09-14T03:25:17Z","updated_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb"}
{"access":"public","created_at":"2026-09-14T03:25:17Z","created_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5c2f70f436c9fa63d9e3ae3b9cffd3f99adca62b60755283838e435c8eaa79b1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"xiaomimimo/mimo-code@6fbb1732232c snapshot d96a162cc3e28c0a","timeframe":null},"slice_ids":["slc_5fcd7f781c6dfbfd3d816c4ccf00d9265784923084d740186a490dad00d8dac1"],"source_ids":["src_90482fc645e750f795208ff2bb5d75a2"],"text":"Repository development practice: development uses bun (bun ci for frozen-lockfile install, bun run dev, bun turbo typecheck).","updated_at":"2026-09-14T03:25:17Z","updated_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb"}
{"access":"public","created_at":"2026-09-14T03:25:17Z","created_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5f7e36ab93631df2b87a88ce376a949ffe84becb0522f1b166b26b0caff321cb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"xiaomimimo/mimo-code@6fbb1732232c snapshot d96a162cc3e28c0a","timeframe":null},"slice_ids":["slc_37b8ea4d71b0947b6d5082e673744e9b2ccd30f5f4cdac08e1b10d982bda37a7","slc_504001494ba47b4c214995bd4cc555e20cb67f2a7aab925ea1a70d93e2bd0867","slc_d46b5e4805456886fc02c145b66d723e257dfd36a4028278e6871636162786b6"],"source_ids":["src_6b019d2dcaa65e8b94675c5a2066b0e4"],"text":"The GPT profile is enabled when the model ID contains 'gpt-' (excluding 'oss' and 'gpt-4') and hides overlapping read/write/edit/grep/glob tools; prompt routing and tool profiles use separate string rules not yet unified.","updated_at":"2026-09-14T03:25:17Z","updated_by_operation":"op_55462cb4c6484827b9b7f5719aa858eb"}
