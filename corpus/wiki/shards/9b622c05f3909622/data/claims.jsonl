{"access":"public","created_at":"2026-09-14T02:30:20Z","created_by_operation":"op_fc7daaf917a34b80b4790f6c97eb113e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f3c7c5b3e09dce8e228ddd65d370a6c1f9e3aaf2ad8139393c5482b1f24fc103","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"patched-codes/patchwork@21948cbec44d snapshot 05fb15c6c171a6dd","timeframe":null},"slice_ids":["slc_cec1571e13010b74144bb425857bbea17e823efc6c942180f3993861b8c0502d"],"source_ids":["src_40d8d0bdab2757c6bb5b492295d90375"],"text":"Patchwork is built from three key components: reusable atomic steps (e.g., create PR, commit changes, call an LLM), customizable prompt templates, and patchflows that combine steps and prompts into automations.","updated_at":"2026-09-14T02:30:20Z","updated_by_operation":"op_fc7daaf917a34b80b4790f6c97eb113e"}
{"access":"public","created_at":"2026-09-14T02:30:20Z","created_by_operation":"op_fc7daaf917a34b80b4790f6c97eb113e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fabbbf3f4b19050237a43e34da3c6ffe92e35dba3c9f299ca5e1ec2c4331fb3e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"patched-codes/patchwork@21948cbec44d snapshot 05fb15c6c171a6dd","timeframe":null},"slice_ids":["slc_5d9b48c5dfc8bf8e7718506a69824144130d2b066bf6c920cc502926a3b5ff23","slc_c042c11513211042aa050655758c6a46f20cfd8b507b819bee9017625075e5fd","slc_c87234c790f720eb33588ad77f512d941b2ba62384474aaf475762a0681b4c62"],"source_ids":["src_40d8d0bdab2757c6bb5b492295d90375"],"text":"The CLI runs patchflows with the syntax 'patchwork <PatchFlow> <?Arguments>'; arguments override patchflow attributes as key=value pairs, and valueless keys are treated as boolean True flags.","updated_at":"2026-09-14T02:30:20Z","updated_by_operation":"op_fc7daaf917a34b80b4790f6c97eb113e"}
