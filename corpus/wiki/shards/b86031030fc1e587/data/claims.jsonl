{"access":"public","created_at":"2026-09-14T03:27:02Z","created_by_operation":"op_be8e1eb6d17e49ad84af7a2e03aabef2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_493879dd99ecb73f373d99ab813d0eb1eddea01255e1b0e8c2aef5b4671cdd83","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"zclllyybb/opengiraffe@40180a705d31 snapshot b25edc3f887cf4c8","timeframe":null},"slice_ids":["slc_644d0b354cbc0a3d026f7f5f9cbb7875ceba6812541f6d644d1b6252479ed0d1","slc_75ac12e7041115fa7c375ee01b1b7f7d0cba7ccafeebf8e6becdeacadf9cbbdc"],"source_ids":["src_e74699f9a19c5b9da9f50f5287ab9b2a"],"text":"Multiple reviewer models vote on each change, and all reviewers must approve for a task to pass; any REQUEST_CHANGES feeds reviewer feedback back to the coder.","updated_at":"2026-09-14T03:27:02Z","updated_by_operation":"op_be8e1eb6d17e49ad84af7a2e03aabef2"}
{"access":"public","created_at":"2026-09-14T03:27:02Z","created_by_operation":"op_be8e1eb6d17e49ad84af7a2e03aabef2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6edc40b15353de5bafd9bec25b3e10c88544ec4a9d6a8271f19b97618d5c73d9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"zclllyybb/opengiraffe@40180a705d31 snapshot b25edc3f887cf4c8","timeframe":null},"slice_ids":["slc_903e6980bc8a38e87fab1c572d80ceb4ac6e5c7ad27b935dc135ff50287762f0"],"source_ids":["src_e74699f9a19c5b9da9f50f5287ab9b2a"],"text":"The system is described as a persistent daemon-based multi-agent system using opencode to explore, plan, implement, and review code changes, with tasks running in parallel git worktrees.","updated_at":"2026-09-14T03:27:02Z","updated_by_operation":"op_be8e1eb6d17e49ad84af7a2e03aabef2"}
