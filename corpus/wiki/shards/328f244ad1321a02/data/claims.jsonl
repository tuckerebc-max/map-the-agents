{"access":"public","created_at":"2026-09-14T02:13:54Z","created_by_operation":"op_e30c2089428e46049722c3145813b3c3","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9bf1f7346e3e1cfdd9cba101b262c4e644305b116a4db78eca34b7db7d767d5b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"linghungegeg/linghun@05d8457bd04a snapshot 64bad13006da78ed","timeframe":null},"slice_ids":["slc_09964ad01f3c719c0fa72a09a55cb0408425bc2aa90ff47decfb01231c9e238f","slc_93181aa6c0bd1af419bc1cfa84884f5d102334b08c8830ebe2390cbfd5282e02"],"source_ids":["src_90afde0e64ba5311b83808a4a90ed8ad"],"text":"A central scheduler combines task type, permissions, evidence, memory, failure records, provider state, workflow state, user state, context pressure, and verification needs to decide each turn's route (read code, clarify, verify, chat, or enter complex task flows).","updated_at":"2026-09-14T02:13:54Z","updated_by_operation":"op_e30c2089428e46049722c3145813b3c3"}
