{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_033db32ad36c6264814c50f9fbd2b4c45cc2c89f0b92d9a7cf898db5bb4ee497","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_1c0957c8a7965972be3fec8a9388675ab4c55ad75a5bb5d2dceea91a34671c93","slc_ce01e367098da733d8af5a8253b0b08e4d9c6c9233b8841e51e9cfbc00655768"],"source_ids":["src_155a1730fae459c39b9c865d4621123a","src_ac1bd9db6607570886182b4a80dfa269"],"text":"Optional review_mode: branch commits successful agent work to a forgeo/review/<TASK_ID> branch, marks the task REVIEW, and waits for a human merge/Complete or Request-changes action instead of committing directly to main.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_05a85f0e27f653315e7806b989bdfaced92fc2efab2ed2f7c78e6c6fdb6093bb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_13ae0842b015fedb959122319a451d108defdf955c131ae5f180a4240dac6407","slc_1c0957c8a7965972be3fec8a9388675ab4c55ad75a5bb5d2dceea91a34671c93"],"source_ids":["src_155a1730fae459c39b9c865d4621123a","src_ac1bd9db6607570886182b4a80dfa269"],"text":"Task selection picks the oldest OPEN task whose dependencies are all COMPLETED (or whose run_at schedule is due); REVIEW blocks dependants while independent tasks keep running.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_09bdd8288a200c68a853e249deb1c2ec784dd7964a94fb7410d6d4b1d57f1eb5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_353ecbc4885885cbd1fe584fd29707fd95d34ebe724218f837b02eda37bd53d3","slc_5b54a176eaf01e76772408c13b570f10fbb553dabe81cb8a1cbbb279981f851d","slc_b20f9fde7e9e5c12efc23945c368d81c04ed476b8e5709a1251a32c48cbe4efc"],"source_ids":["src_b2c2c07470425edb9255d90e162e2559"],"text":"Repository development practice: contributors must run pytest, ruff check, and mypy src/forgeo before opening a PR, and CI enforces the same quality gates on pull requests.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2befd9e1af1a0fbed374262864d41fbd66b8f4f415c96a2a4bea2f547bc336f4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_d3f7e2a5070013aca27644361543161120dc27ab31d32089b67d26c52c49c04f","slc_ef89effd7a99ef214064ee10f0f01c82893d2adb8079a5f21086b5c766c13947"],"source_ids":["src_155a1730fae459c39b9c865d4621123a","src_ac1bd9db6607570886182b4a80dfa269"],"text":"The dashboard supports optional bearer-token auth via forgeo web --token (or a token in ~/.config/forgeo/web.toml), returning 401 on /api/* routes without it; without a flag or token file it stays open by default.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_45865eca87b7c24ad6b3cc32463f495ffb164e7a68286a6d013da838481257a5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_06381937cb0a3e6b8c7b8af1de5e61b23e8764f3154d08dbc9bc8c602fff7943","slc_48bc5b1fb384f3a602db7670987fe4a4755e9df5bb6f9775615ac9338a934b9b","slc_50e03b754cd679063e3bca084feda84cd99c1c4a8d9301e2f9a74a3508080395","slc_6ba4c5c6ebb19c78918c9ce1c3da066ffb85c022ed69105ac13ec1b8cdbe8907","slc_ce954adae7a6a1d2a76899ea23aa15a70f57f1c059e90d47849833ab478be9d4"],"source_ids":["src_155a1730fae459c39b9c865d4621123a","src_ac1bd9db6607570886182b4a80dfa269"],"text":"Forgeo persists runtime state in .forgeo/ (backlog, logs, blockers) plus runs.jsonl run history, daemon.state.json, and rotating backlog.json.bak snapshots restored when the backlog is found corrupt.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4c4fb2e9da456b43d8ae4916c3f92400c07fdf7f2979e1c4a543b41f743e8a29","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_54f16d99ae07991f48662f824cd55b32c37ae079663aa04948aa7e91de678c54","slc_cc671001d649bb1257bf6cdf5f6db4d56bf3eadba98141bec7eb4fb44bdf7ec6"],"source_ids":["src_155a1730fae459c39b9c865d4621123a"],"text":"An optional Docker sandbox runs the agent isolated, with a configurable image, network (default none), read-only mounts, and the repo bind-mounted at the same path.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_502eb40bb2bfa12d35a0c2bbb8886fb3c50303cdab94f239c9b2271ea829dbef","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_06381937cb0a3e6b8c7b8af1de5e61b23e8764f3154d08dbc9bc8c602fff7943","slc_66d5270e8b9a47f9706713d970e002b19e207666a57ca3f768a0504159e3622e","slc_7fbfcb9f6a3a5109e88e2578bd931ba9ce96a3721ac74aaef72bfd1462aa3b46"],"source_ids":["src_155a1730fae459c39b9c865d4621123a","src_ac1bd9db6607570886182b4a80dfa269"],"text":"Backlog providers are file, HTTP, GitHub, GitLab, and Jira; file/HTTP exchange the full document while Jira/GitHub/GitLab sync issues individually, with engine state stored in a hidden forgeo block or issue properties.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_594d2b0a06fb928745b63a6ab93dd90e231f50b1395cd9b99e74f52bd2a50d5a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_33979c946aea1732e115516cc80348dec777d7058bb594e715f35a5e194bcdfe","slc_3d5d8c30113bd11120a0d6799a599799077202605daf8f647c678544e6e596c1"],"source_ids":["src_155a1730fae459c39b9c865d4621123a"],"text":"Forgeo is described as a software factory for a coding agent: given a backlog and an agent CLI, it picks the next runnable task, runs the agent, commits the result, and tracks progress in plain files plus a web dashboard.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7dbff1382a95bee2b761e38d4b87fc5af4618dcdd69efb81870625934e13d092","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_883171cd8af84a90365bd9e68bfd9d6c93005ee471ace437b39d8e4f8021c12b"],"source_ids":["src_ac1bd9db6607570886182b4a80dfa269"],"text":"A silent no-change success (exit 0 with unchanged tree) marks the task BLOCKED for human review rather than FAILED, unless the agent opts in via no_changes_exit_code.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_87f5d225a4b747829d7c08e2d54ccc6932fcb867e8463f7afb3e43076b2cd91d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_04a2ef45490576311a6dd5d199626e6cf6e0bf712917953d0fcd669528012445","slc_7a3041fd277f114aacb66b699897bb68c35f299a121ff6a49b0658f97c5120e2","slc_83ba923228388712190b3696c8406341a03fa4cd27fec2e95533c35b18bf409a","slc_ee79efe62fcf6ed0160065548ea838a81581d4a48198265a5bbad45c622cc5e3"],"source_ids":["src_155a1730fae459c39b9c865d4621123a"],"text":"CLI surface includes forgeo init, validate, start, once, run --task, status, stop, restart, instance add/list, and web, with the daemon running one cycle per interval_minutes.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d3ab0ad618a850d3121b80de9a49700266442b0db7cb0a8a8abf0bea23f9c2fb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_1544b39bee1a0006395e497a40d2463c196626c35693661bc12b4a51ef55e4a2","slc_6bea34eef1e8360072dba75bd52f3cb86f8e045f3bc056d225f1b19717a91f47","slc_97c473deaf03fefbfefe7ec89eb4a60f957ad474344f5aed4ec8b71449cad2b4","slc_ef89effd7a99ef214064ee10f0f01c82893d2adb8079a5f21086b5c766c13947"],"source_ids":["src_155a1730fae459c39b9c865d4621123a","src_ac1bd9db6607570886182b4a80dfa269"],"text":"The central dashboard (forgeo web) defaults to 0.0.0.0:8790, aggregates all registered instances, and exposes a per-instance HTTP API under /api/instances/<name>/ including task create/edit/delete, reopen, config PUT, and daemon start/stop/restart endpoints.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
{"access":"public","created_at":"2026-09-14T02:15:16Z","created_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_eba71376f94ccc43fdcd8122179470d2c36a8d98dcb3d0f5e06f1aef70882334","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"lucagazzola/forgeo@6e709a374a66 snapshot 12163ac21a1508c3","timeframe":null},"slice_ids":["slc_1c0957c8a7965972be3fec8a9388675ab4c55ad75a5bb5d2dceea91a34671c93","slc_5720b98dc5611db2af0fd27ca788bd631fd7cbbc844f4da3bd3f894dd1588e79"],"source_ids":["src_155a1730fae459c39b9c865d4621123a","src_b2c2c07470425edb9255d90e162e2559"],"text":"The agent contract is agent-agnostic: any CLI that reads the FORGEO_TASK environment variable can be used, and the backlog task's acceptance criteria are rendered into that instruction.","updated_at":"2026-09-14T02:15:16Z","updated_by_operation":"op_a7d4dcfb211c4a4cbf589b3ad352064e"}
