{"access":"public","created_at":"2026-09-14T01:28:18Z","created_by_operation":"op_a0006f1055684bb5a254cffff3079b46","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8d3cd70a1aeb1242fb4a2e6c075ee6e75e2360abb434dfd3ab8290d05fdeda0b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"777genius/agent-teams-ai@43764e1df31f snapshot 771d7e3404fa9a61","timeframe":null},"slice_ids":["slc_1604a59c8eeb3a8fe277eee420c46da3c46feeb0f397ff221b8e773a215edb1d","slc_3934f5d23270d83a248d536da102c90143a7e0aed1da013d66d3c91dca5a3a55","slc_48cc52564045962fd586e1d51f62df52c4f00c73f434dd7bb8e8626f570ffd3d"],"source_ids":["src_db0470fef8265fd9afc018a63feda0c9","src_f0c135cdb4e05b528158bf607a79fe53"],"text":"Agents in a team message each other, create and manage shared tasks on a kanban board, review each other's work, and can communicate across different teams; multiple teams can run simultaneously and coordinate.","updated_at":"2026-09-14T01:28:18Z","updated_by_operation":"op_a0006f1055684bb5a254cffff3079b46"}
