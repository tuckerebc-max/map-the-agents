{"access":"public","created_at":"2026-09-14T01:28:18Z","created_by_operation":"op_a0006f1055684bb5a254cffff3079b46","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e95694869f32c094078cc21b9091527e30a0c87e51c7772c1949a4f8ccdcffa0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"777genius/agent-teams-ai@43764e1df31f snapshot 771d7e3404fa9a61","timeframe":null},"slice_ids":["slc_2198524aeacd39b1be90fdde9df4d67cefc68c152a7d37c0c546c63db961dc66"],"source_ids":["src_f0c135cdb4e05b528158bf607a79fe53"],"text":"A guarded, rate-limited nudge system sends short control messages to wake stalled agents, e.g. after a known rate-limit cooldown or when a teammate has not synced with its task or review.","updated_at":"2026-09-14T01:28:18Z","updated_by_operation":"op_a0006f1055684bb5a254cffff3079b46"}
{"access":"public","created_at":"2026-09-14T01:28:18Z","created_by_operation":"op_a0006f1055684bb5a254cffff3079b46","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f19010cac70964705307ec512e8aab62db38517b8fab2015ec4a6f3d6cd311f3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"777genius/agent-teams-ai@43764e1df31f snapshot 771d7e3404fa9a61","timeframe":null},"slice_ids":["slc_be017828c63f92b577617251f0416a3f55131f7c232c9b3044435ca8f3e96844"],"source_ids":["src_f0c135cdb4e05b528158bf607a79fe53"],"text":"Some RDP sessions expose virtual GPU drivers that can break Electron rendering; the documented workaround is launching with AGENT_TEAMS_DISABLE_GPU=1 to disable hardware acceleration.","updated_at":"2026-09-14T01:28:18Z","updated_by_operation":"op_a0006f1055684bb5a254cffff3079b46"}
{"access":"public","created_at":"2026-09-14T01:28:18Z","created_by_operation":"op_a0006f1055684bb5a254cffff3079b46","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f7d74c3ac48396dc63e810b191352dbcf0f4efee941bda0021d684da5a9f5c67","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"777genius/agent-teams-ai@43764e1df31f snapshot 771d7e3404fa9a61","timeframe":null},"slice_ids":["slc_c56cb3382613ed18445ebb68a7cac871c729069477f4d8201b371859494bbcbd"],"source_ids":["src_e7321c5e13395add9a09becccabff019"],"text":"Repository development practice: contributor guardrails require pnpm (not npm/yarn), desktop Electron dev via pnpm dev, production files capped at 800 lines enforced by a source-file-size ratchet script, and testing only in sandbox/test projects rather than real user projects.","updated_at":"2026-09-14T01:28:18Z","updated_by_operation":"op_a0006f1055684bb5a254cffff3079b46"}
