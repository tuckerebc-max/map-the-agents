1e7","maturity":"draft","page_type":"entity","path":"pages/entities/martian56-lumnicode-792d178981e7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"martian56/lumnicode","updated_at":"2026-09-14T02:16:20Z","updated_by_operation":"op_a4342a5e30ab4b44b344032e6b744384"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_874515dc6ce26f9afe32b48d759d5fe1d1bd7721732a81456e45bf1dfd0ca6e9"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run Black and Ruff plus pytest for the backend and ESLint plus a typed build for the frontend before committing; Python style is Black at line length 88 with PEP 8 and type hints."},{"claim_ids":["clm_a6d57640042f6747e356c12ef028740b788837cdf5f1503e1ab423292ff4dc6d"],"opposing_claim_ids":[],"text":"Repository development practice: feature branches are cut from develop using feature/, hotfix/, and release/ prefixes, and pull requests against develop should pass checks, get maintainer review, and squash commits when possible."}],"claim_ids":["clm_874515dc6ce26f9afe32b48d759d5fe1d1bd7721732a81456e45bf1dfd0ca6e9","clm_a6d57640042f6747e356c12ef028740b788837cdf5f1503e1ab423292ff4dc6d"],"created_at":"2026-09-14T02:16:20Z","created_by_operation":"op_a4342a5e30ab4b44b344032e6b744384","id":"pg_944c641c877855e58eebec83b2354eef","maturity":"draft","page_type":"source","path":"pages/sources/martian56-lumnicode-contributing-md-b18933aa526d-ec83b2354eef.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_cbb8f007ad5c581ab09ea1d380346014"],"title":"martian56/lumnicode/CONTRIBUTING.md @ b18933aa526d","updated_at":"2026-09-14T02:16:20Z","updated_by_operation":"op_a4342a5e30ab4b44b344032e6b744384"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:16:20Z","created_by_operation":"op_a4342a5e30ab4b44b344032e6b744384","id":"pg_c96583202a6356adaf9e0813bd34f1ec","maturity":"draft","page_type":"source","path":"pages/sources/martian56-lumnicode-claude-md-b18933aa526d-0813bd34f1ec.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_84ea9e0acb9f507e8e69ec32f8e9e98a"],"title":"martian56/lumnicode/CLAUDE.md @ b18933aa526d","updated_at":"2026-09-14T02:16:20Z","updated_by_operation":"op_a4342a5e30ab4b44b344032e6b744384"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2ddf70d3d94108b05b1b5f63507ebc6189aaa31f51ed2cf30c101f63587a8c0e"],"opposing_claim_ids":[],"text":"File content is stored in S3-compatible storage (MinIO in development) rather than the database, with the database holding project and file metadata."},{"claim_ids":["clm_51b109ad3d2a14ac7739e99547240f3e1f8bed3ac2737586fde91bd3a74e640d"],"opposing_claim_ids":[],"text":"Lumnicode is described as an online code editor with built-in AI assistance where users supply their own API keys from supported providers, with no subscriptions or per-seat pricing."},{"claim_ids":["clm_5af34905b21cbe916f3053470488a912f8e6467994ef234623ab3c5a8b83cf96"],"opposing_claim_ids":[],"text":"Repository development practice: local setup starts Postgres and MinIO via docker-compose.dev.yml, then runs the backend with uv (uv sync, alembic upgrade head, uvicorn) and the frontend with npm install and npm run dev."},{"claim_ids":["clm_65ace3a972a28f67ebf1a34640a935a320838b36c5e5d084ae23f6b4c028edef"],"opposing_claim_ids":[],"text":"The README roadmap lists real-time collaboration, Git integration, a terminal emulator, a plugin system, a self-hosted deployment guide, and a mobile responsive editor as unchecked, i.e., planned but not yet delivered."},{"claim_ids":["clm_874515dc6ce26f9afe32b48d759d5fe1d1bd7721732a81456e45bf1dfd0ca6e9"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run Black and Ruff plus pytest for the backend and ESLint plus a typed build for the frontend before committing; Python style is Black at line length 88 with PEP 8 and type hints."},{"claim_ids":["clm_9386153183ad98e986b3886604f13356f352797543f0fef468a569f7f49bb057"],"opposing_claim_ids":[],"text":"AI project generation is orchestrated by a LangGraph state machine with four nodes — plan, config, generate, finalize — streaming progress to the frontend over WebSocket."},{"claim_ids":["clm_9734362a804a2ceeafe797c8eb969ea197fb4afc25a35bb086c62b417d221fdf"],"opposing_claim_ids":[],"text":"The architecture pairs a React SPA (Vite + TypeScript) frontend with a FastAPI Python backend, backed by PostgreSQL for metadata, MinIO/S3 for file content, and LangChain-based AI providers, connected via REST, SSE, and WebSocket."},{"claim_ids":["clm_bfedbfe2367693ecefbb462627e829f3364d2316c7fe190467f219dd285bf14d"],"opposing_claim_ids":[],"text":"Users add their own AI API keys through the app's Settings > API Keys page after signing in with Clerk."},{"claim_ids":["clm_e83aaafb8e7cc6e488ebf6b95193a6979569d9e9eb8f5ae3df62fea7feef59c1"],"opposing_claim_ids":[],"text":"Supported AI providers include OpenAI, Anthropic, Google Gemini, Groq, Together, Fireworks, and Cohere, with several accessed via OpenAI-compatible APIs; the backend uses LangChain/LangGraph and uv for dependency management."},{"claim_ids":["clm_f6a44308eedd03e83ed8ea22e202a97a67a1f1af2adf66fe52e3e10f5f96ff1d"],"opposing_claim_ids":[],"text":"The backend exposes REST endpoints such as POST /assist, POST /assist/stream (SSE), project and file CRUD, POST /ai/generate/{id}, and a WebSocket /ws/ai-progress/{id}; interactive docs are served at /docs and /redoc."}],"claim_ids":["clm_2ddf70d3d94108b05b1b5f63507ebc6189aaa31f51ed2cf30c101f63587a8c0e","clm_51b109ad3d2a14ac7739e99547240f3e1f8bed3ac2737586fde91bd3a74e640d","clm_5af34905b21cbe916f3053470488a912f8e6467994ef234623ab3c5a8b83cf96","clm_65ace3a972a28f67ebf1a34640a935a320838b36c5e5d084ae23f6b4c028edef","clm_874515dc6ce26f9afe32b48d759d5fe1d1bd7721732a81456e45bf1dfd0ca6e9","clm_9386153183ad98e986b3886604f13356f352797543f0fef468a569f7f49bb057","clm_9734362a804a2ceeafe797c8eb969ea197fb4afc25a35bb086c62b417d221fdf","clm_bfedbfe2367693ecefbb462627e829f3364d2316c7fe190467f219dd285bf14d","clm_e83aaafb8e7cc6e488ebf6b95193a6979569d9e9eb8f5ae3df62fea7feef59c1","clm_f6a44308eedd03e83ed8ea22e202a97a67a1f1af2adf66fe52e3e10f5f96ff1d"],"created_at":"2026-09-14T02:16:20Z","created_by_operation":"op_a4342a5e30ab4b44b344032e6b744384","id":"pg_f98c4d1149685888beaacf0ef846ce82","maturity":"draft","page_type":"source","path":"pages/sources/martian56-lumnicode-readme-md-b18933aa526d-cf0ef846ce82.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_bfcbe37df9b851d5b8601f09176ac730"],"title":"martian56/lumnicode/README.md @ b18933aa526d","updated_at":"2026-09-14T02:16:20Z","updated_by_operation":"op_a4342a5e30ab4b44b344032e6b744384"}
