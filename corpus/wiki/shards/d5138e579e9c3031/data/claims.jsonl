{"access":"public","created_at":"2026-09-14T01:26:01Z","created_by_operation":"op_fd27b0ffb87b4c01a613300b94bed132","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8f053df3f7a5eac6dd5834a8722931ea7e32ecc5d7b8553ef2713983eee715c8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"2389-research/dippin-lang@1ef50f81ba75 snapshot 5334cb5b7378dda0","timeframe":null},"slice_ids":["slc_5059aa9ff95194fa8370c59a326fb5261c075a8325921a566b3c49f1665a22be","slc_57bfe931665d57608430a6789b10de8b45f102ea999e54befe565fd28277fc0c","slc_7e7cd119234123bd6795d175eef6dddb62e53775d5613916fc2519220c37abeb","slc_83c606970b2f6095275f8280a0a34b30207e20e938b3519ce17486d06228818e","slc_849c5e74633643898683efbb0677be59890d2847d394f6ab09c31f5176416226"],"source_ids":["src_71bb9ff210a554a0ab1f0226e6a6e026"],"text":"The language uses explicit node keywords (agent, tool, human, parallel, fan_in, subgraph, manager_loop) instead of DOT shape overloading, and indented multiline blocks preserve content verbatim without escaping.","updated_at":"2026-09-14T01:26:01Z","updated_by_operation":"op_fd27b0ffb87b4c01a613300b94bed132"}
