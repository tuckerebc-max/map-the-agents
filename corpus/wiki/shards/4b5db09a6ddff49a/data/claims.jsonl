{"access":"public","created_at":"2026-09-14T01:26:04Z","created_by_operation":"op_bf831e37322444acbb9eba8a72244a10","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_788e0bc7d226446d7dc839688fd1d292784e4d744504d7ee2e7a3159d299718a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"2389-research/fleet-control@efe2657f5465 snapshot e6a4a546b9278950","timeframe":null},"slice_ids":["slc_1a759348d1d2ebda3b57ebc0058fa8feb618aa792e813acb72bec1297685d05d"],"source_ids":["src_4b8c3616b6125cb48740031cc4bde733"],"text":"Stated non-goals: no agent launching, no cost/token tracking, no centralized agent configuration, no remote monitoring (local Unix socket only), and no detection of agents outside tmux.","updated_at":"2026-09-14T01:26:04Z","updated_by_operation":"op_bf831e37322444acbb9eba8a72244a10"}
{"access":"public","created_at":"2026-09-14T01:26:04Z","created_by_operation":"op_bf831e37322444acbb9eba8a72244a10","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_987efabd4222cb78734fb62c1687185171090c087cf0e296942ba33c5769fd18","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"2389-research/fleet-control@efe2657f5465 snapshot e6a4a546b9278950","timeframe":null},"slice_ids":["slc_7b10ed84fa2d166d4ee02e615f9308ec3e282f05bf17bbd84b25742767f6e1b5","slc_ae460112eb682e8d10e5f0e51946bd92f6b86a7b7905b8f6f9bd818bb5a49c49"],"source_ids":["src_4b8c3616b6125cb48740031cc4bde733"],"text":"The daemon exposes HTTP endpoints over the Unix socket: /agents, /agents/:id, /agents/:id/stop, /history, /history/:id/actions, and /ping, all returning JSON.","updated_at":"2026-09-14T01:26:04Z","updated_by_operation":"op_bf831e37322444acbb9eba8a72244a10"}
