{"access":"public","created_at":"2026-09-14T01:26:04Z","created_by_operation":"op_bf831e37322444acbb9eba8a72244a10","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ce2cca6205064568a74c3b9c781ee67bf1b1df2ccb0f1aa43d3ba414a92319f8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"2389-research/fleet-control@efe2657f5465 snapshot e6a4a546b9278950","timeframe":null},"slice_ids":["slc_5099db6bc5ee17d3c2981dfcbd25c5486b1c0f8d3102cb1f52d84f4fe19b7a4f"],"source_ids":["src_4b8c3616b6125cb48740031cc4bde733"],"text":"The daemon polls tmux roughly every 5 seconds, keeps an in-memory agent registry guarded by sync.RWMutex, persists history to SQLite in WAL mode, and serves HTTP/1.1 over a Unix socket.","updated_at":"2026-09-14T01:26:04Z","updated_by_operation":"op_bf831e37322444acbb9eba8a72244a10"}
{"access":"public","created_at":"2026-09-14T01:26:04Z","created_by_operation":"op_bf831e37322444acbb9eba8a72244a10","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_da651159fec9ccd2eecf3aef0bf91424bca37ffbfa805c82bc0bc7935797b9b3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"2389-research/fleet-control@efe2657f5465 snapshot e6a4a546b9278950","timeframe":null},"slice_ids":["slc_33536a7575fbb788bc5151c92b96391fa07a053b2111464e08d42e7e0e3b1d11","slc_efcf14a199939e3de421d839156c722ce4ff6fe3634f024f150d7e88ce80647f"],"source_ids":["src_4b8c3616b6125cb48740031cc4bde733","src_7c9d9d6141c75b87bda40a5e4a3c0b46"],"text":"The tech stack specifies Go, modernc.org/sqlite as the only acceptable SQLite driver (mattn/go-sqlite3 forbidden), bubbletea/lipgloss for the TUI, and net/http over a Unix socket.","updated_at":"2026-09-14T01:26:04Z","updated_by_operation":"op_bf831e37322444acbb9eba8a72244a10"}
