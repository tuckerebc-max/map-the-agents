{"access":"public","created_at":"2026-09-14T02:17:33Z","created_by_operation":"op_ac5600a4c1684f809574df0aeb26430e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6026a1114b459f592abc0b17eb768f9e2271d75799f991f52830f5b0591da263","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"mervinpraison/praisonai@43a106db26d3 snapshot 462851b4fd2f608d","timeframe":null},"slice_ids":["slc_046826400fd017e8b5a8403e15f9e6588b6c2952ea14c6488a7b852abe5d63bf","slc_f815ed5989de3a18376e3313e1377ce6d49e23860ca6df6568ef29be985873de"],"source_ids":["src_9d8940d0cfd752b3be1362afc603db8b"],"text":"Agents support an approval=True option described as a human gate before risky tools run, alongside guardrails and hooks in the harness layer.","updated_at":"2026-09-14T02:17:33Z","updated_by_operation":"op_ac5600a4c1684f809574df0aeb26430e"}
{"access":"public","created_at":"2026-09-14T02:17:33Z","created_by_operation":"op_ac5600a4c1684f809574df0aeb26430e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_77465c804367522c8b66964e7a27fe7d080893a3d6f216df1012e4750e80620a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"mervinpraison/praisonai@43a106db26d3 snapshot 462851b4fd2f608d","timeframe":null},"slice_ids":["slc_33b58270cacbb549e4bca820b29f56cac506bc121f1ca4ecd34e4548cfd2c891","slc_6fe7834b06ac113d66dffb293ce8a34f2ebdadad3716016e34eadf07d4922af5","slc_c966158f76b7320ff55b56d187bf7e245918ed87321eaf50fd1748cfc6d5a350"],"source_ids":["src_9d8940d0cfd752b3be1362afc603db8b"],"text":"AgentFlow composes multi-step graphs with route(), parallel(), and repeat() steps, and the same graph can be expressed in YAML without Python.","updated_at":"2026-09-14T02:17:33Z","updated_by_operation":"op_ac5600a4c1684f809574df0aeb26430e"}
{"access":"public","created_at":"2026-09-14T02:17:33Z","created_by_operation":"op_ac5600a4c1684f809574df0aeb26430e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9b035dfcd9c4e8efe879df445e4c7f55598bcaa6cfb1f8019b0b976603d70b89","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"mervinpraison/praisonai@43a106db26d3 snapshot 462851b4fd2f608d","timeframe":null},"slice_ids":["slc_3eb4b20ee1aaa47e916fc420595be4c38e6a53c6a78ee29429134067e5dd8c7e","slc_6289eb68132c204a9c4c13dfd063f3346773a8480c40b50c5e328a1893c6664a","slc_b56ac56c05fb28f86dd01181640ff9108b70ee4135f4b522b9723c09f5f5a9bd"],"source_ids":["src_9d8940d0cfd752b3be1362afc603db8b"],"text":"Custom tools are defined with an @tool decorator on plain Python functions whose docstrings describe usage to the model.","updated_at":"2026-09-14T02:17:33Z","updated_by_operation":"op_ac5600a4c1684f809574df0aeb26430e"}
