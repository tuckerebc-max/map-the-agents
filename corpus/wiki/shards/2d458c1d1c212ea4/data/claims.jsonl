{"access":"public","created_at":"2026-09-14T01:40:45Z","created_by_operation":"op_f3b6c4aa00c3478f8903d15b2674bf4a","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9fd5f34f9cae13ed17376cc276e16c6e5ce6740e45742d043dab35684f85c918","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"civai-technologies/cursor-agent@0f5bcd94990b snapshot 4e70f5f0f0abf023","timeframe":null},"slice_ids":["slc_0160177dafc8e6ff528d1228bfff4eaab968bb3e8c4bb7b66cdea08334711f9f","slc_290f6c41350af9441ac6ebe303de6bdfbb58d62e0d8b5ab246b350ae91a674d2","slc_5a4a7a96a2cfad88553275eccf573babf5372ea06e600b25ec93b8869f810ddc","slc_b5f1c0271e0ca48e869f3006c8ae167e341df82ceae37ed1c7326a994f933fdb","slc_ba105d8119385b4aa6f192fc0ca757814ede91d74d7d0b1c4a6ba90e730fe336"],"source_ids":["src_c4cbd3a7ed345fe3aa322a898341de5f"],"text":"Interactive mode (run_agent_interactive) auto-continues by default with a max_iterations cap, pauses when the model asks for input, and requests user confirmation after a threshold of tool calls (default 5), raising the limit by 5 on approval.","updated_at":"2026-09-14T01:40:45Z","updated_by_operation":"op_f3b6c4aa00c3478f8903d15b2674bf4a"}
