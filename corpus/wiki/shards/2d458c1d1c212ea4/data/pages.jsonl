{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_81931ce69bb84aba01a0a0fe0b71ae4764b751e783930485304caffc8919b708"],"opposing_claim_ids":[],"text":"Documented constraints include provider context-window limits (e.g., up to 200K tokens for Claude 3 Opus, 16K-128K for OpenAI models), API rate limits, token-based costs, and tool execution running code on the user's system."}],"claim_ids":["clm_81931ce69bb84aba01a0a0fe0b71ae4764b751e783930485304caffc8919b708"],"created_at":"2026-09-14T01:40:45Z","created_by_operation":"op_f3b6c4aa00c3478f8903d15b2674bf4a","id":"pg_1ea339a228935610baf58883eb6f545c","maturity":"draft","page_type":"source","path":"pages/sources/civai-technologies-cursor-agent-constraints-md-0f5bcd94990b-8883eb6f545c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2a5eb92f43ce5743b5b83edfa7598007"],"title":"civai-technologies/cursor-agent/constraints.md @ 0f5bcd94990b","updated_at":"2026-09-14T01:40:45Z","updated_by_operation":"op_f3b6c4aa00c3478f8903d15b2674bf4a"}
