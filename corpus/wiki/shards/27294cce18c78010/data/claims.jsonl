{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0928075ce4a76a9f991ba185fc89e97711028ea3bf3ac3f413500bb09277cbaf","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_2715ea63b82634f57a8045105957b9471ce64d55a3d79d9aee80816d0a43e7b3","slc_8d0008311dc79c9c2d68853742d4c0b9c91a850142bf8335f3803f4da6f5b31c"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"After a meeting, the app generates three parallel extractions (narrative overview, participant-attributed key points, action items), exports markdown, and can send data to workflow webhooks like n8n and Zapier.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_133e45acc52c91edd4a294d6076351f201b3ec89b047cfccda84bd6c9a41cd99","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_53683888ecae0c5a4407bf6255a1f0e96e645cc0a05a294cfed4859b2337b9e4","slc_85d686b7685aa5deb814a7c2079a801044d962f14600320c7863e18e7ccb8dd9","slc_c75ba8d9a2da286828f93e0e0e62b5e45a791c5a7cd1408a752ef96ad865b43d"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"MCP servers are configured in Settings with a choice of stdio (local) or http (remote) transport, and tool results appear inline in an MCP Results panel during meetings.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1eb204a3db70618284403cbbb0b2d64a2fa37a325d4aa4673923c6d40effda84","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_1d3d9267efae6d05beea91f74582cc11f94ff45c4bfcbc1bcec04eb848ed5573"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"The local tRPC server binds to 127.0.0.1 only, accepts CORS from loopback origins, and every procedure except registration requires a valid access token; renderer windows run with contextIsolation and no Node integration.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1f182be3d50e3e31a8418b20090ea9c4eb222d31dfbb3bc71cc9d76262ea3655","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_135164f5d19586437886a3ad6afe3694b0870d7d2750f0775a4ea4fa86232fbd","slc_857b33e07ba764f9b48190eb59b5d4a4048cb75fee1bb5c58c2345ab0f8729a4"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"The renderer accesses MCP functionality via preload-exposed IPC APIs: window.electronAPI.mcp for server/tool operations and window.electronAPI.mcpOn for event subscriptions.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2bff59c89b7480bfe29daae53f4c81361b1d51d878b5550f52b53b0fff2f2598","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_245685d905bdc8b1506f42fd2b6e8402829c59c465f81c343fce740ee27d92a4","slc_3f05b11629b25ef0cb4e674170903f8f8bcdc62576cfaf1972853a682b737fef","slc_ba6dfeb10ef737c067e8c47b753b5639daf206cbf6455f56655ec865fa5e5ea1"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"The project targets users who want meeting capture with live AI assistance and post-meeting automation handoff, made by the VideoDB team with documentation at docs.videodb.io and community support via Discord and GitHub Issues.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2e6f06e119543be536be7eab86eccb999cad9ec20bb2e0df2ece44bb969ceccb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_2c4c7c809c9522c8073bf47c256e19f1b36c951ad1295ae5baf63748c6eb14ce","slc_46aabd148ac7890ef804b5c145a38007d1790d92c52a7e43567a84ea085b4b3d","slc_7b84fbd1a003a76235b0eabd30975c45c4701bcd79cae99be4ce7ebcfe3b1d75","slc_a1b343fe94adc613fb1d2732d96a6d1683d39737d726a53bd78aa89d83ed3c84","slc_b9bedccc8f17e033b9d1237081dee95aeb3fe2f93d64a6dac30b7b992e21d7b7"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"Repository development practice: developers clone the repo, run npm install, rebuild native modules with npm run rebuild, and start dev mode with npm run dev; scripts exist for typecheck, unit tests, lint, database migrations, and platform-specific distributable builds.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_326bdf7ceb967e7077d71210d4165f3616fe05694fa79c1d42c195ca026daa7d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_2549178d6c7f91e7102b1eba09bd07c596798e6133b10a529240fb7cf898ca52","slc_406b54679ce45aa9c07af666456bbbcf27bd335a0102c1d1483fb2accfa4e810","slc_b36c36165ac6b38545c4ded4e9dc63d664be26fbe6e52b9cc2d039724ac6de37","slc_e5df513d57f86097dd213e87e2f052e1fa7508db6cf5e5b9a43e851afea87a7e"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"A VideoDB API key is required for registration, and transcription and AI features require internet connectivity; Google Calendar integration is optional.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_374355244bf3d49d1badc1ef491f747ecd279f8ba12cc1a049bf8d47604aec0d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_8b7b5784cfc8ed6fb0928e5aeb03a25432565b14f1c77b1b849a6e25e739389c"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"The main process contains a copilot service layer with context-manager, conversation-metrics, nudge-engine, sales-copilot orchestrator, summary-generator, and transcript-buffer services, plus an MCP orchestration set including intent-detector and tool-aggregator services.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_411c649ecc86d1080b39a80f066d5a95e67c2986f26f009d5cb253339d06ac0b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_b3abee5ba32a3d6066a5a9585addd5116a7c9bb64ed25926886ae43732349e75"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"The stack includes Electron 42, TypeScript 5.8, React 19, Tailwind with shadcn/ui, tRPC 11 over a Hono HTTP server, Drizzle ORM with SQLite, Zustand, VideoDB SDK 0.3.0, MCP SDK 1.0.0, OpenAI SDK 6.19.0, and Vite.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4739103950f61a872224960c203a8d7b4e8a41ea632396f4b75807a9857a0f97","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_c32d3f5d7225dc04884b0bd0ce0719b0729922e46c9648ddb8532b9853a738e5"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"Repository development practice: cross-packaging a Windows x64 build from macOS is possible for structural verification using published prebuilds, but the README notes this does not replace native Windows testing or installer signing.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4f15d69feb7bd154426550f34cdb5d2d6a71911269e33ef5f52b45d3283c2842","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_2dc351716bfc5d0cb8f84bfd4666ef672a4faf9b60b4a2c295318790b0970b9e","slc_b36c36165ac6b38545c4ded4e9dc63d664be26fbe6e52b9cc2d039724ac6de37","slc_fe5cbbdcf06dda1cef1a637f2790c1a00545c87f5f3aa22130582e0505f0aa8f"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"The app requires microphone and screen-recording permissions before the first recording; onboarding can skip permission setup, but recording stays unavailable until they are granted.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_65bc015366746f57daf2b4e3a1786cfe1d91ca111c7e8d98ef7869c4877f5ee3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_1d3d9267efae6d05beea91f74582cc11f94ff45c4bfcbc1bcec04eb848ed5573"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"Credentials are protected with layered encryption: the SQLite user row is the sole authority for the VideoDB API key, Google tokens use Electron safeStorage, and MCP secrets use AES-256-GCM under a keychain-wrapped key, failing closed when strong OS-backed storage is unavailable.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_785c34b80d1676cd5ff06bc0fefa006b2215f0b335886417a9f1cfd06834614c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_1e696eeaa59fc4dc64713346be217a2c6e3c35cfc247656cf34244333af43a77","slc_5eabe4fcab5f4088e5e9b0f76c3855d7a7b9f774674774084ead334f4abace4f","slc_cf55be08e388e006b999d3a638ef96e6d672373087199eff982c7186ebb4d96f"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"Recording is supported on macOS 12+ (Apple Silicon and Intel) and Windows x64; Linux and Windows ARM64 builds run the UI, MCP servers, workflows, history, and exports but reject recording because no capture binary exists, and no hosted Windows installer is published.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a214ade13e6cfd90e5b53473874667306efa3449cc319b0317c565f807d988ff","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_13da1476a26cb527fa19b1fb44b58787ff3c0dd82d0fde8e28160068b46c4340"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"During meetings the app offers dual-channel transcription, live AI assist suggestions, conversation metrics (talk ratio, WPM, monologue detection), coaching nudges, MCP auto-triggering, and bookmarking.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a790eeccad003cb24beb0da2af8c830415b59e7b669b81da539337e6d8884755","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_2549178d6c7f91e7102b1eba09bd07c596798e6133b10a529240fb7cf898ca52","slc_5fd897141b087e7e2b9e61dba701a652d40ca4582c03d669fe054438370a8026"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"Recordings are capped at 2 hours of active recording time, stop automatically with a warning 5 minutes prior, and paused or system-sleep time does not count toward the limit.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_aa2a9591e82f3d0a44b7d413e82c95ebdad2ab9388b329ddb885808425f8f393","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_2fa79b8be4577b59c1d929d2b075b5c4f3c431544a4564d4419c047d0829c67b"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"Pre-meeting features include an AI-generated setup wizard with probing questions, a dynamic discussion checklist, and optional Google Calendar sync.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
