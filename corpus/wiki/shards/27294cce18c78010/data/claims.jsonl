{"access":"public","created_at":"2026-09-14T04:30:03Z","created_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c905c242f1b3c92d274e8df8b75fd71aa3601a9ce9f38286ee355c1ab74c8314","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"video-db/call.md@ba53ebed3643 snapshot b93e3320b0cfc245","timeframe":null},"slice_ids":["slc_4bea3374f89777f4bb3498a86165d74ac8f38126cb5f106d643bb25abab59e59"],"source_ids":["src_7f3f8b526c3d5d9d899d03091f5c6e54"],"text":"Call.md records meetings locally, transcribes in real time distinguishing the user from other participants, provides live in-call intelligence, and generates post-meeting summaries with action items.","updated_at":"2026-09-14T04:30:03Z","updated_by_operation":"op_1c5d9e5710ba406dbf621c6e2147758e"}
