{"access":"public","created_at":"2026-09-14T02:39:09Z","created_by_operation":"op_efaf1da25f18446d9826b68b5a651d7b","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c03401602f3efe4b5aa47169866f5035af5ceaddf90de6b21d7e78c692774bdb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"seahyinghang8/blinky@f7a61326e723 snapshot d1be42b9542d8f68","timeframe":null},"slice_ids":["slc_131648bce3d887e0ba89c8f05c349dfbf102307d4637fda2f1d930bbdb0ec5c1","slc_68afdf6fe4194c8f74fefb27bd937579631407bfea40cd27dd22afad52ae3e4f"],"source_ids":["src_c92c64d0ce785893ba7cdce2b3873d27"],"text":"Blinky is an open-source AI debugging agent for VSCode that uses LLMs to identify and fix backend code errors, inspired by SWE-agent.","updated_at":"2026-09-14T02:39:09Z","updated_by_operation":"op_efaf1da25f18446d9826b68b5a651d7b"}
