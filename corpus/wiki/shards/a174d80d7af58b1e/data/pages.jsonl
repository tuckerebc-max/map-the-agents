{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_38f589340cab9f702f267afa51b4abc3e707adcfb205437a7506c0a4ff3efb48"],"opposing_claim_ids":[],"text":"Runtime events are designed to be append-only from a reader's perspective, with new event types added in the protocol package first and older sessions expected to load when optional fields are missing."},{"claim_ids":["clm_b8b92e706647bc2da089c036db9800cd51594a2cea2e1193fd673d4bb526f71b"],"opposing_claim_ids":[],"text":"The workspace includes packages for protocol event schemas, tool specs with approval policy, agent engine with model adapters, JSONL session/artifact state storage, and a scenario-replay harness."},{"claim_ids":["clm_c14e7f109651ea3e49cff611ddc04cb7cde8f774ee49df32be11ebec6d009c7c"],"opposing_claim_ids":[],"text":"Repository development practice: contributors use Node 22 (pinned in .node-version), pnpm 11.x, Rust stable, and Tauri 2 prerequisites; local checks run via pnpm ci:local plus per-package test/typecheck/lint filters."}],"claim_ids":["clm_38f589340cab9f702f267afa51b4abc3e707adcfb205437a7506c0a4ff3efb48","clm_b8b92e706647bc2da089c036db9800cd51594a2cea2e1193fd673d4bb526f71b","clm_c14e7f109651ea3e49cff611ddc04cb7cde8f774ee49df32be11ebec6d009c7c"],"created_at":"2026-09-14T01:58:37Z","created_by_operation":"op_d05a55d94a634c2989ddcf8b9c159066","id":"pg_a89bb244a81756d2a0fe3938311c3a96","maturity":"draft","page_type":"source","path":"pages/sources/233i-ore-code-docs-api-and-compatibility-md-b36da0c05720-3938311c3a96.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4ba6cf74f1dd501f98e64915aec34081"],"title":"233i/ore-code/docs/API_AND_COMPATIBILITY.md @ b36da0c05720","updated_at":"2026-09-14T01:58:37Z","updated_by_operation":"op_d05a55d94a634c2989ddcf8b9c159066"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_f83c4e30d05255870a6a39cce0a2acf884639bc2c1452bba197111ef51b3d964"],"opposing_claim_ids":[],"text":"The runtime can execute local tools such as Git, shell/process commands, tests, diagnostics, code execution, and MCP servers when the user permits them, with an approval system meant to surface higher-risk actions."}],"claim_ids":["clm_f83c4e30d05255870a6a39cce0a2acf884639bc2c1452bba197111ef51b3d964"],"created_at":"2026-09-14T01:58:37Z","created_by_operation":"op_d05a55d94a634c2989ddcf8b9c159066","id":"pg_b391045fbd2b5bf0be031a1cfc2567a0","maturity":"draft","page_type":"source","path":"pages/sources/233i-ore-code-privacy-md-b36da0c05720-1a1cfc2567a0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ad4b5af24a3a5dbf96c116095d1cb1c3"],"title":"233i/ore-code/PRIVACY.md @ b36da0c05720","updated_at":"2026-09-14T01:58:37Z","updated_by_operation":"op_d05a55d94a634c2989ddcf8b9c159066"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9f339a154cef17c117c94f754284d95930942068fa1df8146c525fa2b1710aa4"],"opposing_claim_ids":[],"text":"Skills are user-level reusable workflow instructions stored at ~/.ore-code/skills/<skill-id>/SKILL.md; each skill auto-registers a slash command and its content is injected into the current prompt."},{"claim_ids":["clm_b0b688b5223542f70b6e1affc3ef31aa9e227600fad64d59f97e4e36264da7cd"],"opposing_claim_ids":[],"text":"Skills are documentation-like instructions, not plugin code, and do not execute arbitrary scripts; actual file, shell, and git actions still go through existing tools and the approval system."}],"claim_ids":["clm_9f339a154cef17c117c94f754284d95930942068fa1df8146c525fa2b1710aa4","clm_b0b688b5223542f70b6e1affc3ef31aa9e227600fad64d59f97e4e36264da7cd"],"created_at":"2026-09-14T01:58:37Z","created_by_operation":"op_d05a55d94a634c2989ddcf8b9c159066","id":"pg_c64000b598f252038c5aa34fb15fc67b","maturity":"draft","page_type":"source","path":"pages/sources/233i-ore-code-docs-06-skill-system-md-b36da0c05720-a34fb15fc67b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_52452562738d5a239d41482ce11d2402"],"title":"233i/ore-code/docs/06-skill-system.md @ b36da0c05720","updated_at":"2026-09-14T01:58:37Z","updated_by_operation":"op_d05a55d94a634c2989ddcf8b9c159066"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3a4502f9d5bb5014aa1a41046bcf33e64185419b3ca075cdbfad23d58d5e87f4"],"opposing_claim_ids":[],"text":"Configuration supports DeepSeek, Mimo, Ark Coding, or custom endpoints via ~/.ore-code/config.toml, with API keys kept in the OS keychain and user-level MCP servers in ~/.ore-code/mcp.json."},{"claim_ids":["clm_5cde1f24e4b81236bf9bb3d9e5e815fd601cbcb5e325cc05dcd459832bc8c489"],"opposing_claim_ids":[],"text":"The current release does not read project-level .ore-code/config.toml files; only user-level configuration is supported."},{"claim_ids":["clm_5e9a4abb38fbb022c3f0df4f8ac59f39754a0c63292f71b953c29492e9db0671"],"opposing_claim_ids":[],"text":"The product combines a TypeScript agent runtime, a React/Tauri desktop app, and a Rust OS boundary handling local file, shell, process, Git, keychain, artifact, and MCP operations."},{"claim_ids":["clm_b8ae567a59542113674b21e6503fa4e46a708c65bb185c3d19d64cdb2a1d4fbc"],"opposing_claim_ids":[],"text":"The shipped release provides a macOS Apple Silicon installer; the Windows x64 build is listed as pending and must be built separately in a Windows environment."},{"claim_ids":["clm_b8b92e706647bc2da089c036db9800cd51594a2cea2e1193fd673d4bb526f71b"],"opposing_claim_ids":[],"text":"The workspace includes packages for protocol event schemas, tool specs with approval policy, agent engine with model adapters, JSONL session/artifact state storage, and a scenario-replay harness."},{"claim_ids":["clm_c14e7f109651ea3e49cff611ddc04cb7cde8f774ee49df32be11ebec6d009c7c"],"opposing_claim_ids":[],"text":"Repository development practice: contributors use Node 22 (pinned in .node-version), pnpm 11.x, Rust stable, and Tauri 2 prerequisites; local checks run via pnpm ci:local plus per-package test/typecheck/lint filters."},{"claim_ids":["clm_c7582ede32b4a53f771a0d589cdfafe6f08f504879d23c78bba42508b7bc2710"],"opposing_claim_ids":[],"text":"The macOS build is ad-hoc signed and not notarized because the project does not yet use an Apple Developer ID certificate, so macOS may block the app on first launch."},{"claim_ids":["clm_faca359b6c675c559e5b0a3f9006150f49ad43feb988e541c7580caf4f9c42c3"],"opposing_claim_ids":[],"text":"The agent offers context-control features including history compression, context briefing, checkpoint summaries, usage visibility, and provider-aware request shaping for long conversations."}],"claim_ids":["clm_3a4502f9d5bb5014aa1a41046bcf33e64185419b3ca075cdbfad23d58d5e87f4","clm_5cde1f24e4b81236bf9bb3d9e5e815fd601cbcb5e325cc05dcd459832bc8c489","clm_5e9a4abb38fbb022c3f0df4f8ac59f39754a0c63292f71b953c29492e9db0671","clm_b8ae567a59542113674b21e6503fa4e46a708c65bb185c3d19d64cdb2a1d4fbc","clm_b8b92e706647bc2da089c036db9800cd51594a2cea2e1193fd673d4bb526f71b","clm_c14e7f109651ea3e49cff611ddc04cb7cde8f774ee49df32be11ebec6d009c7c","clm_c7582ede32b4a53f771a0d589cdfafe6f08f504879d23c78bba42508b7bc2710","clm_faca359b6c675c559e5b0a3f9006150f49ad43feb988e541c7580caf4f9c42c3"],"created_at":"2026-09-14T01:58:37Z","created_by_operation":"op_d05a55d94a634c2989ddcf8b9c159066","id":"pg_f39055f421635bd6a29f3d2ff541e283","maturity":"draft","page_type":"source","path":"pages/sources/233i-ore-code-readme-md-b36da0c05720-3d2ff541e283.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d14d305b5eb35f26b7be40edd32c652d"],"title":"233i/ore-code/README.md @ b36da0c05720","updated_at":"2026-09-14T01:58:37Z","updated_by_operation":"op_d05a55d94a634c2989ddcf8b9c159066"}
