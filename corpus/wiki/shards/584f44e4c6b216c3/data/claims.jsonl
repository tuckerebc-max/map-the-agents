{"access":"public","created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_10738a84ae8a5c40333dae4b7d234da071e60f149fb3450f0c371add05df5c03","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"omnara-ai/omnara@1d62b055ebb4 snapshot c77612c90a9bb620","timeframe":null},"slice_ids":["slc_74a29ad3551dadbd1fb3edf5a7d625981950275a4b2d8fca4f1e8665bc56150d"],"source_ids":["src_55e20fb939e354f3980a147d38eab167"],"text":"Users bring their own API keys and models via compatible endpoints (OpenRouter, LiteLLM, Ollama), with OpenAI Responses, Chat Completions, and Anthropic Messages formats supported.","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
{"access":"public","created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2574fcc0d7192f0e518aa333e120723f9c1a8689d6402651d23061a52fabb610","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"omnara-ai/omnara@1d62b055ebb4 snapshot c77612c90a9bb620","timeframe":null},"slice_ids":["slc_74a29ad3551dadbd1fb3edf5a7d625981950275a4b2d8fca4f1e8665bc56150d"],"source_ids":["src_55e20fb939e354f3980a147d38eab167"],"text":"The platform includes role-based access control with organization and project roles for users and API keys, separating management, configuration, operation, and viewing.","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
{"access":"public","created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2bcce282001139f87d0a575e4774cc413c81d91cdaecc4310a7eb97d5162b2ca","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"omnara-ai/omnara@1d62b055ebb4 snapshot c77612c90a9bb620","timeframe":null},"slice_ids":["slc_b8d93b621ebe851a17b9b488d43f70337ead117c4aa26aeb271480e2632792de"],"source_ids":["src_55e20fb939e354f3980a147d38eab167"],"text":"Local development defaults are intentionally insecure and the README warns against using them in deployed environments, pointing to the self-hosting guide for production setup.","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
{"access":"public","created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4be89e5603cecca9a2c4879c99754cf8ed4e7e9e24820518a2ae7c6cf5181168","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"omnara-ai/omnara@1d62b055ebb4 snapshot c77612c90a9bb620","timeframe":null},"slice_ids":["slc_74a29ad3551dadbd1fb3edf5a7d625981950275a4b2d8fca4f1e8665bc56150d"],"source_ids":["src_55e20fb939e354f3980a147d38eab167"],"text":"Agent state is committed atomically to Postgres, and agents recover automatically from crashes, restarts, and machine disconnects.","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
{"access":"public","created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_53489c4dc7e5318f25427c5258596f1dae9d64effd323d4f3e81bf4db0bc71f1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"omnara-ai/omnara@1d62b055ebb4 snapshot c77612c90a9bb620","timeframe":null},"slice_ids":["slc_68a08ac1c9d29ef32cc26d424fe1c5dd5f7910f6eb0fc5b8eacbca9253a037ef","slc_d3483e9d7bffd7ecf9aad8cc5fb0ac12f971f4139f896b5eb7361fb569c7a0b9","slc_d897755b366477a515ac9a674cfa8cd2166346c29e76c62450b1050377d95bc0"],"source_ids":["src_55e20fb939e354f3980a147d38eab167"],"text":"Self-hosting requires Docker with Compose; published images can be run or the stack built from source via docker compose with the app profile.","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
{"access":"public","created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5a72d87d8b89691b749df72ffeb0b5aa3602ad41667d4b164f00e6bf50d47e59","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"omnara-ai/omnara@1d62b055ebb4 snapshot c77612c90a9bb620","timeframe":null},"slice_ids":["slc_44a13e74d26b8a5d99466aaa8bf6656cf7fef557032afcf25a1f37009161f307"],"source_ids":["src_55e20fb939e354f3980a147d38eab167"],"text":"Omnara targets developers building agents for internal or customer-facing products and teams interacting with agents through the dashboard or a first-party Slack connector.","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
{"access":"public","created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6a619053d3c8c33b4adc284171e8b6f5c6f605d5a0e7cc31264cc1d85a56445a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"omnara-ai/omnara@1d62b055ebb4 snapshot c77612c90a9bb620","timeframe":null},"slice_ids":["slc_5614d5772acb3deec1531e1908764fb0ffdb29d8c8ed4c04e95dc60a20abade4","slc_64ebe222839f9d39adc18b54b064c118e13f57f4959f7d7e590ee6d010138394","slc_74a29ad3551dadbd1fb3edf5a7d625981950275a4b2d8fca4f1e8665bc56150d"],"source_ids":["src_55e20fb939e354f3980a147d38eab167"],"text":"The product is usable programmatically via a CLI, a TypeScript CLI, and a REST API; profiles are created and agents launched with npx omnara commands.","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
{"access":"public","created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7d546220dc7b7da41cf5bd1779f0cc7c4af72f63c315906bd695e7f53db69d9f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"omnara-ai/omnara@1d62b055ebb4 snapshot c77612c90a9bb620","timeframe":null},"slice_ids":["slc_74a29ad3551dadbd1fb3edf5a7d625981950275a4b2d8fca4f1e8665bc56150d"],"source_ids":["src_55e20fb939e354f3980a147d38eab167"],"text":"Agents can run on sandboxes from Blaxel, Daytona, Modal, or Unikraft, on user machines, or a mix, and machines can be added or removed while an agent runs.","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
