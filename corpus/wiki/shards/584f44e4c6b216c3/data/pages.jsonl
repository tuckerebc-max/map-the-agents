{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","id":"pg_3e12e215b4e55cc6b0f0c41673d4033d","maturity":"draft","page_type":"source","path":"pages/sources/omnara-ai-omnara-changelog-md-1d62b055ebb4-c41673d4033d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c484534e7fd05735a84c075ecfdef48e"],"title":"omnara-ai/omnara/CHANGELOG.md @ 1d62b055ebb4","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_10738a84ae8a5c40333dae4b7d234da071e60f149fb3450f0c371add05df5c03"],"opposing_claim_ids":[],"text":"Users bring their own API keys and models via compatible endpoints (OpenRouter, LiteLLM, Ollama), with OpenAI Responses, Chat Completions, and Anthropic Messages formats supported."},{"claim_ids":["clm_2574fcc0d7192f0e518aa333e120723f9c1a8689d6402651d23061a52fabb610"],"opposing_claim_ids":[],"text":"The platform includes role-based access control with organization and project roles for users and API keys, separating management, configuration, operation, and viewing."},{"claim_ids":["clm_2bcce282001139f87d0a575e4774cc413c81d91cdaecc4310a7eb97d5162b2ca"],"opposing_claim_ids":[],"text":"Local development defaults are intentionally insecure and the README warns against using them in deployed environments, pointing to the self-hosting guide for production setup."},{"claim_ids":["clm_4be89e5603cecca9a2c4879c99754cf8ed4e7e9e24820518a2ae7c6cf5181168"],"opposing_claim_ids":[],"text":"Agent state is committed atomically to Postgres, and agents recover automatically from crashes, restarts, and machine disconnects."},{"claim_ids":["clm_53489c4dc7e5318f25427c5258596f1dae9d64effd323d4f3e81bf4db0bc71f1"],"opposing_claim_ids":[],"text":"Self-hosting requires Docker with Compose; published images can be run or the stack built from source via docker compose with the app profile."},{"claim_ids":["clm_5a72d87d8b89691b749df72ffeb0b5aa3602ad41667d4b164f00e6bf50d47e59"],"opposing_claim_ids":[],"text":"Omnara targets developers building agents for internal or customer-facing products and teams interacting with agents through the dashboard or a first-party Slack connector."},{"claim_ids":["clm_6a619053d3c8c33b4adc284171e8b6f5c6f605d5a0e7cc31264cc1d85a56445a"],"opposing_claim_ids":[],"text":"The product is usable programmatically via a CLI, a TypeScript CLI, and a REST API; profiles are created and agents launched with npx omnara commands."},{"claim_ids":["clm_7d546220dc7b7da41cf5bd1779f0cc7c4af72f63c315906bd695e7f53db69d9f"],"opposing_claim_ids":[],"text":"Agents can run on sandboxes from Blaxel, Daytona, Modal, or Unikraft, on user machines, or a mix, and machines can be added or removed while an agent runs."},{"claim_ids":["clm_9200b6d65b1efc5773ad8c317b4870892c38bedd8cb33647f6315960b3616376"],"opposing_claim_ids":[],"text":"Repository development practice: source development needs the Go version in go.mod, Node.js 24+ with Corepack, and Docker Compose; verification runs via make verify, with integration, service e2e, and credential-gated live test targets."},{"claim_ids":["clm_d09ed34ba44adb907c7d58ba2c0a449fe82e5c13fc10a377b34794a33ee20c27"],"opposing_claim_ids":[],"text":"The REST API is defined in api/openapi/openapi.yaml and served under /api/v1."},{"claim_ids":["clm_dae648e1fc1c91a4ae29edac5cb7afd913e049f52fa30b233d767cdc10b40202"],"opposing_claim_ids":[],"text":"Agents are defined in an agent.yaml profile containing an instruction and a model section with provider_config and model name."}],"claim_ids":["clm_10738a84ae8a5c40333dae4b7d234da071e60f149fb3450f0c371add05df5c03","clm_2574fcc0d7192f0e518aa333e120723f9c1a8689d6402651d23061a52fabb610","clm_2bcce282001139f87d0a575e4774cc413c81d91cdaecc4310a7eb97d5162b2ca","clm_4be89e5603cecca9a2c4879c99754cf8ed4e7e9e24820518a2ae7c6cf5181168","clm_53489c4dc7e5318f25427c5258596f1dae9d64effd323d4f3e81bf4db0bc71f1","clm_5a72d87d8b89691b749df72ffeb0b5aa3602ad41667d4b164f00e6bf50d47e59","clm_6a619053d3c8c33b4adc284171e8b6f5c6f605d5a0e7cc31264cc1d85a56445a","clm_7d546220dc7b7da41cf5bd1779f0cc7c4af72f63c315906bd695e7f53db69d9f","clm_9200b6d65b1efc5773ad8c317b4870892c38bedd8cb33647f6315960b3616376","clm_d09ed34ba44adb907c7d58ba2c0a449fe82e5c13fc10a377b34794a33ee20c27","clm_dae648e1fc1c91a4ae29edac5cb7afd913e049f52fa30b233d767cdc10b40202"],"created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","id":"pg_422de6ef1e715f80a6c8cc4da48679aa","maturity":"draft","page_type":"source","path":"pages/sources/omnara-ai-omnara-readme-md-1d62b055ebb4-cc4da48679aa.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_55e20fb939e354f3980a147d38eab167"],"title":"omnara-ai/omnara/README.md @ 1d62b055ebb4","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_be4e618150896860bf140534fa3b6ea49cc46a89c6cad853577e839a34bb1ebd"],"opposing_claim_ids":[],"text":"Repository development practice: pull requests should be preceded by an issue for substantial changes, stay focused, use conventional titles, and run README checks; generated files must be regenerated via make targets after OpenAPI or SQL changes and committed with the source change."}],"claim_ids":["clm_be4e618150896860bf140534fa3b6ea49cc46a89c6cad853577e839a34bb1ebd"],"created_at":"2026-09-14T02:24:35Z","created_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d","id":"pg_c120c5acc46352e69d76f0b9f98a7abb","maturity":"draft","page_type":"source","path":"pages/sources/omnara-ai-omnara-contributing-md-1d62b055ebb4-f0b9f98a7abb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b779a3f3a8165e39a26fad5195e1c4f3"],"title":"omnara-ai/omnara/CONTRIBUTING.md @ 1d62b055ebb4","updated_at":"2026-09-14T02:24:35Z","updated_by_operation":"op_68fd1a2ae1214f5d872188957b43ca5d"}
