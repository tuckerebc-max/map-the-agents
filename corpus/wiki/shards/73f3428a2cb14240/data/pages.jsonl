0f29c7c5440b2ef0af","clm_a6811946eda9ac369ac397b5883cacc6cfaaa6cf2c204704cda8ef51fd81ae30","clm_ad41e2d9e7e91d51623c3539bec180871338261fee67b92bd0280621cb5c1f93","clm_cd49d6f3f5ff4ea1ea8c43a96af2cc9d4596ccc1b141ad622b664bccef1825fd","clm_e11b39d8b2fbcd856ced9908a2d0d741b702180dd5852ed46954256e297b99e0"],"created_at":"2026-09-14T03:30:42Z","created_by_operation":"op_8c5a13328d254ea4884ad31c522b4a9a","id":"pg_21fabfbafa2255739e8b263610e542e5","maturity":"draft","page_type":"entity","path":"pages/entities/agent-of-empires-agent-of-empires-263610e542e5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"agent-of-empires/agent-of-empires","updated_at":"2026-09-14T03:30:42Z","updated_by_operation":"op_8c5a13328d254ea4884ad31c522b4a9a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_05a07e1178e8c5e7d9ded916316bfc503229a19baf78017ffda9dd363ecdfea1"],"opposing_claim_ids":[],"text":"Repository development practice: the README's Development section lists cargo build, cargo test, cargo fmt, cargo clippy, and cargo build --features web, with docs/development.md as the full reference."},{"claim_ids":["clm_3c30ecddfee0b9a69b8e49f97128fd9594ff50b02f46c6d6d1942bdcc9975751"],"opposing_claim_ids":[],"text":"The product exposes TUI, web, CLI, and HTTP API surfaces, with status detection, notifications, persistent tmux sessions, git worktrees, multi-repo workspaces, and Docker/Podman/Apple Containers sandboxing."},{"claim_ids":["clm_53e4b08c3ca90b122284cbbf1ff159126de02cb17b279e4880d5a17d22b48c19"],"opposing_claim_ids":[],"text":"AoE is described as a session manager for AI coding agents on Linux and macOS, running agents in parallel across branches with persistent sessions and optional worktree or container isolation."},{"claim_ids":["clm_699d4bde830e954b2e3c8af759257034d25781422d9e591e222b18c6a0dc934f"],"opposing_claim_ids":[],"text":"tmux is a required prerequisite and Docker is optional for sandboxing; the project is built with cargo, and native Windows is unsupported because AoE depends on tmux and POSIX process handling (WSL2 only)."},{"claim_ids":["clm_808c47044ffa994cf6887b5978fb0bc576968d4b56b9190a6fd00e1889727a7a"],"opposing_claim_ids":[],"text":"Each agent runs in its own tmux session, so sessions persist when the TUI closes, SSH disconnects, or the terminal crashes; sessions are only removed when explicitly deleted."},{"claim_ids":["clm_8b08a05cf45d14ccc99b06a37c22da5d09aa63970b0f2b0f29c7c5440b2ef0af"],"opposing_claim_ids":[],"text":"The project is MIT licensed, with one file (src/tui/hyperlink.rs) containing code derived from the herdr project under Apache License 2.0."}],"claim_ids":["clm_05a07e1178e8c5e7d9ded916316bfc503229a19baf78017ffda9dd363ecdfea1","clm_3c30ecddfee0b9a69b8e49f97128fd9594ff50b02f46c6d6d1942bdcc9975751","clm_53e4b08c3ca90b122284cbbf1ff159126de02cb17b279e4880d5a17d22b48c19","clm_699d4bde830e954b2e3c8af759257034d25781422d9e591e222b18c6a0dc934f","clm_808c47044ffa994cf6887b5978fb0bc576968d4b56b9190a6fd00e1889727a7a","clm_8b08a05cf45d14ccc99b06a37c22da5d09aa63970b0f2b0f29c7c5440b2ef0af"],"created_at":"2026-09-14T03:30:42Z","created_by_operation":"op_8c5a13328d254ea4884ad31c522b4a9a","id":"pg_2a139bb2a01157e5a9596b9eeda2d665","maturity":"draft","page_type":"source","path":"pages/sources/agent-of-empires-agent-of-empires-readme-md-bdf21c256673-6b9eeda2d665.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_32790870da7a505c80a1053a62d8cf2f"],"title":"agent-of-empires/agent-of-empires/README.md @ bdf21c256673","updated_at":"2026-09-14T03:30:42Z","updated_by_operation":"op_8c5a13328d254ea4884ad31c522b4a9a"}
