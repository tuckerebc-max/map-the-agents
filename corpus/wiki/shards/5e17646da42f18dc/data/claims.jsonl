{"access":"public","created_at":"2026-09-14T01:59:12Z","created_by_operation":"op_ce87ec39c6b34517970734b4be6dda69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cd8e59df63c9985e56a68be3ab6edab7b4cb77583fa2d97b90df7199eaa7da93","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"agentforce314/clawcodex@4706a57fc29f snapshot 920fad287979953b","timeframe":null},"slice_ids":["slc_c6bddf162896ab2804789f2a1703afc4dccb82218581cf703f7ed156d5e7b0a9"],"source_ids":["src_9226b8c15a4055bc9ff0c9e30ea8324a"],"text":"The interactive UI is a TypeScript Ink TUI that spawns a Python agent-server child and communicates over an NDJSON pipe; running clawcodex with no mode flags launches it.","updated_at":"2026-09-14T01:59:12Z","updated_by_operation":"op_ce87ec39c6b34517970734b4be6dda69"}
{"access":"public","created_at":"2026-09-14T01:59:12Z","created_by_operation":"op_ce87ec39c6b34517970734b4be6dda69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d3a4e56397ed1074775915d9272892e82c7c6af80c816538cf40010a0dab808c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"agentforce314/clawcodex@4706a57fc29f snapshot 920fad287979953b","timeframe":null},"slice_ids":["slc_17ebf5536ae74eb7a2eed1e8c41d8ddbabedb40305092c13b0f6d654dc4dc08a"],"source_ids":["src_9226b8c15a4055bc9ff0c9e30ea8324a"],"text":"The tool system implements file operations (Read/Write/Edit/Glob/Grep), Bash, WebFetch/WebSearch, task management, agent tools, and configuration tools; MCP tools are wired but the full client/runtime is still evolving.","updated_at":"2026-09-14T01:59:12Z","updated_by_operation":"op_ce87ec39c6b34517970734b4be6dda69"}
{"access":"public","created_at":"2026-09-14T01:59:12Z","created_by_operation":"op_ce87ec39c6b34517970734b4be6dda69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_dad4471422640d70dc5d7332b0f51f110adc65e0dda3e27001cd915b2706cf6c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"agentforce314/clawcodex@4706a57fc29f snapshot 920fad287979953b","timeframe":null},"slice_ids":["slc_057ce934d1a6f47c4d5a6e0bfac4a96501cdf16f9afe2e333f2d1befe7a4e1c2","slc_836fc175d5568ebdcf0fbe3ae3dfae81c7d59a03fa3b3913b1d5a0dbda197b22"],"source_ids":["src_9226b8c15a4055bc9ff0c9e30ea8324a"],"text":"The runtime targets Python 3.10+ and lists roughly 30 LLM providers including native formats (Anthropic, DeepSeek, Gemini, OpenAI), OpenAI-compatible vendors, and local servers (Ollama, vLLM, SGLang) requiring no API key.","updated_at":"2026-09-14T01:59:12Z","updated_by_operation":"op_ce87ec39c6b34517970734b4be6dda69"}
