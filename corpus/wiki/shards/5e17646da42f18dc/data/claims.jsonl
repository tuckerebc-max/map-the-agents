{"access":"public","created_at":"2026-09-14T01:59:12Z","created_by_operation":"op_ce87ec39c6b34517970734b4be6dda69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7652b0d38c95dc1984745935570a94ebeb6206f5bdb5552daeb71599207824ba","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"agentforce314/clawcodex@4706a57fc29f snapshot 920fad287979953b","timeframe":null},"slice_ids":["slc_5bcc9b5ac36c58ed6168b78b84689407dc75de50ad22d683f0016a35629d6fef","slc_ad9ea3d358f8907a0e245482f649ec4a3ac4a367ed641925da1f8ed10deb2369"],"source_ids":["src_9226b8c15a4055bc9ff0c9e30ea8324a"],"text":"Skills are markdown SKILL.md slash commands with front matter supporting descriptions, allowed-tools limits, and named arguments, available at project and user scope.","updated_at":"2026-09-14T01:59:12Z","updated_by_operation":"op_ce87ec39c6b34517970734b4be6dda69"}
