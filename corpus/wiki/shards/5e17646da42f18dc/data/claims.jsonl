{"access":"public","created_at":"2026-09-14T01:59:12Z","created_by_operation":"op_ce87ec39c6b34517970734b4be6dda69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_374016996a4d2382d1e3d0ccb3ea5e011050353cd60b43d2faaeae96b0922d3e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"agentforce314/clawcodex@4706a57fc29f snapshot 920fad287979953b","timeframe":null},"slice_ids":["slc_4d5a49fd6d8740df23ead3c0145e12f6d12fc80de813237696947111db6288bf","slc_7afe1c961e58080524ee45db5ce30f20f003bf9eb86ba257c28ec945a1b070a6"],"source_ids":["src_9226b8c15a4055bc9ff0c9e30ea8324a"],"text":"The /eco mode compresses model-bound Bash output with deterministic filters (failure-focused summaries, ceremony stripping, dedup, head-caps), discards any compression not better than the raw rendering, and tees lossy output to disk with a recovery hint.","updated_at":"2026-09-14T01:59:12Z","updated_by_operation":"op_ce87ec39c6b34517970734b4be6dda69"}
{"access":"public","created_at":"2026-09-14T01:59:12Z","created_by_operation":"op_ce87ec39c6b34517970734b4be6dda69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3a041c22429b3f898fc6663f9bc8f495341370d26bd4840f4a588de114d90462","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"agentforce314/clawcodex@4706a57fc29f snapshot 920fad287979953b","timeframe":null},"slice_ids":["slc_3b5b6de01e34005ec51715ec098c84c6a143e01255139292c79e008c0c401518","slc_b50a9babf534405d0d3e5762e516916938eccbf41ec59b5b13751e5ed9df0d3e"],"source_ids":["src_9226b8c15a4055bc9ff0c9e30ea8324a"],"text":"Requests keep a byte-stable prefix so DeepSeek's prompt cache covers system, tools, and history across turns; /cost is stated to follow DeepSeek's peak/off-peak pricing schedule.","updated_at":"2026-09-14T01:59:12Z","updated_by_operation":"op_ce87ec39c6b34517970734b4be6dda69"}
