{"access":"public","created_at":"2026-09-14T01:59:12Z","created_by_operation":"op_ce87ec39c6b34517970734b4be6dda69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_89193ffc48b5cc932f30f17491e81c404bdadc81f538f16036743e039e7772da","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"agentforce314/clawcodex@4706a57fc29f snapshot 920fad287979953b","timeframe":null},"slice_ids":["slc_369c2594ef8cf53647f0e7a6b39ce86a64b53bfbbf76a42e77f87ce75bbb5d5b","slc_a672222637f9eadeb4816e375053f771f692ac1b668b1780fcf49a1dc774f1d8"],"source_ids":["src_9226b8c15a4055bc9ff0c9e30ea8324a"],"text":"The product exposes a CLI with subcommands including tui, web, login, logout, config, and --version, plus a headless -p/--print mode for non-interactive runs.","updated_at":"2026-09-14T01:59:12Z","updated_by_operation":"op_ce87ec39c6b34517970734b4be6dda69"}
{"access":"public","created_at":"2026-09-14T01:59:12Z","created_by_operation":"op_ce87ec39c6b34517970734b4be6dda69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_93c86f2ea07832d91898efac8f6deadeda74daf039e17593bae5f99b0781601c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"agentforce314/clawcodex@4706a57fc29f snapshot 920fad287979953b","timeframe":null},"slice_ids":["slc_086b5f8f3b48b19e83131e509196d50f27b2b7d2e078553738d8af089e55d6da","slc_13f2c32a20db07e4d452913c7628e711f68cf23774272cf2da67aba7da458e11","slc_82e46b1fe2cc45933722b31d164a0a2aa61e13886e8d0f0b3b0a7500be43a3a1"],"source_ids":["src_9226b8c15a4055bc9ff0c9e30ea8324a"],"text":"Interactive sessions start in Full Access by default; /permissions offers Ask-for-approval, Approve-for-me, and Full Access levels, saved to permissions.defaultMode in ~/.clawcodex/settings.json.","updated_at":"2026-09-14T01:59:12Z","updated_by_operation":"op_ce87ec39c6b34517970734b4be6dda69"}
