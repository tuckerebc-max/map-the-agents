{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7211a1d7c13508161a2e6860a33ceaaf38eb362bc95e9628247f95dbe729a5b5"],"opposing_claim_ids":[],"text":"Agent identification uses GitHub search qualifiers on branch prefix (head:copilot/, head:codex/, head:cursor/) or bot author (devin-ai-integration[bot], codegen-sh[bot], google-labs-jules[bot])."},{"claim_ids":["clm_8dd0f084f7f43cafdb358a2bda792a84eade49ca0e165b6c7d6e2c5a199a3254"],"opposing_claim_ids":[],"text":"The project publishes an interactive dashboard at prarena.ai presenting the PR statistics."},{"claim_ids":["clm_987a64e5ebe6bfb8371707fdffb1b5179f5123f486384c7ddf92d906597c0389"],"opposing_claim_ids":[],"text":"Metrics distinguish all PRs (including drafts), ready (non-draft) PRs, and merged PRs, with headline statistics computed on ready PRs only for fair cross-agent comparison."},{"claim_ids":["clm_9a5719d35013e2bf762e52fc663e2b33e4d7bbe15ae223e6b755684cc0d784d4"],"opposing_claim_ids":[],"text":"The project benchmarks AI coding agents by measuring each agent's ability to produce mergeable pull requests, comparing ready-PR merge success rates across agents."},{"claim_ids":["clm_df4af57721abbefc284ce1f7fd2865e8b84d0e82c73835d06df58c763821b2a4"],"opposing_claim_ids":[],"text":"Published statistics table lists six agents (Copilot, Codex, Cursor, Devin, Codegen, Jules) with ready PR counts, merged PR counts, and success rates such as Copilot 96.04% and Devin 61.58%."}],"claim_ids":["clm_7211a1d7c13508161a2e6860a33ceaaf38eb362bc95e9628247f95dbe729a5b5","clm_8dd0f084f7f43cafdb358a2bda792a84eade49ca0e165b6c7d6e2c5a199a3254","clm_987a64e5ebe6bfb8371707fdffb1b5179f5123f486384c7ddf92d906597c0389","clm_9a5719d35013e2bf762e52fc663e2b33e4d7bbe15ae223e6b755684cc0d784d4","clm_df4af57721abbefc284ce1f7fd2865e8b84d0e82c73835d06df58c763821b2a4"],"created_at":"2026-09-14T03:30:40Z","created_by_operation":"op_c1cca8ed79d8454988265029c498fb25","id":"pg_5f7509e5c524512096c6a80e6856c6d2","maturity":"draft","page_type":