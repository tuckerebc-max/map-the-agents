{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1f1398bb65e383824d479e3a94e61e3476a93f7ec143702f485ac1532c62d2a2"],"opposing_claim_ids":[],"text":"The CLI supports commands such as login, run (with --thread), update/upgrade, serve (--api-only), and --web, and accepts a directory argument to attach a workspace."},{"claim_ids":["clm_59409e350d1c608d1ee2310a718ac6fd7c20e00ab02f799bc673f55c497020ce"],"opposing_claim_ids":[],"text":"Server behavior is configurable via environment variables including SPROCKET_DATA_DIR, SPROCKET_PORT (default 17731), SPROCKET_HOST (default 127.0.0.1), and SPROCKET_DESKTOP_EXECUTABLE."},{"claim_ids":["clm_c005a2f376c25e924f4df3ca345e6311a15d4a670b4ed6b7bf6b4f4abdd63fb1"],"opposing_claim_ids":[],"text":"Repository development practice: building and testing use bun install, bun dev, cargo test, bun run test, bun run build, and prek run -a, with Bun 1.3.9+, Node.js 24.14+, and a stable Rust toolchain required."}],"claim_ids":["clm_1f1398bb65e383824d479e3a94e61e3476a93f7ec143702f485ac1532c62d2a2","clm_59409e350d1c608d1ee2310a718ac6fd7c20e00ab02f799bc673f55c497020ce","clm_c005a2f376c25e924f4df3ca345e6311a15d4a670b4ed6b7bf6b4f4abdd63fb1"],"created_at":"2026-09-14T02:42:13Z","created_by_operation":"op_ced1cd4ef8a7485285dbcf625fbb902c","id":"pg_4431ec8bcfeb5bef9650406d4cb98885","maturity":"draft","page_type":"source","path":"pages/sources/spikonado-sprocket-readme-md-f705b4375ade-406d4cb98885.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c7ae16c93eef5061b3fb9dc9fda8d42a"],"title":"spikonado/sprocket/README.md @ f705b4375ade","updated_at":"2026-09-14T02:42:13Z","updated_by_operation":"op_ced1cd4ef8a7485285dbcf625fbb902c"}
