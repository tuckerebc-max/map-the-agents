{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_002cf7947be38670f1434eb7440d1a7bc1b1304333f3f20bb5f5a483172f911d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_77a2c1dcd28b8b1606e8ebb059546dfd94a58a50699e1146737d8982b3208274","slc_a3271d9d6d1c30602cd9fed753663510d9f1e1b8ee8aeb7b07d8ce16556101ce","slc_b229cb513a3ce67bc00e75d3b982bf883869f70bcf3e9388a283c77d236e5d94","slc_d04b8fb583c1112852f0a1ecc86b4c8a252bfa8a4c6fb3079fd4cf48f084e828","slc_ff033538c8fdda82a952d76f021f3225f93f832f516bf34fe44e4bcb86c5ff06"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Agents are defined in YAML files declaring a prompt, an executor harness (e.g. claude-sdk, codex, cursor, pi, openai-agents), tools including local Python functions, MCP servers, and delegatable sub-agents.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_133e70c679f59c54b8ac659997e5b8e03128cfb16065b2f8c1eaaff4ce12c78b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_9edc90b8e88454c183e3b80e3dd6c544a117474f6302dbe73493d396581f3bbd"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Sessions can run in disposable cloud sandboxes on providers including Modal, Daytona, E2B, Kubernetes, CoreWeave, and Databricks, launched from the CLI or provisioned per session by the server as managed hosts.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_13e01de6a89ff11b6dedc76ebbebcca947a3d37d7eeee9ce444dc652ced320e7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_117f6adf2be0228b074a68a99ed510b2715f1fe9f002bf48cf27009ff08e1844"],"source_ids":["src_aeb09033260c5eceae71d2764985e9d6"],"text":"Repository development practice: AGENTS.md instructs AI contributors to run the pre-commit hook before committing and fix reported issues so commits land clean, since CI runs the same checks.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_195b44f5fa73a7a3340245e42ff229d065c713e83dee93bda2dee1a0f49e6709","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_048a1cd641911abbe5c55a83c804a8a175b812b1592c72ebd736e9e223003b66"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Omnigent is described as an open-source meta-harness providing a common orchestration layer over Claude Code, Codex, Cursor, OpenCode, Hermes, Pi, and self-written agents, allowing harness swapping without rewrites.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_23bc56bc5afdca5b65d8372981ab5dfcd73b59b6146cca959f600769ef87e2a5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_46aa4aac3061787fc72385b69619f997d84e9978914b59c0d140c5995e708a61","slc_db866fc9b13c56974f11b469d4898e7f9afc0c683351c8c7fcf479d01b9d4b2e","slc_de781a58f761db651dbdec00976dfddc94521c0ece491bfa8fa1a09ae8dbf72e","slc_f5f4284dc3e1c17e03526ee988850ad01554795903acbf93916d6f413c4a43ea"],"source_ids":["src_aeb09033260c5eceae71d2764985e9d6"],"text":"Repository development practice: contributors use 'just' recipes for common tasks (ensure, dev, lint, electron builds, lockfile normalization) and must fill in the repo's PR template with summary, test plan, and demo sections.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_27d5a60e43b207a685868421aac1af684470a84d097282e043f1bb79cdf78980","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_a1d471470a667025864f2179b0c9cf2cb4008fd8f47d89efd94dff4fbc33f759"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Repository development practice: PRs adding or changing harness support should run the harness test bench to check the capability matrix against observed behavior.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2d7ced6b7f349171358d615d676aa22c6c6ab2bf71192fc74d87def6377db0af","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_07ed642c41a169265507489c791d67950d36b859e838fb29791c1212acc077c0","slc_521da524fa6dd9706d4e07cac07b7a8e4fcb2911ee9250a991d23f007e139bd0"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"The CLI exposes per-harness launchers such as omnigent claude, codex, cursor, agy, opencode, hermes, and pi, plus an interchangeable short alias 'omni' installed alongside the main command.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2e01678dd72e9bc366ad28851e51f3bb465b5645608857fd265f787f34b9a2c6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_5057f9408cc4e884b66444d9e3a157f31f3381f698fdc2ea484304aa7cf9dd88"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Sessions follow the user across devices: started in a terminal, they continue in the browser or on a phone, with messages, sub-agents, terminals, and files staying in sync.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_43450c85f57135b8ae245b7263c8f75740bc9f822d8037f88535c10a40610de2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_f35553f40546e0d5993534ca592bb6b9f7d54511a30b72aadd785b487c8f388c","slc_f6c1cec5ea6a5dfd06caad04b8a264c033cde7cc96a08d5547d5bba1f0b906d2","slc_f8bcee8a2409c42db8959ea408de343b29f5c68012f86e27dd2bbd7f57fc3aee"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"YAML-defined agents are launched with 'omnigent run path/to/agent.yaml', and examples such as polly, debby, and deep-research can be run the same way, optionally with a --harness override.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_76d59394a7f8bd34d614d0d9f48ff311ba7a9075783d3b18db938879d2c8c21a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_16737fcfddb44fbc1fe1b3a734f02b94944ad450d865bc8b2791c3930fe9f1c2"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"The Polly example is a multi-agent orchestrator that delegates coding to sub-agents (Claude Code, Codex, or Pi) in parallel git worktrees and routes each diff to a reviewer from a different vendor.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7b7f209c83b18616329a752c5115c70f2b96f3bc7b6e9f2294b592fa97331b48","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_342ba97ffca0a55de25a53f59951adee14f3ea1519366c50133472f217aa4536","slc_386b98376a25f410ea625f4b0270d77d0cbf47b0abb4d5e29e88ae9b265e2bf4","slc_a8616c5dc8aa14c458a1105975992050d4f1d7d50e9e445a72bfb354a52b65a6","slc_ddec9b75124fb52ffe35c5183e66d53bf655a9aad06b9297a3273f65ba52f1c6"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Multi-user accounts are enabled via OMNIGENT_AUTH_ENABLED=1; signup is invite-only through single-use invite links, and OIDC providers (Google, GitHub, Okta, Microsoft) can be configured on a deployed server.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_965166d942a5105687c49903a0d04b85535d9fecd4f155a10c993aebf394a50f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_f9abbb1385618c70476dc2d3127e85bbbf1130b5a38a5fdda339246427e56bf0"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Native harness terminal wrappers require tmux, the coding-harness CLIs installed by omnigent run need Node.js 22 LTS or newer with npm, and pnpm is needed for the web UI.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_98fdaa60decedd2ee4d6a4b1e6133d4ed6b386825a8e23972a1c7844f73544d2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_f9abbb1385618c70476dc2d3127e85bbbf1130b5a38a5fdda339246427e56bf0"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"On Linux, native harness terminal wrappers and the pi harness sandbox each agent terminal with bubblewrap, and that isolation is mandatory; macOS uses the built-in seatbelt sandbox instead.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ab72d6b5b17ea95eacab811c0fc8e81b3db675a8cf5a00ac800d680213dcb061","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_7cb5bbe13c3098c8b47a19f5a3274d54a073e2c365b93ba73af947dfc23d5a46","slc_8c425a12d382b26b0c2661c019a01c6d71818f81734e27ed1e11d65cb1183ff9","slc_efb3b0cab7f67037c1b1ace91fc7bf28a582ffdeb4614642a96c3f62690f509d"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"On Windows the product runs in a degraded mode: tmux/PTY terminal wrappers and bwrap/seatbelt filesystem and network sandboxing are unavailable; the Windows Job Object backend contains the process tree but does not isolate filesystem or network.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e516c802c2946b3c6d2f6844e2ad5ce6bf3275d45d111e684adc8cfc4a279320","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_176950654dae7d721df1445ad8ba2968a4f98e252253cfa88fcf50549305e687","slc_5154f522d4a56ceb0a9446b3bbc4e6a953509ad825c9ee0ad1607f531cee58a2","slc_781b2771969ef84c51918a94b6558622f0da31bb6d0a47c594dd4cdd2a61c779"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Policies check every agent action and allow, block, or pause for approval; builtins can cap tool calls and spend, and policies stack at server-wide, per-agent, and per-session levels with stricter session rules checked first.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e5e55063a220dae21408caea327daa642d79b2aa64815b81692659941f6753a8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_042d71f50e46302666ff8f223ce47d3fe0adaaa43eb54ee21e26d08e5f1a2ad9","slc_cf02fce81c56f775ff1ec0f32309c906f22daac7fdcfcee34b8d60e451c1e0f9"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Running omnigent starts a terminal session and a local web UI at http://localhost:6767 showing the same session; a macOS desktop app wraps that UI with OS notifications and a dock badge.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
{"access":"public","created_at":"2026-09-14T02:24:55Z","created_by_operation":"op_308e4d0dfae74684964b5d51ff904420","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f4256438dd509e1a63cb9c40b67f1108e6d1545285e79003e0bcc0629b204292","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"omnigent-ai/omnigent@270eca52b1e0 snapshot 94cb8b38f0cdc681","timeframe":null},"slice_ids":["slc_02bebced0e77c32fe36d1ac4731e9de2c84355b8696cd9181ce0f413c4fdc239","slc_2f83ad7ec473d4e91884ac73de859ae865e4e28e0c26f823b2370da8f2d49e6d","slc_302dca21f1f288796e08eaf3d06925799e1548ddbe657db7a1d474a68fe08353","slc_4ce4d96ad34bd9282f178f2cf2cddc638df5e1c842eb5ea99499cbbf0fab0179","slc_fc4e4dac8d5e8de1f30e6dc970ddfdd7e7e3b3be1c82a0b88083e847e4eeee95"],"source_ids":["src_a61e9a9d75855d7f8d9c5a778aed2fbc"],"text":"Omnigent requires Python 3.12+ and is installable via a curl installer script, uv/pip, or Homebrew; optional extras cover model providers (databricks, bedrock, vertex), sandbox providers, SDK harnesses, and storage/memory backends.","updated_at":"2026-09-14T02:24:55Z","updated_by_operation":"op_308e4d0dfae74684964b5d51ff904420"}
