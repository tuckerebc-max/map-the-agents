{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_15f65575ecc3b5d8090e4243a00316e6d21d32b7db1a350225f91af8884c3e75","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_17142da7c6224cb667d35b06557c7f07aaebb23fead4e84de212ee31deefd298","slc_4c893935e14bf48e0cd9fbd3001fa4b07b3ef5909e38e9801b4f8284f37ce786"],"source_ids":["src_a75a00c68a8e5ea6a03dd380496f62d2","src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"DeerFlow 2.0 is a ground-up rewrite sharing no code with the original v1 Deep Research framework, which per the French README is maintained on a separate 1.x branch.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1803af411e1dce5ee868bc04a7f004a57255fa94c223b891e8abfeecca8bf82e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_42a6f222c7e24a1259139469f3b1766d1187c3cadaabafa1b79d9b7d3bbb8bab","slc_57a3f2c7930931bbfed393b788e0cbbba208e093781e8b4f301a4e55ba120fd7","slc_b36f16e41cf0527bc30d811ad6a2dfac7789d1189a33eab58956faf249f605c1"],"source_ids":["src_a75a00c68a8e5ea6a03dd380496f62d2"],"text":"Repository development practice: the documented setup flow recommends make setup, an interactive wizard generating a minimal config.yaml and writing keys to .env, with make doctor for configuration checks and make support-bundle producing sanitized diagnostics (no .env, raw conversations, or user file contents) for GitHub issues.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1fde4adef3a342da1eb21e71717381f270b5654775103cfaf7b4c0be6cc7392a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_0c9ba14cef7135ae9b152f6cce38612e4f061712bd5a6364733ec9dd46435bc5","slc_148e9541f649cccdb167182cf7983a647f04861de29458195026a09de0982ff7"],"source_ids":["src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"A single make dev or Docker stack runs four services: Nginx on port 2026 as the only public entry point, a FastAPI Gateway on 8001 with an embedded LangGraph-compatible agent runtime, a Next.js frontend on 3000, and an optional provisioner on 8002 for provisioner/K8s sandbox mode.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_205af757a08de45635376754ed619ef14f30910535c2493db1ffba9ea2f06781","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_0980a7e776f0c289cda13050978c5994d5175066685218c8a88315fa99413cb9","slc_0d660175cfbcd3a4400d4ec444d4c66be2a73f4799fcc4db88187ed6e94dc7cc","slc_12be72e0cfdce9eb4afcf8acc3daf59240068b4ae48df689e6ead77d4e7fd53a","slc_5b639c8aed0f263fb54385234d982181e7b901c383fafea550d2e08bd32c20d6","slc_f3ec99568a9ea75ceb5eaf0e7033c0d9dbc087c23b9cd8b95a467cf6748f9758"],"source_ids":["src_9dbda6e4ff1c59b9b5cdba35220c75a0"],"text":"Repository development practice: Install.md is written for coding agents and prescribes an idempotent bootstrap that prefers Docker when available, avoids sudo and secret-file inspection, runs make config/docker-init or make check/install, and stops with a status report plus the exact next launch command.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_225af7dde29dfafcf43671f46ead14926f6d211f5c2486ff6418b71835e51270","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_db00a2b3c30c2627d0d7b71355a062359fbd7aac7f790d166f6fe7a23b0dd3f2"],"source_ids":["src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"DeerFlow (Deep Exploration and Efficient Research Flow) is an open-source super-agent harness built on LangGraph, where a lead agent orchestrates sub-agents, persistent memory, sandboxed code execution, and extensible skills/tools, isolated per conversation thread.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3996320ef5eac73d43c8e8b306a1840fbaba629593f4d3bb8f015ca1ceba28b5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_010f3db52ec53d74be6d5b36217875ac65906df14bf673c96eedc2ebea383ebf","slc_38c4edbeeedf94730e7fb3c0a1b2ffd3fb52c145aa7646c0ce1161fe24ec27a2"],"source_ids":["src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"All run modes execute the agent through the Gateway via RunManager, run_agent() and StreamBridge; the lead agent is assembled by make_lead_agent() and wrapped in a middleware chain (thread data, uploads, sandbox, summarization, title, todo list, view image, clarification) that runs before the model call.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3d57d70b7cbe0a2375d3e65fe93901931f1253958cda949ea3eee9e7c93ccb6b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_567c52c52b9e8e04d5a500770b2eb14340e3bc89980d911992df48e38ba018a4","slc_940e484c6c1f6f5e0df5bb072e496dd59bcf003d571857c446088a94eec51ac0"],"source_ids":["src_a75a00c68a8e5ea6a03dd380496f62d2","src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"The frontend uses Next.js 16, React 19, TypeScript and Tailwind v4, with the LangGraph SDK for orchestration/streaming and TanStack Query for server state, requiring Node 22+ and pnpm 10.26.2+; a README badge indicates Python 3.12+ for the backend.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_68e1f616c226e3b335ccba954f7e4cfc83c79fd8e45942c345afad9f00ae3494","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_fce9cd07c857530185fb6398421b5aa038060c39adc61ab6f581afeb5ae2bd86"],"source_ids":["src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"ThreadState extends LangGraph's AgentState with sandbox, artifacts, thread_data, title, todos and viewed_images, and each thread gets isolated data directories under backend/.deer-flow/threads/{thread_id}/.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6a04b155903f19f5b046e4ae4f7776ab66023f67f7c4f29fbf6b9da5a599080a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_c0706c3781647c90445344381695c29ba359eda3f8f2709e9d124acff7420059"],"source_ids":["src_b745213444965d178f5b1193177bbf59"],"text":"A database recovery doc states that an older deployment stamped with revision 0019_thread_incarnations but lacking the projects table and threads_meta.project_id cannot serve the current build; startup rejects that schema without changing it and reports the missing tables/columns.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_890d7ab8da77cdf148b6f41fcd213b8ecb2798ee8ace0464a3b86bd6209ab9e8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_0dc919e2a6b63654f5c5af8573e3884d453999ded8b6e8a4d023140eb936fce5"],"source_ids":["src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"The security model gates client-writable body.context and body.config: keys like non_interactive, disable_clarification and github_token are honored only for internally-authenticated callers, identity/sandbox fields are cleared and restamped from auth state, and nginx is the only published, loopback-by-default surface.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9fbde2b32e3faf41042fb46305c99648d9a6b13606404badcbd696d6c9caff45","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_1567322a2bd5a56a35cc46d96f09d6902f175ff9bef157db77d74bb7c73e6596","slc_53270a17bea5938bb1d03f16ae220f4d1b8ca11f611a8dfd75862301f03c277b","slc_834fd3db047ce2b0f047bdb92e5eaec40925e7cad381cc0128e5e81342fc6c7e","slc_85fb5c66a7e64a2abe5803cd6f2b3a4f86f9385417f744363f49c5c837b92909","slc_9bf388a20f4cb99f2a0035dfefe6d1132a95b1643040d07bf6aa777085b00374","slc_c5c32c7570efe8c2bed407d4b8dcae9f922fbc454a9472779fab29629e165007","slc_daadae5e2d14dc0b7e98b1af61bb38044ed38d889b03863430a1a25ab48bda96"],"source_ids":["src_98027274af2e59c19677abbd05dcf0a1"],"text":"An experiment prompt template defines a Context Extraction Assistant that summarizes conversation history into checklist sections (session intent, summary, artifacts, next steps) so the extracted context can replace the history and free conversation space.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a74cd3372d89d3041ddb3ee085837c91bfae71bdab1b8c82f84a2942725e651d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_1f65e54ceed552fd7f9f1046b158463be76d0948ba8106ed55a43c37549c777b","slc_d05ac1a58b42b036db8b0fb6abc86ff7bf78f1cf92fa7052eeb988e3899e6e80"],"source_ids":["src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"The backend splits into a publishable harness package (deerflow.*: orchestration, tools, sandbox, models, MCP, skills, memory, config) and an unpublished app layer (FastAPI Gateway, IM integrations), with a one-way rule that app imports deerflow but never the reverse, enforced by a CI test.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c076ce65c493b76e61e7bc0154547a5dd98b5cea7c6dd5e4fbde21c070a2ea2a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_fce9cd07c857530185fb6398421b5aa038060c39adc61ab6f581afeb5ae2bd86"],"source_ids":["src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"Tools come from three merged sources via get_available_tools(): built-ins (present_files, ask_clarification, view_image, review_skill_package), configured tools (bash, file operations, web search/fetch), and MCP tools; the sandbox is an abstract SandboxProvider with a dev-only LocalSandboxProvider and a Docker-based AioSandboxProvider using virtual path mapping.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
{"access":"public","created_at":"2026-09-14T01:38:55Z","created_by_operation":"op_3de92d471193478abc979211c1f01d2f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f91e4a78e4d0705f41b18e58de2a874c5fa0cb18629194b6b9c471c53a98648e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"bytedance/deer-flow@d5ae3882b670 snapshot f0af2b8a99cbd610","timeframe":null},"slice_ids":["slc_c44f90c564a448f199e259eae618740698dcac22f8e5037082ba4ff24c591ed2","slc_e22d808c66d493bad5bbf3f57383a722b2c4bf6bbc6edec837cc414a9ef0915e"],"source_ids":["src_b8d8f964e1e959869ce91d82ef10b5e9"],"text":"Nginx routes /api/langgraph/* to the Gateway's LangGraph-compatible runtime (rewritten to native /api/*), other /api/* paths to Gateway REST routers, and non-API paths to the frontend, so standard LangGraph SDK clients can talk to DeerFlow without a separate LangGraph server.","updated_at":"2026-09-14T01:38:55Z","updated_by_operation":"op_3de92d471193478abc979211c1f01d2f"}
