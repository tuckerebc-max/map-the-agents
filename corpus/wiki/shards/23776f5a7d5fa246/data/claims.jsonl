{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2fd468cddbb832af7d6a5c090acd44764815cb0e773cd00360ae897414dbc9da","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_5f7a4c9fbe0b92c396b94e0d802b2e3eb1828d96a1a9158ce52a67dd30863b35","slc_92b33f808de81a6e9492760f1659261a7534d9a0b743ddc4bea2ac5087afcf81","slc_ec38975f4dd57c098fcf16f8adcdef66bb64ece9066a1ec56db286d7c9c18796"],"source_ids":["src_eb44ebcbbdd052b69a4488cbf6cedb55","src_fc3cceb19b3c5e8e82b10057fdc46116"],"text":"Building from source requires Rust 1.88 or newer, Git, and platform build tools; the npm launcher requires Node.js 18+, and optional isolation dependencies are sandbox-exec (macOS) and bubblewrap (Linux).","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3b8a94e5cfe6f5795bc5b5e474ecf2723dca41f43dc91df56f7c55b6c607077a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_3dbd4ac13212f4551a5af03c26e21c2c3a968d506a5266bf6b7d80c66495104d","slc_5839c21bf73aa8eda5dbd7224690b10bf0eafad7e65a542d685afc315a11d627","slc_e97bd0b4641de1aae7cb7e35ec31ff3ad1e5eb7002a52ee494035f368a18917e"],"source_ids":["src_49047ae431c450799521ccc9223079c2","src_762f4e2667f3514d8ac9a56e4c2966f5","src_eb44ebcbbdd052b69a4488cbf6cedb55"],"text":"TUI, IDE, and CLI share one daemon-owned session model; the IDE holds no session store, model state, permission state, or execution path, and the daemon exposes typed presentation endpoints (activity, validation, summary, usage).","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6cec5f10685cc227fa13b9ac1578c1c1f4e78d00858143fbb240ea8f944a3c4f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_c85bfdf1d48424998ad711618094ea2488bc82bfa43c92c47dc20bab76a5c6a0"],"source_ids":["src_eb44ebcbbdd052b69a4488cbf6cedb55"],"text":"Repository development practice: repository checks run cargo fmt --check, clippy with -D warnings, cargo test --workspace, plus npm tests for the purrcode package and TypeScript SDK and Python unittest discovery for the Python SDK.","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_86d62b313efbde48d7a496c122a8635013e556fa3a7fa4135473d0c71e61da27","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_2a5cc2a37e3627dc46437857f475ced91c7977d80c0d993ab55287f7c1e804b4","slc_4dbe7735491e585e50809a249a62ae88fc1383a5062579bbf1ff82607f9d80cd","slc_69830f993fee3f7910f35258380f57e36e7e967b2f104fb11515f9063678cf7a","slc_8ae2b41d345716c2e5406fc50ace964637906ea172d44336fd07129dfe96bf60"],"source_ids":["src_49047ae431c450799521ccc9223079c2","src_762f4e2667f3514d8ac9a56e4c2966f5","src_e2d41f37bd355ba3bd839e1af20688f5"],"text":"Authorization is stored in append-only SQLite with exact action/constraint digest verification and atomic single-use consumption; NineLives owns durable events, checkpoints, restart reconciliation, and conservative recovery that never blindly replays interrupted actions.","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8bca330ca74031fbc29ebff32dd74a6bfdcc231c5c6872c4bd416b4fb727a147","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_05e61fc504bbe40db586f602bb33684bcde7c9873819a9712be898f1a2363fed","slc_145647f3423198b1548be7689fe6f9dd3396caeb3bd248c3b9624ff6609ba1d2","slc_769193cd6ab759e14da7615052d5d5dccd8c4a9c087b598782e39dc458ead6c3","slc_fd14908217a501e420c636b925f42c688e53f41417ef8518d333dc0078de275c"],"source_ids":["src_eb44ebcbbdd052b69a4488cbf6cedb55"],"text":"TUI slash commands include /connect (provider discovery/import), /mode (Ask/Plan/Build/Review), /permission (Ask/Auto/Full Access), and /ide; one-shot commands include plan, run, review, approve, doctor, sessions, resume, and rollback.","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9e1ea18de2a265f9ddefe5ce33d2a8a30ba18c64dd2408acee3103dd6ea3b96e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_3c5d8757d934275532e011e3e147f129c442083f4f2e65519a1456dccd525fa0","slc_69830f993fee3f7910f35258380f57e36e7e967b2f104fb11515f9063678cf7a"],"source_ids":["src_762f4e2667f3514d8ac9a56e4c2966f5","src_e2d41f37bd355ba3bd839e1af20688f5"],"text":"The architecture defines four subsystems: PawGate (policy/judgment/authorization), Claw (tool execution and sandboxing), Whisker (repository context and risk signals), and NineLives (checkpoints, recovery, rollback).","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a7726638ccbcdda382c04e7437a79979e71f1c287e1b708a694dc34c40f5cb8f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_5b735f260bd06ff5086165be324565ce42a47d772be3b70badf88462ee9ee294","slc_f7707ac9d4c22eda3b2e01aead60a8fe223361762e83ae66ea85bfac8d9ed5a6"],"source_ids":["src_e2d41f37bd355ba3bd839e1af20688f5"],"text":"Actions are strongly typed (Command, RepositoryRead, WriteFile, DeleteFile, ExternalTool) with no shell-string parsing in the trusted path; ExternalTool actions are MCP-only and always require approval.","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c749e9d12bd6ef1a66876f15b3241e62251a11601fc619725cdf50092957b3ab","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_bd81494b3aadccaa9c363e399af8688f46cbe3d32dcf4d63a08caae2905b32b1","slc_f7175c61a652a1ce344a7bb0f452e18ee2648d1a4ef2d27fd3e228fece39c9df"],"source_ids":["src_eb44ebcbbdd052b69a4488cbf6cedb55"],"text":"The product exposes a terminal Workbench (bare `purrcode`), a native Rust desktop IDE (`purrcode ide`/`gui`), and a browser Studio client (`purrcode studio`) for daemon health, sessions, and environment inspection.","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_dc882e293cc6bbf333c6cc8763fda4fbd852f066f70ab74ed02a8a299436960b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_0a5886dec13b3ab9555d2795a649b245061ed78c09f7ffb975b4f398e311565f","slc_8ae2b41d345716c2e5406fc50ace964637906ea172d44336fd07129dfe96bf60"],"source_ids":["src_762f4e2667f3514d8ac9a56e4c2966f5","src_eb44ebcbbdd052b69a4488cbf6cedb55"],"text":"Model output is treated as a proposal, never authority: every native action is bound to a durable authorization, re-checked before execution, and followed by recorded validation; repository content, model output, and downloaded skills are untrusted.","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
{"access":"public","created_at":"2026-09-14T03:22:45Z","created_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965","evidence_type":"organizational_statement","extraction_confidence":0.5,"id":"clm_f9c45bb610ee0070d1d3204492ee4eaa5f943a72d02a1f29c820bfb1911f04c1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=inference; facet=dependencies","setting":"weilin0723/purrcode@156d83206ed7 snapshot f386a16ac8aceb42","timeframe":null},"slice_ids":["slc_bd81494b3aadccaa9c363e399af8688f46cbe3d32dcf4d63a08caae2905b32b1","slc_e97bd0b4641de1aae7cb7e35ec31ff3ad1e5eb7002a52ee494035f368a18917e"],"source_ids":["src_49047ae431c450799521ccc9223079c2","src_eb44ebcbbdd052b69a4488cbf6cedb55"],"text":"The IDE appears to depend on the Rust eframe/egui stack, since the docs describe it as a pure-Rust eframe/egui desktop application with no browser, Electron, Tauri, or VS Code dependency.","updated_at":"2026-09-14T03:22:45Z","updated_by_operation":"op_8c04a21fa55b4059afc1bc5ea9f53965"}
