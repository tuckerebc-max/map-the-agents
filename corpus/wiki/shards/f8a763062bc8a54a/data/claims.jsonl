{"access":"public","created_at":"2026-09-14T02:40:57Z","created_by_operation":"op_761875c9fd34461c962d578ff399bf0d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a05a6ed103a32d9e76cb1cc9d13c11420b416513972d622c55262b5bbc62428c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"smtg-ai/claude-squad@ce1ffb4392b0 snapshot 930f92076f14d5f0","timeframe":null},"slice_ids":["slc_a3d3de258c23316b0d816b806b47d7fb6a82cdb303b40ddd58d20a7a8b6e68db","slc_a7178253dde0a5bd3373a7943fe260e011f22f80c67177eeebad7e1db0137a3c","slc_aa3d048de334df93e78fca1b9316a8d9874ad3fac6833114f4a068ddf47b1269","slc_b1f445d8d7b744c7266b3f5ab4a79cf587e9cdda3192a7bb5ce2aa3a4bace852"],"source_ids":["src_c7c41fc7632d5b258cc6d29ce33b666e"],"text":"Profiles allow named program configurations selectable at session creation; a `profiles` array with name/program fields and `default_program` is set in the config file.","updated_at":"2026-09-14T02:40:57Z","updated_by_operation":"op_761875c9fd34461c962d578ff399bf0d"}
{"access":"public","created_at":"2026-09-14T02:40:57Z","created_by_operation":"op_761875c9fd34461c962d578ff399bf0d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a7a576cc5d4dbd0b750ed866770788ffc74a0c575e71acfdd3dbdfa63dc8a725","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"smtg-ai/claude-squad@ce1ffb4392b0 snapshot 930f92076f14d5f0","timeframe":null},"slice_ids":["slc_3172b84ebdc2f6e28f5bf4a0ce3c917e3ddb41b6062a042bd002889207f0b129","slc_cec02285a0d26419b1b143b57d636defe73ab215cd7c8ddf18196650fe91f7e4"],"source_ids":["src_c7c41fc7632d5b258cc6d29ce33b666e"],"text":"The `-p/--program` flag lets users launch a chosen agent command in new instances, e.g. `cs -p \"codex\"` or an aider command with a specific model.","updated_at":"2026-09-14T02:40:57Z","updated_by_operation":"op_761875c9fd34461c962d578ff399bf0d"}
