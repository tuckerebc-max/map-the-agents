{"access":"public","created_at":"2026-09-14T02:40:57Z","created_by_operation":"op_761875c9fd34461c962d578ff399bf0d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_711115868d893aa61ac071c5bf63b3a281fd1da0050acbcd8dd73c87aab2c3df","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"smtg-ai/claude-squad@ce1ffb4392b0 snapshot 930f92076f14d5f0","timeframe":null},"slice_ids":["slc_03013e0cf3750c27e1ce612017a627ad02f27d5a59804a59af1ea1e9a7ecbaf9"],"source_ids":["src_c7c41fc7632d5b258cc6d29ce33b666e"],"text":"Claude Squad is a terminal application that manages multiple local AI coding agents such as Claude Code, Codex, Gemini, and Aider in separate workspaces for parallel tasks.","updated_at":"2026-09-14T02:40:57Z","updated_by_operation":"op_761875c9fd34461c962d578ff399bf0d"}
{"access":"public","created_at":"2026-09-14T02:40:57Z","created_by_operation":"op_761875c9fd34461c962d578ff399bf0d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_87fa88b518a1a8d3f6b426cf0bb27a06902e993999f3aee5cbd238108a4f72e1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"smtg-ai/claude-squad@ce1ffb4392b0 snapshot 930f92076f14d5f0","timeframe":null},"slice_ids":["slc_f1b86ecd7057740d1a6437cb086e8b01dde6055a578cd6fe071efc61d6c13f45"],"source_ids":["src_c7c41fc7632d5b258cc6d29ce33b666e"],"text":"The app uses tmux for isolated per-agent terminal sessions and git worktrees so each session works on its own branch, with a TUI for navigation.","updated_at":"2026-09-14T02:40:57Z","updated_by_operation":"op_761875c9fd34461c962d578ff399bf0d"}
