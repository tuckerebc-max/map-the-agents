{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7d8678b137277b1f3874b1c7d5de25001dad27d72211fcff0b4c49c899459906"],"opposing_claim_ids":[],"text":"Several integrations (AdaL, Aether, Agent Layer, Agentlink) are documented as beta and guidance-only: they write instruction files telling agents to use `tokenjuice wrap`, but do not intercept or replace terminal command output."}],"claim_ids":["clm_7d8678b137277b1f3874b1c7d5de25001dad27d72211fcff0b4c49c899459906"],"created_at":"2026-09-14T04:30:22Z","created_by_operation":"op_4bbba800506b49f39200b67746384f24","id":"pg_57084be5b7a55eab9d3f6d366fed1e8f","maturity":"draft","page_type":"source","path":"pages/sources/vincentkoc-tokenjuice-docs-aether-integration-md-43a621ab06ef-6d366fed1e8f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c862121ded9756e5a1348393ea14fc31"],"title":"vincentkoc/tokenjuice/docs/aether-integration.md @ 43a621ab06ef","updated_at":"2026-09-14T04:30:22Z","updated_by_operation":"op_4bbba800506b49f39200b67746384f24"}
