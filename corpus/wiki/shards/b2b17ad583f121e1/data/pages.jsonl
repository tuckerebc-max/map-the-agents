{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_c1f1e54968c8a11c7a3b03d49ce9ddd31a93534000851b6c4fc6955bb2d23456"],"opposing_claim_ids":[],"text":"A known issue documents that resizing the terminal during CLI operation can cause some UI elements to render multiple times, producing duplicate components and visual clutter."}],"claim_ids":["clm_c1f1e54968c8a11c7a3b03d49ce9ddd31a93534000851b6c4fc6955bb2d23456"],"created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","id":"pg_0ea7bcb68a4b5cf7bdb563b6d006756e","maturity":"draft","page_type":"source","path":"pages/sources/minmaxflow-mini-kode-known-issues-md-4e7f9767e5ca-63b6d006756e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_cad30b30e9a25baba7cb0db4f777fced"],"title":"minmaxflow/mini-kode/KNOWN_ISSUES.md @ 4e7f9767e5ca","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_006251e8c615219542ada5fe0d94d139066eb8ec73a2104309346dab373758bb"],"opposing_claim_ids":[],"text":"MCP servers are configured via .mini-kode/mcp.json with stdio and http transports; tools from connected servers are auto-registered, and ${ENV_VAR} references in args and headers are resolved from the environment."},{"claim_ids":["clm_270198b2b776df947f08acd01cb1e60efeae5f9e8ca94e259d8ee91105451e5e"],"opposing_claim_ids":[],"text":"Built-in tools include fileRead, fileEdit, listFiles, grep, glob, bash, architect, todo_read, todo_write, and fetch, plus dynamically registered MCP tools; fileEdit, bash, fetch, and MCP tools are marked as requiring permission."},{"claim_ids":["clm_d288e5546590be60c259addfee056fb21dbb12611d1a4e5acf584cb807fdc5ed"],"opposing_claim_ids":[],"text":"Tools implement a shared Tool<Input, Output> interface with a readonly flag; read-only tools run concurrently while writing tools run sequentially, and writing tools check permissions, pausing until the user approves."}],"claim_ids":["clm_006251e8c615219542ada5fe0d94d139066eb8ec73a2104309346dab373758bb","clm_270198b2b776df947f08acd01cb1e60efeae5f9e8ca94e259d8ee91105451e5e","clm_d288e5546590be60c259addfee056fb21dbb12611d1a4e5acf584cb807fdc5ed"],"created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","id":"pg_4b054c84d0005b1bacca7caafae440c4","maturity":"draft","page_type":"source","path":"pages/sources/minmaxflow-mini-kode-docs-tools-md-4e7f9767e5ca-7caafae440c4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_59a55bda968d5344973e2bc76f7bf8fa"],"title":"minmaxflow/mini-kode/docs/tools.md @ 4e7f9767e5ca","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_34c3bc6abd899a6c14329edbc25af68353be686c6b0b49df0a9c775fe72b2686"],"opposing_claim_ids":[],"text":"The agent executor runs a loop: build context, send the request with tool descriptions to the LLM, parse text or tool calls, execute tools, feed results back, and repeat until a final response; conversation length is managed via auto-compaction."},{"claim_ids":["clm_6bebbfd61415de1e5ffd3c2b8c85679817ce5c32aa9a46770d4ed7966a45bcf7"],"opposing_claim_ids":[],"text":"The system reads an AGENTS.md file from the project root and includes it in system prompts, providing persistent project context across sessions that users can edit."}],"claim_ids":["clm_34c3bc6abd899a6c14329edbc25af68353be686c6b0b49df0a9c775fe72b2686","clm_6bebbfd61415de1e5ffd3c2b8c85679817ce5c32aa9a46770d4ed7966a45bcf7"],"created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","id":"pg_55e391198e7556e09b84c2341414c673","maturity":"draft","page_type":"source","path":"pages/sources/minmaxflow-mini-kode-docs-llm-tool-integration-md-4e7f9767e5ca-c2341414c673.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e280ebeb38dc51a09be10278604c3c79"],"title":"minmaxflow/mini-kode/docs/llm-tool-integration.md @ 4e7f9767e5ca","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3aaaea4b807d6829794feefd46d3307d895f33cc04947fcab1c8980a585b4c59"],"opposing_claim_ids":[],"text":"The source tree is organized into modules for tools, Ink-based UI, LLM client, permissions, config, CLI, agent logic, sessions, and shared utilities."},{"claim_ids":["clm_467610794cd570914ad7fa3d29a8b0b9a7858bbf3e12a63e16003682ebe666d1"],"opposing_claim_ids":[],"text":"LLM access is configured via environment variables including DEEPSEEK_API_KEY, GLM_API_KEY, OPENAI_API_KEY, and generic MINIKODE_API_KEY/BASE_URL/MODEL variables; DeepSeek and GLM are noted as tested and verified."},{"claim_ids":["clm_6bebbfd61415de1e5ffd3c2b8c85679817ce5c32aa9a46770d4ed7966a45bcf7"],"opposing_claim_ids":[],"text":"The system reads an AGENTS.md file from the project root and includes it in system prompts, providing persistent project context across sessions that users can edit."},{"claim_ids":["clm_6d075132f9e58ed6762d8b91f0ac3e3ed32c316667dd24b1ebb803328d36e951"],"opposing_claim_ids":[],"text":"The documented tech stack includes TypeScript, pnpm, Ink for the terminal UI, OpenAI SDK for LLM integration, Vitest for testing, Zod for runtime validation, and Commander for the CLI."},{"claim_ids":["clm_a197315229be7f96ae0ed94d5d88c1fcb4a9fec023d54b3288d0dcc9b2d90f40"],"opposing_claim_ids":[],"text":"Mini-Kode is an educational project to help developers understand modern coding-agent architecture, described as a complete yet manageable implementation of about 14K lines of production code."},{"claim_ids":["clm_c3649298ba9da2533f28f9ede6f9978cea6b396827167b5ebe57d8d496e91b0a"],"opposing_claim_ids":[],"text":"No agent-performance evaluation or benchmark harness appears in the provided evidence; the only test-related material is the repository's own Vitest test command, so evaluation capability remains unknown."},{"claim_ids":["clm_c61821c4f771d452eace373afe4c8cd1a79f36c8cea2dbbeba779dc514c41634"],"opposing_claim_ids":[],"text":"The product is invoked as the mini-kode command; it supports an interactive mode (bare command) and a non-interactive mode that executes a task supplied as a quoted argument."},{"claim_ids":["clm_d696de5cdfec1c7f0ba4c5e8e7aee777e5371c59338095e8c10424bcdcb100fb"],"opposing_claim_ids":[],"text":"Repository development practice: contributors need Bun and pnpm, install with pnpm install, and use pnpm run dev, pnpm run build, and pnpm run test for development, building, and testing."}],"claim_ids":["clm_3aaaea4b807d6829794feefd46d3307d895f33cc04947fcab1c8980a585b4c59","clm_467610794cd570914ad7fa3d29a8b0b9a7858bbf3e12a63e16003682ebe666d1","clm_6bebbfd61415de1e5ffd3c2b8c85679817ce5c32aa9a46770d4ed7966a45bcf7","clm_6d075132f9e58ed6762d8b91f0ac3e3ed32c316667dd24b1ebb803328d36e951","clm_a197315229be7f96ae0ed94d5d88c1fcb4a9fec023d54b3288d0dcc9b2d90f40","clm_c3649298ba9da2533f28f9ede6f9978cea6b396827167b5ebe57d8d496e91b0a","clm_c61821c4f771d452eace373afe4c8cd1a79f36c8cea2dbbeba779dc514c41634","clm_d696de5cdfec1c7f0ba4c5e8e7aee777e5371c59338095e8c10424bcdcb100fb"],"created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","id":"pg_b1abd69b96295f9bb979465b33ec1493","maturity":"draft","page_type":"source","path":"pages/sources/minmaxflow-mini-kode-readme-md-4e7f9767e5ca-465b33ec1493.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4a8ec1d2c7085a37bf89c1ad5a1143f2"],"title":"minmaxflow/mini-kode/README.md @ 4e7f9767e5ca","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
