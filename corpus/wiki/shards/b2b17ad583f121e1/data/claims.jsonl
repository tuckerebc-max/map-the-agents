{"access":"public","created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6d075132f9e58ed6762d8b91f0ac3e3ed32c316667dd24b1ebb803328d36e951","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"minmaxflow/mini-kode@4e7f9767e5ca snapshot 270e8b959f6026a5","timeframe":null},"slice_ids":["slc_8fc8ea80a7957c6a97acb9d490be001dd685e61bc7ecc1f617a1fa2334a2c055"],"source_ids":["src_4a8ec1d2c7085a37bf89c1ad5a1143f2"],"text":"The documented tech stack includes TypeScript, pnpm, Ink for the terminal UI, OpenAI SDK for LLM integration, Vitest for testing, Zod for runtime validation, and Commander for the CLI.","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
