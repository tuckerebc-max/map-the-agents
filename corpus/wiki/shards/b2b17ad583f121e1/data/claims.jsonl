{"access":"public","created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d288e5546590be60c259addfee056fb21dbb12611d1a4e5acf584cb807fdc5ed","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"minmaxflow/mini-kode@4e7f9767e5ca snapshot 270e8b959f6026a5","timeframe":null},"slice_ids":["slc_098f89e9183ad6718cb1cf6e0e52879c41d14c741fa13b73608da3609e7573a4","slc_af91d6828ece013169c72bce5a7f8e265b839ffaefb76e40bfc454d136e7abca","slc_b480f08fda02975ee70253e1d85c8e2713319b28ba45a1fb0e4a527913f0ce09","slc_f592528d12c1cb692f06be934df35779a9506e4fa2bb4008b391c16bed46839b"],"source_ids":["src_59a55bda968d5344973e2bc76f7bf8fa"],"text":"Tools implement a shared Tool<Input, Output> interface with a readonly flag; read-only tools run concurrently while writing tools run sequentially, and writing tools check permissions, pausing until the user approves.","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
{"access":"public","created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d696de5cdfec1c7f0ba4c5e8e7aee777e5371c59338095e8c10424bcdcb100fb","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"minmaxflow/mini-kode@4e7f9767e5ca snapshot 270e8b959f6026a5","timeframe":null},"slice_ids":["slc_0203f2a44521253992a064c23f6abdc9787574a70ca53ad76d77efabc999a643","slc_24cca3b904312f304c24371017c2f3cd87b929f887c3e196d4ac051a54045241","slc_34dc6e8ab249c249426aa8946761fc6f9f29cb75b96e7d4bb6fa8e454c3b2bf3","slc_62a212965b7708061458a63e1d9980f5644d77567c21ccdcca45fac6ec81c304","slc_affac52bea45d17c7c470fb6b032b5cc477d97bc7df434d95a603c758ad45047"],"source_ids":["src_4a8ec1d2c7085a37bf89c1ad5a1143f2"],"text":"Repository development practice: contributors need Bun and pnpm, install with pnpm install, and use pnpm run dev, pnpm run build, and pnpm run test for development, building, and testing.","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
{"access":"public","created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_da860c0c35da3e3d9e1bc39de4d9a5d0bedc5456881e125e886b19be87792936","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"minmaxflow/mini-kode@4e7f9767e5ca snapshot 270e8b959f6026a5","timeframe":null},"slice_ids":["slc_028e40b4bb1120dd7d39dd81de6d7c751b555c7ff8338e6f6cae7edb2e91b4a0","slc_a1a832d03d25374da846c92bf74ebc8899d60ba655461b004570ffa92cbf2911"],"source_ids":["src_cd593d3c4060529dbeb97e011701e34f"],"text":"The architecture is layered: a terminal UI layer, an agent layer coordinating the LLM-plus-tool loop, an LLM layer with streaming and tool parsing, a tool layer, and an infrastructure layer for config and permissions.","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
