{"access":"public","created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_270198b2b776df947f08acd01cb1e60efeae5f9e8ca94e259d8ee91105451e5e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"minmaxflow/mini-kode@4e7f9767e5ca snapshot 270e8b959f6026a5","timeframe":null},"slice_ids":["slc_54a7423fce204a992f1de2e23a2e8c49415b3ad302656536922d78050e096239"],"source_ids":["src_59a55bda968d5344973e2bc76f7bf8fa"],"text":"Built-in tools include fileRead, fileEdit, listFiles, grep, glob, bash, architect, todo_read, todo_write, and fetch, plus dynamically registered MCP tools; fileEdit, bash, fetch, and MCP tools are marked as requiring permission.","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
{"access":"public","created_at":"2026-09-14T02:19:14Z","created_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_34c3bc6abd899a6c14329edbc25af68353be686c6b0b49df0a9c775fe72b2686","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"minmaxflow/mini-kode@4e7f9767e5ca snapshot 270e8b959f6026a5","timeframe":null},"slice_ids":["slc_4081105903b835f411b284523214acffe456fc89d2e65bc7ef65e9476bf0455a","slc_8a136d1a94af946a756aae39ca81f5a9fa4aac0c593790ffe6f05c1ced1bd36b","slc_9b0196d23b872a38dbefdd41574fb8fdd0627099630106e4549ea0dcca28a9cc","slc_c8110dd981765a4c182b9abef5e226fea54e16b0855751f22c3ba71ff8075171"],"source_ids":["src_cd593d3c4060529dbeb97e011701e34f","src_e280ebeb38dc51a09be10278604c3c79"],"text":"The agent executor runs a loop: build context, send the request with tool descriptions to the LLM, parse text or tool calls, execute tools, feed results back, and repeat until a final response; conversation length is managed via auto-compaction.","updated_at":"2026-09-14T02:19:14Z","updated_by_operation":"op_eaff9ee2afda4af4a6b28dc1d8091cb4"}
