{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_6f5d01c3b023025ac8ec1151fa7058e9a2b39c1450735951d1ff2f96e62b3eb8"],"opposing_claim_ids":[],"text":"Repository development practice: contributors must run ruff format and ruff check on src/ before submitting, follow a branch and commit-message convention (e.g. [Feature], [Fix]), and squash-merge feature branches into main."},{"claim_ids":["clm_f2cdd1cc6b487526c531553c5aae3ff466fa7c6a7a048d6bc6a69011fe0f48ff"],"opposing_claim_ids":[],"text":"Repository development practice: the project has no automated tests; changes are verified manually by running the analyze, generate readme, and generate ai-rules commands against a test repository."}],"claim_ids":["clm_6f5d01c3b023025ac8ec1151fa7058e9a2b39c1450735951d1ff2f96e62b3eb8","clm_f2cdd1cc6b487526c531553c5aae3ff466fa7c6a7a048d6bc6a69011fe0f48ff"],"created_at":"2026-09-14T03:48:05Z","created_by_operation":"op_e26813399e0f492e8dc7b23f7b90fced","id":"pg_680a75f0965f5b0e9a8063c5f60d02b0","maturity":"draft","page_type":"source","path":"pages/sources/divar-ir-ai-doc-gen-agents-md-bd3aba71a0c5-63c5f60d02b0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_252c62a602b85bf1ad27f922762a3c5e"],"title":"divar-ir/ai-doc-gen/AGENTS.md @ bd3aba71a0c5","updated_at":"2026-09-14T03:48:05Z","updated_by_operation":"op_e26813399e0f492e8dc7b23f7b90fced"}
