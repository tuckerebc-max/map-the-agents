"maturity":"draft","page_type":"entity","path":"pages/entities/winfunc-opcode-afab2068e89f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"winfunc/opcode","updated_at":"2026-09-14T03:24:03Z","updated_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1cc5dc55902f1f28c0346ae05858dad6d4e21663ed4e47e2a72e20a47b38df1b"],"opposing_claim_ids":[],"text":"The stack comprises a React 18 + TypeScript + Vite 6 frontend, a Rust backend using Tauri 2, Tailwind CSS v4 with shadcn/ui, and SQLite via rusqlite, with Bun as package manager."},{"claim_ids":["clm_35d7c29340e9b13035ec3e61307c80be70cf44cab79619229b08e571cd3ccafe"],"opposing_claim_ids":[],"text":"Building from source requires Rust 1.70.0+, Bun, Git, and the Claude Code CLI available on PATH, plus platform-specific system libraries such as webkit2gtk on Linux."},{"claim_ids":["clm_5610ba2c29b2cf8fecd5ca977b8420b90a94d0370c1614b1ac5d85a0da92fac0"],"opposing_claim_ids":[],"text":"opcode is a desktop GUI application and toolkit for Claude Code, supporting custom agent creation, interactive session management, and background agent execution."},{"claim_ids":["clm_c1fd597dd809c3e5e2e51e5993826bfbf52ad2c82951888c1442286f9e1efc90"],"opposing_claim_ids":[],"text":"When creating a custom agent, users can configure permissions for file read/write and network access per agent, and agents run in separate processes."},{"claim_ids":["clm_d785052957aaa61010b4e5deccb7f1ddfc93327cdb01e806ab44c95f5dcfa164"],"opposing_claim_ids":[],"text":"The Rust backend is organized into Tauri command handlers, a checkpoint module for timeline management, and a process module for process management, with a Rust test suite under src-tauri/tests."}],"claim_ids":["clm_1cc5dc55902f1f28c0346ae05858dad6d4e21663ed4e47e2a72e20a47b38df1b","clm_35d7c29340e9b13035ec3e61307c80be70cf44cab79619229b08e571cd3ccafe","clm_5610ba2c29b2cf8fecd5ca977b8420b90a94d0370c1614b1ac5d85a0da92fac0","clm_c1fd597dd809c3e5e2e51e5993826bfbf52ad2c82951888c1442286f9e1efc90","clm_d785052957aaa61010b4e5deccb7f1ddfc93327cdb01e806ab44c95f5dcfa164"],"created_at":"2026-09-14T03:24:03Z","created_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1","id":"pg_b32de48f11b0584ca851a492ecbdd7ef","maturity":"draft","page_type":"source","path":"pages/sources/winfunc-opcode-readme-md-70c16d8a4910-a492ecbdd7ef.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_824cbb48444450aba5185fbcd9b90a6a"],"title":"winfunc/opcode/README.md @ 70c16d8a4910","updated_at":"2026-09-14T03:24:03Z","updated_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0f66fce9ca8aa3aaf49c04ffdb4faf67fee473b700000068f054a789347731ea"],"opposing_claim_ids":[],"text":"Web server mode exposes a REST API and WebSocket interface mirroring the desktop app, with request fields for command type (execute/continue/resume), project path, prompt, model, and session id."},{"claim_ids":["clm_14bc4b6623b50c593bc851763570f455b28534bb5cb15d1fc676e9075e1b9869"],"opposing_claim_ids":[],"text":"The web server provides cancel and output endpoints at /api/sessions/{sessionId}/cancel and /api/sessions/{sessionId}/output, added because the frontend expected them."},{"claim_ids":["clm_169b44fc7dbb7f45478526becf90046d58ab90685c1a9abe27eac80e16f1390b"],"opposing_claim_ids":[],"text":"The web server mode has documented critical issues: sessions interfere via generic events, the cancel endpoint is a stub that does not terminate processes, stderr is not captured, and claude-cancelled events are missing."},{"claim_ids":["clm_5a35f847e31f8410e3d1bfd8c5973ce175872b7443703bc7d40f8427ac434a60"],"opposing_claim_ids":[],"text":"In web mode the frontend falls back from Tauri event listening to browser DOM events, handling both string payloads (Tauri) and object payloads (web) for compatibility."},{"claim_ids":["clm_8a42e354eaf7eb9184fee6e07ede8381e4ec1028b71b9864664090430b74aab2"],"opposing_claim_ids":[],"text":"Web server mode is described as functional for single-session use but not production-suitable, and web mode runs Claude with the --dangerously-skip-permissions flag with CORS allowing all origins."}],"claim_ids":["clm_0f66fce9ca8aa3aaf49c04ffdb4faf67fee473b700000068f054a789347731ea","clm_14bc4b6623b50c593bc851763570f455b28534bb5cb15d1fc676e9075e1b9869","clm_169b44fc7dbb7f45478526becf90046d58ab90685c1a9abe27eac80e16f1390b","clm_5a35f847e31f8410e3d1bfd8c5973ce175872b7443703bc7d40f8427ac434a60","clm_8a42e354eaf7eb9184fee6e07ede8381e4ec1028b71b9864664090430b74aab2"],"created_at":"2026-09-14T03:24:03Z","created_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1","id":"pg_f8dabca7c2a35ec2b9546fff0b71a53e","maturity":"draft","page_type":"source","path":"pages/sources/winfunc-opcode-web-server-design-md-70c16d8a4910-6fff0b71a53e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_67694cea036e5b7881d048ecae056646"],"title":"winfunc/opcode/web_server.design.md @ 70c16d8a4910","updated_at":"2026-09-14T03:24:03Z","updated_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1"}
