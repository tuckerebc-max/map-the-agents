{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_567e8a2284636d696fd1f3032ead04439f194cc29a920f7c8541a4a27c1d545b"],"opposing_claim_ids":[],"text":"Repository development practice: contributors should fork, branch, ensure tests pass, and open PRs with title prefixes like Feature:, Fix:, Docs:, Refactor:, Improve:, or Other:, or risk closure without merging."},{"claim_ids":["clm_e95ade364d257124b117f70b6de2e344360fe67361d0013b2ea985414f632862"],"opposing_claim_ids":[],"text":"Repository development practice: frontend code should use TypeScript, functional components with hooks, and Tailwind CSS; Rust code should follow standard conventions with cargo fmt, clippy, explicit Result handling, and cargo test."}],"claim_ids":["clm_567e8a2284636d696fd1f3032ead04439f194cc29a920f7c8541a4a27c1d545b","clm_e95ade364d257124b117f70b6de2e344360fe67361d0013b2ea985414f632862"],"created_at":"2026-09-14T03:24:03Z","created_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1","id":"pg_0bc0f8ac988253d6a7857026d599fd72","maturity":"draft","page_type":"source","path":"pages/sources/winfunc-opcode-contributing-md-70c16d8a4910-7026d599fd72.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_042d3e9d559059dba8a40876880553a1"],"title":"winfunc/opcode/CONTRIBUTING.md @ 70c16d8a4910","updated_at":"2026-09-14T03:24:03Z","updated_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1"}
