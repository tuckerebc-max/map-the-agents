{"access":"public","created_at":"2026-09-14T03:24:03Z","created_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_14bc4b6623b50c593bc851763570f455b28534bb5cb15d1fc676e9075e1b9869","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"winfunc/opcode@70c16d8a4910 snapshot 1501a42f650f8975","timeframe":null},"slice_ids":["slc_f1c558c66923cb31bea14ca9abef5cdf77808e7e38c45ed67d399fc2c973aed8"],"source_ids":["src_67694cea036e5b7881d048ecae056646"],"text":"The web server provides cancel and output endpoints at /api/sessions/{sessionId}/cancel and /api/sessions/{sessionId}/output, added because the frontend expected them.","updated_at":"2026-09-14T03:24:03Z","updated_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1"}
{"access":"public","created_at":"2026-09-14T03:24:03Z","created_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_169b44fc7dbb7f45478526becf90046d58ab90685c1a9abe27eac80e16f1390b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"winfunc/opcode@70c16d8a4910 snapshot 1501a42f650f8975","timeframe":null},"slice_ids":["slc_115debc06bfdbbd8f4e51a21acbe940375c26fa81351f94b2aa710be4f9d2010","slc_3d532f20d022afe64f17c9ec8728adaae10d89dc3c61dfa7b8bf05b8b3a3b529"],"source_ids":["src_67694cea036e5b7881d048ecae056646"],"text":"The web server mode has documented critical issues: sessions interfere via generic events, the cancel endpoint is a stub that does not terminate processes, stderr is not captured, and claude-cancelled events are missing.","updated_at":"2026-09-14T03:24:03Z","updated_by_operation":"op_dfd0175fd1c14db1855ffb1be8e75ab1"}
