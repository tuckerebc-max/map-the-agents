{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_766a90d31c7c12b46c3081a71ad7831352cb5f6c10049cf9e9da8ee46705e65d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_f4a664b2279a2e8b4c168345082e67e43a0cb500c3245b44282d88174dba956b"],"source_ids":["src_b442bd2e961b5a77aec5fdde1cc7cf3f"],"text":"TypedAI includes two autonomous agent types, XML and CodeGen, which apply reasoning to break a user request into a plan executed via available function calls.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_77fdf0304facd5cef4595e2462448118cb2795583bfd538c3d46b35276f440f9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_bf0ce746a423e0d8a7ede32b5cfaf468e05241d7c62415b9c8869a1940c7cf7c","slc_dadc1f364a92d7e88a35a11986406f1bf3d5f748db091b1af84d486c91374dab"],"source_ids":["src_ae5caeac3134580eb622eebef80be898"],"text":"The Postgres schema auto-created at startup includes tables for users, chats, agent contexts and iterations, LLM call logs, prompt revisions, function cache, and code review configs.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7af6d6a0c7b90cf27841ff612ab7cd533dbcf9333b9ff0eb2aae92d9437168dc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_7f160de4be9e314b5de90e8583ff72acd69ec34015f3ba1f46fd9eb88d2afa16","slc_ae3c0faa871d88e0d0b577d797549babb800c582ad888f6a1b3dc127868895ce"],"source_ids":["src_b442bd2e961b5a77aec5fdde1cc7cf3f"],"text":"The project distinguishes workflow agents, whose control flow is defined in code with LLM results driving conditionals, from autonomous agents where the LLM directs its own process and tool usage.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
