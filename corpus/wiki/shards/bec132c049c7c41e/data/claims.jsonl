{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_05c519830705cc1537f1c7ef1328998a617ceca753bdafdff6ee153c1d73e80c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_61bf8073d8a62c4ca5bce9a5fbfa1a75c71008a6d91c8aa8fbd1d5915eccb19c"],"source_ids":["src_b442bd2e961b5a77aec5fdde1cc7cf3f"],"text":"Each agent is configured with three LLMs for easy, medium, and hard tasks, making it simple to swap in different models at a given capability level.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_11b1fa1c83c321dd2e4487cd378a1267c521d992e516cb86e1dd706742a83516","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_1fe83f3da10c0eccf19bad41d93739c0f6cb1679d0ff61d68b6b848db27fb0b5","slc_cccc82e5420258e8b703870a0e236436138c8ddb8cebe921a2788e8c1c9aab68"],"source_ids":["src_a3c288f08b9b588db7dd18d9c10a5b54"],"text":"Code review guidelines are defined as XML files in `resources/codeReview` against a schema there, and reviews can be filtered by file extension or required diff text to reduce LLM cost.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_18a3e13280227d4af4f160adbdae8cd9460e49d6142f997d710ba609328b8127","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_2e566c61693f162b920c1a5290e0ac5c53780bf6f2c520b04e99d47195532bb1","slc_4fd412b36f5e9b88da9c4ca379c7e8f1ea3d750e0b3733c1a3e90942b10ae657","slc_feab0e56b532e200fdadd6f5418273f4b2f41709b470f71308c99513122bed67"],"source_ids":["src_a3c288f08b9b588db7dd18d9c10a5b54"],"text":"Enabling the GitLab code-review feature requires configuring webhooks at project or group level pointing to `<your-typedai-domain>/gitlab/v1/webhook`.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_29b18f76093eeee0104cbc9dab8aefc4a3382ec4e2ea4ceb8c7a5b29b7c5844a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_968cdd036c2d3a812bde32280aa6cf582deca8f438184a61f65d7f7e1edb6861"],"source_ids":["src_e50d67832afd56acba86ec42552f9142"],"text":"The platform supports many LLM services including OpenAI, Anthropic (native and Vertex), Gemini, Groq, Fireworks, Together.ai, DeepSeek, Ollama, Cerebras, SambaNova, OpenRouter, and X.ai.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3eb6d4ca2a8badd2957a211516b4279498f93740e4854e1d062cd6c256a282c6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_20d4e703148beaccd2cee5813e0be3266628c34e0936b7a06257ed1147f7b539","slc_b06f6deeb6c8d75d174e9db74685d3c281df754abff5d7bf1caa58f6b57d1274"],"source_ids":["src_b442bd2e961b5a77aec5fdde1cc7cf3f"],"text":"Agent state, current user, tool configuration, and default LLMs are looked up through Node's AsyncLocalStorage, requiring agent code to run within an AsyncLocalStorage context.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4a9ac38de623b2c358f4a047beb48bcc4adf64ca173efa0729db226f8ad7e950","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_43e632650123daa5425705703f74bba29e48f187d13cffbb54bc6241dbafc83a","slc_968cdd036c2d3a812bde32280aa6cf582deca8f438184a61f65d7f7e1edb6861"],"source_ids":["src_e50d67832afd56acba86ec42552f9142"],"text":"TypedAI offers both CLI and Web UI interfaces, and the `ai` wrapper script runs locally while `aid` runs in Docker for isolation; both expose CLI agents including a codeAgent for autonomous code editing.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5bb70e06102c29ffb76581ec165402521c06b1e784abb115fdddbc899900cf85","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_183d9d1f983be13ae8352158d0217af477807294e70e2ea75764fe74954df03f","slc_56aaf8f00eb3ae0ccf0a57d514323ea8d5ec68af3c746ff88376b0b7ee6a41fb"],"source_ids":["src_e50d67832afd56acba86ec42552f9142"],"text":"TypedAI is a full-featured platform for developing and running agents, LLM-based workflows, and chatbots, described as the TypeScript-first AI platform for developers.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6da9f1e360428a77c4a1d5387cd55ac2a07caafb91a9ddcb0be5d510e852a138","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"trafficguard/typedai@34139aec65bb snapshot 05c891535de024b4","timeframe":null},"slice_ids":["slc_ce3317274362405498ea0a524435994199bb312f8bba0a43b055a0051856894c","slc_dfd22b13574bff238e7e4c40154929b0b070296fcf7c26828d9fcfcc8a8f49b2"],"source_ids":["src_41a1709330b3550db1a2e93f27bb10f9"],"text":"Repository development practice: contributors set up the project with `./bin/setup` and run it locally with `./bin/serve`.","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
