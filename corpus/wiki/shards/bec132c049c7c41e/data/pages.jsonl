{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_11b1fa1c83c321dd2e4487cd378a1267c521d992e516cb86e1dd706742a83516"],"opposing_claim_ids":[],"text":"Code review guidelines are defined as XML files in `resources/codeReview` against a schema there, and reviews can be filtered by file extension or required diff text to reduce LLM cost."},{"claim_ids":["clm_18a3e13280227d4af4f160adbdae8cd9460e49d6142f997d710ba609328b8127"],"opposing_claim_ids":[],"text":"Enabling the GitLab code-review feature requires configuring webhooks at project or group level pointing to `<your-typedai-domain>/gitlab/v1/webhook`."}],"claim_ids":["clm_11b1fa1c83c321dd2e4487cd378a1267c521d992e516cb86e1dd706742a83516","clm_18a3e13280227d4af4f160adbdae8cd9460e49d6142f997d710ba609328b8127"],"created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","id":"pg_02ca3efb22af579a957d930e4d75184f","maturity":"draft","page_type":"source","path":"pages/sources/trafficguard-typedai-docs-code-review-md-34139aec65bb-930e4d75184f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a3c288f08b9b588db7dd18d9c10a5b54"],"title":"TrafficGuard/typedai/docs/CODE_REVIEW.md @ 34139aec65bb","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_77fdf0304facd5cef4595e2462448118cb2795583bfd538c3d46b35276f440f9"],"opposing_claim_ids":[],"text":"The Postgres schema auto-created at startup includes tables for users, chats, agent contexts and iterations, LLM call logs, prompt revisions, function cache, and code review configs."}],"claim_ids":["clm_77fdf0304facd5cef4595e2462448118cb2795583bfd538c3d46b35276f440f9"],"created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","id":"pg_06e3c40b56a55922946526b8ff7e048b","maturity":"draft","page_type":"source","path":"pages/sources/trafficguard-typedai-docs-postgres-setup-md-34139aec65bb-26b8ff7e048b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ae5caeac3134580eb622eebef80be898"],"title":"TrafficGuard/typedai/docs/POSTGRES_SETUP.md @ 34139aec65bb","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_72b574060ff1a72f14216f97d0ee5272b79fb795f5150991d32d8891a227163a"],"opposing_claim_ids":[],"text":"Repository development practice: with `DATABASE_TYPE=postgres` set, a Postgres Docker container auto-starts during app-context initialization, skipping when the host is remote, inside Docker, or in CI."}],"claim_ids":["clm_72b574060ff1a72f14216f97d0ee5272b79fb795f5150991d32d8891a227163a"],"created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","id":"pg_3605c9fc574f5e73affb45681f5ea03d","maturity":"draft","page_type":"source","path":"pages/sources/trafficguard-typedai-docs-auto-start-postgres-md-34139aec65bb-45681f5ea03d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_15a18810039757b2b445f52f5dcffbd0"],"title":"TrafficGuard/typedai/docs/AUTO_START_POSTGRES.md @ 34139aec65bb","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_05c519830705cc1537f1c7ef1328998a617ceca753bdafdff6ee153c1d73e80c"],"opposing_claim_ids":[],"text":"Each agent is configured with three LLMs for easy, medium, and hard tasks, making it simple to swap in different models at a given capability level."},{"claim_ids":["clm_3eb6d4ca2a8badd2957a211516b4279498f93740e4854e1d062cd6c256a282c6"],"opposing_claim_ids":[],"text":"Agent state, current user, tool configuration, and default LLMs are looked up through Node's AsyncLocalStorage, requiring agent code to run within an AsyncLocalStorage context."},{"claim_ids":["clm_762b2dc5bb00d8cb6235e4464529486c76f8f8eb703b56ce2fe3d147ece003e7"],"opposing_claim_ids":[],"text":"Workflows run with a persisted agent context whose state is saved as 'completed' or 'error', so agent actions can be reviewed and resumed in the UI."},{"claim_ids":["clm_766a90d31c7c12b46c3081a71ad7831352cb5f6c10049cf9e9da8ee46705e65d"],"opposing_claim_ids":[],"text":"TypedAI includes two autonomous agent types, XML and CodeGen, which apply reasoning to break a user request into a plan executed via available function calls."},{"claim_ids":["clm_7af6d6a0c7b90cf27841ff612ab7cd533dbcf9333b9ff0eb2aae92d9437168dc"],"opposing_claim_ids":[],"text":"The project distinguishes workflow agents, whose control flow is defined in code with LLM results driving conditionals, from autonomous agents where the LLM directs its own process and tool usage."}],"claim_ids":["clm_05c519830705cc1537f1c7ef1328998a617ceca753bdafdff6ee153c1d73e80c","clm_3eb6d4ca2a8badd2957a211516b4279498f93740e4854e1d062cd6c256a282c6","clm_762b2dc5bb00d8cb6235e4464529486c76f8f8eb703b56ce2fe3d147ece003e7","clm_766a90d31c7c12b46c3081a71ad7831352cb5f6c10049cf9e9da8ee46705e65d","clm_7af6d6a0c7b90cf27841ff612ab7cd533dbcf9333b9ff0eb2aae92d9437168dc"],"created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","id":"pg_387a968520b158c9944c01f2da1e5981","maturity":"draft","page_type":"source","path":"pages/sources/trafficguard-typedai-docs-docs-agent-concepts-md-34139aec65bb-01f2da1e5981.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b442bd2e961b5a77aec5fdde1cc7cf3f"],"title":"TrafficGuard/typedai/docs/docs/agent-concepts.md @ 34139aec65bb","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0491418b123b418f81c8ce4393fe799a31e29bc83a275a6a0e65c38a0ecb4749"],"opposing_claim_ids":[],"text":"LLM function-calling schemas are auto-generated from a `@func` decorator on class methods, avoiding duplicate schema definitions via zod or JSON."},{"claim_ids":["clm_29b18f76093eeee0104cbc9dab8aefc4a3382ec4e2ea4ceb8c7a5b29b7c5844a"],"opposing_claim_ids":[],"text":"The platform supports many LLM services including OpenAI, Anthropic (native and Vertex), Gemini, Groq, Fireworks, Together.ai, DeepSeek, Ollama, Cerebras, SambaNova, OpenRouter, and X.ai."},{"claim_ids":["clm_4a9ac38de623b2c358f4a047beb48bcc4adf64ca173efa0729db226f8ad7e950"],"opposing_claim_ids":[],"text":"TypedAI offers both CLI and Web UI interfaces, and the `ai` wrapper script runs locally while `aid` runs in Docker for isolation; both expose CLI agents including a codeAgent for autonomous code editing."},{"claim_ids":["clm_5bb70e06102c29ffb76581ec165402521c06b1e784abb115fdddbc899900cf85"],"opposing_claim_ids":[],"text":"TypedAI is a full-featured platform for developing and running agents, LLM-based workflows, and chatbots, described as the TypeScript-first AI platform for developers."},{"claim_ids":["clm_b00a9ed204502c57d080f8da548ec66dbef7a9ea20e7597077d9b2eb1bc80248"],"opposing_claim_ids":[],"text":"The CLI supports commands such as `ai query`, `ai code`, and `ai research` for automation and development workflows."},{"claim_ids":["clm_bed482c862198f71bab09e481d08ba1b207503be2c338c0037c32ae864023b76"],"opposing_claim_ids":[],"text":"Agents use callable tool integrations such as Filesystem, Jira, Slack, Perplexity, Google Cloud, GitLab, and GitHub, with configurable human-in-the-loop settings for budget control and agent-initiated questions."},{"claim_ids":["clm_c29bf7be5151f0a56bb06cec4a346be8af8ee37c52493505bab0f8d228727d1e"],"opposing_claim_ids":[],"text":"The platform ships software-developer agents including a Code Editing Agent with a compile/lint/test/fix loop, a ticket-to-PR Software Engineer Agent, and a Code Review agent that posts comments on GitLab merge requests."},{"claim_ids":["clm_ed7ad4b921c877b74bfb7d6687d3fcb1f73067161cbb60c17d25b6dff93eb37d"],"opposing_claim_ids":[],"text":"The project does not use LangChain, and its README claims the platform's scope covers functionality found in LangChain and LangSmith."}],"claim_ids":["clm_0491418b123b418f81c8ce4393fe799a31e29bc83a275a6a0e65c38a0ecb4749","clm_29b18f76093eeee0104cbc9dab8aefc4a3382ec4e2ea4ceb8c7a5b29b7c5844a","clm_4a9ac38de623b2c358f4a047beb48bcc4adf64ca173efa0729db226f8ad7e950","clm_5bb70e06102c29ffb76581ec165402521c06b1e784abb115fdddbc899900cf85","clm_b00a9ed204502c57d080f8da548ec66dbef7a9ea20e7597077d9b2eb1bc80248","clm_bed482c862198f71bab09e481d08ba1b207503be2c338c0037c32ae864023b76","clm_c29bf7be5151f0a56bb06cec4a346be8af8ee37c52493505bab0f8d228727d1e","clm_ed7ad4b921c877b74bfb7d6687d3fcb1f73067161cbb60c17d25b6dff93eb37d"],"created_at":"2026-09-14T04:27:59Z","created_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69","id":"pg_4002fb97e4005b06952e18fdb8c740cf","maturity":"draft","page_type":"source","path":"pages/sources/trafficguard-typedai-readme-md-34139aec65bb-18fdb8c740cf.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e50d67832afd56acba86ec42552f9142"],"title":"TrafficGuard/typedai/README.md @ 34139aec65bb","updated_at":"2026-09-14T04:27:59Z","updated_by_operation":"op_cfce705b28cb4c7a9f4f7294a9c0fe69"}
