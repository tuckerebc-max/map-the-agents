659502336eedb6607d1c86","clm_7a57cadd1c414fb6b86affaf23659e238323b1f38ce4fc1872cd33a8db67904e","clm_7f7b6605c571d369fa524101d1df8ae9f1b2a6d10f929c62895d4780b44a69ef","clm_8767f500c0ffa2ddd79be00717321c6c9125448995e9b94ae40097ee222889ef","clm_88ed8a71d007983c82e9c01c87da37e888b9248facff52d23c5abc89708dd93d","clm_9199d2916301eb69ee465747887bbc77c211d10431e79444f9d89588f0caa566","clm_b681d68111c5abe390647f360132cd7da05640b2c7eb469edf57a106aa232433","clm_bf8497c681173ea7473cce5d7575717ec448844610374f088825240865108883","clm_f550331e2cdc019645cd24aa3e4dbd228fbc6d345391de39c7ca3e2ae8054b5e"],"created_at":"2026-09-14T04:22:24Z","created_by_operation":"op_3f0ec349a8ce4f3a950726d28a52970a","id":"pg_b1989122339754808ef81e786504006c","maturity":"draft","page_type":"entity","path":"pages/entities/sondera-ai-sondera-coding-agent-hooks-1e786504006c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"sondera-ai/sondera-coding-agent-hooks","updated_at":"2026-09-14T04:22:24Z","updated_by_operation":"op_3f0ec349a8ce4f3a950726d28a52970a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_282c65fb898dbc36c04ca741468f17d4fe306b35cfe25c16f96733339b435d11"],"opposing_claim_ids":[],"text":"Enabling the LLM classifiers adds latency to every decision they touch, and with guardrails enabled event content is sent to the configured provider."},{"claim_ids":["clm_7a57cadd1c414fb6b86affaf23659e238323b1f38ce4fc1872cd33a8db67904e"],"opposing_claim_ids":[],"text":"Enforcement hooks fail closed: a hook that cannot reach the harness denies preventive events and never proceeds unadjudicated, so losing the server blocks the agent rather than ungoverning it."},{"claim_ids":["clm_b681d68111c5abe390647f360132cd7da05640b2c7eb469edf57a106aa232433"],"opposing_claim_ids":[],"text":"Neither gRPC surface authenticates its caller: adjudication is plain HTTP/2 gRPC and the console returns the whole local store and exposes agent deletion, so the bind address should stay on loopback or behind an authenticating proxy."}],"claim_ids":["clm_282c65fb898dbc36c04ca741468f17d4fe306b35cfe25c16f96733339b435d11","clm_7a57cadd1c414fb6b86affaf23659e238323b1f38ce4fc1872cd33a8db67904e","clm_b681d68111c5abe390647f360132cd7da05640b2c7eb469edf57a106aa232433"],"created_at":"2026-09-14T04:22:24Z","created_by_operation":"op_3f0ec349a8ce4f3a950726d28a52970a","id":"pg_c4d72c023cfb59088c3cef8e7393a903","maturity":"draft","page_type":"source","path":"pages/sources/sondera-ai-sondera-coding-agent-hooks-docs-deployment-md-9efefedd249e-ef8e7393a903.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_fa7cb92e480157b48a7e8c3e9b4754f4"],"title":"sondera-ai/sondera-coding-agent-hooks/docs/deployment.md @ 9efefedd249e","updated_at":"2026-09-14T04:22:24Z","updated_by_operation":"op_3f0ec349a8ce4f3a950726d28a52970a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_62c117de4ded26410eb724f0fcc8271166c43e9219430589de5e69647fb51b55"],"opposing_claim_ids":[],"text":"The signature engine and Cedar policies run with no external dependencies or API keys; the optional LLM classifiers support Ollama (the default when enabled), OpenAI-compatible servers, Anthropic, Gemini, and Vertex AI via Application Default Credentials."},{"claim_ids":["clm_7a57cadd1c414fb6b86affaf23659e238323b1f38ce4fc1872cd33a8db67904e"],"opposing_claim_ids":[],"text":"Enforcement hooks fail closed: a hook that cannot reach the harness denies preventive events and never proceeds unadjudicated, so losing the server blocks the agent rather than ungoverning it."},{"claim_ids":["clm_9199d2916301eb69ee465747887bbc77c211d10431e79444f9d89588f0caa566"],"opposing_claim_ids":[],"text":"The project targets AI coding agents — Claude Code, Cursor, GitHub Copilot, and Gemini CLI, plus adapters for Antigravity, Codex, Hermes, OpenCode, OpenHands, and VS Code — intercepting shell commands, file operations, and web requests."},{"claim_ids":["clm_f550331e2cdc019645cd24aa3e4dbd228fbc6d345391de39c7ca3e2ae8054b5e"],"opposing_claim_ids":[],"text":"Adapters can act on decisions as block (deny, fail-closed), ask (escalate to the host approval UI), steer (inject context), redact (replace tool output), terminate (stop the loop), or observe only, with capability varying per adapter and hook group."}],"claim_ids":["clm_62c117de4ded26410eb724f0fcc8271166c43e9219430589de5e69647fb51b55","clm_7a57cadd1c414fb6b86affaf23659e238323b1f38ce4fc1872cd33a8db67904e","clm_9199d2916301eb69ee465747887bbc77c211d10431e79444f9d89588f0caa566","clm_f550331e2cdc019645cd24aa3e4dbd228fbc6d345391de39c7ca3e2ae8054b5e"],"created_at":"2026-09-14T04:22:24Z","created_by_operation":"op_3f0ec349a8ce4f3a950726d28a52970a","id":"pg_eea2524bb68e5fd6ab357fc33ba8bd76","maturity":"draft","page_type":"source","path":"pages/sources/sondera-ai-sondera-coding-agent-hooks-readme-md-9efefedd249e-7fc33ba8bd76.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_37fbb8c2c9bb5d9790b97afd84976bce"],"title":"sondera-ai/sondera-coding-agent-hooks/README.md @ 9efefedd249e","updated_at":"2026-09-14T04:22:24Z","updated_by_operation":"op_3f0ec349a8ce4f3a950726d28a52970a"}
