{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_4cd559c4d37f7b31d55bc60a124f4be607ba8d2d61d3660365123c91cf0b72ff"],"opposing_claim_ids":[],"text":"Rules are authored in a unified markdown format under sources/ and converted into formats for popular coding agents, with release automation packaging them into downloadable ZIP files."},{"claim_ids":["clm_694d417a16147dac3ac8862a927bde8dc17ce142db50b4f7251776010f0f37be"],"opposing_claim_ids":[],"text":"The repository includes an MCP server exposing all CodeGuard security rules as tools over streamable HTTP, intended for centrally managed organizational deployment."},{"claim_ids":["clm_75764dceece35120dbf9c508f04fa6134fa903b83569597367b3b36ecd785ca7"],"opposing_claim_ids":[],"text":"Security coverage spans cryptography (including post-quantum), input validation, authentication, authorization, supply chain, cloud, platform, and data protection domains."},{"claim_ids":["clm_a877599d9782f092e4eec24664d71dd408106ac3c0a6eca7cb12254f9cda6e10"],"opposing_claim_ids":[],"text":"CodeGuard targets AI coding agents (Cursor, GitHub Copilot, Codex, Windsurf, Claude Code) across the lifecycle: planning, generation, and post-generation review."},{"claim_ids":["clm_fc705a39fb7accdf4412b6178f7df9972644e53ab59822bb342c00fa8d0b46e6"],"opposing_claim_ids":[],"text":"Project CodeGuard is described as an AI model-agnostic security coding agent skills framework embedding secure-by-default practices into AI coding workflows, part of the CoSAI coalition's work as an OASIS Open Project."}],"claim_ids":["clm_4cd559c4d37f7b31d55bc60a124f4be607ba8d2d61d3660365123c91cf0b72ff","clm_694d417a16147dac3ac8862a927bde8dc17ce142db50b4f7251776010f0f37be","clm_75764dceece35120dbf9c508f04fa6134fa903b83569597367b3b36ecd785ca7","clm_a877599d9782f092e4eec24664d71dd408106ac3c0a6eca7cb12254f9cda6e10","clm_fc705a39fb7accdf4412b6178f7df9972644e53ab59822bb342c00fa8d0b46e6"],"created_at":"2026-09-14T03:43:13Z","created_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f","id":"pg_1709c83ad4f153bba597a5a56671c2fb","maturity":"draft","page_type":"source","path":"pages/sources/cosai-oasis-project-codeguard-readme-md-d6a04cc5bfee-a5a56671c2fb.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_fecb4bafc1ec58fe8568d2268626c63d"],"title":"cosai-oasis/project-codeguard/README.md @ d6a04cc5bfee","updated_at":"2026-09-14T03:43:13Z","updated_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_36553331b809a8cfe81c88d6ab9a19f9074d60272b6b1c75c48498fb368e43ba"],"opposing_claim_ids":[],"text":"The reviewer emits SARIF 2.1.0 with tool.driver.name 'CodeGuard Security Reviewer', results only for confirmed or needs-human findings, and levels error/warning/note by rule class."},{"claim_ids":["clm_8a55c901cda20b01b387509e0a7e1c2597ebadfa19ff5dd2391105469ed9967d"],"opposing_claim_ids":[],"text":"The reviewer subagent is emitted for Claude Code, Cursor, OpenCode, GitHub Copilot/VS Code, and OpenAI Codex, each with a host-specific agent file location."},{"claim_ids":["clm_901b85e56a13136c81532b0aaaf29a859c412a6c3ec3ad3809dd58891965f497"],"opposing_claim_ids":[],"text":"The reviewer classifies candidates as confirmed, needs-human, or false-positive; false positives are excluded from SARIF with a one-line justification in the summary."},{"claim_ids":["clm_bdfa070413e1c4c0946c7b098f942851d8983384d5360707d9c764b0c0bf1a81"],"opposing_claim_ids":[],"text":"The reviewer treats repository content as untrusted data, ignores embedded instructions, never executes discovered code, and redacts suspected credential values from SARIF and summary output."},{"claim_ids":["clm_d4367bed3d54835f86da39fe312e5d9f78c93bd3e12d3fbd3a17241e88a952ec"],"opposing_claim_ids":[],"text":"The CodeGuard Reviewer is designed for on-demand security scans only and does not activate for general code writing or editing."},{"claim_ids":["clm_e06599c6414020a13ab2ec67eda6ebc502b08b9f99a0c51ec8637e367dc05765"],"opposing_claim_ids":[],"text":"A CodeGuard Reviewer subagent performs full-repository security scans against all CodeGuard rules and emits findings as a SARIF 2.1.0 file, writing only that output file."}],"claim_ids":["clm_36553331b809a8cfe81c88d6ab9a19f9074d60272b6b1c75c48498fb368e43ba","clm_8a55c901cda20b01b387509e0a7e1c2597ebadfa19ff5dd2391105469ed9967d","clm_901b85e56a13136c81532b0aaaf29a859c412a6c3ec3ad3809dd58891965f497","clm_bdfa070413e1c4c0946c7b098f942851d8983384d5360707d9c764b0c0bf1a81","clm_d4367bed3d54835f86da39fe312e5d9f78c93bd3e12d3fbd3a17241e88a952ec","clm_e06599c6414020a13ab2ec67eda6ebc502b08b9f99a0c51ec8637e367dc05765"],"created_at":"2026-09-14T03:43:13Z","created_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f","id":"pg_6ed35f21598753f4823dd05a495fdd04","maturity":"draft","page_type":"source","path":"pages/sources/cosai-oasis-project-codeguard-docs-codeguard-reviewer-md-d6a04cc5bfee-d05a495fdd04.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a4c33231c3aa556c87fced2ff025be46"],"title":"cosai-oasis/project-codeguard/docs/codeguard-reviewer.md @ d6a04cc5bfee","updated_at":"2026-09-14T03:43:13Z","updated_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f"}
