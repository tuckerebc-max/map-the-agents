{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7a71a86e32d0ac7f56fbd36f57b6302de1830f9439bede52d16049723e6d7009"],"opposing_claim_ids":[],"text":"Two authored skills ship in sources/skills/: security-review (full codebase review producing a structured markdown report) and memory-safe-migration (guided C/C++ migration to a memory-safe language)."}],"claim_ids":["clm_7a71a86e32d0ac7f56fbd36f57b6302de1830f9439bede52d16049723e6d7009"],"created_at":"2026-09-14T03:43:13Z","created_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f","id":"pg_a3fe2f4d9c685e57b06ee1e8c5fa0470","maturity":"draft","page_type":"source","path":"pages/sources/cosai-oasis-project-codeguard-docs-skills-md-d6a04cc5bfee-e1e8c5fa0470.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5c4e949799935cbdbbd5f982d22bce7f"],"title":"cosai-oasis/project-codeguard/docs/skills.md @ d6a04cc5bfee","updated_at":"2026-09-14T03:43:13Z","updated_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0ac5bb0279d411f56f19f4c8753eee832f9385e3ecab59be1b2cbb7317e67ded"],"opposing_claim_ids":[],"text":"The Codex plugin intentionally packages only ./skills/, excluding sources/skills/, the reviewer agent, hooks, and the MCP server, which are available via other install routes."},{"claim_ids":["clm_f046c7b617822bc55d705aacb4ea52f9cbc71ea8b75f23c302f9aa933421d757"],"opposing_claim_ids":[],"text":"The Codex plugin route requires Codex CLI 0.142.0 or newer, the version that added marketplace plugin support with repository-root source, the layout this repository uses."}],"claim_ids":["clm_0ac5bb0279d411f56f19f4c8753eee832f9385e3ecab59be1b2cbb7317e67ded","clm_f046c7b617822bc55d705aacb4ea52f9cbc71ea8b75f23c302f9aa933421d757"],"created_at":"2026-09-14T03:43:13Z","created_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f","id":"pg_e58798cef5a754bc83203b463474c0a6","maturity":"draft","page_type":"source","path":"pages/sources/cosai-oasis-project-codeguard-docs-codex-skill-plugin-md-d6a04cc5bfee-3b463474c0a6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dfac86b5bd0b55ce8f6bc3b9e09bb396"],"title":"cosai-oasis/project-codeguard/docs/codex-skill-plugin.md @ d6a04cc5bfee","updated_at":"2026-09-14T03:43:13Z","updated_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_10dc9805950b6b976da0fc3073627c06e84f07733e027a97ede1df3cea651541"],"opposing_claim_ids":[],"text":"Repository development practice: contributors regenerate the plugin with 'uv run python src/convert_to_ide_formats.py', which converts sources/ rules into skills/ (core rules only) and dist/ formats."},{"claim_ids":["clm_159bc845ff0e7b1800ed47f647043e4874ff29f6202a0e0b80ab97140f75a83e"],"opposing_claim_ids":[],"text":"The skill follows a 3-step workflow: initial security check to identify applicable rules, code generation with secure-by-default patterns, and a security review against rule checklists."},{"claim_ids":["clm_30c717e7b61016c2b6eaa07eb77151d38f5bfe984572972ab9a7a96873ac2987"],"opposing_claim_ids":[],"text":"CodeGuard ships 23 security rule files: 3 always-apply rules (hardcoded credentials, crypto algorithms, digital certificates) and 20 context-specific rules selected by language, framework, or feature."},{"claim_ids":["clm_4cd559c4d37f7b31d55bc60a124f4be607ba8d2d61d3660365123c91cf0b72ff"],"opposing_claim_ids":[],"text":"Rules are authored in a unified markdown format under sources/ and converted into formats for popular coding agents, with release automation packaging them into downloadable ZIP files."},{"claim_ids":["clm_d125e13a79a4a6a65cc83d3a8653f051bcce74966508293abae3f563a98204cf"],"opposing_claim_ids":[],"text":"Licensing is split: rules are CC BY 4.0 and tools are Apache License 2.0."},{"claim_ids":["clm_d6cd8e0597c3d2854cc1d0ae62042830afb1ddbc9c5047b4c9757796e3eb3622"],"opposing_claim_ids":[],"text":"The Claude Code skill activates automatically when writing or reviewing code, implementing security-sensitive features, handling user input or credentials, or configuring cloud infrastructure."},{"claim_ids":["clm_f23a1d16b1d66a36951885b38e2adb4ae72d8d149ac22c9feefece6d9fabc6e9"],"opposing_claim_ids":[],"text":"Repository development practice: local plugin testing is done via 'claude --plugin-dir .' after regeneration, with /reload-plugins to pick up regenerated files in a running session."}],"claim_ids":["clm_10dc9805950b6b976da0fc3073627c06e84f07733e027a97ede1df3cea651541","clm_159bc845ff0e7b1800ed47f647043e4874ff29f6202a0e0b80ab97140f75a83e","clm_30c717e7b61016c2b6eaa07eb77151d38f5bfe984572972ab9a7a96873ac2987","clm_4cd559c4d37f7b31d55bc60a124f4be607ba8d2d61d3660365123c91cf0b72ff","clm_d125e13a79a4a6a65cc83d3a8653f051bcce74966508293abae3f563a98204cf","clm_d6cd8e0597c3d2854cc1d0ae62042830afb1ddbc9c5047b4c9757796e3eb3622","clm_f23a1d16b1d66a36951885b38e2adb4ae72d8d149ac22c9feefece6d9fabc6e9"],"created_at":"2026-09-14T03:43:13Z","created_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f","id":"pg_ecf87921a80b58ba9d8ae572cdcb1373","maturity":"draft","page_type":"source","path":"pages/sources/cosai-oasis-project-codeguard-docs-claude-code-skill-plugin-md-d6a04cc-e572cdcb1373.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_09e4f5423c46575bbb5f1fe99a695f43"],"title":"cosai-oasis/project-codeguard/docs/claude-code-skill-plugin.md @ d6a04cc5bfee","updated_at":"2026-09-14T03:43:13Z","updated_by_operation":"op_2e5a33f36fb244b297be18b7ffb1052f"}
