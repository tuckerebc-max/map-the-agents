{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0a6cdbcd4247e87899182199c11af1f69428675c9f61a12bcd6317259577f95a"],"opposing_claim_ids":[],"text":"The extension offers two capture flows: Annotate mode for element-level targeting (with Shift multi-select) and Draw mode for rectangle/ellipse region annotations."}],"claim_ids":["clm_0a6cdbcd4247e87899182199c11af1f69428675c9f61a12bcd6317259577f95a"],"created_at":"2026-09-14T04:14:12Z","created_by_operation":"op_aaec4ac611bf4775b2ec00d3e2717b7f","id":"pg_4117c18b7e5859a6b2907cdabc4e0ec7","maturity":"draft","page_type":"source","path":"pages/sources/onllm-dev-onui-docs-release-md-d1a2d29677a4-7cdabc4e0ec7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_40764c213bec57ef98ab74d481717d15"],"title":"onllm-dev/onUI/docs/release.md @ d1a2d29677a4","updated_at":"2026-09-14T04:14:12Z","updated_by_operation":"op_aaec4ac611bf4775b2ec00d3e2717b7f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_41d153f34f7591ceaf331e220166e1da97b0bb3885eeb85f391f160e6373031c"],"opposing_claim_ids":[],"text":"Each annotation supports a comment, an intent (fix, change, question, approve), and a severity (blocking, important, suggestion)."},{"claim_ids":["clm_7417f873c6180d1cb2ed9b5b5e9a0c9146fb0d0338b442f30a70cef61ab41dd6"],"opposing_claim_ids":[],"text":"Exports come in four output levels (compact, standard, detailed, forensic); region annotations include shape and geometry fields in report output at detailed and forensic levels."},{"claim_ids":["clm_ddb7a23072693e7461594b65c4ba343c9e070098f80ed9b0cb8e1e3c51eb9b32"],"opposing_claim_ids":[],"text":"The extension uses Shadow DOM isolation for stable styling and per-tab ON/OFF control that is off by default; new tabs start with onUI off."},{"claim_ids":["clm_edd5867200ff4a0a80e1b74c866f7fe819ca3ba95fdd7a25cc7b8fbfa9253eab"],"opposing_claim_ids":[],"text":"In annotate mode the page freezes: scrolling is disabled and page interactions are blocked so element positions stay stable; draw mode does not freeze the page."}],"claim_ids":["clm_41d153f34f7591ceaf331e220166e1da97b0bb3885eeb85f391f160e6373031c","clm_7417f873c6180d1cb2ed9b5b5e9a0c9146fb0d0338b442f30a70cef61ab41dd6","clm_ddb7a23072693e7461594b65c4ba343c9e070098f80ed9b0cb8e1e3c51eb9b32","clm_edd5867200ff4a0a80e1b74c866f7fe819ca3ba95fdd7a25cc7b8fbfa9253eab"],"created_at":"2026-09-14T04:14:12Z","created_by_operation":"op_aaec4ac611bf4775b2ec00d3e2717b7f","id":"pg_642bf2f3251c5475a3f12b1bcf3acf90","maturity":"draft","page_type":"source","path":"pages/sources/onllm-dev-onui-docs-usage-md-d1a2d29677a4-2b1bcf3acf90.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8c541e0ed8ff54c9ba5994bc85583b17"],"title":"onllm-dev/onUI/docs/usage.md @ d1a2d29677a4","updated_at":"2026-09-14T04:14:12Z","updated_by_operation":"op_aaec4ac611bf4775b2ec00d3e2717b7f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3a547781567d5e5f8d33025c008f8a3f69e59de5abae6b6398fc7c1c9d93d0f6"],"opposing_claim_ids":[],"text":"Installer-based MCP setup uses a prebuilt release bundle and requires Node 20+; development prerequisites include Node.js 20+, pnpm 8+, and Chrome, Edge, or Firefox."},{"claim_ids":["clm_815c1dc9ce9d65ec20562d19fa0acd65d53716dd8e58d41595efe81cf6f97c2c"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run pnpm install, pnpm check, and pnpm test:coverage; docs/development.md also documents pnpm test:all and loading unpacked builds from packages/extension/dist."}],"claim_ids":["clm_3a547781567d5e5f8d33025c008f8a3f69e59de5abae6b6398fc7c1c9d93d0f6","clm_815c1dc9ce9d65ec20562d19fa0acd65d53716dd8e58d41595efe81cf6f97c2c"],"created_at":"2026-09-14T04:14:12Z","created_by_operation":"op_aaec4ac611bf4775b2ec00d3e2717b7f","id":"pg_6b4b575a1b9050b0be593e9c3897a4a9","maturity":"draft","page_type":"source","path":"pages/sources/onllm-dev-onui-docs-development-md-d1a2d29677a4-3e9c3897a4a9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_dd8074a330dc506eae020c908ccbced3"],"title":"onllm-dev/onUI/docs/development.md @ d1a2d29677a4","updated_at":"2026-09-14T04:14:12Z","updated_by_operation":"op_aaec4ac611bf4775b2ec00d3e2717b7f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0a6cdbcd4247e87899182199c11af1f69428675c9f61a12bcd6317259577f95a"],"opposing_claim_ids":[],"text":"The extension offers two capture flows: Annotate mode for element-level targeting (with Shift multi-select) and Draw mode for rectangle/ellipse region annotations."},{"claim_ids":["clm_3a547781567d5e5f8d33025c008f8a3f69e59de5abae6b6398fc7c1c9d93d0f6"],"opposing_claim_ids":[],"text":"Installer-based MCP setup uses a prebuilt release bundle and requires Node 20+; development prerequisites include Node.js 20+, pnpm 8+, and Chrome, Edge, or Firefox."},{"claim_ids":["clm_59e67ac1078bfe3977e33549522ae908ba9cc9f48ac24f4303a6ad9ea8dbe296"],"opposing_claim_ids":[],"text":"onUI ships as a lightweight browser extension for Chrome, Edge, and Firefox plus a local MCP bridge for annotation-first UI pair programming."},{"claim_ids":["clm_7417f873c6180d1cb2ed9b5b5e9a0c9146fb0d0338b442f30a70cef61ab41dd6"],"opposing_claim_ids":[],"text":"Exports come in four output levels (compact, standard, detailed, forensic); region annotations include shape and geometry fields in report output at detailed and forensic levels."},{"claim_ids":["clm_815c1dc9ce9d65ec20562d19fa0acd65d53716dd8e58d41595efe81cf6f97c2c"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run pnpm install, pnpm check, and pnpm test:coverage; docs/development.md also documents pnpm test:all and loading unpacked builds from packages/extension/dist."},{"claim_ids":["clm_b078dcab1d17214f58df8e8bf2fd5b882b441175fa19dabb4f67a830194f54a2"],"opposing_claim_ids":[],"text":"The MCP server is registered as 'onui-local' and runs via node on the onui-cli.js entrypoint; setup auto-registers it for Claude Code and Codex when those CLIs are installed."},{"claim_ids":["clm_d73add54cd0a6bd30cc47dd6a09c250cbc0a73ecfd8719c5027999e90e5cb955"],"opposing_claim_ids":[],"text":"The repository has three packages: core (shared annotation/report types and formatters), extension (background/content/popup runtime), and mcp-server (local MCP server plus native bridge setup/doctor tooling)."},{"claim_ids":["clm_ddb7a23072693e7461594b65c4ba343c9e070098f80ed9b0cb8e1e3c51eb9b32"],"opposing_claim_ids":[],"text":"The extension uses Shadow DOM isolation for stable styling and per-tab ON/OFF control that is off by default; new tabs start with onUI off."},{"claim_ids":["clm_f7663ba5f01ce5b5896cdbd11c320dbee34d4dfc5d4db951277488eefbede05a"],"opposing_claim_ids":[],"text":"Repository development practice: releases run locally via app.sh with no CI/CD dependency; --release gates on a clean tree, main branch, and gh auth, then bumps, tags, and publishes a GitHub release."}],"claim_ids":["clm_0a6cdbcd4247e87899182199c11af1f69428675c9f61a12bcd6317259577f95a","clm_3a547781567d5e5f8d33025c008f8a3f69e59de5abae6b6398fc7c1c9d93d0f6","clm_59e67ac1078bfe3977e33549522ae908ba9cc9f48ac24f4303a6ad9ea8dbe296","clm_7417f873c6180d1cb2ed9b5b5e9a0c9146fb0d0338b442f30a70cef61ab41dd6","clm_815c1dc9ce9d65ec20562d19fa0acd65d53716dd8e58d41595efe81cf6f97c2c","clm_b078dcab1d17214f58df8e8bf2fd5b882b441175fa19dabb4f67a830194f54a2","clm_d73add54cd0a6bd30cc47dd6a09c250cbc0a73ecfd8719c5027999e90e5cb955","clm_ddb7a23072693e7461594b65c4ba343c9e070098f80ed9b0cb8e1e3c51eb9b32","clm_f7663ba5f01ce5b5896cdbd11c320dbee34d4dfc5d4db951277488eefbede05a"],"created_at":"2026-09-14T04:14:12Z","created_by_operation":"op_aaec4ac611bf4775b2ec00d3e2717b7f","id":"pg_8979cadc2b2853a1a619995f90f4e80f","maturity":"draft","page_type":"source","path":"pages/sources/onllm-dev-onui-readme-md-d1a2d29677a4-995f90f4e80f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_43bf6560eba85ead8b03c259c1eb56e5"],"title":"onllm-dev/onUI/README.md @ d1a2d29677a4","updated_at":"2026-09-14T04:14:12Z","updated_by_operation":"op_aaec4ac611bf4775b2ec00d3e2717b7f"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0a6cdbcd4247e87899182199c11af1f69428675c9f61a12bcd6317259577f95a"],"opposing_claim_ids":[],"text":"The extension offers two capture flows: Annotate mode for element-level targeting (with Shift multi-select) and Draw mode for rectangle/ellipse region annotations."},{"claim_ids":["clm_225e4bbd78c8649ca64eed9b8a3d919b76d49cd7fc23ad50541212e38c6c4baf"],"opposing_claim_ids":[],"text":"The local MCP server exposes eight tools: onui_list_pages, onui_get_annotations, onui_get_report, onui_search_annotations, onui_update_annotation_metadata, onui_bulk_update_annotation_metadata, onui_delete_annotation, and onui_clear_page_annotations."},{"claim_ids":["clm_7417f873c6180d1cb2ed9b5b5e9a0c9146fb0d0338b442f30a70cef61ab41dd6"],"opposing_claim_ids":[],"text":"Exports come in four output levels (compact, standard, detailed, forensic); region annotations include shape and geometry fields in report output at detailed and forensic levels."},{"claim_ids":["clm_b078dcab1d17214f58df8e8bf2fd5b882b441175fa19dabb4f67a830194f54a2"],"opposing_claim_ids":[],"text":"The MCP server is registered as 'onui-local' and runs via node on the onui-cli.js entrypoint; setup auto-registers it for Claude Code and Codex when those CLIs are installed."}],"claim_ids":["clm_0a6cdbcd4247e87899182199c11af1f69428675c9f61a12bcd6317259577f95a","clm_225e4bbd78c8649ca64eed9b8a3d919b76d49cd7fc23ad50541212e38c6c4baf","clm_7417f873c6180d1cb2ed9b5b5e9a0c9146fb0d0338b442f30a70cef61ab41dd6","clm_b078dcab1d17214f58df8e8bf2fd5b882b441175fa19dabb4f67a830194f54a2"],"created_at":"2026-09-14T04:14:12Z","created_by_operation":"op_aaec4ac611bf4775b2ec00d3e2717b7f","id":"pg_b859f8d9307e57248c5c5b47829aa67d","maturity":"draft","page_type":"source","path":"pages/sources/onllm-dev-onui-docs-mcp-setup-md-d1a2d29677a4-5b47829aa67d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a3e1d54b23c2580ab58d61d65e2b1889"],"titl