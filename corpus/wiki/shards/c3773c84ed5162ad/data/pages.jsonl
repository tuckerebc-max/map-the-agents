{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_c6a2d9d2b1788e90147936eebd885332bc0b7a292aa5d66e87d8dd8d5cecb631"],"opposing_claim_ids":[],"text":"Sessions are persisted as JSONL files, and a changelog entry says SessionManager is integrated with CodingAgent so history is auto-restored and persisted during generate() and stream()."}],"claim_ids":["clm_c6a2d9d2b1788e90147936eebd885332bc0b7a292aa5d66e87d8dd8d5cecb631"],"created_at":"2026-09-14T02:16:18Z","created_by_operation":"op_aaf441acb38645dd8a67821f3a5a14df","id":"pg_aee6a2fab1a456a59827543085014a27","maturity":"draft","page_type":"source","path":"pages/sources/marcusschiesser-edge-pi-docs-changelog-md-c4b694c4abb1-543085014a27.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d2fb357849ac554b942a7d1adb6d182e"],"title":"marcusschiesser/edge-pi/docs/CHANGELOG.md @ c4b694c4abb1","updated_at":"2026-09-14T02:16:18Z","updated_by_operation":"op_aaf441acb38645dd8a67821f3a5a14df"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_014ed5aa1174708bc93fcb7593ee46bb4fcafd84f05c3588dd31c34f9d6886bc"],"opposing_claim_ids":[],"text":"Repository development practice: the README documents dev commands including npm install, build, check, ./test.sh (which skips LLM-dependent tests without API keys), and ./epi.sh from the repo root."},{"claim_ids":["clm_1ac1c5cf9b9d4c67b5cd3b6deaeeb5e25f2c5dde1ae1ab2abdb76107eb6ba8bf"],"opposing_claim_ids":[],"text":"The codebase is based on the pi coding agent by Mario Zechner, and the SDK is intentionally minimal with features that don't belong there directed to the CLI."},{"claim_ids":["clm_633f2cbdd6d69285ebc9e8a15677228e1bae2ad5a90fc9e5498d7b09e26f8de8"],"opposing_claim_ids":[],"text":"The `epi` CLI is a full-featured coding agent with multi-provider support and skills, described as a proof of concept for using the SDK."},{"claim_ids":["clm_be80024b9d295bc38041217eccdd4eae86261657a919461c580876ad7d6c955a"],"opposing_claim_ids":[],"text":"The project positions itself as an open replacement for Anthropic's proprietary Claude Agent SDK, working with any LLM provider via the Vercel AI SDK."},{"claim_ids":["clm_d4917f5b93f267eb7f12d19d69c5f015b87b5f82a279fe6d06a61aa9516e2da7"],"opposing_claim_ids":[],"text":"The CLI is installed globally via `npm install -g edge-pi-cli` and run with the `epi` command, with `epi --help` for more information."},{"claim_ids":["clm_d874e68176a02760795f9054c986e252f513ceff1eb8f6955ed19524d1a8560e"],"opposing_claim_ids":[],"text":"Edge-Pi is a lightweight coding agent library built on the Vercel AI SDK, providing primitives for tool support, session management, and context compaction."}],"claim_ids":["clm_014ed5aa1174708bc93fcb7593ee46bb4fcafd84f05c3588dd31c34f9d6886bc","clm_1ac1c5cf9b9d4c67b5cd3b6deaeeb5e25f2c5dde1ae1ab2abdb76107eb6ba8bf","clm_633f2cbdd6d69285ebc9e8a15677228e1bae2ad5a90fc9e5498d7b09e26f8de8","clm_be80024b9d295bc38041217eccdd4eae86261657a919461c580876ad7d6c955a","clm_d4917f5b93f267eb7f12d19d69c5f015b87b5f82a279fe6d06a61aa9516e2da7","clm_d874e68176a02760795f9054c986e252f513ceff1eb8f6955ed19524d1a8560e"],"created_at":"2026-09-14T02:16:18Z","created_by_operation":"op_aaf441acb38645dd8a67821f3a5a14df","id":"pg_d70589191d0d5d64a7931430b83a884e","maturity":"draft","page_type":"source","path":"pages/sources/marcusschiesser-edge-pi-readme-md-c4b694c4abb1-1430b83a884e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2935ea53bbdb5469b681a0d0b3e804de"],"title":"marcusschiesser/edge-pi/README.md @ c4b694c4abb1","updated_at":"2026-09-14T02:16:18Z","updated_by_operation":"op_aaf441acb38645dd8a67821f3a5a14df"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_19fb234177892fa52e4e056ef848616f55fcbef6538e7a1f3fd6be16cd5517dd"],"opposing_claim_ids":[],"text":"Repository development practice: first-time contributors must open an issue and receive a maintainer `lgtm` approval before submitting PRs, a gate intended to filter low-quality AI-generated contributions."},{"claim_ids":["clm_1ac1c5cf9b9d4c67b5cd3b6deaeeb5e25f2c5dde1ae1ab2abdb76107eb6ba8bf"],"opposing_claim_ids":[],"text":"The codebase is based on the pi coding agent by Mario Zechner, and the SDK is intentionally minimal with features that don't belong there directed to the CLI."},{"claim_ids":["clm_798cef45b4812898f3a82990ee0af671fe2e90a2626afcd1069029f3e404b123"],"opposing_claim_ids":[],"text":"Repository development practice: PRs require `npm run check` and `./test.sh` to pass, and contributors must not edit CHANGELOG.md files."}],"claim_ids":["clm_19fb234177892fa52e4e056ef848616f55fcbef6538e7a1f3fd6be16cd5517dd","clm_1ac1c5cf9b9d4c67b5cd3b6deaeeb5e25f2c5dde1ae1ab2abdb76107eb6ba8bf","clm_798cef45b4812898f3a82990ee0af671fe2e90a2626afcd1069029f3e404b123"],"created_at":"2026-09-14T02:16:18Z","created_by_operation":"op_aaf441acb38645dd8a67821f3a5a14df","id":"pg_ec76ddb1ff08579992877a6ef14b0437","maturity":"draft","page_type":"source","path":"pages/sources/marcusschiesser-edge-pi-contributing-md-c4b694c4abb1-7a6ef14b0437.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_44b022171e6a5d589d0dd7f5b44f44c9"],"title":"marcusschiesser/edge-pi/CONTRIBUTING.md @ c4b694c4abb1","updated_at":"2026-09-14T02:16:18Z","updated_by_operation":"op_aaf441acb38645dd8a67821f3a5a14df"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_23fc9875d2e536a0021c76d856a7548e540004ef8e3b90fccbfdcbea24d96743"],"opposing_claim_ids":[],"text":"Repository development practice: parallel agents must stage only their own files with explicit paths, never use `git add -A`, and avoid destructive commands like `git reset --hard` or `git stash`."},{"claim_ids":["clm_3190afb783f44a3eb2985ee3cc353803ef9af2a39b57c3ba098855c90129f2dc"],"opposing_claim_ids":[],"text":"Repository development practice: AGENTS.md forbids running `npm run dev`, `npm run build`, or `npm test`, requires `npm run check` after code changes, and forbids committing unless the user asks."},{"claim_ids":["clm_4cbd1e6ec2e2d69019d4a124f1955aaa9cf52ad885e123bfea8e2fad296f78e0"],"opposing_claim_ids":[],"text":"Repository development practice: releases use Changesets with lockstep versioning via fixed groups, using `npm run changeset`, `npm run version`, and `npm run release`."}],"claim_ids":["clm_23fc9875d2e536a0021c76d856a7548e540004ef8e3b90fccbfdcbea24d96743","clm_3190afb783f44a3eb2985ee3cc353803ef9af2a39b57c3ba098855c90129f2dc","clm_4cbd1e6ec2e2d69019d4a124f1955aaa9cf52ad885e123bfea8e2fad296f78e0"],"created_at":"2026-09-14T02:16:18Z","created_by_operation":"op_aaf441acb38645dd8a67821f3a5a14df","id":"pg_ffbb26206a3a58ffb0f3d071c046017c","maturity":"draft","page_type":"source","path":"pages/sources/marcusschiesser-edge-pi-agents-md-c4b694c4abb1-d071c046017c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c32bc15fefff5c039ea319078f183c7c"],"title":"marcusschiesser/edge-pi/AGENTS.md @ c4b694c4abb1","updated_at":"2026-09-14T02:16:18Z","updated_by_operation":"op_aaf441acb38645dd8a67821f3a5a14df"}
