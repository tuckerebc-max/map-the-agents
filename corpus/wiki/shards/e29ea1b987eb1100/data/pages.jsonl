{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_441bb8d3aae0ded0e5e692cea0e755e043df96883f1a68d2f22e70ace77dd602"],"opposing_claim_ids":[],"text":"Repository development practice: fixture tests follow a setup-execute-validation-cleanup flow, comparing transformed files, stdout, and stderr against expected outputs, with approval commands like npm run test:fixture:approve."}],"claim_ids":["clm_441bb8d3aae0ded0e5e692cea0e755e043df96883f1a68d2f22e70ace77dd602"],"created_at":"2026-09-14T03:47:03Z","created_by_operation":"op_3123bdc6708448ad8c302eb181c03c31","id":"pg_16e0f76dee5a59d0a37dedff92d0d7bd","maturity":"draft","page_type":"source","path":"pages/sources/devill-refakts-docs-fixture-testing-strategy-for-refactoring-tools-md--edff92d0d7bd.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_38f3a162065c5b6c82185fb999410b33"],"title":"devill/refakts/docs/FIXTURE_TESTING_STRATEGY_FOR_REFACTORING_TOOLS.md @ 2ff430870b04","updated_at":"2026-09-14T03:47:03Z","updated_by_operation":"op_3123bdc6708448ad8c302eb181c03c31"}
