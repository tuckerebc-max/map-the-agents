db7e43c56"],"created_at":"2026-09-14T02:08:03Z","created_by_operation":"op_64b3c97f34854c8195b101fcf5a29395","id":"pg_46bdd9ba78cc5b5185e69ccd3bd67d35","maturity":"draft","page_type":"entity","path":"pages/entities/johannesjo-parallel-code-9ccd3bd67d35.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"johannesjo/parallel-code","updated_at":"2026-09-14T02:08:03Z","updated_by_operation":"op_64b3c97f34854c8195b101fcf5a29395"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_22f74dcbf6c53684e87c026d3ee5be369afb17982095e825a3530efc059c8f3f"],"opposing_claim_ids":[],"text":"A Remote Access feature lets users monitor agents from a phone over Wi-Fi or Tailscale, with a QR code and a bearer-token URL."},{"claim_ids":["clm_283576c4aa8f14915a2a84d12289afef600dc423f21f68aa9b94a2a677f82b7d"],"opposing_claim_ids":[],"text":"The app is an Electron desktop application with a SolidJS frontend and Node.js backend, published for macOS and Linux only."},{"claim_ids":["clm_53ae285956b82072ca1fe3b506900271a7257e9aa73b65ca5a7dfa5d32f8e013"],"opposing_claim_ids":[],"text":"The app drives third-party AI coding CLIs the user installs, including Claude Code, Codex CLI, Gemini CLI, Copilot CLI, OpenCode, and Antigravity CLI."},{"claim_ids":["clm_72f59418d199e11afc95b9ca72f1a26ebc2309470764767d0ea2cad599b6df73"],"opposing_claim_ids":[],"text":"Features include a built-in diff viewer with inline comments, per-task notes and canvas panels, per-task shell terminals, and an AI Arena head-to-head mode."},{"claim_ids":["clm_81afef8ab67605a23ddc57c61dd8162fb3128dfeee2af639e39f30ed6cca16bf"],"opposing_claim_ids":[],"text":"Creating a task makes a git branch from main, sets up a git worktree, symlinks gitignored directories like node_modules, and spawns the AI agent there."},{"claim_ids":["clm_96f12013c26700ba4c7f918c1b962974666d87a1d880ef8a9f7ebc573f1b99a7"],"opposing_claim_ids":[],"text":"Docker-isolated Antigravity tasks cannot authenticate because the OS keyring is unreachable in the container and agy has no API-key fallback; Antigravity must run natively."},{"claim_ids":["clm_b2e4d1071d043078adbf31239e8fb9ee674b4f2ea750baba45b6af453d12f158"],"opposing_claim_ids":[],"text":"Repository development practice: build from source with git clone, npm install, and npm run dev, requiring Node.js v18+; npm run typecheck runs TypeScript checking."},{"claim_ids":["clm_b712e829105fa8bd9e8fe7488e392198c07fc5406c14cf43fc03b9a70b34d074"],"opposing_claim_ids":[],"text":"Completed task branches can be merged back to main from the sidebar."},{"claim_ids":["clm_f300bb4f3514101b80124c4876dabc1cc6bbf57cbb6bf4929dd17a5db7e43c56"],"opposing_claim_ids":[],"text":"Docker sandboxing is supported via a project-specific Dockerfile placed at .parallel-code/Dockerfile, in which tasks then run."}],"claim_ids":["clm_22f74dcbf6c53684e87c026d3ee5be369afb17982095e825a3530efc059c8f3f","clm_283576c4aa8f14915a2a84d12289afef600dc423f21f68aa9b94a2a677f82b7d","clm_53ae285956b82072ca1fe3b506900271a7257e9aa73b65ca5a7dfa5d32f8e013","clm_72f59418d199e11afc95b9ca72f1a26ebc2309470764767d0ea2cad599b6df73","clm_81afef8ab67605a23ddc57c61dd8162fb3128dfeee2af639e39f30ed6cca16bf","clm_96f12013c26700ba4c7f918c1b962974666d87a1d880ef8a9f7ebc573f1b99a7","clm_b2e4d1071d043078adbf31239e8fb9ee674b4f2ea750baba45b6af453d12f158","clm_b712e829105fa8bd9e8fe7488e392198c07fc5406c14cf43fc03b9a70b34d074","clm_f300bb4f3514101b80124c4876dabc1cc6bbf57cbb6bf4929dd17a5db7e43c56"],"created_at":"2026-09-14T02:08:03Z","created_by_operation":"op_64b3c97f34854c8195b101fcf5a29395","id":"pg_56c8c82208365b67b027548af8fce660","maturity":"draft","page_type":"source","path":"pages/sources/johannesjo-parallel-code-readme-md-dcc4df2592cc-548af8fce660.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5b53695222c1574c8ded7fe1d47c8ce0"],"title":"johannesjo/parallel-code/README.md @ dcc4df2592cc","updated_at":"2026-09-14T02:08:03Z","updated_by_operation":"op_64b3c97f34854c8195b101fcf5a29395"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_034596303c3b7bb3458bc22fc035752c046daba4c420c68ec92e64c769afa4ad"],"opposing_claim_ids":[],"text":"Repository development practice: conventions require functional SolidJS components, strict TypeScript with no any, and Electron IPC with channel names in a shared enum."},{"claim_ids":["clm_283576c4aa8f14915a2a84d12289afef600dc423f21f68aa9b94a2a677f82b7d"],"opposing_claim_ids":[],"text":"The app is an Electron desktop application with a SolidJS frontend and Node.js backend, published for macOS and Linux only."},{"claim_ids":["clm_b2e4d1071d043078adbf31239e8fb9ee674b4f2ea750baba45b6af453d12f158"],"opposing_claim_ids":[],"text":"Repository development practice: build from source with git clone, npm install, and npm run dev, requiring Node.js v18+; npm run typecheck runs TypeScript checking."}],"claim_ids":["clm_034596303c3b7bb3458bc22fc035752c046daba4c420c68ec92e64c769afa4ad","clm_283576c4aa8f14915a2a84d12289afef600dc423f21f68aa9b94a2a677f82b7d","clm_b2e4d1071d043078adbf31239e8fb9ee674b4f2ea750baba45b6af453d12f158"],"created_at":"2026-09-14T02:08:03Z","created_by_operation":"op_64b3c97f34854c8195b101fcf5a29395","id":"pg_6cc0d41e43fc5de68f96c35f28904ad0","maturity":"draft","page_type":"source","path":"pages/sources/johannesjo-parallel-code-claude-md-dcc4df2592cc-c35f28904ad0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ee68965924c45b95a7c7f2f416b03a6d"],"title":"johannesjo/parallel-code/CLAUDE.md @ dcc4df2592cc","updated_at":"2026-09-14T02:08:03Z","updated_by_operation":"op_64b3c97f34854c8195b101fcf5a29395"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_22f74dcbf6c53684e87c026d3ee5be369afb17982095e825a3530efc059c8f3f"],"opposing_claim_ids":[],"text":"A Remote Access feature lets users monitor agents from a phone over Wi-Fi or Tailscale, with a QR code and a bearer-token URL."},{"claim_ids":["clm_415590fe5241a12f44dee3661d9681e4d982609227caca07656ee5a808d39353"],"opposing_claim_ids":[],"text":"For coordinator sub-tasks, the app injects a system-prompt preamble telling the sub-agent to call the signal_done MCP tool, via .claude/settings.local.json for Claude Code."},{"claim_ids":["clm_42a3e602e587717a2f8aaa307c91c844ba18eebfa2bd91b880961d701cb2dbd8"],"opposing_claim_ids":[],"text":"State is stored locally: state.json with a rolling backup, keybindings, themes, arena files, and a .updaterId UUID in per-OS app data directories."},{"claim_ids":["clm_53ae285956b82072ca1fe3b506900271a7257e9aa73b65ca5a7dfa5d32f8e013"],"opposing_claim_ids":[],"text":"The app drives third-party AI coding CLIs the user installs, including Claude Code, Codex CLI, Gemini CLI, Copilot CLI, OpenCode, and Antigravity CLI."},{"claim_ids":["clm_5eab302eac6346d2a2bd883541f3f3306c46194eb927da63bdc2d3bdf02f1d22"],"opposing_claim_ids":[],"text":"Packaged macOS and Linux builds check GitHub Releases for updates via electron-updater, sending a stable per-install x-user-staging-id UUID to GitHub."},{"claim_ids":["clm_f300bb4f3514101b80124c4876dabc1cc6bbf57cbb6bf4929dd17a5db7e43c56"],"opposing_claim_ids":[],"text":"Docker sandboxing is supported via a project-specific Dockerfile placed at .parallel-code/Dockerfile, in which tasks then run."}],"claim_ids":["clm_22f74dcbf6c53684e87c026d3ee5be369afb17982095e825a3530efc059c8f3f","clm_415590fe5241a12f44dee3661d9681e4d982609227caca07656ee5a808d39353","clm_42a3e602e587717a2f8aaa307c91c844ba18eebfa2bd91b880961d701cb2dbd8","clm_53ae285956b82072ca1fe3b506900271a7257e9aa73b65ca5a7dfa5d32f8e013","clm_5eab302eac6346d2a2bd883541f3f3306c46194eb927da63bdc2d3b