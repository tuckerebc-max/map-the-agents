{"access":"public","created_at":"2026-09-14T02:48:49Z","created_by_operation":"op_9372a6bcf64f44f4a5ae781885ac7217","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d6d8dad287b08e63c3f61e696b03bf72e1932f058303dfc12ba6a3c1034f29a8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"asheshgoplani/agent-deck@7d2302fb8a41 snapshot 5d1b37ace8d9fdef","timeframe":null},"slice_ids":["slc_23cb215975a0046d18e607319b14f3b7dedebf55b2daed22a4c6b017f5912e96"],"source_ids":["src_f336b6278b9559e28285acfeedc96a95"],"text":"Documentation states that inheriting sparse-checkout patterns into a new worktree requires Git 2.32 or newer, while the default, non-inheriting checkout behavior carries no such version requirement.","updated_at":"2026-09-14T02:48:49Z","updated_by_operation":"op_9372a6bcf64f44f4a5ae781885ac7217"}
