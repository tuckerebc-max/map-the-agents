{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_99c495ad58d3e96f6363cb7b9519e8978b5ca003306d58725b36de290406b4fc"],"opposing_claim_ids":[],"text":"Repository development practice: development uses pnpm in a turbo workspace, with commands for install, build, typechecking (excluding apps-www), and formatting."},{"claim_ids":["clm_dae1b42c4423fa67c9b2c31f2ee4b4b9406e7fd791d3139da85ba56f531c1274"],"opposing_claim_ids":[],"text":"Repository development practice: pull requests are not accepted and are automatically closed and converted into bug reports (GitHub issues) or feature requests (discussions), with agent-oriented templates also provided."},{"claim_ids":["clm_f048794a5dae11a68df7a0b598360962742a7813ae75fb08bcacc9d22ae7ab18"],"opposing_claim_ids":[],"text":"Repository development practice: the project states no tests exist in the repo, and its contributing philosophy is an experiment applying the Surgical Team model, with agents handling design, research, implementation, and review under a lead maintainer."}],"claim_ids":["clm_99c495ad58d3e96f6363cb7b9519e8978b5ca003306d58725b36de290406b4fc","clm_dae1b42c4423fa67c9b2c31f2ee4b4b9406e7fd791d3139da85ba56f531c1274","clm_f048794a5dae11a68df7a0b598360962742a7813ae75fb08bcacc9d22ae7ab18"],"created_at":"2026-09-14T03:23:56Z","created_by_operation":"op_2890b4c1cad04b048373fb951ac27496","id":"pg_0e4bb8b8b13a5018920f43bd77b495dc","maturity":"draft","page_type":"source","path":"pages/sources/withastro-flue-agents-md-1ae1c85dae55-43bd77b495dc.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f9828f7a35275597abf02a6b3bc6e45e"],"title":"withastro/flue/AGENTS.md @ 1ae1c85dae55","updated_at":"2026-09-14T03:23:56Z","updated_by_operation":"op_2890b4c1cad04b048373fb951ac27496"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_dae1b42c4423fa67c9b2c31f2ee4b4b9406e7fd791d3139da85ba56f531c1274"],"opposing_claim_ids":[],"text":"Repository development practice: pull requests are not accepted and are automatically closed and converted into bug reports (GitHub issues) or feature requests (discussions), with agent-oriented templates also provided."},{"claim_ids":["clm_f048794a5dae11a68df7a0b598360962742a7813ae75fb08bcacc9d22ae7ab18"],"opposing_claim_ids":[],"text":"Repository development practice: the project states no tests exist in the repo, and its contributing philosophy is an experiment applying the Surgical Team model, with agents handling design, research, implementation, and review under a lead maintainer."}],"claim_ids":["clm_dae1b42c4423fa67c9b2c31f2ee4b4b9406e7fd791d3139da85ba56f531c1274","clm_f048794a5dae11a68df7a0b598360962742a7813ae75fb08bcacc9d22ae7ab18"],"created_at":"2026-09-14T03:23:56Z","created_by_operation":"op_2890b4c1cad04b048373fb951ac27496","id":"pg_98265a675b4c57b782f6d5e7c67302cf","maturity":"draft","page_type":"source","path":"pages/sources/withastro-flue-contributing-md-1ae1c85dae55-d5e7c67302cf.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_87833cb3a7ef56d7828d582cde41bb96"],"title":"withastro/flue/CONTRIBUTING.md @ 1ae1c85dae55","updated_at":"2026-09-14T03:23:56Z","updated_by_operation":"op_2890b4c1cad04b048373fb951ac27496"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0d85643aa9a1e57c9eacfcdf428c0105778f73da45c25a8f5884689154bca12d"],"opposing_claim_ids":[],"text":"The CLI exposes a `flue` binary for local runs, blueprints, and offline docs; @flue/sdk is a client SDK for consuming deployed agent conversations."},{"claim_ids":["clm_14f1267daeb9aba6d0d8d7c3057ab2b2c5453a70b8fa71beb8df5e33dbbfe526"],"opposing_claim_ids":[],"text":"The repository ships @flue/runtime (harness, sessions, tools, sandbox), @flue/vite (build plugin), @flue/cli (flue binary), @flue/sdk (client for deployed agent conversations), @flue/opentelemetry, and @flue/postgres."},{"claim_ids":["clm_16f2f5b82b5dd0c8ab65d06e539aa52ec5ea23410909087dbe525fb665cf459e"],"opposing_claim_ids":[],"text":"Documented deployment targets include Node.js, Cloudflare Workers, GitHub Actions, GitLab CI/CD, and Render; Daytona appears as a sandbox option rather than a deployment target."},{"claim_ids":["clm_2233b28f31493d43a446a1e3d3f441fd4bb6ce6be439a17d0f365e8bdf855917"],"opposing_claim_ids":[],"text":"Agents can connect to authenticated tools and services through MCP servers, and telemetry can be exported via OpenTelemetry and Braintrust."},{"claim_ids":["clm_22ba5b0dab1a2e4cfe42b86a03446c8b1391c2b0866153642af31951c89754b6"],"opposing_claim_ids":[],"text":"The framework supports subagents: specialized roles can be defined for different tasks, and the agent can delegate work to the appropriate expert."},{"claim_ids":["clm_4d8456a7bdea1e471b1eca58cea45863d16ee1800d51f7ab710dad780818adba"],"opposing_claim_ids":[],"text":"Agents keep context across conversations and events, and preserve progress through failures and restarts via durable recovery for accepted work."},{"claim_ids":["clm_74a2d79d27f90e8ae497a0c9b7b46bddf0a6411c3d1c794edb77d5c2f6605623"],"opposing_claim_ids":[],"text":"Flue positions itself as a framework for autonomous agents that receive a task rather than pre-defined steps, contrasting with agents built from raw LLM API calls."},{"claim_ids":["clm_8f4dd52f2e57e4405b71f542ad1c7ff7f0d2f534a5c10f105819d6700621cec8"],"opposing_claim_ids":[],"text":"Agents are exported TypeScript functions marked with a 'use agent' directive; hooks like useModel, useSandbox, useSkill, and useTool compose capabilities, and the function's returned string is its instruction."},{"claim_ids":["clm_cb4ba6a79e752df37187c870718302fc4d1e612ded6898a23aae7c647ca70db2"],"opposing_claim_ids":[],"text":"The built-in TypeScript harness gives models sessions, tools, skills, instructions, filesystem access, and a secure sandbox; agents run locally via CLI or deploy to a hosted runtime."}],"claim_ids":["clm_0d85643aa9a1e57c9eacfcdf428c0105778f73da45c25a8f5884689154bca12d","clm_14f1267daeb9aba6d0d8d7c3057ab2b2c5453a70b8fa71beb8df5e33dbbfe526","clm_16f2f5b82b5dd0c8ab65d06e539aa52ec5ea23410909087dbe525fb665cf459e","clm_2233b28f31493d43a446a1e3d3f441fd4bb6ce6be439a17d0f365e8bdf855917","clm_22ba5b0dab1a2e4cfe42b86a03446c8b1391c2b0866153642af31951c89754b6","clm_4d8456a7bdea1e471b1eca58cea45863d16ee1800d51f7ab710dad780818adba","clm_74a2d79d27f90e8ae497a0c9b7b46bddf0a6411c3d1c794edb77d5c2f6605623","clm_8f4dd52f2e57e4405b71f542ad1c7ff7f0d2f534a5c10f105819d6700621cec8","clm_cb4ba6a79e752df37187c870718302fc4d1e612ded6898a23aae7c647ca70db2"],"created_at":"2026-09-14T03:23:56Z","created_by_operation":"op_2890b4c1cad04b048373fb951ac27496","id":"pg_9ff093e85630550eb5bf1205f2baa894","maturity":"draft","page_type":"source","path":"pages/sources/withastro-flue-readme-md-1ae1c85dae55-1205f2baa894.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4c80b1181148552895c35aa40d72a657"],"title":"withastro/flue/README.md @ 1ae1c85dae55","updated_at":"2026-09-14T03:23:56Z","updated_by_operation":"op_2890b4c1cad04b048373fb951ac27496"}
