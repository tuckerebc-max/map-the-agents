{"access":"public","created_at":"2026-09-14T02:25:50Z","created_by_operation":"op_a17826486fe84a1b884b51352ff5dda0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ff863f7e4d7efd0d3989321d9308e4ac0d17862d80d28648d33af977834d0074","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"onecli/onecli@3e595ef04d1a snapshot 675314da46d13fff","timeframe":null},"slice_ids":["slc_af1d51ead03b99baaa0608790bc763b267aa271444a0f0df5c65297bd8043bce"],"source_ids":["src_28895cf60b2456cd95948a7a066abde7"],"text":"The platform comprises a Next.js web dashboard, an API server control plane owning the database and work queue, a Rust gateway, a runner, a sandbox supervisor, an SSH terminator, and a Slack channel adapter.","updated_at":"2026-09-14T02:25:50Z","updated_by_operation":"op_a17826486fe84a1b884b51352ff5dda0"}
