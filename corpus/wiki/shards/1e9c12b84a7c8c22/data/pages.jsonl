{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_68f56f2508ad223909bcc3801346fe66d933adeedd951e4d78e1c0da2c3dd6ef"],"opposing_claim_ids":[],"text":"Configuration resolves in a documented precedence chain: CLI flags, then process.env, workspace .env, .piclaw/config.json, and built-in defaults."}],"claim_ids":["clm_68f56f2508ad223909bcc3801346fe66d933adeedd951e4d78e1c0da2c3dd6ef"],"created_at":"2026-09-14T02:35:00Z","created_by_operation":"op_3a8907f6a1934328a4265addca1f43f9","id":"pg_0a9438ab0a755cd9a61d625167dff296","maturity":"draft","page_type":"source","path":"pages/sources/rcarmo-piclaw-docs-configuration-md-ced7c11253c3-625167dff296.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ca7e5d7b81315ef099088d51ab17e4df"],"title":"rcarmo/piclaw/docs/configuration.md @ ced7c11253c3","updated_at":"2026-09-14T02:35:00Z","updated_by_operation":"op_3a8907f6a1934328a4265addca1f43f9"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T02:35:00Z","created_by_operation":"op_3a8907f6a1934328a4265addca1f43f9","id":"pg_1dfe083aa17d5501a81d372ea8cc3020","maturity":"draft","page_type":"source","path":"pages/sources/rcarmo-piclaw-readme-zh-cn-md-ced7c11253c3-372ea8cc3020.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_19e0d03ba63c5c70b3da3858ca71a827"],"title":"rcarmo/piclaw/README.zh-CN.md @ ced7c11253c3","updated_at":"2026-09-14T02:35:00Z","updated_by_operation":"op_3a8907f6a1934328a4265addca1f43f9"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_36f444dbdfd4e8cd2f1f0464101e4a1c22e9ba4f0d0de1d141d8f82bb7a8d0da"],"opposing_claim_ids":[],"text":"Dream/AutoDream memory consolidation runs as out-of-band model turns on a temporary dream: channel and a dedicated dream:<chatJid> queue lane, so long consolidations do not block interactive chat."},{"claim_ids":["clm_5c189280901a1fd0cd1d43e4bf18c2b610a9130e95a86cfb5a497d42b1bcfb1c"],"opposing_claim_ids":[],"text":"Durable state lives in SQLite (messages, chats, tasks, configs, token usage), session trees, and a workspace holding notes, skills and files."},{"claim_ids":["clm_5e8378a6bd2fab34103934df4eaec20290c91397d58ce5f2ff3e8d5084ef6247"],"opposing_claim_ids":[],"text":"Per-chat turns use a cursor with inflight and failed markers: transient failures recover automatically, while persistent failures roll the cursor back and hold the chat for explicit retry or skip."},{"claim_ids":["clm_7fbcf5485c9cf90aed1ce709d3df7d04140a5f60641155f61f906461704a9d98"],"opposing_claim_ids":[],"text":"The runtime core comprises a router, a lane-aware AgentQueue, an AgentPool of Pi SDK AgentSessions, built-in and packaged extensions, and background workers for IPC, scheduling, and Dream memory consolidation."},{"claim_ids":["clm_99795eb62a4baa9dfbf7b3ce1daf70030f4001df8cce3935375bb78940928d98"],"opposing_claim_ids":[],"text":"Multi-user family mode is experimental: family-shared deployments share one workspace and process without filesystem isolation, isolated-container mode is unavailable, and no family-mode release gate has passed."},{"claim_ids":["clm_a384c5b7be6921687456c3a518688d235c6ce453a656fb8687c0ff554dc6627a"],"opposing_claim_ids":[],"text":"Single-user memory uses a compact notes/memory/MEMORY.md startup index (line-capped, under ~25KB) plus typed files for user, feedback, project and reference detail."},{"claim_ids":["clm_fa3e7d1dde6d50ddf70860dd3b2b54d7d695c2c7625b99fb18ef15c53972b5b7"],"opposing_claim_ids":[],"text":"Chat commands include /login for provider setup, /model for model selection, /dream for memory consolidation, /tasks and /scheduled for scheduled tasks, and /theme and /tint for UI theming."}],"claim_ids":["clm_36f444dbdfd4e8cd2f1f0464101e4a1c22e9ba4f0d0de1d141d8f82bb7a8d0da","clm_5c189280901a1fd0cd1d43e4bf18c2b610a9130e95a86cfb5a497d42b1bcfb1c","clm_5e8378a6bd2fab34103934df4eaec20290c91397d58ce5f2ff3e8d5084ef6247","clm_7fbcf5485c9cf90aed1ce709d3df7d04140a5f60641155f61f906461704a9d98","clm_99795eb62a4baa9dfbf7b3ce1daf70030f4001df8cce3935375bb78940928d98","clm_a384c5b7be6921687456c3a518688d235c6ce453a656fb8687c0ff554dc6627a","clm_fa3e7d1dde6d50ddf70860dd3b2b54d7d695c2c7625b99fb18ef15c53972b5b7"],"created_at":"2026-09-14T02:35:00Z","created_by_operation":"op_3a8907f6a1934328a4265addca1f43f9","id":"pg_5446193ca04553e98ca5b7ec396df254","maturity":"draft","page_type":"source","path":"pages/sources/rcarmo-piclaw-docs-architecture-md-ced7c11253c3-b7ec396df254.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8c786200a2e55ab5ae377ca5c031f59b"],"title":"rcarmo/piclaw/docs/architecture.md @ ced7c11253c3","updated_at":"2026-09-14T02:35:00Z","updated_by_operation":"op_3a8907f6a1934328a4265addca1f43f9"}
