{"access":"public","created_at":"2026-09-14T02:12:36Z","created_by_operation":"op_f60ceac5823a43ef90794993c02d7e75","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5a540c3290e1bd6954b0a094e070993e17536264b22f78f2b71e9b3608ef4c9d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"limecloud/lime@580022b574cb snapshot abaebea4bce76cc8","timeframe":null},"slice_ids":["slc_0936952ee68703dac752191ba3f0af146fc32814f0f33933858cb86ceb0806f2","slc_76bbfd2b5039f244857891e4c8288e5ecaec8e93c52054fbef85e824c714bb1a"],"source_ids":["src_a4fec1600b3e5d8ead39153aea525649"],"text":"FEATURE-MAP assigns ownership across crates: agent-runtime/agent for turn lifecycle and orchestration, model-provider for catalog/routing/retry, and tool-runtime for tool definitions, permissions, sandbox, dispatch, processes and MCP; the main-chain diagram lists thread-store/repository for persistence and projection.","updated_at":"2026-09-14T02:12:36Z","updated_by_operation":"op_f60ceac5823a43ef90794993c02d7e75"}
