{"access":"public","created_at":"2026-09-14T02:20:31Z","created_by_operation":"op_6cfce975fbc04bc18cf36a381084f0f0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ecf49c6fe076b578689ec5bef16e653457d1d0f10ecbcef0a3c208bdec4cf70b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"momozi1996/momo-code@6922581961d5 snapshot 870abd054af90a09","timeframe":null},"slice_ids":["slc_2777d5bf4d38a40acaf6d83f7ec2644a9ea275d3b6ca2c7ee45796a5c4d7d529","slc_8f80142bea4b996189ce1ee6af03c45ad86d67acfe6f9878e2a03b1bbddad043"],"source_ids":["src_75fc6f2327e651638ffb3f0d40ef31e4"],"text":"The /refine command reviews session trajectories and proposes tactic or prompt-patch improvements, and nothing is applied without explicit human approval via approve/apply review-gate subcommands.","updated_at":"2026-09-14T02:20:31Z","updated_by_operation":"op_6cfce975fbc04bc18cf36a381084f0f0"}
{"access":"public","created_at":"2026-09-14T02:20:31Z","created_by_operation":"op_6cfce975fbc04bc18cf36a381084f0f0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f7255d40d6ab206af355d2742af583fe5f591c86b70533defbd9722e61445080","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"momozi1996/momo-code@6922581961d5 snapshot 870abd054af90a09","timeframe":null},"slice_ids":["slc_4d958275c65abb38d19ed45e9c26efea7f4f740142ef1632c368dfb4e48f06f0","slc_606f85df02e808a967fd12ac7be976a716d6f425619b26ea6aa48f5b39aedbdb","slc_c813489e32dd5852ad70f284f08716223cc36e206d24bd2bd7525c33be6f1338"],"source_ids":["src_75fc6f2327e651638ffb3f0d40ef31e4"],"text":"The /graph command plans a directed acyclic graph of subagent tasks, runs nodes in parallel per topological level with retries and downstream dependency outputs, supports resume/status/list, and can mark nodes as simulation agents driving the Genesis world via /sim.","updated_at":"2026-09-14T02:20:31Z","updated_by_operation":"op_6cfce975fbc04bc18cf36a381084f0f0"}
{"access":"public","created_at":"2026-09-14T02:20:31Z","created_by_operation":"op_6cfce975fbc04bc18cf36a381084f0f0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f99b53b80156215ccaf5821524acac143920045a548ff550f4055c14fefc51fe","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"momozi1996/momo-code@6922581961d5 snapshot 870abd054af90a09","timeframe":null},"slice_ids":["slc_07e657c5858cc7de27b01a284170774321181251dfd9779ecb22f66f0d48f8ae","slc_09908403495e0db7a804eaa3466c933fa8f11a4c5c97523bad137c92a5f486c4","slc_d24b1fcd9eb4db9ac27233734be4f520b10181872dfc6981217290ef8bd34a02"],"source_ids":["src_75fc6f2327e651638ffb3f0d40ef31e4"],"text":"Runtime prerequisites are macOS or Linux (Windows via WSL), Node.js >= 20, git, and curl; the /sim feature additionally requires Python with genesis-world installed, and /voice requires sounddevice and scipy plus an OpenAI-compatible speech-to-text endpoint.","updated_at":"2026-09-14T02:20:31Z","updated_by_operation":"op_6cfce975fbc04bc18cf36a381084f0f0"}
