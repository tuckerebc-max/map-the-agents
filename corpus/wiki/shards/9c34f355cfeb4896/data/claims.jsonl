{"access":"public","created_at":"2026-09-14T01:34:31Z","created_by_operation":"op_986e37dd3628403bb397a26c5ff61bc7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_aaf5993a4b3597edd0cd2f965aad3650bd1ec6388497c9623d4470515d925876","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"aozyildirim/agena@63db0e2736d2 snapshot 8467f4e1626576f1","timeframe":null},"slice_ids":["slc_60db0b39519c9947de070908c4d8c2d297d2e92e8d22face8b902317ee84d27a","slc_c8230b87995fdebd78d54737fdc23c45b4405162e5a8cf575adc19c99316a59f"],"source_ids":["src_65947a6f9f935bb0bdb5fdf1ac5daad1"],"text":"Task execution flows through a Redis queue into an OrchestrationService driving a LangGraph pipeline of five nodes (fetch_context, analyze, generate_code, review_code, finalize) executed by CrewAI role agents (PM, Developer, Reviewer, Finalizer).","updated_at":"2026-09-14T04:51:13Z","updated_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6"}
{"access":"public","created_at":"2026-09-14T01:34:31Z","created_by_operation":"op_986e37dd3628403bb397a26c5ff61bc7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b598c8af998e5c25854e202d05262e15ebaddad2a384ca885ec7453e3eb71936","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"aozyildirim/agena@63db0e2736d2 snapshot 8467f4e1626576f1","timeframe":null},"slice_ids":["slc_29106d7ded96306d33a3d5cbb9520819f2708531bc832d8c9f95d75f4a52f166","slc_45b5c4230d9fe8b50f21574e8becd0cb09e48345d12e76bd3bfa56e9097b009e"],"source_ids":["src_65947a6f9f935bb0bdb5fdf1ac5daad1"],"text":"The backend is split into six pip-installable packages (core, models, services, agents, api, worker) with a layered dependency graph where agena-core has no internal deps and agena-api depends on all others.","updated_at":"2026-09-14T04:51:13Z","updated_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6"}
