{"access":"public","created_at":"2026-09-14T01:34:31Z","created_by_operation":"op_986e37dd3628403bb397a26c5ff61bc7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_0c0e273e8abdc29459867a529c6ea122dbc75f7a613167bcf34c31a45c595dc9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"aozyildirim/agena@63db0e2736d2 snapshot 8467f4e1626576f1","timeframe":null},"slice_ids":["slc_64522edb2c2b7170c0b99606f6a55e1f52ba510fe3edb25027988c5d2d29bd46","slc_ca7023aff021b1001f13f382da9d2ad2177e13e55313cf759690478f87109a53","slc_e6e56723d2da26e940376bfaa834f5e1ea72c7cb6e29c01372e0bfe07920226c"],"source_ids":["src_65947a6f9f935bb0bdb5fdf1ac5daad1"],"text":"Completed tasks are distilled into reusable skills stored as Qdrant embeddings (org-scoped, kind='skill') plus MySQL rows; before any agent runs, the top-3 skills above a relevance threshold are prepended to the system prompt.","updated_at":"2026-09-14T04:51:13Z","updated_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6"}
