{"access":"public","created_at":"2026-09-14T01:34:31Z","created_by_operation":"op_986e37dd3628403bb397a26c5ff61bc7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_59c14fef944d26c1ff1d3108a878fb90216f4c2225143e96347281e27c274c29","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"aozyildirim/agena@63db0e2736d2 snapshot 8467f4e1626576f1","timeframe":null},"slice_ids":["slc_e5226d1d01982b19a0996340cc1d155572e453bbde678ed42e65a1b1c39b2828"],"source_ids":["src_65947a6f9f935bb0bdb5fdf1ac5daad1"],"text":"Agent roles are mapped to model tiers: Context Analyst and Finalizer use a small fast model, while PM, Planner, Reviewer use large reasoning models and the Developer uses a large model with 128K output.","updated_at":"2026-09-14T04:51:13Z","updated_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6"}
{"access":"public","created_at":"2026-09-14T04:51:13Z","created_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_650d3f6751a746b9fd7c4d37a02886d03612a323ef65d7afa56c19f46b8d1f88","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"aozyildirim/agena@63db0e2736d2 snapshot 8467f4e1626576f1","timeframe":null},"slice_ids":["slc_5f74d111b765afdaf3fd2679a52d6eb4ac4815185c429940df0d74b8d06030cc","slc_71ce4a36bf4736ebc115e137e389a7ed11d8e417228f440280756a84ec9a24ad","slc_c9073c9739b35f43729510646a398858da3981346220237530b48d1a78ea8c7a","slc_ed27768c275046c17786f46ce5a0afd3ceee2fdd341553ec8b8d929052d82566","slc_f335912ff84f28324596313fb6ee11af4807c5abec5567dfa3020306d7f777a8","slc_f461a95ee8d492cbc3eee0b767423b82dbb0e943414ac9a5f3949fc606114c62"],"source_ids":["src_65947a6f9f935bb0bdb5fdf1ac5daad1"],"text":"The FastAPI backend exposes documented REST endpoints for auth, tasks (including imports from Azure DevOps, Jira, New Relic, Sentry), agents, flows, analytics/DORA, and billing, with OpenAPI docs at /docs.","updated_at":"2026-09-14T04:51:13Z","updated_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6"}
{"access":"public","created_at":"2026-09-14T01:34:31Z","created_by_operation":"op_986e37dd3628403bb397a26c5ff61bc7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6be9bd0ee0cd9a8ef3b4725e7347f11fb6c197abcc9de6c30d05e977a98ccb9f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"aozyildirim/agena@63db0e2736d2 snapshot 8467f4e1626576f1","timeframe":null},"slice_ids":["slc_3966316d2094d75e859e03d3751f3a103760afdd95a5439c3fe4905d88fe21eb","slc_62e21e31d29e60b21db275017231fb687a6667f65bdd06c5fe9bb98f1bfc00a1"],"source_ids":["src_65947a6f9f935bb0bdb5fdf1ac5daad1"],"text":"AGENA targets teams using Sentry, New Relic, Jira, YouTrack, Azure DevOps and GitHub, pulling sprint items and shipping PRs, and is positioned as self-hostable and multi-tenant with JWT auth, RBAC roles, usage-quota plans, and Stripe billing.","updated_at":"2026-09-14T04:51:13Z","updated_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6"}
{"access":"public","created_at":"2026-09-14T01:34:31Z","created_by_operation":"op_986e37dd3628403bb397a26c5ff61bc7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7ab6594043312f003d08710eee00e428dac05337e0035542420608b26b4df243","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"aozyildirim/agena@63db0e2736d2 snapshot 8467f4e1626576f1","timeframe":null},"slice_ids":["slc_d0cd283e3fa2a20427e43b698a538d3e42137093750899d71f2e2467180aae20"],"source_ids":["src_65947a6f9f935bb0bdb5fdf1ac5daad1"],"text":"The stack uses Python 3.11/FastAPI/SQLAlchemy 2.0 async, MySQL 8.0, Redis 7, optional Qdrant vector memory (QDRANT_ENABLED), Next.js 14/React 18 frontend, JWT+bcrypt auth, and Docker Compose with Nginx blue/green frontend deployment.","updated_at":"2026-09-14T04:51:13Z","updated_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6"}
{"access":"public","created_at":"2026-09-14T01:34:31Z","created_by_operation":"op_986e37dd3628403bb397a26c5ff61bc7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_83beae0d94ad48926a20a05535b4c95bb3099d4c8d453ae140d6c47919b949a1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"aozyildirim/agena@63db0e2736d2 snapshot 8467f4e1626576f1","timeframe":null},"slice_ids":["slc_01a1bc14d2db4b292900c22ebf5a5353e01d5a1abf112db0ba49d1b477be8719","slc_0a88cf55eae12f869a071a078464f4b81503907f7dbc6935230c8b244f065808","slc_2d3b4535a45f7f41e92334cdf786ee57cefe21d653143b308c6a56e33d2e3c9c","slc_dd0d9f14b15df13e63bf7a8250f599c1b786a4a5b4a08a8ab14578184d173682"],"source_ids":["src_65947a6f9f935bb0bdb5fdf1ac5daad1"],"text":"Repository development practice: local development instructions cover creating a Python 3.11 venv, installing all six packages in editable mode, running the API with uvicorn on port 8010, and running the worker via python -m agena_worker.workers.redis_worker.","updated_at":"2026-09-14T04:51:13Z","updated_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6"}
