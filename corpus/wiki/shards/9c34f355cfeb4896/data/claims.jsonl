{"access":"public","created_at":"2026-09-14T01:34:31Z","created_by_operation":"op_986e37dd3628403bb397a26c5ff61bc7","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e43b65d6632f9c56fa2f7697f4eeb55bfb1ac29c807c7a08a0985956d1b9a191","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"aozyildirim/agena@63db0e2736d2 snapshot 8467f4e1626576f1","timeframe":null},"slice_ids":["slc_f99400adfd962ba0035a3f07b00acc18ae964128c1532da7721fae25da0591e2"],"source_ids":["src_65947a6f9f935bb0bdb5fdf1ac5daad1"],"text":"A Skill Librarian asks the configured LLM to summarize completed tasks into structured skill records, and extraction is skipped when the LLM's confidence is below 50% to avoid polluting the catalog.","updated_at":"2026-09-14T04:51:13Z","updated_by_operation":"op_22749245ca4d4ad3a7eb9b7b51415cd6"}
