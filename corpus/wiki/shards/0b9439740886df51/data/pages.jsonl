{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_e998ace10df8f97cd12c4dc753b1b8fcb5024b4bb98503108a81b449a2a0f712"],"opposing_claim_ids":[],"text":"BrowserQwen is an example Chrome extension built on Qwen-Agent offering webpage/PDF discussion, browsing-history recording, and Code Interpreter integration, backed by a locally deployed server on port 7864."}],"claim_ids":["clm_e998ace10df8f97cd12c4dc753b1b8fcb5024b4bb98503108a81b449a2a0f712"],"created_at":"2026-09-14T02:34:02Z","created_by_operation":"op_c3b9be7f79164b5a882dece071efc4fe","id":"pg_0900f769e2da5eca9ed4c33fc628c726","maturity":"draft","page_type":"source","path":"pages/sources/qwenlm-qwen-agent-browser-qwen-md-31a4d36d1236-c33fc628c726.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_8bea29ad61c85716b855c55c37df82e8"],"title":"QwenLM/Qwen-Agent/browser_qwen.md @ 31a4d36d1236","updated_at":"2026-09-14T02:34:02Z","updated_by_operation":"op_c3b9be7f79164b5a882dece071efc4fe"}
