98","clm_e72f95e00dd1825f15db9d7ac8d0a309472fc5a348d4ef88355126aa5c000659","clm_e998ace10df8f97cd12c4dc753b1b8fcb5024b4bb98503108a81b449a2a0f712"],"created_at":"2026-09-14T02:34:02Z","created_by_operation":"op_c3b9be7f79164b5a882dece071efc4fe","id":"pg_57caed9b2724549ba6755b292950b418","maturity":"draft","page_type":"entity","path":"pages/entities/qwenlm-qwen-agent-5b292950b418.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"qwenlm/qwen-agent","updated_at":"2026-09-14T02:34:02Z","updated_by_operation":"op_c3b9be7f79164b5a882dece071efc4fe"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_07ab85a9f1f1bf766913f005ed2ae66429422fa03553b37967cf2e9f44d11c29"],"opposing_claim_ids":[],"text":"The package installs from PyPI as qwen-agent with optional extras [gui,rag,code_interpreter,mcp], or editable from source; MCP examples additionally require uv, git, and sqlite3."},{"claim_ids":["clm_10d3ae5c94869fb6987477a1f4db977efd9dca8e1eb6f5ac5dbe4da88f14593a"],"opposing_claim_ids":[],"text":"The default tool-calling template natively supports parallel function calls, and agent classes such as FnCallAgent and ReActChat are built on the function calling capability."},{"claim_ids":["clm_4fe0340659d2bfaa557d28db862f0e366f56fb7723ac60155707b6e523d07323"],"opposing_claim_ids":[],"text":"Qwen-Agent is a framework for developing LLM applications leveraging Qwen's instruction following, tool usage, planning, and memory capabilities, and it serves as the backend of Qwen Chat."},{"claim_ids":["clm_5055cd059ff7009563a7b881c90866936bdd11bfefdf1a9f26ab32bf5f99e164"],"opposing_claim_ids":[],"text":"MCP servers are configured through an mcpServers JSON structure specifying command and args, e.g. npx-based memory and filesystem servers or a uvx sqlite server."},{"claim_ids":["clm_55d9bc175bb42f30328da7645454bbf48fa02c3e7c0ef6a021ce831cc3066069"],"opposing_claim_ids":[],"text":"The project released the DeepPlanning agent evaluation benchmark (Jan 2026) and links a benchmark page in its README."},{"claim_ids":["clm_6d2b941b6fa2bae7b1942b43199b5b45d74eee970de019555dbcab8478bc526c"],"opposing_claim_ids":[],"text":"The Docker-based code interpreter implements only basic sandbox isolation and mounts only the specified working directory, so the docs advise caution when using it in production environments."},{"claim_ids":["clm_8685ead407712b0b4785cc14f9cd31635c292e5e00e072ffcdfbaf888ac42371"],"opposing_claim_ids":[],"text":"Agents are configured via an llm_cfg dict with keys such as model, model_type, model_server, api_key, and generate_cfg; both DashScope and OpenAI-compatible services (e.g. vLLM, Ollama) are supported."},{"claim_ids":["clm_9dff9aaf949c5a2c01dd7d7d6bea0d802d4ee5889fbf0e9c11466c7ea5c9d941"],"opposing_claim_ids":[],"text":"Custom tools are registered with a @register_tool decorator, defining a description, a parameters schema, and a call() method that parses LLM-generated arguments."},{"claim_ids":["clm_a8a8e2091af5f22234d07ce2148f66bcd85567404f32d21232d36e6879be51c3"],"opposing_claim_ids":[],"text":"The framework provides atomic components — LLMs inheriting from BaseChatModel and Tools inheriting from BaseTool — plus higher-level Agents derived from class Agent."},{"claim_ids":["clm_c293aebf2a893059b8891ff980550c58ad1df936ec2c795140ba4fb773a239be"],"opposing_claim_ids":[],"text":"The Assistant agent accepts llm, system_message, function_list, and files arguments, and agents run via bot.run(messages=...) as a generator yielding streaming responses."},{"claim_ids":["clm_cb5b056f5baa9a35d81f8d482d2162cdc3d6af41a77f4f6bc195011e4eb6e3cd"],"opposing_claim_ids":[],"text":"A Gradio-based WebUI (qwen_agent.gui.WebUI) enables rapid deployment of chat interfaces for agents; per the Gradio 5 upgrade note, the GUI requires Python 3.10 or higher."},{"claim_ids":["clm_cfde5686ce7eb6fa325d045be8b7169150472158ce5aa131ccd4b7d42d967098"],"opposing_claim_ids":[],"text":"The built-in code interpreter tool executes agent-written code inside local Docker containers with basic sandbox isolation, mounting only the specified working directory; Docker must be installed and running beforehand."},{"claim_ids":["clm_e72f95e00dd1825f15db9d7ac8d0a309472fc5a348d4ef88355126aa5c000659"],"opposing_claim_ids":[],"text":"LLM config options include thought_in_content (affecting tool-call parsing), fncall_prompt_type (default 'nous', recommended for qwen3), max_input_tokens truncation, and use_raw_api for the API's native tool call interface."}],"claim_ids":["clm_07ab85a9f1f1bf766913f005ed2ae66429422fa03553b37967cf2e9f44d11c29","clm_10d3ae5c94869fb6987477a1f4db977efd9dca8e1eb6f5ac5dbe4da88f14593a","clm_4fe0340659d2bfaa557d28db862f0e366f56fb7723ac60155707b6e523d07323","clm_5055cd059ff7009563a7b881c90866936bdd11bfefdf1a9f26ab32bf5f99e164","clm_55d9bc175bb42f30328da7645454bbf48fa02c3e7c0ef6a021ce831cc3066069","clm_6d2b941b6fa2bae7b1942b43199b5b45d74eee970de019555dbcab8478bc526c","clm_8685ead407712b0b4785cc14f9cd31635c292e5e00e072ffcdfbaf888ac42371","clm_9dff9aaf949c5a2c01dd7d7d6bea0d802d4ee5889fbf0e9c11466c7ea5c9d941","clm_a8a8e2091af5f22234d07ce2148f66bcd85567404f32d21232d36e6879be51c3","clm_c293aebf2a893059b8891ff980550c58ad1df936ec2c795140ba4fb773a239be","clm_cb5b056f5baa9a35d81f8d482d2162cdc3d6af41a77f4f6bc195011e4eb6e3cd","clm_cfde5686ce7eb6fa325d045be8b7169150472158ce5aa131ccd4b7d42d967098","clm_e72f95e00dd1825f15db9d7ac8d0a309472fc5a348d4ef88355126aa5c000659"],"created_at":"2026-09-14T02:34:02Z","created_by_operation":"op_c3b9be7f79164b5a882dece071efc4fe","id":"pg_8f54524632f45a0694bfedcc2fd6230b","maturity":"draft","page_type":"source","path":"pages/sources/qwenlm-qwen-agent-readme-md-31a4d36d1236-edcc2fd6230b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_365df57ed3b7532a8922e9321c6a3f91"],"title":"QwenLM/Qwen-Agent/README.md @ 31a4d36d1236","updated_at":"2026-09-14T02:34:02Z","updated_by_operation":"op_c3b9be7f79164b5a882dece071efc4fe"}
