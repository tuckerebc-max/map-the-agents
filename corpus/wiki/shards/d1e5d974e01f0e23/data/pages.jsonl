{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0069f425b760045938f15d1bd884089da26fac43794f1578984d35a4eb24bca5"],"opposing_claim_ids":[],"text":"A CLI subcommand interface exists for settings: bb-app config supports set, list, unset, and refresh for non-secret settings such as BB_APP_URL and BB_INFERENCE."}],"claim_ids":["clm_0069f425b760045938f15d1bd884089da26fac43794f1578984d35a4eb24bca5"],"created_at":"2026-09-14T01:51:21Z","created_by_operation":"op_1fd59d48bbe74f40a92f686ba36677e8","id":"pg_1a8ea92696d25773b93bc711367150b1","maturity":"draft","page_type":"source","path":"pages/sources/get-bb-bb-docs-configuration-md-d89160eb8c69-c711367150b1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_23ddbf7f51fb5392a7fe2c00c0d75445"],"title":"get-bb/bb/docs/configuration.md @ d89160eb8c69","updated_at":"2026-09-14T01:51:21Z","updated_by_operation":"op_1fd59d48bbe74f40a92f686ba36677e8"}
