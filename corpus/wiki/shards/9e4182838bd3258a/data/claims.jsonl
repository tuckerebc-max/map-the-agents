{"access":"public","created_at":"2026-09-14T03:18:05Z","created_by_operation":"op_d18025edd71041d9aeda677c6f03e2e8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7411f0e60d0310a10281c7c9accd8bc28e294697e7e1ba2e54d304b3e8405b6c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"tarunms7/forge-orchestrator@0ac78e8eddf5 snapshot 25cc550ed3447ada","timeframe":null},"slice_ids":["slc_b684acce1f56c4996f05be6f7eaec162d69d70acb4f9a95986e1ec3493355227","slc_be5074ad2b5be61abae6d5e6fb702a1688d5e764aed5dc75cd0b01fb8f20eb16"],"source_ids":["src_24eada21bb3455a8825e324665831420"],"text":"A terminal UI (forge tui) and a web dashboard (forge serve, backend on port 8000 and frontend on 3000) provide live pipeline progress, plan editing, contract viewing, and cost tracking.","updated_at":"2026-09-14T03:18:05Z","updated_by_operation":"op_d18025edd71041d9aeda677c6f03e2e8"}
{"access":"public","created_at":"2026-09-14T03:18:05Z","created_by_operation":"op_d18025edd71041d9aeda677c6f03e2e8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7b24c603b726ce130335b2c3ee33d7dcb555c211c381afce0f104f58663589e6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"tarunms7/forge-orchestrator@0ac78e8eddf5 snapshot 25cc550ed3447ada","timeframe":null},"slice_ids":["slc_6ecab3dfbc991b70dcf4260a3f9f7a3103bb26a43d60e35025adaf01393790cb"],"source_ids":["src_24eada21bb3455a8825e324665831420"],"text":"Pipelines run six stages: pre-flight validation, planning into a task DAG, contract generation, parallel execution in isolated git worktrees, a five-gate review (build, lint, test, LLM review, contracts), then format, rebase, merge, and gh pr create.","updated_at":"2026-09-14T03:18:05Z","updated_by_operation":"op_d18025edd71041d9aeda677c6f03e2e8"}
{"access":"public","created_at":"2026-09-14T03:18:05Z","created_by_operation":"op_d18025edd71041d9aeda677c6f03e2e8","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7d67f40c3bad1e1cf7e7e9bfdf7f43acae1b30c91bf4f80f549a0af9835e84a0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"tarunms7/forge-orchestrator@0ac78e8eddf5 snapshot 25cc550ed3447ada","timeframe":null},"slice_ids":["slc_0e8db9c00a467fe5566bd4a4c45cc600b997e1f9226954a7e0dd9ecfeeb79f89","slc_11672524e6fab7cf24242fd3dec390f26eb35da2a02ce52907ded7f476e2a96f","slc_94505ed3b54dd105a348072718c97ffa6f91f9868d45c074cd81b09e981d67f8"],"source_ids":["src_24eada21bb3455a8825e324665831420"],"text":"A background health monitor detects tasks in progress over 15 minutes without activity, reviews running over 10 minutes, deadlocks, and dependency cascades, surfacing problems during execution.","updated_at":"2026-09-14T03:18:05Z","updated_by_operation":"op_d18025edd71041d9aeda677c6f03e2e8"}
