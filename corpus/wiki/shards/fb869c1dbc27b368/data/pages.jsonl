{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_633fc8f798ebd83452a9e608fb486c1bb293190a57d1ca935f7d4efda0751b99"],"opposing_claim_ids":[],"text":"Repository development practice: security vulnerabilities must not be filed as public GitHub issues; they go to MSRC via its report form or secure@microsoft.com, preferably encrypted with Microsoft's PGP key."}],"claim_ids":["clm_633fc8f798ebd83452a9e608fb486c1bb293190a57d1ca935f7d4efda0751b99"],"created_at":"2026-09-14T04:09:15Z","created_by_operation":"op_b0bc20a177c643068b2ac516fec98e43","id":"pg_25359bcb376550e2bef311fb08a87455","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-typechat-security-md-83caa1242d9a-11fb08a87455.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d7a08019d3245165ae65b638946ef10a"],"title":"microsoft/TypeChat/SECURITY.md @ 83caa1242d9a","updated_at":"2026-09-14T04:09:15Z","updated_by_operation":"op_b0bc20a177c643068b2ac516fec98e43"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_05c69a67ddc6f59acf6925fecd08da692e8e4509a1e112e765fd4df62a0289be"],"opposing_claim_ids":[],"text":"Repository development practice: the project adopts the Microsoft Open Source Code of Conduct, with questions directed to opencode@microsoft.com."},{"claim_ids":["clm_1e965e0095096478658bda15e03ee67bae21f69fe50f67ebd798df3e44983e30"],"opposing_claim_ids":[],"text":"Repository development practice: contributions require agreeing to a Contributor License Agreement, with a CLA bot decorating pull requests to determine status."},{"claim_ids":["clm_3b39565381a90c73d1973b5d86ba82d4504246e11cbc9f91e7da9121b5824cdc"],"opposing_claim_ids":[],"text":"After validation, TypeChat summarizes the resulting instance succinctly without using an LLM to confirm alignment with user intent."},{"claim_ids":["clm_3f97560752a84efde2f19f2f57b465a5a28565a0cd5af09a7c7fbc3754326c52"],"opposing_claim_ids":[],"text":"Developers define types representing supported intents, from simple sentiment classification to complex schemas like shopping carts or music apps."},{"claim_ids":["clm_532b10bde929022cee04542b26cdb8863958e14e4f4147c9deb75815d8c8a783"],"opposing_claim_ids":[],"text":"TypeChat is a library for building natural language interfaces using types, replacing prompt engineering with schema engineering."},{"claim_ids":["clm_833b73fc6fcb8c19819e08dd75a0cea1cff58094a461d768b704cb27450210ba"],"opposing_claim_ids":[],"text":"TypeChat's pipeline: builds an LLM prompt from the types, validates the response against the schema, and repairs invalid output through further model interaction."},{"claim_ids":["clm_95141e5104f1d5ceb2589152e36b25d1a42396038a93da37f965079cb19d7f0e"],"opposing_claim_ids":[],"text":"The TypeScript/JavaScript package is installed via npm install typechat; Python and C#/.NET variants exist, with .NET hosted in a separate TypeChat.net repository."},{"claim_ids":["clm_a1ab767e14284b8f7931aaf04f85dc87163584baa15c8e8bf2c3a3fa599e97b6"],"opposing_claim_ids":[],"text":"Example projects live under typescript/examples and can be run locally or in a GitHub Codespace; documentation is hosted at microsoft.github.io/TypeChat."},{"claim_ids":["clm_e110ca5bc9af171f6664a5f13c876e8ff70e185056b53c30c00ec9d6f873b2bb"],"opposing_claim_ids":[],"text":"Schemas can be extended by adding types to a discriminated union, and made hierarchical via a meta-schema that selects sub-schemas from user input."}],"claim_ids":["clm_05c69a67ddc6f59acf6925fecd08da692e8e4509a1e112e765fd4df62a0289be","clm_1e965e0095096478658bda15e03ee67bae21f69fe50f67ebd798df3e44983e30","clm_3b39565381a90c73d1973b5d86ba82d4504246e11cbc9f91e7da9121b5824cdc","clm_3f97560752a84efde2f19f2f57b465a5a28565a0cd5af09a7c7fbc3754326c52","clm_532b10bde929022cee04542b26cdb8863958e14e4f4147c9deb75815d8c8a783","clm_833b73fc6fcb8c19819e08dd75a0cea1cff58094a461d768b704cb27450210ba","clm_95141e5104f1d5ceb2589152e36b25d1a42396038a93da37f965079cb19d7f0e","clm_a1ab767e14284b8f7931aaf04f85dc87163584baa15c8e8bf2c3a3fa599e97b6","clm_e110ca5bc9af171f6664a5f13c876e8ff70e185056b53c30c00ec9d6f873b2bb"],"created_at":"2026-09-14T04:09:15Z","created_by_operation":"op_b0bc20a177c643068b2ac516fec98e43","id":"pg_339434601392578ca2a1123cbd2012f4","maturity":"draft","page_type":"source","path":"pages/sources/microsoft-typechat-readme-md-83caa1242d9a-123cbd2012f4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_aed61469778d5f4da9cea1dc23c8db47"],"title":"microsoft/TypeChat/README.md @ 83caa1242d9a","updated_at":"2026-09-14T04:09:15Z","updated_by_operation":"op_b0bc20a177c643068b2ac516fec98e43"}
