{"access":"public","created_at":"2026-09-14T03:45:12Z","created_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6b90ff9d224ba999ff0d4fdbdb24b0b4a83732cadc22826e6bab5e4a1b4cac05","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"deadwavewave/demo2apk@1405c4405c96 snapshot df9b1e3a27b62d02","timeframe":null},"slice_ids":["slc_0c130a95cb13423a9d42937a39075f85d0312c2156d35b918a13bf1df2fbe785","slc_756a4c9596fd0205caacdf1e025eff1fc36ccd8f401a5773396bada4a83d4c50","slc_e08c18ad8f79607bd433e19a5cfb4cbbd4693aa1feb4ea68f30fa9f66666a7d1"],"source_ids":["src_8bf4a062790f5a19af7c33c7542aeafd","src_ff0fbb1b51615038b82abd365fc5ffc9"],"text":"Prebuilt Docker images support only linux/amd64; macOS and ARM users are directed to local development mode instead.","updated_at":"2026-09-14T03:45:12Z","updated_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2"}
{"access":"public","created_at":"2026-09-14T03:45:12Z","created_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_927abcb32a4fd6176cc302fa5b1a5b1c0878a2e279c489e79c680220ebbfb611","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"deadwavewave/demo2apk@1405c4405c96 snapshot df9b1e3a27b62d02","timeframe":null},"slice_ids":["slc_09045757c5310e80e7a8af491e1e1fe52e55d3c6f3aad8f76327730228c81cf6","slc_1ad24fcc8bc0ac77037b380c1b17b279c7a289ace877b34041f08e0f0913d941","slc_f2814b20f0367b940f3accb71832c1bf07dd585e3239ba66afc7b45dff771d6c"],"source_ids":["src_8bf4a062790f5a19af7c33c7542aeafd"],"text":"Repository development practice: React/Vite projects targeting APK output are advised to add @vitejs/plugin-legacy with terser, set legacy targets like chrome >= 52 / android >= 5, and use a relative base ('./') to avoid blank screens.","updated_at":"2026-09-14T03:45:12Z","updated_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2"}
{"access":"public","created_at":"2026-09-14T03:45:12Z","created_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a22a0ce6b7cbcd7776363bf09bed70ec71149088007629f5f80fb8049c7af4b6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"deadwavewave/demo2apk@1405c4405c96 snapshot df9b1e3a27b62d02","timeframe":null},"slice_ids":["slc_21a6959f2bc21493588cb7ebd9f6d24aaad52e8a0f277d95d26d0eb4d54c1bea","slc_9b6ecf6e8b2bb6c74c37dfef81f5c307a5756dbec6541d69f5f8cfe3b1ad47e5"],"source_ids":["src_dbd8de46135153a181a7426f96fb3645"],"text":"The REST API exposes GET /health, POST /api/build/html, POST /api/build/zip, GET /api/build/:taskId/status, GET /api/build/:taskId/download, and DELETE /api/build/:taskId, using multipart/form-data uploads and JSON responses.","updated_at":"2026-09-14T03:45:12Z","updated_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2"}
{"access":"public","created_at":"2026-09-14T03:45:12Z","created_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b4c63bec5d0fa8f5b2b1e4b9689e5f2aa8e2bab70a06839b7cb0d60a076223c7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"deadwavewave/demo2apk@1405c4405c96 snapshot df9b1e3a27b62d02","timeframe":null},"slice_ids":["slc_e8da9f4e9697de557bc0bd16349eaeacb87d289747e02f0d17b7bf83c400c75c"],"source_ids":["src_8bf4a062790f5a19af7c33c7542aeafd"],"text":"The tool auto-detects input type (HTML, React, ZIP) and picks a build strategy, supporting single files (.html/.js/.jsx/.ts/.tsx), pasted code, and ZIP archives of React/Vite or multi-file HTML projects.","updated_at":"2026-09-14T03:45:12Z","updated_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2"}
{"access":"public","created_at":"2026-09-14T03:45:12Z","created_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cf3fe1f77c2ec377089cda246bd6835295bd977cc8376d8d8a4f1f04df747ef8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"deadwavewave/demo2apk@1405c4405c96 snapshot df9b1e3a27b62d02","timeframe":null},"slice_ids":["slc_7523d60a29353c73af8bf92e701af5d292b09f3d717bb3bb8ddd6703072a580c","slc_c01b97e75717f90658e5281ce42488b2f8ccc12d3c8f237b9a3a1083997656cf","slc_ea1c0d94cf0d8a80ae2fabcad8860668731c13726a629702ff45a3f5283fc9a7"],"source_ids":["src_8bf4a062790f5a19af7c33c7542aeafd"],"text":"Builds run through a queue backed by BullMQ and Redis, with configurable worker concurrency (default 2) and excess builds queued automatically.","updated_at":"2026-09-14T03:45:12Z","updated_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2"}
{"access":"public","created_at":"2026-09-14T03:45:12Z","created_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ed7ba9ac84b9af261223676423343b7df889f41b6f6ba76b23b06590aaf3b4e9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"deadwavewave/demo2apk@1405c4405c96 snapshot df9b1e3a27b62d02","timeframe":null},"slice_ids":["slc_c01b97e75717f90658e5281ce42488b2f8ccc12d3c8f237b9a3a1083997656cf"],"source_ids":["src_8bf4a062790f5a19af7c33c7542aeafd"],"text":"The stated tech stack is React/Vite/Tailwind frontend, Node.js/Fastify/TypeScript backend, BullMQ with Redis for queuing, and Cordova, Capacitor, and Gradle for APK building.","updated_at":"2026-09-14T03:45:12Z","updated_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2"}
