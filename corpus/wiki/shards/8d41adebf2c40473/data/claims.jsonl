{"access":"public","created_at":"2026-09-14T03:45:12Z","created_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1e318b7f7c0a936b6e02535323d8fdf44258d2fa9f79256818bcbd9e5a3c48ec","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"deadwavewave/demo2apk@1405c4405c96 snapshot df9b1e3a27b62d02","timeframe":null},"slice_ids":["slc_022053edc717b2c5f2cbb6b15c2bf6d53204b117f45b50fb3039e69645fa01c6","slc_adb35e5cd9d3771a3926dd952507d51759254c40390d048bf170c5f9d0dfa467"],"source_ids":["src_dbd8de46135153a181a7426f96fb3645"],"text":"Build endpoints accept optional appName, appId, and publishPwa fields; appName defaults differ per endpoint (MyVibeApp for HTML, MyReactApp for ZIP).","updated_at":"2026-09-14T03:45:12Z","updated_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2"}
{"access":"public","created_at":"2026-09-14T03:45:12Z","created_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_251f8c3a6d7bbee16e6799ae6c93dda4c268bdd0716f7b62703d3c368877d072","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"deadwavewave/demo2apk@1405c4405c96 snapshot df9b1e3a27b62d02","timeframe":null},"slice_ids":["slc_e8da9f4e9697de557bc0bd16349eaeacb87d289747e02f0d17b7bf83c400c75c"],"source_ids":["src_8bf4a062790f5a19af7c33c7542aeafd"],"text":"Users can customize app name, version, icon, and select Android permissions via the UI, defaulting to INTERNET only; optional PWA generation is available alongside the APK.","updated_at":"2026-09-14T03:45:12Z","updated_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2"}
{"access":"public","created_at":"2026-09-14T03:45:12Z","created_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2a37f5bbc9ec7a5de37a77de719d276b15e81f79e00e41d47f8ec971053c6474","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"deadwavewave/demo2apk@1405c4405c96 snapshot df9b1e3a27b62d02","timeframe":null},"slice_ids":["slc_1cda0f10e26916263cd926642e45daeea163247669e54d537be763b8819e6872","slc_90213fceb69bb3170b5bb82cd4abd79ad2a8a3a6e2e454fcce17298b5c7bb34b","slc_ae3174861c8f72bd603266a9dca0abdfdf79a89f0830131d587df2bdbe032883"],"source_ids":["src_5b257e03a2d05950b72d6df8041406b1"],"text":"Google does not publish Linux ARM64 Android build-tools (notably aapt2), so ARM64 Docker builds rely on a temporary Rosetta x86_64 emulation workaround that is slower than native.","updated_at":"2026-09-14T03:45:12Z","updated_by_operation":"op_5e7d7b136e9b4d7dbd2d7ab16a1938b2"}
