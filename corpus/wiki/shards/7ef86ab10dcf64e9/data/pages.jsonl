{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_287953c98da2eafd9ecb44ff58d723d777685cd50210048d81f5ebcbb486b862"],"opposing_claim_ids":[],"text":"The memory building block is described as agentic memory with switchable backends, naming ReMe and Mem0."},{"claim_ids":["clm_30b1f905f2be6cc5abed2485ea79c148d95f7819d875987aba4b183aba9220a2"],"opposing_claim_ids":[],"text":"AgentScope requires Python 3.11 or higher and can be installed from PyPI via 'uv pip install agentscope'."},{"claim_ids":["clm_958f015877fb238170c14298d3db9399182748c226eee2396bef9e8e7bd4b9a9"],"opposing_claim_ids":[],"text":"The SDK exposes building blocks including a ReAct reasoning-acting loop, Toolkit, Model, Context, Event System, Permission & HITL, Middleware, Memory, and Workspace/Sandbox."},{"claim_ids":["clm_9bb0d76b026b7fc704616006669df783a83e00341ed41ca20669caa3aaddefe9"],"opposing_claim_ids":[],"text":"The design philosophy is to leverage models' reasoning and tool-use abilities rather than constrain them with strict prompts and opinionated orchestrations."}],"claim_ids":["clm_287953c98da2eafd9ecb44ff58d723d777685cd50210048d81f5ebcbb486b862","clm_30b1f905f2be6cc5abed2485ea79c148d95f7819d875987aba4b183aba9220a2","clm_958f015877fb238170c14298d3db9399182748c226eee2396bef9e8e7bd4b9a9","clm_9bb0d76b026b7fc704616006669df783a83e00341ed41ca20669caa3aaddefe9"],"created_at":"2026-09-14T03:32:05Z","created_by_operation":"op_19b8c8d1b2304c26af8b75a748f46d42","id":"pg_3b11c37d06ba53df8ebce4873adcc96c","maturity":"draft","page_type":"source","path":"pages/sources/agentscope-ai-agentscope-readme-zh-md-b82253ba1b68-e4873adcc96c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_cc8407c237e7530299fa223fbbd2a845"],"title":"agentscope-ai/agentscope/README_zh.md @ b82253ba1b68","updated_at":"2026-09-14T03:32:05Z","updated_by_operation":"op_19b8c8d1b2304c26af8b75a748f46d42"}
