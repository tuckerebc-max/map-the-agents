{"access":"public","created_at":"2026-09-14T04:02:20Z","created_by_operation":"op_4da85783a9e641e4b7f030e2fecda46f","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_970a78ae79337d59265c6517bb5db2f6b618efc17772bf26735c3df95c7e145b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"kenn-io/kata@f41a33383aba snapshot f7283538f30a32a1","timeframe":null},"slice_ids":["slc_d084558596d87946c23ac86524252bf21149a6e0f0876d543c991a2a07265888","slc_f19a9ac8fb70f91cf96b9da955461b9aef2dfbe1d2cd9933f5f07a8baa47f288"],"source_ids":["src_f8e530c979eb5711b2ebbde75659c344"],"text":"Hooks run local commands after database commit on a bounded worker pool, invoked without a shell via exec.Command with event data as JSON on stdin; hooks are not a sandbox and run with the daemon's OS user.","updated_at":"2026-09-14T04:02:20Z","updated_by_operation":"op_4da85783a9e641e4b7f030e2fecda46f"}
