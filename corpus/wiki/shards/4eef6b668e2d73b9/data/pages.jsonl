0d"],"created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","id":"pg_a201f5d2b7835f9880ae2d8b01b79b97","maturity":"draft","page_type":"entity","path":"pages/entities/insforge-insforge-2d8b01b79b97.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"insforge/insforge","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7894865097da0a5b2acecb2cfd153df29f711987cc62fa75444943d9c5c69223"],"opposing_claim_ids":[],"text":"On first Google login the system creates records in auth, identifies, and profiles tables; returning users are looked up by provider and provider_id in the identifies table and have last_login_at updated."},{"claim_ids":["clm_bd373b5f39446aff159818ab6d913fdb04971853d72ae498e94408d0a947609f"],"opposing_claim_ids":[],"text":"Google OAuth is documented with endpoints GET /api/auth/v1/google-auth (returns an auth_url) and GET /api/auth/oauth/google/callback, which redirects with token (JWT), user_id, email, and name as URL parameters."}],"claim_ids":["clm_7894865097da0a5b2acecb2cfd153df29f711987cc62fa75444943d9c5c69223","clm_bd373b5f39446aff159818ab6d913fdb04971853d72ae498e94408d0a947609f"],"created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","id":"pg_ccda7252678158a290d90c2375acbfda","maturity":"draft","page_type":"source","path":"pages/sources/insforge-insforge-google-oauth-setup-md-fca20f318722-0c2375acbfda.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f60fece758c35da9a6f66af656569fe0"],"title":"InsForge/InsForge/GOOGLE_OAUTH_SETUP.md @ fca20f318722","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","id":"pg_dbca467441475d619e38fd574902a882","maturity":"draft","page_type":"source","path":"pages/sources/insforge-insforge-github-oauth-setup-md-fca20f318722-fd574902a882.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7107b85dc3355b679ae279b766880394"],"title":"InsForge/InsForge/GITHUB_OAUTH_SETUP.md @ fca20f318722","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_268fa60143b4e9deb04a145622a3f2e61dde914be20d16d007fda4c47fa92cff"],"opposing_claim_ids":[],"text":"The project is licensed under Apache License 2.0, while the public InsForge skills plugin is MIT-licensed."},{"claim_ids":["clm_77710d899fdccae6207da39f19fbeb307462896b6b5aafb612a49c4a89ca939d"],"opposing_claim_ids":[],"text":"Multiple isolated instances are supported by giving each project its own directory, COMPOSE_PROJECT_NAME, and ports; directories sharing a project name share containers, while distinct names yield separate containers, volumes, databases, and secrets."},{"claim_ids":["clm_9be7ae9c62ec7cf80a116e03fa39b0691304a6c4bc55a753bf1885b8884afb39"],"opposing_claim_ids":[],"text":"InsForge is described as an all-in-one, open-source backend platform for agentic coding, giving coding agents database, auth, storage, compute, hosting, and an AI gateway."},{"claim_ids":["clm_9f47cfeb9ba25e69371a41a477e70c85c55351d62d75b01d9e20a4ae598d4126"],"opposing_claim_ids":[],"text":"Storage defaults to the local filesystem; S3-compatible backing storage enables an S3 gateway at /storage/v1/s3, with bundled MinIO or RustFS compose overlays or bring-your-own S3 settings (S3_BUCKET, S3_REGION, keys, optional endpoint and presigned-URL mode)."},{"claim_ids":["clm_a66169c6735c64d625bfcc66d3c2af4c6fc85dc313cbf2fc1eb94a82120524d6"],"opposing_claim_ids":[],"text":"Core products include authentication, Postgres database, S3-compatible storage, an OpenAI-compatible model gateway, edge functions, compute (private preview), and site deployment."},{"claim_ids":["clm_af3e6a0b6e84ccc9de090eb958405c7395e59ddf0000400fdaf20281c5eb503e"],"opposing_claim_ids":[],"text":"Through its interfaces agents can read backend context (docs, schemas, metadata such as deployed functions, bucket contents, auth config, and runtime logs) and configure primitives like edge functions, migrations, buckets, and auth providers."},{"claim_ids":["clm_b75a5618cf4e209f2bebc0f44ba8868fe6e714c40d1f93dd87cdcdf77e9fcb32"],"opposing_claim_ids":[],"text":"Coding agents interact with InsForge through two interfaces: an MCP server (self-hosted and cloud) exposing operations as tools, and a cloud-only CLI paired with Skills invoked from the terminal."},{"claim_ids":["clm_e9b9f7552a2ec2507f84366960cf6d977dbdfe73deb2dd863905f2b420dea60d"],"opposing_claim_ids":[],"text":"Self-hosting via Docker Compose requires Docker with Compose v2; a setup script generates secrets including JWT_SECRET, ENCRYPTION_KEY, POSTGRES_PASSWORD, ROOT_ADMIN_PASSWORD, and access keys into ~/insforge/.env (mode 600) without starting anything."}],"claim_ids":["clm_268fa60143b4e9deb04a145622a3f2e61dde914be20d16d007fda4c47fa92cff","clm_77710d899fdccae6207da39f19fbeb307462896b6b5aafb612a49c4a89ca939d","clm_9be7ae9c62ec7cf80a116e03fa39b0691304a6c4bc55a753bf1885b8884afb39","clm_9f47cfeb9ba25e69371a41a477e70c85c55351d62d75b01d9e20a4ae598d4126","clm_a66169c6735c64d625bfcc66d3c2af4c6fc85dc313cbf2fc1eb94a82120524d6","clm_af3e6a0b6e84ccc9de090eb958405c7395e59ddf0000400fdaf20281c5eb503e","clm_b75a5618cf4e209f2bebc0f44ba8868fe6e714c40d1f93dd87cdcdf77e9fcb32","clm_e9b9f7552a2ec2507f84366960cf6d977dbdfe73deb2dd863905f2b420dea60d"],"created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","id":"pg_e46801d0cfd650ff858bc1e6bd8ce6de","maturity":"draft","page_type":"source","path":"pages/sources/insforge-insforge-readme-md-fca20f318722-c1e6bd8ce6de.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_429f822567d35259b1c6730bfe03ca2c"],"title":"InsForge/InsForge/README.md @ fca20f318722","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_a5874fc9623ba53d553a62dcd8cf353b45dc57071eb322eb85f75e1978c7a36f"],"opposing_claim_ids":[],"text":"The MCP server and CLI expose infrastructure as structured, machine-readable context so AI coding agents can plan and execute operations autonomously within scoped permissions."}],"claim_ids":["clm_a5874fc9623ba53d553a62dcd8cf353b45dc57071eb322eb85f75e1978c7a36f"],"created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","id":"pg_f85358d4994b5442af9988d270856194","maturity":"draft","page_type":"source","path":"pages/sources/insforge-insforge-docs-alternatives-mdx-fca20f318722-88d270856194.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_49bebbd4b0a85197b41820350750b9a0"],"title":"InsForge/InsForge/docs/alternatives.mdx @ fca20f318722","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
