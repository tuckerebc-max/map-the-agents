{"access":"public","created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_77f6f395e94062ce53ef8efd9b3aa11d765bcd636a40278a3b5aa99e4037d835","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"insforge/insforge@fca20f318722 snapshot 4305e1ce136d7730","timeframe":null},"slice_ids":["slc_45fa002d63036b43e63ac72e73bd392933c407a663cbd3e485cf2c43b2e78254"],"source_ids":["src_da608a059f8c55a9b9c1cc1134a164b2"],"text":"Repository development practice: the .claude/skills and .agents/skills directories are internal contributor skills for working on the InsForge OSS repository, distinct from the public plugin maintained in InsForge/insforge-skills.","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7894865097da0a5b2acecb2cfd153df29f711987cc62fa75444943d9c5c69223","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"insforge/insforge@fca20f318722 snapshot 4305e1ce136d7730","timeframe":null},"slice_ids":["slc_c492ec6e6190f5c248af7d6e96df36ca0c01aa95dcd1f4da4be0317902bd0a20","slc_e0a34ab0e8ffcfaee75ede254372e55a1a1383b03183032971cf25bd66566cbf"],"source_ids":["src_f60fece758c35da9a6f66af656569fe0"],"text":"On first Google login the system creates records in auth, identifies, and profiles tables; returning users are looked up by provider and provider_id in the identifies table and have last_login_at updated.","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9be7ae9c62ec7cf80a116e03fa39b0691304a6c4bc55a753bf1885b8884afb39","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"insforge/insforge@fca20f318722 snapshot 4305e1ce136d7730","timeframe":null},"slice_ids":["slc_7930585795c9ff930fedfbdcfc114b05be90ec6faf1ab3940293dbf9d2debba9"],"source_ids":["src_429f822567d35259b1c6730bfe03ca2c"],"text":"InsForge is described as an all-in-one, open-source backend platform for agentic coding, giving coding agents database, auth, storage, compute, hosting, and an AI gateway.","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9f47cfeb9ba25e69371a41a477e70c85c55351d62d75b01d9e20a4ae598d4126","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"insforge/insforge@fca20f318722 snapshot 4305e1ce136d7730","timeframe":null},"slice_ids":["slc_22a71907c1dde5d84d645fcff24da4a48aa5069bb4047b639fda92ded79ca027","slc_3848a0921260df10e44b2fc75b944e309b5f70032c7632f7c9b780e99e25345c","slc_a53c6e359e0507b6f9fc50b63320499f17d2a71940f3374442ce0fede689bc42","slc_cc32f4d251aa12ae61a55912cd1486590f28e4297ff20030e11e0610f66db60c"],"source_ids":["src_429f822567d35259b1c6730bfe03ca2c"],"text":"Storage defaults to the local filesystem; S3-compatible backing storage enables an S3 gateway at /storage/v1/s3, with bundled MinIO or RustFS compose overlays or bring-your-own S3 settings (S3_BUCKET, S3_REGION, keys, optional endpoint and presigned-URL mode).","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a5874fc9623ba53d553a62dcd8cf353b45dc57071eb322eb85f75e1978c7a36f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"insforge/insforge@fca20f318722 snapshot 4305e1ce136d7730","timeframe":null},"slice_ids":["slc_d99a3ab8fa51028e926b767a1eb7e16c94579183377a043b6154b4feb0c4a672"],"source_ids":["src_49bebbd4b0a85197b41820350750b9a0"],"text":"The MCP server and CLI expose infrastructure as structured, machine-readable context so AI coding agents can plan and execute operations autonomously within scoped permissions.","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a66169c6735c64d625bfcc66d3c2af4c6fc85dc313cbf2fc1eb94a82120524d6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"insforge/insforge@fca20f318722 snapshot 4305e1ce136d7730","timeframe":null},"slice_ids":["slc_0990d4e468972dd63037a9a7fad1a244478e07f7399e4d3d972bbee08b431d5a"],"source_ids":["src_429f822567d35259b1c6730bfe03ca2c"],"text":"Core products include authentication, Postgres database, S3-compatible storage, an OpenAI-compatible model gateway, edge functions, compute (private preview), and site deployment.","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_af3e6a0b6e84ccc9de090eb958405c7395e59ddf0000400fdaf20281c5eb503e","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"insforge/insforge@fca20f318722 snapshot 4305e1ce136d7730","timeframe":null},"slice_ids":["slc_ca56ef6d4edd7d7d750d648c0260a9b5b5f8f76e4a66804592a45a6a19128a27"],"source_ids":["src_429f822567d35259b1c6730bfe03ca2c"],"text":"Through its interfaces agents can read backend context (docs, schemas, metadata such as deployed functions, bucket contents, auth config, and runtime logs) and configure primitives like edge functions, migrations, buckets, and auth providers.","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b75a5618cf4e209f2bebc0f44ba8868fe6e714c40d1f93dd87cdcdf77e9fcb32","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"insforge/insforge@fca20f318722 snapshot 4305e1ce136d7730","timeframe":null},"slice_ids":["slc_7ee47bcca72c570dab457384d80962a2081f7a73ca9ebfb5bcb19ffc63cf4b1f","slc_9c9fe9f8f0bd61f1ee9ed081d8ba7e7296d28d65d92b83cca3d9f3b6a5cad9e0"],"source_ids":["src_429f822567d35259b1c6730bfe03ca2c"],"text":"Coding agents interact with InsForge through two interfaces: an MCP server (self-hosted and cloud) exposing operations as tools, and a cloud-only CLI paired with Skills invoked from the terminal.","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
{"access":"public","created_at":"2026-09-14T03:58:31Z","created_by_operation":"op_8fd3ab65918a43d2888429a07c889da6","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bd373b5f39446aff159818ab6d913fdb04971853d72ae498e94408d0a947609f","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"insforge/insforge@fca20f318722 snapshot 4305e1ce136d7730","timeframe":null},"slice_ids":["slc_4bdc0a937fe113da6ec71ae3c4551e95eda1403a88d21d0c00981bed397555cb","slc_61ed38e72fc24cfc76a442d2d2206d4b37036299fd4b5ee456b6a16f55ecc5ed","slc_9f13ee88061a1849a44ff4e9ada82b06be3f5e1573f46c33b03a8053b06f1f71","slc_f84baa3f574ba6a26e3513053b82965f5c23ad9306233065f19dbbd9bd0b595a"],"source_ids":["src_f60fece758c35da9a6f66af656569fe0"],"text":"Google OAuth is documented with endpoints GET /api/auth/v1/google-auth (returns an auth_url) and GET /api/auth/oauth/google/callback, which redirects with token (JWT), user_id, email, and name as URL parameters.","updated_at":"2026-09-14T03:58:31Z","updated_by_operation":"op_8fd3ab65918a43d2888429a07c889da6"}
