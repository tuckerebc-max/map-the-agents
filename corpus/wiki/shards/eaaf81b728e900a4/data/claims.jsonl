{"access":"public","created_at":"2026-09-14T04:09:11Z","created_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_97400cbe362db73191667eb7250e8c6c723d8c7fa3dcab69c865899f447cd763","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"maxktz/hitch@bcbfca260225 snapshot a239af80cda50b58","timeframe":null},"slice_ids":["slc_094c0972ae83a52ef6e5d25dd9da6c96d3403ca75839fd6bebecd3c84c3fb61b","slc_48bc8380478247c9848650430732c0b197c18a07b04dbc945777ff05efba9f32","slc_8716760e649a88cbb06da697f50cc27aa8836c52d39fb2457445a35e6c22e906","slc_8f7de37444c80d76690a95eea6269f0268cfed752f46c7214370764e19a40f5b"],"source_ids":["src_51665feb7651590dad68b90b8932db8d"],"text":"Human-facing usage is minimal: `hitch` starts sharing and `unhitch` or `hitch off` stops it; remaining commands are built for agents.","updated_at":"2026-09-14T04:09:11Z","updated_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2"}
