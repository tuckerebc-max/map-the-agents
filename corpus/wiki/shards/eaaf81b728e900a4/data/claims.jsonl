{"access":"public","created_at":"2026-09-14T04:09:11Z","created_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3681a4756ba766be2a278fad254b29188671aa3945b873d82a9ea4cc5bd01575","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"maxktz/hitch@bcbfca260225 snapshot a239af80cda50b58","timeframe":null},"slice_ids":["slc_5fcca206ff22eab0386931efbec086614030d4aac9c606d3a39c261052a95bc4"],"source_ids":["src_51665feb7651590dad68b90b8932db8d"],"text":"Hitch is a CLI for sharing the user's real terminal with AI coding agents; running `hitch` gives agents terminal context, ability to send keys or commands, and inspect output.","updated_at":"2026-09-14T04:09:11Z","updated_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2"}
