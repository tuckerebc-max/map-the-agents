{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:09:11Z","created_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2","id":"pg_35d6e12c3abe5344a3ad9f62770af459","maturity":"draft","page_type":"source","path":"pages/sources/maxktz-hitch-todo-md-bcbfca260225-9f62770af459.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f6e32248fa5457c28ffc982f1b5a8cb9"],"title":"maxktz/hitch/TODO.md @ bcbfca260225","updated_at":"2026-09-14T04:09:11Z","updated_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_173014819b1af3b4b441868ee2098845bf5b367c8e77a8cb4d24a31d65b0f2f6"],"opposing_claim_ids":[],"text":"Installation is via `npm install -g hitch-cli`; supported platforms are macOS and Linux on arm64 or x64."},{"claim_ids":["clm_1b27170cff80c1d0ab3195277abc8e6a772ee1e06f9ab06cdc70a865c8064b81"],"opposing_claim_ids":[],"text":"Hitch is not a terminal multiplexer UI like tmux; the terminal feels like a normal shell while Hitch proxies input/output, records context, and exposes agent-friendly commands."},{"claim_ids":["clm_3681a4756ba766be2a278fad254b29188671aa3945b873d82a9ea4cc5bd01575"],"opposing_claim_ids":[],"text":"Hitch is a CLI for sharing the user's real terminal with AI coding agents; running `hitch` gives agents terminal context, ability to send keys or commands, and inspect output."},{"claim_ids":["clm_97400cbe362db73191667eb7250e8c6c723d8c7fa3dcab69c865899f447cd763"],"opposing_claim_ids":[],"text":"Human-facing usage is minimal: `hitch` starts sharing and `unhitch` or `hitch off` stops it; remaining commands are built for agents."}],"claim_ids":["clm_173014819b1af3b4b441868ee2098845bf5b367c8e77a8cb4d24a31d65b0f2f6","clm_1b27170cff80c1d0ab3195277abc8e6a772ee1e06f9ab06cdc70a865c8064b81","clm_3681a4756ba766be2a278fad254b29188671aa3945b873d82a9ea4cc5bd01575","clm_97400cbe362db73191667eb7250e8c6c723d8c7fa3dcab69c865899f447cd763"],"created_at":"2026-09-14T04:09:11Z","created_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2","id":"pg_6396e1034e5a570d9f34ed76a7d8f904","maturity":"draft","page_type":"source","path":"pages/sources/maxktz-hitch-readme-md-bcbfca260225-ed76a7d8f904.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_51665feb7651590dad68b90b8932db8d"],"title":"maxktz/hitch/README.md @ bcbfca260225","updated_at":"2026-09-14T04:09:11Z","updated_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_8da2f6f795818f6575b7ae57a7877b48524e00fc9ebcf436419b60b05208b7d4"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run `cargo fmt -- --check` and `cargo test` before committing, and build locally with `cargo build --release`."},{"claim_ids":["clm_ba1c5f2217655bdacc2ef49bd6ab15bda6303007ae37d5d7f8e601acb69d685d"],"opposing_claim_ids":[],"text":"Repository development practice: releases use `npm run release -- <version>` and a tag push; GitHub Actions then builds native binaries, publishes hitch-cli to npm, and creates a GitHub release."}],"claim_ids":["clm_8da2f6f795818f6575b7ae57a7877b48524e00fc9ebcf436419b60b05208b7d4","clm_ba1c5f2217655bdacc2ef49bd6ab15bda6303007ae37d5d7f8e601acb69d685d"],"created_at":"2026-09-14T04:09:11Z","created_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2","id":"pg_91b30ddfd2ff57a896b5b47c17a6e0a6","maturity":"draft","page_type":"source","path":"pages/sources/maxktz-hitch-contributing-md-bcbfca260225-b47c17a6e0a6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_ccdd2b54c3ea5a3db4becd00281f4a13"],"title":"maxktz/hitch/CONTRIBUTING.md @ bcbfca260225","updated_at":"2026-09-14T04:09:11Z","updated_by_operation":"op_7bb4a4e40af647bf8b556245b8cd7ab2"}
