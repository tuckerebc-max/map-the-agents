{"access":"public","created_at":"2026-09-14T03:43:14Z","created_by_operation":"op_ab917da251704325a25f275c10d6d1cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ac9d19ec0edbee656154429592172e990d413fd95c52758dc30e2033864c8629","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"crewaiinc/crewai@894898f84c4a snapshot 0d6e6df1020dcd85","timeframe":null},"slice_ids":["slc_7ca90746fbf0cda952af7e1db62e329bcfe37ca6261c11961df690ff7deeff98"],"source_ids":["src_d807d78c881350ef90d7a8a6a8c9a552"],"text":"On Windows, a chroma-hnswlib==0.7.6 build error (missing float.h) can occur, requiring Visual Studio Build Tools with Desktop development with C++ to resolve.","updated_at":"2026-09-14T03:43:14Z","updated_by_operation":"op_ab917da251704325a25f275c10d6d1cc"}
{"access":"public","created_at":"2026-09-14T03:43:14Z","created_by_operation":"op_ab917da251704325a25f275c10d6d1cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_afb20134f481ac65142dedc12fb34a5403bc8602803f2a017450db8a699ae8f2","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=skills-patterns","setting":"crewaiinc/crewai@894898f84c4a snapshot 0d6e6df1020dcd85","timeframe":null},"slice_ids":["slc_60c0b1532e84537bac398b223ae9d1751dc4c464b0bb930e5d839aade90d4309","slc_775342e2bca8a444841a6e22d58213b47e4a60e4892791c467bbc02882758063","slc_87bd9b6943b0b607a9c0f442b53cb84aa35ecf55482e5462c1df7a4d013b509f","slc_e8eb288671c6e3ca7d42f2ded9e7ce38da9e00c74ebf4eb4152a997077aa9034"],"source_ids":["src_d807d78c881350ef90d7a8a6a8c9a552"],"text":"Official CrewAI Skills can be installed for AI coding agents (Claude Code plugins or `npx skills add crewaiinc/skills`), covering scaffolding, agent/task design, and a docs MCP query skill.","updated_at":"2026-09-14T03:43:14Z","updated_by_operation":"op_ab917da251704325a25f275c10d6d1cc"}
{"access":"public","created_at":"2026-09-14T03:43:14Z","created_by_operation":"op_ab917da251704325a25f275c10d6d1cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d0cd35e632df5fd84c5f0f9f20d85c1c61eac9afc63cdf429f67c0cc98f6e6d7","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"crewaiinc/crewai@894898f84c4a snapshot 0d6e6df1020dcd85","timeframe":null},"slice_ids":["slc_7dab11474ff5d648a52a913013b4c9f752ff8d701ac6dbcb3b2b41a118e45d88","slc_8e6f20d2c01780ade8a9ac2ebe66725dd47cb71a68bb97970532ed9780d75223","slc_fb7cd1769432e9ef0dcd1aee03aa598b23bc24a730ce4c3848df13907ee46cd1"],"source_ids":["src_d807d78c881350ef90d7a8a6a8c9a552"],"text":"By default agents use the OpenAI API for model queries; other connections such as local models via Ollama and LM Studio are supported, and custom-trained or fine-tuned models can be integrated.","updated_at":"2026-09-14T03:43:14Z","updated_by_operation":"op_ab917da251704325a25f275c10d6d1cc"}
