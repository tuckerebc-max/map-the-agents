{"access":"public","created_at":"2026-09-14T03:43:14Z","created_by_operation":"op_ab917da251704325a25f275c10d6d1cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_547d5ffd99603491b04822d28ed05a9864625bceff62796157215f3c87437a84","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"crewaiinc/crewai@894898f84c4a snapshot 0d6e6df1020dcd85","timeframe":null},"slice_ids":["slc_81d7d8e5dc9303b58e4c10e381ac4353078dbc7404d07f9e3ebcd512cfff88dd"],"source_ids":["src_d807d78c881350ef90d7a8a6a8c9a552"],"text":"CrewAI is described as an open-source Python framework for building production-ready multi-agent workflows, offering high-level abstractions and low-level APIs.","updated_at":"2026-09-14T03:43:14Z","updated_by_operation":"op_ab917da251704325a25f275c10d6d1cc"}
{"access":"public","created_at":"2026-09-14T03:43:14Z","created_by_operation":"op_ab917da251704325a25f275c10d6d1cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_572b5baf15d504d8047314be4a3e15cc7dda6987d2d171a61d2fb29e59cbf374","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"crewaiinc/crewai@894898f84c4a snapshot 0d6e6df1020dcd85","timeframe":null},"slice_ids":["slc_1c71b0d4a4194d552b0165f55c22389afb46f34e25e1818ae194d37b9a36193c","slc_485350e4bcb7fbb39abe00fa788c7507e048bb5c9f1c6c87558da56741853629","slc_4cd2eb023e635f5c773fa9e01a8a6f1ee2f0bb41d99a0e90396e03e59aee84bf","slc_63b088ad3cc10ec941fa22c0ab9de22953fbe00d6651c9cfb86e1b4c27ddf465"],"source_ids":["src_d807d78c881350ef90d7a8a6a8c9a552"],"text":"New crew projects are JSON-first: agents live in `agents/*.jsonc`, tasks and crew settings in `crew.jsonc`, with optional `knowledge/`, `skills/`, and `tools/` directories; a `--classic` flag yields the older Python/YAML scaffold.","updated_at":"2026-09-14T03:43:14Z","updated_by_operation":"op_ab917da251704325a25f275c10d6d1cc"}
{"access":"public","created_at":"2026-09-14T03:43:14Z","created_by_operation":"op_ab917da251704325a25f275c10d6d1cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_60f51d9f110e62fbc9c8690d12adcebf09db8f54e746c97763183e00c7bd49cd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"crewaiinc/crewai@894898f84c4a snapshot 0d6e6df1020dcd85","timeframe":null},"slice_ids":["slc_58cd0b365a86d84da6429034ad96f059a1adb3298560254f3dbcb9fc86216a66","slc_abf45ba32e11579e7e38c463cab41c105e633b897f28915e7bdb81f548a47d00","slc_e46b401dfed584cf70f759e378ac7f46036eb64abc30ddf76f4e129a11c22bac"],"source_ids":["src_d807d78c881350ef90d7a8a6a8c9a552"],"text":"Repository development practice: contributors clone the repo, run `uv sync --all-groups --all-extras`, install pre-commit hooks, run tests with `uv run pytest lib/crewai/tests/ -x -q`, and type-check with `uv run mypy lib/`.","updated_at":"2026-09-14T03:43:14Z","updated_by_operation":"op_ab917da251704325a25f275c10d6d1cc"}
{"access":"public","created_at":"2026-09-14T03:43:14Z","created_by_operation":"op_ab917da251704325a25f275c10d6d1cc","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8317081bce5f36199ecbbba2fc62a3afbb2a4b9160a0f9a0a541f777f8fc9116","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"crewaiinc/crewai@894898f84c4a snapshot 0d6e6df1020dcd85","timeframe":null},"slice_ids":["slc_621abc2dde705983b5329de59b4fab003056dd4a4af547fac2d2dd5972aec199","slc_6668eea588f7e4b3d90ca7ebc4fb5b286e565fb79b39c7cb8945e16db03552c8"],"source_ids":["src_d807d78c881350ef90d7a8a6a8c9a552"],"text":"CrewAI is positioned for multi-step work needing specialized agents, tool use, structured outputs, human review, and workflows combining autonomous reasoning with explicit business logic.","updated_at":"2026-09-14T03:43:14Z","updated_by_operation":"op_ab917da251704325a25f275c10d6d1cc"}
