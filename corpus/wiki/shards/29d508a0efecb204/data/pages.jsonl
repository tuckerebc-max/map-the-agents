{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2cac8dca2e17d02754e8714a055336499d283c65596622727dd39fa1b7bbbb49"],"opposing_claim_ids":[],"text":"Repository development practice: the docs directory is a Nextra documentation template, installed with pnpm i and run locally with pnpm dev on localhost:3000, deployable to Vercel."}],"claim_ids":["clm_2cac8dca2e17d02754e8714a055336499d283c65596622727dd39fa1b7bbbb49"],"created_at":"2026-09-14T03:16:50Z","created_by_operation":"op_864fa068de6240818236c4f18c879d42","id":"pg_2c02b563a1025dd6937017bcb403b0b9","maturity":"draft","page_type":"source","path":"pages/sources/sweepai-sweep-docs-readme-md-a8b8b67bda4f-17bcb403b0b9.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1c2ff02fbf205c988b42940adc888253"],"title":"sweepai/sweep/docs/README.md @ a8b8b67bda4f","updated_at":"2026-09-14T03:16:50Z","updated_by_operation":"op_864fa068de6240818236c4f18c879d42"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_981faf4e4ac6c4757410ea7d5d889806321539f9bfca6f8c15eae3df5ee8cd91"],"opposing_claim_ids":[],"text":"A browser extension lets users create a Sweep issue from a repository page via a purple 'Make Sweep issue' button or ctrl-enter."}],"claim_ids":["clm_981faf4e4ac6c4757410ea7d5d889806321539f9bfca6f8c15eae3df5ee8cd91"],"created_at":"2026-09-14T03:16:50Z","created_by_operation":"op_864fa068de6240818236c4f18c879d42","id":"pg_3406c1cdb4ec532eb6feac558f6cd549","maturity":"draft","page_type":"source","path":"pages/sources/sweepai-sweep-docs-extension-post-install-md-a8b8b67bda4f-ac558f6cd549.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_89332c1113fb56ab9e55d7a07e1fa62f"],"title":"sweepai/sweep/docs/extension-post-install.md @ a8b8b67bda4f","updated_at":"2026-09-14T03:16:50Z","updated_by_operation":"op_864fa068de6240818236c4f18c879d42"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_94979290ff5f027d97b614993fece62d5061e2afc3c484d232fe3c111644f1c1"],"opposing_claim_ids":[],"text":"Documented limitations include repos over 5000 files, large refactors beyond 5 files or 300 changed lines, editing images/non-text assets, and accessing external APIs or fetching tokens."},{"claim_ids":["clm_d3d9ea9a6cd9fe3e4e74e73c7d279d62309a14699c7897b976885c67a4245213"],"opposing_claim_ids":[],"text":"Sweep is invoked from GitHub by titling an issue with a 'Sweep: ' prefix or by adding the Sweep label to an existing issue or PR."}],"claim_ids":["clm_94979290ff5f027d97b614993fece62d5061e2afc3c484d232fe3c111644f1c1","clm_d3d9ea9a6cd9fe3e4e74e73c7d279d62309a14699c7897b976885c67a4245213"],"created_at":"2026-09-14T03:16:50Z","created_by_operation":"op_864fa068de6240818236c4f18c879d42","id":"pg_530211e9a20057a6ab436deec596f74d","maturity":"draft","page_type":"source","path":"pages/sources/sweepai-sweep-docs-installation-md-a8b8b67bda4f-6deec596f74d.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5c774046eba45cffaa531eb605c2bd07"],"title":"sweepai/sweep/docs/installation.md @ a8b8b67bda4f","updated_at":"2026-09-14T03:16:50Z","updated_by_operation":"op_864fa068de6240818236c4f18c879d42"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_6b2051dd99a975751d363ca7d5ed6eb7c2748764940074f0453410a27889a65a"],"opposing_claim_ids":[],"text":"The README states the team is now building an AI coding assistant for JetBrains, available as a plugin, and thanks users for support of Sweep."}],"claim_ids":["clm_6b2051dd99a975751d363ca7d5ed6eb7c2748764940074f0453410a27889a65a"],"created_at":"2026-09-14T03:16:50Z","created_by_operation":"op_864fa068de6240818236c4f18c879d42","id":"pg_624c8e87ba25524980986ecab0c0cb58","maturity":"draft","page_type":"source","path":"pages/sources/sweepai-sweep-readme-md-a8b8b67bda4f-6ecab0c0cb58.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_cfa031e2e2d85b42a91dc12189e4cca9"],"title":"sweepai/sweep/README.md @ a8b8b67bda4f","updated_at":"2026-09-14T03:16:50Z","updated_by_operation":"op_864fa068de6240818236c4f18c879d42"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0819eb7020fb14be456ce1284b0ccb9b6f9305f7e4593a98c855f8df64fdadbf"],"opposing_claim_ids":[],"text":"By default Sweep reads logs and outputs from the repository's existing GitHub Actions runs; gha_enabled: False disables this."},{"claim_ids":["clm_59e6a2953b2025f067819b07959a163447c9c670c2aaefceb97e88044a9f4860"],"opposing_claim_ids":[],"text":"The blocked_dirs setting lists directories Sweep will not edit, e.g. .github/, restricting its write access within a repository."},{"claim_ids":["clm_87d6f46280444c64c484e474c34a3cafde30b29dc8cadc3e1c7e355f7642348f"],"opposing_claim_ids":[],"text":"Sweep is configured through a sweep.yaml file placed in the repository root, and Sweep can open a PR adding that config file after the first issue."},{"claim_ids":["clm_b89cb351da0d7fd4344434d8b81ada1f14a922c4efa1822d6399c8a92d93788c"],"opposing_claim_ids":[],"text":"When draft mode is enabled, all pull requests are created as drafts and GitHub Actions are not triggered for them."},{"claim_ids":["clm_d1115bd2a6c72aca659cafa27940cbf4cacacc2ceadff376c4017b34b79f7d6b"],"opposing_claim_ids":[],"text":"Repository development practice: the project's own sweep.yaml description instructs that sweepai/sweep is a Python 3.10 project with main API endpoints in sweepai/api.py and that code should adhere to PEP8."},{"claim_ids":["clm_d97216d1dd68b61fa06a0d1d5ee7ecbfd8d2909a479c2f0e1e100bf92a09bc68"],"opposing_claim_ids":[],"text":"The sweep.yaml config supports keys gha_enabled, branch, blocked_dirs, draft, and description, controlling GitHub Actions reading, target branch, excluded directories, draft PRs, and repo context."}],"claim_ids":["clm_0819eb7020fb14be456ce1284b0ccb9b6f9305f7e4593a98c855f8df64fdadbf","clm_59e6a2953b2025f067819b07959a163447c9c670c2aaefceb97e88044a9f4860","clm_87d6f46280444c64c484e474c34a3cafde30b29dc8cadc3e1c7e355f7642348f","clm_b89cb351da0d7fd4344434d8b81ada1f14a922c4efa1822d6399c8a92d93788c","clm_d1115bd2a6c72aca659cafa27940cbf4cacacc2ceadff376c4017b34b79f7d6b","clm_d97216d1dd68b61fa06a0d1d5ee7ecbfd8d2909a479c2f0e1e100bf92a09bc68"],"created_at":"2026-09-14T03:16:50Z","created_by_operation":"op_864fa068de6240818236c4f18c879d42","id":"pg_ae31a0675df559fc89a3b7b4ca5fce78","maturity":"draft","page_type":"source","path":"pages/sources/sweepai-sweep-docs-pages-usage-config-mdx-a8b8b67bda4f-b7b4ca5fce78.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_3d8c6ddb76ab57ea9dbe985900dd1d7c"],"title":"sweepai/sweep/docs/pages/usage/config.mdx @ a8b8b67bda4f","updated_at":"2026-09-14T03:16:50Z","updated_by_operation":"op_864fa068de6240818236c4f18c879d42"}
