{"access":"public","created_at":"2026-09-14T02:08:27Z","created_by_operation":"op_ab8c8fab8a7a484a862ae28f8aa179fa","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_db101c06b220ca423ece0da336cf784530718a49b4604c5ad283184a3281a9b5","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"junkyard22/orca@115d36b6cf51 snapshot 91cfee230c8891fa","timeframe":null},"slice_ids":["slc_28d7770036b474217e340971b0dc3b1d09e59d0c75a07781a48d3478446c2c63","slc_61f07bd8215cc24d2f4b9489d417239fe2c89780ef69aa525da82f297ba8d924"],"source_ids":["src_2f97b24b62ef54f7ac0a6d1290da55f9","src_57c50fe133b15750951cafc126703663"],"text":"The runtime is organized as packages: benson-core (intent parsing), orca-core (runtime, event bus, SQLite persistence), maestro-core (role routing), pappy-core (QC verdicts), miranda-core (compliance gate), workbench-core (tool execution), and dewey-core (context store).","updated_at":"2026-09-14T02:08:27Z","updated_by_operation":"op_ab8c8fab8a7a484a862ae28f8aa179fa"}
{"access":"public","created_at":"2026-09-14T02:08:27Z","created_by_operation":"op_ab8c8fab8a7a484a862ae28f8aa179fa","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_faaffa4602291bda137cbc7b1805486c72599f759b38ee556bebde40da8255c8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"junkyard22/orca@115d36b6cf51 snapshot 91cfee230c8891fa","timeframe":null},"slice_ids":["slc_1d9c9871ffe505a552f5907657c48cf5922026c322e5cc77c1b4bc8b66c60572","slc_98b6d1539e8fef5d91b1f2b326a7292655e6f8ba59fc211ac6ac93a95236e31f"],"source_ids":["src_2f97b24b62ef54f7ac0a6d1290da55f9","src_57c50fe133b15750951cafc126703663"],"text":"The pipeline routes user input through Benson (intent parsing) to an Orca Runtime that orchestrates Maestro role routing, Pappy QC (PASS/WARN/FAIL), and Miranda compliance with a repair loop.","updated_at":"2026-09-14T02:08:27Z","updated_by_operation":"op_ab8c8fab8a7a484a862ae28f8aa179fa"}
