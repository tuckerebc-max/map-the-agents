{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9b85594aa89880b575f21ae443e041f6af248061e6ed4ea2d0172aced96ee736"],"opposing_claim_ids":[],"text":"Repository development practice: docs/llm-wiki is a structured knowledge layer for humans and agents, with maintenance conventions like link-first navigation, code-over-docs conflict resolution, and recording contradictions in a dedicated page."}],"claim_ids":["clm_9b85594aa89880b575f21ae443e041f6af248061e6ed4ea2d0172aced96ee736"],"created_at":"2026-09-14T03:28:21Z","created_by_operation":"op_4e2c5cffd8784f619bdab6836a1de9e4","id":"pg_20c8f0d00c1c5161972a14470e3494f3","maturity":"draft","page_type":"source","path":"pages/sources/zykjshadow-async-docs-llm-wiki-readme-md-2c18a43c0711-14470e3494f3.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_55a43513f29a51b8bdb71964f18064e3"],"title":"ZYKJShadow/Async/docs/llm-wiki/README.md @ 2c18a43c0711","updated_at":"2026-09-14T03:28:21Z","updated_by_operation":"op_4e2c5cffd8784f619bdab6836a1de9e4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1192ffa2a0b37a5f49036b982808435da98179b1ba564a4060a730681bc54fd9"],"opposing_claim_ids":[],"text":"The Composer offers four modes: Agent (full auto), Plan (review before run), Ask (read-only Q&A), and Debug (systematic troubleshooting)."},{"claim_ids":["clm_151fecd3080948373995600bdc6cb29b510fa7a749b800a779195f456ede6f6d"],"opposing_claim_ids":[],"text":"Repository development practice: the repo can be run with npm install then npm run desktop, with dev, dev:debug, and icons scripts; the macOS test guide documents building unsigned packages via npm run release:mac:unsigned."},{"claim_ids":["clm_1dcdc63e0b306bc32504e6487a26dff5b33cb09c14ff7288268066fa044792ef"],"opposing_claim_ids":[],"text":"The app bridges to Telegram, Slack, Discord, and Feishu bots; inbound messages run through botRuntime, reusing the same agentLoop and teamOrchestrator paths as the desktop Composer, with per-integration model, workspace, and allowlist config."},{"claim_ids":["clm_25dedae062db33f48b086cf033d401372ff7b4b961011193e3ff2d92757f434b"],"opposing_claim_ids":[],"text":"The main process contains agentLoop.ts (multi-round tool calls, partial JSON streaming, tool repair, aborts), toolExecutor, LLM adapters, gitService, threadStore, settingsStore, LSP session, and PTY terminal."},{"claim_ids":["clm_3bd926cec47597347e1d73170fc26ff710f62d56582fc9e0d1bdee8f8c075a1c"],"opposing_claim_ids":[],"text":"The app is built from scratch on Electron + React + Monaco and is explicitly not a VS Code fork, with a deliberately lean two-process architecture and clear IPC boundaries."},{"claim_ids":["clm_45fcb1e2be6be76bde1a434255bf5684a9000faa50e24bd3d425e63561ac18d0"],"opposing_claim_ids":[],"text":"Team mode provides multi-agent collaboration with a Lead planning, specialist execution, reviewer verification, and plan-approval workflows; nested and background sub-agents are supported."},{"claim_ids":["clm_6955a29490e77e71088d227e93fe5d0786620084183b10016f28d4c783a84cc6"],"opposing_claim_ids":[],"text":"Threads, settings, and plans persist locally as JSON/Markdown under Electron userData (threads.json, settings.json, .async/plans/); threads.json is the authoritative conversation source."},{"claim_ids":["clm_d8727f401d90c41b4239a85badb49140e61e0990e207e57a8f1b920e14dc0719"],"opposing_claim_ids":[],"text":"Async IDE is an open-source, agent-first desktop workspace combining Agent, editor, Git, and terminal, licensed Apache 2.0, local-first with BYOK model access."},{"claim_ids":["clm_da09fcdeff3423c53e946475022543cc61c9be01abc1ef595ad4091e7dc83b33"],"opposing_claim_ids":[],"text":"Sensitive operations such as shell commands and file writes pass through approval gates, and the renderer's access to main-process capabilities is bounded by a preload whitelist."},{"claim_ids":["clm_e507b5c7998c2f0f364ad1da2f9472da73c332808025439167c2af55d341a5ed"],"opposing_claim_ids":[],"text":"The tech stack includes Electron 41, React 19, TypeScript 5.9, Monaco 0.52, xterm.js, OpenAI/Anthropic/Gemini SDKs, MCP SDK, and node-pty."}],"claim_ids":["clm_1192ffa2a0b37a5f49036b982808435da98179b1ba564a4060a730681bc54fd9","clm_151fecd3080948373995600bdc6cb29b510fa7a749b800a779195f456ede6f6d","clm_1dcdc63e0b306bc32504e6487a26dff5b33cb09c14ff7288268066fa044792ef","clm_25dedae062db33f48b086cf033d401372ff7b4b961011193e3ff2d92757f434b","clm_3bd926cec47597347e1d73170fc26ff710f62d56582fc9e0d1bdee8f8c075a1c","clm_45fcb1e2be6be76bde1a434255bf5684a9000faa50e24bd3d425e63561ac18d0","clm_6955a29490e77e71088d227e93fe5d0786620084183b10016f28d4c783a84cc6","clm_d8727f401d90c41b4239a85badb49140e61e0990e207e57a8f1b920e14dc0719","clm_da09fcdeff3423c53e946475022543cc61c9be01abc1ef595ad4091e7dc83b33","clm_e507b5c7998c2f0f364ad1da2f9472da73c332808025439167c2af55d341a5ed"],"created_at":"2026-09-14T03:28:21Z","created_by_operation":"op_4e2c5cffd8784f619bdab6836a1de9e4","id":"pg_5e8899380b405e5d8459ce1b6a5447c1","maturity":"draft","page_type":"source","path":"pages/sources/zykjshadow-async-readme-md-2c18a43c0711-ce1b6a5447c1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_a0e4a178f84d5963bfe2fae9ef3271ff"],"title":"ZYKJShadow/Async/README.md @ 2c18a43c0711","updated_at":"2026-09-14T03:28:21Z","updated_by_operation":"op_4e2c5cffd8784f619bdab6836a1de9e4"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_151fecd3080948373995600bdc6cb29b510fa7a749b800a779195f456ede6f6d"],"opposing_claim_ids":[],"text":"Repository development practice: the repo can be run with npm install then npm run desktop, with dev, dev:debug, and icons scripts; the macOS test guide documents building unsigned packages via npm run release:mac:unsigned."},{"claim_ids":["clm_d6d93e4f6ef214281b5521151b52e4b76f813957151e99a791a8c7898c698ea6"],"opposing_claim_ids":[],"text":"The macOS build is unsigned, so electron-updater cannot auto-install updates; the app instead downloads the ZIP to ~/Downloads and prompts manual installation, while Windows builds auto-install."}],"claim_ids":["clm_151fecd3080948373995600bdc6cb29b510fa7a749b800a779195f456ede6f6d","clm_d6d93e4f6ef214281b5521151b52e4b76f813957151e99a791a8c7898c698ea6"],"created_at":"2026-09-14T03:28:21Z","created_by_operation":"op_4e2c5cffd8784f619bdab6836a1de9e4","id":"pg_71debf19ea285ff6a5f2b0498304e84f","maturity":"draft","page_type":"source","path":"pages/sources/zykjshadow-async-docs-mac-mini-auto-update-test-md-2c18a43c0711-b0498304e84f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2d094b6d9b2e5055bf7786290f3aeff3"],"title":"ZYKJShadow/Async/docs/mac-mini-auto-update-test.md @ 2c18a43c0711","updated_at":"2026-09-14T03:28:21Z","updated_by_operation":"op_4e2c5cffd8784f619bdab6836a1de9e4"}
