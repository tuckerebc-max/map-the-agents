{"access":"public","created_at":"2026-09-14T04:41:43Z","created_by_operation":"op_8e5f710a7f714253a11f7171010b8469","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_2c3b28d9db15231e4826b283f7baad112332ab89ab7b004a04998dfb1429c83a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"2389-research/coven-gateway@11425046d196 snapshot 2bb9947e45a92f52","timeframe":null},"slice_ids":["slc_e48a3a82f461c1a27ac50843653fcb9e0c2eefd6da7e885d0619128347147e20","slc_ec0039b15c5bc14aac9aeb05dbb5a2ec5f584ce167cf2943853ad7874500d3dd"],"source_ids":["src_e426ba9267a55086860f5f7eeeb5052c"],"text":"Routing uses channel bindings that map frontend channels (e.g., Slack, Matrix) to specific agents for sticky agent assignment.","updated_at":"2026-09-14T04:41:43Z","updated_by_operation":"op_8e5f710a7f714253a11f7171010b8469"}
