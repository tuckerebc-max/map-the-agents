{"access":"public","created_at":"2026-09-14T04:41:43Z","created_by_operation":"op_8e5f710a7f714253a11f7171010b8469","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f1e6545c9d253fb6f03e4e8998182479064f125e8eb7ac791e80f06c6f65c845","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"2389-research/coven-gateway@11425046d196 snapshot 2bb9947e45a92f52","timeframe":null},"slice_ids":["slc_4f8935c6ffd3251285012c85534b675cbe0ba9e8f53ffd96b00888d504dad595","slc_8be795a5b5dfcf10f4a56ffccc7b7e5e726b6280814e6900f5460ac1f53db0d4"],"source_ids":["src_fc274a5c209e585a890e1d331284d5fb"],"text":"Agent-to-gateway messages use an AgentMessage wrapper (register, response, heartbeat, injection_ack, execute_pack_tool) and gateway-to-agent messages use a ServerMessage wrapper (welcome, send_message, shutdown, tool_approval, inject_context, cancel_request, pack_tool_result, registration_error).","updated_at":"2026-09-14T04:41:43Z","updated_by_operation":"op_8e5f710a7f714253a11f7171010b8469"}
