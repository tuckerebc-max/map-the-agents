{"access":"public","created_at":"2026-09-14T04:41:43Z","created_by_operation":"op_8e5f710a7f714253a11f7171010b8469","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a011f7c81a9e1278e455a6f50311fd3981e913f586e8ebb6e42e8b6d73345da9","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"2389-research/coven-gateway@11425046d196 snapshot 2bb9947e45a92f52","timeframe":null},"slice_ids":["slc_10efd1c3791554e8c2ef7860d0aa1df4144d61700cd7c9cafab7bdacc3d082fb","slc_29787b4177b29081d6d01db5b9ae83ae32d9a9c4d5b67f30236e33cb123660c9","slc_6226017cc823ed30e0ecd7845acccd1bc3ca1fb13894340fc2a062e1c518f82d","slc_f6362877021480484df4c16d2f1c165231305f215fa3406e4df1c381b5dbc7e3"],"source_ids":["src_fc274a5c209e585a890e1d331284d5fb"],"text":"Agents connect over a bidirectional gRPC stream to the AgentStream RPC of the coven.CovenControl service, defaulting to port 50051.","updated_at":"2026-09-14T04:41:43Z","updated_by_operation":"op_8e5f710a7f714253a11f7171010b8469"}
