{"access":"public","created_at":"2026-09-14T02:06:55Z","created_by_operation":"op_c19434b5c5f2462ead59f82c49eaa930","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_812e7cda94851aa9114e2ecc72cbc6b206da2fe6bde4a5ea226edf4a0a98e34c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"jina-ai/dev-gpt@f6c151f93b02 snapshot 065ec9400596f020","timeframe":null},"slice_ids":["slc_125ba69edf0526cb8e46fe7beb9ccbf0dac7c92b271104ac1fc7701c2c634edc","slc_12a68755260b34a9403a27978bf9c24490a4c68d67e9cb18a422546c52e619e2","slc_9a50bc9bfd57d697586263e51b00f25e251f6a484f079ef258b02f7b4f9b79a3","slc_d43dc8e94cdbd4c9fc85cea16a4e1cb42ef06d87ee8147e5f66cad3e0203ea19"],"source_ids":["src_88332432106155bc87df5a9423a67213"],"text":"After a successful build the tool pushes the Docker image to a registry, deploys the microservice, and generates a Streamlit playground for testing it in the browser.","updated_at":"2026-09-14T02:06:55Z","updated_by_operation":"op_c19434b5c5f2462ead59f82c49eaa930"}
{"access":"public","created_at":"2026-09-14T02:06:55Z","created_by_operation":"op_c19434b5c5f2462ead59f82c49eaa930","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8559396a59c34645883cfd92b96d9ab9a228d3c551116f6ea4f5d3388acb0cdc","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"jina-ai/dev-gpt@f6c151f93b02 snapshot 065ec9400596f020","timeframe":null},"slice_ids":["slc_a9effeb627d56f952d808da1a25f4ac6f29a60f746bfec4d4de42a9edfb7889d"],"source_ids":["src_728a35f58ebc52788d26b1b3b9f996ad"],"text":"Runtime dependencies include jina 3.15.1.dev14, openai>=0.27.5, langchain 0.0.153, streamlit 1.9.0, jcloud, jina-hubble-sdk, click, psutil, and pinned pydantic/typing packages.","updated_at":"2026-09-14T02:06:55Z","updated_by_operation":"op_c19434b5c5f2462ead59f82c49eaa930"}
{"access":"public","created_at":"2026-09-14T02:06:55Z","created_by_operation":"op_c19434b5c5f2462ead59f82c49eaa930","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8ec997263490fac80df01d97630b5606cd6420398616fa52a91140365d325001","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"jina-ai/dev-gpt@f6c151f93b02 snapshot 065ec9400596f020","timeframe":null},"slice_ids":["slc_12a68755260b34a9403a27978bf9c24490a4c68d67e9cb18a422546c52e619e2","slc_6b201d6ef3a551222ba26107af87e9cc06fe81b60f5a0de4738756cce018e419","slc_84a6885967afe0776d2f68f4b53e13a402d698f30d349c5fc02bf957ca77d782","slc_c40a773b763f025c724423fc03d71b6a57f132e9f7a8670d6bed360769792dec","slc_ddee4ae994bdf4ded84e9e589ce6b774f0433e231f1c9cb73e476d4ecf565f32"],"source_ids":["src_88332432106155bc87df5a9423a67213"],"text":"Generation works by proposing multiple implementation strategies, generating code plus tests and a Dockerfile per strategy, building the image, and using build error messages to retry; after 10 consecutive failures it moves to the next strategy.","updated_at":"2026-09-14T02:06:55Z","updated_by_operation":"op_c19434b5c5f2462ead59f82c49eaa930"}
{"access":"public","created_at":"2026-09-14T02:06:55Z","created_by_operation":"op_c19434b5c5f2462ead59f82c49eaa930","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ad205eb121e6f371542b12f04732a09cc7950edbb017482e3ec9e37a77ad618c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"jina-ai/dev-gpt@f6c151f93b02 snapshot 065ec9400596f020","timeframe":null},"slice_ids":["slc_e4862b303b8175a5e1b951afdf1c36d43947ab20e02c3b66c21e86978fc67a36"],"source_ids":["src_88332432106155bc87df5a9423a67213"],"text":"The model choice is user-selectable between gpt-3.5-turbo and gpt-4, with gpt-3.5-turbo described as roughly 10x cheaper but less capable of complex microservices; default is the largest model the key can access.","updated_at":"2026-09-14T02:06:55Z","updated_by_operation":"op_c19434b5c5f2462ead59f82c49eaa930"}
