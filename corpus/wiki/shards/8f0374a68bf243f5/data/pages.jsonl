{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0d3dccdb9abb51406f34f8944827388e82587dec11f32ffddba2f59cb064c3bc"],"opposing_claim_ids":[],"text":"AI assistance is integrated: users can ask AI at any time and apply or roll back its changes in one step."},{"claim_ids":["clm_2611fa23e121c82e0ca700fdebf39aa6515cda503abafb647625f10d8f691a02"],"opposing_claim_ids":[],"text":"The IDE takes an opinionated-core approach: there is no plugin marketplace; built-in capabilities cover the main path."},{"claim_ids":["clm_37cbaa81091a0b0bf76b8d8bf8ba81108ac25c3f92431c92a71a0dcf2c9ec442"],"opposing_claim_ids":[],"text":"The workspace combines editor, terminal, app preview, and AI panels in one place, letting users code while running commands and previewing."},{"claim_ids":["clm_3a256a377ba08fa9872b810f98c4571a37f25ff8af22914eab7669867275212b"],"opposing_claim_ids":[],"text":"The project is MIT licensed, with third-party notices located in the third_party/ directory."},{"claim_ids":["clm_7bd04fad145b63c48ee3b7c39aa2f11d81b62eb6103ad0fcd17b618a6a037cc3"],"opposing_claim_ids":[],"text":"Repository development practice: local development uses pnpm — 'pnpm install' to install, 'pnpm run dev' to run, plus build, lint, and typecheck commands."},{"claim_ids":["clm_a026bed58b1e21442105b55ae97d558c5d43be2d26a7a92c53197b7402c821ab"],"opposing_claim_ids":[],"text":"XCoding is described as a new IDE for Vibe Coding, built to stay light, clean, and fast with a low footprint."},{"claim_ids":["clm_b8535c065ae918553ce37e2635fb23b8813738ff5f744d89d9d230834ec46fa0"],"opposing_claim_ids":[],"text":"The product supports managing several projects in one window, with project switching via Cmd/Ctrl+1..8 shortcuts."}],"claim_ids":["clm_0d3dccdb9abb51406f34f8944827388e82587dec11f32ffddba2f59cb064c3bc","clm_2611fa23e121c82e0ca700fdebf39aa6515cda503abafb647625f10d8f691a02","clm_37cbaa81091a0b0bf76b8d8bf8ba81108ac25c3f92431c92a71a0dcf2c9ec442","clm_3a256a377ba08fa9872b810f98c4571a37f25ff8af22914eab7669867275212b","clm_7bd04fad145b63c48ee3b7c39aa2f11d81b62eb6103ad0fcd17b618a6a037cc3","clm_a026bed58b1e21442105b55ae97d558c5d43be2d26a7a92c53197b7402c821ab","clm_b8535c065ae918553ce37e2635fb23b8813738ff5f744d89d9d230834ec46fa0"],"created_at":"2026-09-14T03:23:45Z","created_by_operation":"op_bbc846aaeb104c6db5eb517020a4890d","id":"pg_05cf503f5d1458558354af54d004e904","maturity":"draft","page_type":"source","path":"pages/sources/xcodinglab-xcoding-readme-md-349a05eeb1e8-af54d004e904.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_bb7e1ed9a2e353d68886073da62cb2ea"],"title":"XCodingLab/XCoding/README.md @ 349a05eeb1e8","updated_at":"2026-09-14T03:23:45Z","updated_by_operation":"op_bbc846aaeb104c6db5eb517020a4890d"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2c82003ce49b23f6366e4681e44d956d4f7cb458fb3a42794ac4136cd4a5552e"],"opposing_claim_ids":[],"text":"Deleting a theme folder causes the app to fall back to builtin-classic without a blank screen, suggesting built-in fallback handling for missing themes."},{"claim_ids":["clm_57ead4dc81d871de9a1e2cf9dbcc24185bc051cb6e7e89c358afbba0cadde00c"],"opposing_claim_ids":[],"text":"Theme CSS is sandboxed: only relative paths inside the theme folder are allowed; remote/unsafe URLs are ignored and @import is stripped to block external resource loading."},{"claim_ids":["clm_6fb693d884be52eee3ce297bea6b3584daf52afd51e0b2d80cd3f5ca24f59a13"],"opposing_claim_ids":[],"text":"Settings supports importing .zip theme packs, prompting to replace existing themes with the same id; both single-top-level-directory and root-level theme.json zip layouts are accepted."},{"claim_ids":["clm_8106f3f7d1aa05bfe6eeb45687d4276555a62357f1c77e234446b7a7396af8bb"],"opposing_claim_ids":[],"text":"A theme pack must contain theme.json following VS Code Color Theme JSON structure (name/type/colors/tokenColors), with optional theme.css and assets/."},{"claim_ids":["clm_f1c311867b3ff7b31ba4ff761d3eab2c604fe495983e7f50d6bc652d458e2c8d"],"opposing_claim_ids":[],"text":"Theme packs are folders placed in userData/themes/ that appear in Settings for selection; Settings offers an 'Open Themes Folder' action."},{"claim_ids":["clm_f30bb1b43f25a89c9ad640a215ea61b91bbc1d6f3bb3ae0a26fc687b207e219d"],"opposing_claim_ids":[],"text":"Theme color keys map to --vscode-* CSS variables; a non-standard 'css' field can load extra CSS, and 'cssVars' supplies additional non-VSCode variables."},{"claim_ids":["clm_f3a927b48065f242a51d9df4aab26026dbc0865d513aef6fa60dca2b496f250c"],"opposing_claim_ids":[],"text":"XCoding ships a non-deletable default theme pack 'builtin-classic' (auto-recreated if missing) and writes an editable 'builtin-dark' (Aurora Dark) pack on first initialization."}],"claim_ids":["clm_2c82003ce49b23f6366e4681e44d956d4f7cb458fb3a42794ac4136cd4a5552e","clm_57ead4dc81d871de9a1e2cf9dbcc24185bc051cb6e7e89c358afbba0cadde00c","clm_6fb693d884be52eee3ce297bea6b3584daf52afd51e0b2d80cd3f5ca24f59a13","clm_8106f3f7d1aa05bfe6eeb45687d4276555a62357f1c77e234446b7a7396af8bb","clm_f1c311867b3ff7b31ba4ff761d3eab2c604fe495983e7f50d6bc652d458e2c8d","clm_f30bb1b43f25a89c9ad640a215ea61b91bbc1d6f3bb3ae0a26fc687b207e219d","clm_f3a927b48065f242a51d9df4aab26026dbc0865d513aef6fa60dca2b496f250c"],"created_at":"2026-09-14T03:23:46Z","created_by_operation":"op_bbc846aaeb104c6db5eb517020a4890d","id":"pg_05fe278f7c85526db7b49bb7a352f2f1","maturity":"draft","page_type":"source","path":"pages/sources/xcodinglab-xcoding-docs-theme-packs-md-349a05eeb1e8-9bb7a352f2f1.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_88239ff17cc05d9e9f31136e54f74da6"],"title":"XCodingLab/XCoding/docs/theme-packs.md @ 349a05eeb1e8","updated_at":"2026-09-14T03:23:46Z","updated_by_operation":"op_bbc846aaeb104c6db5eb517020a4890d"}
