{"access":"public","created_at":"2026-09-14T01:36:37Z","created_by_operation":"op_fe820e249ea641c4825409391282114e","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_f521cd83e367f14d3a34e0ebeb3692f4484f505c6e32694f982fbbaf2f9d03e6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"avelikiy/great_cto@5ca5a322ac7a snapshot 8463cdb3ab3d551e","timeframe":null},"slice_ids":["slc_9dce61fe34b79cc5a0dfff02460b126e035c45945725c902a8c2abb5655de875"],"source_ids":["src_1a415f8d2a32571a93cdadc5310d1391"],"text":"Decisions, lessons, and promoted patterns persist per project and globally across sessions, and an interrupted run resumes knowing which stages already ran.","updated_at":"2026-09-14T01:36:37Z","updated_by_operation":"op_fe820e249ea641c4825409391282114e"}
