{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0cf06be7e4d104f2c98dec6f82c1e9e725d070da3b3e4f92ec0b00bac6b7dd28"],"opposing_claim_ids":[],"text":"The privacy and data-handling guarantees appear only as README marketing claims; the snapshot contains no code that could verify them."},{"claim_ids":["clm_166dfa24068d4ca38b0eabc796408776dd13500032bf01562ad427475b45c005"],"opposing_claim_ids":[],"text":"Support resources include a help center page, desktop landing page, FAQ page, and a support email address."},{"claim_ids":["clm_51e7e9195283b7f492c4a07f0e65bc08df6c692f63fdcb19db2399dc9ee2e1c5"],"opposing_claim_ids":[],"text":"The Pro subscription bundles several components: a VS Code extension (Abacus AI Dev), ChatLLM Teams, DeepAgent, a desktop app, a voice-activated Listener, and the CLI."},{"claim_ids":["clm_530cb8fbabda723afb576a88b54555c14c475a4d8dce15645306587fbfd7693b"],"opposing_claim_ids":[],"text":"The README states the product routes work through multiple leading AI models (e.g., Sonnet 4.5, Opus 4.5) using DeepAgent's orchestration."},{"claim_ids":["clm_d2dc1a957fc8bd5bf379822a41e26b9c0acbc1304b5afabc228794741088deb2"],"opposing_claim_ids":[],"text":"Use of Abacus AI requires an active Abacus AI Pro subscription, per the license and terms section."},{"claim_ids":["clm_d4c178331e80d3059d1e964c79bd1691c2316ad8be698cf7c0301218619c2ac3"],"opposing_claim_ids":[],"text":"The product is distributed as a terminal coding agent CLI, installed globally via npm as @abacus-ai/cli and launched with the command 'abacusai'."},{"claim_ids":["clm_db00673d639750dba4f3c242af850705b3a1b2496099bbb7c891cebc22a03a12"],"opposing_claim_ids":[],"text":"The privacy section claims only referenced files are shared with the AI, no training occurs on user code, zero data retention agreements exist with the models, and transmission is encrypted."},{"claim_ids":["clm_e9e0ca6adfd259d0b40903c23ae3186dcccd13cd3b8c168439c4844306999886"],"opposing_claim_ids":[],"text":"Running the CLI launches a terminal agent providing the same AI models and coding capabilities as the desktop product, usable for code generation, debugging, and refactoring."}],"claim_ids":["clm_0cf06be7e4d104f2c98dec6f82c1e9e725d070da3b3e4f92ec0b00bac6b7dd28","clm_166dfa24068d4ca38b0eabc796408776dd13500032bf01562ad427475b45c005","clm_51e7e9195283b7f492c4a07f0e65bc08df6c692f63fdcb19db2399dc9ee2e1c5","clm_530cb8fbabda723afb576a88b54555c14c475a4d8dce15645306587fbfd7693b","clm_d2dc1a957fc8bd5bf379822a41e26b9c0acbc1304b5afabc228794741088deb2","clm_d4c178331e80d3059d1e964c79bd1691c2316ad8be698cf7c0301218619c2ac3","clm_db00673d639750dba4f3c242af850705b3a1b2496099bbb7c891cebc22a03a12","clm_e9e0ca6adfd259d0b40903c23ae3186dcccd13cd3b8c168439c4844306999886"],"created_at":"2026-09-14T01:29:50Z","created_by_operation":"op_3edecc7748764230a942bb9e2ac60354","id":"pg_d7facaa8353e53bda1eae5a4c0c97f25","maturity":"draft","page_type":"source","path":"pages/sources/abacusai-abacusai-desktop-readme-md-b4f988ce556d-e5a4c0c97f25.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f003433dfa775bb3bbac7962d3ddc0dd"],"title":"abacusai/abacusai-desktop/README.md @ b4f988ce556d","updated_at":"2026-09-14T01:29:50Z","updated_by_operation":"op_3edecc7748764230a942bb9e2ac60354"}
