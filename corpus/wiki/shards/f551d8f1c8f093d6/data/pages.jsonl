6d6","clm_6d89d3aa8ebdbd1f4a057a1a098d05d3c6fd97d75d016fb584c80a29fb2989ac","clm_95d91e9bdd23f93ed0d1357e3367f872766d741981e2f487a1c59fd5aee0df64","clm_9c3a5f1370a4fd338e36f3b39026d555ec610090021541e41fd60c25542c6532","clm_bab0f642bd4682e07151be6145be1d06974dfbd81a29c020aa8737539c19000e","clm_bb0c595ad37cead759be14608f5c310a64d9f8337ff3bd0a0b22ccef951e4cf2","clm_ccf94eed339c67bc763a66aa2ab40dabaa36447202723e0d309b4e71f2619314","clm_d0376602231b7ac1f2b44c49e737a237c4746a29a9cb94e742b776d435792f50","clm_db9e030816a1592753a254da052d257dbcd03a2e68f50a318caab0d71429e76e","clm_ee1c7e3a469c40ab4b52dfe691caee5df7fb176dd2c62451cce7378de60c88ec","clm_f77e93194bca2d26a0a0bb68a939caeb6084a33c3c6bc7c6d3c077a86bb95328"],"created_at":"2026-09-14T01:39:55Z","created_by_operation":"op_0073be04ef3e4503a0e3393011850f02","id":"pg_7782becfe3cd5479b5cea523df1397f4","maturity":"draft","page_type":"entity","path":"pages/entities/chaitin-monkeycode-a523df1397f4.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"chaitin/monkeycode","updated_at":"2026-09-14T01:39:55Z","updated_by_operation":"op_0073be04ef3e4503a0e3393011850f02"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_000e608dbcf5f6733e241207f06231e40a66814076f6af739dc71ea1db9bfa95"],"opposing_claim_ids":[],"text":"Tasks run in server-side cloud development environments; build, test, and preview workflows are executed in the cloud rather than on local machines."},{"claim_ids":["clm_49697c7cb891b4b63b16615681881eaf974ac2bfd21baafd84239ebd9c7ae350"],"opposing_claim_ids":[],"text":"MonkeyCode is licensed under the GNU Affero General Public License v3.0."},{"claim_ids":["clm_51a375d178a48a2c0674497c3190b18f7e85fc72b0bc0adbb1f5f8109a297734"],"opposing_claim_ids":[],"text":"The product targets deployment inside enterprise networks shared with an R&D team, with an online hosted environment (managed dev environments, built-in LLMs, mobile support) as an alternative."},{"claim_ids":["clm_574db900ad1c95baab900c5ddf1bdb682715c08d5bc929ec8b50a6133c01cff6"],"opposing_claim_ids":[],"text":"MonkeyCode is described as an open-source enterprise-grade AI development platform combining development environment management, AI model/task management, and project requirement management."},{"claim_ids":["clm_ccf94eed339c67bc763a66aa2ab40dabaa36447202723e0d309b4e71f2619314"],"opposing_claim_ids":[],"text":"The platform integrates multiple LLMs including GLM, Kimi, MiniMax, Qwen, and DeepSeek, switchable per task type or chosen manually."},{"claim_ids":["clm_d0376602231b7ac1f2b44c49e737a237c4746a29a9cb94e742b776d435792f50"],"opposing_claim_ids":[],"text":"Self-hosted install is via a curl-fetched bash script, with recommended minimums of 2C/4GB/40GB for the console and 8C/16GB/100GB for development-environment hosts."},{"claim_ids":["clm_db9e030816a1592753a254da052d257dbcd03a2e68f50a318caab0d71429e76e"],"opposing_claim_ids":[],"text":"A comparison table marks MonkeyCode as lacking local IDE, local CLI, and code completion, while claiming cloud environments, automated PR/MR review, team collaboration, and private deployment."},{"claim_ids":["clm_ee1c7e3a469c40ab4b52dfe691caee5df7fb176dd2c62451cce7378de60c88ec"],"opposing_claim_ids":[],"text":"Native iOS and Android support is claimed, keeping PC and mobile data in sync so agents can continue running tasks while the user is away."}],"claim_ids":["clm_000e608dbcf5f6733e241207f06231e40a66814076f6af739dc71ea1db9bfa95","clm_49697c7cb891b4b63b16615681881eaf974ac2bfd21baafd84239ebd9c7ae350","clm_51a375d178a48a2c0674497c3190b18f7e85fc72b0bc0adbb1f5f8109a297734","clm_574db900ad1c95baab900c5ddf1bdb682715c08d5bc929ec8b50a6133c01cff6","clm_ccf94eed339c67bc763a66aa2ab40dabaa36447202723e0d309b4e71f2619314","clm_d0376602231b7ac1f2b44c49e737a237c4746a29a9cb94e742b776d435792f50","clm_db9e030816a1592753a254da052d257dbcd03a2e68f50a318caab0d71429e76e","clm_ee1c7e3a469c40ab4b52dfe691caee5df7fb176dd2c62451cce7378de60c88ec"],"created_at":"2026-09-14T01:39:55Z","created_by_operation":"op_0073be04ef3e4503a0e3393011850f02","id":"pg_935b9881370d5ba49c66fa4a2228aa36","maturity":"draft","page_type":"source","path":"pages/sources/chaitin-monkeycode-readme-md-a67aef068778-fa4a2228aa36.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_19babcfda8f35910893d52760d613d38"],"title":"chaitin/MonkeyCode/README.md @ a67aef068778","updated_at":"2026-09-14T01:39:55Z","updated_by_operation":"op_0073be04ef3e4503a0e3393011850f02"}
