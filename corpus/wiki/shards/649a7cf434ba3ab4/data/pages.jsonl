72fe85ea","clm_e0814f36d299d52be5e1186498df052e916c8b65e0f2278c71a2e0600a0dbfa2","clm_e496b6ef98a44ca543b57ba0e35e3d957a5960b25a0d668bc2bb8f7c576821f6","clm_eaebe6aacefec997e47210a9018d2960f8b36aaeb3825a557027bbd36a4e9512","clm_fc49aa3aba3966266d452b4e9afc40fb1dec4bea97059c7366292f6883a220ff"],"created_at":"2026-09-14T04:09:28Z","created_by_operation":"op_987e24a19f284983a8708d5f9149ef60","id":"pg_0426c8505d385dd4bca9a780edb985ea","maturity":"draft","page_type":"entity","path":"pages/entities/memorax-ai-memorax-code-a780edb985ea.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"memorax-ai/memorax-code","updated_at":"2026-09-14T04:09:28Z","updated_by_operation":"op_987e24a19f284983a8708d5f9149ef60"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_00ef1fa849729e7a115af31d85fd43cd1fb0031427e120f1f4efca65a9467d02"],"opposing_claim_ids":[],"text":"Memory is divided into four categories: Coding Memory (engineering lessons), Repo Memory (repository knowledge), Personal Memory (user preferences), and Procedure Memory (reusable task steps)."},{"claim_ids":["clm_240adc51d6340123da53373e82062821f0b3eac1fd436951d486d551c7b93822"],"opposing_claim_ids":[],"text":"The product targets the problem that new coding-agent sessions start without prior architecture knowledge, failed attempts, repository rules, or working preferences, providing a shared memory layer across supported clients."},{"claim_ids":["clm_6a09ff5d063ad441a6116c83ff33e5750b49f3acfc6a16a9225f1e97e4c3b3e3"],"opposing_claim_ids":[],"text":"Local trace capture is on by default for supported clients and retained traces under MEMORAX_CODE_HOME may include prompts, responses, recalled memory, reminder text, and local paths; it can be switched to metadata-only or disabled."},{"claim_ids":["clm_6e76580d4a2d5f02c2872490438c8d5dd3af395e3f83599b0b98ede8ba8bf69b"],"opposing_claim_ids":[],"text":"Personal and Procedure Memory stay in the current repository under .repo_memory/; writes compare existing content so equivalent requests make no change and conflicts update or supersede entries."},{"claim_ids":["clm_dedbb3ef52a30450ea7d4107a30759a1d7326e42ad2b0a8731b9af85351d99f2"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are directed to read CONTRIBUTING.md before making changes, and AGENTS.md defines working rules for coding agents, runtime/data invariants, and Git handoff requirements."},{"claim_ids":["clm_dfdc7aa10d901b5177984db51d457bc54dda47d840c7823fcf94c64072fe85ea"],"opposing_claim_ids":[],"text":"On Linux, guest credentials require /usr/bin/secret-tool from libsecret and an available Secret Service, and MemoraX search and writeback require network access."},{"claim_ids":["clm_e0814f36d299d52be5e1186498df052e916c8b65e0f2278c71a2e0600a0dbfa2"],"opposing_claim_ids":[],"text":"The package requires Node.js 20 or newer (Node 24 LTS recommended), and DeepSeek Harness releases require Node ^22.19.0 || >=24.0.0 with pnpm on PATH; MemoraX Code does not install or update DSH."},{"claim_ids":["clm_e496b6ef98a44ca543b57ba0e35e3d957a5960b25a0d668bc2bb8f7c576821f6"],"opposing_claim_ids":[],"text":"The MemoraX platform does not currently support attaching a Mark ID to an already-registered account, so guest users must obtain the Mark ID before registering to keep guest memory."},{"claim_ids":["clm_fc49aa3aba3966266d452b4e9afc40fb1dec4bea97059c7366292f6883a220ff"],"opposing_claim_ids":[],"text":"Trae can use the Skill for Repo Memory but does not currently expose a headless worker for automatic Repo Memory maintenance, and automatic quota reminders are not listed for DeepSeek Harness."}],"claim_ids":["clm_00ef1fa849729e7a115af31d85fd43cd1fb0031427e120f1f4efca65a9467d02","clm_240adc51d6340123da53373e82062821f0b3eac1fd436951d486d551c7b93822","clm_6a09ff5d063ad441a6116c83ff33e5750b49f3acfc6a16a9225f1e97e4c3b3e3","clm_6e76580d4a2d5f02c2872490438c8d5dd3af395e3f83599b0b98ede8ba8bf69b","clm_dedbb3ef52a30450ea7d4107a30759a1d7326e42ad2b0a8731b9af85351d99f2","clm_dfdc7aa10d901b5177984db51d457bc54dda47d840c7823fcf94c64072fe85ea","clm_e0814f36d299d52be5e1186498df052e916c8b65e0f2278c71a2e0600a0dbfa2","clm_e496b6ef98a44ca543b57ba0e35e3d957a5960b25a0d668bc2bb8f7c576821f6","clm_fc49aa3aba3966266d452b4e9afc40fb1dec4bea97059c7366292f6883a220ff"],"created_at":"2026-09-14T04:09:28Z","created_by_operation":"op_987e24a19f284983a8708d5f9149ef60","id":"pg_1cc56772532d58b6b82bdf5ebb1c415f","maturity":"draft","page_type":"source","path":"pages/sources/memorax-ai-memorax-code-readme-md-1525c20fbcad-df5ebb1c415f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_acab5a616cbc5342920196d674bce990"],"title":"memorax-ai/memorax-code/README.md @ 1525c20fbcad","updated_at":"2026-09-14T04:09:28Z","updated_by_operation":"op_987e24a19f284983a8708d5f9149ef60"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2799c9f6f086415b6b0a5f59ed65bdede1342f137fd7f8f58fdd0c7e1af1c0ae"],"opposing_claim_ids":[],"text":"Automatic Search on turn-start Hooks is disabled by default; the usual retrieval path is the client invoking memorax-cli through the shared Skill, while Hooks still provide identity, scope, and writeback coordination."},{"claim_ids":["clm_33c49998aa682dd0b060d2ac0b03789410322cce02f10502e48299c9b766fc10"],"opposing_claim_ids":[],"text":"Adapter Hooks and plugins communicate with the Backend via versioned, client-qualified local HTTP commands carrying JSON and token headers, with a request deadline and optional cancellation; the transport does not retry or start the Backend."},{"claim_ids":["clm_4db40c8d6b9342e787b37f5653b3f25f3dd0ce716d22e502bac1edf1c8baf3a6"],"opposing_claim_ids":[],"text":"After setup, the managed Backend schedules a detached updater that locks, resolves a channel target, installs an exact published version via the package-replacement path, and reuses non-interactive setup reconciliation."},{"claim_ids":["clm_66c97585ac8a651a827302d786cec72fe60923a46c914bfe5b1e9d16e5d90c54"],"opposing_claim_ids":[],"text":"The system integrates seven coding clients with one local Backend, a capability-oriented modular monolith, surrounded by six client deployment adapters, a shared runtime source layer, and an npm assembly/CLI layer."},{"claim_ids":["clm_74376d914b1cfd1da92279991a398dc08c40b9d10f10db9e750b238ffd11797c"],"opposing_claim_ids":[],"text":"The Backend owns the local memory service, repository scope, trace, lifecycle, and update scheduling, but must not own model execution, provider credentials, or native transcript creation."},{"claim_ids":["clm_dedbb3ef52a30450ea7d4107a30759a1d7326e42ad2b0a8731b9af85351d99f2"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are directed to read CONTRIBUTING.md before making changes, and AGENTS.md defines working rules for coding agents, runtime/data invariants, and Git handoff requirements."},{"claim_ids":["clm_eaebe6aacefec997e47210a9018d2960f8b36aaeb3825a557027bbd36a4e9512"],"opposing_claim_ids":[],"text":"adapter-common is a shared source layer consumed by the Backend and all six adapters, providing connection primitives, credential storage, locks, and Hook transport; it is not an independently deployed service."}],"claim_ids":["clm_2799c9f6f086415b6b0a5f59ed65bdede1342f137fd7f8f58fdd0c7e1af1c0ae","clm_33c49998aa682dd0b060d2ac0b03789410322cce02f10502e48299c9b766fc10","clm_4db40c8d6b9342e787b37f5653b3f25f3dd0ce716d22e502bac1edf1c8baf3a6","clm_66c97585ac8a651a827302d786cec72fe60923a46c914bfe5b1e9d16e5d90c54","clm_74376d914b1cfd1da92279991a398dc08c40b9d10f10db9e750b238ffd11797c","clm_dedbb3ef52a30450ea7d4107a30759a1d7326e42ad2b0a8731b9af85351d99f2","clm_eaebe6aacefec997e47210a9018d2960f8b36aaeb3825a557027bbd36a4e9512"],"created_at":"2026-09-14T04:09:28Z","created_by_operation":"op_987e24a19f284983a8708d5f9149ef60","id":"pg_81943465ead8543e8082c9cdc0f19912","maturity":"draft","page_type":"source","path":"pages/sources/memorax-ai-memorax-code-architecture-md-1525c20fbcad-c9cdc0f19912.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_4075b6c35e0f503fac600b7ee3dc8a2f"],"title":"memorax-ai/memorax-code/ARCHITECTURE.md @ 1525c20fbcad","updated_at":"2026-09-14T04:09:28Z","updated_by_operation":"op_987e24a19f284983a8708d5f9149ef60"}
