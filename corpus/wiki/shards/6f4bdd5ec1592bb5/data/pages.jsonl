1d11405e9","clm_9c833ae391b9e0006427e8438706b0d699baaec5f1fe3e0bce087b4678115cb7","clm_af975098dfe5e6c90cec3cae92ed1a0547cd6f25c6568b6208cd03c8b5487095","clm_b10e31b6d60b0c5864dbe169525dc05ca1da7088b10f4057f5ca5ea610642038","clm_c91721ef053953c0cf728c2c5a45f19c6b2ee4630c8f8ce774bcb08a8bc23505","clm_cf859cfb002088c1cde2700bca96d733a8a447f98c2847a294417de7fb108001","clm_ddc9a086391a35f3908fbb8272286a6c758c3c2a6afdfe7ea210073e34b17302","clm_dfedc3d12440d425f2ce8f6881281c57b133753d9b037201982221e7b52afa56","clm_e5220aead22c812ec249be6580763989d48953c8f8b1e0a192f13dceb35e99ed"],"created_at":"2026-09-14T04:31:25Z","created_by_operation":"op_9d255cbaafe64bd4bbb7cf151b1b2751","id":"pg_bdaa6bb08bd85df08598e26e39c1d876","maturity":"draft","page_type":"entity","path":"pages/entities/whut09-opencode-plusplus-e26e39c1d876.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"whut09/opencode-plusplus","updated_at":"2026-09-14T04:31:25Z","updated_by_operation":"op_9d255cbaafe64bd4bbb7cf151b1b2751"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:31:25Z","created_by_operation":"op_9d255cbaafe64bd4bbb7cf151b1b2751","id":"pg_f29e9837827a5c8eba07e07657247a2c","maturity":"draft","page_type":"source","path":"pages/sources/whut09-opencode-plusplus-docs-reference-config-md-598767170bb7-e07657247a2c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d157117d4b2e5faa84930386dad4a787"],"title":"whut09/opencode-plusplus/docs/reference/config.md @ 598767170bb7","updated_at":"2026-09-14T04:31:25Z","updated_by_operation":"op_9d255cbaafe64bd4bbb7cf151b1b2751"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_35454948309d6e8a93ea6dc8c844098d21097f1fad274250449c8ba6d1494ba1"],"opposing_claim_ids":[],"text":"The Command Guard represents repository semantics: it can defer operations as approval-required or hard-stop policy-blocked destructive commands, protected paths, unknown project commands, or evidence tampering; native auto approval cannot override the latter."},{"claim_ids":["clm_368005b66b4e53e89a1e2acb5fb5bae43c3caa9a9bd21f6f7d9624e785e51087"],"opposing_claim_ids":[],"text":"A harness-led developer mode, opencode-plusplus orchestrate, runs a bounded loop (task, prepare, execute, collect, evaluate, decide, persist) around an explicitly configured executor, reporting finalize, repair, repack, block, rollback, or human-review."},{"claim_ids":["clm_3a4916dd5bc6963ea37cea113cedaea187e167d96cc4442d78b02b4b00ba984a"],"opposing_claim_ids":[],"text":"The architecture is described as Guard modules around coding agents: Context, Hallucination, Boundary, Regression, Evidence, Impact, and Loop Guards, plus an Executor Adapter and Trace Normalizer."},{"claim_ids":["clm_3e6c402bbfa9db0f736dea9ecf2172bb812f08ea2fbc3343c7a1335856e05adb"],"opposing_claim_ids":[],"text":"The v2 architecture has five responsibilities: Repo Scanner, Context Planner, Context Pack Composer, Agent Harness Layer, and an Integration Layer exposing CLI, stdio MCP server, and retriever adapters."},{"claim_ids":["clm_5bf6237f880c0d6a1295194e977d94214dd8e35c65a7c44740c298725007698f"],"opposing_claim_ids":[],"text":"Indexing uses the TypeScript Compiler API for TS/JS, optional Tree-sitter for Python with stdlib AST and regex fallback, and generic metadata for other files; real tokenizer modes use js-tiktoken with a chars_approx fallback."},{"claim_ids":["clm_9c833ae391b9e0006427e8438706b0d699baaec5f1fe3e0bce087b4678115cb7"],"opposing_claim_ids":[],"text":"The loop state file records state, previousState, repository/context/diff hashes, lastAction, blocking nextAction, allowedActions, satisfiedEvidence, and missingEvidence for resumable runs."},{"claim_ids":["clm_b10e31b6d60b0c5864dbe169525dc05ca1da7088b10f4057f5ca5ea610642038"],"opposing_claim_ids":[],"text":"The project targets helping coding agents safely complete concrete changes, distinguishing itself from repo summarizers, README generators, and raw RAG loaders."},{"claim_ids":["clm_ddc9a086391a35f3908fbb8272286a6c758c3c2a6afdfe7ea210073e34b17302"],"opposing_claim_ids":[],"text":"The loop controller decides next steps such as start-agent, rebuild-context, replan, expand-context, repair-contracts, add-or-update-tests, run-tests, or ready-for-review, each with a confidence score and blocking flag."},{"claim_ids":["clm_e5220aead22c812ec249be6580763989d48953c8f8b1e0a192f13dceb35e99ed"],"opposing_claim_ids":[],"text":"Documented MCP tools include opencode_plusplus_build, plan, pack, retrieve, tests, impact, verify, and explain, plus experimental runtime loop tools for start/evaluate/repair/finalize flows."}],"claim_ids":["clm_35454948309d6e8a93ea6dc8c844098d21097f1fad274250449c8ba6d1494ba1","clm_368005b66b4e53e89a1e2acb5fb5bae43c3caa9a9bd21f6f7d9624e785e51087","clm_3a4916dd5bc6963ea37cea113cedaea187e167d96cc4442d78b02b4b00ba984a","clm_3e6c402bbfa9db0f736dea9ecf2172bb812f08ea2fbc3343c7a1335856e05adb","clm_5bf6237f880c0d6a1295194e977d94214dd8e35c65a7c44740c298725007698f","clm_9c833ae391b9e0006427e8438706b0d699baaec5f1fe3e0bce087b4678115cb7","clm_b10e31b6d60b0c5864dbe169525dc05ca1da7088b10f4057f5ca5ea610642038","clm_ddc9a086391a35f3908fbb8272286a6c758c3c2a6afdfe7ea210073e34b17302","clm_e5220aead22c812ec249be6580763989d48953c8f8b1e0a192f13dceb35e99ed"],"created_at":"2026-09-14T04:31:25Z","created_by_operation":"op_9d255cbaafe64bd4bbb7cf151b1b2751","id":"pg_f873f668e6865304a6d0e4dbefe04782","maturity":"draft","page_type":"source","path":"pages/sources/whut09-opencode-plusplus-docs-concepts-architecture-md-598767170bb7-e4dbefe04782.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5ca61327d48553cfb2e260e324106a8f"],"title":"whut09/opencode-plusplus/docs/concepts/architecture.md @ 598767170bb7","updated_at":"2026-09-14T04:31:25Z","updated_by_operation":"op_9d255cbaafe64bd4bbb7cf151b1b2751"}
