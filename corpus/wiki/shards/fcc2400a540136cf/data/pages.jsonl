{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_a69730671e4f381b2ea2cdaad632a8cf9f335b90c5c580ae12bc60a1c16930c9"],"opposing_claim_ids":[],"text":"Repository development practice: dev dependencies include pytest, pytest-asyncio, pytest-cov, pytest-mock, and pre-commit; the project targets Python 3.9+ for development."}],"claim_ids":["clm_a69730671e4f381b2ea2cdaad632a8cf9f335b90c5c580ae12bc60a1c16930c9"],"created_at":"2026-09-14T05:05:10Z","created_by_operation":"op_8266962be2404f08894d152a98685446","id":"pg_2a17566d26d1513ba9c8e528e5065067","maturity":"draft","page_type":"source","path":"pages/sources/coderamp-labs-gitingest-requirements-dev-txt-4e259a02fe72-e528e5065067.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_b326fdde2a3e5942bbe34c8966182a45"],"title":"coderamp-labs/gitingest/requirements-dev.txt @ 4e259a02fe72","updated_at":"2026-09-14T05:05:10Z","updated_by_operation":"op_8266962be2404f08894d152a98685446"}
