{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0e4be72b416fdf3ac13c00ed81e56019a43f275c9c02e1b897523d6bcdd7a931"],"opposing_claim_ids":[],"text":"Flexpilot is a VS Code extension described as an open-source, native alternative to GitHub Copilot, distributed via the VS Code Marketplace."},{"claim_ids":["clm_2df8dfa68bfecdf5465d9b4ee6db9762140b3e636f01a04a46ffc02cdc66e073"],"opposing_claim_ids":[],"text":"The extension is no longer actively maintained; the project says it will still try to address issues and pull requests but will not add new features."},{"claim_ids":["clm_49447f446d55ff610b78ad3fca4a1c4be773cf7e0bfb2e81e409bbaffc662bf1"],"opposing_claim_ids":[],"text":"The README emphasizes a native VS Code experience without webviews and lets users supply their own API keys and choose their preferred AI providers and models."},{"claim_ids":["clm_c34fa0e2906ab4ff105a8c18a0e58235c6851a0bf0d159c629c36a9b6d9a810d"],"opposing_claim_ids":[],"text":"The README lists supported AI providers including Anthropic, OpenAI, Azure OpenAI, Groq, Google Gemini, Mistral AI, Ollama, and several self-hosted backends such as vLLM and llama-cpp-python."},{"claim_ids":["clm_d32a10098a9fb4b7bf59edf65294e64064f452be78d49d26881e55e42b650f6a"],"opposing_claim_ids":[],"text":"The project positions itself as relevant to developers wanting flexible, provider-agnostic AI assistance in VS Code, with a roadmap pointing to multi-file edits and workspace-agent features in the successor product."}],"claim_ids":["clm_0e4be72b416fdf3ac13c00ed81e56019a43f275c9c02e1b897523d6bcdd7a931","clm_2df8dfa68bfecdf5465d9b4ee6db9762140b3e636f01a04a46ffc02cdc66e073","clm_49447f446d55ff610b78ad3fca4a1c4be773cf7e0bfb2e81e409bbaffc662bf1","clm_c34fa0e2906ab4ff105a8c18a0e58235c6851a0bf0d159c629c36a9b6d9a810d","clm_d32a10098a9fb4b7bf59edf65294e64064f452be78d49d26881e55e42b650f6a"],"created_at":"2026-09-14T03:07:46Z","created_by_operation":"op_3354dd30a0194cfaa620bbd913d45f3a","id":"pg_c68c4f108dd757f383a