{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_3540e81a9b96daded5f0c58f1121be65803e1bd33ba7f27259e580331d609f8b"],"opposing_claim_ids":[],"text":"Repository development practice: contributing requires agreeing to a Contributor License Agreement that grants Flexpilot rights to use contributions commercially and to potentially change the license away from GPLv3."},{"claim_ids":["clm_4d4cc078b415df89ffdd4fb4e0c3e92f3518f0bce5a3d9fd7dbf4003b42f3143"],"opposing_claim_ids":[],"text":"Repository development practice: the project adopts a Contributor Covenant-based Code of Conduct, with reports directed to contact@flexpilot.ai and an enforcement ladder from warnings to permanent bans."},{"claim_ids":["clm_a7c8f82ff28c99fd8e4f4e686695ab0753653787d6dc362a3b42684816b138a4"],"opposing_claim_ids":[],"text":"Repository development practice: contributors are told to fork and clone the repo, run npm install, debug the extension in VS Code, then run npm run lint and npm run format before opening a pull request."}],"claim_ids":["clm_3540e81a9b96daded5f0c58f1121be65803e1bd33ba7f27259e580331d609f8b","clm_4d4cc078b415df89ffdd4fb4e0c3e92f3518f0bce5a3d9fd7dbf4003b42f3143","clm_a7c8f82ff28c99fd8e4f4e686695ab0753653787d6dc362a3b42684816b138a4"],"created_at":"2026-09-14T03:07:46Z","created_by_operation":"op_3354dd30a0194cfaa620bbd913d45f3a","id":"pg_0d05d2e8db1251d5a7a5df819f3e0463","maturity":"draft","page_type":"source","path":"pages/sources/flexpilot-ai-vscode-extension-contributing-md-360af0191b36-df819f3e0463.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d1a567a823035748b01d40bc4fc3a887"],"title":"flexpilot-ai/vscode-extension/CONTRIBUTING.md @ 360af0191b36","updated_at":"2026-09-14T03:07:46Z","updated_by_operation":"op_3354dd30a0194cfaa620bbd913d45f3a"}
