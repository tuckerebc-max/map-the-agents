ity":"draft","page_type":"entity","path":"pages/entities/ovh-shai-2968bbad728c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"ovh/shai","updated_at":"2026-09-14T02:28:49Z","updated_by_operation":"op_2116b5c5c32549eb93e343075717e3b5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_8f6bf1b85a7ef7e3485a6ef0f7ef0f797fed24481db1e4c527fbb1a9ef64492c"],"opposing_claim_ids":[],"text":"The workspace is split into shai-cli (CLI entry point), shai-core (agent, state machine, protocol), and shai-llm (LLM provider wrappers), plus docs, examples, and tests directories."}],"claim_ids":["clm_8f6bf1b85a7ef7e3485a6ef0f7ef0f797fed24481db1e4c527fbb1a9ef64492c"],"created_at":"2026-09-14T02:28:49Z","created_by_operation":"op_2116b5c5c32549eb93e343075717e3b5","id":"pg_c25c98898b2a5e2aba2017b08c7f709f","maturity":"draft","page_type":"source","path":"pages/sources/ovh-shai-shai-md-f076f6128a82-17b08c7f709f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_05da3b29145b573085b6d4d8d1bc8013"],"title":"ovh/shai/SHAI.md @ f076f6128a82","updated_at":"2026-09-14T02:28:49Z","updated_by_operation":"op_2116b5c5c32549eb93e343075717e3b5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1a498401b475351423595817b011178975e27f1638efeed6f0342f1d1c7bb5a4"],"opposing_claim_ids":[],"text":"Repository development practice: releases require bumping versions in four crate Cargo.toml files, running `cargo check`, then tagging and pushing to trigger the release workflow."},{"claim_ids":["clm_79f8c66b114821cf2b88d278ae8cb2c6afada08cbba690717ec9f972b020b362"],"opposing_claim_ids":[],"text":"Repository development practice: contributions must follow coding style rules, be unit-tested and documented, be DCO signed-off, and be submitted via GitHub pull requests under Apache 2.0."}],"claim_ids":["clm_1a498401b475351423595817b011178975e27f1638efeed6f0342f1d1c7bb5a4","clm_79f8c66b114821cf2b88d278ae8cb2c6afada08cbba690717ec9f972b020b362"],"created_at":"2026-09-14T02:28:49Z","created_by_operation":"op_2116b5c5c32549eb93e343075717e3b5","id":"pg_e1be4185755754b8bd77e3957060abe6","maturity":"draft","page_type":"source","path":"pages/sources/ovh-shai-contributing-md-f076f6128a82-e3957060abe6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_447979d033c051e38cf611c6c3d6eb1f"],"title":"ovh/shai/CONTRIBUTING.md @ f076f6128a82","updated_at":"2026-09-14T02:28:49Z","updated_by_operation":"op_2116b5c5c32549eb93e343075717e3b5"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2997ed0ba4e96f2f5ffb4631d9acf945bb0a46a9f0b2a815b8dea17b4da4a4c2"],"opposing_claim_ids":[],"text":"Shai works with multiple LLM providers including OVHcloud (default, anonymous with rate limits), OpenAI, and other compatible endpoints; `shai auth` configures sign-in or provider selection."},{"claim_ids":["clm_322c932866838250b1c026716928ebc10b193200b2978be15ba95b165d75b1d8"],"opposing_claim_ids":[],"text":"Server options include `--port` (default 3000), `--ephemeral` to spawn a new agent per request, and an optional agent name for a persistent session."},{"claim_ids":["clm_33944129e45cb908a9a37110b1a74fc440a964a49bcbb4c792db28cecf059aca"],"opposing_claim_ids":[],"text":"For OVHcloud, function-calling models (e.g. gpt-oss-120b, gpt-oss-20b, Mistral-Small-3.2-24B) are recommended, or any model with structured output forced via the `/set so` option."},{"claim_ids":["clm_8b2ab68d870210ff235cb484e2e8612cedacee102d068334f30914f20513d08c"],"opposing_claim_ids":[],"text":"Project context is loaded from a `SHAI.md` file at the project root, which the agent automatically reads as additional context."},{"claim_ids":["clm_8f6a78a445246f4cfa675c9028c09718d38a2e2278561389d52c4a30a2b98379"],"opposing_claim_ids":[],"text":"Custom agents can be defined in separate config files placed under ~/.config/shai/agents/, listed with `shai agent list`, and run via `shai agent <name>`; MCP and OAuth are supported."},{"claim_ids":["clm_9b8adc6e473988b91de43b21e2b92eed6d602ed5627a71b9cea7aca62f2997c0"],"opposing_claim_ids":[],"text":"A shell-assistant mode hooks the terminal via `shai on`/`shai off`, sending the last command, output, and error code to the LLM provider to suggest fixes for failed commands."},{"claim_ids":["clm_9d07ff204b709f04d399425f08c613df4dbc61d9fbd96e4f937cd6046dbfafd0"],"opposing_claim_ids":[],"text":"Running `shai` starts an interactive terminal coding agent for chatting, writing code, fixing bugs, and answering questions."},{"claim_ids":["clm_e3ea0d966f27771d903ceb230a09c4abbb1636b8a608efb5b49b8bb5d1e5d038"],"opposing_claim_ids":[],"text":"Headless mode accepts a piped prompt and streams events to stderr; shai can be told to return the whole conversation as a trace, which enables chaining shai calls."},{"claim_ids":["clm_f2000a24957a8e4d8cb8c74d6dd098f5f2247083be63ee756873cb098a51248e"],"opposing_claim_ids":[],"text":"`shai serve --port 3000` runs an HTTP service with SSE streaming and OpenAI-compatible endpoints including POST /v1/chat/completions and POST /v1/responses."}],"claim_ids":["clm_2997ed0ba4e96f2f5ffb4631d9acf945bb0a46a9f0b2a815b8dea17b4da4a4c2","clm_322c932866838250b1c026716928ebc10b193200b2978be15ba95b165d75b1d8","clm_33944129e45cb908a9a37110b1a74fc440a964a49bcbb4c792db28cecf059aca","clm_8b2ab68d870210ff235cb484e2e8612cedacee102d068334f30914f20513d08c","clm_8f6a78a445246f4cfa675c9028c09718d38a2e2278561389d52c4a30a2b98379","clm_9b8adc6e473988b91de43b21e2b92eed6d602ed5627a71b9cea7aca62f2997c0","clm_9d07ff204b709f04d399425f08c613df4dbc61d9fbd96e4f937cd6046dbfafd0","clm_e3ea0d966f27771d903ceb230a09c4abbb1636b8a608efb5b49b8bb5d1e5d038","clm_f2000a24957a8e4d8cb8c74d6dd098f5f2247083be63ee756873cb098a51248e"],"created_at":"2026-09-14T02:28:49Z","created_by_operation":"op_2116b5c5c32549eb93e343075717e3b5","id":"pg_fba1e665b0a05d4e9b6553ddeb815133","maturity":"draft","page_type":"source","path":"pages/sources/ovh-shai-readme-md-f076f6128a82-53ddeb815133.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9504e92061f2538886fa885257981a0d"],"title":"ovh/shai/README.md @ f076f6128a82","updated_at":"2026-09-14T02:28:49Z","updated_by_operation":"op_2116b5c5c32549eb93e343075717e3b5"}
