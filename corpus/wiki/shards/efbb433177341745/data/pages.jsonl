{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_88899e3ebfd37182860039dc12636d1864e335e157b0bd1695782bf5dcde592a"],"opposing_claim_ids":[],"text":"Capstone deliverables include clean commented code, a project README, and at least one public result-sharing form such as a demo, repo, or blog post."},{"claim_ids":["clm_ae7e0e1c7343bdfeda57a0e937e092299072ac051a0a4ab57b20435f53da889c"],"opposing_claim_ids":[],"text":"Capstone projects reference tools such as LangChain, Hugging Face, Chroma/FAISS, PyTorch/TensorFlow, scikit-learn, OpenAI Gym, and Stable-Baselines3."},{"claim_ids":["clm_df8c6d64f885f7454af16c2b378f2cff70871f4194c0974916909c8be80d1179"],"opposing_claim_ids":[],"text":"Capstone ideas include a RAG chat assistant, image classifier with deployment, text classifier, LangChain task-automation agent, and an RL game agent."}],"claim_ids":["clm_88899e3ebfd37182860039dc12636d1864e335e157b0bd1695782bf5dcde592a","clm_ae7e0e1c7343bdfeda57a0e937e092299072ac051a0a4ab57b20435f53da889c","clm_df8c6d64f885f7454af16c2b378f2cff70871f4194c0974916909c8be80d1179"],"created_at":"2026-09-14T03:30:44Z","created_by_operation":"op_6004065afb8e4b27beeff4b650d7236b","id":"pg_1370d3f210b152dea98195fdbe0b5658","maturity":"draft","page_type":"source","path":"pages/sources/agenticailabs-ai-engineering-roadmap-07-capstone-projects-readme-md-3d-95fdbe0b5658.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f727aeeeff745cd8938690b04cda30fc"],"title":"AgenticAiLabs/Ai-Engineering-Roadmap/07_capstone-projects_README.md @ 3d81071f7f90","updated_at":"2026-09-14T03:30:44Z","updated_by_operation":"op_6004065afb8e4b27beeff4b650d7236b"}
