{"access":"public","created_at":"2026-09-14T01:53:26Z","created_by_operation":"op_337a8354a992446a8fa4ab090c6a43e1","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1994a38214d3ac14c93e344c135617c9cd90e713ee0c3db67fa8eddaa4e301b4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"halfwhey/claudraband@d2b6a7d1836f snapshot 4c0e8208ff0b9c40","timeframe":null},"slice_ids":["slc_59d42ee54e7923deb8564a692e86f69c9e55fc6efa6b405a01e6427040ae0f8a","slc_9b9d2afa13501bf91eaf81f8298d989a027f6aa18b2f6a4e59b2c2703c684493","slc_ddca066174c0b7a78b094f3afbe409f8347e9824b0a133424ac21a0140a2d6f6"],"source_ids":["src_4aaf7a35bb9d5b6e80ba4c2a7d77bc8d","src_cd8f2d1b608f5409945f74809316fa30"],"text":"Live sessions are tracked in ~/.claudraband/; the sessions command lists only live entries, while prompt or send with --session auto-resume saved sessions even when no longer live.","updated_at":"2026-09-14T01:53:26Z","updated_by_operation":"op_337a8354a992446a8fa4ab090c6a43e1"}
