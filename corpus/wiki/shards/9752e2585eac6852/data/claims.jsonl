{"access":"public","created_at":"2026-09-14T02:20:20Z","created_by_operation":"op_ceb2ef3200344c7a98ea28eabf8f320d","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c43095695e7fb51ac011438e4a1b9b176b80be40736eff18437f0deed7a769b1","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"morganlinton/albatross@6f20178d81c6 snapshot efa5ca6ad18bbc10","timeframe":null},"slice_ids":["slc_610216c23ce1a01630ab21fcd72c5c687a789e715e75e27fb7f4b3ad49e2dfb7","slc_8c51de0f793ef260477ad4f3aff4339999f465fa1bd71062771a466631b43308"],"source_ids":["src_5664aa6a6ad353fcbf3ec91e36d43a8b"],"text":"Session memory features include /index and /map for project memory, /remember and /forget for durable notes, /compact for in-place summarization, and /reset which writes a handoff artifact to .albatross/continue.md and starts a fresh session seeded only with it.","updated_at":"2026-09-14T02:20:20Z","updated_by_operation":"op_ceb2ef3200344c7a98ea28eabf8f320d"}
