c0e9355253","clm_e5234c4eaa048e769a5b9fbef00c1ecbafab0988e769af2338a00bed5d20ffae","clm_f7efcf77a459a96486140b592a859b2f8667401f121077f92669dee1a7756582"],"created_at":"2026-09-14T04:13:10Z","created_by_operation":"op_42119bee40c84356b128cd625de76244","id":"pg_b02f583dacaa513dbab93f4445aa9f9b","maturity":"draft","page_type":"entity","path":"pages/entities/nisarg38-claude-northstar-3f4445aa9f9b.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"nisarg38/claude-northstar","updated_at":"2026-09-14T04:13:10Z","updated_by_operation":"op_42119bee40c84356b128cd625de76244"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_28b59b57b6991d23b35e89f2e1ac89a29d6282ada921bfa5c2ebccf5281c64e5"],"opposing_claim_ids":[],"text":"Repository development practice: state files have defined update triggers — project-state.json after each session, decisions.md on technical choices, progress-log.md at session end, and north-star.md when the vision changes."},{"claim_ids":["clm_8319bbe8444eed661041f438f4289e3f9c99dca86db0366f4c13462cffe8b824"],"opposing_claim_ids":[],"text":"The framework follows a quality pipeline before merging significant work: developer completes, QA verifies, reviewer approves, then merge."},{"claim_ids":["clm_94dd46b257a455c049d503af548b56873f660ab78fa5059919e2b0784a4d302d"],"opposing_claim_ids":[],"text":"Repository development practice: the installed CLAUDE.md instructs the agent to always read north-star.md, project-state.json, and decisions.md at session start, then either capture a new vision or report state and work autonomously."},{"claim_ids":["clm_d3830b80a00ff9cc1f3082bf3417517cfed6082a6a80ecc059e759c0e9355253"],"opposing_claim_ids":[],"text":"Repository development practice: sub-agents are spawned via the Task tool with subagent_type 'general-purpose', using prompt files from .claude/harness/prompts/ with injected context."}],"claim_ids":["clm_28b59b57b6991d23b35e89f2e1ac89a29d6282ada921bfa5c2ebccf5281c64e5","clm_8319bbe8444eed661041f438f4289e3f9c99dca86db0366f4c13462cffe8b824","clm_94dd46b257a455c049d503af548b56873f660ab78fa5059919e2b0784a4d302d","clm_d3830b80a00ff9cc1f3082bf3417517cfed6082a6a80ecc059e759c0e9355253"],"created_at":"2026-09-14T04:13:10Z","created_by_operation":"op_42119bee40c84356b128cd625de76244","id":"pg_cc2bd0027c465d3a9af23c3533f92dee","maturity":"draft","page_type":"source","path":"pages/sources/nisarg38-claude-northstar-claude-md-43d89d5aba90-3c3533f92dee.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d0f29a747aca5214ab16d96d7302d625"],"title":"Nisarg38/claude-northstar/CLAUDE.md @ 43d89d5aba90","updated_at":"2026-09-14T04:13:10Z","updated_by_operation":"op_42119bee40c84356b128cd625de76244"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0303ccd53b17b04ee65988a25bfb67faec8d26edbc1507b5ff18f18412f7beda"],"opposing_claim_ids":[],"text":"Jujutsu (jj) is an optional companion tool: North Star works with plain git, while jj enables isolated workspaces for parallel tasks, conflicts-as-data, and rollback via an operation log."},{"claim_ids":["clm_0489701e42f73cd95bc2247a10a506732746d97f0d91347cd1ed3f2769e9bf16"],"opposing_claim_ids":[],"text":"The project targets CLI coding agents such as Claude Code and OpenCode, aiming to shift them from task-by-task execution to autonomous progress toward a shared project vision."},{"claim_ids":["clm_7471c36dc24cb073ed61562de3e22a9cd3b181085747e1ef444a1ab348d31733"],"opposing_claim_ids":[],"text":"Work is delegated to five sub-agent roles: Product Researcher, Strategist, Developer, QA, and Reviewer, each used at a specific phase such as planning, implementation, or pre-merge review."},{"claim_ids":["clm_76d55ba738aaa858b336b3a824f8ae5aecb79528860a7d41789693078dd38706"],"opposing_claim_ids":[],"text":"The autonomous work loop is documented as a repeating cycle of ANALYZE state, PLAN next work, EXECUTE, and EVALUATE progress."},{"claim_ids":["clm_8319bbe8444eed661041f438f4289e3f9c99dca86db0366f4c13462cffe8b824"],"opposing_claim_ids":[],"text":"The framework follows a quality pipeline before merging significant work: developer completes, QA verifies, reviewer approves, then merge."},{"claim_ids":["clm_8382d046c07f4cf9219170e997a6080cdee3c5ca4a488554d010763d68d115bc"],"opposing_claim_ids":[],"text":"The agent interrupts the user only for major architecture decisions, ambiguous requirements, and milestone reviews, and deliberately avoids asking about routine task completions or minor implementation choices."},{"claim_ids":["clm_840476d217666629e4660c4177c51349692af76b7391bcd0ca572a72a1c4013f"],"opposing_claim_ids":[],"text":"Installation creates a .claude/harness directory containing north-star.md, project-state.json, decisions.md, progress-log.md, and five sub-agent prompt templates under prompts/."},{"claim_ids":["clm_936ed3a82a06a41a77eace97728745e4e9c0f48f582dfcdf944cc818d146e314"],"opposing_claim_ids":[],"text":"The tool is distributed as the npm package claude-northstar and operated via npx commands: init, status, and uninstall."},{"claim_ids":["clm_b30c620ec388e595fedae723fde60d91f722efc2f7ed80a15e5a61ef880f0f11"],"opposing_claim_ids":[],"text":"The framework positions the CLI agent session as a Tech Lead that understands the vision, plans milestones, coordinates sub-agents, and asks only strategic questions."},{"claim_ids":["clm_e5234c4eaa048e769a5b9fbef00c1ecbafab0988e769af2338a00bed5d20ffae"],"opposing_claim_ids":[],"text":"An alternative install path fetches an install.sh script from the GitHub repository via curl and pipes it to bash."},{"claim_ids":["clm_f7efcf77a459a96486140b592a859b2f8667401f121077f92669dee1a7756582"],"opposing_claim_ids":[],"text":"project-state.json persists milestones with status and progress values, the current focus, and identified gaps, enabling sessions to resume when the user says 'continue'."}],"claim_ids":["clm_0303ccd53b17b04ee65988a25bfb67faec8d26edbc1507b5ff18f18412f7beda","clm_0489701e42f73cd95bc2247a10a506732746d97f0d91347cd1ed3f2769e9bf16","clm_7471c36dc24cb073ed61562de3e22a9cd3b181085747e1ef444a1ab348d31733","clm_76d55ba738aaa858b336b3a824f8ae5aecb79528860a7d41789693078dd38706","clm_8319bbe8444eed661041f438f4289e3f9c99dca86db0366f4c13462cffe8b824","clm_8382d046c07f4cf9219170e997a6080cdee3c5ca4a488554d010763d68d115bc","clm_840476d217666629e4660c4177c51349692af76b7391bcd0ca572a72a1c4013f","clm_936ed3a82a06a41a77eace97728745e4e9c0f48f582dfcdf944cc818d146e314","clm_b30c620ec388e595fedae723fde60d91f722efc2f7ed80a15e5a61ef880f0f11","clm_e5234c4eaa048e769a5b9fbef00c1ecbafab0988e769af2338a00bed5d20ffae","clm_f7efcf77a459a96486140b592a859b2f8667401f121077f92669dee1a7756582"],"created_at":"2026-09-14T04:13:10Z","created_by_operation":"op_42119bee40c84356b128cd625de76244","id":"pg_fd090bbd0fca5d8f9c80568a11388372","maturity":"draft","page_type":"source","path":"pages/sources/nisarg38-claude-northstar-readme-md-43d89d5aba90-568a11388372.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e49c75f431395e57b98602d9a3568526"],"title":"Nisarg38/claude-northstar/README.md @ 43d89d5aba90","updated_at":"2026-09-14T04:13:10Z","updated_by_operation":"op_42119bee40c84356b128cd625de76244"}
