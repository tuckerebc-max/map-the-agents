{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0924ad49db39570d530ed487cad3586c095be3646022e3d7b76cb4b91bf29007"],"opposing_claim_ids":[],"text":"The repository includes Claude Code plugins that extend functionality with custom commands and agents, documented in a plugins directory."},{"claim_ids":["clm_128a56451a5937fd7b9d42924185330da225df6169438ac72fbc78f9acd797b5"],"opposing_claim_ids":[],"text":"A `/bug` command exists inside Claude Code for reporting issues directly, and GitHub issues are an alternative feedback channel."},{"claim_ids":["clm_289496b4929f75d631d1857d5a8faa1bb796480c897eaf904aa31a4326d55bb0"],"opposing_claim_ids":[],"text":"Recommended installation is via a curl install script on macOS/Linux and a PowerShell script on Windows; Homebrew and WinGet are also offered, while npm installation is deprecated."},{"claim_ids":["clm_7106b8908e7930f6129779c2c4be9098452a9ade5c8d6b8206bd6c532ecb905c"],"opposing_claim_ids":[],"text":"npm-based installation is explicitly marked deprecated in favor of other recommended methods."},{"claim_ids":["clm_afd09e89874a80ff8c59cd03a44b39356c1a24f793ce29f83de7a5e8261cb38d"],"opposing_claim_ids":[],"text":"After installing, users navigate to their project directory and run the `claude` command to start."},{"claim_ids":["clm_b7a63ab175c58093635fdb7b8e86b4f938bd8c061713497cf2dec5ce4788b160"],"opposing_claim_ids":[],"text":"Claude Code is described as an agentic coding tool that runs in the terminal, understands the codebase, executes routine tasks, explains code, and handles git workflows via natural language commands."},{"claim_ids":["clm_c17e1083455ef35b0d88248f355d5b0d7cf46951d7b355146c09ea1b830ad673"],"opposing_claim_ids":[],"text":"The tool can be used in a terminal, in an IDE, or by tagging @claude on GitHub, per the README."},{"claim_ids":["clm_c5e6df0a33c047e10dd5ec0f7834df8bd6082e082e83576dfd6fa06e050b46f2"],"opposing_claim_ids":[],"text":"A Node.js 18+ badge appears in the README, and the npm package is @anthropic-ai/claude-code."},{"claim_ids":["clm_db663f37d57a56f09ca9a98aca9843d7af3b1a3efc55bada68b730e1fd0471a4"],"opposing_claim_ids":[],"text":"The README states feedback collection includes usage data such as code acceptance or rejections, conversation data, and /bug submissions, with safeguards like limited retention and no use of feedback for model training."}],"claim_ids":["clm_0924ad49db39570d530ed487cad3586c095be3646022e3d7b76cb4b91bf29007","clm_128a56451a5937fd7b9d42924185330da225df6169438ac72fbc78f9acd797b5","clm_289496b4929f75d631d1857d5a8faa1bb796480c897eaf904aa31a4326d55bb0","clm_7106b8908e7930f6129779c2c4be9098452a9ade5c8d6b8206bd6c532ecb905c","clm_afd09e89874a80ff8c59cd03a44b39356c1a24f793ce29f83de7a5e8261cb38d","clm_b7a63ab175c58093635fdb7b8e86b4f938bd8c061713497cf2dec5ce4788b160","clm_c17e1083455ef35b0d88248f355d5b0d7cf46951d7b355146c09ea1b830ad673","clm_c5e6df0a33c047e10dd5ec0f7834df8bd6082e082e83576dfd6fa06e050b46f2","clm_db663f37d57a56f09ca9a98aca9843d7af3b1a3efc55bada68b730e1fd0471a4"],"created_at":"2026-09-14T01:34:29Z","created_by_operation":"op_167d163d95dd49788f94a677bcb72d98","id":"pg_686d781bb8645d56bc496175c9371f3e","maturity":"draft","page_type":"source","path":"pages/sources/anthropics-claude-code-readme-md-b5932767f3ac-6175c9371f3e.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_20acfc20f4145040be114f1bd7f2e383"],"title":"anthropics/claude-code/README.md @ b5932767f3ac","updated_at":"2026-09-14T01:34:29Z","updated_by_operation":"op_167d163d95dd49788f94a677bcb72d98"}
