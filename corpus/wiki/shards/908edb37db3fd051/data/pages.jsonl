{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_2af9f142dc6fe250783b00e62ad5d053c00d0711d690e94b15ba48653a37cb8e"],"opposing_claim_ids":[],"text":"A sandbox.enabled setting (default false) enables a Linux bubblewrap sandbox for process-based tools."},{"claim_ids":["clm_3d4d1180066861d1a5ddf7e8e8c6c07630123a613be962879662edea0ad3bcc3"],"opposing_claim_ids":[],"text":"The permissionMode setting defaults to \"ask\" and allows ask, auto, or yolo, controlling default tool-execution approval behavior."}],"claim_ids":["clm_2af9f142dc6fe250783b00e62ad5d053c00d0711d690e94b15ba48653a37cb8e","clm_3d4d1180066861d1a5ddf7e8e8c6c07630123a613be962879662edea0ad3bcc3"],"created_at":"2026-09-14T03:12:36Z","created_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04","id":"pg_c7a908dab0dc50efa93b78402c820283","maturity":"draft","page_type":"source","path":"pages/sources/rokoss21-iosm-cli-docs-configuration-generated-md-6cb971ca9c23-78402c820283.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_df857df969215ab5995ce2c3e587cef8"],"title":"rokoss21/iosm-cli/docs/configuration.generated.md @ 6cb971ca9c23","updated_at":"2026-09-14T03:12:36Z","updated_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:12:36Z","created_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04","id":"pg_e1ef1166059453a8808e89f9dc69036f","maturity":"draft","page_type":"source","path":"pages/sources/rokoss21-iosm-cli-improvement-checklist-md-6cb971ca9c23-89f9dc69036f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_68b55d82b88558c09d50a36a20d1cda6"],"title":"rokoss21/iosm-cli/improvement-checklist.md @ 6cb971ca9c23","updated_at":"2026-09-14T03:12:36Z","updated_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_0be1cc2ba787de562b79c51def908d2c4f4b1c78f3c0997d0795c4a4be830872"],"opposing_claim_ids":[],"text":"Unsupported ACP methods return JSON-RPC -32601 with reason=capability_not_supported; the ACP adapter is additive, leaving --mode rpc unchanged, and unsupported features fail with capability-level rejections rather than crashes."},{"claim_ids":["clm_d5a030ee615a2e8d25aa434d10f704a5fbceca884ad6a6d07cef4f69cece19c6"],"opposing_claim_ids":[],"text":"ACP methods map to internal runtime actions: session start/prompt/steer/follow_up/abort/state, builtin slash command dispatch, resumable shell exec sessions with stdin writes, and permission bridge responses supporting scope=once|turn|session."},{"claim_ids":["clm_e8831cd744a1b75fd08ac7668c8f462edb19b9c0b0de8f53568c6525dd424f50"],"opposing_claim_ids":[],"text":"The product supports an ACP compatibility mode via --mode acp, with a documented acp.handshake returning protocol version and capabilities including streaming, permissionBridge, toolEvents, sessionLifecycle, backCompatRpc, and execSessions."}],"claim_ids":["clm_0be1cc2ba787de562b79c51def908d2c4f4b1c78f3c0997d0795c4a4be830872","clm_d5a030ee615a2e8d25aa434d10f704a5fbceca884ad6a6d07cef4f69cece19c6","clm_e8831cd744a1b75fd08ac7668c8f462edb19b9c0b0de8f53568c6525dd424f50"],"created_at":"2026-09-14T03:12:36Z","created_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04","id":"pg_ec204c9a2cdb52db98cb8d37ad7594a7","maturity":"draft","page_type":"source","path":"pages/sources/rokoss21-iosm-cli-docs-acp-rpc-mapping-md-6cb971ca9c23-8d37ad7594a7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_236b147557c95192808d5fa4cf92dd32"],"title":"rokoss21/iosm-cli/docs/acp-rpc-mapping.md @ 6cb971ca9c23","updated_at":"2026-09-14T03:12:36Z","updated_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04"}
