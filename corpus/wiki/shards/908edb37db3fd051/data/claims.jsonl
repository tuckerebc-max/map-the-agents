{"access":"public","created_at":"2026-09-14T03:12:36Z","created_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_b75920c89206e8abc5e0d46a940a641afdf0ba8908586cdb712fcf0dc7dfe8fd","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"rokoss21/iosm-cli@6cb971ca9c23 snapshot d07da58db67add57","timeframe":null},"slice_ids":["slc_023505a5d61116c581b2a2afcb5e0d914877dd471979c4571217a8f4e2c215f2","slc_06707096f49254a968c4d45de8d876fca9b035f8f4226c4b0c4ddc704f7a6edd","slc_10296b0ab619b8c5804be362107177401c454a8d1ecb9306baaa593fa6453a95"],"source_ids":["src_6c3b6c944a3f54428c513ea1b99cf934"],"text":"iosm-spec.md is a normative specification of the IOSM (Improve, Optimize, Shrink, Modularize) methodology, defining ordered phases, quality gates, normalized metrics, evidence-confidence rules, and an aggregate IOSM-Index score.","updated_at":"2026-09-14T03:12:36Z","updated_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04"}
{"access":"public","created_at":"2026-09-14T03:12:36Z","created_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_c1edaa8f67958d6ec4f988e69f8d9fd8b156d9a720a67484bc02df5c1fca6a46","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"rokoss21/iosm-cli@6cb971ca9c23 snapshot d07da58db67add57","timeframe":null},"slice_ids":["slc_aeb015aa3d34b5aa586b1bfde91aac9038002037dd3b66faf5bb7ded437aecfe","slc_e3a566a251f524917410f99807950203543ea9cf4efcd732df6218c942663192"],"source_ids":["src_a29e183fd7d4575b8389d2b4a90806a4"],"text":"Profiles control behavior and available tools: full grants all built-ins, plan is a read-only bundle, iosm adds IOSM cycle context, and meta is orchestration-first for multi-agent delegation; db_run is enabled only in write-capable profiles (full, meta, iosm).","updated_at":"2026-09-14T03:12:36Z","updated_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04"}
