{"access":"public","created_at":"2026-09-14T03:12:36Z","created_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_d5a030ee615a2e8d25aa434d10f704a5fbceca884ad6a6d07cef4f69cece19c6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"rokoss21/iosm-cli@6cb971ca9c23 snapshot d07da58db67add57","timeframe":null},"slice_ids":["slc_f1933d4af8a3396f224e981b4b1a18e73ac934ca0b105d9be42126d869df87ac"],"source_ids":["src_236b147557c95192808d5fa4cf92dd32"],"text":"ACP methods map to internal runtime actions: session start/prompt/steer/follow_up/abort/state, builtin slash command dispatch, resumable shell exec sessions with stdin writes, and permission bridge responses supporting scope=once|turn|session.","updated_at":"2026-09-14T03:12:36Z","updated_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04"}
{"access":"public","created_at":"2026-09-14T03:12:36Z","created_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_e8831cd744a1b75fd08ac7668c8f462edb19b9c0b0de8f53568c6525dd424f50","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"rokoss21/iosm-cli@6cb971ca9c23 snapshot d07da58db67add57","timeframe":null},"slice_ids":["slc_b7cae0bbb6fbe9a322f694b499c64b4d1e0511eb4164c590a6348d395b01b126","slc_eaee4b97a1efeeec04486cbf3eb7ee8cc5f978987c6c0b1d6ca098409759ce18"],"source_ids":["src_236b147557c95192808d5fa4cf92dd32"],"text":"The product supports an ACP compatibility mode via --mode acp, with a documented acp.handshake returning protocol version and capabilities including streaming, permissionBridge, toolEvents, sessionLifecycle, backCompatRpc, and execSessions.","updated_at":"2026-09-14T03:12:36Z","updated_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04"}
{"access":"public","created_at":"2026-09-14T03:12:36Z","created_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_feda1eb8196f0b2bae19da4afe24bd56939ec1b9d03740ef44cc854177f653fe","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"rokoss21/iosm-cli@6cb971ca9c23 snapshot d07da58db67add57","timeframe":null},"slice_ids":["slc_2812e95ba7d28e2b060dacda4286b7227e90aacab2f354551e44fb94fbbb3681","slc_9e8cd13262534fd549ac4cd7f76e4e04ff5c96bac2c281785ba576eb35de4455"],"source_ids":["src_a29e183fd7d4575b8389d2b4a90806a4"],"text":"Sessions persist under ~/.iosm/agent/sessions with JSONL trace files in session-traces; semantic search indexes are cached per project hash under ~/.iosm/agent/semantic/indexes containing meta.json, chunks.jsonl, and vectors.jsonl.","updated_at":"2026-09-14T03:12:36Z","updated_by_operation":"op_49e3eb9d9c6f43ab8c47562957454f04"}
