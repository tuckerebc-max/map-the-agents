{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7ffefc1127f33a96e79b2e95b9e9b4a06a7aa83e9a6a69f19a15a7f3a40fa347"],"opposing_claim_ids":[],"text":"The --update-pricing command downloads public model pricing metadata from the LiteLLM community pricing source and does not send local session logs."},{"claim_ids":["clm_bb92fd35b762993b69e746e99276ecb81aec79c4b5583565dfc3313b2c6a4fc4"],"opposing_claim_ids":[],"text":"The tool is local-first: it reads session logs from chosen paths, computes metrics on the machine, and does not upload prompts, code, logs, reports, or telemetry to any hosted service."}],"claim_ids":["clm_7ffefc1127f33a96e79b2e95b9e9b4a06a7aa83e9a6a69f19a15a7f3a40fa347","clm_bb92fd35b762993b69e746e99276ecb81aec79c4b5583565dfc3313b2c6a4fc4"],"created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","id":"pg_33edbfe2c33f5c40b11b769df4bbc336","maturity":"draft","page_type":"source","path":"pages/sources/luoyuctl-agenttrace-privacy-md-6848aa10df9d-769df4bbc336.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_7436d839ff2e512d983058837d217905"],"title":"luoyuctl/agenttrace/PRIVACY.md @ 6848aa10df9d","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","id":"pg_63714888bd165c739e08f08c5eec7633","maturity":"draft","page_type":"source","path":"pages/sources/luoyuctl-agenttrace-docs-readme-md-6848aa10df9d-f08c5eec7633.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_0e132c3003ed5d17ba96119f0b037f4d"],"title":"luoyuctl/agenttrace/docs/README.md @ 6848aa10df9d","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_119d1915758b44602d53903ba9b17c5ddc3cf83874f2f26abde8f38ad87ce074"],"opposing_claim_ids":[],"text":"The Rust codebase is split into agenttrace-core (data model, detection, parsers, analysis, pricing, reports, cache, SQLite), agenttrace-cli (clap-based CLI), and agenttrace-tui (ratatui/crossterm)."}],"claim_ids":["clm_119d1915758b44602d53903ba9b17c5ddc3cf83874f2f26abde8f38ad87ce074"],"created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","id":"pg_72cf323df4d3587e9928440345a40147","maturity":"draft","page_type":"source","path":"pages/sources/luoyuctl-agenttrace-docs-archive-rust-migration-compatibility-v0-6-md--440345a40147.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d510749012505169b3afaa07b769f36b"],"title":"luoyuctl/agenttrace/docs/archive/rust-migration-compatibility-v0.6.md @ 6848aa10df9d","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","id":"pg_860fe677b19951d4bc0d2ac816276fe5","maturity":"draft","page_type":"source","path":"pages/sources/luoyuctl-agenttrace-readme-zh-cn-md-6848aa10df9d-2ac816276fe5.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_9c5767d8aeb253e19dffd43f02d137f5"],"title":"luoyuctl/agenttrace/README.zh-CN.md @ 6848aa10df9d","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_16c197f31379c6840fdd0fe7c4a5dc5f428179f8d080f90e3d93420c87f1c71c"],"opposing_claim_ids":[],"text":"Stated non-goals include hosted prompt storage, billing-grade invoice reconciliation, replacing agent chat UIs, live tracing during streaming, and security enforcement."},{"claim_ids":["clm_78017a72603b060f7411a215370a03a6622c87588c89a66846efcc4ab07d7159"],"opposing_claim_ids":[],"text":"Each session is labeled Detailed, Aggregate, or Limited so missing event-level evidence is never presented as a complete trace."},{"claim_ids":["clm_7df72fada2c196a0008c89b0d59c77b0d113dde7e4ca05b9df7427e924b857b6"],"opposing_claim_ids":[],"text":"Tool steps retain only timing/status metadata; no prompt, response, result, or tool-argument body is stored in steps."}],"claim_ids":["clm_16c197f31379c6840fdd0fe7c4a5dc5f428179f8d080f90e3d93420c87f1c71c","clm_78017a72603b060f7411a215370a03a6622c87588c89a66846efcc4ab07d7159","clm_7df72fada2c196a0008c89b0d59c77b0d113dde7e4ca05b9df7427e924b857b6"],"created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","id":"pg_94668919786e55e9a29199bbefb503f0","maturity":"draft","page_type":"source","path":"pages/sources/luoyuctl-agenttrace-roadmap-md-6848aa10df9d-99bbefb503f0.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1b1cd7cdd794588d8dfebd4217818008"],"title":"luoyuctl/agenttrace/ROADMAP.md @ 6848aa10df9d","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1f393ee8300cf185ad5297db015d11aa7258ddf6e968da0bb6ca5657fa923ca3"],"opposing_claim_ids":[],"text":"Repository development practice: parser PRs should include a redacted fixture, format detection in crates/agenttrace-core/src/parser.rs, field extraction, and tests; contributors run cargo test, a release build, and --doctor before sending a PR."},{"claim_ids":["clm_78017a72603b060f7411a215370a03a6622c87588c89a66846efcc4ab07d7159"],"opposing_claim_ids":[],"text":"Each session is labeled Detailed, Aggregate, or Limited so missing event-level evidence is never presented as a complete trace."},{"claim_ids":["clm_7df72fada2c196a0008c89b0d59c77b0d113dde7e4ca05b9df7427e924b857b6"],"opposing_claim_ids":[],"text":"Tool steps retain only timing/status metadata; no prompt, response, result, or tool-argument body is stored in steps."},{"claim_ids":["clm_8cca191f05de49aecd28f93acccac33a6070e19e4e6150c1d498c800a62746c8"],"opposing_claim_ids":[],"text":"A single agenttrace binary provides both interfaces: run without a report action to open the TUI, or pass flags such as --sessions and --overview for CLI output."},{"claim_ids":["clm_9fb13a17b870bafabcf22c747d163185884bd1548f21420c8c240cd4d2cb9c45"],"opposing_claim_ids":[],"text":"Reports can be emitted as JSON, Markdown, and self-contained HTML; --overview includes scope, parse/pricing confidence, cost audit, recommendations, MCP governance, context trends, and delivery signals."},{"claim_ids":["clm_bc12580d644454d6a98bbfbcbf628d52d9824ffe74613d94c60287709a6c890e"],"opposing_claim_ids":[],"text":"All cost and delivery fields are explicitly estimates or heuristics, not provider billing or proof that a commit reached main."},{"claim_ids":["clm_e49ff145f630a73bbf1dc2a4df722fcd7b17a03109148fe1dbdb0d4df94064a6"],"opposing_claim_ids":[],"text":"Pricing overrides via AGENTTRACE_PRICING_FILE accept model aliases plus per-million-token prices for input, output, cache write, and cache read."},{"claim_ids":["clm_f302dfad9b8c653e33a9ddbaa82677024134a73f35fb37e028a1e52c79c793ef"],"opposing_claim_ids":[],"text":"The CLI exposes governance report actions including --audit, --recommend, --mcp-governance, --context-trends, and --delivery-evidence, each shown with --range and -f options."}],"claim_ids":["clm_1f393ee8300cf185ad5297db015d11aa7258ddf6e968da0bb6ca5657fa923ca3","clm_78017a72603b060f7411a215370a03a6622c87588c89a66846efcc4ab07d7159","clm_7df72fada2c196a0008c89b0d59c77b0d113dde7e4ca05b9df7427e924b857b6","clm_8cca191f05de49aecd28f93acccac33a6070e19e4e6150c1d498c800a62746c8","clm_9fb13a17b870bafabcf22c747d163185884bd1548f21420c8c240cd4d2cb9c45","clm_bc12580d644454d6a98bbfbcbf628d52d9824ffe74613d94c60287709a6c890e","clm_e49ff145f630a73bbf1dc2a4df722fcd7b17a03109148fe1dbdb0d4df94064a6","clm_f302dfad9b8c653e33a9ddbaa82677024134a73f35fb37e028a1e52c79c793ef"],"created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","id":"pg_cde52303227e57928a3b3fd0e8731d48","maturity":"draft","page_type":"source","path":"pages/sources/luoyuctl-agenttrace-readme-md-6848aa10df9d-3fd0e8731d48.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_5f5d952017aa551ab4fbaa83c780fa63"],"title":"luoyuctl/agenttrace/README.md @ 6848aa10df9d","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
