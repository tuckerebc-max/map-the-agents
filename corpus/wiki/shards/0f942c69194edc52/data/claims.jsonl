{"access":"public","created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_119d1915758b44602d53903ba9b17c5ddc3cf83874f2f26abde8f38ad87ce074","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"luoyuctl/agenttrace@6848aa10df9d snapshot 786a6feb4df14021","timeframe":null},"slice_ids":["slc_2b9e359b70851daad6bce1afe738ff3d1c0c69382c9ecc7ed1123b4b1ff78199"],"source_ids":["src_d510749012505169b3afaa07b769f36b"],"text":"The Rust codebase is split into agenttrace-core (data model, detection, parsers, analysis, pricing, reports, cache, SQLite), agenttrace-cli (clap-based CLI), and agenttrace-tui (ratatui/crossterm).","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_16c197f31379c6840fdd0fe7c4a5dc5f428179f8d080f90e3d93420c87f1c71c","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"luoyuctl/agenttrace@6848aa10df9d snapshot 786a6feb4df14021","timeframe":null},"slice_ids":["slc_ed694ba3b1cf5ef7c8bd2b0783e5af4fd3579824726ca46f593d0402cb206512"],"source_ids":["src_1b1cd7cdd794588d8dfebd4217818008"],"text":"Stated non-goals include hosted prompt storage, billing-grade invoice reconciliation, replacing agent chat UIs, live tracing during streaming, and security enforcement.","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1f393ee8300cf185ad5297db015d11aa7258ddf6e968da0bb6ca5657fa923ca3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"luoyuctl/agenttrace@6848aa10df9d snapshot 786a6feb4df14021","timeframe":null},"slice_ids":["slc_7cd8e3fd60a21c1858d5cc89154c181f3af601396831db28cbc318590565b93d","slc_a0cf996aac11bcb6edbe8a35c60ddb93e8b412f901d8ffdec24571366a548ef7","slc_cd48626a70322b7f790d3cef2b4690ae1f63458c755a43486e51f8119c3879b6","slc_ec6528072ab1d89f1894de89a22154139c5fd01ec71d473421b31cc0e8a7893e"],"source_ids":["src_5f5d952017aa551ab4fbaa83c780fa63"],"text":"Repository development practice: parser PRs should include a redacted fixture, format detection in crates/agenttrace-core/src/parser.rs, field extraction, and tests; contributors run cargo test, a release build, and --doctor before sending a PR.","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_78017a72603b060f7411a215370a03a6622c87588c89a66846efcc4ab07d7159","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"luoyuctl/agenttrace@6848aa10df9d snapshot 786a6feb4df14021","timeframe":null},"slice_ids":["slc_c352a277d9e5377a04a86029f411fa2b460cd0af13f5ae9da27c1c78f52b4641","slc_ea6fc5cb7ef771f8a1f0b5caefb8e620cf676beacd79e527da793942dce9bf2b"],"source_ids":["src_1b1cd7cdd794588d8dfebd4217818008","src_5f5d952017aa551ab4fbaa83c780fa63"],"text":"Each session is labeled Detailed, Aggregate, or Limited so missing event-level evidence is never presented as a complete trace.","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7df72fada2c196a0008c89b0d59c77b0d113dde7e4ca05b9df7427e924b857b6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"luoyuctl/agenttrace@6848aa10df9d snapshot 786a6feb4df14021","timeframe":null},"slice_ids":["slc_c352a277d9e5377a04a86029f411fa2b460cd0af13f5ae9da27c1c78f52b4641","slc_ea6fc5cb7ef771f8a1f0b5caefb8e620cf676beacd79e527da793942dce9bf2b"],"source_ids":["src_1b1cd7cdd794588d8dfebd4217818008","src_5f5d952017aa551ab4fbaa83c780fa63"],"text":"Tool steps retain only timing/status metadata; no prompt, response, result, or tool-argument body is stored in steps.","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7ffefc1127f33a96e79b2e95b9e9b4a06a7aa83e9a6a69f19a15a7f3a40fa347","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=dependencies","setting":"luoyuctl/agenttrace@6848aa10df9d snapshot 786a6feb4df14021","timeframe":null},"slice_ids":["slc_5ae853972367f46a02062e599fdb1024021aa687e7590c05e9a6d7641c052f87"],"source_ids":["src_7436d839ff2e512d983058837d217905"],"text":"The --update-pricing command downloads public model pricing metadata from the LiteLLM community pricing source and does not send local session logs.","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8cca191f05de49aecd28f93acccac33a6070e19e4e6150c1d498c800a62746c8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"luoyuctl/agenttrace@6848aa10df9d snapshot 786a6feb4df14021","timeframe":null},"slice_ids":["slc_91c9c8d5d01655627ee188badd9ffbe8ef3913c67d41209e677d11f85a2a6db5"],"source_ids":["src_5f5d952017aa551ab4fbaa83c780fa63"],"text":"A single agenttrace binary provides both interfaces: run without a report action to open the TUI, or pass flags such as --sessions and --overview for CLI output.","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_9fb13a17b870bafabcf22c747d163185884bd1548f21420c8c240cd4d2cb9c45","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"luoyuctl/agenttrace@6848aa10df9d snapshot 786a6feb4df14021","timeframe":null},"slice_ids":["slc_bf0dfdb6330ba96e2a2ccf0af761535ac4257ef1a1871898b91657ed33dc4de8","slc_c352a277d9e5377a04a86029f411fa2b460cd0af13f5ae9da27c1c78f52b4641"],"source_ids":["src_5f5d952017aa551ab4fbaa83c780fa63"],"text":"Reports can be emitted as JSON, Markdown, and self-contained HTML; --overview includes scope, parse/pricing confidence, cost audit, recommendations, MCP governance, context trends, and delivery signals.","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
{"access":"public","created_at":"2026-09-14T04:08:28Z","created_by_operation":"op_b3763fa6601746aea794a49f20879610","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bb92fd35b762993b69e746e99276ecb81aec79c4b5583565dfc3313b2c6a4fc4","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"luoyuctl/agenttrace@6848aa10df9d snapshot 786a6feb4df14021","timeframe":null},"slice_ids":["slc_b618428622f59b4aebec913d01fdaff9bb7d959c1a801ccc00516a817b2085f2"],"source_ids":["src_7436d839ff2e512d983058837d217905"],"text":"The tool is local-first: it reads session logs from chosen paths, computes metrics on the machine, and does not upload prompts, code, logs, reports, or telemetry to any hosted service.","updated_at":"2026-09-14T04:08:28Z","updated_by_operation":"op_b3763fa6601746aea794a49f20879610"}
