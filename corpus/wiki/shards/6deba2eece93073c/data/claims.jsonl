{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_12f97141da6ede68b624a6aaf9be9a2913c04222020297a459b2d9d6c1f13971","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_a47bdf72f7bd1fb9c7997f00ac336a22bb3ecf62365d46086be49a35a92b11a6"],"source_ids":["src_d7843c2227ba54a695830c610cd93521"],"text":"The default local stack serves a web UI at localhost:5173, an API at localhost:4100, and OTLP intake at localhost:4101.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_171a7fda0d77784346eba80f99b269085d46a579a3743ebf226f9d4f655375e8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=relevance","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_83ffa53d5684c22c1fb5c4e226512b889593f0f3b4069c3e31a4dca3613990cf","slc_e5f4a50c4a8b6fc05fe59049689aa66091c7add7ad297f02148de7e326cff153"],"source_ids":["src_d7843c2227ba54a695830c610cd93521"],"text":"Superlog targets teams debugging production systems: it is an open-core observability workspace for OpenTelemetry data that ingests traces, logs, and metrics and groups noisy signals into incidents.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_189ea82591a4c70aa5ac4d2bb98dd27bc07f2d1cbe8232699c948eb48ea40743","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_1185aef0656fc1c011b1d182f4da9191b9992f7bfd930f597bad2d402e1ce5e7","slc_97ed7e2c73ccb67a6f0b539358cccef59e622b0f3f304fb3ca64ac25201f716a"],"source_ids":["src_164b8ffe7141596bbe129d9cd9b84e42"],"text":"A completed agent investigation can produce a root cause with confidence, estimated impact, severity, an opened pull request with patch and validation status, and Linear tickets, embedded in the agent_completed webhook payload.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1a18d1e8e262df30c9e9c391a06522900cc72d0817a74e85d5ed06dc43fbfe0b","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=components","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_a993ec822e5febf6373abe1867d1525d3545f75562adb414c1b86ade07a18936"],"source_ids":["src_d7843c2227ba54a695830c610cd93521"],"text":"The community edition includes a web app and API, an OTLP ingest proxy, worker processes for incident grouping and background jobs, Postgres schema with ClickHouse-backed telemetry queries, and agent runner interfaces.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1c7f0af6ae4b2123933e56ea49dacca108233d152a64b8d14229a275dbb443b6","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=tools-permissions","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_015d411a16dfdd18f139d6962b8de96d005c45f63f7db22536b41fadd42f66f3","slc_e781e38e621cdf5a9bad44c14577fe10765f8a1f31a016558cf35561aace3d28"],"source_ids":["src_2cecbf6e140055deaf2b3ee06da213e7"],"text":"The GitHub App is configured with minimum repository permissions: Contents read/write to read files and push fix branches, Pull requests read/write to open/update/merge PRs, Issues read/write for comments, and read-only Metadata; no account or organization permissions are required.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_3d70a2711a3754162d35e5e3dbea9673fa8b3cc6361f26cde522255b6fdbe3b3","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_121e3965bd5ffab707b8525a44541812f88d06296dfa0f87dafaf45057213a52","slc_8af21a4ddf3abceca4095e7be25e0e0382601cfe86ef1450c6f646f9080c2623","slc_dbf276a617a3c75d575d8e0999edba09eb7b46f51194d9e688b9efc7b88d27fb"],"source_ids":["src_164b8ffe7141596bbe129d9cd9b84e42"],"text":"Outgoing webhooks use exactly two events, incident.created and incident.updated; resolve, reopen, merge, and agent start/finish/fail/await-input are all incident.updated distinguished by a change.kind field.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4e24f56c08597b4e5bf19e6f1e352de6b37e6807b8d4e52986189f79bdb42944","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_7670fb7b68bbad51099a916158924aa161905dd4af70716bc8e88e996722325c","slc_a993ec822e5febf6373abe1867d1525d3545f75562adb414c1b86ade07a18936"],"source_ids":["src_164b8ffe7141596bbe129d9cd9b84e42","src_d7843c2227ba54a695830c610cd93521"],"text":"Agent investigation runtimes are pluggable, with a default 'community' runner that records a local incident summary; webhook agentRun payloads show a runtime value of 'anthropic' and states including queued, running, awaiting_human, blocked_no_github, complete, and failed.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_4e2eca492102310199b71e3bedb3655e5a502eef81f51c34cbf0aeb59c959348","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_08f4f9f33be3a81b4d6256d48462d10a97cd25649d887a7223d6e47b69ebf4d4","slc_48b03b549b700a6c6391493b67af02b371eda3c8ecd93db1431d1ca7fd65b591"],"source_ids":["src_2cecbf6e140055deaf2b3ee06da213e7"],"text":"The agent integrates with GitHub via a GitHub App using two OAuth callback URLs on the API: /github/install/callback for the connect/install flow and /github/author/callback for a commit-author OAuth flow.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_7ea4aebc839e605cdb80e566306a73e08549f51043c5c433af46fe47eb9e0344","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=limitations","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_66b2ecc90b29c7f952252b94ccf031be52ccf14f776f60dfa09dc6c450067600","slc_aef1951422db4f722addfa5655c239830a7f1c7d3e69fc47a09aaa435c855d37"],"source_ids":["src_1f1d7f61c9df548a963405b476b38bda"],"text":"The Sentry connector supports only Sentry Cloud via a public Sentry App; self-hosted Sentry is not supported.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_86e231bb57bc19427e07677cd6dc9f5a0346474f1398cc99dfc7e1c43b6d1fef","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_49d6c9778e2222473c5325127b9cdb8f689508fc48305b5cb525d60b6384be2f","slc_6a62b238fb3f9e2d6b6db522ad591faa872682d67f06858b9cf92cad71c328e7"],"source_ids":["src_164b8ffe7141596bbe129d9cd9b84e42"],"text":"Webhook delivery is a JSON POST with a 10-second timeout; failures are retried with backoff up to 8 attempts (~8h) before being marked failed, and retries reuse a stable Superlog-Delivery UUID as an idempotency key.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a5c90096f10653ec68db631bcf80dc27fc5a8cb8b62f3bb09864f9b6bfa40f62","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_2080082d482d695d48f122e0700a0affcc7aa72ba869bd262bafb82e54e777bb","slc_e330798a518bf08177f5a3f50332d1be6431f5ef80deba94a0ac378f07608b63"],"source_ids":["src_c188e398a2df528f819999c45585482a"],"text":"Repository development practice: the web design system's rules live in apps/web/DESIGN.md with a live /design sheet, and contributors are told to read it before adding or restyling UI; a stated rule forbids combining monospace fonts with uppercased text for labels and chrome.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_ac3b2fb5577fb10dcceda5ee4be64aafea22eceff5e9fe177bd26e203b263677","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_14a6bd381e841f1219400c983a13d7e20b315d83646853b812c52d9ea780b8b2"],"source_ids":["src_1f1d7f61c9df548a963405b476b38bda"],"text":"OAuth and relay credentials are encrypted at rest using AGENT_SECRETS_KEY, which is required alongside STATE_SIGNING_SECRET.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_cdb6ae71d9db1aab091d25a5de920b8a3f5c9f0186101fdbdbcdb7b63b4ac27a","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_d81f4b02fe320b95d59df0075d66f3b550140ab8872c00d5c6cfafac4e029ef0"],"source_ids":["src_c188e398a2df528f819999c45585482a"],"text":"Onboarding follows an integration-first product principle, favoring connected no-code integrations over manual SDK wiring where possible.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_de72b291019f760760fd1e33cd7c2e3e5801f008433abf1f8f91f42af1e34b0d","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=workflows","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_03b99b8592297018a988a96c43d454d0d807a1414528d984870b51f422c51146","slc_7ad84a2646b62c1230cd86e9ad060f3c742403946603c0214184040843e38a2e","slc_8bcb2122e9778c3ba4c633e16306965d4c169b3be224c145c90071e11379d85d"],"source_ids":["src_d7843c2227ba54a695830c610cd93521"],"text":"Repository development practice: local development requires Node.js 20+, pnpm 9+, and Docker; setup uses pnpm install, docker compose up -d, a db migrate command, pnpm dev, and pnpm typecheck for typechecks.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_fd6e4cbfe8bb6700351129167ddde7d053860c1add0dc82bb9d76e0d125fc569","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"superloglabs/superlog@feffc9fd542a snapshot 804cab7eff5456ea","timeframe":null},"slice_ids":["slc_39c869d3793b96a573fea95c5bd162bf35e615a1fdf9006849ac885f25e5e18c","slc_6b9f9e3c99fc9858b0ffdca158232e6937212a2c1c48e10719c7187b925a77cf","slc_7ad3599c882ed16f5e9b2e169c86977a9d644c88e8c5ece79b3b6eefe2c3100a","slc_bb8141459879f06996120d3e8276a8ef8561210b8b4d7f77e4731edaedbbf69b"],"source_ids":["src_164b8ffe7141596bbe129d9cd9b84e42"],"text":"Webhook deliveries carry a Stripe-style Superlog-Signature header (t=<unix-ts>,v1=<hex>) where the hex is HMAC-SHA256 over '<timestamp>.<raw body>'; verification must use the raw body before JSON parsing.","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
