{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_12f97141da6ede68b624a6aaf9be9a2913c04222020297a459b2d9d6c1f13971"],"opposing_claim_ids":[],"text":"The default local stack serves a web UI at localhost:5173, an API at localhost:4100, and OTLP intake at localhost:4101."},{"claim_ids":["clm_171a7fda0d77784346eba80f99b269085d46a579a3743ebf226f9d4f655375e8"],"opposing_claim_ids":[],"text":"Superlog targets teams debugging production systems: it is an open-core observability workspace for OpenTelemetry data that ingests traces, logs, and metrics and groups noisy signals into incidents."},{"claim_ids":["clm_1a18d1e8e262df30c9e9c391a06522900cc72d0817a74e85d5ed06dc43fbfe0b"],"opposing_claim_ids":[],"text":"The community edition includes a web app and API, an OTLP ingest proxy, worker processes for incident grouping and background jobs, Postgres schema with ClickHouse-backed telemetry queries, and agent runner interfaces."},{"claim_ids":["clm_4e24f56c08597b4e5bf19e6f1e352de6b37e6807b8d4e52986189f79bdb42944"],"opposing_claim_ids":[],"text":"Agent investigation runtimes are pluggable, with a default 'community' runner that records a local incident summary; webhook agentRun payloads show a runtime value of 'anthropic' and states including queued, running, awaiting_human, blocked_no_github, complete, and failed."},{"claim_ids":["clm_de72b291019f760760fd1e33cd7c2e3e5801f008433abf1f8f91f42af1e34b0d"],"opposing_claim_ids":[],"text":"Repository development practice: local development requires Node.js 20+, pnpm 9+, and Docker; setup uses pnpm install, docker compose up -d, a db migrate command, pnpm dev, and pnpm typecheck for typechecks."}],"claim_ids":["clm_12f97141da6ede68b624a6aaf9be9a2913c04222020297a459b2d9d6c1f13971","clm_171a7fda0d77784346eba80f99b269085d46a579a3743ebf226f9d4f655375e8","clm_1a18d1e8e262df30c9e9c391a06522900cc72d0817a74e85d5ed06dc43fbfe0b","clm_4e24f56c08597b4e5bf19e6f1e352de6b37e6807b8d4e52986189f79bdb42944","clm_de72b291019f760760fd1e33cd7c2e3e5801f008433abf1f8f91f42af1e34b0d"],"created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","id":"pg_036263aaba6f5e4f98af63015b917744","maturity":"draft","page_type":"source","path":"pages/sources/superloglabs-superlog-readme-md-feffc9fd542a-63015b917744.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d7843c2227ba54a695830c610cd93521"],"title":"superloglabs/superlog/README.md @ feffc9fd542a","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_a5c90096f10653ec68db631bcf80dc27fc5a8cb8b62f3bb09864f9b6bfa40f62"],"opposing_claim_ids":[],"text":"Repository development practice: the web design system's rules live in apps/web/DESIGN.md with a live /design sheet, and contributors are told to read it before adding or restyling UI; a stated rule forbids combining monospace fonts with uppercased text for labels and chrome."},{"claim_ids":["clm_cdb6ae71d9db1aab091d25a5de920b8a3f5c9f0186101fdbdbcdb7b63b4ac27a"],"opposing_claim_ids":[],"text":"Onboarding follows an integration-first product principle, favoring connected no-code integrations over manual SDK wiring where possible."}],"claim_ids":["clm_a5c90096f10653ec68db631bcf80dc27fc5a8cb8b62f3bb09864f9b6bfa40f62","clm_cdb6ae71d9db1aab091d25a5de920b8a3f5c9f0186101fdbdbcdb7b63b4ac27a"],"created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","id":"pg_297f1a7d15965d71b3914f12a3447ed6","maturity":"draft","page_type":"source","path":"pages/sources/superloglabs-superlog-design-md-feffc9fd542a-4f12a3447ed6.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_c188e398a2df528f819999c45585482a"],"title":"superloglabs/superlog/design.md @ feffc9fd542a","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_189ea82591a4c70aa5ac4d2bb98dd27bc07f2d1cbe8232699c948eb48ea40743"],"opposing_claim_ids":[],"text":"A completed agent investigation can produce a root cause with confidence, estimated impact, severity, an opened pull request with patch and validation status, and Linear tickets, embedded in the agent_completed webhook payload."},{"claim_ids":["clm_3d70a2711a3754162d35e5e3dbea9673fa8b3cc6361f26cde522255b6fdbe3b3"],"opposing_claim_ids":[],"text":"Outgoing webhooks use exactly two events, incident.created and incident.updated; resolve, reopen, merge, and agent start/finish/fail/await-input are all incident.updated distinguished by a change.kind field."},{"claim_ids":["clm_4e24f56c08597b4e5bf19e6f1e352de6b37e6807b8d4e52986189f79bdb42944"],"opposing_claim_ids":[],"text":"Agent investigation runtimes are pluggable, with a default 'community' runner that records a local incident summary; webhook agentRun payloads show a runtime value of 'anthropic' and states including queued, running, awaiting_human, blocked_no_github, complete, and failed."},{"claim_ids":["clm_86e231bb57bc19427e07677cd6dc9f5a0346474f1398cc99dfc7e1c43b6d1fef"],"opposing_claim_ids":[],"text":"Webhook delivery is a JSON POST with a 10-second timeout; failures are retried with backoff up to 8 attempts (~8h) before being marked failed, and retries reuse a stable Superlog-Delivery UUID as an idempotency key."},{"claim_ids":["clm_fd6e4cbfe8bb6700351129167ddde7d053860c1add0dc82bb9d76e0d125fc569"],"opposing_claim_ids":[],"text":"Webhook deliveries carry a Stripe-style Superlog-Signature header (t=<unix-ts>,v1=<hex>) where the hex is HMAC-SHA256 over '<timestamp>.<raw body>'; verification must use the raw body before JSON parsing."}],"claim_ids":["clm_189ea82591a4c70aa5ac4d2bb98dd27bc07f2d1cbe8232699c948eb48ea40743","clm_3d70a2711a3754162d35e5e3dbea9673fa8b3cc6361f26cde522255b6fdbe3b3","clm_4e24f56c08597b4e5bf19e6f1e352de6b37e6807b8d4e52986189f79bdb42944","clm_86e231bb57bc19427e07677cd6dc9f5a0346474f1398cc99dfc7e1c43b6d1fef","clm_fd6e4cbfe8bb6700351129167ddde7d053860c1add0dc82bb9d76e0d125fc569"],"created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","id":"pg_3fa79d89e28556bc8e6849ec65d1facf","maturity":"draft","page_type":"source","path":"pages/sources/superloglabs-superlog-docs-webhooks-md-feffc9fd542a-49ec65d1facf.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_164b8ffe7141596bbe129d9cd9b84e42"],"title":"superloglabs/superlog/docs/webhooks.md @ feffc9fd542a","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","aliases":[],"assertions":[],"claim_ids":[],"created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","id":"pg_62de308b37b85c3681b7299cd4e54d5c","maturity":"draft","page_type":"source","path":"pages/sources/superloglabs-superlog-roadmap-md-feffc9fd542a-299cd4e54d5c.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_de41fbaadfd45970a7888349435447d4"],"title":"superloglabs/superlog/ROADMAP.md @ feffc9fd542a","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1c7f0af6ae4b2123933e56ea49dacca108233d152a64b8d14229a275dbb443b6"],"opposing_claim_ids":[],"text":"The GitHub App is configured with minimum repository permissions: Contents read/write to read files and push fix branches, Pull requests read/write to open/update/merge PRs, Issues read/write for comments, and read-only Metadata; no account or organization permissions are required."},{"claim_ids":["clm_4e2eca492102310199b71e3bedb3655e5a502eef81f51c34cbf0aeb59c959348"],"opposing_claim_ids":[],"text":"The agent integrates with GitHub via a GitHub App using two OAuth callback URLs on the API: /github/install/callback for the connect/install flow and /github/author/callback for a commit-author OAuth flow."}],"claim_ids":["clm_1c7f0af6ae4b2123933e56ea49dacca108233d152a64b8d14229a275dbb443b6","clm_4e2eca492102310199b71e3bedb3655e5a502eef81f51c34cbf0aeb59c959348"],"created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","id":"pg_7bcae1dbcc7c54fab462f64809049a34","maturity":"draft","page_type":"source","path":"pages/sources/superloglabs-superlog-docs-github-app-setup-md-feffc9fd542a-f64809049a34.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_2cecbf6e140055deaf2b3ee06da213e7"],"title":"superloglabs/superlog/docs/github-app-setup.md @ feffc9fd542a","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_7ea4aebc839e605cdb80e566306a73e08549f51043c5c433af46fe47eb9e0344"],"opposing_claim_ids":[],"text":"The Sentry connector supports only Sentry Cloud via a public Sentry App; self-hosted Sentry is not supported."},{"claim_ids":["clm_ac3b2fb5577fb10dcceda5ee4be64aafea22eceff5e9fe177bd26e203b263677"],"opposing_claim_ids":[],"text":"OAuth and relay credentials are encrypted at rest using AGENT_SECRETS_KEY, which is required alongside STATE_SIGNING_SECRET."}],"claim_ids":["clm_7ea4aebc839e605cdb80e566306a73e08549f51043c5c433af46fe47eb9e0344","clm_ac3b2fb5577fb10dcceda5ee4be64aafea22eceff5e9fe177bd26e203b263677"],"created_at":"2026-09-14T03:17:02Z","created_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c","id":"pg_90bcfc7e2e1b54c89296861cceecaed2","maturity":"draft","page_type":"source","path":"pages/sources/superloglabs-superlog-docs-sentry-app-setup-md-feffc9fd542a-861cceecaed2.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_1f1d7f61c9df548a963405b476b38bda"],"title":"superloglabs/superlog/docs/sentry-app-setup.md @ feffc9fd542a","updated_at":"2026-09-14T03:17:02Z","updated_by_operation":"op_d4ff1e9da44541c8ac0176cf7071fd4c"}
