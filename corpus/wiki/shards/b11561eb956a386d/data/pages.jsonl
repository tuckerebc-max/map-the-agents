{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_b2027fba36282b14e9e149e3ba08c14e1bbc5f6028757a32c9f9e91cebf12cbd"],"opposing_claim_ids":[],"text":"Repository development practice: development uses pnpm commands — dev (Vite on port 1420), build (tsc + Vite), lint (ESLint), test (Vitest), and tauri dev/build for the desktop app."},{"claim_ids":["clm_c6ff4a7f87f37d788d3836613ef9b86e1d1405341c68e1099b06320056ed6009"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are issue-first — a GitHub issue must be approved by a maintainer before opening a PR, with narrow exceptions like typos and one-to-two-line bug fixes."}],"claim_ids":["clm_b2027fba36282b14e9e149e3ba08c14e1bbc5f6028757a32c9f9e91cebf12cbd","clm_c6ff4a7f87f37d788d3836613ef9b86e1d1405341c68e1099b06320056ed6009"],"created_at":"2026-09-14T03:08:46Z","created_by_operation":"op_127718bee2ac4a1388197d2ce59bd818","id":"pg_2b1c169bf24d53f3bc48fc7fb3451c12","maturity":"draft","page_type":"source","path":"pages/sources/hanshuaikang-nezha-agents-md-8b1068a87cf2-fc7fb3451c12.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_69f3426a1e7755bb94cc62f66e0aa56e"],"title":"hanshuaikang/nezha/AGENTS.md @ 8b1068a87cf2","updated_at":"2026-09-14T03:08:46Z","updated_by_operation":"op_127718bee2ac4a1388197d2ce59bd818"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_1aa0d38fe9ed355d80130c0c659a126259157cb1d24094d3ffbf0c98031fa3b3"],"opposing_claim_ids":[],"text":"The app supports skill management, letting users centrally manage local skills via symlinks."},{"claim_ids":["clm_4f73eb7e8c61f9023797ccb88bfae472073b5e1b520152ab19d3c819a68940c2"],"opposing_claim_ids":[],"text":"Nezha is a cross-platform lightweight IDE built for AI programming, integrating native Claude Code and Codex sessions in a built-in terminal alongside task tracking, Git, and an editor."},{"claim_ids":["clm_655502b838c6a3ad6a6ad1db2a21b5abacf49ef1f6122093af9921dd7a015c1a"],"opposing_claim_ids":[],"text":"The project credits Tauri, React, xterm.js, and Material Icon Theme as open-source projects it depends on."},{"claim_ids":["clm_a76e439704f430d727c2c3f34f821e54d641db59f86b77ce297b0a663fbe8758"],"opposing_claim_ids":[],"text":"The macOS installer is unsigned, so first launch triggers a Gatekeeper 'damaged' warning; the documented workaround is removing the quarantine attribute via xattr."}],"claim_ids":["clm_1aa0d38fe9ed355d80130c0c659a126259157cb1d24094d3ffbf0c98031fa3b3","clm_4f73eb7e8c61f9023797ccb88bfae472073b5e1b520152ab19d3c819a68940c2","clm_655502b838c6a3ad6a6ad1db2a21b5abacf49ef1f6122093af9921dd7a015c1a","clm_a76e439704f430d727c2c3f34f821e54d641db59f86b77ce297b0a663fbe8758"],"created_at":"2026-09-14T03:08:46Z","created_by_operation":"op_127718bee2ac4a1388197d2ce59bd818","id":"pg_a997a5e2a98f5a07882e6140d0be9978","maturity":"draft","page_type":"source","path":"pages/sources/hanshuaikang-nezha-readme-md-8b1068a87cf2-6140d0be9978.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_e1987e0f62965b40ad3673e09a1e08f2"],"title":"hanshuaikang/nezha/README.md @ 8b1068a87cf2","updated_at":"2026-09-14T03:08:46Z","updated_by_operation":"op_127718bee2ac4a1388197d2ce59bd818"}
