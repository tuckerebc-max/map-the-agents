{"access":"public","created_at":"2026-09-14T03:58:30Z","created_by_operation":"op_e09d6c3b6a2e41c79ab08eaded8189c0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_6d8eb8e40255aa82143b1aa92145960e88ecccb5a0d3edb9aaa91f283be4f262","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=interfaces","setting":"iamunbounded/devctx@7308ec5a514e snapshot 1681c23458a06fb3","timeframe":null},"slice_ids":["slc_478e92286495212e74a65f85cbce2a70a8361c3a0652d85133be475a38727c0c"],"source_ids":["src_cde7e8688e0954199b4a614417d6f811"],"text":"Team/automation commands include handoff @user, share (committing the .devctx/ folder to git), watch (auto-save on file changes using chokidar), and hook install for a git post-commit hook.","updated_at":"2026-09-14T03:58:30Z","updated_by_operation":"op_e09d6c3b6a2e41c79ab08eaded8189c0"}
{"access":"public","created_at":"2026-09-14T03:58:30Z","created_by_operation":"op_e09d6c3b6a2e41c79ab08eaded8189c0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_a2981742f7bde15ba9c8c5071b2c5b9b5f118341e52346364d40b632b22b24c0","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"iamunbounded/devctx@7308ec5a514e snapshot 1681c23458a06fb3","timeframe":null},"slice_ids":["slc_97dbd4960e548e0b18e0d67140f1fe94fccd95e53b92b1811ac88f18ff83154f","slc_b2200b308ac07559733034c3c28f22a5d0f796da09a67840b1b3867943aae039"],"source_ids":["src_cde7e8688e0954199b4a614417d6f811"],"text":"The tool is designed to work with any AI coding tool by managing the prompt itself, described as the universal interface for LLMs; agents without MCP can run save/resume/log via terminal access as a fallback.","updated_at":"2026-09-14T03:58:30Z","updated_by_operation":"op_e09d6c3b6a2e41c79ab08eaded8189c0"}
{"access":"public","created_at":"2026-09-14T03:58:30Z","created_by_operation":"op_e09d6c3b6a2e41c79ab08eaded8189c0","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_bab354b54149f2d84941fe7dd023667e8a84b7829ac8172c2274f6646fda6955","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=memory-state","setting":"iamunbounded/devctx@7308ec5a514e snapshot 1681c23458a06fb3","timeframe":null},"slice_ids":["slc_3966450b04cc8431294d8314cf97994b3a003bb42dd37ca79f246c9975e24650"],"source_ids":["src_cde7e8688e0954199b4a614417d6f811"],"text":"Context is stored in a .devctx/ folder in the repo; each entry captures task, goal, approaches tried (and failures), key architectural decisions, and where work left off.","updated_at":"2026-09-14T03:58:30Z","updated_by_operation":"op_e09d6c3b6a2e41c79ab08eaded8189c0"}
