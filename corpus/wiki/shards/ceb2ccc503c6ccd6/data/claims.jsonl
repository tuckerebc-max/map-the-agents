{"access":"public","created_at":"2026-09-14T03:20:39Z","created_by_operation":"op_f878f43e4cac413bb08350b94a18dace","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_457615a89e0549a9295ad06d4a9be53f7a52aa4dc3db29a6a1684ee8f4fb6205","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=orchestration","setting":"tutti-os/tutti@8821cf4788f6 snapshot e2307a61fc57c0b8","timeframe":null},"slice_ids":["slc_2f3a4f67333d791d79ae11ae483cda0cefed199d1543a7c31ab54599c240c7de"],"source_ids":["src_cee4c9f095265844987d82e9b396faa4"],"text":"Agents from different providers share visibility into each other's work so they can avoid or resolve conflicts and decide whether work runs in parallel or in sequence.","updated_at":"2026-09-14T04:57:54Z","updated_by_operation":"op_46a38f3f87354db3be09a4dfdb031f94"}
