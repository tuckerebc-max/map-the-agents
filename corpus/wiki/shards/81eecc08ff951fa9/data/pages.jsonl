{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_68847aafb4bb5a08e5ee058141eab19510ebf429e1ecb2cce38a78183913fdf4"],"opposing_claim_ids":[],"text":"Repository development practice: Arctic is built with Bun 1.3+; contributors fork, clone, run `bun install`, and use `bun dev` to launch the TUI with watch mode on packages/arctic."},{"claim_ids":["clm_84fffc88538dd6ebcbbaf5caac2585ee570676bd4865b9a207bf2398d2a9be84"],"opposing_claim_ids":[],"text":"Repository development practice: the repo is a Turbo-managed monorepo with packages/arctic (SolidJS + OpenTUI CLI/TUI), packages/sdk, and packages/plugin."},{"claim_ids":["clm_91fbf3db59b66202a7eaa7ea85c8605f12ae2825416f645d8ec8eebb1420dbdd"],"opposing_claim_ids":[],"text":"Repository development practice: contributors run tests with `bun test`, follow a strict style guide (prefer const over let, avoid else/try-catch, use Bun APIs), and submit PRs with clear descriptions."},{"claim_ids":["clm_d3687719cd8967fa1b640a25a13dfe8074193568cf41636d95944ec5155d737c"],"opposing_claim_ids":[],"text":"Repository development practice: contributions are licensed under the project's MIT License."}],"claim_ids":["clm_68847aafb4bb5a08e5ee058141eab19510ebf429e1ecb2cce38a78183913fdf4","clm_84fffc88538dd6ebcbbaf5caac2585ee570676bd4865b9a207bf2398d2a9be84","clm_91fbf3db59b66202a7eaa7ea85c8605f12ae2825416f645d8ec8eebb1420dbdd","clm_d3687719cd8967fa1b640a25a13dfe8074193568cf41636d95944ec5155d737c"],"created_at":"2026-09-14T01:34:34Z","created_by_operation":"op_d8dc367d616a41218d6596c9319299ac","id":"pg_11f6a1ed98635751a2db3f7bd00144a8","maturity":"draft","page_type":"source","path":"pages/sources/arctic-cli-interface-contributing-md-cddbdde2dc95-3f7bd00144a8.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_85a2e958e4415354ac79863662ac4e32"],"title":"arctic-cli/interface/CONTRIBUTING.md @ cddbdde2dc95","updated_at":"2026-09-14T01:34:34Z","updated_by_operation":"op_d8dc367d616a41218d6596c9319299ac"}
