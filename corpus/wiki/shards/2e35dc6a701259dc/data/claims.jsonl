{"access":"public","created_at":"2026-09-14T03:49:07Z","created_by_operation":"op_8be18b33b8654d1aac5cfc1bee291acb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_5588a8342f3ace10314a02d4cebd747ff1937202b4528caa37e4fd5e7f8876df","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"elpsykongloo/paperbanana-pro@3d9d1f11647e snapshot b699785fdaa1e74d","timeframe":null},"slice_ids":["slc_6363b40955ddcf90a65903b09e763d1bc51d4a6cb8d5051aec1c535f9a507fdb","slc_9ba665a3e2cb576870e84fa62a0b0e8e3a6e73c43b82ceeb509aaf0e56492b50"],"source_ids":["src_2d809baffcdf5c63acdcf2b26e2d84b4"],"text":"A refinement workspace supports 2K/4K upscaling with concurrent multi-version redraws, tree-shaped version chains, and rollback to any historical version.","updated_at":"2026-09-14T03:49:07Z","updated_by_operation":"op_8be18b33b8654d1aac5cfc1bee291acb"}
