{"access":"public","created_at":"2026-09-14T03:49:07Z","created_by_operation":"op_8be18b33b8654d1aac5cfc1bee291acb","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_1561d16e3c18bdfa2a4e070c416a37d8e71cd3c1c116ca66ad29d27714773882","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=design-choices","setting":"elpsykongloo/paperbanana-pro@3d9d1f11647e snapshot b699785fdaa1e74d","timeframe":null},"slice_ids":["slc_9ba665a3e2cb576870e84fa62a0b0e8e3a6e73c43b82ceeb509aaf0e56492b50"],"source_ids":["src_2d809baffcdf5c63acdcf2b26e2d84b4"],"text":"Generation runs as background async jobs with a real-time event timeline, supporting 40+ concurrent candidates, and results are packaged in a `Bundle v1` `.bundle.json` format preserving timelines and review records.","updated_at":"2026-09-14T03:49:07Z","updated_by_operation":"op_8be18b33b8654d1aac5cfc1bee291acb"}
