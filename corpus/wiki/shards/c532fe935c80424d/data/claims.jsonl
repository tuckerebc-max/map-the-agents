{"access":"public","created_at":"2026-09-14T02:43:43Z","created_by_operation":"op_59623779fd27423a9342ca4c1a2d9753","evidence_type":"organizational_statement","extraction_confidence":0.8,"id":"clm_8fbbcae4b3e7601e55a3fd4ff366aa3b9c5f9613880267d6767d494e21252bb8","lineage_status":"original_available","polarity":"affirmed","record_type":"claim","review_state":"mechanically_checked","schema_version":"1.0","scope":{"instrument_status":null,"jurisdiction":null,"method":"documented","population":null,"qualifiers":"kind=observation; facet=specifications","setting":"storozhenko98/beehive@42e6a36ead6d snapshot 45e04241f2153fbd","timeframe":null},"slice_ids":["slc_9be23ee7d05c98227db5d223805a20da72ea3ea349c75921b505dc546394820a","slc_cb195cb5c25d17ac4930f0c4eaa60a9951831fbef0d1e260d58652475ad41011"],"source_ids":["src_686f3df186985394a61f2568e44dec41"],"text":"Beehive manages multiple repos, creates isolated workspace clones on different branches, and runs terminals and AI agents side-by-side from one window, shipped as both a desktop GUI app and a terminal TUI.","updated_at":"2026-09-14T02:43:43Z","updated_by_operation":"op_59623779fd27423a9342ca4c1a2d9753"}
