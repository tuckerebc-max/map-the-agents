{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_5d91c901528c90de287e78daa34aa3331a8792b2089765c9fdacf0a3b4017b6b"],"opposing_claim_ids":[],"text":"Global keybindings include ctrl+space to switch between Kanban and Search modes, ctrl+o to enter Orchestration/Dashboard mode, ? for help, and ctrl+c to quit."},{"claim_ids":["clm_76bf15a24d7e2c3d90352a377fd0f0cea1008b57ecc7460d6f62587266ad3307"],"opposing_claim_ids":[],"text":"Using the Cursor provider requires the cursor-agent CLI on PATH; installing from source requires Go 1.27+."},{"claim_ids":["clm_d023e10be69a11ffa689e2a4c84458c13c638bd91e6f2155b7cf65ff86bebe59"],"opposing_claim_ids":[],"text":"The CLI supports flags including --beads-dir, --config, --version, --help, and --debug, plus subcommands: perles (TUI), themes, workflows, and playground."}],"claim_ids":["clm_5d91c901528c90de287e78daa34aa3331a8792b2089765c9fdacf0a3b4017b6b","clm_76bf15a24d7e2c3d90352a377fd0f0cea1008b57ecc7460d6f62587266ad3307","clm_d023e10be69a11ffa689e2a4c84458c13c638bd91e6f2155b7cf65ff86bebe59"],"created_at":"2026-09-14T04:34:24Z","created_by_operation":"op_1afee7b0543d40c39af07e5c5c4120ac","id":"pg_53bdb6b4713d521c8a3d9b403840c515","maturity":"draft","page_type":"source","path":"pages/sources/zjrosen-perles-docs-getting-started-md-f97afa7a7c44-9b403840c515.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_f1823368b9415eb19acdd355f293ed82"],"title":"zjrosen/perles/docs/getting-started.md @ f97afa7a7c44","updated_at":"2026-09-14T04:34:24Z","updated_by_operation":"op_1afee7b0543d40c39af07e5c5c4120ac"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_67d304b32d49e6d6804bf7e4cb1f997137ee6f9fc06767fee16450e420195454"],"opposing_claim_ids":[],"text":"Perles is a terminal UI for beads issue tracking powered by a custom BQL query language supporting boolean search, date filters, dependency traversal, and custom kanban views."},{"claim_ids":["clm_f667685ed442c4a2d0da97b271e381e793358542db02b964e9a5471788e0fab3"],"opposing_claim_ids":[],"text":"Perles requires a beads or beads-rust project with a .beads directory and a minimum beads database version of v0.62.0, upgradable via bd migrate."}],"claim_ids":["clm_67d304b32d49e6d6804bf7e4cb1f997137ee6f9fc06767fee16450e420195454","clm_f667685ed442c4a2d0da97b271e381e793358542db02b964e9a5471788e0fab3"],"created_at":"2026-09-14T04:34:24Z","created_by_operation":"op_1afee7b0543d40c39af07e5c5c4120ac","id":"pg_a220fca9aeb45f0c9d57f36f287ab881","maturity":"draft","page_type":"source","path":"pages/sources/zjrosen-perles-readme-md-f97afa7a7c44-f36f287ab881.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d7b05f54faf259818e7716b86d78daab"],"title":"zjrosen/perles/README.md @ f97afa7a7c44","updated_at":"2026-09-14T04:34:24Z","updated_by_operation":"op_1afee7b0543d40c39af07e5c5c4120ac"}
