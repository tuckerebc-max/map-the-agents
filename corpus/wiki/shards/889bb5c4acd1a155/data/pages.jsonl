,"clm_68f82f927b6499f0b63334cf5fb9d06e259ebd2f9fadd0c9a207804df49b0bc9","clm_76bf15a24d7e2c3d90352a377fd0f0cea1008b57ecc7460d6f62587266ad3307","clm_9ef6f051824f29988f18b9657fd327695e71b43f41d44bdd19d0ad813380dd2f","clm_ae865c03813fb4c44446b647af734672451ce92b2e72db0cc8bcf004ed8d52ac","clm_b8fa05cd744f317cc191d5e3d32fc126c296dc3484d0b5ccb2aa0e1159a17183","clm_bed82846bba2df1c454fe00cf07e28c8efc9a13835b6e95a60174f3bf6fd4678","clm_c69dcfae9bab0606dc85417860b81d5ea2504fb44f3e4b8e46e463f2bac98f7a","clm_ca60a241d71e0e380f83af37ead67cdb5acd88eb87175b101011a3f1d88c8516","clm_d023e10be69a11ffa689e2a4c84458c13c638bd91e6f2155b7cf65ff86bebe59","clm_db79fa544a6d6824eec2af225c6372862eda6ef3abb381a67a65d57dfa95b1ab","clm_e3d36677ff0027f70548783283f85b5471fa4b8a435b3ab55768dc95fc6f1347","clm_f667685ed442c4a2d0da97b271e381e793358542db02b964e9a5471788e0fab3"],"created_at":"2026-09-14T04:34:24Z","created_by_operation":"op_1afee7b0543d40c39af07e5c5c4120ac","id":"pg_db31ae64e26f5aa6a5eb0cfe606f71aa","maturity":"draft","page_type":"entity","path":"pages/entities/zjrosen-perles-0cfe606f71aa.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"zjrosen/perles","updated_at":"2026-09-14T04:34:24Z","updated_by_operation":"op_1afee7b0543d40c39af07e5c5c4120ac"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_9ef6f051824f29988f18b9657fd327695e71b43f41d44bdd19d0ad813380dd2f"],"opposing_claim_ids":[],"text":"The Control Plane supports multiple concurrent workflows with resource governance, health monitoring with stuck-workflow recovery, a dashboard TUI, and unified event aggregation."},{"claim_ids":["clm_b8fa05cd744f317cc191d5e3d32fc126c296dc3484d0b5ccb2aa0e1159a17183"],"opposing_claim_ids":[],"text":"The dashboard TUI offers keyboard actions for navigating workflows, filtering, starting (s), pausing (p), stopping (x), creating (n/N), and opening detail views."},{"claim_ids":["clm_bed82846bba2df1c454fe00cf07e28c8efc9a13835b6e95a60174f3bf6fd4678"],"opposing_claim_ids":[],"text":"Workflows move through states Pending, Running, Paused, Completed, Failed, and Stopped, with documented transitions including stop from pending, running, or paused."},{"claim_ids":["clm_c69dcfae9bab0606dc85417860b81d5ea2504fb44f3e4b8e46e463f2bac98f7a"],"opposing_claim_ids":[],"text":"Control Plane behavior is configured in ~/.config/perles/config.yaml under orchestration.control_plane, with resource policy defaults of 5 concurrent workflows, 10 workers, 5 AI calls, and MCP ports 9000-9100."},{"claim_ids":["clm_db79fa544a6d6824eec2af225c6372862eda6ef3abb381a67a65d57dfa95b1ab"],"opposing_claim_ids":[],"text":"The Control Plane comprises ControlPlane (lifecycle entry point), Registry (in-memory workflow storage), Supervisor, ResourceScheduler, HealthMonitor, and CrossWorkflowEventBus."},{"claim_ids":["clm_e3d36677ff0027f70548783283f85b5471fa4b8a435b3ab55768dc95fc6f1347"],"opposing_claim_ids":[],"text":"Workflow instances track identity, state, priority, labels, timestamps, runtime infrastructure/session/MCP port, token budget, and last heartbeat/progress times; the Registry stores them in memory."}],"claim_ids":["clm_9ef6f051824f29988f18b9657fd327695e71b43f41d44bdd19d0ad813380dd2f","clm_b8fa05cd744f317cc191d5e3d32fc126c296dc3484d0b5ccb2aa0e1159a17183","clm_bed82846bba2df1c454fe00cf07e28c8efc9a13835b6e95a60174f3bf6fd4678","clm_c69dcfae9bab0606dc85417860b81d5ea2504fb44f3e4b8e46e463f2bac98f7a","clm_db79fa544a6d6824eec2af225c6372862eda6ef3abb381a67a65d57dfa95b1ab","clm_e3d36677ff0027f70548783283f85b5471fa4b8a435b3ab55768dc95fc6f1347"],"created_at":"2026-09-14T04:34:23Z","created_by_operation":"op_1afee7b0543d40c39af07e5c5c4120ac","id":"pg_fcb915854c0a5ed59eca2eeadc98a20f","maturity":"draft","page_type":"source","path":"pages/sources/zjrosen-perles-docs-control-plane-md-f97afa7a7c44-2eeadc98a20f.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_d816d6bc61495da18a93db27f4337791"],"title":"zjrosen/perles/docs/CONTROL_PLANE.md @ f97afa7a7c44","updated_at":"2026-09-14T04:34:23Z","updated_by_operation":"op_1afee7b0543d40c39af07e5c5c4120ac"}
