5c87fb6ab","maturity":"draft","page_type":"entity","path":"pages/entities/autoresearch-factory-agon-2fa5c87fb6ab.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":[],"title":"autoresearch-factory/agon","updated_at":"2026-09-14T03:36:03Z","updated_by_operation":"op_cb2ca2cdd9f24f4caf80101579cfb07a"}
{"access":"public","aliases":[],"assertions":[{"claim_ids":["clm_085b409c65bc72d04a3bf4523fd417806f0d5aa999d1701f0b237c6b054956c2"],"opposing_claim_ids":[],"text":"The documented setup enables CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS so the main agent can resume background subagents and subagents can message each other, and sets cleanupPeriodDays to 3650 to retain session history."},{"claim_ids":["clm_0c88b05c0f0a9968f55e450b838c8340e6091848d401a932f4200f947de1b174"],"opposing_claim_ids":[],"text":"Running Agon requires launching Claude Code with --dangerously-skip-permissions, because unattended subagents write files, launch experiments, and call tools for hours and a permission prompt would stall the run; the README suggests isolating it on its own machine, container, or account."},{"claim_ids":["clm_2037a2ac15cea07ab11a24c027f964f1507be5fe8d93061fe5a64e4f70c85315"],"opposing_claim_ids":[],"text":"Agon exposes four Claude Code slash commands: /idea-tick, /proposal-tick, /experiment-tick, and /deep-lit-tick, which advance the research pipeline stages."},{"claim_ids":["clm_2a81397c17629b2c2a4e4f7c749ad1c30606a56e61ce8c6f2f45d93d805f6d71"],"opposing_claim_ids":[],"text":"The data workspace layout (topics/, ideas/, workspace/ directories) appears to be where the file-based artifacts of each pipeline stage are stored."},{"claim_ids":["clm_6bbcfccf943725ed5768b60ec4ad878744343ec367a1269890f2dbb4b622652d"],"opposing_claim_ids":[],"text":"Every handoff between agents goes through a file on disk, which the README says makes runs recoverable, auditable, and reusable across projects."},{"claim_ids":["clm_7382fc1984d7f6b750735be2f4c418330933e09b9c4818da9beefe665f0694aa"],"opposing_claim_ids":[],"text":"The pipeline is deliberately minimal and explicit: topic → idea → proposal → experiment."},{"claim_ids":["clm_8ce10a40342d33d1f64fd8762117b8a3bfbe9c2a036c9bc2b68882e7a4b2a51c"],"opposing_claim_ids":[],"text":"Agon is a Claude Code plugin intended to run from a separate data workspace repository (agon-artifacts), cloned side by side with the plugin directory."},{"claim_ids":["clm_93476d5e54ca4db3a2c03e97b3de20d05a4038ff63ae25b25fcfced5431f3c41"],"opposing_claim_ids":[],"text":"Optional local configuration lives in .settings.toml, with a .settings.example.toml template for customizing model routing and parallelism."},{"claim_ids":["clm_b496447f0261313a510f71ee64399609b27bbdb370ea357e4a3fdd775eff6d3b"],"opposing_claim_ids":[],"text":"Agon is presented as an autonomous large-scale omnidisciplinary research system built on Prompt Economy, with an accompanying arXiv paper (2606.24177) reporting deployments across more than ten research domains."},{"claim_ids":["clm_bd1414a1a5ff11465105437d2c8309260d4ef8a8fc1e856aff583595889f9753"],"opposing_claim_ids":[],"text":"The README documents an optional claude-ds wrapper that runs Claude Code against DeepSeek's Anthropic-compatible API endpoint using DEEPSEEK_API_KEY, with deepseek-v4-pro and deepseek-v4-flash model mappings."},{"claim_ids":["clm_e7d74802cdc6f33baa2c18e5eb85c867efa0489c746d2b16a8f4d05540b128cd"],"opposing_claim_ids":[],"text":"The experiment stage coordinates scientist, coder, auditor, and reviewer roles for a single workspace, with agents planning, implementing, auditing, and reviewing each other in closed loops."},{"claim_ids":["clm_fec97295778d9ab6dbc636a12ef3af5c2db8c9b5c8eac8f3f483472fea66d914"],"opposing_claim_ids":[],"text":"Commands accept free-form arguments, e.g. /experiment-tick can be told a run is a debugging run and asked to pause for user approval after each agent call."}],"claim_ids":["clm_085b409c65bc72d04a3bf4523fd417806f0d5aa999d1701f0b237c6b054956c2","clm_0c88b05c0f0a9968f55e450b838c8340e6091848d401a932f4200f947de1b174","clm_2037a2ac15cea07ab11a24c027f964f1507be5fe8d93061fe5a64e4f70c85315","clm_2a81397c17629b2c2a4e4f7c749ad1c30606a56e61ce8c6f2f45d93d805f6d71","clm_6bbcfccf943725ed5768b60ec4ad878744343ec367a1269890f2dbb4b622652d","clm_7382fc1984d7f6b750735be2f4c418330933e09b9c4818da9beefe665f0694aa","clm_8ce10a40342d33d1f64fd8762117b8a3bfbe9c2a036c9bc2b68882e7a4b2a51c","clm_93476d5e54ca4db3a2c03e97b3de20d05a4038ff63ae25b25fcfced5431f3c41","clm_b496447f0261313a510f71ee64399609b27bbdb370ea357e4a3fdd775eff6d3b","clm_bd1414a1a5ff11465105437d2c8309260d4ef8a8fc1e856aff583595889f9753","clm_e7d74802cdc6f33baa2c18e5eb85c867efa0489c746d2b16a8f4d05540b128cd","clm_fec97295778d9ab6dbc636a12ef3af5c2db8c9b5c8eac8f3f483472fea66d914"],"created_at":"2026-09-14T03:36:03Z","created_by_operation":"op_cb2ca2cdd9f24f4caf80101579cfb07a","id":"pg_f00624b36b315ba69685c043e7d788d7","maturity":"draft","page_type":"source","path":"pages/sources/autoresearch-factory-agon-readme-md-594fa079fd35-c043e7d788d7.md","record_type":"page","review_state":"mechanically_checked","schema_version":"1.0","source_ids":["src_87ca0f19531152328ef02897af9d7996"],"title":"AutoResearch-Factory/Agon/README.md @ 594fa079fd35","updated_at":"2026-09-14T03:36:03Z","updated_by_operation":"op_cb2ca2cdd9f24f4caf80101579cfb07a"}
